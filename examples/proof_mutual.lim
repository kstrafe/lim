; Each family is a separate declaration in an explicitly checked group.
; Recursive children receive the motive for their own family and indices.
(#math-inductive tree ()
  ()
  (#mutual tree forest)
  (#pt-type 0)
  ((node ((children (#pt-recur forest ()))))))
(#math-inductive forest ()
  ()
  (#mutual tree forest)
  (#pt-type 0)
  ((empty ()) (cons ((first (#pt-recur tree ())) (rest (#pt-recur forest ()))))))
(#math-definition add ()
  (#pt-pi ((x #pt-nat) (y #pt-nat)) #pt-nat)
  (#pt-lambda
    ((x #pt-nat) (y #pt-nat))
    (#pt-nat-induct
      (#pt-lambda ((n #pt-nat)) #pt-nat)
      y
      (#pt-lambda ((previous #pt-nat) (ih #pt-nat)) (#pt-succ ih))
      x)))
(#math-definition tree-count ()
  (#pt-pi ((value (#pt-use tree ()))) #pt-nat)
  (#pt-lambda
    ((value (#pt-use tree ())))
    (#pt-mutual-induct
      tree
      ()
      ()
      (#indices)
      (
        (tree
          (#pt-lambda ((subject (#pt-use tree ()))) #pt-nat)
          (
            (#pt-lambda
              ((children (#pt-use forest ())) (children-count #pt-nat))
              (#pt-succ children-count))))
        (forest
          (#pt-lambda ((subject (#pt-use forest ()))) #pt-nat)
          (#pt-zero
            (#pt-lambda
              (
                (first (#pt-use tree ()))
                (first-count #pt-nat)
                (rest (#pt-use forest ()))
                (rest-count #pt-nat))
              (#pt-app (#pt-use add ()) first-count rest-count)))))
      value)))
(#math-definition forest-count ()
  (#pt-pi ((value (#pt-use forest ()))) #pt-nat)
  (#pt-lambda
    ((value (#pt-use forest ())))
    (#pt-mutual-induct
      forest
      ()
      ()
      (#indices)
      (
        (tree
          (#pt-lambda ((subject (#pt-use tree ()))) #pt-nat)
          (
            (#pt-lambda
              ((children (#pt-use forest ())) (children-count #pt-nat))
              (#pt-succ children-count))))
        (forest
          (#pt-lambda ((subject (#pt-use forest ()))) #pt-nat)
          (#pt-zero
            (#pt-lambda
              (
                (first (#pt-use tree ()))
                (first-count #pt-nat)
                (rest (#pt-use forest ()))
                (rest-count #pt-nat))
              (#pt-app (#pt-use add ()) first-count rest-count)))))
      value)))
(#theorem tree-count-node
  (#universes)
  (#parameters
    (#parameter children (#pt-use forest ())))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use tree-count ()) (#pt-construct tree () () node (children)))
      (#pt-succ (#pt-app (#pt-use forest-count ()) children))))
  (#proof (#pt-refl #pt-nat (#pt-succ (#pt-app (#pt-use forest-count ()) children)))))
(#theorem forest-count-cons
  (#universes)
  (#parameters
    (#parameter first (#pt-use tree ()))
    (#parameter rest (#pt-use forest ())))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use forest-count ()) (#pt-construct forest () () cons (first rest)))
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use tree-count ()) first)
        (#pt-app (#pt-use forest-count ()) rest))))
  (#proof
    (#pt-refl
      #pt-nat
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use tree-count ()) first)
        (#pt-app (#pt-use forest-count ()) rest)))))
(#theorem mutual-recursion-computes
  (#universes)
  (#parameters)
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app
        (#pt-use tree-count ())
        (#pt-construct
          tree
          ()
          ()
          node
          (
            (#pt-construct
              forest
              ()
              ()
              cons
              (
                (#pt-construct tree () () node ((#pt-construct forest () () empty ())))
                (#pt-construct forest () () empty ()))))))
      (#pt-succ (#pt-succ #pt-zero))))
  (#proof (#pt-refl #pt-nat (#pt-succ (#pt-succ #pt-zero)))))
(#math-inductive even ()
  ()
  (#mutual even odd)
  (#indices
    (#parameter n #pt-nat))
  #pt-prop
  ((zero () (#pt-zero)) (step ((n #pt-nat) (previous (#pt-recur odd (n)))) ((#pt-succ n)))))
(#math-inductive odd ()
  ()
  (#mutual even odd)
  (#indices
    (#parameter n #pt-nat))
  #pt-prop
  ((step ((n #pt-nat) (previous (#pt-recur even (n)))) ((#pt-succ n)))))
(#theorem even-index-reflexive
  (#universes)
  (#parameters
    (#parameter n #pt-nat)
    (#parameter proof (#pt-app (#pt-use even ()) n)))
  (#statement (#pt-eq #pt-nat n n))
  (#proof
    (#pt-mutual-induct
      even
      ()
      ()
      (#indices n)
      (
        (even
          (#pt-lambda
            ((index #pt-nat) (subject (#pt-app (#pt-use even ()) index)))
            (#pt-eq #pt-nat index index))
          (
            (#pt-refl #pt-nat #pt-zero)
            (#pt-lambda
              (
                (index #pt-nat)
                (previous (#pt-app (#pt-use odd ()) index))
                (ih (#pt-eq #pt-nat index index)))
              (#pt-refl #pt-nat (#pt-succ index)))))
        (odd
          (#pt-lambda
            ((index #pt-nat) (subject (#pt-app (#pt-use odd ()) index)))
            (#pt-eq #pt-nat index index))
          (
            (#pt-lambda
              (
                (index #pt-nat)
                (previous (#pt-app (#pt-use even ()) index))
                (ih (#pt-eq #pt-nat index index)))
              (#pt-refl #pt-nat (#pt-succ index))))))
      proof)))

(#fn main () #u64
  (#return 42u64))
