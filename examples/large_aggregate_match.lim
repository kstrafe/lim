(#struct Large
  ((a u64) (b u64) (c u64) (d u64)
   (e u64) (f u64) (g u64)))

(#fn main () u64
  (#let tuple-value (#tuple u64 u64 u64 u64 u64 u64 u64)
    (#tuple (#tuple u64 u64 u64 u64 u64 u64 u64)
      1u64 2u64 3u64 4u64 5u64 6u64 40u64))
  (#let struct-value Large
    (Large 1u64 2u64 3u64 4u64 5u64 6u64 2u64))
  (#return
    (#u64.+.wrap
      (#match tuple-value
        ((#tuple first second third fourth fifth sixth last) last)
        (_ 0u64))
      (#match struct-value
        ((Large first second third fourth fifth sixth last) last)
        (_ 0u64)))))
