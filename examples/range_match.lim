#fn classify {
  #params = ((value #i32));
  #returns = #u64;
  #body = ((#return (#match value
        (#case (#range -10 10)
          42
        )
        (#case _
          0
        )
      )));
}

#fn wide-classify {
  #params = ((value #i128));
  #returns = #u64;
  #body = ((#return (#match value
        (#case (#range -2i128 2i128)
          42
        )
        (#case _
          0
        )
      )));
}

#fn main {
  #params = ();
  #returns = #u64;
  #body =
  ((#return (#u64::add-wrap (#call classify ((value 7))) (#call wide-classify ((value 1))))));
}
