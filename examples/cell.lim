#alias cell = #std/cell.lim::cell
// The generated type and its operations are concrete, named Lim declarations.
#generate cell {
  name = CellU32;
  get = CellU32::get;
  value-type = #u32;
  set = CellU32::set;
  create = CellU32::create;
}

#fn advance {
  #params = ((counter (#ref CellU32)));
  #returns = ();
  #body = (
    (#let current #u32 (#call CellU32::get ((cell (#clone counter)))))
    (#call CellU32::set ((cell counter) (value (#u32::add-wrap current 2u32))))
    (#return ())
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let counter CellU32 (#call CellU32::create ((value 40u32))))
    (#call advance ((counter (#borrow counter))))
    (#let result #u32 (#call CellU32::get ((cell (#borrow counter)))))
    (#forget counter)
    (#return (#as result #u64))
  );
}
