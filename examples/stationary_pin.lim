#alias lim-gen-pin = ../library/pin.lim::#pin
#alias lim-gen-pin-scope = ../library/pin.lim::#pin-scope
//; The generated scope privately owns the storage. User functions only see
//; an opaque handle, never the movable Frame itself.

#struct Frame (#linear) ((value #u64))

#generate lim-gen-pin { options = ((type Frame) (name PinnedFrame) (fields ((value #u64)))); }
#generate lim-gen-pin-scope { options = ((type Frame) (pin PinnedFrame) (name with-pinned-frame) (run
    drive-frame) (destroy destroy-frame) (result #u64)); }

#fn drive-frame {
  #params = ((pin PinnedFrame));
  #returns = #u64;
  #body = (
    (#let-mut handle PinnedFrame pin)
    (#call PinnedFrame::Write::value ((pin (#borrow-mut handle)) (value 42u64)))
    (#let result #u64 (#call PinnedFrame::Read::value ((pin (#borrow handle)))))
    (#forget handle)
    (#return result)
  );
}

#fn destroy-frame {
  #params = ((pin PinnedFrame));
  #returns = ();
  #body = (//; Release any resources in place here, before the scope retires storage.
    (#forget pin) (#return ()));
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = ((#return (#call with-pinned-frame ((value (#struct-literal Frame ((value 0u64))))))));
}
