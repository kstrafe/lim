(#fn mixed
  ((first u64) (second u64) (third u64) (fourth u64)
   (fifth u64) (sixth u64) (scale f64) (seventh u64) (eighth u64))
  u64
  (#return eighth))

(#fn main () u64
  (#return
    (#call mixed (#fn-args (first 1u64) (second 2u64) (third 3u64) (fourth 4u64) (fifth 5u64) (sixth 6u64) (scale 1.5f64) (seventh 7u64) (eighth 8u64)))))
