#fn consume {
  #params = ((value (#tuple #u64 #u64)));
  #returns = #u64;
  #body = ((#return (#get value 1)));
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = ((#return (#call consume ((value (#if true
              (#tuple (#tuple #u64 #u64) 10 20)
              (#tuple (#tuple #u64 #u64) 30 12)
            ))))));
