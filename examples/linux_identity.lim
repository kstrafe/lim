(#import "../library/linux_x86_64.lim")

; This executable only reapplies its current identity. Never use it as setuid.
; SAFETY: memory supplies six exclusively writable #u32 slots.
(#unsafe-fn identity-snapshot ((memory (#ptr-mut #u32))) ()
  (#assert (#i64.== (#unsafe (#unsafe-call linux-getresuid (: real memory : effective (#unsafe (#ptr-offset memory 1usize)) : saved (#unsafe (#ptr-offset memory 2usize))))) 0i64))
  (#assert (#i64.== (#unsafe (#unsafe-call linux-getresgid (: real (#unsafe (#ptr-offset memory 3usize)) : effective (#unsafe (#ptr-offset memory 4usize)) : saved (#unsafe (#ptr-offset memory 5usize))))) 0i64))
  (#return ()))

(#fn main () #u64
  (#let memory (#ptr-mut #u32)
    (#unsafe (#linux-syscall (#ptr-mut #u32) LINUX-SYS-MMAP
      (0usize 4096usize 3u32 34u32 -1i64 0i64))))
  (#unsafe (#unsafe-call identity-snapshot (: memory memory)))
  (#let uid #u32 (#unsafe (#ptr-read memory)))
  (#let gid #u32 (#unsafe (#ptr-read (#ptr-offset memory 3usize))))
  ; Check preconditions before calling setters: no differing saved/effective IDs.
  (#for-range (word #usize) 1usize 3usize
    (#assert (#u32.== uid (#unsafe (#ptr-read (#ptr-offset memory word))))))
  (#for-range (word #usize) 4usize 6usize
    (#assert (#u32.== gid (#unsafe (#ptr-read (#ptr-offset memory word))))))
  ; Invalid all-ones filesystem IDs query the old ID without changing it.
  (#let fsuid #i64 (#call linux-setfsuid (: uid 4294967295u32)))
  (#let fsgid #i64 (#call linux-setfsgid (: gid 4294967295u32)))
  (#assert (#i64.== fsuid (#as uid #i64)))
  (#assert (#i64.== fsgid (#as gid #i64)))
  (#assert (#i64.== (#call linux-setuid (: uid uid)) 0i64))
  (#assert (#i64.== (#call linux-setgid (: gid gid)) 0i64))
  (#assert (#i64.== (#call linux-setreuid (: real 4294967295u32 : effective 4294967295u32)) 0i64))
  (#assert (#i64.== (#call linux-setregid (: real 4294967295u32 : effective 4294967295u32)) 0i64))
  (#assert (#i64.== (#call linux-setresuid (: real 4294967295u32 : effective 4294967295u32 : saved 4294967295u32)) 0i64))
  (#assert (#i64.== (#call linux-setresgid (: real 4294967295u32 : effective 4294967295u32 : saved 4294967295u32)) 0i64))
  ; setuid/setgid reject all-ones rather than treating it as "unchanged".
  (#assert (#i64.== (#call linux-setuid (: uid 4294967295u32)) -22i64))
  (#assert (#i64.== (#call linux-setgid (: gid 4294967295u32)) -22i64))
  (#assert (#i64.== (#call linux-setfsuid (: uid uid)) fsuid))
  (#assert (#i64.== (#call linux-setfsgid (: gid gid)) fsgid))
  (#assert (#i64.== (#call linux-setfsuid (: uid 4294967295u32)) fsuid))
  (#assert (#i64.== (#call linux-setfsgid (: gid 4294967295u32)) fsgid))
  (#let after (#ptr-mut #u32) (#unsafe (#ptr-offset memory 6usize)))
  (#unsafe (#unsafe-call identity-snapshot (: memory after)))
  (#for-range (word #usize) 0usize 6usize
    (#assert (#u32.==
      (#unsafe (#ptr-read (#ptr-offset memory word)))
      (#unsafe (#ptr-read (#ptr-offset after word))))))
  (#assert (#i64.== (#unsafe (#linux-syscall #i64 LINUX-SYS-MUNMAP
    (memory 4096usize))) 0i64))
  (#let letter #u8 85u8)
  (#let newline #u8 10u8)
  (#assert (#i64.== (#call linux-write-byte (: source (#borrow letter))) 1i64))
  (#assert (#i64.== (#call linux-write-byte (: source (#borrow newline))) 1i64))
  (#return 42u64))
