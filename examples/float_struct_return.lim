(
  #struct
  Point
  (
    (x f64)
    (y f32)
  )
)

(
  #fn
  make
  ()
  Point
  (
    #return
    (#struct-literal Point ((x 1.5) (y 2.5)))
  )
)

(
  #fn
  main
  ()
  u64
  (
    #return
    (
      #if
      (#bool.&&
        (#f64.>
          (
            #get
            (#call make (#fn-args ))
            x
          )
          1.0
        )
        (#f32.>
          (
            #get
            (#call make (#fn-args ))
            y
          )
          2.0
        )
      )
      42
      0
    )
  )
)
