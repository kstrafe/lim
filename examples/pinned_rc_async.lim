#alias lim-gen-pin-rc = #std/pin_rc.lim::pin-rc

#struct Arena () ()
#enum ArenaError () (ArenaError.OutOfMemory)
#type Arena::Allocator::State Arena
#type Arena::Allocator::Error ArenaError
#enum Arena::Allocator::Allocation () ((Arena::Allocator::Allocation.Allocated (#ptr-mut #u8))
  (Arena::Allocator::Allocation.AllocationFailed ArenaError))
#struct StepWaiting () ((value #u64) (remaining #u64))
#enum Step (#linear) ((Step.Step-waiting StepWaiting))

#enum StepPoll () ((StepPoll.StepPending Step) (StepPoll.StepReady #u64))

#fn step-poll {
  #params = ((task Step) (waker (#ref #u64)));
  #returns = StepPoll;
  #body = ((#return (#match task
        (#case (Step.Step-waiting state)
          (#if (#u64::eq (#get state remaining) 0u64)
            (StepPoll.StepReady (#get state value))
            (StepPoll.StepPending (Step.Step-waiting (#struct-literal StepWaiting ((value (#get
                        state value)) (remaining (#u64::sub-wrap (#get state remaining) 1u64))))))
          )
        )
      )));
}

#syntax StepAwait (#u64 Step StepPoll.StepPending StepPoll.StepReady step-poll)

#fn cancel-step {
  #params = ((task Step));
  #returns = ();
  #body = ((#forget task) (#return ()));
}

#generate #async-fn-pinned ((protocol WorkAwait) (waker #u64) (cancel (cancel-work ((await-0
          cancel-step)))) (function (#fn work () #u64 (#let value #u64 (#await (#syntax-splice
            StepAwait) (Step.Step-waiting (#struct-literal StepWaiting ((value 42u64) (remaining
                  1u64)))))) (#return value))))

#generate lim-gen-pin-rc { options = ((type Work::Frame) (allocator Arena::Allocator) (name
      PinnedFrameRc) (destroy destroy-frame)); }

#fn Arena::Allocator::allocate {
  #params = ((allocator (#ref Arena)) (layout #usize) (alignment #usize));
  #returns = Arena::Allocator::Allocation;
  #effects = (#global-access #io);
  #body = (
    (#let pointer (#ptr-mut #u8) (#unsafe
        (#linux-syscall (#ptr-mut #u8) 9usize (0usize layout 3usize 34usize -1i64 0usize))
      ))
    (#return (#if (#usize::ge (#ptr-address pointer) 18446744073709547520usize)
        (Arena::Allocator::Allocation.AllocationFailed ArenaError.OutOfMemory)
        (Arena::Allocator::Allocation.Allocated pointer)
      ))
  );
}

#unsafe-fn Arena::Allocator::deallocate {
  #params = ((allocator (#ref Arena)) (pointer (#ptr-mut #u8)) (layout #usize) (alignment #usize));
  #returns = ();
  #effects = (#global-access #io);
  #body = (
    (#assert (#i64::eq (#unsafe
          (#linux-syscall #i64 11usize (pointer layout))
        ) 0i64))
    (#return ())
  );
}

#fn destroy-frame {
  #params = ((allocator (#ref Arena)) (pin (#pin-ref-mut Work::Frame)));
  #returns = ();
  #effects = ((#effects-of Work::Poll::cleanup));
  #body = (
    (#call cancel-work ((task (#call Work::Poll::cleanup ((task pin))))))
    (#forget pin)
    (#return ())
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #effects = ((#effects-of PinnedFrameRc::create) (#effects-of PinnedFrameRc::destroy)
    (#effects-of Work::poll));
  #body = (
    (#let arena Arena (#struct-literal Arena ()))
    (#let-mut owner PinnedFrameRc
      (#match (#call PinnedFrameRc::create ((allocator (#borrow arena)) (value (#call work ()))))
        (#case (PinnedFrameRc::CreateResult.Created allocated)
          allocated
        )
        (#case (PinnedFrameRc::CreateResult.Allocation-failed failure)
          (#block
            (#forget failure)
            (#unreachable)
          )
        )
      ))
    (#let other PinnedFrameRc (#call PinnedFrameRc::clone ((owner (#borrow owner)))))
    (#match (#call PinnedFrameRc::borrow-mut ((owner (#borrow-mut owner))))
      (#case PinnedFrameRc::MutResult.Shared
        ()
      )
      (#case (PinnedFrameRc::MutResult.Unique unexpected)
        (#block
          (#forget unexpected)
          (#unreachable)
        )
      )
    )
    (#call PinnedFrameRc::destroy ((owner other)))
    (#let waker #u64 0u64)
    (#let first-pin (#pin-ref-mut Work::Frame)
      (#match (#call PinnedFrameRc::borrow-mut ((owner (#borrow-mut owner))))
        (#case (PinnedFrameRc::MutResult.Unique pin)
          pin
        )
        (#case PinnedFrameRc::MutResult.Shared
          (#unreachable)
        )
      ))
    (#let first Work::Poll (#call Work::poll ((task first-pin) (waker (#borrow waker)))))
    (#forget first-pin)
    (#let-else (Work::Poll.Pending pending) Work::Poll first (#unreachable))
    (#forget pending)
    (#let-mut moved PinnedFrameRc owner)
    (#let second-pin (#pin-ref-mut Work::Frame)
      (#match (#call PinnedFrameRc::borrow-mut ((owner (#borrow-mut moved))))
        (#case (PinnedFrameRc::MutResult.Unique pin-next)
          pin-next
        )
        (#case PinnedFrameRc::MutResult.Shared
          (#unreachable)
        )
      ))
    (#let second Work::Poll (#call Work::poll ((task second-pin) (waker (#borrow waker)))))
    (#forget second-pin)
    (#let answer #u64 (#match second
        (#case (Work::Poll.Ready value)
          value
        )
        (#case (Work::Poll.Pending unexpected-pending)
          (#block
            (#forget unexpected-pending)
            (#unreachable)
          )
        )
      ))
    (#call PinnedFrameRc::destroy ((owner moved)))
    (#forget arena)
    (#return answer)
  );
}
