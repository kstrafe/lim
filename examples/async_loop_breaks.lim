; Both conditional exits of this value-producing loop survive suspension. The inner
; synchronous loop's break belongs to that loop, not the enclosing async loop.
(#enum Step ((Waiting #u64) (Resuming #u64)))
(#linear Step)
(#enum StepPoll ((StepPending Step) (StepReady #u64)))
(#fn step-poll ((task Step) (waker (#ref #u64))) StepPoll
  (#return (#match task
    (#case (Waiting value) (StepPending (Resuming value)))
    (#case (Resuming value) (StepReady value)))))

(#fn identity ((value #u64)) #u64 (#return value))
(@async-fn ( : protocol WorkAwait : waker #u64 : function
  (#fn work ((choose #bool)) #u64
    (#let result #u64
      (#call identity (: value
        (#loop
          (#let awaited #u64
            (#await #u64 Step StepPending StepReady step-poll (Waiting 41u64)))
          (#let nested #u64 (#loop (#break 7u64)))
          (#assert (#u64.== nested 7u64))
          (#if choose (#break 42u64) (#break awaited))))))
    (#return result))))

(#fn run ((choose #bool) (waker (#ref #u64))) #u64
  (#let first work-poll-result
    (#call work-poll (: task (#call work (: choose choose)) : waker waker)))
  (#let-else (work-pending pending) work-poll-result first (#unreachable))
  (#let second work-poll-result (#call work-poll (: task pending : waker waker)))
  (#return (#match second
    (#case (work-ready value) value)
    (#case (work-pending unexpected) (#block (#forget unexpected) (#unreachable))))))

(#fn main () #u64
  (#let waker #u64 0u64)
  (#let early #u64 (#call run (: choose true : waker (#borrow waker))))
  (#let final #u64 (#call run (: choose false : waker (#borrow waker))))
  (#assert (#u64.== final 41u64))
  (#forget waker)
  (#return early))
