#alias linux-close = ../library/linux_x86_64.lim::linux-close
#alias linux-fcntl = ../library/linux_x86_64.lim::linux-fcntl
#alias linux-ftruncate = ../library/linux_x86_64.lim::linux-ftruncate
#alias linux-getpid = ../library/linux_x86_64.lim::linux-getpid
#alias linux-memfd-secret = ../library/linux_x86_64.lim::linux-memfd-secret
#alias linux-mmap = ../library/linux_x86_64.lim::linux-mmap
#alias linux-munmap = ../library/linux_x86_64.lim::linux-munmap
#alias linux-process-vm-readv = ../library/linux_x86_64.lim::linux-process-vm-readv
#alias linux-write = ../library/linux_x86_64.lim::linux-write

// Requires enabled secret memory and sufficient RLIMIT_MEMLOCK for two maps.
#fn main {
  #params = ();
  #returns = #u64;
  #effects = (#global-access #io (#effects-of linux-close) (#effects-of linux-fcntl) (#effects-of linux-ftruncate) (#effects-of linux-getpid) (#effects-of linux-memfd-secret) (#effects-of linux-mmap) (#effects-of linux-munmap) (#effects-of linux-process-vm-readv) (#effects-of linux-write));
  #body = (
    (#assert (#i64::eq (#call linux-memfd-secret ((flags 1u32))) -22i64))
    (#let fd #i64 (#call linux-memfd-secret ((flags 524288u32))))
    (#assert (#i64::ge fd 0i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-fcntl ((fd fd) (command 1i32) (argument 0usize)))) 1i64))
    (#assert (#i64::eq (#call linux-ftruncate ((fd fd) (length 4096i64))) 0i64))
    (#assert (#i64::eq (#call linux-ftruncate ((fd fd) (length 8192i64))) -22i64))
    (#let secret (#ptr-mut #u8) (#unsafe (#unsafe-call linux-mmap ((address (#ptr-null (#ptr-mut #u8))) (length 4096usize) (protection 3u32) (flags 1u32) (fd fd) (offset 0i64)))))
    (#let alias (#ptr-mut #u8) (#unsafe (#unsafe-call linux-mmap ((address (#ptr-null (#ptr-mut #u8))) (length 4096usize) (protection 3u32) (flags 1u32) (fd fd) (offset 0i64)))))
    (#unsafe (#ptr-write secret 83u8))
    (#unsafe (#ptr-write (#ptr-offset secret 1usize) 10u8))
    (#assert (#u8::eq (#unsafe (#ptr-read alias)) 83u8))
    (#unsafe (#ptr-write alias 84u8))
    (#assert (#u8::eq (#unsafe (#ptr-read secret)) 84u8))
    (#let memory (#ptr-mut #u8) (#unsafe (#unsafe-call linux-mmap ((address (#ptr-null (#ptr-mut #u8))) (length 4096usize) (protection 3u32) (flags 34u32) (fd -1i64) (offset 0i64)))))
    (#let remote (#ptr-mut #u8) (#unsafe (#ptr-offset memory 16usize)))
    (#let destination (#ptr-mut #u8) (#unsafe (#ptr-offset memory 64usize)))
    // Local and remote native iovecs. process_vm_readv cannot pin secret pages.
    (#unsafe (#asm () ((rdi memory) (rsi secret))
      "lea rax, [rdi+64]\nmov QWORD PTR [rdi], rax\nmov QWORD PTR [rdi+8], 2\nmov QWORD PTR [rdi+16], rsi\nmov QWORD PTR [rdi+24], 2"))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-process-vm-readv ((pid (#as (#call linux-getpid ()) #i32)) (local-vectors memory) (local-count 1usize) (remote-vectors remote) (remote-count 1usize) (flags 0usize)))) -14i64))
    (#assert (#u8::eq (#unsafe (#ptr-read destination)) 0u8))
    (#assert (#i64::eq (#call linux-close ((fd fd))) 0i64))
    // Mappings retain the object after its descriptor closes. Deliberately copy
    // the synthetic test payload to ordinary memory before writing stdout.
    (#unsafe (#ptr-write destination (#ptr-read secret)))
    (#unsafe (#ptr-write (#ptr-offset destination 1usize) (#ptr-read (#ptr-offset alias 1usize))))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-write ((fd 1i64) (source destination) (count 2usize)))) 2i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-munmap ((address secret) (length 4096usize)))) 0i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-munmap ((address alias) (length 4096usize)))) 0i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-munmap ((address memory) (length 4096usize)))) 0i64))
    (#return 42u64)
  );
}
