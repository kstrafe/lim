#enum Holder () ((Holder.Has (#ref #u64)))

#fn select {
  #params = ((source (#ref #u64)));
  #returns = (#ref #u64);
  #body = (
    (#let holder Holder (Holder.Has source))
    (#return (#match holder
      (#case (Holder.Has view) view)))
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let owner #u64 42u64)
    (#let selected (#ref #u64)
      (#call select ((source (#borrow owner)))))
    (#return (#deref selected))
  );
}
