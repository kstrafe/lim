#gn-fn make-alias { name; target; } `(#type ,name ,target)

#gn-fn make-aliases { pairs; } `(,@(#gn-for-each pair pairs
         (#gn-call make-alias
           { name = (#gn-first pair);
           target = (#gn-first (#gn-rest pair)); })))

#gn aliases { pairs; } (#gn-call make-aliases { pairs = pairs; })

#generate aliases { pairs = ((Byte #u8) (Word #u16)); }

#fn main {
  #params = ();
  #returns = #u64;
  #body = ((#return 42));
}
