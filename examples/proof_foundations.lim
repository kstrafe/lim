; These fixed logical assumptions are explicit. They are not computed proofs.
; --check-theorem reports the transitive basis of each selected theorem.
(#math-definition inhabited-naturals ()
  (#pt-pi ((P #pt-prop) (consume (#pt-pi ((value #pt-nat)) P))) P)
  (#pt-lambda ((P #pt-prop) (consume (#pt-pi ((value #pt-nat)) P)))
    (#pt-app consume #pt-zero)))

(#math-definition selected-natural () #pt-nat
  (#pt-app (#pt-use #pt-foundation-choice (1)) #pt-nat
    (#pt-use inhabited-naturals ())))

(#theorem selected-natural-reflexive
  (#universes)
  (#parameters)
  (#statement (#pt-eq #pt-nat (#pt-use selected-natural ()) (#pt-use selected-natural ())))
  (#proof (#pt-refl #pt-nat (#pt-use selected-natural ()))))

(#theorem proposition-extensionality
  (#universes)
  (#parameters
    (#parameter P #pt-prop)
    (#parameter Q #pt-prop)
    (#parameter forward (#pt-pi ((p P)) Q))
    (#parameter backward (#pt-pi ((q Q)) P)))
  (#statement (#pt-eq #pt-prop P Q))
  (#proof (#pt-app (#pt-use #pt-foundation-propext ()) P Q forward backward)))

(#theorem quotient-related-representatives
  (#universes u)
  (#parameters
    (#parameter A (#pt-sort u))
    (#parameter relation (#pt-pi ((x A) (y A)) #pt-prop))
    (#parameter left A)
    (#parameter right A)
    (#parameter related (#pt-app relation left right)))
  (#statement (#pt-eq (#pt-quot u A relation)
    (#pt-quot-make u A relation left) (#pt-quot-make u A relation right)))
  (#proof (#pt-app (#pt-use #pt-foundation-quot-sound (u)) A relation left right related)))

(#fn main () #u64
  (#return 42u64))
