; Each pattern test awaits a factory and the task returned by that factory.
; Pattern payloads remain available through both body suspension points.
(#enum Choice ((Chosen #u64) Empty))
(#enum ChoiceTask ((ChoiceStart Choice) (ChoiceResume Choice)))
(#enum ChoicePoll ((ChoicePending ChoiceTask) (ChoiceReady Choice)))
(#fn choice-poll ((task ChoiceTask) (waker (#ref #u64))) ChoicePoll
  (#return (#match task
    (#case (ChoiceStart value) (ChoicePending (ChoiceResume value)))
    (#case (ChoiceResume value) (ChoiceReady value)))))

(#enum Factory ((MakeChoice Choice) (ResumeChoice Choice)))
(#linear Factory)
(#enum FactoryPoll ((FactoryPending Factory) (FactoryReady ChoiceTask)))
(#fn factory-poll ((task Factory) (waker (#ref #u64))) FactoryPoll
  (#return (#match task
    (#case (MakeChoice choice) (FactoryPending (ResumeChoice choice)))
    (#case (ResumeChoice choice) (FactoryReady (ChoiceStart choice))))))

(#enum Step ((Start #u64) (Resume #u64)))
(#enum StepPoll ((StepPending Step) (StepReady #u64)))
(#fn step-poll ((task Step) (waker (#ref #u64))) StepPoll
  (#return (#match task
    (#case (Start value) (StepPending (Resume value)))
    (#case (Resume value) (StepReady value)))))

(@#async-fn ( : protocol WorkAwait : waker #u64 : function
  (#fn work ((#mut choice Choice)) #u64
    (#let-mut total #u64 0u64)
    (#while-let (Chosen value)
      (#await Choice ChoiceTask ChoicePending ChoiceReady choice-poll
        (#await ChoiceTask Factory FactoryPending FactoryReady factory-poll
          (#block
            (#set total (#u64.+.wrap total 1u64))
            (MakeChoice choice))))
      (#let first #u64 (#await #u64 Step StepPending StepReady step-poll (Start value)))
      (#let second #u64 (#await #u64 Step StepPending StepReady step-poll (Start first)))
      (#set total (#u64.+.wrap total second))
      (#set choice Empty))
    (#return total))))

(#fn run ((choice Choice) (waker (#ref #u64))) #u64
  (#let-mut task work-task (#call work (: choice choice)))
  (#for-range (attempt #u64) 0u64 8u64
    (#let polled work-poll-result (#call work-poll (: task task : waker waker)))
    (#match polled
      (#case (work-pending next) (#block (#set task next) ()))
      (#case (work-ready result) (#block (#return result)))))
  (#forget task)
  (#return (#unreachable)))

(#fn main () #u64
  (#let waker #u64 0u64)
  (#let chosen #u64 (#call run (: choice (Chosen 37u64) : waker (#borrow waker))))
  (#let empty #u64 (#call run (: choice Empty : waker (#borrow waker))))
  ; Chosen: 37 plus two factory constructions; Empty: one construction.
  (#return (#u64.+.wrap chosen empty)))
