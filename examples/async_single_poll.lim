;; Construction is lazy and movable. @#pin-scope owns stationary storage;
;; every resume calls the same work-poll function. The state enum tag is its index.
(#import "../library/pin.lim")

(#enum Step (: Step-waiting #u64 #u64))
(#linear Step)
(#enum StepPoll (: StepPending Step : StepReady #u64))
(#fn step-poll (: task Step : waker (#ref #u64)) StepPoll
  (#return (#match task
    (#case (Step-waiting value remaining)
      (#if (#u64.== remaining 0u64)
        (StepReady value)
        (StepPending (Step-waiting value (#u64.-.wrap remaining 1u64))))))))

(#syntax StepAwait (#u64 Step StepPending StepReady step-poll))
(@#async-fn-pinned ( : protocol WorkAwait : waker #u64 : function
  (#fn work () #u64
    ;; The first child is immediately work-ready: work-poll advances to await-1 without
    ;; returning to the caller or calling a generated resume function.
    (#let first #u64 (#await (#syntax-splice StepAwait) (Step-waiting 40u64 0u64)))
    (#let second #u64 (#await (#syntax-splice StepAwait) (Step-waiting 2u64 2u64)))
    (#return (#u64.+.wrap first second)))))

(@#pin (: type Work-frame : name PinnedFrame))
(@#pin-scope (: type Work-frame : pin PinnedFrame : name with-pinned-frame
  : run drive-frame : destroy destroy-frame : result #u64))

(#fn drive-frame (: pin PinnedFrame) #u64
  ;; The adapter is unsafe because it exposes a low-level pin view. The
  ;; generated scope still owns the storage until cleanup has completed.
  (#let view (#pin-ref-mut Work-frame)
    (#unsafe (#call PinnedFrame-into-view (: pin pin))))
  (#let waker #u64 0u64)
  (#let first Work-poll-result (#call work-poll (: task view : waker (#borrow waker))))
  (#let-else (work-pending after-first) Work-poll-result first (#unreachable))
  (#let second Work-poll-result (#call work-poll (: task after-first : waker (#borrow waker))))
  (#let-else (work-pending after-second) Work-poll-result second (#unreachable))
  (#let third Work-poll-result (#call work-poll (: task after-second : waker (#borrow waker))))
  (#let-else (work-ready answer) Work-poll-result third (#unreachable))
  (#return answer))

(#fn destroy-frame (: pin PinnedFrame) ()
  (#let view (#pin-ref-mut Work-frame)
    (#unsafe (#call PinnedFrame-into-view (: pin pin))))
  (#let state Work-frame-state (#call work-poll-cancel (: task view)))
  ;; Cleanup dispatches on the same initialized payloads as before. This also
  ;; works before the first work-poll or while a child remains work-pending.
  (#match state
    (#case work-frame-start ())
    (#case (work-frame-await-0 child) (#forget child))
    (#case (work-frame-await-1 first child) (#block (#forget child) ()))
    (#case work-frame-done ()))
  (#return ()))

(#fn main () #u64
  (#return (#call with-pinned-frame (: value (#call work (:))))))
