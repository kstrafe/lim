#alias lim-gen-cell = #std/cell.lim::cell
#alias lim-gen-task = #std/tasks.lim::task
#alias lim-gen-task-cancel = #std/tasks.lim::task-cancel

#generate lim-gen-cell { value-type = #u64; name = CellU64; create = CellU64::create; get = CellU64::get; set = CellU64::set; }
#struct Flag () ((released CellU64))
#generate lim-gen-task { names = (Held HeldPoll HeldPoll.HeldPending HeldPoll.HeldReady); result = #u64; states = ((Held.Holding
    (#ref Flag))); }

#fn release {
  #params = ((task (#ref Flag)));
  #returns = ();
  #body =
  ((#call CellU64::set ((cell (#borrow (#get task released))) (value 42u64))) (#return ()));
}

#generate lim-gen-task-cancel { cancel = cancel; task = Held; states = ((Held.Holding release)); }

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let flag Flag (#struct-literal Flag ((released (#call CellU64::create ((value 0u64)))))))
    (#call cancel ((task (Held.Holding (#borrow flag)))))
    (#let flag-ref (#ref Flag) (#borrow flag))
    (#let result #u64 (#call CellU64::get ((cell (#borrow (#get flag-ref released))))))
    (#drop flag-ref)
    (#forget flag)
    (#return result)
  );
}
