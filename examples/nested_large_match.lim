(#struct Inner
  ((payload (#array u64 7))))

(#struct Outer
  ((inner Inner)))

(#fn main () u64
  (#let value Outer
    (#struct-literal Outer ((inner (#struct-literal Inner ((payload (#array (#array u64 7) 1u64 2u64 3u64 4u64 5u64 6u64 42u64))))))))
  (#return
    (#match value
      ((Outer (Inner payload)) (#index payload 6u64))
      (_ 0u64))))
