(
  #enum
  MaybeF
  (
    (SomeF f32)
    None
  )
)

(
  #fn
  make
  ()
  MaybeF
  (
    #return
    (SomeF 2.5)
  )
)

(
  #fn
  read
  (
    (value MaybeF)
  )
  f32
  (
    #return
    (
      #match
      value
      (
        (SomeF payload)
        payload
      )
      (None 0.0)
    )
  )
)

(
  #fn
  main
  ()
  u64
  (
    #return
    (
      #if
      (#f32.>
        (#call read (#fn-args (value (#call make (#fn-args )))))
        2.0
      )
      42
      0
    )
  )
)
