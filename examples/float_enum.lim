#enum MaybeF () ((MaybeF.SomeF #f32) MaybeF.None)

#fn make {
  #params = ();
  #returns = MaybeF;
  #body = ((#return (MaybeF.SomeF 2.5)));
}

#fn read {
  #params = ((value MaybeF));
  #returns = #f32;
  #body = ((#return (#match value
        (#case (MaybeF.SomeF payload)
          payload
        )
        (#case MaybeF.None
          0.0
        )
      )));
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = ((#return (#if (#f32::gt (#call read ((value (#call make ())))) 2.0)
        42
        0
      )));
}
