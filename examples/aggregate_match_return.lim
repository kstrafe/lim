(#enum Maybe ((Some u64) None))

(#fn choose ((value Maybe)) (#tuple u64 u64)
  (#return (#match value
    (#case (Some payload) (#tuple (#tuple u64 u64) payload 20))
    (#case None (#tuple (#tuple u64 u64) 30 12)))))

(#fn main () u64
  (#return (#get (#call choose (#fn-args (value (Some 10)))) 1)))
