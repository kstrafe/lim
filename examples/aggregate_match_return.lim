#enum Maybe () ((Maybe.Some #u64) Maybe.None)

#fn choose {
  #params = ((value Maybe));
  #returns = (#tuple #u64 #u64);
  #body = (
    (#return (#match value
      (#case (Maybe.Some payload) (#tuple (#tuple #u64 #u64) payload 20))
      (#case Maybe.None (#tuple (#tuple #u64 #u64) 30 12))))
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#return (#get (#call choose ((value (Maybe.Some 10)))) 1))
  );
}
