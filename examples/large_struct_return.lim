(#struct Large
  ((a u64) (b u64) (c u64) (d u64)
   (e u64) (f u64) (g u64)))

(#fn make ((last u64)) Large
  (#return (#struct-literal Large ((a 1u64) (b 2u64) (c 3u64) (d 4u64) (e 5u64) (f 6u64) (g last)))))

(#fn main () u64
  (#let value Large (#call make (: last 42u64)))
  (#return (#get value g)))
