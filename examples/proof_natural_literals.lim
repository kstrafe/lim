; These mathematical naturals exceed machine integers. Their representation
; stays compact; induction still has the ordinary zero/successor semantics.
(#math-definition huge () #pt-nat
  (#pt-nat-literal #pt-nat "184467440737095516160"))

(#math-definition predecessor ()
  (#pt-pi ((input #pt-nat)) #pt-nat)
  (#pt-lambda ((input #pt-nat))
    (#pt-nat-induct (#pt-lambda ((value #pt-nat)) #pt-nat) #pt-zero
      (#pt-lambda ((previous #pt-nat) (result #pt-nat)) previous) input)))

(#theorem huge-successor
  (#universes)
  (#parameters)
  (#statement (#pt-eq #pt-nat (#pt-succ (#pt-use huge ()))
    (#pt-nat-literal #pt-nat "184467440737095516161")))
  (#proof (#pt-refl #pt-nat (#pt-nat-literal #pt-nat "184467440737095516161"))))

(#theorem huge-predecessor
  (#universes)
  (#parameters)
  (#statement (#pt-eq #pt-nat
    (#pt-app (#pt-use predecessor ()) (#pt-nat-literal #pt-nat "184467440737095516161"))
    (#pt-use huge ())))
  (#proof (#pt-refl #pt-nat (#pt-use huge ()))))

(#fn main () #u64
  (#return 42u64))
