#fn add-inner-and-tail {
  #params = ((value (#tuple (#tuple #u64 #u64) #u64)));
  #returns = #u64;
  #body = ((#return (#u64::add-wrap (#u64::add-wrap (#get (#get value 0) 1) (#get value 1)) (#get
          (#get value 0) 0))));
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = ((#return (#call add-inner-and-tail ((value (#tuple (#tuple (#tuple #u64 #u64) #u64)
              (#tuple (#tuple #u64 #u64) 10 20) 32))))));
}
