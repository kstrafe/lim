#gn-fn emit-function { name; temporary; } `((#fn ,name ((task #u64)) #u64
       (#let ,temporary #u64 task)
       (#return (#u64::add-wrap task ,temporary))))

#gn make-function { name; } (#gn-call emit-function { name = name; temporary = (#gn-gensym "task"); })

#generate make-function { name = first; }
#generate make-function { name = second; }
#generate make-function { name = first; }

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#assert (#u64::eq (#call second ((task 21u64))) 42u64))
    (#return (#call first ((task 21u64))))
  );
}
