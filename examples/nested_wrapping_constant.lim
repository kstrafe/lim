(#const Wrapped i8 (#i8./.wrap (#i8.+.wrap 127i8 1i8) 2i8))
(#const Negated i8 (#i8./.wrap (#i8.-.wrap -128i8) 2i8))
(#const Inverted u8 (#u8./.wrap (#u8.! 0u8) 2u8))
(#fn main () u64
  (#assert (#i8.== Wrapped -64i8))
  (#assert (#i8.== Negated -64i8))
  (#assert (#u8.== Inverted 127u8))
  (#assert (#u128.== (#u128.! 0u128) 340282366920938463463374607431768211455u128))
  (#assert (#u128.== (#u128.-.wrap 1u128) 340282366920938463463374607431768211455u128))
  (#assert (#i128.== (#i128.-.saturate -170141183460469231731687303715884105728i128) 170141183460469231731687303715884105727i128))
  (#assert (#i8.== Wrapped (#i8./.wrap (#i8.+.wrap 127i8 1i8) 2i8)))
  (#return 42u64))
