(#struct Tagged () ((marker ()) (value #u64)))

(#fn consume ((marker ())) #u64
  (#return 41))

(#fn main () #u64
  (#let unit-value () ())
  (#let pair (#tuple () #u64) (#tuple (#tuple () #u64) (#clone unit-value) 40))
  (#let tagged Tagged (#struct-literal Tagged ((marker (#clone unit-value)) (value 1))))
  (#return (#u64::add-wrap (#call consume (: marker unit-value)) (#u64::add-wrap (#get pair 1) (#get tagged value)))))
