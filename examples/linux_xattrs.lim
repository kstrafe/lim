    (#let path-file-unlinked #i64
      (#unsafe (#unsafe-call linux-unlink ((path (#ptr-offset memory 128usize))))))
    (#let memory-unmapped #i64
      (#unsafe (#linux-syscall #i64 lINUX-SYS-MUNMAP (memory 4096usize))))
    (#let xattrs-ok #bool
      (#bool::and (#i64::ge fd 0i64)
        (#bool::and (#i64::eq attribute-set 0i64)
          (#bool::and (#i64::eq attribute-listed 9i64)
            (#bool::and (#i64::eq attribute-read 8i64)
              (#bool::and (#u8::eq output-byte-0 108u8)
                (#bool::and (#u8::eq output-byte-7 97u8)
                  (#bool::and (#u8::eq list-first 117u8)
                    (#bool::and (#u8::eq list-last 0u8)
                      (#bool::and (#i64::eq attribute-removed 0i64)
                        (#i64::eq absent-read -61i64)))))))))))
    (#let path-xattrs-ok #bool
      (#bool::and (#i64::ge path-file 0i64)
        (#bool::and (#i64::eq path-file-closed 0i64)
          (#bool::and (#i64::eq path-attribute-set 0i64)
            (#bool::and (#i64::eq duplicate-path-attribute -17i64)
              (#bool::and (#i64::eq path-attribute-read 8i64)
                (#bool::and (#u8::eq path-first-byte 108u8)
                  (#bool::and (#u8::eq path-last-byte 97u8)
                    (#bool::and (#i64::eq path-attribute-list 9i64)
                      (#bool::and (#u8::eq path-list-first-byte 117u8)
