    (#let path-attribute-llist #i64
      (#unsafe (#unsafe-call linux-llistxattr ((path (#ptr-offset memory 128usize)) (list (#ptr-offset memory 96usize)) (size 128usize)))))
    (#let path-attribute-lremoved #i64
      (#unsafe (#unsafe-call linux-lremovexattr ((path (#ptr-offset memory 128usize)) (name (#ptr-offset memory 16usize))))))
    (#let path-absent-read #i64
      (#unsafe (#unsafe-call linux-getxattr ((path (#ptr-offset memory 128usize)) (name (#ptr-offset memory 16usize)) (value (#ptr-offset memory 64usize)) (size 128usize)))))
    (#let path-attribute-lset #i64
