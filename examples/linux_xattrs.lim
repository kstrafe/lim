          (#ptr-write (#ptr-offset memory 20usize) 46u8)
          (#ptr-write (#ptr-offset memory 21usize) 108u8)
          (#ptr-write (#ptr-offset memory 22usize) 105u8)
          (#ptr-write (#ptr-offset memory 23usize) 109u8)
          (#ptr-write (#ptr-offset memory 24usize) 0u8)
          (#ptr-write (#ptr-offset memory 32usize) 108u8)
          (#ptr-write (#ptr-offset memory 33usize) 105u8)
          (#ptr-write (#ptr-offset memory 34usize) 109u8)
          (#ptr-write (#ptr-offset memory 35usize) 45u8)
          (#ptr-write (#ptr-offset memory 36usize) 100u8)
          (#ptr-write (#ptr-offset memory 37usize) 97u8)
          (#ptr-write (#ptr-offset memory 38usize) 116u8)
          (#ptr-write (#ptr-offset memory 39usize) 97u8)
          (#ptr-write (#ptr-offset memory 128usize) 120u8)
          (#ptr-write (#ptr-offset memory 129usize) 97u8)
          (#ptr-write (#ptr-offset memory 130usize) 116u8)
          (#ptr-write (#ptr-offset memory 131usize) 116u8)
          (#ptr-write (#ptr-offset memory 132usize) 114u8)
          (#ptr-write (#ptr-offset memory 133usize) 45u8)
          (#ptr-write (#ptr-offset memory 134usize) 102u8)
          (#ptr-write (#ptr-offset memory 135usize) 105u8)
          (#ptr-write (#ptr-offset memory 136usize) 108u8)
          (#ptr-write (#ptr-offset memory 137usize) 101u8)
          ())))
    (#let fd #i64
      (#unsafe (#unsafe-call linux-memfd-create ((name memory) (flags 1u32)))))
    (#let attribute-set #i64
      (#unsafe (#unsafe-call linux-fsetxattr ((fd fd) (name (#ptr-offset memory 16usize)) (value (#ptr-offset memory 32usize)) (size 8usize) (flags 0i32)))))
    (#let attribute-listed #i64
      (#unsafe (#unsafe-call linux-flistxattr ((fd fd) (list (#ptr-offset memory 96usize)) (size 128usize)))))
    (#let attribute-read #i64
      (#unsafe (#unsafe-call linux-fgetxattr ((fd fd) (name (#ptr-offset memory 16usize)) (value (#ptr-offset memory 64usize)) (size 128usize)))))
    (#let output-byte-0 #u8
      (#unsafe (#ptr-read (#ptr-offset memory 64usize))))
    (#let output-byte-7 #u8
