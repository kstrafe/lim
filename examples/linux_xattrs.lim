    (#let path-file-closed #i64
      (#call linux-close ((fd path-file))))
    (#let path-attribute-set #i64
      (#unsafe (#unsafe-call linux-setxattr ((path (#ptr-offset memory 128usize)) (name (#ptr-offset memory 16usize)) (value (#ptr-offset memory 32usize)) (size 8usize) (flags 1i32)))))
    (#let duplicate-path-attribute #i64
