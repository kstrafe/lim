                                (#bool::and (#i64::eq path-attribute-lset 0i64)
                                  (#bool::and (#i64::eq path-attribute-removed 0i64)
                                    (#bool::and (#i64::eq path-absent-lread -61i64)
                                      (#i64::eq path-file-unlinked 0i64))))))))))))))))))
    (#return
      (#if (#bool::and (#bool::and xattrs-ok path-xattrs-ok)
        (#bool::and (#i64::eq fd-closed 0i64)
