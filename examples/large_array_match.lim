#fn make {
  #params = ();
  #returns = (#array #u64 7);
  #body = ((#return (#array (#array #u64 7) 1u64 2u64 3u64 4u64 5u64 6u64 42u64)));
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = ((#return (#match (#call make ())
        (#case (#array first second third fourth fifth sixth last)
          last
        )
        (#case _
          0u64
        )
      )));
}
