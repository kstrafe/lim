(#struct Large
  ((a u64) (b u64) (c u64) (d u64)
   (e u64) (f u64) (g u64)))

(#fn make-tuple () (#tuple u64 u64 u64 u64 u64 u64 u64)
  (#return
    (#tuple (#tuple u64 u64 u64 u64 u64 u64 u64)
      1u64 2u64 3u64 4u64 5u64 6u64 20u64)))

(#fn make-struct () Large
  (#return (Large 1u64 2u64 3u64 4u64 5u64 6u64 22u64)))

(#fn main () u64
  (#return
    (#u64.+.wrap
      (#match (make-tuple)
        ((#tuple first second third fourth fifth sixth last) last)
        (_ 0u64))
      (#match (make-struct)
        ((Large first second third fourth fifth sixth last) last)
        (_ 0u64)))))
