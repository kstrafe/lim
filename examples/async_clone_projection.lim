; Clone a reference-bearing field of a computed owning temporary, then suspend.
; The cloned Holder retains the caller's loan after its Envelope is consumed.
(#struct Holder (#linear) (: reference (#ref #u64)))

(#struct Envelope () (: item Holder))
(#fn make-envelope (: reference (#ref #u64)) Envelope
  (#return (#struct-literal Envelope (: item (#struct-literal Holder (: reference reference))))))
(#enum Step (#linear) (Start Resume))

(#enum StepPoll () ((Pending Step) (Ready ())))
(#fn step-poll (: task Step : waker (#ref #u64)) StepPoll
  (#return
    (#match task
      (#case Start
        (Pending Resume))
      (#case Resume
        (Ready ())))))
(@
  #async-fn
  (: protocol WorkAwait : waker #u64 : function
  (#fn work (: owner (#ref #u64)) #u64
    (#let holder Holder
      (#clone (#get (#call make-envelope (: reference owner)) item)))
    (#let ready () (#await () Step Pending Ready step-poll Start))
    (#let result #u64 (#deref (#get holder reference)))
    (#forget holder)
    (#return result))))
(#fn main () #u64
  (#let owner #u64 42u64)
  (#let waker #u64 0u64)
  (#let
    first
    Work-poll-result
    (#call work-poll (: task (#call work (: owner (#borrow owner))) : waker (#borrow waker))))
  (#let-else (work-pending pending) Work-poll-result first (#unreachable))
  (#let second Work-poll-result (#call work-poll (: task pending : waker (#borrow waker))))
  (#return
    (#match second
      (#case (work-ready result)
        result)
      (#case (work-pending unexpected)
        (#block
          (#forget unexpected)
          (#unreachable))))))
