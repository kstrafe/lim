#type Value #u64

#enum
    Box ()
    (
      (Box.Some Value)
      Box.None
    )

#fn
    main {
  #params = ();
  #returns = #u64;
  #body = (
    (
      #return
      (
        #match
        (Box.Some 42)
        (#case
          (Box.Some value)
          value
        )
        (#case Box.None 0)
      )
    )
  );
}
