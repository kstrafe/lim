// The start and end factories run once, in order, despite suspension/continue.
(#enum ChildTask (#linear) ((ChildTask.Start #u64) (ChildTask.Resume #u64)))

(#enum ChildPoll () ((ChildPoll.ChildPending ChildTask) (ChildPoll.ChildReady #u64)))
(#fn child-poll ((task ChildTask) (waker (#ref #u64))) ChildPoll
  (#return
    (#match task
      (#case (ChildTask.Start value)
        (ChildPoll.ChildPending (ChildTask.Resume value)))
      (#case (ChildTask.Resume value)
        (ChildPoll.ChildReady value)))))
(#fn bound ((order (#ref-mut #u64)) (expected #u64) (value #u64)) ChildTask
  (#assert (#u64::eq (#deref order) expected))
  (#deref-set order (#u64::add-wrap (#deref order) 1u64))
  (#return (ChildTask.Start value)))
(#generate
  #async-fn
  ((protocol WorkAwait) (waker #u64) (function
  (#fn work ((order (#ref-mut #u64))) #u64
    (#let-mut total #u64 0u64)
    (#label counting
      (#for-range (iteration #u64)
        (#await #u64 ChildTask ChildPoll.ChildPending ChildPoll.ChildReady child-poll
          (#call bound ((order order) (expected 0u64) (value 0u64))))
        (#await #u64 ChildTask ChildPoll.ChildPending ChildPoll.ChildReady child-poll
          (#call bound ((order order) (expected 1u64) (value 3u64))))
        (#if (#u64::eq iteration 0u64) (#block (#continue-to counting)) ())
        (#set total (#u64::add-wrap total iteration))))
    (#return (#u64::add-wrap total 39u64))))))
(#fn main () #u64
  (#let-mut order #u64 0u64)
  (#let waker #u64 0u64)
  (#let-mut task Work::Task (#call work ((order (#borrow-mut order)))))
  (#for-range (attempt #u64) 0u64 4u64
    (#let result Work::Poll (#call Work::poll ((task task) (waker (#borrow waker)))))
    (#match result
      (#case (Work::Poll.Pending next)
        (#block
          (#set task next)
          ()))
      (#case (Work::Poll.Ready value)
        (#block
          (#assert (#u64::eq order 2u64))
          (#return value)))))
  (#forget task)
  (#return (#unreachable)))
