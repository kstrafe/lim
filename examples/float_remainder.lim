(#fn main () #u64
  (#let left #f64 5.5f64)
  (#let right #f64 2.0f64)
  (#let small-left #f32 5.5f32)
  (#let small-right #f32 2.0f32)
  (#return (#if (#bool::and (#f64::eq (#f64::rem left right) 1.5f64)
                          (#f32::eq (#f32::rem small-left small-right) 1.5f32))
                   42u64
                   0u64)))
