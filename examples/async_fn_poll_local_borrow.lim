// References ending before an await do not require a stationary future.
#struct Counter (#linear) ((value #u64))

#fn increment ((target (#ref-mut #u64))) ()
    (#deref-set target (#u64::add-wrap (#deref target) 1u64))
    (#return ())
#enum Step (#linear) (Step.Start Step.Resume)

#enum StepPoll () ((StepPoll.StepPending Step) (StepPoll.StepReady #u64))
#syntax StepAwait (#u64 Step StepPoll.StepPending StepPoll.StepReady step-poll)
#fn step-poll ((task Step) (waker (#ref #u64))) StepPoll
    (#return
      (#match task
        (#case Step.Start
          (StepPoll.StepPending Step.Resume))
        (#case Step.Resume
          (StepPoll.StepReady 0u64))))
#generate
    #async-fn
    ((protocol WorkAwait) (waker #u64) (function
    (#fn work () #u64
      (#let-mut counter Counter (#struct-literal Counter ((value 40u64))))
      (#let view (#ref-mut Counter) (#borrow-mut counter))
      (#call increment ((target (#borrow-mut (#get view value)))))
      (#call increment ((target (#borrow-mut (#get view value)))))
      (#forget view)
      (#let answer #u64 (#borrow counter (#get counter value)))
      (#forget counter)
      (#let extra #u64 (#await StepAwait Step.Start))
      (#return (#u64::add-wrap answer extra)))))
#fn main () #u64
    (#let waker #u64 0u64)
    (#let first Work::Poll (#call Work::poll ((task (#call work ())) (waker (#borrow waker)))))
    (#let-else (Work::Poll.Pending task) Work::Poll first (#unreachable))
    (#let second Work::Poll (#call Work::poll ((task task) (waker (#borrow waker)))))
    (#forget waker)
    (#return
      (#match second
        (#case (Work::Poll.Ready answer)
          answer)
        (#case (Work::Poll.Pending unexpected)
          (#block
            (#forget unexpected)
            (#unreachable)))))
