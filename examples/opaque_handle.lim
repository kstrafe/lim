(#alias api@Handle = ./opaque_handle/lib.lim::Handle)
(#alias api@Status = ./opaque_handle/lib.lim::Status)
(#alias api@handle-close = ./opaque_handle/lib.lim::handle-close)
(#alias api@handle-create = ./opaque_handle/lib.lim::handle-create)
(#alias api@handle-status = ./opaque_handle/lib.lim::handle-status)

(#fn main () #u64
  (#let handle api@Handle (#call api@handle-create (: value 42u64)))
  (#let status api@Status (#call api@handle-status (: handle (#borrow handle))))
  (#let answer #u64
    (#match status
      (#case (api@Status.Open value) value)
      (#case api@Status.Closed 0u64)))
  (#call api@handle-close (: handle handle))

  // Both cases are publicly constructible without separate variant exports.
  (#let made api@Status (#enum-literal api@Status.Open 7u64))
  (#match made
    (#case (api@Status.Open value) (#assert (#u64::eq value 7u64)))
    (#case api@Status.Closed (#unreachable)))
  (#let closed api@Status (#enum-literal api@Status.Closed))
  (#match closed
    (#case (api@Status.Open value) (#unreachable))
    (#case api@Status.Closed ()))
  (#return answer))
