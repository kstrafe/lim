#fn classify {
  #params = ((value (#tuple #u64 #u64)));
  #returns = #u64;
  #body = (
    (#return
      (#match value
        (#case (#tuple 40 second) second)
        (#case _ 0)))
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#return (#call classify ((value (#tuple (#tuple #u64 #u64) 40 2)))))
  );
}
