#struct Point () ((x #u64) (y #u64))

#fn identity {
  #params = ((point Point));
  #returns = Point;
  #body = ((#return point));
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let result Point (#call identity ((point (#struct-literal Point ((x 11) (y 37)))))))
    (#return (#get result y))
  );
}
