#fn choose ((condition #bool)) (#array (#array #u64 7) 2)
    (#return
      (#loop
        (#if condition
          (#block (#break (#array (#array (#array #u64 7) 2)
            (#array (#array #u64 7) 1u64 2u64 3u64 4u64 5u64 6u64 7u64)
            (#array (#array #u64 7) 10u64 20u64 30u64 40u64 50u64 60u64 42u64))))
          (#block (#break (#array (#array (#array #u64 7) 2)
            (#array (#array #u64 7) 70u64 80u64 90u64 100u64 110u64 120u64 132u64)
            (#array (#array #u64 7) 170u64 180u64 190u64 200u64 210u64 220u64 242u64)))))))

#fn main () #u64
    (#let selected (#array (#array #u64 7) 2) (#call choose ((condition false))))
    (#let item (#array #u64 7) (#index selected 1u64))
    (#return (#index item 6u64))
