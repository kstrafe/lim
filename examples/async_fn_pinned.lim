; This source-slot cleanup example uses --cfg async-lowering=graph.
; @#async-fn-pinned returns a movable frame value that must be pinned before
; polling. While a Work::poll is Work::Pending, the returned PinRefMut keeps the frame at
; its storage location and is passed into the next Work::poll. One generated Work::poll
; loop dispatches on the state tag. See async_single_poll.lim for opaque pins
; with privately owned stationary storage and async_fn_self_reference.lim for the
; supported internal-reference form.
(#enum Child (#linear) ((Waiting #u64)))

(#enum ChildPoll () ((ChildPending Child) (ChildReady #u64)))
(#fn child-poll ((task Child) (waker (#ref #u64))) ChildPoll
  (#return (#match task
    (#case (Waiting value)
      (#if (#u64.== value 0u64)
        (ChildPending (Waiting 1u64))
        (ChildReady value))))))
(#fn cancel-child ((task Child)) () (#forget task) (#return ()))

(@#async-fn-pinned ( : protocol WorkAwait : waker #u64
  : cancel (cancel-frame ((await-0 cancel-child))) : function
  (#fn work ((offset #u64)) #u64
    (#let value #u64
      (#await Child ChildPending ChildReady child-poll (Waiting 0u64)))
    (#return (#u64.+.wrap value offset)))))

(#fn main () #u64
  (#let-mut frame Work::Frame (#call work (: offset 40u64)))
  (#let waker #u64 0u64)
  (#let first Work::Poll
    (#call Work::poll (: task (#pin-borrow-mut frame) : waker (#borrow waker))))
  (#let-else (Work::Pending pinned-frame) Work::Poll first (#unreachable))
  (#let second Work::Poll
    (#call Work::poll (: task pinned-frame : waker (#borrow waker))))
  (#let result #u64
    (#match second
      (#case (Work::Ready value) value)
      (#case (Work::Pending unexpected)
        (#block (#forget unexpected) (#unreachable)))))
  (#forget frame)

  (#let-mut cancelled-frame Work::Frame (#call work (: offset 90u64)))
  (#let first-cancel Work::Poll
    (#call Work::poll (: task (#pin-borrow-mut cancelled-frame) : waker (#borrow waker))))
  (#let-else (Work::Pending cancel-pin) Work::Poll first-cancel (#unreachable))
  (#let cleanup-to-cancel Work::Frame::Cleanup (#call Work::poll::cleanup (: task cancel-pin)))
  (#call cancel-frame (: task cleanup-to-cancel))
  (#forget cancelled-frame)
  (#forget waker)
  (#return result))
