(#struct SystemAllocator ((identity u64) (destructions (#cell u64))))
(#enum AllocError (OutOfMemory))
(@result (#ptr-mut u64) AllocError AllocResult)
(@vec u64 SystemAllocator VecU64)
(@vec-sort u64 VecU64 compare-u64)
(@vec-alloc u64 SystemAllocator VecU64 AllocResult AllocError
  system-alloc system-grow system-dealloc drop-u64)

(#fn compare-u64 ((left (#ref u64)) (right (#ref u64))) bool
  (#return (#u64.< (#deref left) (#deref right))))

(#extern-fn #abi-c malloc ((size usize)) (#ptr-mut u64))
(#extern-fn #abi-c realloc ((pointer (#ptr-mut u64)) (size usize)) (#ptr-mut u64))
(#extern-fn #abi-c free ((pointer (#ptr-mut u64))) ())

(#fn system-alloc
  ((allocator (#ref SystemAllocator)) (layout usize) (alignment usize))
  AllocResult
  (#let pointer (#ptr-mut u64) (#unsafe (malloc layout)))
  (#return
    (#if (#ptr-is-null pointer)
      (#block (#forget pointer) (AllocResult-err OutOfMemory))
      (AllocResult-ok pointer))))

(#fn system-grow
  ((allocator (#ref SystemAllocator)) (pointer (#ptr-mut u64))
   (old-layout usize) (new-layout usize) (alignment usize))
  AllocResult
  (#let new-pointer (#ptr-mut u64) (#unsafe (realloc pointer new-layout)))
  (#return
    (#if (#ptr-is-null new-pointer)
      (#block (#forget new-pointer) (AllocResult-err OutOfMemory))
      (AllocResult-ok new-pointer))))

(#fn system-dealloc
  ((allocator (#ref SystemAllocator)) (pointer (#ptr-mut u64))
   (layout usize) (alignment usize))
  ()
  (#unsafe (free pointer))
  (#return ()))

(#fn drop-u64 ((allocator (#ref SystemAllocator)) (value u64)) ()
  (#cell-set (#get allocator destructions)
    (#u64.+.wrap (#cell-get (#get allocator destructions)) 1u64))
  (#return ()))

(#fn main () u64
  (#let-mut allocator SystemAllocator (SystemAllocator 0u64 (#cell 0u64)))
  (#let-mut vector VecU64 (VecU64-new (#borrow allocator)))
  (#let first VecU64-PushResult (VecU64-push (#borrow-mut vector) 33u64))
  (#forget first)
  (#let second VecU64-PushResult (VecU64-push (#borrow-mut vector) 11u64))
  (#forget second)
  (#let third VecU64-PushResult (VecU64-push (#borrow-mut vector) 22u64))
  (#forget third)
  (VecU64-sort (#borrow-mut vector))
  (#let read VecU64-GetResult (VecU64-get (#borrow vector) 1usize))
  (#let read-value u64
    (#match read
      ((VecU64-GetResult-some reference) (#deref reference))
      (VecU64-GetResult-none 0u64)))
  (#assert (#u64.== read-value 22u64))
  (#let replacement VecU64-SetResult
    (VecU64-set (#borrow-mut vector) 1usize 44u64))
  (#forget replacement)
  (#let popped VecU64-PopResult (VecU64-pop (#borrow-mut vector)))
  (#assert
    (#match popped
      ((VecU64-PopResult-some value)
        (#block (drop-u64 (#borrow allocator) value) true))
      (VecU64-PopResult-none false)))
  (VecU64-free vector)
  (#let destruction-count u64 (#cell-get (#get allocator destructions)))
  (#forget allocator)
  (#return destruction-count))
