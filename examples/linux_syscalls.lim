(#import "../library/linux_x86_64.lim")

(#fn is-ebadf ((status i64)) bool
  (#return (#i64.== status -9i64)))

(#fn main () u64
  (#let pid i64 (#call linux-getpid (#fn-args)))
  (#let asm_pid i64
    (#unsafe (#asm i64 ((rax LINUX-SYS-GETPID)) "syscall")))
  (#let uid i64 (#call linux-getuid (#fn-args)))
  (#let gid i64 (#call linux-getgid (#fn-args)))
  (#let euid i64 (#call linux-geteuid (#fn-args)))
  (#let egid i64 (#call linux-getegid (#fn-args)))
  (#let ppid i64 (#call linux-getppid (#fn-args)))
  (#let pgrp i64 (#call linux-getpgrp (#fn-args)))
  (#let queried-pgrp i64 (#call linux-getpgid (#fn-args (pid pid))))
  (#let sid i64 (#call linux-getsid (#fn-args (pid pid))))
  (#let priority i64 (#call linux-getpriority (#fn-args (which 0i64) (who 0i64))))
  (#let tid i64 (#call linux-gettid (#fn-args)))
  (#let yielded i64 (#call linux-sched-yield (#fn-args)))
  (#let alive i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-KILL (pid 0usize))))
  (#let failed_close i64
    (#call linux-close (#fn-args (fd 999999i64))))
  (#let failed_dup i64
    (#call linux-dup (#fn-args (fd 999999i64))))
  (#let failed_seek i64
    (#call linux-lseek (#fn-args (fd 999999i64) (offset 0i64) (whence 0i64))))
  (#let failed_sync i64
    (#call linux-fsync (#fn-args (fd 999999i64))))
  (#let failed_truncate i64
    (#call linux-ftruncate (#fn-args (fd 999999i64) (length 0i64))))
  (#let failed_fstat i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-FSTAT
      (999999i64 (#ptr-null (#ptr-mut u8))))))
  (#let failed_ioctl i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-IOCTL (999999i64 0usize 0usize))))
  (#let failed_fcntl i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-FCNTL (999999i64 1usize 0usize))))
  (#let failed_flock i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-FLOCK (999999i64 2usize))))
  (#let failed_fdatasync i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-FDATASYNC (999999i64))))
  (#let failed_fchdir i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-FCHDIR (999999i64))))
  (#let failed_fchmod i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-FCHMOD (999999i64 0usize))))
  (#let failed_fchown i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-FCHOWN (999999i64 0usize 0usize))))
  (#let failed_getdents i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-GETDENTS64
      (999999i64 (#ptr-null (#ptr-mut u8)) 8usize))))
  (#let failed_fallocate i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-FALLOCATE
      (999999i64 0usize 0i64 1i64))))
  (#let failed_dup2 i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-DUP2 (999999i64 999998i64))))
  (#let advice i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-FADVISE64 (-1i64 0usize 0usize 0usize))))
  (#let-mut parent_signal u32 0u32)
  (#let parent_query i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-PRCTL
      (2usize (#borrow-mut parent_signal) 0usize 0usize 0usize))))
  (#let identity-memory (#ptr-mut u32)
    (#unsafe (#linux-syscall (#ptr-mut u32) LINUX-SYS-MMAP
      (0usize 4096usize 3usize 34usize -1i64 0usize))))
  (#let getresuid-result i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-GETRESUID
      ((#ptr-offset identity-memory 0usize)
       (#ptr-offset identity-memory 1usize)
       (#ptr-offset identity-memory 2usize)))))
  (#let real-uid u32 (#unsafe (#ptr-read identity-memory)))
  (#let effective-uid u32
    (#unsafe (#ptr-read (#ptr-offset identity-memory 1usize))))
  (#let saved-uid u32
    (#unsafe (#ptr-read (#ptr-offset identity-memory 2usize))))
  (#let getresgid-result i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-GETRESGID
      ((#ptr-offset identity-memory 0usize)
       (#ptr-offset identity-memory 1usize)
       (#ptr-offset identity-memory 2usize)))))
  (#let real-gid u32 (#unsafe (#ptr-read identity-memory)))
  (#let effective-gid u32
    (#unsafe (#ptr-read (#ptr-offset identity-memory 1usize))))
  (#let saved-gid u32
    (#unsafe (#ptr-read (#ptr-offset identity-memory 2usize))))
  (#let supplementary-groups i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-GETGROUPS
      (0usize (#ptr-null (#ptr-mut u32))))))
  (#let identity-memory-unmapped i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-MUNMAP (identity-memory 4096usize))))
  (#let-mut mapping (#ptr-mut u8)
    (#unsafe (#linux-syscall (#ptr-mut u8) LINUX-SYS-MMAP
      (0usize 4096usize 3usize 34usize -1i64 0usize))))
  (#let uname-result i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-UNAME (mapping))))
  (#let uname-first-byte u8 (#unsafe (#ptr-read mapping)))
  (#let random-buffer-count i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-GETRANDOM (mapping 4usize 0usize))))
  (#unsafe
    (#block
      (#ptr-write mapping 47u8)
      (#ptr-write (#ptr-offset mapping 1usize) 100u8)
      (#ptr-write (#ptr-offset mapping 2usize) 101u8)
      (#ptr-write (#ptr-offset mapping 3usize) 118u8)
      (#ptr-write (#ptr-offset mapping 4usize) 47u8)
      (#ptr-write (#ptr-offset mapping 5usize) 110u8)
      (#ptr-write (#ptr-offset mapping 6usize) 117u8)
      (#ptr-write (#ptr-offset mapping 7usize) 108u8)
      (#ptr-write (#ptr-offset mapping 8usize) 108u8)
      (#ptr-write (#ptr-offset mapping 9usize) 0u8)
      ()))
  (#let null-device i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-OPENAT
      (-100i64 mapping 0usize 0usize))))
  (#let close-null-device i64
    (#call linux-close (#fn-args (fd null-device))))
  (#unsafe
    (#block
      (#ptr-write (#ptr-offset mapping 1usize) 112u8)
      (#ptr-write (#ptr-offset mapping 2usize) 114u8)
      (#ptr-write (#ptr-offset mapping 3usize) 111u8)
      (#ptr-write (#ptr-offset mapping 4usize) 99u8)
      (#ptr-write (#ptr-offset mapping 5usize) 47u8)
      (#ptr-write (#ptr-offset mapping 6usize) 115u8)
      (#ptr-write (#ptr-offset mapping 7usize) 101u8)
      (#ptr-write (#ptr-offset mapping 8usize) 108u8)
      (#ptr-write (#ptr-offset mapping 9usize) 102u8)
      (#ptr-write (#ptr-offset mapping 10usize) 47u8)
      (#ptr-write (#ptr-offset mapping 11usize) 101u8)
      (#ptr-write (#ptr-offset mapping 12usize) 120u8)
      (#ptr-write (#ptr-offset mapping 13usize) 101u8)
      (#ptr-write (#ptr-offset mapping 14usize) 0u8)
      ()))
  (#let readlink-count i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-READLINKAT
      (-100i64 mapping (#ptr-offset mapping 64usize) 256usize))))
  (#let link-first-byte u8
    (#unsafe (#ptr-read (#ptr-offset mapping 64usize))))
  (#let cwd-result i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-GETCWD (mapping 4096usize))))
  (#let cwd-first-byte u8 (#unsafe (#ptr-read mapping)))
  (#let protected i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-MPROTECT (mapping 4096usize 1usize))))
  (#let protected-first-byte u8 (#unsafe (#ptr-read mapping)))
  (#let unprotected i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-MPROTECT (mapping 4096usize 3usize))))
  (#let advised i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-MADVISE (mapping 4096usize 0usize))))
  (#let edge-written ()
    (#unsafe (#ptr-write (#ptr-offset mapping 4095usize) 42u8)))
  (#let edge-byte u8
    (#unsafe (#ptr-read (#ptr-offset mapping 4095usize))))
  (#let remapped (#ptr-mut u8)
    (#unsafe (#linux-syscall (#ptr-mut u8) LINUX-SYS-MREMAP
      (mapping 4096usize 8192usize 1usize))))
  (#set mapping remapped)
  (#let preserved-edge u8
    (#unsafe (#ptr-read (#ptr-offset mapping 4095usize))))
  (#let expanded-edge-written ()
    (#unsafe (#ptr-write (#ptr-offset mapping 8191usize) 84u8)))
  (#let expanded-edge u8
    (#unsafe (#ptr-read (#ptr-offset mapping 8191usize))))
  (#let unmapped i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-MUNMAP (mapping 8192usize))))
  (#let mapping-i16 (#ptr-mut i16)
    (#unsafe (#linux-syscall (#ptr-mut i16) LINUX-SYS-MMAP
      (0usize 4096usize 3usize 34usize -1i64 0usize))))
  (#let edge-i16 (#ptr-mut i16) (#unsafe (#ptr-offset mapping-i16 2047usize)))
  (#let write-i16 () (#unsafe (#ptr-write edge-i16 -1234i16)))
  (#let value-i16 i16 (#unsafe (#ptr-read edge-i16)))
  (#let unmapped-i16 i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-MUNMAP (mapping-i16 4096usize))))
  (#let mapping-i32 (#ptr-mut i32)
    (#unsafe (#linux-syscall (#ptr-mut i32) LINUX-SYS-MMAP
      (0usize 4096usize 3usize 34usize -1i64 0usize))))
  (#let edge-i32 (#ptr-mut i32) (#unsafe (#ptr-offset mapping-i32 1023usize)))
  (#let write-i32 () (#unsafe (#ptr-write edge-i32 -123456789i32)))
  (#let value-i32 i32 (#unsafe (#ptr-read edge-i32)))
  (#let unmapped-i32 i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-MUNMAP (mapping-i32 4096usize))))
  (#let mapping-u32 (#ptr-mut u32)
    (#unsafe (#linux-syscall (#ptr-mut u32) LINUX-SYS-MMAP
      (0usize 4096usize 3usize 34usize -1i64 0usize))))
  (#let edge-u32 (#ptr-mut u32) (#unsafe (#ptr-offset mapping-u32 1023usize)))
  (#let write-u32 () (#unsafe (#ptr-write edge-u32 4294967295u32)))
  (#let value-u32 u32 (#unsafe (#ptr-read edge-u32)))
  (#let unmapped-u32 i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-MUNMAP (mapping-u32 4096usize))))
  (#let pipe-memory (#ptr-mut i32)
    (#unsafe (#linux-syscall (#ptr-mut i32) LINUX-SYS-MMAP
      (0usize 4096usize 3usize 34usize -1i64 0usize))))
  (#let pipe-created i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-PIPE2 (pipe-memory 0usize))))
  (#let pipe-read-fd i64 (#as (#unsafe (#ptr-read pipe-memory)) i64))
  (#let pipe-write-fd i64
    (#as (#unsafe (#ptr-read (#ptr-offset pipe-memory 1usize))) i64))
  (#let pipe-payload-set ()
    (#unsafe (#ptr-write (#ptr-offset pipe-memory 4usize) 305419896i32)))
  (#let pipe-write-count i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-WRITE
      (pipe-write-fd (#ptr-offset pipe-memory 4usize) 4usize))))
  (#let pipe-read-count i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-READ
      (pipe-read-fd (#ptr-offset pipe-memory 8usize) 4usize))))
  (#let pipe-payload-read i32
    (#unsafe (#ptr-read (#ptr-offset pipe-memory 8usize))))
  (#let pipe-read-close i64
    (#call linux-close (#fn-args (fd pipe-read-fd))))
  (#let pipe-write-close i64
    (#call linux-close (#fn-args (fd pipe-write-fd))))
  (#let pipe-unmapped i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-MUNMAP (pipe-memory 4096usize))))
  (#let event-memory (#ptr-mut u64)
    (#unsafe (#linux-syscall (#ptr-mut u64) LINUX-SYS-MMAP
      (0usize 4096usize 3usize 34usize -1i64 0usize))))
  (#let event-descriptor i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-EVENTFD2 (0usize 0usize))))
  (#let event-payload-set () (#unsafe (#ptr-write event-memory 7u64)))
  (#let event-write-count i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-WRITE
      (event-descriptor event-memory 8usize))))
  (#let event-read-count i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-READ
      (event-descriptor event-memory 8usize))))
  (#let event-payload u64 (#unsafe (#ptr-read event-memory)))
  (#let event-closed i64
    (#call linux-close (#fn-args (fd event-descriptor))))
  (#let event-unmapped i64
    (#unsafe (#linux-syscall i64 LINUX-SYS-MUNMAP (event-memory 4096usize))))
  (#let-mut time LinuxTimespec
    (#struct-literal LinuxTimespec ((seconds 0i64) (nanoseconds 0i64))))
  (#let clock i64
    (#call linux-clock-gettime (#fn-args (clock-id 0i64) (time (#borrow-mut time)))))
  (#let seconds i64 (#get time seconds))
  (#let nanoseconds i64 (#get time nanoseconds))
  (#let-mut zero-request LinuxTimespec
    (#struct-literal LinuxTimespec ((seconds 0i64) (nanoseconds 1000000i64))))
  (#let-mut zero-remaining LinuxTimespec
    (#struct-literal LinuxTimespec ((seconds 0i64) (nanoseconds 0i64))))
  (#let slept i64
    (#call linux-nanosleep (#fn-args
      (request (#borrow zero-request))
      (remaining (#borrow-mut zero-remaining)))))
  (#let-mut random-byte u8 0u8)
  (#let random-result i64
    (#call linux-getrandom-byte (#fn-args (destination (#borrow-mut random-byte)))))
  (#let remaining-seconds i64 (#get zero-remaining seconds))
  (#let remaining-nanoseconds i64 (#get zero-remaining nanoseconds))
  (#let identity-ok bool
    (#bool.&& (#i64.!= pid 0i64)
      (#bool.&& (#i64.!= asm_pid 0i64)
        (#bool.&& (#i64.>= uid 0i64)
          (#bool.&& (#i64.>= gid 0i64)
            (#bool.&& (#i64.>= euid 0i64) (#i64.>= egid 0i64)))))))
  (#let credential-queries-ok bool
    (#bool.&& (#i64.== getresuid-result 0i64)
      (#bool.&& (#i64.== (#as real-uid i64) uid)
        (#bool.&& (#i64.== (#as effective-uid i64) euid)
          (#bool.&& (#u32.>= saved-uid 0u32)
            (#bool.&& (#i64.== getresgid-result 0i64)
              (#bool.&& (#i64.== (#as real-gid i64) gid)
                (#bool.&& (#i64.== (#as effective-gid i64) egid)
                  (#bool.&& (#u32.>= saved-gid 0u32)
                    (#bool.&& (#i64.>= supplementary-groups 0i64)
                      (#i64.== identity-memory-unmapped 0i64)))))))))))
  (#let process-ok bool
    (#bool.&& (#i64.!= ppid 0i64)
      (#bool.&& (#i64.> pgrp 0i64)
        (#bool.&& (#i64.== queried-pgrp pgrp)
          (#bool.&& (#i64.> sid 0i64)
            (#bool.&& (#i64.>= priority 1i64)
              (#bool.&& (#i64.<= priority 40i64)
                (#bool.&& (#i64.!= tid 0i64) (#i64.== yielded 0i64)))))))))
  (#let descriptor-errors-ok bool
    (#bool.&& (#i64.== failed_close -9i64)
      (#bool.&& (#i64.== failed_dup -9i64)
        (#bool.&& (#i64.== failed_seek -9i64)
          (#bool.&& (#i64.== failed_sync -9i64)
            (#bool.&& (#i64.== failed_truncate -9i64)
              (#bool.&& (#i64.== uname-result 0i64)
                (#bool.&& (#u8.== uname-first-byte 76u8)
                  (#bool.&& (#i64.== random-buffer-count 4i64)
                    (#bool.&& (#i64.>= null-device 0i64)
                      (#bool.&& (#i64.== close-null-device 0i64)
                  (#bool.&& (#i64.== advice -9i64) (#i64.== alive 0i64)))))))))))))
  (#let extra-descriptor-errors-ok bool
    (#bool.&& (#call is-ebadf (#fn-args (status failed_fstat)))
      (#bool.&& (#call is-ebadf (#fn-args (status failed_ioctl)))
        (#bool.&& (#call is-ebadf (#fn-args (status failed_fcntl)))
          (#bool.&& (#call is-ebadf (#fn-args (status failed_flock)))
            (#bool.&& (#call is-ebadf (#fn-args (status failed_fdatasync)))
              (#bool.&& (#call is-ebadf (#fn-args (status failed_fchdir)))
                (#bool.&& (#call is-ebadf (#fn-args (status failed_fchmod)))
                  (#bool.&& (#call is-ebadf (#fn-args (status failed_fchown)))
                    (#bool.&& (#call is-ebadf (#fn-args (status failed_getdents)))
                      (#bool.&& (#call is-ebadf (#fn-args (status failed_fallocate)))
                        (#call is-ebadf (#fn-args (status failed_dup2))))))))))))))
  (#let path-queries-ok bool
    (#bool.&& (#i64.> readlink-count 0i64)
      (#bool.&& (#u8.== link-first-byte 47u8)
        (#bool.&& (#i64.> cwd-result 0i64)
          (#bool.&& (#u8.== cwd-first-byte 47u8)
            (#bool.&& (#i64.== protected 0i64)
              (#bool.&& (#u8.== protected-first-byte 47u8)
                (#bool.&& (#i64.== unprotected 0i64)
                  (#bool.&& (#i64.== advised 0i64)
                    (#bool.&& (#u8.== preserved-edge 42u8)
                      (#u8.== expanded-edge 84u8)))))))))))
  (#let memory-time-ok bool
    (#bool.&& (#i64.== parent_query 0i64)
      (#bool.&& (#bool.== (#ptr-is-null mapping) false)
        (#bool.&& (#i64.== unmapped 0i64)
              (#bool.&& (#i64.== clock 0i64)
                (#bool.&& (#i64.>= seconds 0i64)
                  (#bool.&& (#u8.== edge-byte 42u8)
                    (#bool.&& (#i64.>= nanoseconds 0i64)
                      (#bool.&& (#i64.< nanoseconds 1000000000i64)
                        (#bool.&& (#i64.== slept 0i64)
                          (#bool.&& (#i64.== remaining-seconds 0i64)
                            (#bool.&& (#i64.>= remaining-nanoseconds 0i64)
                              (#bool.&& (#i64.< remaining-nanoseconds 1000000000i64)
                                (#i64.== random-result 1i64))))))))))))))
  (#let pointer-widths-ok bool
    (#bool.&& (#i16.== value-i16 -1234i16)
      (#bool.&& (#i64.== unmapped-i16 0i64)
        (#bool.&& (#i32.== value-i32 -123456789i32)
          (#bool.&& (#i64.== unmapped-i32 0i64)
            (#bool.&& (#u32.== value-u32 4294967295u32)
              (#i64.== unmapped-u32 0i64)))))))
  (#let pipe-io-ok bool
    (#bool.&& (#i64.== pipe-created 0i64)
      (#bool.&& (#i64.== pipe-write-count 4i64)
        (#bool.&& (#i64.== pipe-read-count 4i64)
          (#bool.&& (#i32.== pipe-payload-read 305419896i32)
            (#bool.&& (#i64.== pipe-read-close 0i64)
              (#bool.&& (#i64.== pipe-write-close 0i64)
                (#i64.== pipe-unmapped 0i64))))))))
  (#let eventfd-io-ok bool
    (#bool.&& (#i64.>= event-descriptor 0i64)
      (#bool.&& (#i64.== event-write-count 8i64)
        (#bool.&& (#i64.== event-read-count 8i64)
          (#bool.&& (#u64.== event-payload 7u64)
            (#bool.&& (#i64.== event-closed 0i64)
              (#i64.== event-unmapped 0i64)))))))
  (#return
    (#if
      (#bool.&& identity-ok (#bool.&& process-ok
        (#bool.&& credential-queries-ok
          (#bool.&& descriptor-errors-ok
            (#bool.&& extra-descriptor-errors-ok
              (#bool.&& path-queries-ok
                (#bool.&& memory-time-ok
                  (#bool.&& pointer-widths-ok
                    (#bool.&& pipe-io-ok eventfd-io-ok)))))))))
      42u64
      1u64)))
