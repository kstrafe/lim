              (#i64::eq unmapped-u32 0i64)))))))
  (#let pipe-io-ok #bool
    (#bool::and (#i64::eq pipe-created 0i64)
      (#bool::and (#i64::eq pipe-write-count 4i64)
        (#bool::and (#i64::eq pipe-read-count 4i64)
          (#bool::and (#i32::eq pipe-payload-read 305419896i32)
