  (#return
    (#if
      (#bool::and uname-name-ok (#bool::and identity-ok (#bool::and process-ok
        (#bool::and credential-queries-ok
          (#bool::and descriptor-errors-ok
            (#bool::and extra-descriptor-errors-ok
