(#import "../library/linux_x86_64.lim")

; This example is the native x86-64 ABI, not Lim's aggregate representation.
; Loads/stores use assembly so the shared ring accesses and barriers remain
; explicit. One issuer, no SQPOLL, standard 64-byte SQEs and 16-byte CQEs.
(#unsafe-fn ring-load ((base (#ptr-mut u8)) (offset usize)) u32
  (#return (#unsafe (#asm u32 ((rdi base) (rsi offset))
    "mov eax, DWORD PTR [rdi+rsi]\nlfence"))))

(#unsafe-fn ring-store ((base (#ptr-mut u8)) (offset usize) (value u32)) ()
  (#unsafe (#asm () ((rdi base) (rsi offset) (rdx value))
    "mfence\nmov DWORD PTR [rdi+rsi], edx"))
  (#return ()))

(#fn ring-map ((fd i64) (length usize) (offset i64)) (#ptr-mut u8)
  (#let memory (#ptr-mut u8) (#unsafe (#call linux-mmap (#fn-args
    (address (#ptr-null (#ptr-mut u8))) (length length)
    (protection 3u32) (flags 1u32) (fd fd) (offset offset)))))
  (#assert (#unsafe (#asm bool ((rdi memory))
    "cmp rdi, -4095\nsetb al\nmovzx eax, al")))
  (#return memory))

(#fn run-ring ((allow-shared bool)) u64
  ; This region owns every buffer and ring until all requests complete.
  (#return (#unsafe (#block
  (#let memory (#ptr-mut u8) (#call linux-mmap (#fn-args
    (address (#ptr-null (#ptr-mut u8))) (length 4096usize)
    (protection 3u32) (flags 34u32) (fd -1i64) (offset 0i64))))
  ; Zero-initialized io_uring_params occupies 120 bytes at the beginning.
  (#assert (#i64.== (#call linux-io-uring-setup (#fn-args
    (entries 0u32) (parameters memory))) -22i64))
  (#call ring-store (#fn-args (base memory) (offset 8usize) (value 2147483648u32)))
  (#assert (#i64.== (#call linux-io-uring-setup (#fn-args
    (entries 2u32) (parameters memory))) -22i64))
  (#call ring-store (#fn-args (base memory) (offset 8usize) (value 0u32)))
  (#let descriptor i64 (#call linux-io-uring-setup (#fn-args
    (entries 2u32) (parameters memory))))
  (#assert (#i64.>= descriptor 0i64))
  (#let ring u32 (#as descriptor u32))
  (#let sq-count u32 (#call ring-load (#fn-args (base memory) (offset 0usize))))
  (#let cq-count u32 (#call ring-load (#fn-args (base memory) (offset 4usize))))
  (#assert (#u32.== sq-count 2u32))
  (#assert (#u32.>= cq-count 2u32))
  (#let sq-array usize (#as (#call ring-load (#fn-args (base memory) (offset 64usize))) usize))
  (#let cq-array usize (#as (#call ring-load (#fn-args (base memory) (offset 100usize))) usize))
  (#let sq-size usize (#usize.+.wrap sq-array (#usize.*.wrap (#as sq-count usize) 4usize)))
  (#let cq-size usize (#usize.+.wrap cq-array (#usize.*.wrap (#as cq-count usize) 16usize)))
  (#let shared bool (#bool.&& allow-shared (#u32.!= (#u32.&
    (#call ring-load (#fn-args (base memory) (offset 20usize))) 1u32) 0u32)))
  (#let ring-size usize (#if (#bool.&& shared (#usize.> cq-size sq-size)) cq-size sq-size))
  (#let sq (#ptr-mut u8) (#call ring-map (#fn-args
    (fd descriptor) (length ring-size) (offset 0i64))))
  (#let cq (#ptr-mut u8) (#if shared sq (#call ring-map (#fn-args
    (fd descriptor) (length cq-size) (offset 134217728i64)))))
  (#let sqe-size usize (#usize.*.wrap (#as sq-count usize) 64usize))
  (#let sqes (#ptr-mut u8) (#call ring-map (#fn-args
    (fd descriptor) (length sqe-size) (offset 268435456i64))))
  (#let sq-head usize (#as (#call ring-load (#fn-args (base memory) (offset 40usize))) usize))
  (#let sq-tail usize (#as (#call ring-load (#fn-args (base memory) (offset 44usize))) usize))
  (#let sq-mask-offset usize (#as (#call ring-load (#fn-args (base memory) (offset 48usize))) usize))
  (#let sq-mask u32 (#call ring-load (#fn-args (base sq) (offset sq-mask-offset))))
  (#let cq-head usize (#as (#call ring-load (#fn-args (base memory) (offset 80usize))) usize))
  (#let cq-tail usize (#as (#call ring-load (#fn-args (base memory) (offset 84usize))) usize))
  (#let cq-mask-offset usize (#as (#call ring-load (#fn-args (base memory) (offset 88usize))) usize))
  (#let cq-mask u32 (#call ring-load (#fn-args (base cq) (offset cq-mask-offset))))
  (#assert (#u32.== (#u32.+.wrap sq-mask 1u32) sq-count))
  (#assert (#u32.== (#u32.+.wrap cq-mask 1u32) cq-count))
  (#let files (#ptr-mut u8) (#unsafe (#ptr-offset memory 128usize)))
  (#let payload (#ptr-mut u8) (#unsafe (#ptr-offset memory 256usize)))
  (#let received (#ptr-mut u8) (#unsafe (#ptr-offset memory 272usize)))
  (#let file i64 (#call linux-memfd-create (#fn-args (name payload) (flags 1u32))))
  (#assert (#i64.>= file 0i64))
  (#unsafe (#asm () ((rdi files) (rsi file)) "mov DWORD PTR [rdi], esi"))
  (#assert (#i64.== (#call linux-io-uring-register (#fn-args
    (ring ring) (operation 4294967295u32) (argument files) (count 1u32))) -22i64))
  (#assert (#i64.== (#call linux-io-uring-register (#fn-args
    (ring ring) (operation 2u32) (argument files) (count 1u32))) 0i64))
  ; Registered files retain their own reference, even after ordinary close.
  (#assert (#i64.== (#call linux-close (#fn-args (fd file))) 0i64))
  (#assert (#i64.== (#call linux-io-uring-enter (#fn-args
    (ring ring) (submit 0u32) (minimum 0u32) (flags 2147483648u32)
    (argument (#ptr-null (#ptr-mut u8))) (argument-size 0usize))) -22i64))
  (#for-range (iteration u32) 0u32 14u32
    (#let writing bool (#u32.== (#u32.%.wrap iteration 2u32) 0u32))
    (#let opcode u8 (#if (#u32.== iteration 12u32) 255u8 (#if writing 23u8 22u8)))
    (#let file-slot u32 (#if (#u32.== iteration 13u32) 1u32 0u32))
    (#let buffer (#ptr-mut u8) (#if writing payload received))
    (#let cookie u64 (#u64.+.wrap 100u64 (#as iteration u64)))
    (#let expected i32 (#if (#u32.< iteration 12u32) 4i32
      (#if (#u32.== iteration 12u32) -22i32 -9i32)))
    ; Change each write's first byte to detect stale completions/data.
    (#unsafe (#asm () ((rdi payload) (rsi iteration) (rdx received))
      "mov DWORD PTR [rdi], 0x0a524955\nmov eax, esi\nand eax, -2\nadd eax, 65\nmov BYTE PTR [rdi], al\nmov DWORD PTR [rdx], 0"))
    (#let tail u32 (#call ring-load (#fn-args (base sq) (offset sq-tail))))
    (#assert (#u32.== (#call ring-load (#fn-args (base sq) (offset sq-head))) tail))
    (#let slot u32 (#u32.& tail sq-mask))
    (#let sqe (#ptr-mut u8) (#unsafe (#ptr-offset sqes
      (#usize.*.wrap (#as slot usize) 64usize))))
    ; Clear the entire reused SQE, then set opcode, FIXED_FILE, fd index,
    ; buffer, byte count and completion cookie. File offset is explicitly 0.
    (#unsafe (#asm () ((rdi sqe) (rsi buffer) (rdx opcode) (rcx file-slot) (r8 cookie))
      "mov QWORD PTR [rdi], 0\nmov QWORD PTR [rdi+8], 0\nmov QWORD PTR [rdi+16], rsi\nmov QWORD PTR [rdi+24], 4\nmov QWORD PTR [rdi+32], r8\nmov QWORD PTR [rdi+40], 0\nmov QWORD PTR [rdi+48], 0\nmov QWORD PTR [rdi+56], 0\nmov BYTE PTR [rdi], dl\nmov BYTE PTR [rdi+1], 1\nmov DWORD PTR [rdi+4], ecx"))
    (#call ring-store (#fn-args (base sq)
      (offset (#usize.+.wrap sq-array (#usize.*.wrap (#as slot usize) 4usize))) (value slot)))
    (#call ring-store (#fn-args (base sq) (offset sq-tail) (value (#u32.+.wrap tail 1u32))))
    (#assert (#i64.== (#call linux-io-uring-enter (#fn-args
      (ring ring) (submit 1u32) (minimum 1u32) (flags 1u32)
      (argument (#ptr-null (#ptr-mut u8))) (argument-size 0usize))) 1i64))
    (#let head u32 (#call ring-load (#fn-args (base cq) (offset cq-head))))
    (#assert (#u32.== (#call ring-load (#fn-args (base cq) (offset cq-tail)))
      (#u32.+.wrap head 1u32)))
    (#let cqe (#ptr-mut u8) (#unsafe (#ptr-offset cq (#usize.+.wrap cq-array
      (#usize.*.wrap (#as (#u32.& head cq-mask) usize) 16usize)))))
    (#assert (#u64.== (#unsafe (#asm u64 ((rdi cqe)) "mov rax, QWORD PTR [rdi]")) cookie))
    (#assert (#i32.== (#unsafe (#asm i32 ((rdi cqe)) "mov eax, DWORD PTR [rdi+8]")) expected))
    (#assert (#u32.== (#call ring-load (#fn-args (base cqe) (offset 12usize))) 0u32))
    (#call ring-store (#fn-args (base cq) (offset cq-head) (value (#u32.+.wrap head 1u32))))
    (#if (#bool.&& (#bool.! writing) (#u32.< iteration 12u32))
      (#block
        (#assert (#u32.== (#call ring-load (#fn-args (base payload) (offset 0usize)))
          (#call ring-load (#fn-args (base received) (offset 0usize)))))
        (#assert (#i64.== (#call linux-write (#fn-args
          (fd 1i64) (source received) (count 4usize))) 4i64))) ()))
  (#let dropped-offset usize (#as (#call ring-load (#fn-args (base memory) (offset 60usize))) usize))
  (#let overflow-offset usize (#as (#call ring-load (#fn-args (base memory) (offset 96usize))) usize))
  (#assert (#u32.== (#call ring-load (#fn-args (base sq) (offset dropped-offset))) 0u32))
  (#assert (#u32.== (#call ring-load (#fn-args (base cq) (offset overflow-offset))) 0u32))
  (#assert (#i64.== (#call linux-io-uring-register (#fn-args
    (ring ring) (operation 3u32) (argument (#ptr-null (#ptr-mut u8))) (count 0u32))) 0i64))
  (#assert (#i64.== (#call linux-munmap (#fn-args (address sqes) (length sqe-size))) 0i64))
  (#if (#bool.! shared)
    (#assert (#i64.== (#call linux-munmap (#fn-args (address cq) (length cq-size))) 0i64)) ())
  (#assert (#i64.== (#call linux-munmap (#fn-args (address sq) (length ring-size))) 0i64))
  (#assert (#i64.== (#call linux-close (#fn-args (fd descriptor))) 0i64))
  (#assert (#i64.== (#call linux-io-uring-enter (#fn-args
    (ring ring) (submit 0u32) (minimum 0u32) (flags 0u32)
    (argument (#ptr-null (#ptr-mut u8))) (argument-size 0usize))) -9i64))
  (#assert (#i64.== (#call linux-munmap (#fn-args (address memory) (length 4096usize))) 0i64))
  42u64))))

(#fn main () u64
  ; Cover both the advertised SINGLE_MMAP optimization and separate mappings.
  (#assert (#u64.== (#call run-ring (#fn-args (allow-shared true))) 42u64))
  (#assert (#u64.== (#call run-ring (#fn-args (allow-shared false))) 42u64))
  (#return 42u64))
