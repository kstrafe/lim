#fn make {
  #params = ((last #u64));
  #returns = (#tuple #u64 #u64 #u64 #u64 #u64 #u64 #u64);
  #body = ((#return (#tuple (#tuple #u64 #u64 #u64 #u64 #u64 #u64 #u64) 1u64 2u64 3u64 4u64 5u64
        6u64 last)));
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let values (#tuple #u64 #u64 #u64 #u64 #u64 #u64 #u64) (#call make ((last 42u64))))
    (#return (#get values 6))
  );
}
