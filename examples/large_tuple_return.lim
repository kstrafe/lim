(#fn make ((last #u64)) (#tuple #u64 #u64 #u64 #u64 #u64 #u64 #u64)
  (#return
    (#tuple (#tuple #u64 #u64 #u64 #u64 #u64 #u64 #u64)
      1u64 2u64 3u64 4u64 5u64 6u64 last)))

(#fn main () #u64
  (#let values (#tuple #u64 #u64 #u64 #u64 #u64 #u64 #u64) (#call make (: last 42u64)))
  (#return (#get values 6)))
