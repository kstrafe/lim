; Constructors determine their result length; the recursive tail has the
; explicitly stated predecessor length.
(#math-inductive vector (u)
  ((A (#pt-type u)))
  (#indices
    (#parameter length #pt-nat))
  (#pt-type u)
  ((nil () (#pt-zero)) (cons ((n #pt-nat) (head A) (tail (#pt-self-at (n)))) ((#pt-succ n)))))
; The motive binds an arbitrary length and a vector at that length. Each
; recursive tail is followed by its count, computed at the tail's own index.
(#math-definition vector-count (u)
  (#pt-pi ((A (#pt-type u)) (n #pt-nat) (xs (#pt-app (#pt-use vector (u)) A n))) #pt-nat)
  (#pt-lambda
    ((A (#pt-type u)) (n #pt-nat) (xs (#pt-app (#pt-use vector (u)) A n)))
    (#pt-induct
      vector
      (u)
      (A)
      (#indices n)
      (#pt-lambda ((length #pt-nat) (items (#pt-app (#pt-use vector (u)) A length))) #pt-nat)
      (#pt-zero
        (#pt-lambda
          ((k #pt-nat) (head A) (tail (#pt-app (#pt-use vector (u)) A k)) (tail-count #pt-nat))
          (#pt-succ tail-count)))
      xs)))
; This is a proof for every element type and every mathematical Nat length,
; not a bounded enumeration. The recursive IH relates the tail's count to k.
(#theorem vector-count-correct
  (#universes u)
  (#parameters
    (#parameter A (#pt-type u))
    (#parameter n #pt-nat)
    (#parameter xs (#pt-app (#pt-use vector (u)) A n)))
  (#statement (#pt-eq #pt-nat (#pt-app (#pt-use vector-count (u)) A n xs) n))
  (#proof
    (#pt-induct
      vector
      (u)
      (A)
      (#indices n)
      (#pt-lambda
        ((length #pt-nat) (items (#pt-app (#pt-use vector (u)) A length)))
        (#pt-eq #pt-nat (#pt-app (#pt-use vector-count (u)) A length items) length))
      (
        (#pt-refl #pt-nat #pt-zero)
        (#pt-lambda
          (
            (k #pt-nat)
            (head A)
            (tail (#pt-app (#pt-use vector (u)) A k))
            (ih (#pt-eq #pt-nat (#pt-app (#pt-use vector-count (u)) A k tail) k)))
          (#pt-let
            (#parameter counted #pt-nat)
            (#pt-app (#pt-use vector-count (u)) A k tail)
            (#pt-eq-elim
              #pt-nat
              counted
              (#pt-lambda
                ((actual #pt-nat) (evidence (#pt-eq #pt-nat counted actual)))
                (#pt-eq #pt-nat (#pt-succ counted) (#pt-succ actual)))
              (#pt-refl #pt-nat (#pt-succ counted))
              k
              ih))))
      xs)))

(#fn main () #u64
  (#return 42u64))
