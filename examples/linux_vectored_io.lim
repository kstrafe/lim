(#alias lINUX-SYS-MMAP = ../library/linux_x86_64_syscall_numbers.lim::lINUX-SYS-MMAP)
(#alias lINUX-SYS-MUNMAP = ../library/linux_x86_64_syscall_numbers.lim::lINUX-SYS-MUNMAP)
(#alias linux-close = ../library/linux_x86_64.lim::linux-close)
(#alias linux-lseek = ../library/linux_x86_64.lim::linux-lseek)
(#alias linux-memfd-create = ../library/linux_x86_64.lim::linux-memfd-create)
(#alias linux-preadv = ../library/linux_x86_64.lim::linux-preadv)
(#alias linux-preadv2 = ../library/linux_x86_64.lim::linux-preadv2)
(#alias linux-pwritev = ../library/linux_x86_64.lim::linux-pwritev)
(#alias linux-pwritev2 = ../library/linux_x86_64.lim::linux-pwritev2)
(#alias linux-readv = ../library/linux_x86_64.lim::linux-readv)
(#alias linux-write-byte = ../library/linux_x86_64.lim::linux-write-byte)
(#alias linux-writev = ../library/linux_x86_64.lim::linux-writev)

// The Linux x86-64 iovec ABI is a pointer followed by an 8-byte length.
// SAFETY: slot supplies 16 exclusively writable bytes. The eventual syscall
// caller must separately prove validity of the stored base/length region.
(#unsafe-fn set-iovec ((slot (#ptr-mut #u8)) (base (#ptr-mut #u8)) (length #usize)) ()
  (#unsafe (#asm () ((rdi slot) (rsi base) (rdx length))
    "mov QWORD PTR [rdi], rsi\nmov QWORD PTR [rdi+8], rdx"))
  (#return ()))

(#fn main () #u64
  (#let data (#ptr-mut #u8)
    (#unsafe (#linux-syscall (#ptr-mut #u8) lINUX-SYS-MMAP
      (0usize 4096usize 3usize 34usize -1i64 0usize))))
  (#let vectors (#ptr-mut #u8)
    (#unsafe (#linux-syscall (#ptr-mut #u8) lINUX-SYS-MMAP
      (0usize 4096usize 3usize 34usize -1i64 0usize))))
  (#unsafe (#block
    (#ptr-write data 118u8)
    (#ptr-write (#ptr-offset data 1usize) 101u8)
    (#ptr-write (#ptr-offset data 2usize) 99u8)
    (#ptr-write (#ptr-offset data 16usize) 65u8)
    (#ptr-write (#ptr-offset data 17usize) 66u8)
    (#ptr-write (#ptr-offset data 18usize) 67u8)
    (#ptr-write (#ptr-offset data 19usize) 68u8)
    (#unsafe-call set-iovec ((slot vectors) (base (#ptr-offset data 16usize)) (length 2usize)))
    (#unsafe-call set-iovec ((slot (#ptr-offset vectors 16usize)) (base (#ptr-offset data 18usize)) (length 2usize)))
    ()))
  (#let fd #i64
    (#unsafe (#unsafe-call linux-memfd-create ((name data) (flags 1u32)))))
  (#let gathered #i64
    (#unsafe (#unsafe-call linux-writev ((fd fd) (iovecs vectors) (count 2i32)))))
  (#let invalid-vector-count #i64
    (#unsafe (#unsafe-call linux-writev ((fd fd) (iovecs vectors) (count -1i32)))))
  (#unsafe (#block
    (#unsafe-call set-iovec ((slot vectors) (base (#ptr-offset data 32usize)) (length 2usize)))
    (#unsafe-call set-iovec ((slot (#ptr-offset vectors 16usize)) (base (#ptr-offset data 34usize)) (length 2usize)))
    ()))
  (#let seek-start #i64
    (#call linux-lseek ((fd fd) (offset 0i64) (whence 0i64))))
  (#let scattered #i64
    (#unsafe (#unsafe-call linux-readv ((fd fd) (iovecs vectors) (count 2i32)))))
  (#let first-byte #u8 (#unsafe (#ptr-read (#ptr-offset data 32usize))))
  (#let fourth-byte #u8 (#unsafe (#ptr-read (#ptr-offset data 35usize))))
  (#unsafe (#block
    (#unsafe-call set-iovec ((slot vectors) (base (#ptr-offset data 16usize)) (length 2usize)))
    (#unsafe-call set-iovec ((slot (#ptr-offset vectors 16usize)) (base (#ptr-offset data 18usize)) (length 2usize)))
    ()))
  (#let positioned-written #i64
    (#unsafe (#unsafe-call linux-pwritev ((fd fd) (iovecs vectors) (count 2i32) (offset 8i64)))))
  (#let positioned-written-v2 #i64
    (#unsafe (#unsafe-call linux-pwritev2 ((fd fd) (iovecs vectors) (count 2i32) (offset 16i64) (flags 0i32)))))
  (#unsafe (#block
    (#ptr-write (#ptr-offset data 32usize) 0u8)
    (#ptr-write (#ptr-offset data 35usize) 0u8)
    (#unsafe-call set-iovec ((slot vectors) (base (#ptr-offset data 32usize)) (length 2usize)))
    (#unsafe-call set-iovec ((slot (#ptr-offset vectors 16usize)) (base (#ptr-offset data 34usize)) (length 2usize)))
    ()))
  (#let positioned-read #i64
    (#unsafe (#unsafe-call linux-preadv ((fd fd) (iovecs vectors) (count 2i32) (offset 8i64)))))
  (#let positioned-first #u8 (#unsafe (#ptr-read (#ptr-offset data 32usize))))
  (#let positioned-fourth #u8 (#unsafe (#ptr-read (#ptr-offset data 35usize))))
  (#unsafe (#block
    (#ptr-write (#ptr-offset data 32usize) 0u8)
    (#ptr-write (#ptr-offset data 35usize) 0u8)
    ()))
  (#let positioned-read-v2 #i64
    (#unsafe (#unsafe-call linux-preadv2 ((fd fd) (iovecs vectors) (count 2i32) (offset 16i64) (flags 0i32)))))
  (#let positioned-v2-first #u8
    (#unsafe (#ptr-read (#ptr-offset data 32usize))))
  (#let positioned-v2-fourth #u8
    (#unsafe (#ptr-read (#ptr-offset data 35usize))))
  (#let position-after-positioned-io #i64
    (#call linux-lseek ((fd fd) (offset 0i64) (whence 1i64))))
  (#let end-position #i64
    (#call linux-lseek ((fd fd) (offset 0i64) (whence 2i64))))
  (#let fd-closed #i64 (#call linux-close ((fd fd))))
  (#let data-unmapped #i64
    (#unsafe (#linux-syscall #i64 lINUX-SYS-MUNMAP (data 4096usize))))
  (#let vectors-unmapped #i64
    (#unsafe (#linux-syscall #i64 lINUX-SYS-MUNMAP (vectors 4096usize))))
  (#let vectored-ok #bool
    (#bool::and (#i64::ge fd 0i64)
      (#bool::and (#i64::eq gathered 4i64)
        (#bool::and (#i64::eq invalid-vector-count -22i64)
          (#bool::and (#i64::eq seek-start 0i64)
            (#bool::and (#i64::eq scattered 4i64)
              (#bool::and (#u8::eq first-byte 65u8)
                (#bool::and (#u8::eq fourth-byte 68u8)
                  (#bool::and (#i64::eq positioned-written 4i64)
                    (#bool::and (#i64::eq positioned-written-v2 4i64)
                      (#bool::and (#i64::eq positioned-read 4i64)
                        (#bool::and (#u8::eq positioned-first 65u8)
                          (#bool::and (#u8::eq positioned-fourth 68u8)
                            (#bool::and (#i64::eq positioned-read-v2 4i64)
                              (#bool::and (#u8::eq positioned-v2-first 65u8)
                                (#bool::and (#u8::eq positioned-v2-fourth 68u8)
                                  (#bool::and (#i64::eq position-after-positioned-io 4i64)
                                    (#bool::and (#i64::eq end-position 20i64)
                                      (#bool::and (#i64::eq fd-closed 0i64)
                                        (#bool::and (#i64::eq data-unmapped 0i64)
                                          (#i64::eq vectors-unmapped 0i64)))))))))))))))))))))
  (#return (#if vectored-ok
    (#block
      (#let-mut byte #u8 86u8)
      (#let first #i64
        (#call linux-write-byte ((source (#borrow byte)))))
      (#set byte 10u8)
      (#let second #i64
        (#call linux-write-byte ((source (#borrow byte)))))
      (#if (#bool::and (#i64::eq first 1i64) (#i64::eq second 1i64))
        42u64 1u64))
    1u64)))
