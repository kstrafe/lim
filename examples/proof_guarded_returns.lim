; The weak contract retains the checked condition selecting a return origin.
(#fn choose (: condition #bool : left (#ref-mut #u8) : right (#ref-mut #u8)) (#ref-mut #u8)
  (#return
    (#if condition
      left
      right)))

(#theorem choose-origins
  (#proof-contract choose true true))

(#fn update-choice (: condition #bool : left (#ref-mut #u8) : right (#ref-mut #u8) : value #u8) ()
  (#let selected (#ref-mut #u8) (#call choose (: condition condition : left left : right right)))
  (#deref-set selected value)
  (#forget selected)
  (#return ()))

(#theorem update-choice-contract
  (#proof-using
    (choose-origins)
    (#proof-contract
      update-choice
      true
      (#proof-and
        (#proof-eq
          (#deref left)
          (#if condition
            value
            (#proof-old (#deref left))))
        (#proof-eq
          (#deref right)
          (#if condition
            (#proof-old (#deref right))
            value))))))

(#fn main () #u64
  (#let-mut left #u8 4u8)
  (#let-mut right #u8 7u8)
  (#call update-choice
    (: condition false : left (#borrow-mut left) : right (#borrow-mut right) : value 9u8))
  (#return (#u64::add-wrap (#u64::mul-wrap (#as left #u64) 10u64) (#as right #u64))))
