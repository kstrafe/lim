#fn
    classify {
  #params = (
      (value #u64)
    );
  #returns = #u64;
  #body = (
    (
      #return
      (
        #match
        value
        (#case 0 10)
        (#case 1 20)
        (#case _ 30)
      )
    )
  );
}

#fn
    main {
  #params = ();
  #returns = #u64;
  #body = (
    (
      #return
      (#call classify ((value 1)))
    )
  );
}
