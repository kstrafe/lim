(#alias linux-brk = ../library/linux_x86_64.lim::linux-brk)
(#alias linux-personality = ../library/linux_x86_64.lim::linux-personality)
(#alias linux-write = ../library/linux_x86_64.lim::linux-write)

; Standalone, single-threaded executable: no other allocator owns the break.
(#fn main () #u64
  (#let persona #i64 (#unsafe (#unsafe-call linux-personality (: persona 4294967295u32))))
  (#assert (#i64::ge persona 0i64))
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-personality (: persona (#as persona #u32)))) persona))
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-personality (: persona 4294967295u32))) persona))
  (#let initial #usize (#unsafe (#unsafe-call linux-brk (: address 0usize))))
  (#assert (#usize::gt initial 0usize))
  (#let requested #usize (#usize::add-wrap initial 8192usize))
  (#assert (#usize::gt requested initial))
  (#assert (#usize::eq (#unsafe (#unsafe-call linux-brk (: address requested))) requested))
  (#let memory (#ptr-mut #u8)
    (#unsafe (#asm (#ptr-mut #u8) ((rdi initial)) "mov rax, rdi")))
  (#unsafe (#ptr-write memory 72u8))
  (#unsafe (#ptr-write (#ptr-offset memory 1usize) 10u8))
  (#unsafe (#ptr-write (#ptr-offset memory 8191usize) 90u8))
  (#assert (#u8::eq (#unsafe (#ptr-read (#ptr-offset memory 8191usize))) 90u8))
  ; Impossible growth leaves the break unchanged; there is no -ENOMEM result.
  (#assert (#usize::eq (#unsafe (#unsafe-call linux-brk (: address 18446744073709551615usize))) requested))
  (#assert (#usize::eq (#unsafe (#unsafe-call linux-brk (: address 0usize))) requested))
  (#let middle #usize (#usize::add-wrap initial 4096usize))
  (#assert (#usize::eq (#unsafe (#unsafe-call linux-brk (: address middle))) middle))
  ; The first page remains usable after shrinking by one page.
  (#assert (#u8::eq (#unsafe (#ptr-read memory)) 72u8))
  (#let written #i64 (#unsafe (#unsafe-call linux-write (: fd 1i64 : source memory : count 2usize))))
  (#assert (#usize::eq (#unsafe (#unsafe-call linux-brk (: address initial))) initial))
  (#assert (#usize::eq (#unsafe (#unsafe-call linux-brk (: address 0usize))) initial))
  ; Do not access memory after restoring the original break.
  (#assert (#i64::eq written 2i64))
  (#return 42u64))
