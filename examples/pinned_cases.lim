#struct Payload () ((value #u64))
#enum Choice () ((Choice.Empty) (Choice.Full Payload))

#fn inspect {
  #params = ((choice (#pin-ref Choice)));
  #returns = #u64;
  #body = (
    (#return
      (#match choice
        (#case-pin (Choice.Full payload) (#get payload value))
        (#case-pin Choice.Empty 0u64)))
  );
}

#fn update {
  #params = ((choice (#pin-ref-mut Choice)));
  #returns = #u64;
  #body = (
    (#return
      (#match choice
        (#case-pin-mut (Choice.Full payload)
          (#pin-set-field payload value 42u64)
          (#get payload value))
        (#case-pin-mut Choice.Empty 0u64)))
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let-mut choice Choice (Choice.Full (#struct-literal Payload ((value 41u64)))))
    (#let pin (#pin-ref-mut Choice) (#pin choice))
    (#let observed #u64 (#call inspect ((choice (#pin-borrow (#deref pin))))))
    (#let changed #u64 (#call update ((choice (#pin-borrow-mut (#deref pin))))))
    (#forget pin)
    (#forget choice)
    (#return (#u64::add-wrap observed changed))
  );
}
