// Linux AArch64 getpid=172/write=64; x86-64 getpid=39/write=1.
// Writes '*' and exits with status 42; no runtime library or dynamic loader.
#cfg-if (#cfg-is #arch aarch64) (#fn main {
    #params = ();
    #returns = #u64;
    #body = (
      (#let process #i64 (#unsafe
          (#linux-syscall #i64 172usize ())
        ))
      (#assert (#i64::gt process 0i64))
      (#let byte #u64 42u64)
      (#let written #i64 (#unsafe
          (#linux-syscall #i64 64usize (1i64 (#borrow byte) 1usize))
        ))
      (#assert (#i64::eq written 1i64))
      (#return 42u64)
    );
  }) (#cfg-else (#fn main {
      #params = ();
      #returns = #u64;
      #body = (
        (#let process #i64 (#unsafe
            (#linux-syscall #i64 39usize ())
          ))
        (#assert (#i64::gt process 0i64))
        (#let byte #u64 42u64)
        (#let written #i64 (#unsafe
            (#linux-syscall #i64 1usize (1i64 (#borrow byte) 1usize))
          ))
        (#assert (#i64::eq written 1i64))
        (#return 42u64)
      );
    }))
