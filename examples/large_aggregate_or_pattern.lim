(#struct LargeOr ()
  ((a #u64) (b #u64) (c #u64) (d #u64)
   (e #u64) (f #u64) (g #u64)))

(#fn main () #u64
  (#let tuple-value (#tuple #u64 #u64 #u64 #u64 #u64 #u64 #u64)
    (#tuple (#tuple #u64 #u64 #u64 #u64 #u64 #u64 #u64)
      1u64 2u64 3u64 4u64 5u64 6u64 42u64))
  (#let struct-value LargeOr
    (#struct-literal LargeOr ((a 1u64) (b 2u64) (c 3u64) (d 4u64) (e 5u64) (f 6u64) (g 42u64))))
  (#return
    (#u64.+.wrap
      (#match tuple-value
        (#case (#or (#tuple 1 2 3 4 5 6 41)
              (#tuple 1 2 3 4 5 6 42)) 20u64)
        (#case _ 0u64))
      (#match struct-value
        (#case (#or (LargeOr 1 2 3 4 5 6 41)
              (LargeOr 1 2 3 4 5 6 42)) 22u64)
        (#case _ 0u64)))))
