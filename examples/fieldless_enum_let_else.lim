#enum Color () (Color.Red Color.Green Color.Blue)

#fn classify {
  #params = ((value Color));
  #returns = #u64;
  #body = ((#let-else (#or Color.Green Color.Blue) Color value (#return 0u64)) (#return 42u64));
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = ((#return (#call classify ((value Color.Green)))));
}
