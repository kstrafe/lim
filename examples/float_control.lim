#fn
    choose {
  #params = (
      (flag #bool)
    );
  #returns = #f32;
  #body = (
    (
      #return
      (#if flag 1.5 2.5)
    )
  );
}

#fn
    main {
  #params = ();
  #returns = #u64;
  #body = (
    (
      #return
      (
        #if
        (#f32::gt
          (#call choose ((flag true)))
          1.0
        )
        42
        0
      )
    )
  );
}
