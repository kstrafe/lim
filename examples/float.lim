(
  #fn
  add
  (
    (left f64)
    (right f64)
  )
  f64
  (
    #return
    (#f64.+  left right)
  )
)

(
  #fn
  choose
  (
    (value u64)
    (scale f64)
  )
  u64
  (
    #return
    (
      #if
      (#f64.>  scale 1.0)
      value
      0
    )
  )
)

(
  #fn
  main
  ()
  u64
  (#let left f64 1.5)
  (#let right f64 2.25)
  (
    #let
    total
    f64
    (add left right)
  )
  (
    #return
    (
      #if
      (#f64.>  total 3.0)
      (choose 42 2.0)
      0
    )
  )
)
