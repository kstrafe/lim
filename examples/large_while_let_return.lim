#fn values () (#array #u64 7)
    (#return (#array-of (#array #u64 7)
      1u64 2u64 3u64 4u64 5u64 6u64 42u64))

#fn main () #u64
    (#let-mut value (#array #u64 7) (#call values ()))
    (#let-mut total #u64 0u64)
    (#while-let
      (#array 1u64 _ _ _ _ _ _)
      value
      (#set total (#index value 6u64))
      (#set-index value 0u64 0u64))
    (#return total)
