; Checked structural definitions, not machine integers or opaque arithmetic.
; The kernel batches constant-increment folds without expanding their counts.
(#math-definition add ()
  (#pt-pi ((left #pt-nat) (right #pt-nat)) #pt-nat)
  (#pt-lambda ((left #pt-nat) (right #pt-nat))
    (#pt-nat-induct (#pt-lambda ((index #pt-nat)) #pt-nat) left
      (#pt-lambda ((previous #pt-nat) (sum #pt-nat)) (#pt-succ sum)) right)))

(#math-definition multiply ()
  (#pt-pi ((left #pt-nat) (right #pt-nat)) #pt-nat)
  (#pt-lambda ((left #pt-nat) (right #pt-nat))
    (#pt-nat-induct (#pt-lambda ((index #pt-nat)) #pt-nat) #pt-zero
      (#pt-lambda ((previous #pt-nat) (product #pt-nat))
        (#pt-app (#pt-use add ()) product left)) right)))

(#theorem large-addition
  (#universes)
  (#parameters)
  (#statement (#pt-eq #pt-nat
    (#pt-app (#pt-use add ())
      (#pt-nat-literal #pt-nat "184467440737095516160")
      (#pt-nat-literal #pt-nat "340282366920938463463374607431768211456"))
    (#pt-nat-literal #pt-nat "340282366920938463647842048168863727616")))
  (#proof (#pt-refl #pt-nat
    (#pt-nat-literal #pt-nat "340282366920938463647842048168863727616"))))

(#theorem large-multiplication
  (#universes)
  (#parameters)
  (#statement (#pt-eq #pt-nat
    (#pt-app (#pt-use multiply ())
      (#pt-nat-literal #pt-nat "184467440737095516160")
      (#pt-nat-literal #pt-nat "100000000000000000000"))
    (#pt-nat-literal #pt-nat "18446744073709551616000000000000000000000")))
  (#proof (#pt-refl #pt-nat
    (#pt-nat-literal #pt-nat "18446744073709551616000000000000000000000"))))

(#fn main () #u64
  (#return 42u64))
