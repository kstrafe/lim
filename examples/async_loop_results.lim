// A suspended value loop can break with ordinary expressions, including a
// function call returning a linear struct. The struct is consumed explicitly.
#struct Token () ((value #u64))

#fn make-token {
  #params = ((value #u64));
  #returns = Token;
  #body = ((#return (#struct-literal Token ((value value)))));
}

#fn consume-token {
  #params = ((token Token));
  #returns = #u64;
  #body = ((#let value #u64 (#get token value)) (#forget token) (#return value));
}

#enum Step (#linear) ((Step.Waiting #u64) (Step.Resuming #u64))

#enum StepPoll () ((StepPoll.StepPending Step) (StepPoll.StepReady #u64))

#fn step-poll {
  #params = ((task Step) (waker (#ref #u64)));
  #returns = StepPoll;
  #body = ((#return (#match task
        (#case (Step.Waiting value)
          (StepPoll.StepPending (Step.Resuming value))
        )
        (#case (Step.Resuming value)
          (StepPoll.StepReady value)
        )
      )));
}

#generate #async-fn ((protocol WorkAwait) (waker #u64) (function (#fn work () #u64 (#let result
        #u64 (#call consume-token ((token (#loop
                (#let awaited #u64 (#await #u64 Step StepPoll.StepPending StepPoll.StepReady
                    step-poll (Step.Waiting 41u64)))
                (#if (#u64::eq awaited 41u64)
                  (#break (#call make-token ((value (#u64::add-wrap awaited 1u64)))))
                  (#break (#struct-literal Token ((value 0u64))))
                )
              ))))) (#return result))))

#fn main {
  #params = ();
  #returns = #u64;
  #effects = ((#effects-of Work::poll));
  #body = (
    (#let waker #u64 0u64)
    (#let first Work::Poll (#call Work::poll ((task (#call work ())) (waker (#borrow waker)))))
    (#let-else (Work::Poll.Pending pending) Work::Poll first (#unreachable))
    (#let second Work::Poll (#call Work::poll ((task pending) (waker (#borrow waker)))))
    (#forget waker)
    (#return (#match second
        (#case (Work::Poll.Ready value)
          value
        )
        (#case (Work::Poll.Pending unexpected)
          (#block
            (#forget unexpected)
            (#unreachable)
          )
        )
      ))
  );
}
