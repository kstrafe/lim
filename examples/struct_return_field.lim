#struct
    Point ()
    (
      (x #u64)
      (y #u64)
    )

#fn
    make {
  #params = ();
  #returns = Point;
  #body = (
    (
      #return
      (#struct-literal Point ((x 7) (y 9)))
    )
  );
}

#fn
    main {
  #params = ();
  #returns = #u64;
  #body = (
    (
      #return
      (
        #get
        (#call make ())
        y
      )
    )
  );
}
