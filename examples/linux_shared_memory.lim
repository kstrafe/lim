(#import "../library/linux_x86_64.lim")

; Raw pointer-returning syscalls retain negative errno bit patterns.
(#fn valid-mapping ((address (#ptr-mut u8))) bool
  (#return (#unsafe (#asm bool ((rdi address))
    "xor eax, eax\ncmp rdi, -4095\nsetb al"))))

(#fn main () u64
  (#let null (#ptr-mut u8) (#ptr-null (#ptr-mut u8)))
  (#assert (#i64.== (#call linux-shmget (: key 0i32 : size 0usize : flags 384i32)) -22i64))
  ; IPC_PRIVATE with mode 0600 creates a fresh segment for this test.
  (#let segment i64 (#call linux-shmget (: key 0i32 : size 4096usize : flags 384i32)))
  (#assert (#i64.>= segment 0i64))
  (#let first (#ptr-mut u8) (#unsafe (#call linux-shmat (: segment (#as segment i32) : address null : flags 0i32))))
  ; Mark for deletion immediately. Linux keeps an attached segment alive
  ; and permits further attachments until the last mapping is detached.
  (#let marked i64 (#unsafe (#call linux-shmctl (: segment (#as segment i32) : command 0i32 : buffer null))))
  (#assert (#i64.== marked 0i64))
  (#assert (#call valid-mapping (: address first)))
  (#let second (#ptr-mut u8) (#unsafe (#call linux-shmat (: segment (#as segment i32) : address null : flags 4096i32))))
  (#assert (#call valid-mapping (: address second)))
  (#assert (#u8.== (#unsafe (#ptr-read first)) 0u8))
  (#unsafe (#block
    (#ptr-write first 72u8)
    (#ptr-write (#ptr-offset first 1usize) 10u8)
    ()))
  (#assert (#u8.== (#unsafe (#ptr-read second)) 72u8))
  (#assert (#i64.== (#unsafe (#call linux-shmdt (: address first))) 0i64))
  ; The read-only second attachment still retains the segment and its data.
  (#assert (#u8.== (#unsafe (#ptr-read (#ptr-offset second 1usize))) 10u8))
  (#assert (#i64.== (#unsafe (#call linux-write (: fd 1i64 : source second : count 2usize))) 2i64))
  (#assert (#i64.== (#unsafe (#call linux-shmdt (: address second))) 0i64))
  (#assert (#i64.== (#unsafe (#call linux-shmctl (: segment (#as segment i32) : command 2i32 : buffer null))) -22i64))
  (#assert (#i64.== (#unsafe (#call linux-shmdt (: address null))) -22i64))
  (#let invalid (#ptr-mut u8) (#unsafe (#call linux-shmat (: segment -1i32 : address null : flags 0i32))))
  (#let error i64 (#unsafe (#asm i64 ((rdi invalid)) "mov rax, rdi")))
  (#assert (#i64.== error -22i64))
  (#return 42u64))
