#alias linux-close = ../library/linux_x86_64.lim::linux-close
#alias linux-ioctl = ../library/linux_x86_64.lim::linux-ioctl
#alias linux-mmap = ../library/linux_x86_64.lim::linux-mmap
#alias linux-munmap = ../library/linux_x86_64.lim::linux-munmap
#alias linux-pipe2 = ../library/linux_x86_64.lim::linux-pipe2
#alias linux-read = ../library/linux_x86_64.lim::linux-read
#alias linux-write = ../library/linux_x86_64.lim::linux-write

// FIONREAD writes an int; FIONBIO reads an int on Linux x86-64.
#fn main () #u64
    (#let memory (#ptr-mut #u8) (#unsafe (#unsafe-call linux-mmap ((address (#ptr-null (#ptr-mut #u8))) (length 4096usize) (protection 3u32) (flags 34u32) (fd -1i64) (offset 0i64)))))
    (#let descriptors (#ptr-mut #i32)
      (#unsafe (#asm (#ptr-mut #i32) ((rdi memory)) "mov rax, rdi")))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-pipe2 ((descriptors descriptors) (flags 0i32)))) 0i64))
    (#let reader #i64 (#as (#unsafe (#ptr-read descriptors)) #i64))
    (#let writer #i64 (#as (#unsafe (#ptr-read (#ptr-offset descriptors 1usize))) #i64))
    (#let count (#ptr-mut #i32) (#unsafe (#ptr-offset descriptors 2usize)))
    (#let argument #usize (#unsafe (#asm #usize ((rdi count)) "mov rax, rdi")))
    (#let payload (#ptr-mut #u8) (#unsafe (#ptr-offset memory 16usize)))
    (#let received (#ptr-mut #u8) (#unsafe (#ptr-offset memory 32usize)))
    (#unsafe (#asm () ((rdi payload)) "mov DWORD PTR [rdi], 0x0a434241"))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-write ((fd writer) (source payload) (count 4usize)))) 4i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-ioctl ((fd reader) (request 0x541bu32) (argument argument)))) 0i64))
    (#assert (#i32::eq (#unsafe (#ptr-read count)) 4i32))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-read ((fd reader) (destination received) (count 1usize)))) 1i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-ioctl ((fd reader) (request 0x541bu32) (argument argument)))) 0i64))
    (#assert (#i32::eq (#unsafe (#ptr-read count)) 3i32))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-read ((fd reader) (destination (#unsafe (#ptr-offset received 1usize))) (count 3usize)))) 3i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-ioctl ((fd reader) (request 0x541bu32) (argument argument)))) 0i64))
    (#assert (#i32::eq (#unsafe (#ptr-read count)) 0i32))
    // Set nonblocking through ioctl and verify an empty pipe returns EAGAIN.
    (#unsafe (#ptr-write count 1i32))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-ioctl ((fd reader) (request 0x5421u32) (argument argument)))) 0i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-read ((fd reader) (destination payload) (count 1usize)))) -11i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-ioctl ((fd -1i64) (request 0x541bu32) (argument argument)))) -9i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-ioctl ((fd reader) (request 0x541bu32) (argument 0usize)))) -14i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-ioctl ((fd reader) (request 0u32) (argument 0usize)))) -25i64))
    (#assert (#i64::eq (#call linux-close ((fd reader))) 0i64))
    (#assert (#i64::eq (#call linux-close ((fd writer))) 0i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-write ((fd 1i64) (source received) (count 4usize)))) 4i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-munmap ((address memory) (length 4096usize)))) 0i64))
    (#return 42u64)
