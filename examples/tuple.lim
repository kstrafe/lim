(
  #fn
  make
  ()
  (#tuple u64 f32)
  (
    #return
    (#tuple 40 2.5)
  )
)

(
  #fn
  consume
  (
    (
      value
      (#tuple u64 f32)
    )
  )
  u64
  (
    #return
    (#u64.+.wrap
      (#get value 0)
      (
        #as
        (#get value 1)
        u64
      )
    )
  )
)

(
  #fn
  main
  ()
  u64
  (
    #let
    value
    (#tuple u64 f32)
    (#call make (:))
  )
  (
    #return
    (#call consume (: value value))
  )
)
