(#import "../library/tasks.lim")

(@task (Count CountPoll CountPending CountReady) u64 ((Counting u64)))

(#fn count-poll ((task Count)) CountPoll
  (#return (#match task
    (#case (Counting remaining)
      (#if (#u64.== (#clone remaining) 0u64)
        (#block (#forget remaining) (CountReady 21u64))
        (CountPending (Counting (#u64.-.wrap remaining 1u64))))))))

(#fn next-count ((value u64)) Count
  (#return (Counting value)))

(@async (Pipeline PipelinePoll PipelinePending PipelineReady pipeline-poll) u64
  ((Begin (#await Count CountPending CountReady count-poll)
     (#then Finish next-count))
   (Finish (#await Count CountPending CountReady count-poll)
     (#return))))

(#fn cancel-count ((task Count)) ()
  (#match task (#case (Counting remaining) (#forget remaining)))
  (#return ()))

(@task-cancel cancel-pipeline Pipeline
  ((Begin cancel-count) (Finish cancel-count)))

(@executor run-pipeline Results
  ((pipeline Pipeline PipelinePoll PipelinePending PipelineReady pipeline-poll u64)
   (counter Count CountPoll CountPending CountReady count-poll u64)))

(#fn main () u64
  (#call cancel-pipeline (#fn-args (task (Begin (Counting 100u64)))))
  (#let results Results
    (#call run-pipeline
      (#fn-args (pipeline (Begin (Counting 2u64))) (counter (Counting 3u64)))))
  (#return (#u64.+.wrap (#get results pipeline) (#get results counter))))
