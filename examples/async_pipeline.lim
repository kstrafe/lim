#alias lim-gen-async = #std/tasks.lim::async
#alias lim-gen-executor = #std/tasks.lim::executor
#alias lim-gen-task = #std/tasks.lim::task
#alias lim-gen-task-cancel = #std/tasks.lim::task-cancel

#generate lim-gen-task { names = (Count CountPoll CountPoll.CountPending CountPoll.CountReady); result = #u64;
  states = ((Count.Counting #u64)); }

#fn count-poll {
  #params = ((task Count));
  #returns = CountPoll;
  #body = ((#return (#match task
        (#case (Count.Counting remaining)
          (#if (#u64::eq (#clone remaining) 0u64)
            (#block
              (#forget remaining)
              (CountPoll.CountReady 21u64)
            )
            (CountPoll.CountPending (Count.Counting (#u64::sub-wrap remaining 1u64)))
          )
        )
      )));
}

#fn next-count {
  #params = ((value #u64));
  #returns = Count;
  #body = ((#return (Count.Counting value)));
}

#generate lim-gen-async { names = (Pipeline PipelinePoll PipelinePoll.PipelinePending
  PipelinePoll.PipelineReady pipeline-poll); result = #u64; stages = ((Pipeline.Begin (#await Count
      CountPoll.CountPending CountPoll.CountReady count-poll) (#then Pipeline.Finish next-count))
  (Pipeline.Finish (#await Count CountPoll.CountPending CountPoll.CountReady count-poll) (#return))); }

#fn cancel-count {
  #params = ((task Count));
  #returns = ();
  #body = (
    (#match task
      (#case (Count.Counting remaining)
        (#forget remaining)
      )
    )
    (#return ())
  );
}

#generate lim-gen-task-cancel { cancel = cancel-pipeline; task = Pipeline; states = ((Pipeline.Begin cancel-count)
  (Pipeline.Finish cancel-count)); }

#generate lim-gen-executor { run = run-pipeline; result = Results; jobs = ((pipeline Pipeline PipelinePoll
    PipelinePoll.PipelinePending PipelinePoll.PipelineReady pipeline-poll #u64 pipeline-input)
  (counter Count CountPoll CountPoll.CountPending CountPoll.CountReady count-poll #u64
    counter-input)); }

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#call cancel-pipeline ((task (Pipeline.Begin (Count.Counting 100u64)))))
    (#let results Results (#call run-pipeline ((pipeline-input (Pipeline.Begin
              (Count.Counting 2u64))) (counter-input (Count.Counting 3u64)))))
    (#return (#u64::add-wrap (#get results pipeline) (#get results counter)))
  );
}
