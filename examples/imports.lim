(#import "modules/shared.lim")
(#import-external "modules/shared.lim" External-)

(#fn main () #u64
  (#return
    (#u64.+.wrap
      (#call widget-value (: widget (#struct-literal Widget ((value 20)))))
      (#call External-widget-value (: External-widget (#struct-literal External-Widget ((External-value 22))))))))
