(#import "modules/shared.lim")
(#import-external "modules/shared.lim" external-)

(#fn main () u64
  (#return
    (#u64.+.wrap
      (#call widget-value (#fn-args (widget (#struct-literal Widget ((value 20))))))
      (#call external-widget-value (#fn-args (external-widget (#struct-literal external-Widget ((external-value 22)))))))))
