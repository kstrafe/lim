#enum Maybe () ((Maybe.Some #u64) Maybe.None)

#fn classify {
  #params = ((value Maybe));
  #returns = #u64;
  #body = (
    (#return
      (#match value
        (#case (Maybe.Some 42) 1)
        (#case Maybe.None 0)))
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#return (#call classify ((value (Maybe.Some 42)))))
  );
}
