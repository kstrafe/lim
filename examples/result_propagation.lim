#generate #result ((ok #u64) (error #u32) (name Input))
#generate #result ((ok #bool) (error #u32) (name Output))

#fn convert {
  #params = ((value Input));
  #returns = Output;
  #body = (
    (#let-else (Input.Ok number) Input value (#else (Input.Err error) (#return (#call Output::err
            (($ error))))))
    (#return (#call Output::ok ((value (#u64::eq number 42u64)))))
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let result Output (#call convert ((value (#call Input::err ((error 42u32)))))))
    (#return (#match result
        (#case (Output.Ok yes)
          (#if yes
            42u64
            0u64
          )
        )
        (#case (Output.Err error)
          (#as error #u64)
        )
      ))
  );
}
