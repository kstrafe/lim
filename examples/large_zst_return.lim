(#struct LargeWithUnit
  ((a u64) (b u64) (c u64) (d u64)
   (e u64) (f u64) (g u64) (marker ())))

(#fn make () LargeWithUnit
  (#return
    (#struct-literal LargeWithUnit ((a 1u64) (b 2u64) (c 3u64) (d 4u64) (e 5u64) (f 6u64) (g 40u64) (marker ())))))

(#fn make-tuple () (#tuple u64 u64 u64 u64 u64 u64 u64 ())
  (#return
    (#tuple (#tuple u64 u64 u64 u64 u64 u64 u64 ())
      1u64 2u64 3u64 4u64 5u64 6u64 40u64 ())))

(#fn main () u64
  (#let value LargeWithUnit (#call make (#fn-args )))
  (#let tuple (#tuple u64 u64 u64 u64 u64 u64 u64 ()) (#call make-tuple (#fn-args )))
  (#return
    (#u64.+.wrap
      (#u64.+.wrap (#get value a) (#get value g))
      (#get tuple 6))))
