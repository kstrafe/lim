// Move a nested field out, suspend, then rebuild its parent from owned parts.
// Cancellation retains the remaining leaves as separate cleanup obligations.
#struct Resource (#linear) ((value #u64))

#struct Pair () ((left Resource) (right Resource))
#struct Outer () ((inner Pair) (spare Resource))
#enum Step (#linear) ((Step.Start #u64) (Step.Resume #u64))

#enum StepPoll () ((StepPoll.Pending Step) (StepPoll.Ready #u64))

#fn step-poll {
  #params = ((task Step) (waker (#ref #u64)));
  #returns = StepPoll;
  #body = ((#return (#match task
        (#case (Step.Start value)
          (StepPoll.Pending (Step.Resume value))
        )
        (#case (Step.Resume value)
          (StepPoll.Ready value)
        )
      )));
}

#generate #async-fn ((protocol WorkAwait) (waker #u64) (function (#fn work () #u64 (#let-mut owner
        Outer (#struct-literal Outer ((inner (#struct-literal Pair ((left (#struct-literal
                      Resource ((value 20u64))))
                  (right (#struct-literal Resource ((value 22u64))))))) (spare (#struct-literal
                Resource ((value 3u64))))))) (#let moved Resource (#get (#get owner inner) left))
      (#let delta #u64 (#await #u64 Step StepPoll.Pending StepPoll.Ready step-poll
          (Step.Start 2u64))) (#let old #u64 (#get moved value)) (#forget moved) (#let sibling
        Resource (#get (#get owner inner) right)) (#set-field owner inner (#struct-literal Pair
          ((left (#struct-literal Resource ((value (#u64::add-wrap old delta))))) (right sibling))))
      (#let result #u64 (#u64::add-wrap (#get (#get (#get owner inner) left) value) (#get (#get
              (#get owner inner) right) value))) (#forget owner) (#return result))))

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let waker #u64 0u64)
    (#let first Work::Poll (#call Work::poll ((task (#call work ())) (waker (#borrow waker)))))
    (#let-else (Work::Poll.Pending task) Work::Poll first (#unreachable))
    (#return (#match (#call Work::poll ((task task) (waker (#borrow waker))))
        (#case (Work::Poll.Ready result)
          result
        )
        (#case (Work::Poll.Pending unexpected)
          (#block
            (#forget unexpected)
            (#unreachable)
          )
        )
      ))
  );
}
