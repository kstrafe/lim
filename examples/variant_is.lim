#enum Value (#linear) ((Value.Number #u64) Value.Empty)


#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let value Value (Value.Number 42u64))
    (#let view (#pin-ref Value) (#pin-borrow value))
    (#assert (#variant-is view Value.Number))
    (#assert (#bool::not (#variant-is view Value.Empty)))
    (#drop view)
    (#let result #u64 (#get-payload value Value.Number 0))
    (#forget value)
    (#return result)
  );
}
