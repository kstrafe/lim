(#alias Counter = ./storage.lim::Counter)
(#alias counter-destroy = ./storage.lim::counter-destroy)

// A separately compiled white-box test belongs to the same library.


(#fn main () #u64
  (#let counter Counter (#struct-literal Counter (: value 42u64)))
  (#let answer #u64 (#get counter value))
  (#call counter-destroy (: counter counter))
  (#return answer))
