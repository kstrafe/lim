; Registration consumes only literal names. It never inspects unfinished enums.
(#distributed-enum ExecutorTask ())

(#gn register-future (executor future)
  `((#require-generated
       ,(#gn-symbol-append future "::Frame")
       #async-fn-pinned
       (,(#gn-symbol-append future "::Poll")
        ,(#gn-symbol-append future "::Pending")
        ,(#gn-symbol-append future "::Ready")
        ,(#gn-symbol-append future "::poll")))
    (#enum-contribute ,executor
      (,(#gn-symbol-append (#gn-symbol-append executor "::") future)
       ,(#gn-symbol-append future "::Frame")))))

; Forward references are checked after expansion; they do not schedule it.
(@register-future ExecutorTask Work)

(@#async-fn-pinned
  (: protocol Work::Await : waker #u64
   : function (#fn work () #u64 (#return 42u64))))

(#fn main () #u64
  (#let waker #u64 0u64)
  (#let-mut task ExecutorTask (ExecutorTask::Work (#call work (:))))
  (#let frame (#pin-ref-mut Work::Frame)
    (#pin-get-payload-mut (#pin-borrow-mut task) ExecutorTask::Work 0))
  (#let result Work::Poll
    (#call Work::poll (: task frame : waker (#borrow waker))))
  (#let answer #u64 (#match result
    (#case (Work::Ready value) value)
    (#case (Work::Pending pending) (#block (#forget pending) (#unreachable)))))
  (#forget task)
  (#return answer))
