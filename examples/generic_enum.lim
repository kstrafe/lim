#enum MaybeU64 () ((MaybeU64.SomeU64 #u64) MaybeU64.None)

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let value MaybeU64 (MaybeU64.SomeU64 42))
    (#return (#match value
        (#case (MaybeU64.SomeU64 payload)
          payload
        )
        (#case MaybeU64.None
          0
        )
      ))
  );
}
