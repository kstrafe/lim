#struct
    Pair ()
    (
      (scale #f32)
      (value #u64)
    )

#fn
    consume {
  #params = (
      (pair Pair)
      (factor #f32)
    );
  #returns = #u64;
  #body = (
    (
      #return
      (
        #if
        (#f32::gt
          (#get pair scale)
          1.0
        )
        (#u64::add-wrap
          (#get pair value)
          1
        )
        0
      )
    )
  );
}

#fn
    main {
  #params = ();
  #returns = #u64;
  #body = (
    (
      #return
      (#call consume ((pair (#struct-literal Pair ((scale 1.5) (value 41)))) (factor 2.0)))
    )
  );
}
