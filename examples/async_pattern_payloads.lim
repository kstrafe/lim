; Destructured tuple fields are typed from Choice, then retained as needed.
(#enum Choice ((Chosen (#tuple u64 u64)) Empty))
(#enum Step ((Start u64) (Resume u64)))
(#enum StepPoll ((StepPending Step) (StepReady u64)))
(#fn step-poll ((task Step) (waker (#ref u64))) StepPoll
  (#return (#match task
    (#case (Start value) (StepPending (Resume value)))
    (#case (Resume value) (StepReady value)))))

(@async-fn (: names (Frame Poll Pending Ready poll) : waker u64 : function
  (#fn work ((choice Choice)) u64
    (#return (#match choice
      (#case (Chosen (#tuple value bias))
        (#u64.+.wrap
          (#await u64 Step StepPending StepReady step-poll (Start value))
          bias))
      (#case Empty 0u64))))))

(#fn main () u64
  (#let waker u64 0u64)
  (#let-mut task Frame
    (#call work (: choice (Chosen (#tuple (#tuple u64 u64) 20u64 22u64)))))
  (#for-range (attempt u64) 0u64 3u64
    (#let result Poll (#call poll (: task task : waker (#borrow waker))))
    (#match result
      (#case (Pending next) (#block (#set task next) ()))
      (#case (Ready value) (#block (#return value)))))
  (#forget task)
  (#return (#unreachable)))
