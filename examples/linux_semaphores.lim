(#import "../library/linux_x86_64.lim")

(#fn main () u64
  (#assert (#i64.== (#call linux-semget (#fn-args
    (key 0i32) (count 0i32) (flags 384i32))) -22i64))
  (#let memory (#ptr-mut u8)
    (#unsafe (#call linux-mmap (#fn-args
      (address (#ptr-null (#ptr-mut u8))) (length 4096usize)
      (protection 3u32) (flags 34u32) (fd -1i64) (offset 0i64)))))
  ; Each sembuf has u16 number, i16 operation, i16 flags (six bytes).
  ; Decrement semaphores 0 and 1 with IPC_NOWAIT.
  (#unsafe (#asm () ((rdi memory))
    "mov WORD PTR [rdi], 0\nmov WORD PTR [rdi+2], -1\nmov WORD PTR [rdi+4], 2048\nmov WORD PTR [rdi+6], 1\nmov WORD PTR [rdi+8], -1\nmov WORD PTR [rdi+10], 2048"))
  (#let timeout (#ptr-mut i64)
    (#unsafe (#asm (#ptr-mut i64) ((rdi memory)) "lea rax, [rdi+32]")))
  (#let created i64 (#call linux-semget (#fn-args
    (key 0i32) (count 2i32) (flags 384i32))))
  (#assert (#i64.>= created 0i64))
  (#let set-id i32 (#as created i32))
  (#let initialized-first i64 (#unsafe (#call linux-semctl (#fn-args
    (set-id set-id) (number 0i32) (command 16i32) (argument 2usize)))))
  (#let initialized-second i64 (#unsafe (#call linux-semctl (#fn-args
    (set-id set-id) (number 1i32) (command 16i32) (argument 0usize)))))
  (#let rejected-batch i64 (#unsafe (#call linux-semop (#fn-args
    (set-id set-id) (operations memory) (count 2usize)))))
  (#let after-rejection i64 (#unsafe (#call linux-semctl (#fn-args
    (set-id set-id) (number 0i32) (command 12i32) (argument 0usize)))))
  (#let decremented i64 (#unsafe (#call linux-semop (#fn-args
    (set-id set-id) (operations memory) (count 1usize)))))
  (#let after-decrement i64 (#unsafe (#call linux-semctl (#fn-args
    (set-id set-id) (number 0i32) (command 12i32) (argument 0usize)))))
  ; Disable IPC_NOWAIT to exercise the zero timespec timeout itself.
  (#unsafe (#asm () ((rdi memory)) "mov WORD PTR [rdi+4], 0"))
  (#let timed-success i64 (#unsafe (#call linux-semtimedop (#fn-args
    (set-id set-id) (operations memory) (count 1usize) (timeout timeout)))))
  (#let timed-out i64 (#unsafe (#call linux-semtimedop (#fn-args
    (set-id set-id) (operations memory) (count 1usize) (timeout timeout)))))
  (#let final-value i64 (#unsafe (#call linux-semctl (#fn-args
    (set-id set-id) (number 0i32) (command 12i32) (argument 0usize)))))
  ; Remove the private set before checking saved results.
  (#let removed i64 (#unsafe (#call linux-semctl (#fn-args
    (set-id set-id) (number 0i32) (command 0i32) (argument 0usize)))))
  (#assert (#i64.== removed 0i64))
  (#assert (#i64.== initialized-first 0i64))
  (#assert (#i64.== initialized-second 0i64))
  (#assert (#i64.== rejected-batch -11i64))
  (#assert (#i64.== after-rejection 2i64))
  (#assert (#i64.== decremented 0i64))
  (#assert (#i64.== after-decrement 1i64))
  (#assert (#i64.== timed-success 0i64))
  (#assert (#i64.== timed-out -11i64))
  (#assert (#i64.== final-value 0i64))
  (#assert (#i64.== (#unsafe (#call linux-semctl (#fn-args
    (set-id set-id) (number 0i32) (command 12i32) (argument 0usize)))) -22i64))
  (#assert (#i64.== (#unsafe (#call linux-munmap (#fn-args
    (address memory) (length 4096usize)))) 0i64))
  (#let letter u8 83u8)
  (#let newline u8 10u8)
  (#assert (#i64.== (#call linux-write-byte (#fn-args
    (source (#borrow letter)))) 1i64))
  (#assert (#i64.== (#call linux-write-byte (#fn-args
    (source (#borrow newline)))) 1i64))
  (#return 42u64))
