(#import "../library/linux_x86_64.lim")

(#fn main () u64
  (#let memory (#ptr-mut u8)
    (#unsafe (#call linux-mmap (#fn-args
      (address (#ptr-null (#ptr-mut u8))) (length 4096usize)
      (protection 3u32) (flags 34u32) (fd -1i64) (offset 0i64)))))
  ; Native message layout is an eight-byte positive type then the payload.
  (#unsafe (#asm () ((rdi memory))
    "mov QWORD PTR [rdi], 2\nmov BYTE PTR [rdi+8], 66\nmov BYTE PTR [rdi+9], 10\nmov QWORD PTR [rdi+16], 1\nmov BYTE PTR [rdi+24], 65\nmov BYTE PTR [rdi+25], 10"))
  (#let second (#ptr-mut u8) (#unsafe (#ptr-offset memory 16usize)))
  (#let received-first (#ptr-mut u8) (#unsafe (#ptr-offset memory 32usize)))
  (#let received-second (#ptr-mut u8) (#unsafe (#ptr-offset memory 48usize)))
  (#let invalid-message (#ptr-mut u8) (#unsafe (#ptr-offset memory 64usize)))
  (#let queue-result i64 (#call linux-msgget (#fn-args (key 0i32) (flags 384i32))))
  (#assert (#i64.>= queue-result 0i64))
  (#let queue i32 (#as queue-result i32))
  ; IPC_NOWAIT keeps every operation bounded. Save results and remove the
  ; queue before assertions, so assertion failures cannot retain this queue.
  (#let invalid-type i64 (#unsafe (#call linux-msgsnd (#fn-args
    (queue queue) (message invalid-message) (size 2usize) (flags 2048i32)))))
  (#let sent-first i64 (#unsafe (#call linux-msgsnd (#fn-args
    (queue queue) (message memory) (size 2usize) (flags 2048i32)))))
  (#let sent-second i64 (#unsafe (#call linux-msgsnd (#fn-args
    (queue queue) (message second) (size 2usize) (flags 2048i32)))))
  ; Select type 1 even though type 2 was enqueued first.
  (#let selected i64 (#unsafe (#call linux-msgrcv (#fn-args
    (queue queue) (message received-first) (size 2usize)
    (message-type 1i64) (flags 2048i32)))))
  (#let too-small i64 (#unsafe (#call linux-msgrcv (#fn-args
    (queue queue) (message received-second) (size 1usize)
    (message-type 0i64) (flags 2048i32)))))
  ; E2BIG must leave the message queued for a subsequent full-sized receive.
  (#let remaining i64 (#unsafe (#call linux-msgrcv (#fn-args
    (queue queue) (message received-second) (size 2usize)
    (message-type 0i64) (flags 2048i32)))))
  (#let empty i64 (#unsafe (#call linux-msgrcv (#fn-args
    (queue queue) (message invalid-message) (size 2usize)
    (message-type 0i64) (flags 2048i32)))))
  (#let removed i64 (#unsafe (#call linux-msgctl (#fn-args
    (queue queue) (command 0i32) (buffer (#ptr-null (#ptr-mut u8)))))))
  (#assert (#i64.== removed 0i64))
  (#assert (#i64.== invalid-type -22i64))
  (#assert (#i64.== sent-first 0i64))
  (#assert (#i64.== sent-second 0i64))
  (#assert (#i64.== selected 2i64))
  (#assert (#i64.== too-small -7i64))
  (#assert (#i64.== remaining 2i64))
  (#assert (#i64.== empty -42i64))
  (#let first-type i64
    (#unsafe (#asm i64 ((rdi received-first)) "mov rax, QWORD PTR [rdi]")))
  (#let second-type i64
    (#unsafe (#asm i64 ((rdi received-second)) "mov rax, QWORD PTR [rdi]")))
  (#assert (#i64.== first-type 1i64))
  (#assert (#i64.== second-type 2i64))
  (#assert (#i64.== (#unsafe (#call linux-msgctl (#fn-args
    (queue queue) (command 2i32) (buffer memory)))) -22i64))
  (#assert (#i64.== (#unsafe (#call linux-write (#fn-args
    (fd 1i64) (source (#ptr-offset received-first 8usize)) (count 2usize)))) 2i64))
  (#assert (#i64.== (#unsafe (#call linux-write (#fn-args
    (fd 1i64) (source (#ptr-offset received-second 8usize)) (count 2usize)))) 2i64))
  (#assert (#i64.== (#unsafe (#call linux-munmap (#fn-args
    (address memory) (length 4096usize)))) 0i64))
  (#return 42u64))
