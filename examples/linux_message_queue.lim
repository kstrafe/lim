#alias linux-mmap = ../library/linux_x86_64.lim::linux-mmap
#alias linux-msgctl = ../library/linux_x86_64.lim::linux-msgctl
#alias linux-msgget = ../library/linux_x86_64.lim::linux-msgget
#alias linux-msgrcv = ../library/linux_x86_64.lim::linux-msgrcv
#alias linux-msgsnd = ../library/linux_x86_64.lim::linux-msgsnd
#alias linux-munmap = ../library/linux_x86_64.lim::linux-munmap
#alias linux-write = ../library/linux_x86_64.lim::linux-write

#fn main {
  #params = ();
  #returns = #u64;
  #effects = (#global-access #io (#effects-of linux-mmap) (#effects-of linux-msgctl) (#effects-of
      linux-msgget) (#effects-of linux-msgrcv) (#effects-of linux-msgsnd)
    (#effects-of linux-munmap) (#effects-of linux-write));
  #body = ((#let memory (#ptr-mut #u8) (#unsafe
        (#unsafe-call linux-mmap ((address (#ptr-null (#ptr-mut #u8))) (length 4096usize)
            (protection 3u32) (flags 34u32) (fd -1i64) (offset 0i64)))
      ))
    // Native message layout is an eight-byte positive type then the payload.
    (#unsafe
      (#asm () ((rdi memory))
        "mov QWORD PTR [rdi], 2\nmov bYTE PTR [rdi+8], 66\nmov bYTE PTR [rdi+9], 10\nmov QWORD PTR [rdi+16], 1\nmov bYTE PTR [rdi+24], 65\nmov bYTE PTR [rdi+25], 10")
    ) (#let second (#ptr-mut #u8) (#unsafe
        (#ptr-offset memory 16usize)
      )) (#let received-first (#ptr-mut #u8) (#unsafe
        (#ptr-offset memory 32usize)
      )) (#let received-second (#ptr-mut #u8) (#unsafe
        (#ptr-offset memory 48usize)
      )) (#let invalid-message (#ptr-mut #u8) (#unsafe
        (#ptr-offset memory 64usize)
      )) (#let queue-result #i64 (#call linux-msgget ((key 0i32) (flags 384i32)))) (#assert
      (#i64::ge queue-result 0i64)) (#let queue #i32 (#as queue-result #i32))
    // IPC_NOWAIT keeps every operation bounded. Save results and remove the
    // queue before assertions, so assertion failures cannot retain this queue.
    (#let invalid-type #i64 (#unsafe
        (#unsafe-call linux-msgsnd ((queue queue) (message invalid-message) (size 2usize) (flags
              2048i32)))
      )) (#let sent-first #i64 (#unsafe
        (#unsafe-call linux-msgsnd ((queue queue) (message memory) (size 2usize) (flags 2048i32)))
      )) (#let sent-second #i64 (#unsafe
        (#unsafe-call linux-msgsnd ((queue queue) (message second) (size 2usize) (flags 2048i32)))
      ))
    // Select type 1 even though type 2 was enqueued first.
    (#let selected #i64 (#unsafe
        (#unsafe-call linux-msgrcv ((queue queue) (message received-first) (size 2usize)
            (message-type 1i64) (flags 2048i32)))
      )) (#let too-small #i64 (#unsafe
        (#unsafe-call linux-msgrcv ((queue queue) (message received-second) (size 1usize)
            (message-type 0i64) (flags 2048i32)))
      ))
    // E2BIG must leave the message queued for a subsequent full-sized receive.
    (#let remaining #i64 (#unsafe
        (#unsafe-call linux-msgrcv ((queue queue) (message received-second) (size 2usize)
            (message-type 0i64) (flags 2048i32)))
      )) (#let empty #i64 (#unsafe
        (#unsafe-call linux-msgrcv ((queue queue) (message invalid-message) (size 2usize)
            (message-type 0i64) (flags 2048i32)))
      )) (#let removed #i64 (#unsafe
        (#unsafe-call linux-msgctl ((queue queue) (command 0i32)
            (buffer (#ptr-null (#ptr-mut #u8)))))
      )) (#assert (#i64::eq removed 0i64)) (#assert (#i64::eq invalid-type -22i64)) (#assert
      (#i64::eq sent-first 0i64)) (#assert (#i64::eq sent-second 0i64)) (#assert (#i64::eq
        selected 2i64)) (#assert (#i64::eq too-small -7i64)) (#assert (#i64::eq remaining 2i64))
    (#assert (#i64::eq empty -42i64)) (#let first-type #i64 (#unsafe
        (#asm #i64 ((rdi received-first)) "mov rax, QWORD PTR [rdi]")
      )) (#let second-type #i64 (#unsafe
        (#asm #i64 ((rdi received-second)) "mov rax, QWORD PTR [rdi]")
      )) (#assert (#i64::eq first-type 1i64)) (#assert (#i64::eq second-type 2i64)) (#assert
      (#i64::eq (#unsafe
          (#unsafe-call linux-msgctl ((queue queue) (command 2i32) (buffer memory)))
        ) -22i64)) (#assert (#i64::eq (#unsafe
          (#unsafe-call linux-write ((fd 1i64) (source (#ptr-offset received-first 8usize)) (count
                2usize)))
        ) 2i64)) (#assert (#i64::eq (#unsafe
          (#unsafe-call linux-write ((fd 1i64) (source (#ptr-offset received-second 8usize))
              (count 2usize)))
        ) 2i64)) (#assert (#i64::eq (#unsafe
          (#unsafe-call linux-munmap ((address memory) (length 4096usize)))
        ) 0i64)) (#return 42u64));
}
