#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let value #u32 2)
    (#return
      (#u64::add-wrap
        (#match value
          (#case (#or 1 2 3) 42)
          (#case _ 0))
        (#call bool-or ((value true)))))
  );
}

#fn bool-or {
  #params = ((value #bool));
  #returns = #u64;
  #body = (
    (#return
      (#match value
        (#case (#or true false) 42)))
  );
}
