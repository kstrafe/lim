; Contracts quantify the whole array and index, rather than sampling inputs.
(#fn middle-read (: values (#ref (#array #u8 4)) : index #usize) #u8
  (#let view (#slice #u8) (#borrow-slice (#deref values) 1usize 3usize))
  (#return (#deref (#slice-idx view index))))

(#theorem middle-read-contract
  (#proof-contract
    middle-read
    (#usize::lt index 2usize)
    (#proof-eq (#proof-result) (#proof-old (#index values (#usize::add-wrap index 1usize))))))

(#fn middle-set (: values (#ref-mut (#array #u8 4)) : index #usize : value #u8) ()
  (#let whole (#slice-mut #u8) (#slice-mut-of values))
  (#let middle (#slice-mut #u8) (#slice-mut-range whole 1usize 3usize))
  (#deref-set (#slice-mut-idx middle index) value)
  (#forget middle)
  (#forget whole)
  (#return ()))
; The selected element changes, and both elements outside the view stay intact.

(#theorem middle-set-contract
  (#proof-contract
    middle-set
    (#usize::lt index 2usize)
    (#proof-and
      (#proof-eq (#index values (#usize::add-wrap index 1usize)) value)
      (#proof-eq (#index values 0usize) (#proof-old (#index values 0usize)))
      (#proof-eq (#index values 3usize) (#proof-old (#index values 3usize))))))

(#fn main () #u64
  (#let-mut values (#array #u8 4) (#array-of (#array #u8 4) 10u8 20u8 30u8 40u8))
  (#call middle-set (: values (#borrow-mut values) : index 0usize : value 12u8))
  (#return (#as (#u8::add-wrap (#index values 1usize) (#index values 2usize)) #u64)))
