(#import "../library/tasks.lim")
(#import "../library/linux_x86_64.lim")

(#fn print-text ((text (#slice char))) ()
  (#for-range (offset usize) 0usize (#slice-len text)
    (#let byte u8 (#as (#deref (#slice-idx text offset)) u8))
    (#assert (#i64.==
      (#call linux-write-byte (#fn-args (source (#borrow byte)))) 1i64)))
  (#return ()))

; A small wake context: the child records each time it asks to be polled again.
(#struct Wake ((notifications (#cell u64))))

(@task (Step StepPoll StepPending StepReady) u64 ((Waiting u64)))

(#fn step-poll ((task Step) (waker (#ref Wake))) StepPoll
  (#return (#match task
    (#case (Waiting remaining)
      (#if (#u64.== (#clone remaining) 0u64)
        (#block (#forget remaining) (StepReady 20u64))
        (#block
          (#cell-set (#get waker notifications)
            (#u64.+.wrap (#cell-get (#get waker notifications)) 1u64))
          (StepPending (Waiting (#u64.-.wrap remaining 1u64)))))))))

; @async-fn generates TwoSteps, TwoStepsPoll, and the start/poll functions.
; Each #await lists the locals it must carry across that suspension point.
(@async-fn
  (TwoSteps TwoStepsPoll TwoStepsPending TwoStepsReady two-steps-poll) Wake
  (#fn two-steps ((extra u64)) u64
    (#let first Step (Waiting 1u64))
    (#let left u64
      (#await (extra) Step StepPending StepReady step-poll first))
    (#let second Step (Waiting 1u64))
    (#let right u64
      (#await (extra left) Step StepPending StepReady step-poll second))
    (#return (#u64.+.wrap (#u64.+.wrap left right) extra))))

(#fn main () u64
  (#let start (#array char 6) "start\n")
  (#call print-text (#fn-args (text (#slice-of (#borrow start)))))
  (#let wake Wake (#struct-literal Wake ((notifications (#cell 0u64)))))
  (#let first TwoStepsPoll
    (#call two-steps-poll (#fn-args
      (task (#call two-steps (#fn-args (extra 0u64))))
      (waker (#borrow wake)))))
  (#let-else (TwoStepsPending state1) TwoStepsPoll first (#unreachable))
  (#let first-pending (#array char 16) "poll 1: pending\n")
  (#call print-text (#fn-args (text (#slice-of (#borrow first-pending)))))
  (#let second TwoStepsPoll
    (#call two-steps-poll (#fn-args
      (task state1)
      (waker (#borrow wake)))))
  (#let-else (TwoStepsPending state2) TwoStepsPoll second (#unreachable))
  (#let second-pending (#array char 16) "poll 2: pending\n")
  (#call print-text (#fn-args (text (#slice-of (#borrow second-pending)))))
  (#let third TwoStepsPoll
    (#call two-steps-poll (#fn-args
      (task state2)
      (waker (#borrow wake)))))
  (#let result u64
    (#match third
      (#case (TwoStepsReady value) value)
      (#case (TwoStepsPending state)
        (#block (#forget state) (#unreachable)))))
  (#let ready (#array char 14) "poll 3: ready\n")
  (#call print-text (#fn-args (text (#slice-of (#borrow ready)))))
  (#let notifications u64 (#cell-get (#get wake notifications)))
  (#forget wake)
  (#return (#u64.+.wrap result notifications)))
