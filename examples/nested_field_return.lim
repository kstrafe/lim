#struct Inner ()
    ((payload (#array #u64 7)))

#struct Outer ()
    ((inner Inner))

#fn project {
  #params = ();
  #returns = (#array #u64 7);
  #body = (
    (#let value Outer
      (#struct-literal Outer ((inner (#struct-literal Inner ((payload (#array (#array #u64 7) 1u64 2u64 3u64 4u64 5u64 6u64 42u64))))))))
    (#return (#get (#get value inner) payload))
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let value (#array #u64 7) (#call project ()))
    (#return (#index value 6u64))
  );
}
