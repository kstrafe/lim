(#struct Inner
  ((payload (#array u64 7))))

(#struct Outer
  ((inner Inner)))

(#fn project () (#array u64 7)
  (#let value Outer
    (Outer
      (Inner
        (#array (#array u64 7) 1u64 2u64 3u64 4u64 5u64 6u64 42u64))))
  (#return (#get (#get value inner) payload)))

(#fn main () u64
  (#let value (#array u64 7) (project))
  (#return (#index value 6u64)))
