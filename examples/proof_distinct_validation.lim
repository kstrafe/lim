; Rechecking one user must preserve valid evidence for a different user.
; If both references alias, this pure validator returns the same result.
(#struct User () (: id #u8))

(#fn validate (: user (#ref User)) #bool
  (#return (#u8::eq (#get user id) 42u8)))

(#fn perform (: user (#ref User)) ()
  (#return ()))

(#fn process (: first (#ref User) : second (#ref User) : count #u8) #u8
  (#let checked #bool (#call validate (: user second)))
  (#let-mut remaining #u8 count)
  (#let-mut accepted #u8 0u8)
  (#label
    again
    (#while (#u8::gt remaining 0u8)
      (#let ignored #bool (#call validate (: user first)))
      (#if checked
        (#block
          (#call perform (: user second))
          (#set accepted (#u8::add-wrap accepted 1u8))))
      (#set remaining (#u8::sub-wrap remaining 1u8))))
  (#return accepted))

(#theorem preserved-validation
  (#proof-loop-limit
    1
    (#proof-with-invariants
      (
        (process
          again
          (#proof-implies checked (#proof-validated (#parameter-of validate user) second))
          remaining))
      (#proof-requires-validation
        process
        (#parameter-of validate user)
        (#parameter-of perform user)))))

(#fn main () #u64
  (#let rejected User (#struct-literal User (: id 7u8)))
  (#let accepted User (#struct-literal User (: id 42u8)))
  (#let answer #u8
    (#call process (: first (#borrow rejected) : second (#borrow accepted) : count 42u8)))
  (#forget rejected)
  (#forget accepted)
  (#return (#as answer #u64)))
