; Await an argument of an effect-only step with a synchronous condition.
(#enum StepTask (#linear) ((Start #u64) (Resume #u64)))

(#enum StepPoll () ((StepPending StepTask) (StepReady #u64)))

(#fn step-poll (: task StepTask : waker (#ref #u64)) StepPoll
  (#return (#match task
    (#case (Start next) (StepPending (Resume next)))
    (#case (Resume next) (StepReady next)))))

(#fn advance (: next #u64 : counter (#ref-mut #u64)) ()
  (#deref-set counter next)
  (#return ()))

(@#async-fn ( : protocol WorkAwait : waker #u64 : function
  (#fn work (: run #bool : stop #bool) #u64
    (#let-mut index #u64 0u64)
    (#for () (#bool.&& run (#u64.< index 2u64))
      (#call advance
        (: next (#await #u64 StepTask StepPending StepReady step-poll
                  (Start (#u64.+.wrap index 1u64)))
         : counter (#borrow-mut index)))
      (#if (#u64.== index 0u64)
        (#continue)
        (#if stop (#break) ())))
    (#return (#u64.+.wrap index 40u64)))))

(#fn main () #u64
  (#let waker #u64 0u64)
  (#let first Work::Poll (#call Work::poll
    (: task (#call work (: run true : stop false)) : waker (#borrow waker))))
  (#let-else (Work::Pending first-task) Work::Poll first (#unreachable))
  (#let second Work::Poll (#call Work::poll (: task first-task : waker (#borrow waker))))
  (#let-else (Work::Pending second-task) Work::Poll second (#unreachable))
  (#let third Work::Poll (#call Work::poll (: task second-task : waker (#borrow waker))))
  (#let-else (Work::Ready value) Work::Poll third (#unreachable))
  (#assert (#u64.== value 42u64))
  (#let broken-first Work::Poll (#call Work::poll
    (: task (#call work (: run true : stop true)) : waker (#borrow waker))))
  (#let-else (Work::Pending broken-task) Work::Poll broken-first (#unreachable))
  (#let broken-last Work::Poll (#call Work::poll (: task broken-task : waker (#borrow waker))))
  (#let-else (Work::Ready broken-value) Work::Poll broken-last (#unreachable))
  (#assert (#u64.== broken-value 41u64))
  (#let skipped Work::Poll (#call Work::poll
    (: task (#call work (: run false : stop false)) : waker (#borrow waker))))
  (#let-else (Work::Ready skipped-value) Work::Poll skipped (#unreachable))
  (#assert (#u64.== skipped-value 40u64))
  (#return 42u64))
