// Await an argument of an effect-only step with a synchronous condition.
#enum StepTask (#linear) ((StepTask.Start #u64) (StepTask.Resume #u64))

#enum StepPoll () ((StepPoll.StepPending StepTask) (StepPoll.StepReady #u64))

#fn step-poll {
  #params = ((task StepTask) (waker (#ref #u64)));
  #returns = StepPoll;
  #body = ((#return (#match task
        (#case (StepTask.Start next)
          (StepPoll.StepPending (StepTask.Resume next))
        )
        (#case (StepTask.Resume next)
          (StepPoll.StepReady next)
        )
      )));
}

#fn advance {
  #params = ((next #u64) (counter (#ref-mut #u64)));
  #returns = ();
  #body = ((#deref-set counter next) (#return ()));
}

#generate #async-fn ((protocol WorkAwait) (waker #u64) (function (#fn work ((run #bool)
        (stop #bool)) #u64 (#let-mut index #u64 0u64)
      (#for () (#bool::and run (#u64::lt index 2u64)) (#call advance ((next (#await #u64 StepTask
              StepPoll.StepPending StepPoll.StepReady step-poll (StepTask.Start (#u64::add-wrap
                  index 1u64)))) (counter (#borrow-mut index))))
        (#if (#u64::eq index 0u64)
          (#continue)
          (#if stop
            (#break)
            ()
          )
        )
      ) (#return (#u64::add-wrap index 40u64)))))

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let waker #u64 0u64)
    (#let first Work::Poll (#call Work::poll ((task (#call work ((run true) (stop false)))) (waker
            (#borrow waker)))))
    (#let-else (Work::Poll.Pending first-task) Work::Poll first (#unreachable))
    (#let second Work::Poll (#call Work::poll ((task first-task) (waker (#borrow waker)))))
    (#let-else (Work::Poll.Pending second-task) Work::Poll second (#unreachable))
    (#let third Work::Poll (#call Work::poll ((task second-task) (waker (#borrow waker)))))
    (#let-else (Work::Poll.Ready value) Work::Poll third (#unreachable))
    (#assert (#u64::eq value 42u64))
    (#let broken-first Work::Poll (#call Work::poll ((task (#call work ((run true) (stop true))))
          (waker (#borrow waker)))))
    (#let-else (Work::Poll.Pending broken-task) Work::Poll broken-first (#unreachable))
    (#let broken-last Work::Poll (#call Work::poll ((task broken-task) (waker (#borrow waker)))))
    (#let-else (Work::Poll.Ready broken-value) Work::Poll broken-last (#unreachable))
    (#assert (#u64::eq broken-value 41u64))
    (#let skipped Work::Poll (#call Work::poll ((task (#call work ((run false) (stop false))))
          (waker (#borrow waker)))))
    (#let-else (Work::Poll.Ready skipped-value) Work::Poll skipped (#unreachable))
    (#assert (#u64::eq skipped-value 40u64))
    (#return 42u64)
  );
}
