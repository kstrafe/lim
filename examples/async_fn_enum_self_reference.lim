; A pinned async frame may retain a reference into an active enum payload.
(#enum Child ((Waiting u64)))
(#linear Child)
(#enum ChildPoll ((ChildPending Child) (ChildReady u64)))
(#fn child-poll ((task Child) (waker (#ref u64))) ChildPoll
  (#return (#match task
    (#case (Waiting count)
      (#if (#u64.== count 0u64)
        (ChildPending (Waiting 1u64))
        (ChildReady 2u64))))))
(#fn cancel-child ((task Child)) () (#forget task) (#return ()))

(#enum Choice ((Number u64) (Other u64)))
(#struct Owner ((choice Choice)))

(@async-fn-pinned (: names (EnumFrame EnumPoll EnumPending EnumReady enum-poll)
                   : waker u64
                   : function
  (#fn read-after-await ((owner Owner)) u64
    (#let view (#pin-ref u64)
      (#pin-get-payload (#pin-borrow (#get owner choice)) Number 0))
    (#let result u64
      (#await Child ChildPending ChildReady child-poll (Waiting 0u64)))
    (#return (#u64.+.wrap (#deref view) result)))))

(#fn cancel-enum-state ((task EnumFrame-state)) ()
  (#match task
    (#case EnumFrame-start ())
    (#case (EnumFrame-await-0 view child)
      (#call cancel-child (: task child)))
    (#case EnumFrame-done ()))
  (#return ()))

(#fn main () u64
  (#let-mut frame EnumFrame
    (#call read-after-await
      (: owner (#struct-literal Owner ((choice (Number 40u64)))))))
  (#let waker u64 0u64)
  (#let first EnumPoll
    (#call enum-poll
      (: task (#pin-borrow-mut frame) : waker (#borrow waker))))
  (#let-else (EnumPending pending-frame) EnumPoll first (#unreachable))
  (#let second EnumPoll
    (#call enum-poll (: task pending-frame : waker (#borrow waker))))
  (#let result u64
    (#match second
      (#case (EnumReady value) value)
      (#case (EnumPending unexpected)
        (#block (#forget unexpected) (#unreachable)))))
  (#forget frame)
  (#forget waker)
  (#return result))
