; A pinned async frame may retain a reference into an active enum payload.
(#enum Child (#linear) ((Waiting #u64)))

(#enum ChildPoll () ((ChildPending Child) (ChildReady #u64)))
(#fn child-poll ((task Child) (waker (#ref #u64))) ChildPoll
  (#return (#match task
    (#case (Waiting count)
      (#if (#u64.== count 0u64)
        (ChildPending (Waiting 1u64))
        (ChildReady 2u64))))))
(#fn cancel-child ((task Child)) () (#forget task) (#return ()))

(#struct NumberPayload () ((value #u64)))
(#enum Choice () ((Number NumberPayload) (Other #u64)))
(#struct Owner () ((choice Choice)))

(@#async-fn-pinned ( : protocol ReadAfterAwaitAwait
                   : waker #u64
                   : function
  (#fn read-after-await ((owner Owner)) #u64
    (#let view (#pin-ref #u64)
      (#pin-borrow
        (#get (#pin-get-payload (#pin-borrow (#get owner choice)) Number 0) value)))
    (#let result #u64
      (#await Child ChildPending ChildReady child-poll (Waiting 0u64)))
    (#return (#u64.+.wrap (#deref view) result)))))

(#fn main () #u64
  (#let-mut frame Read-after-await-frame
    (#call read-after-await
      (: owner (#struct-literal Owner
        ((choice (Number (#struct-literal NumberPayload ((value 40u64))))))))))
  (#let waker #u64 0u64)
  (#let first Read-after-await-poll-result
    (#call read-after-await-poll
      (: task (#pin-borrow-mut frame) : waker (#borrow waker))))
  (#let-else (read-after-await-pending pending-frame) Read-after-await-poll-result first (#unreachable))
  (#let second Read-after-await-poll-result
    (#call read-after-await-poll (: task pending-frame : waker (#borrow waker))))
  (#let result #u64
    (#match second
      (#case (read-after-await-ready value) value)
      (#case (read-after-await-pending unexpected)
        (#block (#forget unexpected) (#unreachable)))))
  (#forget frame)
  (#forget waker)
  (#return result))
