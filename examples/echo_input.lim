; Echo standard input one byte at a time through POSIX read/write.
; These calls are explicitly unsafe because their behavior is provided by FFI.
(#extern-fn #abi-c read ((fd i32) (buffer (#ptr-mut u8)) (count usize)) i64)
(#extern-fn #abi-c write ((fd i32) (buffer (#ptr u8)) (count usize)) i64)

(#fn main () i32
  (#let-mut byte u8 0u8)
  (#let-mut count i64
    (#unsafe (#call read (#fn-args
      (fd 0i32)
      (buffer (#unsafe (#addr-of-mut byte)))
      (count 1usize)))))
  (#while (#i64.!= count 0i64)
    (#unsafe (#call write (#fn-args
      (fd 1i32)
      (buffer (#unsafe (#addr-of byte)))
      (count 1usize))))
    (#set count
      (#unsafe (#call read (#fn-args
        (fd 0i32)
        (buffer (#unsafe (#addr-of-mut byte)))
        (count 1usize))))))
  (#return 0))
