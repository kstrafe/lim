// The loop initializer destructures a struct into mutable, explicitly typed leaves.
#struct Bounds () ((z (#tuple #u64 #u64)) (a #u64))
#enum Step () ((Step.Start #u64) (Step.Resume #u64))
#enum StepPoll () ((StepPoll.StepPending Step) (StepPoll.StepReady #u64))

#fn step-poll {
  #params = ((task Step) (waker (#ref #u64)));
  #returns = StepPoll;
  #body = ((#return (#match task
        (#case (Step.Start value)
          (StepPoll.StepPending (Step.Resume value))
        )
        (#case (Step.Resume value)
          (StepPoll.StepReady value)
        )
      )));
}

#generate #async-fn ((protocol WorkAwait) (waker #u64) (function (#fn work ((bounds Bounds)) #u64
      (#let-mut total #u64 1u64)
      (#for (#let-mut (Bounds (#tuple iteration limit) bias) Bounds bounds) (#u64::lt iteration
        limit) (#set iteration (#u64::add-wrap iteration 1u64))
        (#let value #u64 (#await Step StepPoll.StepPending StepPoll.StepReady step-poll
            (Step.Start iteration)))
        (#set total (#u64::add-wrap total (#u64::add-wrap value bias)))
      )
      // The initializer's scope has ended; this is an independent binding.
      (#let iteration #u64 42u64)
      (#return (#u64::add-wrap total (#u64::sub-wrap iteration 42u64))))))

#fn main {
  #params = ();
  #returns = #u64;
  #effects = ((#effects-of Work::poll));
  #body = (
    (#let waker #u64 0u64)
    (#let-mut task Work::Task (#call work ((bounds (#struct-literal Bounds ((a 20u64) (z (#tuple
                    (#tuple #u64 #u64) 0u64 2u64))))))))
    (#for-range (attempt #u64) 0u64 4u64
      (#let outcome Work::Poll (#call Work::poll ((task task) (waker (#borrow waker)))))
      (#match outcome
        (#case (Work::Poll.Pending next)
          (#block
            (#set task next)
            ()
          )
        )
        (#case (Work::Poll.Ready value)
          (#block
            (#return value)
          )
        )
      )
    )
    (#forget task)
    (#return (#unreachable))
  );
}
