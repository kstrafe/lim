; Both paths consume the same structural owner obligation.
(#struct Resource (#linear) ((value #u64)))

(#struct Wrapper () ((item Resource) (copy #u64)))

(#fn main () #u64
  (#let wrapper Wrapper
    (#struct-literal Wrapper
      ((item (#struct-literal Resource ((value 1u64))))
       (copy 2u64))))
  (#let take-whole #bool (#u64.== 1u64 2u64))
  (#return (#if take-whole
    (#block (#forget wrapper) 10u64)
    (#block (#forget (#get wrapper item)) 42u64))))
