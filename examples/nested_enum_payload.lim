#enum Boxed () ((Boxed.Wrapped (#tuple #u64 #u64)) Boxed.Empty)

#fn sum {
  #params = ((value Boxed));
  #returns = #u64;
  #body = ((#return (#match value
        (#case (Boxed.Wrapped (#tuple left right))
          (#u64::add-wrap left right)
        )
        (#case Boxed.Empty
          0
        )
      )));
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = ((#return (#call sum ((value (Boxed.Wrapped (#tuple (#tuple #u64 #u64) 10 22)))))));
}
