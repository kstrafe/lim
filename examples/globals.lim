#let scale #f32 1.5

#let pi #f64 3.25

#let letter #char #\a

#fn
    main {
  #params = ();
  #returns = #u64;
  #body = (
    (
      #return
      (
        #if
        (#bool::and
          (#f32::gt  scale 1.0)
          (#bool::and
            (#f64::gt  pi 3.0)
            (#char::eq  letter #\a)
          )
        )
        42
        0
      )
    )
  );
}
