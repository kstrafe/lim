(#fn consume ((value (#array (#tuple u128 u64) 4))) u64
  (#let item (#tuple u128 u64) (#index value 3u64))
  (#return (#get item 1)))

(#fn main () u64
  (#return
    (#call consume (: value (#array (#array (#tuple u128 u64) 4)
        (#tuple 10u128 1u64)
        (#tuple 20u128 2u64)
        (#tuple 30u128 3u64)
        (#tuple 40u128 42u64))))))
