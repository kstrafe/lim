(#import "../library/linux_x86_64.lim")

(#fn main () #u64
  (#let memory (#ptr-mut #i64)
    (#unsafe (#linux-syscall (#ptr-mut #i64) LINUX-SYS-MMAP
      (0usize 4096usize 3usize 34usize -1i64 0usize))))
  (#let initialized ()
    (#unsafe
      (#block
        (#ptr-write memory 0i64)
        (#ptr-write (#ptr-offset memory 1usize) 0i64)
        (#ptr-write (#ptr-offset memory 2usize) 60i64)
        (#ptr-write (#ptr-offset memory 3usize) 0i64)
        ()) ))
  (#let initial-query #i64
    (#unsafe (#unsafe-call linux-getitimer (: which 0i64 : current-value (#ptr-offset memory 8usize)))))
  (#let timer-armed #i64
    (#unsafe (#unsafe-call linux-setitimer (: which 0i64 : new-value memory : old-value (#ptr-offset memory 4usize)))))
  (#let active-query #i64
    (#unsafe (#unsafe-call linux-getitimer (: which 0i64 : current-value (#ptr-offset memory 8usize)))))
  (#let remaining-seconds #i64
    (#unsafe (#ptr-read (#ptr-offset memory 10usize))))
  (#let remaining-microseconds #i64
    (#unsafe (#ptr-read (#ptr-offset memory 11usize))))
  (#let timer-restored #i64
    (#unsafe (#unsafe-call linux-setitimer (: which 0i64 : new-value (#ptr-offset memory 4usize) : old-value (#ptr-offset memory 12usize)))))
  (#let restored-query #i64
    (#unsafe (#unsafe-call linux-getitimer (: which 0i64 : current-value (#ptr-offset memory 16usize)))))
  (#let original-interval-seconds #i64
    (#unsafe (#ptr-read (#ptr-offset memory 4usize))))
  (#let restored-interval-seconds #i64
    (#unsafe (#ptr-read (#ptr-offset memory 16usize))))
  (#let original-interval-microseconds #i64
    (#unsafe (#ptr-read (#ptr-offset memory 5usize))))
  (#let restored-interval-microseconds #i64
    (#unsafe (#ptr-read (#ptr-offset memory 17usize))))
  (#let original-expiration-seconds #i64
    (#unsafe (#ptr-read (#ptr-offset memory 6usize))))
  (#let restored-expiration-seconds #i64
    (#unsafe (#ptr-read (#ptr-offset memory 18usize))))
  (#let original-expiration-microseconds #i64
    (#unsafe (#ptr-read (#ptr-offset memory 7usize))))
  (#let restored-expiration-microseconds #i64
    (#unsafe (#ptr-read (#ptr-offset memory 19usize))))
  (#let memory-unmapped #i64
    (#unsafe (#linux-syscall #i64 LINUX-SYS-MUNMAP (memory 4096usize))))
  (#let expiration-active #bool
    (#bool.|| (#i64.> remaining-seconds 0i64)
      (#i64.> remaining-microseconds 0i64)))
  (#let state-restored #bool
    (#bool.&& (#i64.== original-interval-seconds restored-interval-seconds)
      (#bool.&& (#i64.== original-interval-microseconds restored-interval-microseconds)
        (#bool.&& (#i64.== original-expiration-seconds restored-expiration-seconds)
          (#i64.== original-expiration-microseconds restored-expiration-microseconds)))))
  (#return
    (#if (#bool.&& (#i64.== initial-query 0i64)
      (#bool.&& (#i64.== timer-armed 0i64)
        (#bool.&& (#i64.== active-query 0i64)
          (#bool.&& expiration-active
            (#bool.&& (#i64.== timer-restored 0i64)
              (#bool.&& (#i64.== restored-query 0i64)
                (#bool.&& state-restored (#i64.== memory-unmapped 0i64)))))))) 42u64 1u64)))
