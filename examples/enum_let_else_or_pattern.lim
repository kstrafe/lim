#enum Maybe () ((Maybe.Some #u64) Maybe.None)

#fn classify {
  #params = ((value Maybe));
  #returns = #u64;
  #body = (
    (#let-else (#or (Maybe.Some 1u64) (Maybe.Some 2u64) Maybe.None) Maybe value (#return 0u64))
    (#return 42u64)
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = ((#return (#call classify ((value (Maybe.Some 2u64))))));
}
