#let answer #u64 42

#fn identity {
  #params = ((value (#ref #u64)));
  #returns = (#ref #u64);
  #body = (
    (#return value)
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #effects = ((#read-global answer));
  #body = (
    (#return (#deref (#call identity ((value (#borrow answer))))))
  );
}
