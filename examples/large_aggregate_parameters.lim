(#struct Large
  ((a u64) (b u64) (c u64) (d u64)
   (e u64) (f u64) (g u64)))

(#enum LargePayload
  ((Big u64 u64 u64 u64 u64 u64 u64) Empty))

(#fn consume-tuple ((value (#tuple u64 u64 u64 u64 u64 u64 u64))) u64
  (#return (#get value 6)))

(#fn consume-struct ((value Large)) u64
  (#return (#get value g)))

(#fn consume-enum ((value LargePayload)) u64
  (#return
    (#match value
      ((Big first second third fourth fifth sixth seventh) seventh)
      (Empty 0u64))))

(#fn main () u64
  (#let tuple-value (#tuple u64 u64 u64 u64 u64 u64 u64)
    (#tuple (#tuple u64 u64 u64 u64 u64 u64 u64)
      1u64 2u64 3u64 4u64 5u64 6u64 42u64))
  (#let struct-value Large
    (Large 1u64 2u64 3u64 4u64 5u64 6u64 42u64))
  (#let enum-value LargePayload
    (Big 1u64 2u64 3u64 4u64 5u64 6u64 42u64))
  (#return
    (#u64.+.wrap
      (#u64.+.wrap (consume-tuple tuple-value) (consume-struct struct-value))
      (consume-enum enum-value))))
