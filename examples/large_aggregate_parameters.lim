(#struct Large
  ((a u64) (b u64) (c u64) (d u64)
   (e u64) (f u64) (g u64)))

(#enum LargePayload
  ((Big u64 u64 u64 u64 u64 u64 u64) Empty))

(#fn consume-tuple ((value (#tuple u64 u64 u64 u64 u64 u64 u64))) u64
  (#return (#get value 6)))

(#fn consume-struct ((value Large)) u64
  (#return (#get value g)))

(#fn consume-enum ((value LargePayload)) u64
  (#return
    (#match value
      (#case (Big first second third fourth fifth sixth seventh) seventh)
      (#case Empty 0u64))))

(#fn main () u64
  (#let tuple-value (#tuple u64 u64 u64 u64 u64 u64 u64)
    (#tuple (#tuple u64 u64 u64 u64 u64 u64 u64)
      1u64 2u64 3u64 4u64 5u64 6u64 42u64))
  (#let struct-value Large
    (#struct-literal Large ((a 1u64) (b 2u64) (c 3u64) (d 4u64) (e 5u64) (f 6u64) (g 42u64))))
  (#let enum-value LargePayload
    (Big 1u64 2u64 3u64 4u64 5u64 6u64 42u64))
  (#return
    (#u64.+.wrap
      (#u64.+.wrap (#call consume-tuple (#fn-args (value tuple-value))) (#call consume-struct (#fn-args (value struct-value))))
      (#call consume-enum (#fn-args (value enum-value))))))
