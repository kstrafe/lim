(#struct Arena ((cursor (#cell u64))))
(#struct VecU64Arena ((allocator (#ref Arena)) (length u64)))

(#fn VecU64Arena-reserve ((vector (#ref VecU64Arena)) (count u64)) u64
  (#cell-set
    (#get (#get vector allocator) cursor)
    (#u64.+.wrap (#cell-get (#get (#get vector allocator) cursor)) count))
  (#return (#cell-get (#get (#get vector allocator) cursor))))

(#fn main () u64
  (#let-mut arena Arena (#struct-literal Arena ((cursor (#cell 0)))))
  (#let-mut vector VecU64Arena (#struct-literal VecU64Arena ((allocator (#borrow arena)) (length 0))))
  (#let reserved u64 (#call VecU64Arena-reserve (#fn-args (vector (#borrow vector)) (count 42))))
  (#drop vector)
  (#forget arena)
  (#return reserved))
