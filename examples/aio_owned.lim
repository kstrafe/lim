(#alias AioOwnedCancel = ../library/aio_owned.lim::AioOwnedCancel)
(#alias AioOwnedCompleted = ../library/aio_owned.lim::AioOwnedCompleted)
(#alias AioOwnedContext = ../library/aio_owned.lim::AioOwnedContext)
(#alias AioOwnedContextCreate = ../library/aio_owned.lim::AioOwnedContextCreate)
(#alias AioOwnedPending = ../library/aio_owned.lim::AioOwnedPending)
(#alias AioOwnedSubmit = ../library/aio_owned.lim::AioOwnedSubmit)
(#alias AioOwnedWait = ../library/aio_owned.lim::AioOwnedWait)
(#alias aio-owned-cancel-wait = ../library/aio_owned.lim::aio-owned-cancel-wait)
(#alias aio-owned-completed-byte = ../library/aio_owned.lim::aio-owned-completed-byte)
(#alias aio-owned-completed-destroy = ../library/aio_owned.lim::aio-owned-completed-destroy)
(#alias aio-owned-completed-result = ../library/aio_owned.lim::aio-owned-completed-result)
(#alias aio-owned-context-create = ../library/aio_owned.lim::aio-owned-context-create)
(#alias aio-owned-context-destroy = ../library/aio_owned.lim::aio-owned-context-destroy)
(#alias aio-owned-poll-submit = ../library/aio_owned.lim::aio-owned-poll-submit)
(#alias aio-owned-read-submit = ../library/aio_owned.lim::aio-owned-read-submit)
(#alias aio-owned-wait = ../library/aio_owned.lim::aio-owned-wait)
(#alias linux-close = ../library/linux_x86_64.lim::linux-close)
(#alias linux-eventfd2 = ../library/linux_x86_64.lim::linux-eventfd2)
(#alias linux-memfd-create = ../library/linux_x86_64.lim::linux-memfd-create)
(#alias linux-mmap = ../library/linux_x86_64.lim::linux-mmap)
(#alias linux-munmap = ../library/linux_x86_64.lim::linux-munmap)
(#alias linux-write = ../library/linux_x86_64.lim::linux-write)

(#fn main () #u64
  (#let scratch (#ptr-mut #u8)
    (#unsafe (#unsafe-call linux-mmap
      ((address (#ptr-null (#ptr-mut #u8))) (length 4096usize)
       (protection 3u32) (flags 34u32) (fd -1i64) (offset 0i64)))))
  (#let name (#ptr-mut #u8) scratch)
  (#unsafe (#ptr-write name 0u8))
  (#let fd #i64 (#unsafe (#unsafe-call linux-memfd-create
    ((name name) (flags 1u32)))))
  (#assert (#i64::ge fd 0i64))
  (#let input (#ptr-mut #u8) (#unsafe (#ptr-offset scratch 32usize)))
  (#unsafe (#block
    (#ptr-write input 76u8)
    (#ptr-write (#ptr-offset (#clone input) 1usize) 73u8)
    (#ptr-write (#ptr-offset (#clone input) 2usize) 77u8)
    (#ptr-write (#ptr-offset (#clone input) 3usize) 33u8)))
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-write
    ((fd fd) (source input) (count 4usize)))) 4i64))
  (#let context-result AioOwnedContextCreate (#call aio-owned-context-create ()))
  (#let-mut context AioOwnedContext
    (#match context-result
      (#case (AioOwnedContextCreate.AioOwnedContextCreated owner) owner)
      (#case (AioOwnedContextCreate.AioOwnedContextCreateFailed error)
        (#block (#forget error) (#unreachable)))))

  //; A readiness operation is cancelled asynchronously; the wrapper waits for
  //; its completion acknowledgement before exposing a completed owner.
  (#let poll-fd #i64 (#call linux-eventfd2 ((initial-value 0u32) (flags 526336i32))))
  (#assert (#i64::ge poll-fd 0i64))
  (#let poll-submission AioOwnedSubmit
    (#call aio-owned-poll-submit
      ((context (#borrow context)) (fd poll-fd) (events 1u16))))
  (#let poll-operation AioOwnedPending
    (#match poll-submission
      (#case (AioOwnedSubmit.AioOwnedSubmitted operation) operation)
      (#case (AioOwnedSubmit.AioOwnedSubmitFailed error)
        (#block (#forget error) (#unreachable)))))
  (#let cancel-result AioOwnedCancel
    (#call aio-owned-cancel-wait ((operation poll-operation))))
  (#let cancelled AioOwnedCompleted
    (#match cancel-result
      (#case (AioOwnedCancel.AioOwnedCancelFinished operation) operation)
      (#case (AioOwnedCancel.AioOwnedCancelFailed failure)
        (#block
          (#let (#tuple still-pending error)
            (#tuple AioOwnedPending #i64) failure)
          (#forget error)
          (#forget still-pending)
          (#unreachable)))))
  (#assert (#i64::eq (#call aio-owned-completed-result
    ((operation (#borrow cancelled)))) 0i64))
  (#let cancel-unmapped #i64
    (#call aio-owned-completed-destroy ((operation cancelled))))
  (#assert (#i64::eq cancel-unmapped 0i64))
  (#assert (#i64::eq (#call linux-close ((fd poll-fd))) 0i64))

  (#let read-submission AioOwnedSubmit
    (#call aio-owned-read-submit
      ((context (#borrow context)) (fd fd) (length 4usize) (offset 0i64))))
  (#let read-operation AioOwnedPending
    (#match read-submission
      (#case (AioOwnedSubmit.AioOwnedSubmitted operation) operation)
      (#case (AioOwnedSubmit.AioOwnedSubmitFailed error)
        (#block (#forget error) (#unreachable)))))
  (#let wait-result AioOwnedWait (#call aio-owned-wait ((operation read-operation))))
  (#let completed AioOwnedCompleted
    (#match wait-result
      (#case (AioOwnedWait.AioOwnedFinished operation) operation)
      (#case (AioOwnedWait.AioOwnedWaitFailed failure)
        (#block
          (#let (#tuple still-pending error)
            (#tuple AioOwnedPending #i64) failure)
          (#forget error)
          (#forget still-pending)
          (#unreachable)))))
  (#assert (#i64::eq (#call aio-owned-completed-result
    ((operation (#borrow completed)))) 4i64))
  (#assert (#u8::eq (#call aio-owned-completed-byte
    ((operation (#borrow completed)) (index 0usize))) 76u8))
  (#assert (#u8::eq (#call aio-owned-completed-byte
    ((operation (#borrow completed)) (index 1usize))) 73u8))
  (#assert (#u8::eq (#call aio-owned-completed-byte
    ((operation (#borrow completed)) (index 2usize))) 77u8))
  (#assert (#u8::eq (#call aio-owned-completed-byte
    ((operation (#borrow completed)) (index 3usize))) 33u8))
  (#let read-unmapped #i64
    (#call aio-owned-completed-destroy ((operation completed))))
  (#assert (#i64::eq read-unmapped 0i64))
  (#let context-destroyed #i64
    (#call aio-owned-context-destroy ((context context))))
  (#assert (#i64::eq context-destroyed 0i64))
  (#assert (#i64::eq (#call linux-close ((fd fd))) 0i64))
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-munmap
    ((address scratch) (length 4096usize)))) 0i64))
  (#return 42u64))
