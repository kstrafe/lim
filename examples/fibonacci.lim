(#fn fib ((n #u64)) #u64
  (#let-mut a #u64 0)
  (#let-mut b #u64 1)
  (#let-mut i #u64 0)
  (#let-mut next #u64 0)
  (#while (#u64.< (#clone i) (#clone n))
    (#set next (#u64.+.wrap (#clone a) (#clone b)))
    (#set a (#clone b))
    (#set b next)
    (#set i (#u64.+.wrap (#clone i) 1)))
  (#return a))
(#fn main () #u64
  (#return (#call fib (: n 10))))
