#fn fib {
  #params = ((n #u64));
  #returns = #u64;
  #body = (
    (#let-mut a #u64 0)
    (#let-mut b #u64 1)
    (#let-mut i #u64 0)
    (#let-mut next #u64 0)
    (#while (#u64::lt (#clone i) (#clone n))
      (#set next (#u64::add-wrap (#clone a) (#clone b)))
      (#set a (#clone b))
      (#set b next)
      (#set i (#u64::add-wrap (#clone i) 1))
    )
    (#return a)
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = ((#return (#call fib ((n 10)))));
}
