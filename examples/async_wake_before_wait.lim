;; A pre-published local wake must make the blocking wait return immediately,
;; even when the only descriptor is disabled and can never become ready.
(#import "../library/wake_ready4.lim")
(#import "../library/async_poll4.lim")

(#fn main () #u64
  (#let-mut queue WakeReady4 (#call wake-ready4-create (:)))
  (#let registration WakeRegister4
    (#call wake-ready4-register (: queue (#borrow-mut queue) : slot 0usize)))
  (#let token WakeToken4 (#match registration
    (#case (WakeRegistered4 value) value)
    (#case _ (#unreachable))))
  (#assert (#call wake-ready4-notify (: queue (#borrow queue) : token token)))
  (#let source AsyncPollSource4
    (#call async-poll4-source
      (: fd -1i64 : queue (#borrow queue) : token token)))
  (#let entries (#array AsyncPollSource4 1) (#array-of (#array AsyncPollSource4 1) source))
  (#let sources (#slice AsyncPollSource4) (#borrow-slice entries))
  (#let result AsyncPoll4Result
    (#call async-poll4-wait (: sources sources : timeout-ms -1i32)))
  (#let ready #bool (#match result
    (#case (AsyncPoll4Ready mask) (#u32.== mask 1u32))
    (#case (AsyncPoll4Failed error) (#block (#forget error) false))))
  (#let retired WakeRetire4
    (#call wake-ready4-retire (: queue (#borrow-mut queue) : token token)))
  (#assert (#match retired
    (#case WakeRetired4 true)
    (#case WakeStale4 false)))
  (#forget queue)
  (#return (#if ready 42u64 1u64)))
