#alias lINUX-SYS-PRCTL = ../library/linux_x86_64_syscall_numbers.lim::lINUX-SYS-PRCTL
#alias lINUX-SYS-WAIT4 = ../library/linux_x86_64_syscall_numbers.lim::lINUX-SYS-WAIT4
#alias linux-exit = ../library/linux_x86_64.lim::linux-exit
#alias linux-fork = ../library/linux_x86_64.lim::linux-fork
#alias linux-mmap = ../library/linux_x86_64.lim::linux-mmap
#alias linux-munmap = ../library/linux_x86_64.lim::linux-munmap
#alias linux-pkey-alloc = ../library/linux_x86_64.lim::linux-pkey-alloc
#alias linux-pkey-free = ../library/linux_x86_64.lim::linux-pkey-free
#alias linux-pkey-mprotect = ../library/linux_x86_64.lim::linux-pkey-mprotect
#alias linux-write = ../library/linux_x86_64.lim::linux-write

// Requires Linux x86-64 with protection-key support enabled (PKU/OSPKE).
#fn main {
  #params = ();
  #returns = #u64;
  #effects = (#global-access #io (#effects-of linux-exit) (#effects-of linux-fork) (#effects-of linux-mmap) (#effects-of linux-munmap) (#effects-of linux-pkey-alloc) (#effects-of linux-pkey-free) (#effects-of linux-pkey-mprotect) (#effects-of linux-write));
  #body = (
    (#assert (#i64::eq (#call linux-pkey-alloc ((flags 1u32) (access-rights 0u32))) -22i64))
    (#assert (#i64::eq (#call linux-pkey-alloc ((flags 0u32) (access-rights 4u32))) -22i64))
    (#let allocated #i64 (#call linux-pkey-alloc ((flags 0u32) (access-rights 2u32))))
    (#assert (#bool::and (#i64::gt allocated 0i64) (#i64::lt allocated 16i64)))
    (#let key #i32 (#as allocated #i32))
    (#let memory (#ptr-mut #u8) (#unsafe (#unsafe-call linux-mmap ((address (#ptr-null (#ptr-mut #u8))) (length 4096usize) (protection 3u32) (flags 34u32) (fd -1i64) (offset 0i64)))))
    (#unsafe (#ptr-write memory 75u8))
    (#unsafe (#ptr-write (#ptr-offset memory 1usize) 10u8))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-pkey-mprotect ((address memory) (length 4096usize) (protection 3u32) (key key)))) 0i64))
    // Page permissions allow writes, but this thread's key disables them.
    (#let rights #u32 (#unsafe (#asm #u32 () "xor ecx, ecx\nrdpkru")))
    (#let shift #u32 (#u32::mul-wrap (#as key #u32) 2u32))
    (#assert (#u32::eq (#u32::bit-and (#u32::shr rights shift) 3u32) 2u32))
    (#assert (#u8::eq (#unsafe (#ptr-read memory)) 75u8))
    (#let child #i64 (#unsafe (#unsafe-call linux-fork ())))
    (#assert (#i64::ge child 0i64))
    (#if (#i64::eq child 0i64)
      (#block
        // Disable core dumps for the intentional access violation in the child.
        (#assert (#i64::eq (#unsafe (#linux-syscall #i64 lINUX-SYS-PRCTL
          (4i32 0usize 0usize 0usize 0usize))) 0i64))
        (#unsafe (#ptr-write memory 88u8))
        (#unsafe (#unsafe-call linux-exit ((status 99i32))))) ())
    (#let-mut status #i32 0i32)
    (#assert (#i64::eq (#unsafe (#linux-syscall #i64 lINUX-SYS-WAIT4
      (child (#addr-of-mut status) 0i32 0usize))) child))
    // Reassign to key zero before freeing the key, even if the child check fails.
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-pkey-mprotect ((address memory) (length 4096usize) (protection 3u32) (key 0i32)))) 0i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-pkey-free ((key key)))) 0i64))
    (#assert (#i32::eq (#i32::bit-and status 127i32) 11i32))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-pkey-free ((key key)))) -22i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-pkey-mprotect ((address memory) (length 4096usize) (protection 3u32) (key key)))) -22i64))
    (#unsafe (#ptr-write memory 75u8))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-write ((fd 1i64) (source memory) (count 2usize)))) 2i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-munmap ((address memory) (length 4096usize)))) 0i64))
    (#return 42u64)
  );
}
