#enum Wrapped ()
    ((Wrapped.Values (#array #u64 7)) Wrapped.Empty)

#fn main () #u64
    (#let value Wrapped
      (Wrapped.Values
        (#array (#array #u64 7)
          1u64 2u64 3u64 4u64 5u64 6u64 42u64)))
    (#let-else (Wrapped.Values payload) Wrapped value
      (#return 0u64))
    (#return (#index payload 6u64))
