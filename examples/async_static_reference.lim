// A selected reference can point into a pinned frame or directly into a static.
// Neither path needs a synthetic external-reference parameter.
#static fallback #u64 40u64
#enum Step (#linear) ((Step.Waiting #u64))
#enum StepPoll (#linear) ((StepPoll.Pending Step) (StepPoll.Ready #u64))

#fn step-poll {
  #params = ((task Step) (waker (#ref #u64)));
  #returns = StepPoll;
  #body = ((#return (#match task
        (#case (Step.Waiting count)
          (#if (#u64::eq count 0u64)
            (#enum-literal StepPoll.Ready 2u64)
            (#enum-literal StepPoll.Pending
              (#enum-literal Step.Waiting (#u64::sub-wrap count 1u64)))
          )
        )
      )));
}

#fn cancel-step {
  #params = ((task Step));
  #returns = ();
  #body = ((#forget task) (#return ()));
}

#generate #async-fn-pinned ((protocol WorkAwait) (waker #u64) (cancel (work-cancel ((await-0
          cancel-step)))) (function (#fn work ((choose-local #bool)) #u64 (#effects ((#read-global
            fallback))) (#let local #u64 50u64) (#let view (#ref #u64) (#if choose-local
          (#borrow local)
          (#unsafe
            (#borrow fallback)
          )
        )) (#let bonus #u64 (#await Step StepPoll.Pending StepPoll.Ready step-poll (#enum-literal
            Step.Waiting 1u64))) (#let answer #u64 (#u64::add-wrap (#deref view) bonus)) (#drop
        view) (#forget local) (#return answer))))

#fn run {
  #params = ((choose-local #bool));
  #returns = #u64;
  #effects = ((#effects-of Work::Poll::destroy) (#effects-of Work::poll));
  #body = (
    (#let waker #u64 0u64)
    (#let-mut frame Work::Frame (#call work (($ choose-local))))
    (#let-else (Work::Poll.Pending pending) (#call Work::poll ((task (#pin-borrow-mut frame))
          (waker (#borrow waker)))) (#else (#unreachable)))
    (#let result Work::Poll (#call Work::poll ((task pending) (waker (#borrow waker)))))
    (#let answer #u64 (#match result
        (#case (Work::Poll.Ready value)
          value
        )
        (#case (Work::Poll.Pending unexpected)
          (#forget unexpected)
          (#unreachable)
        )
      ))
    (#call Work::Poll::destroy ((task (#pin-borrow-mut frame))))
    (#forget frame)
    (#return answer)
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #effects = ((#effects-of run));
  #body = (
    (#assert (#u64::eq (#call run ((choose-local true))) 52u64))
    (#assert (#u64::eq (#call run ((choose-local false))) 42u64))
    (#return 42u64)
  );
}
