#fn positive {
  #params = { value = #u64; };
  #returns = #bool;
  #body: #return [#u64; value > 0u64];
}

#fn double {
  #params = { value = #u64; };
  #returns = #u64;
  #requires:
    positive { value = value; };
    [#u64; value < 22u64];
  #body: #return [#u64 #wrap; value * 2u64];
}

#fn main {
  #params = { };
  #returns = #u64;
  #body:
    #let seed #u64 21u64;
    #return (#if-valid {
      #condition = (#bool::and
        (positive { value = seed; })
        [#u64; seed < 22u64]);
      #then:
        #let answer #u64 (double { value = seed; });
        #if {
          #condition = [#u64; answer == 42u64];
          #then = answer;
          #else = 0u64;
        };
      #else: 0u64;
    });
}
