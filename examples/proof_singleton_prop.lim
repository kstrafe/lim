; A neutral proof in the constructor's indexed fibre computes to the sole branch.
(#math-inductive singleton-prop ()
  ((P #pt-prop))
  (#indices
    (#parameter i #pt-nat))
  #pt-prop
  ((witness () (#pt-zero))))
(#theorem neutral-singleton-prop-computes
  (#universes)
  (#parameters
    (#parameter P #pt-prop)
    (#parameter h (#pt-eq #pt-nat #pt-zero #pt-zero))
    (#parameter subject (#pt-app (#pt-use singleton-prop ()) P #pt-zero)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app
        (#pt-induct
          singleton-prop
          ()
          (P)
          (#indices #pt-zero)
          (#pt-lambda
            ((index #pt-nat) (proof (#pt-app (#pt-use singleton-prop ()) P index)))
            (#pt-pi ((equality (#pt-eq #pt-nat index #pt-zero))) #pt-nat))
          ((#pt-lambda ((equality (#pt-eq #pt-nat #pt-zero #pt-zero))) #pt-zero))
          subject)
        h)
      #pt-zero))
  (#proof (#pt-refl #pt-nat #pt-zero)))

(#fn main () #u64
  (#return 42u64))
