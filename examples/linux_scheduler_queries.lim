#alias lINUX-SYS-MMAP = ../library/linux_x86_64_syscall_numbers.lim::lINUX-SYS-MMAP
#alias lINUX-SYS-MUNMAP = ../library/linux_x86_64_syscall_numbers.lim::lINUX-SYS-MUNMAP
#alias linux-getpriority = ../library/linux_x86_64.lim::linux-getpriority
#alias linux-sched-get-priority-max = ../library/linux_x86_64.lim::linux-sched-get-priority-max
#alias linux-sched-get-priority-min = ../library/linux_x86_64.lim::linux-sched-get-priority-min
#alias linux-sched-getparam = ../library/linux_x86_64.lim::linux-sched-getparam
#alias linux-sched-getscheduler = ../library/linux_x86_64.lim::linux-sched-getscheduler

#fn main {
  #params = ();
  #returns = #u64;
  #effects = (#global-access #io (#effects-of linux-getpriority) (#effects-of
      linux-sched-get-priority-max) (#effects-of linux-sched-get-priority-min) (#effects-of
      linux-sched-getparam) (#effects-of linux-sched-getscheduler));
  #body = (
    (#let scheduler-memory (#ptr-mut #i32) (#unsafe
        (#linux-syscall (#ptr-mut #i32) lINUX-SYS-MMAP (0usize 4096usize 3usize 34usize -1i64
            0usize))
      ))
    (#let policy #i64 (#unsafe
        (#call linux-sched-getscheduler ((pid 0i64)))
      ))
    (#let parameters-read #i64 (#unsafe
        (#unsafe-call linux-sched-getparam ((pid 0i64) (scheduler-parameters scheduler-memory)))
      ))
    (#let priority #i32 (#unsafe
        (#ptr-read scheduler-memory)
      ))
    (#let other-priority-min #i64 (#unsafe
        (#call linux-sched-get-priority-min ((policy 0i64)))
      ))
    (#let other-priority-max #i64 (#unsafe
        (#call linux-sched-get-priority-max ((policy 0i64)))
      ))
    (#let fifo-priority-min #i64 (#unsafe
        (#call linux-sched-get-priority-min ((policy 1i64)))
      ))
    (#let fifo-priority-max #i64 (#unsafe
        (#call linux-sched-get-priority-max ((policy 1i64)))
      ))
    (#let invalid-priority-min #i64 (#unsafe
        (#call linux-sched-get-priority-min ((policy 99i64)))
      ))
    (#let nice-value #i64 (#unsafe
        (#call linux-getpriority ((which 0i64) (who 0i64)))
      ))
    (#let memory-unmapped #i64 (#unsafe
        (#linux-syscall #i64 lINUX-SYS-MUNMAP (scheduler-memory 4096usize))
      ))
    (#let scheduler-queries-ok #bool (#bool::and (#i64::eq policy 0i64) (#bool::and (#i64::eq
            parameters-read 0i64) (#bool::and (#i32::eq priority 0i32) (#bool::and (#i64::eq
                other-priority-min 0i64) (#bool::and (#i64::eq other-priority-max 0i64)
                (#bool::and (#i64::eq fifo-priority-min 1i64) (#bool::and (#i64::eq
                      fifo-priority-max 99i64) (#bool::and (#i64::eq invalid-priority-min -22i64)
                      (#bool::and (#i64::gt nice-value 0i64) (#i64::le nice-value 40i64)))))))))))
    (#return (#if (#bool::and scheduler-queries-ok (#i64::eq memory-unmapped 0i64))
        42u64
        1u64
      ))
  );
}
