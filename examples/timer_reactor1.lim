(#import "../library/timer_reactor1.lim")

(#fn main () u64
  (#let reactor TimerReactor1
    (#call timer-reactor1-create (: nanoseconds 1000000u64)))
  (#let first TimerPoll1
    (#call timer-reactor1-poll (: timer (#borrow reactor))))
  (#assert (#match first
    (#case TimerPending1 true)
    (#case (TimerReady1 value) false)
    (#case (TimerPollFailed1 error) false)))
  (#let wake TimerWait1
    (#call timer-reactor1-wait (: timer (#borrow reactor))))
  (#assert (#match wake
    (#case TimerWoken1 true)
    (#case (TimerWaitFailed1 error) false)))
  (#let second TimerPoll1
    (#call timer-reactor1-poll (: timer (#borrow reactor))))
  (#let ready bool (#match second
    (#case TimerPending1 false)
    (#case (TimerReady1 expirations) (#u64.>= expirations 1u64))
    (#case (TimerPollFailed1 error) false)))
  (#let closed i64 (#call timer-reactor1-cancel (: timer reactor)))
  (#let pending TimerReactor1
    (#call timer-reactor1-create (: nanoseconds 500000000u64)))
  (#let cancelled i64 (#call timer-reactor1-cancel (: timer pending)))
  (#return (#if (#bool.&& ready
    (#bool.&& (#i64.== closed 0i64) (#i64.== cancelled 0i64)))
    42u64 0u64)))
