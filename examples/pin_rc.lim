(#import "../library/pin_rc.lim")

(#struct Arena () (: destroyed (#atomic #u64) : deallocated (#atomic #u64)))
(#enum ArenaError () (OutOfMemory))
(#enum AllocationResult () ((Allocated (#ptr-mut PinnedNumberRc::Allocation)) (AllocationFailed ArenaError)))
(@#pin-rc (: type #u64 : allocator Arena : name PinnedNumberRc
  : error ArenaError : alloc-result AllocationResult : alloc-ok Allocated
  : alloc-error AllocationFailed : alloc arena-allocate : dealloc arena-deallocate
  : destroy destroy-number))

(#fn arena-allocate (: allocator (#ref Arena) : layout #usize : alignment #usize) AllocationResult
  (#let pointer (#ptr-mut PinnedNumberRc::Allocation)
    (#unsafe (#linux-syscall (#ptr-mut PinnedNumberRc::Allocation) 9usize
      (0usize layout 3usize 34usize -1i64 0usize))))
  (#return (#if (#usize.>= (#ptr-address pointer) 18446744073709547520usize)
    (AllocationFailed OutOfMemory) (Allocated pointer))))

(#fn arena-deallocate (: allocator (#ref Arena) : pointer (#ptr-mut PinnedNumberRc::Allocation)
  : layout #usize : alignment #usize) ()
  (#assert (#i64.== (#unsafe (#linux-syscall #i64 11usize (pointer layout))) 0i64))
  (#let ignored #u64 (#atomic-fetch-add (#borrow (#get allocator deallocated)) 1u64 #memory-relaxed))
  (#return ()))

(#fn destroy-number (: allocator (#ref Arena) : pin (#pin-ref-mut #u64)) ()
  (#assert (#u64.== (#deref pin) 42u64))
  (#let ignored #u64 (#atomic-fetch-add (#borrow (#get allocator destroyed)) 1u64 #memory-relaxed))
  (#forget pin) (#return ()))

(#fn main () #u64
  (#let arena Arena (#struct-literal Arena
    (: destroyed (#atomic-init #u64 0u64) : deallocated (#atomic-init #u64 0u64))))
  (#let owner PinnedNumberRc (#match (#call PinnedNumberRc::create (: allocator (#borrow arena) : value 40u64))
    (#case (PinnedNumberRc::created allocated) allocated)
    (#case (PinnedNumberRc::allocation-failed failure) (#block (#forget failure) (#unreachable)))))
  (#let clone PinnedNumberRc (#call PinnedNumberRc::clone (: owner (#borrow owner))))
  (#let-mut moved PinnedNumberRc owner)
  (#let unavailable PinnedNumberRc::MutResult (#call PinnedNumberRc::borrow-mut (: owner (#borrow-mut moved))))
  (#match unavailable
    (#case PinnedNumberRc::shared ())
    (#case (PinnedNumberRc::unique unexpected) (#block (#forget unexpected) (#unreachable))))
  (#let shared (#pin-ref #u64) (#call PinnedNumberRc::borrow (: owner (#borrow clone))))
  (#assert (#u64.== (#deref shared) 40u64)) (#drop shared)
  (#call PinnedNumberRc::destroy (: owner clone))
  (#assert (#u64.== (#atomic-load (#borrow (#get arena destroyed)) #memory-relaxed) 0u64))
  (#let available PinnedNumberRc::MutResult (#call PinnedNumberRc::borrow-mut (: owner (#borrow-mut moved))))
  (#let exclusive (#pin-ref-mut #u64) (#match available
    (#case (PinnedNumberRc::unique pin) pin)
    (#case PinnedNumberRc::shared (#unreachable))))
  (#unsafe (#pin-write exclusive 42u64)) (#drop exclusive)
  (#let observed (#pin-ref #u64) (#call PinnedNumberRc::borrow (: owner (#borrow moved))))
  (#let answer #u64 (#deref observed)) (#drop observed)
  (#call PinnedNumberRc::destroy (: owner moved))
  (#assert (#u64.== (#atomic-load (#borrow (#get arena destroyed)) #memory-relaxed) 1u64))
  (#assert (#u64.== (#atomic-load (#borrow (#get arena deallocated)) #memory-relaxed) 1u64))
  (#forget arena) (#return answer))
