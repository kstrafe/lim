(#import "../library/linux_x86_64.lim")

(#fn main () #u64
  (#let memory (#ptr-mut #i64)
    (#unsafe (#linux-syscall (#ptr-mut #i64) lINUX-SYS-MMAP
      (0usize 4096usize 3usize 34usize -1i64 0usize))))
  (#let usage-result #i64
    (#unsafe (#unsafe-call linux-getrusage (: resource 0i64 : usage memory))))
  (#let user-seconds #i64 (#unsafe (#ptr-read memory)))
  (#let user-microseconds #i64
    (#unsafe (#ptr-read (#ptr-offset memory 1usize))))
  (#let system-seconds #i64
    (#unsafe (#ptr-read (#ptr-offset memory 2usize))))
  (#let system-microseconds #i64
    (#unsafe (#ptr-read (#ptr-offset memory 3usize))))
  (#let maximum-resident-set #i64
    (#unsafe (#ptr-read (#ptr-offset memory 4usize))))
  (#let initial-limit-result #i64
    (#unsafe (#unsafe-call linux-getrlimit (: resource 7usize : limits (#ptr-offset memory 20usize)))))
  (#let initial-soft-limit #i64
    (#unsafe (#ptr-read (#ptr-offset memory 20usize))))
  (#let initial-hard-limit #i64
    (#unsafe (#ptr-read (#ptr-offset memory 21usize))))
  (#let reduced-soft-limit #i64
    (#if (#i64::gt initial-soft-limit 32i64) 32i64 initial-soft-limit))
  (#let limit-update ()
    (#unsafe
      (#block
        (#ptr-write (#ptr-offset memory 22usize) reduced-soft-limit)
        (#ptr-write (#ptr-offset memory 23usize) initial-hard-limit)
        ())))
  (#let set-limit-result #i64
    (#unsafe (#unsafe-call linux-setrlimit (: resource 7usize : limits (#ptr-offset memory 22usize)))))
  (#let current-limit-result #i64
    (#unsafe (#unsafe-call linux-getrlimit (: resource 7usize : limits (#ptr-offset memory 24usize)))))
  (#let current-soft-limit #i64
    (#unsafe (#ptr-read (#ptr-offset memory 24usize))))
  (#let current-hard-limit #i64
    (#unsafe (#ptr-read (#ptr-offset memory 25usize))))
  (#let restore-limit-result #i64
    (#unsafe (#unsafe-call linux-setrlimit (: resource 7usize : limits (#ptr-offset memory 20usize)))))
  (#let queried-limit-result #i64
    (#unsafe (#unsafe-call linux-prlimit64 (: pid 0i64 : resource 7usize : new-limits (#ptr-null (#ptr-mut #i64)) : old-limits (#ptr-offset memory 26usize)))))
  (#let restored-soft-limit #i64
    (#unsafe (#ptr-read (#ptr-offset memory 26usize))))
  (#let restored-hard-limit #i64
    (#unsafe (#ptr-read (#ptr-offset memory 27usize))))
  (#let previous-mask #i64 (#call linux-umask (: mask 18usize)))
  (#let restore-mask #i64
    (#call linux-umask (: mask (#as previous-mask #usize))))
  (#let unmapped #i64
    (#unsafe (#linux-syscall #i64 lINUX-SYS-MUNMAP (memory 4096usize))))
  (#let resources-ok #bool
    (#bool::and (#i64::eq usage-result 0i64)
      (#bool::and (#i64::ge user-seconds 0i64)
        (#bool::and (#i64::ge user-microseconds 0i64)
          (#bool::and (#i64::lt user-microseconds 1000000i64)
            (#bool::and (#i64::ge system-seconds 0i64)
              (#bool::and (#i64::ge system-microseconds 0i64)
                (#bool::and (#i64::lt system-microseconds 1000000i64)
                  (#bool::and (#i64::ge maximum-resident-set 0i64)
                    (#bool::and (#i64::eq initial-limit-result 0i64)
                      (#bool::and (#i64::gt initial-hard-limit 0i64)
                        (#bool::and (#i64::eq set-limit-result 0i64)
                          (#bool::and (#i64::eq current-limit-result 0i64)
                            (#bool::and (#i64::eq current-soft-limit reduced-soft-limit)
                              (#bool::and (#i64::eq current-hard-limit initial-hard-limit)
                                (#bool::and (#i64::eq restore-limit-result 0i64)
                                  (#bool::and (#i64::eq queried-limit-result 0i64)
                                    (#bool::and (#i64::eq restored-soft-limit initial-soft-limit)
                                      (#bool::and (#i64::eq restored-hard-limit initial-hard-limit)
                                        (#bool::and (#i64::ge previous-mask 0i64)
                                          (#bool::and (#i64::eq restore-mask 18i64)
                                            (#i64::eq unmapped 0i64))))))))))))))))))))))
  (#return (#if resources-ok 42u64 1u64)))
