(#import "../library/tasks.lim")
(#import "../library/local_waker.lim")
(#import "../library/cell.lim")
(@cell u64 CellU64 CellU64-create CellU64-get CellU64-set)

(#struct Executor ((notifications CellU64)))
(#struct WakeMetadata ((amount u64)))
(#linear WakeMetadata)

(#fn notify ((executor (#ref Executor)) (metadata (#ref WakeMetadata))) ()
  (#let cell (#ref CellU64) (#borrow (#get executor notifications)))
  (#call CellU64-set (: cell (#clone cell) : value (#u64.+.wrap (#call CellU64-get (: cell cell))
      (#get metadata amount))))
  (#return ()))

(#fn clone-metadata ((metadata (#ref WakeMetadata))) WakeMetadata
  (#return (#struct-literal WakeMetadata ((amount (#get metadata amount))))))

(#fn destroy-metadata ((executor (#ref Executor)) (metadata WakeMetadata)) ()
  (#forget metadata)
  (#return ()))

(@local-waker
  (LocalWaker local-waker-create local-waker-wake
    local-waker-wake-by-ref local-waker-clone local-waker-destroy)
  (Executor WakeMetadata)
  (notify clone-metadata destroy-metadata))

(@task (Step StepPoll StepPending StepReady) u64 ((Waiting u64)))

(#fn step-poll ((task Step) (waker (#ref LocalWaker))) StepPoll
  (#return (#match task
    (#case (Waiting remaining)
      (#if (#u64.== (#clone remaining) 0u64)
        (#block (#forget remaining) (StepReady 40u64))
        (#block
          (#call local-waker-wake-by-ref (: waker waker))
          (StepPending (Waiting (#u64.-.wrap remaining 1u64)))))))))

(@async-fn (: names (Work WorkPoll WorkPending WorkReady work-poll) : waker LocalWaker : function (#fn work ((offset u64)) u64
    (#let step Step (Waiting 1u64))
    (#let-mut total u64 0u64)
    (#set total
      (#await u64 Step StepPending StepReady step-poll step))
    (#return (#u64.+.wrap total offset)))))

(#fn cancel-step ((task Step)) ()
  (#match task
    (#case (Waiting remaining) (#forget remaining)))
  (#return ()))

(#fn cancel-work ((task Work)) ()
  (#match task
    (#case (Work-start offset) (#forget offset))
    (#case (Work-await-0 total offset child)
      (#block
        (#forget total)
        (#forget offset)
        (#call cancel-step (: task child)))))
  (#return ()))

(#fn main () u64
  (#call cancel-work (: task (#call work (: offset 99u64))))
  (#let executor Executor
    (#struct-literal Executor ((notifications
      (#call CellU64-create (: value 0u64))))))
  (#let waker LocalWaker
    (#call local-waker-create (: executor (#borrow executor) : metadata (#struct-literal WakeMetadata ((amount 1u64))))))
  (#let first WorkPoll
    (#call work-poll (: task (#call work (: offset 1u64)) : waker (#borrow waker))))
  (#let-else (WorkPending pending) WorkPoll first (#unreachable))
  (#let second WorkPoll
    (#call work-poll (: task pending : waker (#borrow waker))))
  (#let result u64
    (#match second
      (#case (WorkReady value) value)
      (#case (WorkPending task)
        (#block (#forget task) (#unreachable)))))
  (#call local-waker-destroy (: waker waker))
  (#let executor-ref (#ref Executor) (#borrow executor))
  (#let notifications u64 (#call CellU64-get (: cell (#borrow (#get executor-ref notifications)))))
  (#drop executor-ref)
  (#forget executor)
  (#return (#u64.+.wrap result notifications)))
