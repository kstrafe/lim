(#import "../library/tasks.lim")
(#import "../library/local_waker.lim")

(#struct Executor ((notifications (#cell u64))))
(#struct WakeMetadata ((amount u64)))
(#linear WakeMetadata)

(#fn notify ((executor (#ref Executor)) (metadata (#ref WakeMetadata))) ()
  (#cell-set (#get executor notifications)
    (#u64.+.wrap (#cell-get (#get executor notifications))
      (#get metadata amount)))
  (#return ()))

(#fn clone-metadata ((metadata (#ref WakeMetadata))) WakeMetadata
  (#return (#struct-literal WakeMetadata ((amount (#get metadata amount))))))

(#fn destroy-metadata ((executor (#ref Executor)) (metadata WakeMetadata)) ()
  (#forget metadata)
  (#return ()))

(@local-waker
  (LocalWaker local-waker-create local-waker-wake
    local-waker-wake-by-ref local-waker-clone local-waker-destroy)
  (Executor WakeMetadata)
  (notify clone-metadata destroy-metadata))

(@task (Step StepPoll StepPending StepReady) u64 ((Waiting u64)))

(#fn step-poll ((task Step) (waker (#ref LocalWaker))) StepPoll
  (#return (#match task
    (#case (Waiting remaining)
      (#if (#u64.== (#clone remaining) 0u64)
        (#block (#forget remaining) (StepReady 40u64))
        (#block
          (#call local-waker-wake-by-ref (#fn-args (waker waker)))
          (StepPending (Waiting (#u64.-.wrap remaining 1u64)))))))))

(@async-fn (Work WorkPoll WorkPending WorkReady work-poll) LocalWaker
  (#fn work ((offset u64)) u64
    (#let step Step (Waiting 1u64))
    (#let value u64
      (#await (offset) Step StepPending StepReady step-poll step))
    (#return (#u64.+.wrap value offset))))

(#fn cancel-step ((task Step)) ()
  (#match task
    (#case (Waiting remaining) (#forget remaining)))
  (#return ()))

(#fn cancel-work ((task Work)) ()
  (#match task
    (#case (Work-start offset) (#forget offset))
    (#case (Work-await-0 offset child)
      (#block
        (#forget offset)
        (#call cancel-step (#fn-args (task child))))))
  (#return ()))

(#fn main () u64
  (#call cancel-work (#fn-args
    (task (#call work (#fn-args (offset 99u64))))))
  (#let executor Executor
    (#struct-literal Executor ((notifications (#cell 0u64)))))
  (#let waker LocalWaker
    (#call local-waker-create (#fn-args
      (executor (#borrow executor))
      (metadata (#struct-literal WakeMetadata ((amount 1u64)))))))
  (#let first WorkPoll
    (#call work-poll (#fn-args
      (task (#call work (#fn-args (offset 1u64))))
      (waker (#borrow waker)))))
  (#let-else (WorkPending pending) WorkPoll first (#unreachable))
  (#let second WorkPoll
    (#call work-poll (#fn-args (task pending) (waker (#borrow waker)))))
  (#let result u64
    (#match second
      (#case (WorkReady value) value)
      (#case (WorkPending task)
        (#block (#forget task) (#unreachable)))))
  (#call local-waker-destroy (#fn-args (waker waker)))
  (#let notifications u64 (#cell-get (#get executor notifications)))
  (#forget executor)
  (#return (#u64.+.wrap result notifications)))
