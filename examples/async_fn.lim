#alias lim-gen-cell = ../library/cell.lim::#cell
#alias lim-gen-local-waker = ../library/local_waker.lim::#local-waker
#alias lim-gen-task = ../library/tasks.lim::#task
#alias linux-write-byte = ../library/linux_x86_64.lim::linux-write-byte

#generate lim-gen-cell { value-type = #u64; name = CellU64; create = CellU64::create; get = CellU64::get; set = CellU64::set; }

#fn print-text {
  #params = ((text (#slice #char)));
  #returns = ();
  #effects = ((#effects-of linux-write-byte));
  #body = (
    (#for-range (offset #usize) 0usize (#slice-len text)
      (#let byte #u8 (#as (#deref (#slice-idx text offset)) #u8))
      (#assert (#i64::eq (#call linux-write-byte ((source (#borrow byte)))) 1i64)))
    (#return ())
  );
}

#struct Executor () ((notifications CellU64))
#struct WakeMetadata (#linear) ((amount #u64))

#fn notify {
  #params = ((executor (#ref Executor)) (metadata (#ref WakeMetadata)));
  #returns = ();
  #body = (
    (#let cell (#ref CellU64) (#borrow (#get executor notifications)))
    (#call CellU64::set
      ((cell (#clone cell))
       (value (#u64::add-wrap (#call CellU64::get (($ cell))) (#get metadata amount)))))
    (#return ())
  );
}

#fn clone-metadata {
  #params = ((metadata (#ref WakeMetadata)));
  #returns = WakeMetadata;
  #body = (
    (#return (#struct-literal WakeMetadata ((amount (#get metadata amount)))))
  );
}

#fn destroy-metadata {
  #params = ((executor (#ref Executor)) (metadata WakeMetadata));
  #returns = ();
  #body = (
    (#forget metadata)
    (#return ())
  );
}

#generate lim-gen-local-waker
    { names = (LocalWaker
      local-waker-create
      local-waker-wake
      local-waker-wake-by-ref
      local-waker-clone
      local-waker-destroy);
    types = (Executor WakeMetadata);
    callbacks = (notify clone-metadata destroy-metadata); }
#generate lim-gen-task { names = (Step StepPoll StepPoll.StepPending StepPoll.StepReady); result = #u64; states = ((Step.Waiting #u64)); }

#fn step-poll {
  #params = ((task Step) (waker (#ref LocalWaker)));
  #returns = StepPoll;
  #body = (
    (#return
      (#match task
        (#case (Step.Waiting remaining)
          (#if (#u64::eq (#clone remaining) 0u64)
            (#block
              (#forget remaining)
              (StepPoll.StepReady 40u64))
            (#block
              (#call local-waker-wake-by-ref (($ waker)))
              (StepPoll.StepPending (Step.Waiting (#u64::sub-wrap remaining 1u64))))))))
  );
}

#syntax StepAwait (#u64 Step StepPoll.StepPending StepPoll.StepReady step-poll)
#generate #async-fn
    ((protocol WorkAwait)
     (waker LocalWaker)
     (cancel (cancel-work ((await-0 cancel-step))))
     (function (#fn work ((offset #u64)) #u64
       (#effects ((#effects-of print-text)))
         (#let started-text (#array #char 14) "work: started\n")
         (#call print-text ((text (#borrow-slice started-text))))
         (#let step Step (Step.Waiting 1u64))
         (#let-mut total #u64 0u64)
         (#set total (#await StepAwait step))
         (#let resumed-text (#array #char 14) "work: resumed\n")
         (#call print-text ((text (#borrow-slice resumed-text))))
         (#return (#u64::add-wrap total offset)))))

#fn cancel-step {
  #params = ((task Step));
  #returns = ();
  #body = (
    (#match task
      (#case (Step.Waiting remaining) (#forget remaining)))
    (#return ())
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #effects = ((#effects-of Work::Poll::cleanup) (#effects-of Work::poll) (#effects-of print-text));
  #body = (
    (#call cancel-work ((task (#call Work::Poll::cleanup ((task (#call work ((offset 99u64)))))))))
    (#let executor Executor
      (#struct-literal Executor ((notifications (#call CellU64::create ((value 0u64)))))))
    (#let waker LocalWaker
      (#call local-waker-create
        ((executor (#borrow executor)) (metadata (#struct-literal WakeMetadata ((amount 1u64)))))))
    (#let first Work::Poll
      (#call Work::poll ((task (#call work ((offset 1u64)))) (waker (#borrow waker)))))
    (#let-else (Work::Poll.Pending pending) Work::Poll
      first
      (#unreachable))
    (#let pending-text (#array #char 16) "poll 1: pending\n")
    (#call print-text ((text (#borrow-slice pending-text))))
    (#let second Work::Poll (#call Work::poll ((task pending) (waker (#borrow waker)))))
    (#let result #u64
      (#match second
        (#case (Work::Poll.Ready value) value)
        (#case (Work::Poll.Pending task)
          (#forget task)
          (#unreachable))))
    (#let ready-text (#array #char 14) "poll 2: ready\n")
    (#call print-text ((text (#borrow-slice ready-text))))
    (#call local-waker-destroy (($ waker)))
    (#let executor-ref (#ref Executor) (#borrow executor))
    (#let notifications #u64 (#call CellU64::get ((cell (#borrow (#get executor-ref notifications))))))
    (#drop executor-ref)
    (#forget executor)
    (#return (#u64::add-wrap result notifications))
  );
}
