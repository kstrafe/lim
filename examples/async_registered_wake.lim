(#import "../library/tasks.lim")
(#import "../library/local_waker.lim")
(#import "../library/wake_ready4.lim")

(#struct WakeExecutor ((queue WakeReady4)))
(#struct WakeMetadata ((token WakeToken4)))
(#linear WakeMetadata)

(#fn notify ((executor (#ref WakeExecutor)) (metadata (#ref WakeMetadata))) ()
  (#assert (#call wake-ready4-notify
    (: queue (#borrow (#get executor queue)) : token (#get metadata token))))
  (#return ()))

(#fn clone-metadata ((metadata (#ref WakeMetadata))) WakeMetadata
  (#return (#struct-literal WakeMetadata ((token (#get metadata token))))))

(#fn destroy-metadata
  ((executor (#ref WakeExecutor)) (metadata WakeMetadata)) ()
  (#forget metadata)
  (#return ()))

(@#local-waker
  (LocalWaker local-waker-create local-waker-wake
    local-waker-wake-by-ref local-waker-clone local-waker-destroy)
  (WakeExecutor WakeMetadata)
  (notify clone-metadata destroy-metadata))

(@#task (Step StepPoll StepPending StepReady) #u64 ((Waiting #u64)))

(#fn step-poll ((task Step) (waker (#ref LocalWaker))) StepPoll
  (#return (#match task
    (#case (Waiting remaining)
      (#if (#u64.== (#clone remaining) 0u64)
        (#block (#forget remaining) (StepReady 42u64))
        (#block
          (#call local-waker-wake-by-ref (: waker waker))
          (StepPending (Waiting (#u64.-.wrap remaining 1u64)))))))))

(@#async-wake
  (Pipeline PipelinePoll PipelinePending PipelineReady pipeline-poll) #u64
  ((Only (#await Step StepPending StepReady step-poll) (#return)))
  LocalWaker)

(#fn main () #u64
  (#let queue WakeReady4 (#call wake-ready4-create (:)))
  (#let-mut executor WakeExecutor (#struct-literal WakeExecutor ((queue queue))))
  (#let executor-mut (#ref-mut WakeExecutor) (#borrow-mut executor))
  (#let registration WakeRegister4
    (#call wake-ready4-register
      (: queue (#borrow-mut (#get executor-mut queue)) : slot 0usize)))
  (#drop executor-mut)
  (#let token WakeToken4 (#match registration
    (#case (WakeRegistered4 value) value)
    (#case _ (#unreachable))))
  (#let result #u64 (#block
  (#let waker LocalWaker
    (#call local-waker-create
      (: executor (#borrow executor)
       : metadata (#struct-literal WakeMetadata ((token token))))))
  (#let first PipelinePoll
    (#call pipeline-poll (: task (Only (Waiting 1u64)) : waker (#borrow waker))))
  (#let pending Pipeline (#match first
    (#case (PipelinePending task) task)
    (#case (PipelineReady result) (#unreachable))))
  (#call local-waker-wake-by-ref (: waker (#borrow waker)))
  (#let executor-ref (#ref WakeExecutor) (#borrow executor))
  (#assert (#call wake-ready4-take
    (: queue (#borrow (#get executor-ref queue)) : token token)))
  (#assert (#bool.! (#call wake-ready4-take
    (: queue (#borrow (#get executor-ref queue)) : token token))))
  (#drop executor-ref)
  (#let second PipelinePoll
    (#call pipeline-poll (: task pending : waker (#borrow waker))))
  (#let outcome #u64 (#match second
    (#case (PipelineReady value) value)
    (#case (PipelinePending task) (#block (#forget task) (#unreachable)))))
  (#call local-waker-destroy (: waker waker))
  outcome))
  (#let executor-mut-again (#ref-mut WakeExecutor) (#borrow-mut executor))
  (#let retired WakeRetire4
    (#call wake-ready4-retire
      (: queue (#borrow-mut (#get executor-mut-again queue)) : token token)))
  (#drop executor-mut-again)
  (#assert (#match retired (#case WakeRetired4 true) (#case WakeStale4 false)))
  (#let executor-ref (#ref WakeExecutor) (#borrow executor))
  (#assert (#bool.! (#call wake-ready4-notify
    (: queue (#borrow (#get executor-ref queue)) : token token))))
  (#drop executor-ref)
  (#forget executor)
  (#return result))
