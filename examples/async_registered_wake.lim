#alias WakeReady4 = ../library/wake_ready4.lim::WakeReady4
#alias WakeRegister4 = ../library/wake_tokens.lim::WakeRegister4
#alias WakeRetire4 = ../library/wake_tokens.lim::WakeRetire4
#alias WakeToken4 = ../library/wake_tokens.lim::WakeToken4
#alias lim-gen-async-wake = ../library/tasks.lim::#async-wake
#alias lim-gen-local-waker = ../library/local_waker.lim::#local-waker
#alias lim-gen-task = ../library/tasks.lim::#task
#alias wake-ready4-create = ../library/wake_ready4.lim::wake-ready4-create
#alias wake-ready4-notify = ../library/wake_ready4.lim::wake-ready4-notify
#alias wake-ready4-register = ../library/wake_ready4.lim::wake-ready4-register
#alias wake-ready4-retire = ../library/wake_ready4.lim::wake-ready4-retire
#alias wake-ready4-take = ../library/wake_ready4.lim::wake-ready4-take

#struct WakeExecutor () ((queue WakeReady4))
#struct WakeMetadata (#linear) ((token WakeToken4))


#fn notify {
  #params = ((executor (#ref WakeExecutor)) (metadata (#ref WakeMetadata)));
  #returns = ();
  #body = (
    (#assert (#call wake-ready4-notify ((queue (#borrow (#get executor queue))) (token (#get
              metadata token)))))
    (#return ())
  );
}

#fn clone-metadata {
  #params = ((metadata (#ref WakeMetadata)));
  #returns = WakeMetadata;
  #body = ((#return (#struct-literal WakeMetadata ((token (#get metadata token))))));
}

#fn destroy-metadata {
  #params = ((executor (#ref WakeExecutor)) (metadata WakeMetadata));
  #returns = ();
  #body = ((#forget metadata) (#return ()));
}

#generate lim-gen-local-waker { names = (LocalWaker local-waker-create local-waker-wake
  local-waker-wake-by-ref local-waker-clone local-waker-destroy); types = (WakeExecutor WakeMetadata);
  callbacks = (notify clone-metadata destroy-metadata); }

#generate lim-gen-task { names = (Step StepPoll StepPoll.StepPending StepPoll.StepReady); result = #u64; states = ((Step.Waiting
    #u64)); }

#fn step-poll {
  #params = ((task Step) (waker (#ref LocalWaker)));
  #returns = StepPoll;
  #body = ((#return (#match task
        (#case (Step.Waiting remaining)
          (#if (#u64::eq (#clone remaining) 0u64)
            (#block
              (#forget remaining)
              (StepPoll.StepReady 42u64)
            )
            (#block
              (#call local-waker-wake-by-ref ((waker waker)))
              (StepPoll.StepPending (Step.Waiting (#u64::sub-wrap remaining 1u64)))
            )
          )
        )
      )));
}

#generate lim-gen-async-wake { names = (Pipeline PipelinePoll PipelinePoll.PipelinePending
  PipelinePoll.PipelineReady pipeline-poll); result = #u64; stages = ((Pipeline.Only (#await Step StepPoll.StepPending
      StepPoll.StepReady step-poll) (#return))); waker = LocalWaker; }

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let queue WakeReady4 (#call wake-ready4-create ()))
    (#let-mut executor WakeExecutor (#struct-literal WakeExecutor ((queue queue))))
    (#let executor-mut (#ref-mut WakeExecutor) (#borrow-mut executor))
    (#let registration WakeRegister4 (#call wake-ready4-register ((queue (#borrow-mut (#get
                executor-mut queue))) (slot 0usize))))
    (#drop executor-mut)
    (#let token WakeToken4 (#match registration
        (#case (WakeRegister4.WakeRegistered4 value)
          value
        )
        (#case _
          (#unreachable)
        )
      ))
    (#let result #u64 (#block
        (#let waker LocalWaker (#call local-waker-create ((executor (#borrow executor)) (metadata
                (#struct-literal WakeMetadata ((token token)))))))
        (#let first PipelinePoll (#call pipeline-poll ((task (Pipeline.Only (Step.Waiting 1u64)))
              (waker (#borrow waker)))))
        (#let pending Pipeline (#match first
            (#case (PipelinePoll.PipelinePending task)
              task
            )
            (#case (PipelinePoll.PipelineReady result)
              (#unreachable)
            )
          ))
        (#call local-waker-wake-by-ref ((waker (#borrow waker))))
        (#let executor-ref (#ref WakeExecutor) (#borrow executor))
        (#assert (#call wake-ready4-take
            ((queue (#borrow (#get executor-ref queue))) (token token))))
        (#assert (#bool::not (#call wake-ready4-take ((queue (#borrow (#get executor-ref queue)))
                (token token)))))
        (#drop executor-ref)
        (#let second PipelinePoll (#call pipeline-poll ((task pending) (waker (#borrow waker)))))
        (#let outcome #u64 (#match second
            (#case (PipelinePoll.PipelineReady value)
              value
            )
            (#case (PipelinePoll.PipelinePending task)
              (#block
                (#forget task)
                (#unreachable)
              )
            )
          ))
        (#call local-waker-destroy ((waker waker)))
        outcome
      ))
    (#let executor-mut-again (#ref-mut WakeExecutor) (#borrow-mut executor))
    (#let retired WakeRetire4 (#call wake-ready4-retire ((queue (#borrow-mut (#get
                executor-mut-again queue))) (token token))))
    (#drop executor-mut-again)
    (#assert (#match retired
        (#case WakeRetire4.WakeRetired4
          true
        )
        (#case WakeRetire4.WakeStale4
          false
        )
      ))
    (#let executor-ref (#ref WakeExecutor) (#borrow executor))
    (#assert (#bool::not (#call wake-ready4-notify ((queue (#borrow (#get executor-ref queue)))
            (token token)))))
    (#drop executor-ref)
    (#forget executor)
    (#return result)
  );
}
