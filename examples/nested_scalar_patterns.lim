(#enum NestedScalar () ((NestedScalar.Value #u64) NestedScalar.Empty))

(#fn main () #u64
  (#let pair (#tuple #u64 #u64)
    (#tuple (#tuple #u64 #u64) 15u64 3u64))
  (#let value NestedScalar (NestedScalar.Value 18u64))
  (#return
    (#u64::add-wrap
      (#match pair
        (#case (#tuple (#range 10u64 20u64) (#or 2u64 3u64)) 20u64)
        (#case _ 0u64))
      (#match value
        (#case (NestedScalar.Value (#range 10u64 20u64)) 22u64)
        (#case NestedScalar.Empty 0u64)))))
