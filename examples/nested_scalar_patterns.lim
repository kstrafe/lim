(#enum NestedScalar ((Value u64) Empty))

(#fn main () u64
  (#let pair (#tuple u64 u64)
    (#tuple (#tuple u64 u64) 15u64 3u64))
  (#let value NestedScalar (Value 18u64))
  (#return
    (#u64.+.wrap
      (#match pair
        ((#tuple (#range 10u64 20u64) (#or 2u64 3u64)) 20u64)
        (_ 0u64))
      (#match value
        ((Value (#range 10u64 20u64)) 22u64)
        (Empty 0u64)))))
