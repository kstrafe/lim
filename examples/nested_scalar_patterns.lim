(#enum NestedScalar () ((Value #u64) Empty))

(#fn main () #u64
  (#let pair (#tuple #u64 #u64)
    (#tuple (#tuple #u64 #u64) 15u64 3u64))
  (#let value NestedScalar (Value 18u64))
  (#return
    (#u64.+.wrap
      (#match pair
        (#case (#tuple (#range 10u64 20u64) (#or 2u64 3u64)) 20u64)
        (#case _ 0u64))
      (#match value
        (#case (Value (#range 10u64 20u64)) 22u64)
        (#case Empty 0u64)))))
