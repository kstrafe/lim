; Generic definitions and theorems are checked at compile time.
; Only the ordinary main function below is emitted as machine code.

(#proof identity
  (#proof-definition (u)
    (#pt-pi ((a (#pt-type u)) (value a)) a)
    (#pt-lambda ((a (#pt-type u)) (value a)) value)))

(#proof reflexivity
  (#proof-theorem (u)
    (#pt-pi ((a (#pt-type u)) (value a)) (#pt-eq a value value))
    (#pt-lambda ((a (#pt-type u)) (value a)) (#pt-refl a value))))

(#proof compose-implications
  (#proof-theorem ()
    (#pt-pi ((p #pt-prop) (q #pt-prop) (r #pt-prop)
             (first (#pt-pi ((input p)) q))
             (second (#pt-pi ((input q)) r)) (premise p)) r)
    (#pt-lambda ((p #pt-prop) (q #pt-prop) (r #pt-prop)
                 (first (#pt-pi ((input p)) q))
                 (second (#pt-pi ((input q)) r)) (premise p))
      (#pt-app second (#pt-app first premise)))))

(#proof symmetry
  (#proof-theorem (u)
    (#pt-pi ((a (#pt-type u)) (left a) (right a)
             (path (#pt-eq a left right))) (#pt-eq a right left))
    (#pt-lambda ((a (#pt-type u)) (left a) (right a)
                 (path (#pt-eq a left right)))
      (#pt-eq-elim a left
        (#pt-lambda ((other a) (evidence (#pt-eq a left other)))
          (#pt-eq a other left))
        (#pt-refl a left) right path))))

(#proof transitivity
  (#proof-theorem (u)
    (#pt-pi ((a (#pt-type u)) (start a) (midpoint a) (endpoint a)
             (initial (#pt-eq a start midpoint))
             (following (#pt-eq a midpoint endpoint))) (#pt-eq a start endpoint))
    (#pt-lambda ((a (#pt-type u)) (start a) (midpoint a) (endpoint a)
                 (initial (#pt-eq a start midpoint))
                 (following (#pt-eq a midpoint endpoint)))
      (#pt-eq-elim a midpoint
        (#pt-lambda ((other a) (evidence (#pt-eq a midpoint other)))
          (#pt-eq a start other))
        initial endpoint following))))

(#proof transport
  (#proof-definition (u v)
    (#pt-pi ((a (#pt-type u))
             (family (#pt-pi ((point a)) (#pt-type v)))
             (left a) (right a) (path (#pt-eq a left right))
             (value (#pt-app family left))) (#pt-app family right))
    (#pt-lambda ((a (#pt-type u))
                 (family (#pt-pi ((point a)) (#pt-type v)))
                 (left a) (right a) (path (#pt-eq a left right))
                 (value (#pt-app family left)))
      (#pt-eq-elim a left
        (#pt-lambda ((other a) (evidence (#pt-eq a left other)))
          (#pt-app family other))
        value right path))))

(#proof congruence
  (#proof-theorem (u v)
    (#pt-pi ((a (#pt-type u)) (b (#pt-type v))
             (function (#pt-pi ((argument a)) b))
             (left a) (right a) (path (#pt-eq a left right)))
      (#pt-eq b (#pt-app function left) (#pt-app function right)))
    (#pt-lambda ((a (#pt-type u)) (b (#pt-type v))
                 (function (#pt-pi ((argument a)) b))
                 (left a) (right a) (path (#pt-eq a left right)))
      (#pt-eq-elim a left
        (#pt-lambda ((other a) (evidence (#pt-eq a left other)))
          (#pt-eq b (#pt-app function left) (#pt-app function other)))
        (#pt-refl b (#pt-app function left)) right path))))

(#proof product
  (#proof-definition (u v)
    (#pt-pi ((a (#pt-type u)) (b (#pt-type v)))
      (#pt-type (#pt-level-max u v)))
    (#pt-lambda ((a (#pt-type u)) (b (#pt-type v)))
      (#pt-sigma ((first a)) b))))

(#proof plus
  (#proof-definition ()
    (#pt-pi ((left #pt-nat) (right #pt-nat)) #pt-nat)
    (#pt-lambda ((left #pt-nat) (right #pt-nat))
      (#pt-nat-induct (#pt-lambda ((ordinal #pt-nat)) #pt-nat)
        right
        (#pt-lambda ((previous #pt-nat) (sum #pt-nat)) (#pt-succ sum))
        left))))

(#proof plus-right-zero
  (#proof-theorem ()
    (#pt-pi ((number #pt-nat))
      (#pt-eq #pt-nat (#pt-app (#pt-use plus ()) number #pt-zero) number))
    (#pt-lambda ((number #pt-nat))
      (#pt-nat-induct
        (#pt-lambda ((ordinal #pt-nat))
          (#pt-eq #pt-nat (#pt-app (#pt-use plus ()) ordinal #pt-zero) ordinal))
        (#pt-refl #pt-nat #pt-zero)
        (#pt-lambda ((previous #pt-nat)
                     (hypothesis (#pt-eq #pt-nat
                       (#pt-app (#pt-use plus ()) previous #pt-zero) previous)))
          (#pt-app (#pt-use congruence (0 0)) #pt-nat #pt-nat
            (#pt-lambda ((value #pt-nat)) (#pt-succ value))
            (#pt-app (#pt-use plus ()) previous #pt-zero) previous hypothesis))
        number))))

(#proof plus-right-successor
  (#proof-theorem ()
    (#pt-pi ((left #pt-nat) (right #pt-nat))
      (#pt-eq #pt-nat
        (#pt-app (#pt-use plus ()) left (#pt-succ right))
        (#pt-succ (#pt-app (#pt-use plus ()) left right))))
    (#pt-lambda ((left #pt-nat) (right #pt-nat))
      (#pt-nat-induct
        (#pt-lambda ((ordinal #pt-nat))
          (#pt-eq #pt-nat
            (#pt-app (#pt-use plus ()) ordinal (#pt-succ right))
            (#pt-succ (#pt-app (#pt-use plus ()) ordinal right))))
        (#pt-refl #pt-nat (#pt-succ right))
        (#pt-lambda ((previous #pt-nat)
                     (hypothesis (#pt-eq #pt-nat
                       (#pt-app (#pt-use plus ()) previous (#pt-succ right))
                       (#pt-succ (#pt-app (#pt-use plus ()) previous right)))))
          (#pt-app (#pt-use congruence (0 0)) #pt-nat #pt-nat
            (#pt-lambda ((value #pt-nat)) (#pt-succ value))
            (#pt-app (#pt-use plus ()) previous (#pt-succ right))
            (#pt-succ (#pt-app (#pt-use plus ()) previous right)) hypothesis))
        left))))

; Induction on the first input, using right-zero and right-successor.
(#proof plus-commutative
  (#proof-theorem ()
    (#pt-pi ((left #pt-nat) (right #pt-nat))
      (#pt-eq #pt-nat (#pt-app (#pt-use plus ()) left right)
        (#pt-app (#pt-use plus ()) right left)))
    (#pt-lambda ((left #pt-nat) (right #pt-nat))
      (#pt-nat-induct
        (#pt-lambda ((ordinal #pt-nat))
          (#pt-eq #pt-nat (#pt-app (#pt-use plus ()) ordinal right)
            (#pt-app (#pt-use plus ()) right ordinal)))
        (#pt-app (#pt-use symmetry (0)) #pt-nat
          (#pt-app (#pt-use plus ()) right #pt-zero) right
          (#pt-app (#pt-use plus-right-zero ()) right))
        (#pt-lambda ((previous #pt-nat)
                     (hypothesis (#pt-eq #pt-nat
                       (#pt-app (#pt-use plus ()) previous right)
                       (#pt-app (#pt-use plus ()) right previous))))
          (#pt-app (#pt-use transitivity (0)) #pt-nat
            (#pt-succ (#pt-app (#pt-use plus ()) previous right))
            (#pt-succ (#pt-app (#pt-use plus ()) right previous))
            (#pt-app (#pt-use plus ()) right (#pt-succ previous))
            (#pt-app (#pt-use congruence (0 0)) #pt-nat #pt-nat
              (#pt-lambda ((value #pt-nat)) (#pt-succ value))
              (#pt-app (#pt-use plus ()) previous right)
              (#pt-app (#pt-use plus ()) right previous) hypothesis)
            (#pt-app (#pt-use symmetry (0)) #pt-nat
              (#pt-app (#pt-use plus ()) right (#pt-succ previous))
              (#pt-succ (#pt-app (#pt-use plus ()) right previous))
              (#pt-app (#pt-use plus-right-successor ()) right previous))))
        left))))

(#proof list
  (#proof-inductive (u) (: a (#pt-type u)) (#pt-type u)
    ((nil ()) (cons (: head a : tail #pt-self)))))

(#proof length
  (#proof-definition (u)
    (#pt-pi ((a (#pt-type u)) (values (#pt-app (#pt-use list (u)) a))) #pt-nat)
    (#pt-lambda ((a (#pt-type u)) (values (#pt-app (#pt-use list (u)) a)))
      (#pt-induct list (u) (a)
        (#pt-lambda ((items (#pt-app (#pt-use list (u)) a))) #pt-nat)
        (#pt-zero
          (#pt-lambda ((head a) (tail (#pt-app (#pt-use list (u)) a))
                       (tail-length #pt-nat)) (#pt-succ tail-length)))
        values))))

(#proof length-nil
  (#proof-theorem (u)
    (#pt-pi ((a (#pt-type u)))
      (#pt-eq #pt-nat
        (#pt-app (#pt-use length (u)) a (#pt-construct list (u) (a) nil ()))
        #pt-zero))
    (#pt-lambda ((a (#pt-type u))) (#pt-refl #pt-nat #pt-zero))))

(#proof length-cons
  (#proof-theorem (u)
    (#pt-pi ((a (#pt-type u)) (head a) (tail (#pt-app (#pt-use list (u)) a)))
      (#pt-eq #pt-nat
        (#pt-app (#pt-use length (u)) a
          (#pt-construct list (u) (a) cons (head tail)))
        (#pt-succ (#pt-app (#pt-use length (u)) a tail))))
    (#pt-lambda ((a (#pt-type u)) (head a) (tail (#pt-app (#pt-use list (u)) a)))
      (#pt-refl #pt-nat (#pt-succ (#pt-app (#pt-use length (u)) a tail))))))

(#proof false-elimination
  (#proof-theorem ()
    (#pt-pi ((conclusion #pt-prop) (impossible #pt-false)) conclusion)
    (#pt-lambda ((conclusion #pt-prop) (impossible #pt-false))
      (#pt-induct #pt-false () ()
        (#pt-lambda ((absurd #pt-false)) conclusion) () impossible))))

(#proof empty (#proof-inductive () () #pt-prop ()))

(#proof empty-elimination
  (#proof-theorem ()
    (#pt-pi ((conclusion #pt-prop) (impossible (#pt-use empty ()))) conclusion)
    (#pt-lambda ((conclusion #pt-prop) (impossible (#pt-use empty ())))
      (#pt-induct empty () ()
        (#pt-lambda ((absurd (#pt-use empty ()))) conclusion) () impossible))))

(#proof a-dependent-pair
  (#proof-definition ()
    (#pt-sigma ((first #pt-nat)) (#pt-eq #pt-nat first first))
    (#pt-pair (#pt-sigma ((first #pt-nat)) (#pt-eq #pt-nat first first))
      (#pt-numeral 2) (#pt-refl #pt-nat (#pt-numeral 2)))))

(#proof pair-projection
  (#proof-theorem ()
    (#pt-eq #pt-nat (#pt-first (#pt-use a-dependent-pair ())) (#pt-numeral 2))
    (#pt-refl #pt-nat (#pt-numeral 2))))

(#proof pair-evidence
  (#proof-theorem ()
    (#pt-eq #pt-nat (#pt-first (#pt-use a-dependent-pair ()))
      (#pt-first (#pt-use a-dependent-pair ())))
    (#pt-second (#pt-use a-dependent-pair ()))))

(#fn leaf () #u64 (#return 42u64))
(#fn main () #u64 (#return (#call leaf (:))))

(#proof main-calls-leaf (#proof-calls-directly main leaf))
(#proof verified-program
  (#proof-theorem () (#pt-program main-calls-leaf) (#pt-certificate main-calls-leaf)))
