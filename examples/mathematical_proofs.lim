; Generic definitions and theorems are checked at compile time.
; Only the ordinary main function below is emitted as machine code.
(#math-definition identity (u)
  (#pt-pi ((a (#pt-type u)) (value a)) a)
  (#pt-lambda ((a (#pt-type u)) (value a)) value))
(#theorem reflexivity
  (#universes u)
  (#parameters
    (#parameter a (#pt-type u))
    (#parameter value a))
  (#statement (#pt-eq a value value))
  (#proof (#pt-refl a value)))
(#theorem compose-implications
  (#universes)
  (#parameters
    (#parameter p #pt-prop)
    (#parameter q #pt-prop)
    (#parameter r #pt-prop)
    (#parameter first (#pt-pi ((input p)) q))
    (#parameter second (#pt-pi ((input q)) r))
    (#parameter premise p))
  (#statement r)
  (#proof (#pt-app second (#pt-app first premise))))
(#theorem symmetry
  (#universes u)
  (#parameters
    (#parameter a (#pt-type u))
    (#parameter left a)
    (#parameter right a)
    (#parameter path (#pt-eq a left right)))
  (#statement (#pt-eq a right left))
  (#proof
    (#pt-eq-elim
      a
      left
      (#pt-lambda ((other a) (evidence (#pt-eq a left other))) (#pt-eq a other left))
      (#pt-refl a left)
      right
      path)))
(#theorem transitivity
  (#universes u)
  (#parameters
    (#parameter a (#pt-type u))
    (#parameter start a)
    (#parameter midpoint a)
    (#parameter endpoint a)
    (#parameter initial (#pt-eq a start midpoint))
    (#parameter following (#pt-eq a midpoint endpoint)))
  (#statement (#pt-eq a start endpoint))
  (#proof
    (#pt-eq-elim
      a
      midpoint
      (#pt-lambda ((other a) (evidence (#pt-eq a midpoint other))) (#pt-eq a start other))
      initial
      endpoint
      following)))
(#math-definition transport (u v)
  (#pt-pi
    (
      (a (#pt-type u))
      (family (#pt-pi ((point a)) (#pt-type v)))
      (left a)
      (right a)
      (path (#pt-eq a left right))
      (value (#pt-app family left)))
    (#pt-app family right))
  (#pt-lambda
    (
      (a (#pt-type u))
      (family (#pt-pi ((point a)) (#pt-type v)))
      (left a)
      (right a)
      (path (#pt-eq a left right))
      (value (#pt-app family left)))
    (#pt-eq-elim
      a
      left
      (#pt-lambda ((other a) (evidence (#pt-eq a left other))) (#pt-app family other))
      value
      right
      path)))
(#theorem congruence
  (#universes u v)
  (#parameters
    (#parameter a (#pt-type u))
    (#parameter b (#pt-type v))
    (#parameter function (#pt-pi ((argument a)) b))
    (#parameter left a)
    (#parameter right a)
    (#parameter path (#pt-eq a left right)))
  (#statement (#pt-eq b (#pt-app function left) (#pt-app function right)))
  (#proof
    (#pt-eq-elim
      a
      left
      (#pt-lambda
        ((other a) (evidence (#pt-eq a left other)))
        (#pt-eq b (#pt-app function left) (#pt-app function other)))
      (#pt-refl b (#pt-app function left))
      right
      path)))
(#math-definition product (u v)
  (#pt-pi ((a (#pt-type u)) (b (#pt-type v))) (#pt-type (#pt-level-max u v)))
  (#pt-lambda ((a (#pt-type u)) (b (#pt-type v))) (#pt-sigma ((first a)) b)))
(#math-definition plus ()
  (#pt-pi ((left #pt-nat) (right #pt-nat)) #pt-nat)
  (#pt-lambda
    ((left #pt-nat) (right #pt-nat))
    (#pt-nat-induct
      (#pt-lambda ((ordinal #pt-nat)) #pt-nat)
      right
      (#pt-lambda ((previous #pt-nat) (sum #pt-nat)) (#pt-succ sum))
      left)))
(#theorem plus-right-zero
  (#universes)
  (#parameters
    (#parameter number #pt-nat))
  (#statement (#pt-eq #pt-nat (#pt-app (#pt-use plus ()) number #pt-zero) number))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((ordinal #pt-nat))
        (#pt-eq #pt-nat (#pt-app (#pt-use plus ()) ordinal #pt-zero) ordinal))
      (#pt-refl #pt-nat #pt-zero)
      (#pt-lambda
        (
          (previous #pt-nat)
          (hypothesis (#pt-eq #pt-nat (#pt-app (#pt-use plus ()) previous #pt-zero) previous)))
        (#pt-app
          (#pt-use congruence (0 0))
          #pt-nat
          #pt-nat
          (#pt-lambda ((value #pt-nat)) (#pt-succ value))
          (#pt-app (#pt-use plus ()) previous #pt-zero)
          previous
          hypothesis))
      number)))
(#theorem plus-right-successor
  (#universes)
  (#parameters
    (#parameter left #pt-nat)
    (#parameter right #pt-nat))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use plus ()) left (#pt-succ right))
      (#pt-succ (#pt-app (#pt-use plus ()) left right))))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((ordinal #pt-nat))
        (#pt-eq
          #pt-nat
          (#pt-app (#pt-use plus ()) ordinal (#pt-succ right))
          (#pt-succ (#pt-app (#pt-use plus ()) ordinal right))))
      (#pt-refl #pt-nat (#pt-succ right))
      (#pt-lambda
        (
          (previous #pt-nat)
          (hypothesis
            (#pt-eq
              #pt-nat
              (#pt-app (#pt-use plus ()) previous (#pt-succ right))
              (#pt-succ (#pt-app (#pt-use plus ()) previous right)))))
        (#pt-app
          (#pt-use congruence (0 0))
          #pt-nat
          #pt-nat
          (#pt-lambda ((value #pt-nat)) (#pt-succ value))
          (#pt-app (#pt-use plus ()) previous (#pt-succ right))
          (#pt-succ (#pt-app (#pt-use plus ()) previous right))
          hypothesis))
      left)))
; Induction on the first input, using right-zero and right-successor.
(#theorem plus-commutative
  (#universes)
  (#parameters
    (#parameter left #pt-nat)
    (#parameter right #pt-nat))
  (#statement
    (#pt-eq #pt-nat (#pt-app (#pt-use plus ()) left right) (#pt-app (#pt-use plus ()) right left)))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((ordinal #pt-nat))
        (#pt-eq
          #pt-nat
          (#pt-app (#pt-use plus ()) ordinal right)
          (#pt-app (#pt-use plus ()) right ordinal)))
      (#pt-app
        (#pt-use symmetry (0))
        #pt-nat
        (#pt-app (#pt-use plus ()) right #pt-zero)
        right
        (#pt-app (#pt-use plus-right-zero ()) right))
      (#pt-lambda
        (
          (previous #pt-nat)
          (hypothesis
            (#pt-eq
              #pt-nat
              (#pt-app (#pt-use plus ()) previous right)
              (#pt-app (#pt-use plus ()) right previous))))
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          (#pt-succ (#pt-app (#pt-use plus ()) previous right))
          (#pt-succ (#pt-app (#pt-use plus ()) right previous))
          (#pt-app (#pt-use plus ()) right (#pt-succ previous))
          (#pt-app
            (#pt-use congruence (0 0))
            #pt-nat
            #pt-nat
            (#pt-lambda ((value #pt-nat)) (#pt-succ value))
            (#pt-app (#pt-use plus ()) previous right)
            (#pt-app (#pt-use plus ()) right previous)
            hypothesis)
          (#pt-app
            (#pt-use symmetry (0))
            #pt-nat
            (#pt-app (#pt-use plus ()) right (#pt-succ previous))
            (#pt-succ (#pt-app (#pt-use plus ()) right previous))
            (#pt-app (#pt-use plus-right-successor ()) right previous))))
      left)))
(#math-inductive list (u)
  (: a (#pt-type u))
  (#pt-type u)
  ((nil ()) (cons (: head a : tail #pt-self))))
(#math-definition length (u)
  (#pt-pi ((a (#pt-type u)) (values (#pt-app (#pt-use list (u)) a))) #pt-nat)
  (#pt-lambda
    ((a (#pt-type u)) (values (#pt-app (#pt-use list (u)) a)))
    (#pt-induct
      list
      (u)
      (a)
      (#pt-lambda ((items (#pt-app (#pt-use list (u)) a))) #pt-nat)
      (#pt-zero
        (#pt-lambda
          ((head a) (tail (#pt-app (#pt-use list (u)) a)) (tail-length #pt-nat))
          (#pt-succ tail-length)))
      values)))
(#theorem length-nil
  (#universes u)
  (#parameters
    (#parameter a (#pt-type u)))
  (#statement
    (#pt-eq #pt-nat (#pt-app (#pt-use length (u)) a (#pt-construct list (u) (a) nil ())) #pt-zero))
  (#proof (#pt-refl #pt-nat #pt-zero)))
(#theorem length-cons
  (#universes u)
  (#parameters
    (#parameter a (#pt-type u))
    (#parameter head a)
    (#parameter tail (#pt-app (#pt-use list (u)) a)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use length (u)) a (#pt-construct list (u) (a) cons (head tail)))
      (#pt-succ (#pt-app (#pt-use length (u)) a tail))))
  (#proof (#pt-refl #pt-nat (#pt-succ (#pt-app (#pt-use length (u)) a tail)))))
(#theorem false-elimination
  (#universes)
  (#parameters
    (#parameter conclusion #pt-prop)
    (#parameter impossible #pt-false))
  (#statement conclusion)
  (#proof (#pt-induct #pt-false () () (#pt-lambda ((absurd #pt-false)) conclusion) () impossible)))
(#math-inductive empty ()
  ()
  #pt-prop
  ())
(#theorem empty-elimination
  (#universes)
  (#parameters
    (#parameter conclusion #pt-prop)
    (#parameter impossible (#pt-use empty ())))
  (#statement conclusion)
  (#proof
    (#pt-induct empty () () (#pt-lambda ((absurd (#pt-use empty ()))) conclusion) () impossible)))
(#math-definition a-dependent-pair ()
  (#pt-sigma ((first #pt-nat)) (#pt-eq #pt-nat first first))
  (#pt-pair
    (#pt-sigma ((first #pt-nat)) (#pt-eq #pt-nat first first))
    (#pt-numeral 2)
    (#pt-refl #pt-nat (#pt-numeral 2))))
(#theorem pair-projection
  (#universes)
  (#parameters)
  (#statement (#pt-eq #pt-nat (#pt-first (#pt-use a-dependent-pair ())) (#pt-numeral 2)))
  (#proof (#pt-refl #pt-nat (#pt-numeral 2))))
(#theorem pair-evidence
  (#universes)
  (#parameters)
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-first (#pt-use a-dependent-pair ()))
      (#pt-first (#pt-use a-dependent-pair ()))))
  (#proof (#pt-second (#pt-use a-dependent-pair ()))))

(#fn leaf () #u64
  (#return 42u64))

(#fn main () #u64
  (#return (#call leaf ())))

(#theorem main-calls-leaf
  (#proof-calls-directly main leaf))
(#theorem verified-program
  (#universes)
  (#parameters)
  (#statement (#pt-program main-calls-leaf))
  (#proof (#pt-certificate main-calls-leaf)))
