#struct
    Point ()
    (
      (x #u64)
      (y #u64)
    )

#fn
    make_point
    ()
    Point
    (
      #return
      (#struct-literal Point ((x 7) (y 34)))
    )

#fn
    main
    ()
    #u64
    (
      #let
      point
      Point
      (#call make_point ())
    )
    (
      #return
      (#get point y)
    )
