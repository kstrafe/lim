(#struct Inner ((left u64) (right u64)))
(#struct Outer ((inner Inner) (tail u64)))

(#fn main () u64
  (#let-mut value Outer (#struct-literal Outer ((inner (#struct-literal Inner ((left 10) (right 20)))) (tail 30))))
  (#set-field value inner (#struct-literal Inner ((left 50) (right 60))))
  (#return (#get (#get value inner) right)))
