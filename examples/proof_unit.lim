; A mathematical unit type has one constructor with no fields. Its values
; are definitionally equal; other types and instantiations remain distinct.
(#math-inductive unit-data ()
  ()
  (#pt-type 0)
  ((only ())))
(#theorem unit-values-agree
  (#universes)
  (#parameters
    (#parameter left (#pt-use unit-data ()))
    (#parameter right (#pt-use unit-data ())))
  (#statement (#pt-eq (#pt-use unit-data ()) left right))
  (#proof (#pt-refl (#pt-use unit-data ()) left)))
; The recursor computes for an opaque subject as well as its constructor.
(#theorem unit-recursion-computes
  (#universes)
  (#parameters
    (#parameter value (#pt-use unit-data ())))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-induct
        unit-data
        ()
        ()
        (#pt-lambda ((subject (#pt-use unit-data ()))) #pt-nat)
        (#pt-zero)
        value)
      #pt-zero))
  (#proof (#pt-refl #pt-nat #pt-zero)))
; Function eta composes with unit conversion without assuming an arbitrary
; equality between functions whose results contain distinguishable data.
(#theorem unit-functions-agree
  (#universes)
  (#parameters
    (#parameter left (#pt-pi ((input #pt-nat)) (#pt-use unit-data ())))
    (#parameter right (#pt-pi ((input #pt-nat)) (#pt-use unit-data ()))))
  (#statement (#pt-eq (#pt-pi ((input #pt-nat)) (#pt-use unit-data ())) left right))
  (#proof (#pt-refl (#pt-pi ((input #pt-nat)) (#pt-use unit-data ())) left)))

(#fn main () #u64
  (#return 42u64))
