; The relation and its lift proof are explicit. No representative projection
; or equality between related representatives is assumed.
(#math-definition related ()
  (#pt-pi ((left #pt-nat) (right #pt-nat)) #pt-prop)
  (#pt-lambda ((left #pt-nat) (right #pt-nat)) (#pt-eq #pt-nat left right)))

(#math-definition quotient () (#pt-type 0)
  (#pt-quot 1 #pt-nat (#pt-use related ())))

(#math-definition identity ()
  (#pt-pi ((value #pt-nat)) #pt-nat)
  (#pt-lambda ((value #pt-nat)) value))

(#math-definition respects ()
  (#pt-pi ((left #pt-nat) (right #pt-nat)
    (proof (#pt-app (#pt-use related ()) left right)))
    (#pt-eq #pt-nat (#pt-app (#pt-use identity ()) left)
      (#pt-app (#pt-use identity ()) right)))
  (#pt-lambda ((left #pt-nat) (right #pt-nat)
    (proof (#pt-app (#pt-use related ()) left right))) proof))

(#math-definition extract ()
  (#pt-pi ((value (#pt-use quotient ()))) #pt-nat)
  (#pt-lambda ((value (#pt-use quotient ())))
    (#pt-quot-lift (1 1) #pt-nat (#pt-use related ()) #pt-nat
      (#pt-use identity ()) (#pt-use respects ()) value)))

(#theorem quotient-lift-computes
  (#universes)
  (#parameters (#parameter value #pt-nat))
  (#statement (#pt-eq #pt-nat
    (#pt-app (#pt-use extract ())
      (#pt-quot-make 1 #pt-nat (#pt-use related ()) value)) value))
  (#proof (#pt-refl #pt-nat value)))

(#theorem quotient-induction
  (#universes)
  (#parameters (#parameter value (#pt-use quotient ())))
  (#statement (#pt-eq #pt-nat
    (#pt-app (#pt-use extract ()) value) (#pt-app (#pt-use extract ()) value)))
  (#proof (#pt-quot-induct 1 #pt-nat (#pt-use related ())
    (#pt-lambda ((subject (#pt-use quotient ())))
      (#pt-eq #pt-nat (#pt-app (#pt-use extract ()) subject)
        (#pt-app (#pt-use extract ()) subject)))
    (#pt-lambda ((representative #pt-nat)) (#pt-refl #pt-nat representative)) value)))

(#fn main () #u64
  (#return 42u64))
