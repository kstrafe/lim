; The first iteration continues before reaching the body await.
(#enum ConditionTask ((Check #u64) (Recheck #u64)))
(#linear ConditionTask)
(#enum ConditionPoll ((ConditionPending ConditionTask) (ConditionReady #bool)))
(#fn condition-poll ((task ConditionTask) (waker (#ref #u64))) ConditionPoll
  (#return (#match task
    (#case (Check index) (ConditionPending (Recheck index)))
    (#case (Recheck index) (ConditionReady (#u64.< index 2u64))))))

(#enum BodyTask ((Start #u64) (Resume #u64)))
(#linear BodyTask)
(#enum BodyPoll ((BodyPending BodyTask) (BodyReady #u64)))
(#fn body-poll ((task BodyTask) (waker (#ref #u64))) BodyPoll
  (#return (#match task
    (#case (Start value) (BodyPending (Resume value)))
    (#case (Resume value) (BodyReady value)))))

(@async-fn (: names (Frame Poll Pending Ready poll) : waker #u64 : function
  (#fn work () #u64
    (#let-mut index #u64 0u64)
    (#while (#await #bool ConditionTask ConditionPending ConditionReady condition-poll (Check index))
      (#set index (#u64.+.wrap index 1u64))
      (#if (#u64.== index 1u64) (#continue) ())
      (#let value #u64 (#await #u64 BodyTask BodyPending BodyReady body-poll (Start 40u64)))
      (#return (#u64.+.wrap value index)))
    (#return 0u64))))

(#fn main () #u64
  (#let waker #u64 0u64)
  (#let first Poll (#call poll (: task (#call work ()) : waker (#borrow waker))))
  (#let-else (Pending first-condition) Poll first (#unreachable))
  (#let second Poll (#call poll (: task first-condition : waker (#borrow waker))))
  (#let-else (Pending second-condition) Poll second (#unreachable))
  (#let third Poll (#call poll (: task second-condition : waker (#borrow waker))))
  (#let-else (Pending body) Poll third (#unreachable))
  (#let fourth Poll (#call poll (: task body : waker (#borrow waker))))
  (#return (#match fourth
    (#case (Ready value) value)
    (#case (Pending unexpected) (#block (#forget unexpected) (#unreachable))))))
