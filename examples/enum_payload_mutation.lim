(#struct PairPayload () (: left #u64 : right #u64))
(#enum Pair () ((Pair PairPayload) Empty))

(#fn main () #u64
  (#let-mut value Pair (Pair (#struct-literal PairPayload (: left 20 : right 22))))
  (#set-payload value Pair 0 (#struct-literal PairPayload (: left 20 : right 30)))
  (#return
    (#match value
      (#case (Pair pair) (#u64.+.wrap (#get pair left) (#get pair right)))
      (#case Empty 0))))
