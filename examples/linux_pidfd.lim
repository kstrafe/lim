(#alias linux-close = ../library/linux_x86_64.lim::linux-close)
(#alias linux-fcntl = ../library/linux_x86_64.lim::linux-fcntl)
(#alias linux-getpid = ../library/linux_x86_64.lim::linux-getpid)
(#alias linux-pidfd-getfd = ../library/linux_x86_64.lim::linux-pidfd-getfd)
(#alias linux-pidfd-open = ../library/linux_x86_64.lim::linux-pidfd-open)
(#alias linux-pidfd-send-signal = ../library/linux_x86_64.lim::linux-pidfd-send-signal)
(#alias linux-write-byte = ../library/linux_x86_64.lim::linux-write-byte)

(#fn main () #u64
  (#let pid #i64 (#call linux-getpid ()))
  (#let invalid-pid #i64
    (#call linux-pidfd-open ((pid 0i64) (flags 0u32))))
  (#let invalid-open-flags #i64
    (#call linux-pidfd-open ((pid pid) (flags 1u32))))
  (#let pidfd #i64
    (#call linux-pidfd-open ((pid pid) (flags 0u32))))
  (#let no-info (#ptr-mut #u8) (#ptr-null (#ptr-mut #u8)))
  // Signal zero checks the target without delivering a signal.
  (#let self-alive #i64
    (#unsafe (#unsafe-call linux-pidfd-send-signal ((pidfd pidfd) (signal 0i32) (info no-info) (flags 0u32)))))
  (#let invalid-signal #i64
    (#unsafe (#unsafe-call linux-pidfd-send-signal ((pidfd pidfd) (signal 999i32) (info no-info) (flags 0u32)))))
  (#let invalid-signal-fd #i64
    (#unsafe (#unsafe-call linux-pidfd-send-signal ((pidfd -1i64) (signal 0i32) (info no-info) (flags 0u32)))))
  (#let invalid-getfd #i64
    (#call linux-pidfd-getfd ((pidfd -1i64) (target-fd pidfd) (flags 0u32))))
  (#let duplicated #i64
    (#call linux-pidfd-getfd ((pidfd pidfd) (target-fd pidfd) (flags 0u32))))
  (#let duplicate-flags #i64
    (#if (#i64::ge duplicated 0i64)
      (#unsafe (#unsafe-call linux-fcntl ((fd duplicated) (command 1i32) (argument 0usize))))
      -1i64))
  (#let duplicate-closed #i64
    (#if (#i64::ge duplicated 0i64)
      (#call linux-close ((fd duplicated)))
      -1i64))
  (#let original-closed #i64 (#call linux-close ((fd pidfd))))
  (#let closed-pidfd-signal #i64
    (#unsafe (#unsafe-call linux-pidfd-send-signal ((pidfd pidfd) (signal 0i32) (info no-info) (flags 0u32)))))
  (#let getfd-ok #bool
    (#bool::or (#i64::eq duplicated -1i64)
      (#bool::and (#i64::ge duplicated 0i64)
        (#bool::and (#i64::eq duplicate-flags 1i64)
          (#i64::eq duplicate-closed 0i64)))))
  (#let checks-ok #bool
    (#bool::and (#i64::gt pid 0i64)
      (#bool::and (#i64::eq invalid-pid -22i64)
        (#bool::and (#i64::eq invalid-open-flags -22i64)
          (#bool::and (#i64::ge pidfd 0i64)
            (#bool::and (#i64::eq self-alive 0i64)
              (#bool::and (#i64::eq invalid-signal -22i64)
                (#bool::and (#i64::eq invalid-signal-fd -9i64)
                  (#bool::and (#i64::eq invalid-getfd -9i64)
                    (#bool::and getfd-ok
                      (#bool::and (#i64::eq original-closed 0i64)
                        (#i64::eq closed-pidfd-signal -9i64))))))))))))
  (#return
    (#if checks-ok
      (#block
        (#let-mut byte #u8 80u8)
        (#let first-write #i64
          (#call linux-write-byte ((source (#borrow byte)))))
        (#set byte 10u8)
        (#let second-write #i64
          (#call linux-write-byte ((source (#borrow byte)))))
        (#if (#bool::and (#i64::eq first-write 1i64)
            (#i64::eq second-write 1i64)) 42u64 1u64))
      1u64)))
