// Outcome.Pending retains the reference; Outcome.Ready clears it before returning.
(#enum Choice () ((Choice.Empty) (Choice.Full (#ref #u64))))
(#enum Outcome () ((Outcome.Ready) (Outcome.Pending)))

(#fn step-choice ((target (#ref-mut Choice)) (value (#ref #u64)) (complete #bool)) Outcome
  (#return
    (#if complete
      (#block (#deref-set target (Choice.Empty)) (Outcome.Ready))
      (#block (#deref-set target (Choice.Full value)) (Outcome.Pending)))))

(#fn main () #u64
  (#let old #u64 7u64)
  (#let-mut value #u64 42u64)
  (#let-mut holder Choice (Choice.Full (#borrow old)))
  (#let target (#ref-mut Choice) (#borrow-mut holder))
  (#let first Outcome
    (#call step-choice ((target target) (value (#borrow value)) (complete false))))
  (#drop target)
  (#let result #u64
    (#match first
      (#case (Outcome.Ready) 0u64)
      (#case (Outcome.Pending)
        (#match holder
          (#case (Choice.Empty) 0u64)
          (#case (Choice.Full view) (#deref view))))))
  (#let next-target (#ref-mut Choice) (#borrow-mut holder))
  (#let second Outcome
    (#call step-choice ((target next-target) (value (#borrow value)) (complete true))))
  (#drop next-target)
  (#let output #u64
    (#match second
      (#case (Outcome.Ready) (#block (#set value 1u64) result))
      (#case (Outcome.Pending) (#unreachable))))
  (#forget holder)
  (#return output))
