#struct Point () ((x #u64) (y #u64))

#fn classify {
  #params = ((value Point));
  #returns = #u64;
  #body = (
    (#return
      (#match value
        (#case (Point 40 second) second)
        (#case _ 0)))
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#return (#call classify ((value (#struct-literal Point ((x 40) (y 2)))))))
  );
}
