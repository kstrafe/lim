#alias lim-gen-cell = #std/cell.lim::cell

#generate lim-gen-cell { value-type = #u64; name = CellU64; create = CellU64::create; get = CellU64::get; set = CellU64::set; }
#struct Resource (#linear) ((owned #u64))

#struct Bundle () ((left Resource) (right Resource))
#struct Counter () ((total CellU64))

#fn Resource::destroy {
  #params = ((counter (#ref Counter)) (value Resource));
  #returns = ();
  #body = (
    (#let (Resource owned) Resource value)
    (#let cell (#ref CellU64) (#borrow (#get counter total)))
    (#call CellU64::set ((cell (#clone cell)) (value (#u64::add-wrap (#call CellU64::get ((cell
                  cell))) 1u64))))
    (#forget owned)
    (#return ())
  );
}

#fn Bundle::destroy {
  #params = ((counter (#ref Counter)) (value Bundle));
  #returns = ();
  #body = (
    (#let (Bundle left right) Bundle value)
    (#call Resource::destroy ((counter (#clone counter)) (value left)))
    (#call Resource::destroy ((counter (#clone counter)) (value right)))
    (#return ())
  );
}

#fn make-bundle {
  #params = ();
  #returns = Bundle;
  #body = ((#return (#struct-literal Bundle ((left (#struct-literal Resource ((owned 0u64))))
          (right (#struct-literal Resource ((owned 0u64))))))));
}

#fn pass-through {
  #params = ((value Bundle));
  #returns = Bundle;
  #body = ((#return value));
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let-mut counter Counter (#struct-literal Counter ((total (#call CellU64::create
              ((value 0u64)))))))
    (#let bundle Bundle (#call make-bundle ()))
    (#let moved Bundle (#call pass-through ((value bundle))))
    (#call Bundle::destroy ((counter (#borrow counter)) (value moved)))
    (#let counter-ref (#ref Counter) (#borrow counter))
    (#let destroyed #u64 (#call CellU64::get ((cell (#borrow (#get counter-ref total))))))
    (#drop counter-ref)
    (#forget counter)
    (#return destroyed)
  );
}
