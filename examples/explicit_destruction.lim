(#struct Resource ((owned (#cell u64))))
(#struct Bundle ((left Resource) (right Resource)))
(#struct Counter ((total (#cell u64))))

(#fn Resource-destroy ((counter (#ref Counter)) (value Resource)) ()
  (#let (Resource owned) Resource value)
  (#cell-set (#get counter total)
    (#u64.+.wrap (#cell-get (#get counter total)) 1u64))
  (#forget owned)
  (#return ()))

(#fn Bundle-destroy ((counter (#ref Counter)) (value Bundle)) ()
  (#let (Bundle left right) Bundle value)
  (#call Resource-destroy (#fn-args (counter (#clone counter)) (value left)))
  (#call Resource-destroy (#fn-args (counter (#clone counter)) (value right)))
  (#return ()))

(#fn make-bundle () Bundle
  (#return
    (#struct-literal Bundle ((left (#struct-literal Resource ((owned (#cell 0u64))))) (right (#struct-literal Resource ((owned (#cell 0u64)))))))))

(#fn pass-through ((value Bundle)) Bundle
  (#return value))

(#fn main () u64
  (#let-mut counter Counter (#struct-literal Counter ((total (#cell 0u64)))))
  (#let bundle Bundle (#call make-bundle (#fn-args )))
  (#let moved Bundle (#call pass-through (#fn-args (value bundle))))
  (#call Bundle-destroy (#fn-args (counter (#borrow counter)) (value moved)))
  (#let destroyed u64 (#cell-get (#get counter total)))
  (#forget counter)
  (#return destroyed))
