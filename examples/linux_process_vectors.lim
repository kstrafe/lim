#alias linux-close = ../library/linux_x86_64.lim::linux-close
#alias linux-getpid = ../library/linux_x86_64.lim::linux-getpid
#alias linux-mmap = ../library/linux_x86_64.lim::linux-mmap
#alias linux-munmap = ../library/linux_x86_64.lim::linux-munmap
#alias linux-pipe2 = ../library/linux_x86_64.lim::linux-pipe2
#alias linux-process-vm-readv = ../library/linux_x86_64.lim::linux-process-vm-readv
#alias linux-process-vm-writev = ../library/linux_x86_64.lim::linux-process-vm-writev
#alias linux-read = ../library/linux_x86_64.lim::linux-read
#alias linux-vmsplice = ../library/linux_x86_64.lim::linux-vmsplice
#alias linux-write = ../library/linux_x86_64.lim::linux-write

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let pid #i32 (#as (#call linux-getpid ()) #i32))
    (#let memory (#ptr-mut #u8)
      (#unsafe (#unsafe-call linux-mmap ((address (#ptr-null (#ptr-mut #u8))) (length 4096usize) (protection 3u32) (flags 34u32) (fd -1i64) (offset 0i64)))))
    (#let local (#ptr-mut #u8) (#unsafe (#ptr-offset memory 32usize)))
    (#let remote (#ptr-mut #u8) (#unsafe (#ptr-offset memory 48usize)))
    (#let source (#ptr-mut #u8) (#unsafe (#ptr-offset memory 128usize)))
    (#let destination (#ptr-mut #u8) (#unsafe (#ptr-offset memory 144usize)))
    // Native iovec records: base pointer followed by #usize length.
    (#unsafe (#asm () ((rdi memory))
      "lea rax, [rdi+144]\nmov QWORD PTR [rdi+32], rax\nmov QWORD PTR [rdi+40], 4\nlea rax, [rdi+128]\nmov QWORD PTR [rdi+48], rax\nmov QWORD PTR [rdi+56], 4\nmov bYTE PTR [rdi+128], 65\nmov bYTE PTR [rdi+129], 66\nmov bYTE PTR [rdi+130], 67\nmov bYTE PTR [rdi+131], 10"))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-process-vm-readv ((pid pid) (local-vectors local) (local-count 1usize) (remote-vectors remote) (remote-count 1usize) (flags 1usize)))) -22i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-process-vm-readv ((pid pid) (local-vectors local) (local-count 1usize) (remote-vectors remote) (remote-count 1usize) (flags 0usize)))) 4i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-write ((fd 1i64) (source destination) (count 4usize)))) 4i64))
    (#unsafe (#block
      (#ptr-write destination 68u8)
      (#ptr-write (#ptr-offset destination 1usize) 69u8)
      (#ptr-write (#ptr-offset destination 2usize) 70u8)
      ()))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-process-vm-writev ((pid pid) (local-vectors local) (local-count 1usize) (remote-vectors remote) (remote-count 1usize) (flags 1usize)))) -22i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-process-vm-writev ((pid pid) (local-vectors local) (local-count 1usize) (remote-vectors remote) (remote-count 1usize) (flags 0usize)))) 4i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-write ((fd 1i64) (source source) (count 4usize)))) 4i64))
    (#let descriptors (#ptr-mut #i32)
      (#unsafe (#asm (#ptr-mut #i32) ((rdi memory)) "mov rax, rdi")))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-pipe2 ((descriptors descriptors) (flags 2048i32)))) 0i64))
    (#let reader #i64 (#as (#unsafe (#ptr-read descriptors)) #i64))
    (#let writer #i64 (#as (#unsafe (#ptr-read (#ptr-offset descriptors 1usize))) #i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-vmsplice ((fd -1i64) (iovecs remote) (count 1usize) (flags 2u32)))) -9i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-vmsplice ((fd writer) (iovecs remote) (count 1usize) (flags 2u32)))) 4i64))
    // Keep the source unchanged and mapped until the pipe has consumed it.
    (#unsafe (#asm () ((rdi destination)) "mov DWORD PTR [rdi], 0"))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-read ((fd reader) (destination destination) (count 4usize)))) 4i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-write ((fd 1i64) (source destination) (count 4usize)))) 4i64))
    (#assert (#i64::eq (#call linux-close ((fd reader))) 0i64))
    (#assert (#i64::eq (#call linux-close ((fd writer))) 0i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-munmap ((address memory) (length 4096usize)))) 0i64))
    (#return 42u64)
  );
}
