// Construct with #enum-literal; destructure with ordinary variant patterns.
(#struct Reading () ((value #u64)))
(#enum Measurement () ((Measurement.Present Reading) Measurement.Absent))

(#fn read-value ((available #bool)) Measurement
  (#return (#if available
    (#enum-literal Measurement.Present
      (#struct-literal Reading ((value 42u64))))
    (#enum-literal Measurement.Absent))))

(#fn main () #u64
  (#let measurement Measurement (#call read-value ((available true))))
  (#return (#match measurement
    (#case (Measurement.Present reading) (#get reading value))
    (#case Measurement.Absent 0u64))))
