; Validation must succeed for this exact object before any perform call.
(#struct User () ((id #u64)))

(#fn validate (: user (#ref User)) #bool
  (#return (#u64::ne (#get user id) 0u64)))

(#fn perform (: user (#ref User)) #u64
  (#return (#get user id)))

(#fn dispatch (: user (#ref User)) #u64
  (#return (#call perform (($ user)))))

(#fn process (: user (#ref User)) #u64
  (#if (#bool::not (#call validate (($ user))))
    (#block
      (#return 0u64)))
  (#return (#call dispatch (($ user)))))
; All branches and helper calls reachable from process are checked for every
; User input. Replacing user with another object at dispatch fails the theorem.

(#theorem process-validates-the-user
  (#proof-requires-validation process (validate user) (perform user)))
(#theorem main-validates-the-user
  (#proof-requires-validation main (validate user) (perform user)))

(#fn main () #u64
  (#let user User (#struct-literal User (: id 42u64)))
  (#let result #u64 (#call process (: user (#borrow user))))
  (#forget user)
  (#return result))
