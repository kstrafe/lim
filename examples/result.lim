#generate #result ((ok #u64) (error #u32) (name Result))

#fn classify {
  #params = ((value Result));
  #returns = #u64;
  #body = (
    (#return
      (#match value
        (#case (Result.Ok 42) 1)
        (#case (Result.Err _) 0)))
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let value Result (#call Result::ok ((value 42))))
    (#return (#call classify ((value value))))
  );
}
