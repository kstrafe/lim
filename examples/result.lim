(@result u64 u32 Result)

(#fn classify ((value Result)) u64
  (#return
    (#match value
      (#case (Result-ok-value 42) 1)
      (#case (Result-err-value _) 0))))

(#fn main () u64
  (#let value Result (#call Result-ok (#fn-args (value 42))))
  (#return (#call classify (#fn-args (value value)))))
