; An exact local write establishes the variant and its retained reference.
(#enum Choice ((Empty) (Full (#ref u64))))

(#fn read (: source (#ref Choice)) u64
  (#return
    (#match (#deref source)
      (#case (Empty) 0u64)
      (#case (Full value) (#deref value)))))

(#fn main () u64
  (#let value u64 42u64)
  (#let-mut choice Choice (Empty))
  (#let writer (#ref-mut Choice) (#borrow-mut choice))
  (#deref-set writer (Full (#borrow value)))
  (#drop writer)
  (#let source (#ref Choice) (#borrow choice))
  (#let result u64 (#call read (: source source)))
  (#drop source)
  (#forget choice)
  (#return result))
