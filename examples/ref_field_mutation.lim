(#struct Point ((x u64) (y u64)))
(#struct CellState ((prefix u64) (counter (#cell u64))))
(#static Origin Point (#struct-literal Point ((x 19) (y 23))))

(#fn origin-y () u64
  (#let origin-ref (#ref Point) (#unsafe (#borrow Origin)))
  (#let y-ref (#ref u64) (#borrow (#get origin-ref y)))
  (#return (#deref y-ref)))

(#fn point-y ((point (#ref Point))) u64
  (#return (#get point y)))

(#fn mutate-cell-through-reference () u64
  (#let-mut state CellState (#struct-literal CellState ((prefix 5) (counter (#cell 1)))))
  (#let state-ref (#ref CellState) (#borrow state))
  (#cell-set (#get state-ref counter) 42)
  (#let result u64 (#cell-get (#get state-ref counter)))
  (#drop state-ref)
  (#forget state)
  (#return result))

(#fn main () u64
  (#let-mut point Point (#struct-literal Point ((x 1) (y 2))))
  (#let original-y u64 (#call point-y (#fn-args (point (#borrow point)))))
  (#let point-ref (#ref-mut Point) (#borrow-mut point))
  (#let y-ref (#ref-mut u64) (#borrow-mut (#get point-ref y)))
  (#deref-set y-ref 42)
  (#return (#u64.+.wrap
    (#u64.+.wrap (#u64.+.wrap (#deref y-ref) original-y) (#call origin-y (#fn-args )))
    (#call mutate-cell-through-reference (#fn-args )))))
