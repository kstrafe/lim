; The weak contract retains which element the returned reference addresses.
(#fn at (: values (#ref-mut (#array #u8 2)) : index #usize) (#ref-mut #u8)
  (#return (#borrow-mut (#index (#deref values) index))))

(#theorem at-origins
  (#proof-contract at (#usize::lt index 2usize) true))

(#fn overwrite (: values (#ref-mut (#array #u8 2)) : index #usize : value #u8) ()
  (#let selected (#ref-mut #u8) (#call at (: values values : index index)))
  (#deref-set selected value)
  (#forget selected)
  (#return ()))

(#theorem selected-and-sibling
  (#proof-using
    (at-origins)
    (#proof-contract
      overwrite
      (#usize::lt index 2usize)
      (#proof-and
        (#proof-eq
          (#index values 0usize)
          (#if (#usize::eq index 0usize)
            value
            (#proof-old (#index values 0usize))))
        (#proof-eq
          (#index values 1usize)
          (#if (#usize::eq index 1usize)
            value
            (#proof-old (#index values 1usize))))))))

(#fn main () #u64
  (#let-mut values (#array #u8 2) (#array-of (#array #u8 2) 4u8 7u8))
  (#call overwrite (: values (#borrow-mut values) : index 1usize : value 9u8))
  (#return
    (#u64::add-wrap
      (#u64::mul-wrap (#as (#index values 0usize) #u64) 10u64)
      (#as (#index values 1usize) #u64))))
