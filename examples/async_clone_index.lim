; Clone a runtime-selected element of a computed reference-bearing array.
; The selected Holder keeps the caller's loan through suspension.
(#struct Holder (#linear) (: reference (#ref #u64) : offset #u64))

(#fn make-array (: owner (#ref #u64)) (#array Holder 2)
  (#return
    (#array-of
      (#array Holder 2)
      (#struct-literal Holder (: reference owner : offset 0u64))
      (#struct-literal Holder (: reference owner : offset 1u64)))))
(#enum Step (#linear) (Start Resume))

(#enum StepPoll () ((Pending Step) (Ready ())))
(#fn step-poll (: task Step : waker (#ref #u64)) StepPoll
  (#return
    (#match task
      (#case Start
        (Pending Resume))
      (#case Resume
        (Ready ())))))
(@
  #async-fn
  (: protocol WorkAwait : waker #u64 : function
  (#fn work (: owner (#ref #u64) : index #usize) #u64
    (#let holder Holder (#clone (#index (#call make-array (: owner owner)) index)))
    (#let ready () (#await () Step Pending Ready step-poll Start))
    (#let result #u64 (#u64.+.wrap
      (#deref (#get holder reference)) (#get holder offset)))
    (#forget holder) (#return result))))
(#fn main () #u64
  (#let owner #u64 42u64)
  (#let index #usize 1usize)
  (#let waker #u64 0u64)
  (#let
    first
    Work::Poll
    (#call
      Work::poll
      (: task (#call work (: owner (#borrow owner) : index index))
      : waker (#borrow waker))))
  (#let-else (Work::Pending pending) Work::Poll first (#unreachable))
  (#let second Work::Poll (#call Work::poll (: task pending : waker (#borrow waker))))
  (#return
    (#match second
      (#case (Work::Ready result)
        result)
      (#case (Work::Pending unexpected)
        (#block
          (#forget unexpected)
          (#unreachable))))))
