// Explicit validation, a constrained field, and an API requirement.
#fn below-100 {
  #params = ((value #u64));
  #returns = #bool;
  #body = ((#return (#u64::lt value 100u64)));
}

#type Small (#where (value #u64) (#call below-100 ((value value))))
#struct Request () ((count Small) (tag #u64))

#fn send {
  #params = ((request (#ref Request)));
  #returns = #u64;
  #body = ((#return (#get request count)));
}

#fn submit {
  #params = ((value #u64));
  #returns = #u64;
  #body = (
    (#requires (#call below-100 ((value value))))
    (#let request Request (#struct-literal Request ((count value) (tag 0u64))))
    (#let response #u64 (#call send ((request (#borrow request)))))
    (#forget request)
    (#return response)
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let input #u64 42u64)
    (#return (#if-valid (#call below-100 ((value input))) (#call submit ((value input))) 1u64))
  );
}
