; Reuse a checked state-changing contract; only the borrowed field may change.
(#struct Pair () (: total #u8 : untouched #u8))

(#fn bump (: target (#ref-mut #u8) : count #u8) ()
  (#let-mut remaining #u8 count)
  (#while (#u8::gt remaining 0u8)
    (#deref-set target (#u8::add-wrap (#deref target) 1u8))
    (#set remaining (#u8::sub-wrap remaining 1u8)))
  (#return ()))

(#theorem bump-contract
  (#proof-loop-limit
    4
    (#proof-contract
      bump
      (#u8::le count 2u8)
      (#proof-eq (#deref target) (#u8::add-wrap (#proof-old (#deref target)) count)))))

(#fn work (: pair (#ref-mut Pair) : count #u8) #u8
  (#call bump (: target (#borrow-mut (#get (#deref pair) total)) : count count))
  (#return (#get pair total)))

(#theorem work-contract
  (#proof-using
    (bump-contract)
    (#proof-loop-limit
      1
      (#proof-contract
        work
        (#u8::le count 2u8)
        (#proof-and
          (#proof-eq (#proof-result) (#u8::add-wrap (#proof-old (#get pair total)) count))
          (#proof-eq (#get pair untouched) (#proof-old (#get pair untouched))))))))

(#fn main () #u64
  (#let-mut pair Pair (#struct-literal Pair (: total 40u8 : untouched 7u8)))
  (#return (#as (#call work (: pair (#borrow-mut pair) : count 2u8)) #u64)))
