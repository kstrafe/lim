; All operations are checked definitions over unbounded mathematical naturals.
(#math-definition add ()
  (#pt-pi ((left #pt-nat) (right #pt-nat)) #pt-nat)
  (#pt-lambda ((left #pt-nat) (right #pt-nat))
    (#pt-nat-induct (#pt-lambda ((index #pt-nat)) #pt-nat) left
      (#pt-lambda ((previous #pt-nat) (sum #pt-nat)) (#pt-succ sum)) right)))

(#math-definition multiply ()
  (#pt-pi ((left #pt-nat) (right #pt-nat)) #pt-nat)
  (#pt-lambda ((left #pt-nat) (right #pt-nat))
    (#pt-nat-induct (#pt-lambda ((index #pt-nat)) #pt-nat) #pt-zero
      (#pt-lambda ((previous #pt-nat) (product #pt-nat))
        (#pt-app (#pt-use add ()) product left)) right)))

(#math-definition power ()
  (#pt-pi ((base #pt-nat) (exponent #pt-nat)) #pt-nat)
  (#pt-lambda ((base #pt-nat) (exponent #pt-nat))
    (#pt-nat-induct (#pt-lambda ((index #pt-nat)) #pt-nat) (#pt-numeral 1)
      (#pt-lambda ((previous #pt-nat) (value #pt-nat))
        (#pt-app (#pt-use multiply ()) value base)) exponent)))

(#math-definition grow ()
  (#pt-pi ((count #pt-nat)) #pt-nat)
  (#pt-lambda ((count #pt-nat))
    (#pt-nat-induct (#pt-lambda ((index #pt-nat)) #pt-nat) #pt-zero
      (#pt-lambda ((previous #pt-nat) (value #pt-nat))
        (#pt-app (#pt-use add ())
          (#pt-app (#pt-use multiply ()) value (#pt-numeral 2)) (#pt-numeral 1))) count)))

(#theorem two-to-128
  (#universes)
  (#parameters)
  (#statement (#pt-eq #pt-nat
    (#pt-app (#pt-use power ()) (#pt-numeral 2) (#pt-numeral 128))
    (#pt-nat-literal #pt-nat "340282366920938463463374607431768211456")))
  (#proof (#pt-refl #pt-nat (#pt-nat-literal #pt-nat "340282366920938463463374607431768211456"))))

(#theorem affine-growth
  (#universes)
  (#parameters)
  (#statement (#pt-eq #pt-nat (#pt-app (#pt-use grow ()) (#pt-numeral 128))
    (#pt-nat-literal #pt-nat "340282366920938463463374607431768211455")))
  (#proof (#pt-refl #pt-nat (#pt-nat-literal #pt-nat "340282366920938463463374607431768211455"))))

(#fn main () #u64
  (#return 42u64))
