(#import "modules/file_errors.lim")
(#import "modules/parse_errors.lim")

(#fn code ((error ApplicationError)) #u64
  (#return
    (#match error
      (#case (ApplicationError.FileFailure number) (#as number #u64))
      (#case (ApplicationError.ParseFailure number) number))))

(#fn main () #u64
  (#return (#call code (: error (ApplicationError.FileFailure 42u32)))))
