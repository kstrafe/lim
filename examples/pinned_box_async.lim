(#import "../library/linux_x86_64.lim")
(#import "../library/pin_box.lim")

(#struct Arena () ())
(#enum ArenaError () (OutOfMemory))
(#import "../library/pin.lim")
(#enum Step (#linear) (: Step-waiting #u64 #u64))

(#enum StepPoll () (: StepPending Step : StepReady #u64))
(#fn step-poll (: task Step : waker (#ref #u64)) StepPoll
  (#return (#match task
    (#case (Step-waiting value remaining)
      (#if (#u64.== remaining 0u64) (StepReady value)
        (StepPending (Step-waiting value (#u64.-.wrap remaining 1u64))))))))
(#syntax StepAwait (#u64 Step StepPending StepReady step-poll))
(#fn cancel-step (: task Step) () (#forget task) (#return ()))

(@#async-fn-pinned (: protocol WorkAwait : waker #u64
  : cancel (cancel-work ((await-0 cancel-step)))
  : function
  (#fn work () #u64
    (#let value #u64 (#await (#syntax-splice StepAwait) (Step-waiting 42u64 2u64)))
    (#return value))))

(@#result (: ok (#ptr-mut Work::Frame) : error ArenaError : name FrameAllocResult))
(#fn arena-allocate (: allocator (#ref Arena) : layout #usize : alignment #usize) FrameAllocResult
  (#let pointer (#ptr-mut Work::Frame)
    (#unsafe (#linux-syscall (#ptr-mut Work::Frame) LINUX-SYS-MMAP
      (0usize layout 3usize 34usize -1i64 0usize))))
  (#return (#if (#usize.>= (#ptr-address pointer) 18446744073709547520usize)
    (FrameAllocResult-err-value OutOfMemory)
    (FrameAllocResult-ok-value pointer))))
(#fn arena-deallocate (: allocator (#ref Arena) : pointer (#ptr-mut Work::Frame)
  : layout #usize : alignment #usize) ()
  (#let status #i64 (#unsafe (#linux-syscall #i64 LINUX-SYS-MUNMAP (pointer layout))))
  (#assert (#i64.== status 0i64)) (#return ()))

(@#pin-box (: type Work::Frame : allocator Arena : name PinnedFrameBox : error ArenaError
  : alloc-result FrameAllocResult : alloc-ok FrameAllocResult-ok-value
  : alloc-error FrameAllocResult-err-value : alloc arena-allocate
  : dealloc arena-deallocate : destroy destroy-frame))

(#fn destroy-frame (: allocator (#ref Arena) : pin (#pin-ref-mut Work::Frame)) ()
  (#call cancel-work (: task (#call Work::poll::cleanup (: task pin))))
  (#forget pin)
  (#return ()))

(#fn main () #u64
  (#let arena Arena (#struct-literal Arena ()))
  (#let frame Work::Frame (#call work (:)))
  (#let created PinnedFrameBoxCreateResult
    (#call PinnedFrameBox-create (: allocator (#borrow arena) : value frame)))
  (#let-mut owner PinnedFrameBox
    (#match created
      (#case (PinnedFrameBox-created box) box)
      (#case (PinnedFrameBox-allocation-failed failure)
        (#block (#let (#tuple error failed-frame) (#tuple ArenaError Work::Frame) failure)
          (#forget error) (#forget failed-frame) (#return 0u64)))))
  (#let waker #u64 0u64)
  (#let first Work::Poll
    (#call Work::poll (: task (#call PinnedFrameBox-borrow-mut (: owner (#borrow-mut owner)))
      : waker (#borrow waker))))
  (#let-else (Work::Pending pending-frame) Work::Poll first (#unreachable))
  (#forget pending-frame)
  (#let-mut moved-once PinnedFrameBox owner)
  (#let second Work::Poll
    (#call Work::poll (: task (#call PinnedFrameBox-borrow-mut (: owner (#borrow-mut moved-once)))
      : waker (#borrow waker))))
  (#let-else (Work::Pending pending-frame-second) Work::Poll second (#unreachable))
  (#forget pending-frame-second)
  (#let-mut moved-twice PinnedFrameBox moved-once)
  (#let third Work::Poll
    (#call Work::poll (: task (#call PinnedFrameBox-borrow-mut (: owner (#borrow-mut moved-twice)))
      : waker (#borrow waker))))
  (#let answer #u64
    (#match third
      (#case (Work::Ready value) value)
      (#case (Work::Pending unexpected-frame) (#block (#forget unexpected-frame) 0u64))))
  (#call PinnedFrameBox-destroy (: owner moved-twice))
  (#return answer))
