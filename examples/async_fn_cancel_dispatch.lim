(#enum Child ((Waiting #u64)))
(#linear Child)
(#enum ChildPoll ((ChildPending Child) (ChildReady #u64)))
(#fn child-poll ((task Child) (waker (#ref #u64))) ChildPoll
  (#return (ChildPending task)))
(#fn child-cancel ((task Child)) () (#forget task) (#return ()))

(#enum Token ((TokenValue #u64)))
(#linear Token)
(#fn destroy-token ((task Token)) () (#forget task) (#return ()))

(#fn cancel-start ((task Token)) ()
  (#call destroy-token (: task task))
  (#return ()))

(#fn cancel-await ((task (#tuple Token Child))) ()
  (#let (#tuple token child) (#tuple Token Child) task)
  (#call destroy-token (: task token))
  (#call child-cancel (: task child))
  (#return ()))

(@async-fn
  (: names (Work WorkPoll WorkPending WorkReady work-poll)
   : waker #u64
   : cancel (cancel-work
     ((Work-start cancel-start)
      (Work-await-0 cancel-await)))
   : function
   (#fn work ((token Token)) #u64
     (#let child-result #u64
       (#await #u64 Child ChildPending ChildReady child-poll (Waiting 0u64)))
     (#call destroy-token (: task token))
     (#return 42u64))))

(#fn main () #u64
  (#let waker #u64 0u64)
  ; Cancel a task before its first poll.
  (#call cancel-work (: task (#call work (: token (TokenValue 1u64)))))
  ; Cancel another task after its child has returned Pending.
  (#let task Work (#call work (: token (TokenValue 2u64))))
  (#let outcome WorkPoll
    (#call work-poll (: task task : waker (#borrow waker))))
  (#let-else (WorkPending pending) WorkPoll outcome (#unreachable))
  (#call cancel-work (: task pending))
  (#forget waker)
  (#return 42u64))
