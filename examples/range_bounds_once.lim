// Range endpoints are evaluated once, start before end, even with continue.
(#fn bound ((order (#ref-mut #u64)) (expected #u64) (value #u64)) #u64
  (#assert (#u64::eq (#deref order) expected))
  (#deref-set order (#u64::add-wrap (#deref order) 1u64))
  (#return value))
(#fn main () #u64
  (#let-mut order #u64 0u64)
  (#let-mut limit #u64 3u64)
  (#let-mut total #u64 0u64)
  (#label
    counting
    (#for-range (iteration #u64) (#call bound ((order (#borrow-mut order)) (expected 0u64) (value 0u64))) (#call bound ((order (#borrow-mut order)) (expected 1u64) (value limit)))
      (#if (#u64::eq iteration 0u64)
        (#block
          (#set limit 0u64)
          (#continue-to counting))
        ())
      (#set total (#u64::add-wrap total iteration))))
  (#assert (#u64::eq order 2u64))
  (#assert (#u64::eq limit 0u64))
  (#return (#u64::add-wrap total 39u64)))
