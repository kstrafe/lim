; A reused reference-returning contract must preserve the caller's storage.
(#struct Pair () (: current #u8 : untouched #u8))

(#fn current-ref (: pair (#ref-mut Pair)) (#ref-mut #u8)
  (#return (#borrow-mut (#get (#deref pair) current))))

(#theorem current-ref-contract
  (#proof-contract current-ref true true))

(#fn update (: pair (#ref-mut Pair)) #u8
  (#let target (#ref-mut #u8) (#call current-ref (: pair pair)))
  (#deref-set target (#u8::add-wrap (#deref target) 1u8))
  (#forget target)
  (#return (#get pair current)))

(#theorem update-contract
  (#proof-using
    (current-ref-contract)
    (#proof-contract
      update
      true
      (#proof-and
        (#proof-eq (#proof-result) (#u8::add-wrap (#proof-old (#get pair current)) 1u8))
        (#proof-eq (#get pair untouched) (#proof-old (#get pair untouched)))))))

(#fn main () #u64
  (#let-mut pair Pair (#struct-literal Pair (: current 41u8 : untouched 7u8)))
  (#return (#as (#call update (: pair (#borrow-mut pair))) #u64)))
