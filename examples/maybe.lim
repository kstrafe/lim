(
  #enum
  Maybe ()
  (
    (Some #u64)
    None
  )
)

(
  #fn
  make
  ()
  Maybe
  (
    #return
    (Some 42)
  )
)

(
  #fn
  main
  ()
  #u64
  (
    #let
    value
    Maybe
    (#call make (:))
  )
  (
    #return
    (
      #match
      value
      (#case
        (Some payload)
        payload
      )
      (#case None 7)
    )
  )
)
