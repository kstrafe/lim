(
  #enum
  Maybe ()
  (
    (Maybe.Some #u64)
    Maybe.None
  )
)

(
  #fn
  make
  ()
  Maybe
  (
    #return
    (Maybe.Some 42)
  )
)

(
  #fn
  main
  ()
  #u64
  (
    #let
    value
    Maybe
    (#call make ())
  )
  (
    #return
    (
      #match
      value
      (#case
        (Maybe.Some payload)
        payload
      )
      (#case Maybe.None 7)
    )
  )
)
