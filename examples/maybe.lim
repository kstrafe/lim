(
  #enum
  Maybe
  (
    (Some u64)
    None
  )
)

(
  #fn
  make
  ()
  Maybe
  (
    #return
    (Some 42)
  )
)

(
  #fn
  main
  ()
  u64
  (
    #let
    value
    Maybe
    (#call make (#fn-args ))
  )
  (
    #return
    (
      #match
      value
      (
        (Some payload)
        payload
      )
      (None 7)
    )
  )
)
