#enum
    Maybe ()
    (
      (Maybe.Some #u64)
      Maybe.None
    )

#fn
    make {
  #params = ();
  #returns = Maybe;
  #body = (
    (
      #return
      (Maybe.Some 42)
    )
  );
}

#fn
    main {
  #params = ();
  #returns = #u64;
  #body = (
    (
      #let
      value
      Maybe
      (#call make ())
    )
    (
      #return
      (
        #match
        value
        (#case
          (Maybe.Some payload)
          payload
        )
        (#case Maybe.None 7)
      )
    )
  );
}
