#alias lim-gen-ready-queue = #std/ready_queue.lim::ready-queue
// Queue operations update Copy fields in place; main consumes the linear owner.

#generate lim-gen-ready-queue { name = ReadyQueue; enqueue-result = ReadyQueueEnqueueResult; dequeue-result = ReadyQueueDequeueResult;
  create = ready-queue-create; enqueue = ready-queue-enqueue; dequeue = ready-queue-dequeue; enqueued = ReadyQueueEnqueueResult.QueueEnqueued;
  full = ReadyQueueEnqueueResult.QueueFull; item = ReadyQueueDequeueResult.QueueItem;
  empty = ReadyQueueDequeueResult.QueueEmpty; slots = (worker-a worker-b worker-c); }

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let-mut queue ReadyQueue (#call ready-queue-create ()))
    (#let first ReadyQueueEnqueueResult (#call ready-queue-enqueue ((queue (#borrow-mut queue))
          (task-id 11u64))))
    (#let second ReadyQueueEnqueueResult (#call ready-queue-enqueue ((queue (#borrow-mut queue))
          (task-id 22u64))))
    (#let third ReadyQueueEnqueueResult (#call ready-queue-enqueue ((queue (#borrow-mut queue))
          (task-id 33u64))))
    (#let full ReadyQueueEnqueueResult (#call ready-queue-enqueue ((queue (#borrow-mut queue))
          (task-id 44u64))))
    (#forget first)
    (#forget second)
    (#forget third)
    (#let full-ok #bool (#match full
        (#case ReadyQueueEnqueueResult.QueueFull
          true
        )
        (#case ReadyQueueEnqueueResult.QueueEnqueued
          false
        )
      ))
    (#let removed ReadyQueueDequeueResult (#call ready-queue-dequeue ((queue (#borrow-mut queue)))))
    (#let first-ok #bool (#match removed
        (#case (ReadyQueueDequeueResult.QueueItem value)
          (#u64::eq value 11u64)
        )
        (#case ReadyQueueDequeueResult.QueueEmpty
          false
        )
      ))
    (#let wrap ReadyQueueEnqueueResult (#call ready-queue-enqueue ((queue (#borrow-mut queue))
          (task-id 44u64))))
    (#forget wrap)
    (#let-mut total #u64 0u64)
    (#while (#u64::ne (#clone (#get queue length)) 0u64)
      (#let next ReadyQueueDequeueResult (#call ready-queue-dequeue ((queue (#borrow-mut queue)))))
      (#set total (#match next
          (#case (ReadyQueueDequeueResult.QueueItem value)
            (#u64::add-wrap total value)
          )
          (#case ReadyQueueDequeueResult.QueueEmpty
            total
          )
        ))
    )
    (#let empty ReadyQueueDequeueResult (#call ready-queue-dequeue ((queue (#borrow-mut queue)))))
    (#let empty-ok #bool (#match empty
        (#case ReadyQueueDequeueResult.QueueEmpty
          true
        )
        (#case (ReadyQueueDequeueResult.QueueItem _)
          false
        )
      ))
    (#forget queue)
    (#return (#if (#bool::and (#bool::and full-ok first-ok) empty-ok)
        total
        0u64
      ))
  );
}
