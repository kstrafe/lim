(#struct PairValues () (: left #u64 : right #u64))

(
  #enum
  Pair ()
  (
    (Pair PairValues)
    Empty
  )
)

(
  #fn
  main
  ()
  #u64
  (
    #let
    value
    Pair
    (Pair (#struct-literal PairValues (: left 20 : right 22)))
  )
  (
    #return
    (
      #match
      value
      (#case
        (Pair (PairValues left right))
        (#u64.+.wrap  left right)
      )
      (#case Empty 0)
    )
  )
)
