(
  #enum
  Pair
  (
    (Pair #u64 #u64)
    Empty
  )
)

(
  #fn
  main
  ()
  #u64
  (
    #let
    value
    Pair
    (Pair 20 22)
  )
  (
    #return
    (
      #match
      value
      (#case
        (Pair left right)
        (#u64.+.wrap  left right)
      )
      (#case Empty 0)
    )
  )
)
