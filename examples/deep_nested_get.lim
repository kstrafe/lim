(#struct Outer
  ((values (#array u64 7)) (tag u64)))

(#static GlobalOuter Outer
  (Outer
    (#array (#array u64 7)
      1u64 2u64 3u64 4u64 5u64 6u64 7u64)
    100u64))

(#fn make () Outer
  (#return GlobalOuter))

(#fn main () u64
  (#let local Outer (make))
  (#let local-values (#array u64 7) (#get local values))
  (#let returned-values (#array u64 7) (#get (make) values))
  (#let static-values (#array u64 7) (#get GlobalOuter values))
  (#return (#u64.+.wrap
    (#index local-values 6u64)
    (#u64.+.wrap
      (#index returned-values 6u64)
      (#index static-values 6u64)))))
