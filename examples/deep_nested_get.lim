#struct Outer ()
    ((values (#array #u64 7)) (tag #u64))

#static globalOuter Outer
    (#struct-literal Outer ((values (#array (#array #u64 7)
        1u64 2u64 3u64 4u64 5u64 6u64 7u64)) (tag 100u64)))

#fn make () Outer
    (#return (#unsafe globalOuter))

#fn main () #u64
    (#let local Outer (#call make ()))
    (#let local-values (#array #u64 7) (#get local values))
    (#let returned-values (#array #u64 7) (#get (#call make ()) values))
    (#let static-values (#array #u64 7) (#get (#unsafe globalOuter) values))
    (#return (#u64::add-wrap
      (#index local-values 6u64)
      (#u64::add-wrap
        (#index returned-values 6u64)
        (#index static-values 6u64))))
