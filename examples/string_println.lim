#alias String = #std/string.lim::String
#alias String::free = #std/string.lim::String::free
#alias String::from-chars = #std/string.lim::String::from-chars
#alias String::push-char = #std/string.lim::String::push-char
#alias String::push-string = #std/string.lim::String::push-string
#alias StringCreateResult = #std/string.lim::StringCreateResult
#alias StringStatus = #std/string.lim::StringStatus

#std

#fn main {
  #params = ();
  #returns = #u64;
  #effects = ((#effects-of String::free) (#effects-of String::from-chars) (#effects-of String::push-char) (#effects-of String::push-string) (#effects-of std-println));
  #body = (
    (#let greeting (#array #char 5) "Hello")
    (#let suffix (#array #char 9) ", world 🙂")
    (#let-mut message String (#match (#call String::from-chars ((text (#borrow-slice greeting))))
        (#case (StringCreateResult.StringCreated created-message)
          created-message
        )
        (#case (StringCreateResult.StringCreateFailed error)
          (#panic)
        )
      ))
    (#let tail String (#match (#call String::from-chars ((text (#borrow-slice suffix))))
        (#case (StringCreateResult.StringCreated created-tail)
          created-tail
        )
        (#case (StringCreateResult.StringCreateFailed error)
          (#panic)
        )
      ))
    (#assert
      (#match (#call String::push-string ((string (#borrow-mut message)) (text (#borrow tail))))
        (#case StringStatus.StringOk
          true
        )
        (#case _
          false
        )
      ))
    (#assert (#match (#call String::push-char ((string (#borrow-mut message)) (value #\!)))
        (#case StringStatus.StringOk
          true
        )
        (#case _
          false
        )
      ))
    (#assert (#i64::eq (#println (#borrow message)) (#literal #i64 0)))
    (#call String::free ((string tail)))
    (#call String::free ((string message)))
    (#return (#literal #u64 42))
  );
}
