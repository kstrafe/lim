(#fn add-last
  ((left (#array (#tuple #u128 #u64) 4))
   (right (#array (#tuple #u128 #u64) 4)))
  #u64
  (#let left-item (#tuple #u128 #u64) (#index left 3u64))
  (#let right-item (#tuple #u128 #u64) (#index right 3u64))
  (#return (#u64::add-wrap (#get left-item 1) (#get right-item 1))))

(#fn main () #u64
  (#return
    (#call add-last (: left (#array (#array (#tuple #u128 #u64) 4)
        (#tuple 10u128 2u64)
        (#tuple 20u128 3u64)
        (#tuple 30u128 4u64)
        (#tuple 40u128 20u64)) : right (#array (#array (#tuple #u128 #u64) 4)
        (#tuple 50u128 5u64)
        (#tuple 60u128 6u64)
        (#tuple 70u128 7u64)
        (#tuple 80u128 22u64))))))
