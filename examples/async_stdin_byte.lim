; Read and echo one stdin byte using readiness polling. The task borrows the
; destination only while it is pending; poll never leaves the buffer in flight.
(#import "../library/async_stdin_byte.lim")

(#fn main () i32
  (#let-mut byte u8 0u8)
  (#let blocking AsyncByteReadCreate1
    (#call async-byte-read1-create
      (: fd 0i64 : destination (#borrow-mut byte))))
  (#assert (#match blocking
    (#case (AsyncByteReadCreateFailed1 error) (#i64.== error -22i64))
    (#case (AsyncByteReadCreated1 unexpected)
      (#block
        (#let cleanup i64
          (#call async-byte-read1-destroy (: task unexpected)))
        false))))
  (#let enabled i64 (#call async-byte-read1-enable-nonblocking (: fd 0i64)))
  (#assert (#i64.>= enabled 0i64))
  (#let invalid AsyncByteReadCreate1
    (#call async-byte-read1-create
      (: fd -1i64 : destination (#borrow-mut byte))))
  (#assert (#match invalid
    (#case (AsyncByteReadCreateFailed1 error) (#i64.== error -9i64))
    (#case (AsyncByteReadCreated1 unexpected)
      (#block
        (#let cleanup i64
          (#call async-byte-read1-destroy (: task unexpected)))
        false))))
  (#let created AsyncByteReadCreate1
    (#call async-byte-read1-create
      (: fd 0i64 : destination (#borrow-mut byte))))
  (#let-else (AsyncByteReadCreated1 task) AsyncByteReadCreate1 created
    (#unreachable))
  (#let original-closed i64 (#call linux-close (: fd 0i64)))
  (#let first AsyncByteReadPoll1
    (#call async-byte-read1-poll (: task (#borrow task))))
  (#let wait AsyncByteReadWait1
    (#call async-byte-read1-wait (: task (#borrow task))))
  (#let second AsyncByteReadPoll1
    (#call async-byte-read1-poll (: task (#borrow task))))
  (#let destroyed i64 (#call async-byte-read1-destroy (: task task)))
  (#let result i32 (#match second
    (#case (AsyncByteReadReady1 value)
      (#block
        (#let written i64
          (#call linux-write-byte (: source (#borrow byte))))
        (#if (#bool.&& (#u8.== value byte) (#i64.== written 1i64)) 0i32 5i32)))
    (#case AsyncByteReadEof1 0i32)
    (#case (AsyncByteReadFailed1 error)
      (#block (#forget error) 6i32))
    (#case AsyncByteReadPending1 7i32)))
  (#return (#if (#bool.&& (#i64.== destroyed 0i64)
                         (#i64.== original-closed 0i64))
    (#if (#match first
      (#case AsyncByteReadPending1 true)
      (#case _ false))
      (#if (#match wait (#case AsyncByteReadWoken1 true) (#case _ false))
        result 8i32)
      9i32)
    10i32)))
