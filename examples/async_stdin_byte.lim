#alias AsyncByteRead1 = ../library/async_stdin_byte.lim::AsyncByteRead1
#alias AsyncByteReadCreate1 = ../library/async_stdin_byte.lim::AsyncByteReadCreate1
#alias AsyncByteReadPoll1 = ../library/async_stdin_byte.lim::AsyncByteReadPoll1
#alias AsyncByteReadWait1 = ../library/async_stdin_byte.lim::AsyncByteReadWait1
#alias async-byte-read1-create = ../library/async_stdin_byte.lim::async-byte-read1-create
#alias async-byte-read1-destroy = ../library/async_stdin_byte.lim::async-byte-read1-destroy
#alias async-byte-read1-enable-nonblocking = ../library/async_stdin_byte.lim::async-byte-read1-enable-nonblocking
#alias async-byte-read1-poll = ../library/async_stdin_byte.lim::async-byte-read1-poll
#alias async-byte-read1-wait = ../library/async_stdin_byte.lim::async-byte-read1-wait
#alias linux-close = ../library/linux_x86_64.lim::linux-close
#alias linux-write-byte = ../library/linux_x86_64.lim::linux-write-byte

// Work.Read and echo one stdin byte using readiness polling. The task borrows the
// destination only while it is pending; poll never leaves the buffer in flight.


#fn main {
  #params = ();
  #returns = #i32;
  #body = (
    (#let-mut byte #u8 0u8)
    (#let blocking AsyncByteReadCreate1
      (#call async-byte-read1-create
        ((fd 0i64) (destination (#borrow-mut byte)))))
    (#assert (#match blocking
      (#case (AsyncByteReadCreate1.AsyncByteReadCreateFailed1 error) (#i64::eq error -22i64))
      (#case (AsyncByteReadCreate1.AsyncByteReadCreated1 unexpected)
        (#block
          (#let cleanup #i64
            (#call async-byte-read1-destroy ((task unexpected))))
          false))))
    (#let enabled #i64 (#call async-byte-read1-enable-nonblocking ((fd 0i64))))
    (#assert (#i64::ge enabled 0i64))
    (#let invalid AsyncByteReadCreate1
      (#call async-byte-read1-create
        ((fd -1i64) (destination (#borrow-mut byte)))))
    (#assert (#match invalid
      (#case (AsyncByteReadCreate1.AsyncByteReadCreateFailed1 error) (#i64::eq error -9i64))
      (#case (AsyncByteReadCreate1.AsyncByteReadCreated1 unexpected)
        (#block
          (#let cleanup #i64
            (#call async-byte-read1-destroy ((task unexpected))))
          false))))
    (#let created AsyncByteReadCreate1
      (#call async-byte-read1-create
        ((fd 0i64) (destination (#borrow-mut byte)))))
    (#let-else (AsyncByteReadCreate1.AsyncByteReadCreated1 initial-task) AsyncByteReadCreate1 created
      (#unreachable))
    (#let-mut task AsyncByteRead1 initial-task)
    (#let original-closed #i64 (#call linux-close ((fd 0i64))))
    (#let first AsyncByteReadPoll1
      (#call async-byte-read1-poll ((task (#borrow-mut task)))))
    (#let wait AsyncByteReadWait1
      (#call async-byte-read1-wait ((task (#borrow task)))))
    (#let second AsyncByteReadPoll1
      (#call async-byte-read1-poll ((task (#borrow-mut task)))))
    (#let destroyed #i64 (#call async-byte-read1-destroy ((task task))))
    (#let result #i32 (#match second
      (#case (AsyncByteReadPoll1.AsyncByteReadReady1 value)
        (#block
          (#let written #i64
            (#call linux-write-byte ((source (#borrow byte)))))
          (#if (#bool::and (#u8::eq value byte) (#i64::eq written 1i64)) 0i32 5i32)))
      (#case AsyncByteReadPoll1.AsyncByteReadEof1 0i32)
      (#case (AsyncByteReadPoll1.AsyncByteReadFailed1 error)
        (#block (#forget error) 6i32))
      (#case AsyncByteReadPoll1.AsyncByteReadPending1 7i32)))
    (#return (#if (#bool::and (#i64::eq destroyed 0i64)
                           (#i64::eq original-closed 0i64))
      (#if (#match first
        (#case AsyncByteReadPoll1.AsyncByteReadPending1 true)
        (#case _ false))
        (#if (#match wait (#case AsyncByteReadWait1.AsyncByteReadWoken1 true) (#case _ false))
          result 8i32)
        9i32)
      10i32))
  );
}
