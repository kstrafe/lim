(#import "../library/linux_x86_64.lim")

(#fn main () u64
  (#let memory (#ptr-mut u8)
    (#call linux-mmap (#fn-args
      (address (#ptr-null (#ptr-mut u8)))
      (length 4096usize)
      (protection 3u32)
      (flags 34u32)
      (fd -1i64)
      (offset 0i64))))
  (#let memory-initialized ()
    (#unsafe (#block (#ptr-write memory 201u8) ())))
  (#let value u8 (#unsafe (#ptr-read memory)))
  (#let readable i64
    (#call linux-mprotect (#fn-args
      (address memory) (length 4096usize) (protection 1u32))))
  (#let unaligned-protection i64
    (#call linux-mprotect (#fn-args
      (address (#unsafe (#ptr-offset memory 1usize)))
      (length 1usize)
      (protection 1u32))))
  (#let unmapped i64
    (#call linux-munmap (#fn-args (address memory) (length 4096usize))))
  (#return
    (#if (#bool.&& (#u8.== value 201u8)
          (#bool.&& (#i64.== readable 0i64)
            (#bool.&& (#i64.== unaligned-protection -22i64)
              (#i64.== unmapped 0i64))))
      42u64
      1u64)))
