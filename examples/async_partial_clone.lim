; Move and restore one part while a sibling is borrowed, then clone the whole.
; Cloning snapshots values without relocating the original borrowed part.
(#struct Part (: value #u64))
(#linear Part)
(#struct Parts (: first Part : second Part))
(#linear Parts)
(#fn Parts-clone (: original Parts) Parts
  (#let (Parts first second) Parts original)
  (#let value #u64 (#u64.+.wrap (#get first value) 1u64))
  (#forget first)
  (#return (#struct-literal Parts (: first (#struct-literal Part (: value value)) : second second))))
(#enum Step (Start Resume))
(#linear Step)
(#enum StepPoll ((Pending Step) (Ready ())))
(#fn step-poll (: task Step : waker (#ref #u64)) StepPoll
  (#return
    (#match task
      (#case Start
        (Pending Resume))
      (#case Resume
        (Ready ())))))
(@
  #async-fn-pinned
  (: protocol WorkAwait : waker #u64 : function
  (#fn work () Parts
    (#let-mut original Parts (#struct-literal Parts
      (: first (#struct-literal Part (: value 20u64))
       : second (#struct-literal Part (: value 22u64)))))
    (#let view (#ref Part) (#borrow (#get original second)))
    (#let moved Part (#get original first))
    (#let ready () (#await () Step Pending Ready step-poll Start))
    (#forget moved)
    (#set-field original first (#struct-literal Part (: value 22u64)))
    (#let duplicate Parts (#clone original))
    (#assert (#u64.== (#get view value) 22u64))
    (#drop view) (#forget original) (#return duplicate))))
(#fn main () #u64
  (#let waker #u64 0u64)
  (#let-mut frame Work-frame (#call work (:)))
  (#let
    first
    Work-poll-result
    (#call work-poll (: task (#pin-borrow-mut frame) : waker (#borrow waker))))
  (#let-else (work-pending pending) Work-poll-result first (#unreachable))
  (#let second Work-poll-result (#call work-poll (: task pending : waker (#borrow waker))))
  (#let
    result
    #u64
    (#match second
      (#case (work-ready duplicate)
        (#block
          (#let
            value
            #u64
            (#u64.+.wrap (#get (#get duplicate first) value) (#get (#get duplicate second) value)))
          (#forget duplicate)
          value))
      (#case (work-pending unexpected)
        (#block
          (#forget unexpected)
          (#unreachable)))))
  (#forget frame)
  (#return result))
