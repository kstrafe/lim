#alias String = #std/string.lim::String
#alias String::free = #std/string.lim::String::free
#alias String::from-chars = #std/string.lim::String::from-chars
#alias String::view = #std/utf8_view.lim::String::view
#alias StringCreateResult = #std/string.lim::StringCreateResult
#alias StringView = #std/utf8_view.lim::StringView
#alias StringView::CharResult = #std/utf8_view.lim::StringView::CharResult
#alias StringView::Chars = #std/utf8_view.lim::StringView::Chars
#alias StringView::Chars::next = #std/utf8_view.lim::StringView::Chars::next
#alias StringView::Result = #std/utf8_view.lim::StringView::Result
#alias StringView::chars = #std/utf8_view.lim::StringView::chars
#alias StringView::len = #std/utf8_view.lim::StringView::len
#alias StringView::subview = #std/utf8_view.lim::StringView::subview

#std

#fn main {
  #params = ();
  #returns = #u64;
  #effects = ((#effects-of String::free) (#effects-of String::from-chars) (#effects-of String::view) (#effects-of StringView::subview) (#effects-of StringView::Chars::next));
  #body = (
    (#let source (#array #char 4) "Aλ😀!")
    (#let text String (#match (#call String::from-chars ((text (#borrow-slice source))))
        (#case (StringCreateResult.StringCreated created)
          created
        )
        (#case (StringCreateResult.StringCreateFailed error)
          (#panic)
        )
      ))
    (#let whole StringView (#call String::view ((string (#borrow text)))))
    (#let middle StringView
      (#match (#call StringView::subview ((view (#borrow whole)) (start 1usize) (end 7usize)))
        (#case (StringView::Result.Valid selected)
          selected
        )
        (#case _
          (#panic)
        )
      ))
    (#assert (#usize::eq (#call StringView::len ((view (#borrow middle)))) 6usize))
    (#let-mut characters StringView::Chars (#call StringView::chars ((view middle))))
    (#assert (#match (#call StringView::Chars::next ((iterator (#borrow-mut characters))))
        (#case (StringView::CharResult.Char first)
          (#char::eq first #\λ)
        )
        (#case _
          false
        )
      ))
    (#assert (#match (#call StringView::Chars::next ((iterator (#borrow-mut characters))))
        (#case (StringView::CharResult.Char second)
          (#char::eq second #\😀)
        )
        (#case _
          false
        )
      ))
    (#assert (#match (#call StringView::Chars::next ((iterator (#borrow-mut characters))))
        (#case StringView::CharResult.End
          true
        )
        (#case _
          false
        )
      ))
    (#forget characters)
    (#forget whole)
    (#call String::free ((string text)))
    (#return 42u64)
  );
}
