(#std)
(#fn main () #u64
  (#let source (#array #char 4) "Aλ😀!")
  (#let text String
    (#match (#call String-from-chars (: text (#borrow-slice source)))
      (#case (StringCreated created) created)
      (#case (StringCreateFailed error) (#panic))))
  (#let whole StringView (#call String-view (: string (#borrow text))))
  (#let middle StringView
    (#match (#call StringView::subview (: view (#borrow whole) : start 1usize : end 7usize))
      (#case (StringView::Valid selected) selected)
      (#case _ (#panic))))
  (#assert (#usize.== (#call StringView::len (: view (#borrow middle))) 6usize))
  (#let-mut characters StringView::Chars (#call StringView::chars (: view middle)))
  (#assert (#match (#call StringView::Chars::next (: iterator (#borrow-mut characters)))
    (#case (StringView::Char first) (#char.== first #\λ)) (#case _ false)))
  (#assert (#match (#call StringView::Chars::next (: iterator (#borrow-mut characters)))
    (#case (StringView::Char second) (#char.== second #\😀)) (#case _ false)))
  (#assert (#match (#call StringView::Chars::next (: iterator (#borrow-mut characters)))
    (#case StringView::End true) (#case _ false)))
  (#forget characters)
  (#forget whole)
  (#call String-free (: string text))
  (#return 42u64))
