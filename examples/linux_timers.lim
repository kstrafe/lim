#alias lINUX-SYS-MMAP = ../library/linux_x86_64_syscall_numbers.lim::lINUX-SYS-MMAP
#alias lINUX-SYS-MUNMAP = ../library/linux_x86_64_syscall_numbers.lim::lINUX-SYS-MUNMAP
#alias lINUX-SYS-POLL = ../library/linux_x86_64_syscall_numbers.lim::lINUX-SYS-POLL
#alias lINUX-SYS-READ = ../library/linux_x86_64_syscall_numbers.lim::lINUX-SYS-READ
#alias linux-close = ../library/linux_x86_64.lim::linux-close
#alias linux-timer-create = ../library/linux_x86_64.lim::linux-timer-create
#alias linux-timer-delete = ../library/linux_x86_64.lim::linux-timer-delete
#alias linux-timer-getoverrun = ../library/linux_x86_64.lim::linux-timer-getoverrun
#alias linux-timer-gettime = ../library/linux_x86_64.lim::linux-timer-gettime
#alias linux-timer-settime = ../library/linux_x86_64.lim::linux-timer-settime
#alias linux-timerfd-create = ../library/linux_x86_64.lim::linux-timerfd-create
#alias linux-timerfd-gettime = ../library/linux_x86_64.lim::linux-timerfd-gettime
#alias linux-timerfd-settime = ../library/linux_x86_64.lim::linux-timerfd-settime

#fn main () #u64
    (#let event-memory (#ptr-mut #i64)
      (#unsafe (#linux-syscall (#ptr-mut #i64) lINUX-SYS-MMAP
        (0usize 4096usize 3usize 34usize -1i64 0usize))))
    (#let timer-memory (#ptr-mut #i32)
      (#unsafe (#linux-syscall (#ptr-mut #i32) lINUX-SYS-MMAP
        (0usize 4096usize 3usize 34usize -1i64 0usize))))
    (#let time-memory (#ptr-mut #i64)
      (#unsafe (#linux-syscall (#ptr-mut #i64) lINUX-SYS-MMAP
        (0usize 4096usize 3usize 34usize -1i64 0usize))))
    (#let initialized ()
      (#unsafe
        (#block
          (#ptr-write event-memory 0i64)
          (#ptr-write (#ptr-offset event-memory 1usize) 4294967296i64)
          (#ptr-write (#ptr-offset event-memory 2usize) 0i64)
          (#ptr-write (#ptr-offset event-memory 3usize) 0i64)
          (#ptr-write (#ptr-offset event-memory 4usize) 0i64)
          (#ptr-write (#ptr-offset event-memory 5usize) 0i64)
          (#ptr-write (#ptr-offset event-memory 6usize) 0i64)
          (#ptr-write (#ptr-offset event-memory 7usize) 0i64)
          (#ptr-write time-memory 0i64)
          (#ptr-write (#ptr-offset time-memory 1usize) 0i64)
          (#ptr-write (#ptr-offset time-memory 2usize) 5i64)
          (#ptr-write (#ptr-offset time-memory 3usize) 0i64)
          (#ptr-write (#ptr-offset time-memory 4usize) 0i64)
          (#ptr-write (#ptr-offset time-memory 5usize) 0i64)
          (#ptr-write (#ptr-offset time-memory 6usize) 0i64)
          (#ptr-write (#ptr-offset time-memory 7usize) 0i64)
          ())))
    (#let timer-created #i64
      (#unsafe (#unsafe-call linux-timer-create ((clock-id 1i64) (event event-memory) (timer-id timer-memory)))))
    (#let timer-id #i64 (#as (#unsafe (#ptr-read timer-memory)) #i64))
    (#assert (#i64::eq (#call linux-timer-getoverrun ((timer-id timer-id))) 0i64))
    (#let timer-armed #i64
      (#unsafe (#unsafe-call linux-timer-settime ((timer-id timer-id) (flags 0i32) (new-time time-memory) (old-time (#ptr-null (#ptr-mut #i64)))))))
    (#let timer-read #i64
      (#unsafe (#unsafe-call linux-timer-gettime ((timer-id timer-id) (current-time (#ptr-offset time-memory 4usize))))))
    (#let remaining-seconds #i64
      (#unsafe (#ptr-read (#ptr-offset time-memory 6usize))))
    (#let remaining-nanoseconds #i64
      (#unsafe (#ptr-read (#ptr-offset time-memory 7usize))))
    (#let timer-deleted #i64
      (#unsafe (#call linux-timer-delete ((timer-id timer-id)))))
    (#assert (#i64::eq (#call linux-timer-getoverrun ((timer-id timer-id))) -22i64))
    (#let deleted-timer-query #i64
      (#unsafe (#unsafe-call linux-timer-gettime ((timer-id timer-id) (current-time (#ptr-offset time-memory 4usize))))))
    (#let invalid-timerfd-clock #i64
      (#call linux-timerfd-create ((clock-id -1i32) (flags 0i32))))
    (#let invalid-timerfd-flags #i64
      (#call linux-timerfd-create ((clock-id 1i32) (flags 1i32))))
    (#let timer-fd #i64
      (#call linux-timerfd-create ((clock-id 1i32) (flags 0i32))))
    (#let initially-disarmed #i64
      (#unsafe (#unsafe-call linux-timerfd-gettime ((fd timer-fd) (current-time (#ptr-offset time-memory 4usize))))))
    (#let initial-seconds #i64
      (#unsafe (#ptr-read (#ptr-offset time-memory 6usize))))
    (#let initial-nanoseconds #i64
      (#unsafe (#ptr-read (#ptr-offset time-memory 7usize))))
    // Linux itimerspec is interval {sec,nsec}, then initial value {sec,nsec}.
    (#unsafe
      (#block
        (#ptr-write time-memory 0i64)
        (#ptr-write (#ptr-offset time-memory 1usize) 0i64)
        (#ptr-write (#ptr-offset time-memory 2usize) 0i64)
        (#ptr-write (#ptr-offset time-memory 3usize) 1000000i64)))
    (#let timerfd-armed #i64
      (#unsafe (#unsafe-call linux-timerfd-settime ((fd timer-fd) (flags 0i32) (new-time time-memory) (old-time (#ptr-null (#ptr-mut #i64)))))))
    (#let timerfd-state #i64
      (#unsafe (#unsafe-call linux-timerfd-gettime ((fd timer-fd) (current-time (#ptr-offset time-memory 4usize))))))
    (#let invalid-timerfd-settime #i64
      (#unsafe (#unsafe-call linux-timerfd-settime ((fd timer-fd) (flags 8i32) (new-time time-memory) (old-time (#ptr-null (#ptr-mut #i64)))))))
    (#unsafe (#ptr-write (#ptr-offset time-memory 8usize)
      (#as (#u64::bit-or (#as timer-fd #u64) (#u64::shl 1u64 32u64)) #i64)))
    (#let timerfd-ready #i64
      (#unsafe (#linux-syscall #i64 lINUX-SYS-POLL
        ((#ptr-offset time-memory 8usize) 1usize 1000i32))))
    (#let timerfd-read #i64
      (#if (#i64::eq timerfd-ready 1i64)
        (#unsafe (#linux-syscall #i64 lINUX-SYS-READ
          (timer-fd (#ptr-offset time-memory 9usize) 8usize)))
        -1i64))
    (#let expirations #i64
      (#unsafe (#ptr-read (#ptr-offset time-memory 9usize))))
    (#let disarmed-state #i64
      (#unsafe (#unsafe-call linux-timerfd-gettime ((fd timer-fd) (current-time (#ptr-offset time-memory 4usize))))))
    (#let remaining-after-read-seconds #i64
      (#unsafe (#ptr-read (#ptr-offset time-memory 6usize))))
    (#let remaining-after-read-nanoseconds #i64
      (#unsafe (#ptr-read (#ptr-offset time-memory 7usize))))
    (#let timerfd-closed #i64
      (#call linux-close ((fd timer-fd))))
    (#let closed-timerfd-query #i64
      (#unsafe (#unsafe-call linux-timerfd-gettime ((fd timer-fd) (current-time (#ptr-offset time-memory 4usize))))))
    (#let event-unmapped #i64
      (#unsafe (#linux-syscall #i64 lINUX-SYS-MUNMAP (event-memory 4096usize))))
    (#let timer-unmapped #i64
      (#unsafe (#linux-syscall #i64 lINUX-SYS-MUNMAP (timer-memory 4096usize))))
    (#let time-unmapped #i64
      (#unsafe (#linux-syscall #i64 lINUX-SYS-MUNMAP (time-memory 4096usize))))
    (#let remaining-positive #bool
      (#bool::or (#i64::gt remaining-seconds 0i64)
        (#i64::gt remaining-nanoseconds 0i64)))
    (#let timer-operations-ok #bool
      (#bool::and (#i64::eq timer-created 0i64)
        (#bool::and (#i64::eq timer-armed 0i64)
          (#bool::and (#i64::eq timer-read 0i64)
            (#bool::and remaining-positive
              (#bool::and (#i64::eq timer-deleted 0i64)
                (#i64::eq deleted-timer-query -22i64)))))))
    (#let timerfd-operations-ok #bool
      (#bool::and (#i64::eq invalid-timerfd-clock -22i64)
        (#bool::and (#i64::eq invalid-timerfd-flags -22i64)
          (#bool::and (#i64::ge timer-fd 0i64)
            (#bool::and (#i64::eq initially-disarmed 0i64)
              (#bool::and (#i64::eq initial-seconds 0i64)
                (#bool::and (#i64::eq initial-nanoseconds 0i64)
                  (#bool::and (#i64::eq timerfd-armed 0i64)
                    (#bool::and (#i64::eq timerfd-state 0i64)
                      (#bool::and (#i64::eq invalid-timerfd-settime -22i64)
                        (#bool::and (#i64::eq timerfd-ready 1i64)
                          (#bool::and (#i64::eq timerfd-read 8i64)
                            (#bool::and (#i64::eq expirations 1i64)
                              (#bool::and (#i64::eq disarmed-state 0i64)
                                (#bool::and (#i64::eq remaining-after-read-seconds 0i64)
                                  (#bool::and (#i64::eq remaining-after-read-nanoseconds 0i64)
                                    (#bool::and (#i64::eq timerfd-closed 0i64)
                                      (#i64::eq closed-timerfd-query -9i64))))))))))))))))))
    (#return
      (#if (#bool::and (#bool::and timer-operations-ok timerfd-operations-ok)
        (#bool::and (#i64::eq event-unmapped 0i64)
          (#bool::and (#i64::eq timer-unmapped 0i64)
            (#i64::eq time-unmapped 0i64)))) 42u64 1u64))
