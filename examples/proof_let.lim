; A proof-term binding states its name and type explicitly. Its definition
; is available for conversion in the body, including local type aliases.
(#theorem local-type-alias
  (#universes)
  (#parameters)
  (#statement (#pt-eq #pt-nat #pt-zero #pt-zero))
  (#proof
    (#pt-let
      (#parameter Alias (#pt-type 0))
      #pt-nat
      (#pt-refl Alias #pt-zero))))
; Value and evidence bindings use the same syntax. The definition is checked
; even if its name is never used; the binding is local to the body.
(#theorem local-evidence
  (#universes)
  (#parameters
    (#parameter value #pt-nat))
  (#statement (#pt-eq #pt-nat value value))
  (#proof
    (#pt-let
      (#parameter evidence (#pt-eq #pt-nat value value))
      (#pt-refl #pt-nat value)
      evidence)))

(#fn main () #u64
  (#return 42u64))
