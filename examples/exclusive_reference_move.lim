// Mutable handles transfer once; their pointee stays initialized in place.
#struct ExclusiveView () ((item (#ref-mut #u64)))

#fn main () #u64
    (#let-mut value #u64 40u64)
    (#let reference (#ref-mut #u64) (#borrow-mut value))
    (#let moved (#ref-mut #u64) reference)
    (#let view ExclusiveView (#struct-literal ExclusiveView ((item moved))))
    (#let extracted (#ref-mut #u64) (#get view item))
    (#forget view)
    (#deref-set extracted (#u64::add-wrap (#deref extracted) 2u64))
    (#let result #u64 (#deref extracted))
    (#forget extracted)
    (#return result)
