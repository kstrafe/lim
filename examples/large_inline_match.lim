(#fn main () #u64
  (#return
    (#match
      (#array (#array (#tuple #u128 #u64) 4)
        (#tuple 10u128 1u64)
        (#tuple 20u128 2u64)
        (#tuple 30u128 3u64)
        (#tuple 40u128 42u64))
      (#case (#array
        (#tuple _ _)
        (#tuple _ _)
        (#tuple _ _)
        (#tuple _ last))
       last)
      (#case _ 0u64))))
