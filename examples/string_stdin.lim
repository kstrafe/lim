(#std)

(#fn main () #u64
  (#let-mut line String (#call String-new (:)))
  (#let-mut finished #bool false)
  (#while (#bool.== finished false)
    (#match (#call std-read-line (: string (#borrow-mut line)))
      (#case (StdLineRead count)
        (#block
          (#assert (#i64.== (#println (#borrow line)) 0i64))
          (#call String-clear (: string (#borrow-mut line)))
          ()))
      (#case StdEndOfInput (#block (#set finished true) ()))
      (#case (StdReadFailed error) (#block (#set finished true) ()))))
  (#call String-free (: string line))
  (#return 42u64))
