(#alias lINUX-SYS-MMAP = ../library/linux_x86_64_syscall_numbers.lim::lINUX-SYS-MMAP)
(#alias lINUX-SYS-MUNMAP = ../library/linux_x86_64_syscall_numbers.lim::lINUX-SYS-MUNMAP)
(#alias linux-getpriority = ../library/linux_x86_64.lim::linux-getpriority)
(#alias linux-ioprio-get = ../library/linux_x86_64.lim::linux-ioprio-get)
(#alias linux-ioprio-set = ../library/linux_x86_64.lim::linux-ioprio-set)
(#alias linux-sched-getattr = ../library/linux_x86_64.lim::linux-sched-getattr)
(#alias linux-sched-getparam = ../library/linux_x86_64.lim::linux-sched-getparam)
(#alias linux-sched-getscheduler = ../library/linux_x86_64.lim::linux-sched-getscheduler)
(#alias linux-sched-setattr = ../library/linux_x86_64.lim::linux-sched-setattr)
(#alias linux-sched-setparam = ../library/linux_x86_64.lim::linux-sched-setparam)
(#alias linux-sched-setscheduler = ../library/linux_x86_64.lim::linux-sched-setscheduler)
(#alias linux-setpriority = ../library/linux_x86_64.lim::linux-setpriority)
(#alias linux-write-byte = ../library/linux_x86_64.lim::linux-write-byte)

(#fn main () #u64
  (#let memory (#ptr-mut #u64)
    (#unsafe (#linux-syscall (#ptr-mut #u64) lINUX-SYS-MMAP
      (0usize 4096usize 3u32 34u32 -1i64 0i64))))
  (#let after (#ptr-mut #u64) (#unsafe (#ptr-offset memory 8usize)))
  (#let-mut priority #i32 0i32)
  (#let parameters (#ptr-mut #i32) (#unsafe (#addr-of-mut priority)))
  (#let policy #i64 (#call linux-sched-getscheduler (: pid 0i64)))
  (#assert (#i64::ge policy 0i64))
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-sched-getparam (: pid 0i64 : scheduler-parameters parameters))) 0i64))
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-sched-setparam (: pid 0i32 : scheduler-parameters parameters))) 0i64))
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-sched-setparam (: pid -1i32 : scheduler-parameters parameters))) -22i64))
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-sched-setscheduler (: pid 0i32 : policy (#as policy #i32) : scheduler-parameters parameters))) 0i64))
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-sched-setscheduler (: pid 0i32 : policy 99i32 : scheduler-parameters parameters))) -22i64))
  (#assert (#i64::eq (#call linux-sched-getscheduler (: pid 0i64)) policy))
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-sched-getattr (: pid 0i64 : attributes memory : size 56u32 : flags 0u32))) 0i64))
  // Replay the current sched_attr instead of choosing a different policy.
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-sched-setattr (: pid 0i32 : attributes memory : flags 0u32))) 0i64))
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-sched-setattr (: pid 0i32 : attributes memory : flags 1u32))) -22i64))
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-sched-getattr (: pid 0i64 : attributes after : size 56u32 : flags 0u32))) 0i64))
  // Compare size/policy, flags, and nice/static-priority words.
  (#for-range (word #usize) 0usize 3usize
    (#assert (#u64::eq
      (#unsafe (#ptr-read (#ptr-offset memory word)))
      (#unsafe (#ptr-read (#ptr-offset after word))))))
  // The raw getpriority return is 20 - nice, unlike libc's return value.
  (#let raw-nice #i64 (#call linux-getpriority (: which 0i64 : who 0i64)))
  (#assert (#bool::and (#i64::gt raw-nice 0i64) (#i64::le raw-nice 40i64)))
  (#let nice #i32 (#as (#i64::sub-wrap 20i64 raw-nice) #i32))
  (#assert (#i64::eq (#call linux-setpriority (: which 0i32 : who 0u32 : priority nice)) 0i64))
  (#assert (#i64::eq (#call linux-setpriority (: which 99i32 : who 0u32 : priority nice)) -22i64))
  (#assert (#i64::eq (#call linux-getpriority (: which 0i64 : who 0i64)) raw-nice))
  (#let io-priority #i64 (#call linux-ioprio-get (: which 1i32 : who 0i32)))
  (#assert (#i64::ge io-priority 0i64))
  (#assert (#i64::eq (#call linux-ioprio-set (: which 1i32 : who 0i32 : priority (#as io-priority #i32))) 0i64))
  (#assert (#i64::eq (#call linux-ioprio-get (: which 1i32 : who 0i32)) io-priority))
  (#assert (#i64::eq (#call linux-ioprio-get (: which 99i32 : who 0i32)) -22i64))
  (#assert (#i64::eq (#call linux-ioprio-set (: which 99i32 : who 0i32 : priority (#as io-priority #i32))) -22i64))
  (#assert (#i64::eq (#unsafe (#linux-syscall #i64 lINUX-SYS-MUNMAP
    (memory 4096usize))) 0i64))
  (#let letter #u8 80u8)
  (#let newline #u8 10u8)
  (#assert (#i64::eq (#call linux-write-byte (: source (#borrow letter))) 1i64))
  (#assert (#i64::eq (#call linux-write-byte (: source (#borrow newline))) 1i64))
  (#return 42u64))
