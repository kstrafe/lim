(#import "../library/linux_x86_64.lim")

(#fn pointer-word ((pointer (#ptr-mut #u32))) #usize
  (#return (#unsafe (#asm #usize ((rdi pointer)) "mov rax, rdi"))))

; SAFETY: operation must be PR_GET_NAME/PR_SET_NAME and buffer must supply
; 16 writable/readable bytes respectively, without conflicting accesses.
(#unsafe-fn name-operation ((operation #i32) (buffer (#ptr-mut #u32))) #i64
  (#return (#unsafe (#unsafe-call linux-prctl (: option operation : arg2 (#call pointer-word (: pointer buffer)) : arg3 0usize : arg4 0usize : arg5 0usize)))))

(#fn main () #u64
  (#let memory (#ptr-mut #u32)
    (#unsafe (#linux-syscall (#ptr-mut #u32) lINUX-SYS-MMAP
      (0usize 4096usize 3u32 34u32 -1i64 0i64))))
  (#let capabilities (#ptr-mut #u32) (#unsafe (#ptr-offset memory 2usize)))
  (#let after (#ptr-mut #u32) (#unsafe (#ptr-offset memory 8usize)))
  ; Version zero asks the kernel to report its preferred capability ABI.
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-capget (: header memory : data capabilities))) -22i64))
  (#assert (#u32::eq (#unsafe (#ptr-read memory)) 537396514u32))
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-capget (: header memory : data capabilities))) 0i64))
  ; Reapply exactly the existing effective/permitted/inheritable sets.
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-capset (: header memory : data capabilities))) 0i64))
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-capget (: header memory : data after))) 0i64))
  (#for-range (word #usize) 0usize 6usize
    (#assert (#u32::eq
      (#unsafe (#ptr-read (#ptr-offset capabilities word)))
      (#unsafe (#ptr-read (#ptr-offset after word))))))
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-capset (: header (#ptr-null (#ptr-mut #u32)) : data capabilities))) -14i64))
  (#let fs-base (#ptr-mut #u32) (#unsafe (#ptr-offset memory 24usize)))
  (#let gs-base (#ptr-mut #u32) (#unsafe (#ptr-offset memory 26usize)))
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-arch-prctl (: operation 4099i32 : argument (#call pointer-word (: pointer fs-base))))) 0i64))
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-arch-prctl (: operation 4100i32 : argument (#call pointer-word (: pointer gs-base))))) 0i64))
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-arch-prctl (: operation -1i32 : argument 0usize))) -22i64))
  (#let original-name (#ptr-mut #u32) (#unsafe (#ptr-offset memory 32usize)))
  (#let requested-name (#ptr-mut #u32) (#unsafe (#ptr-offset memory 36usize)))
  (#let observed-name (#ptr-mut #u32) (#unsafe (#ptr-offset memory 40usize)))
  (#let restored-name (#ptr-mut #u32) (#unsafe (#ptr-offset memory 44usize)))
  (#unsafe (#asm () ((rdi requested-name)) "mov DWORD PTR [rdi], 0x006d694c"))
  (#assert (#i64::eq (#unsafe (#unsafe-call name-operation (: operation 16i32 : buffer original-name))) 0i64))
  (#assert (#i64::eq (#unsafe (#unsafe-call name-operation (: operation 15i32 : buffer requested-name))) 0i64))
  (#let queried #i64 (#unsafe (#unsafe-call name-operation (: operation 16i32 : buffer observed-name))))
  (#assert (#i64::eq (#unsafe (#unsafe-call name-operation (: operation 15i32 : buffer original-name))) 0i64))
  (#assert (#i64::eq queried 0i64))
  (#assert (#u32::eq (#unsafe (#ptr-read observed-name))
                   (#unsafe (#ptr-read requested-name))))
  (#assert (#i64::eq (#unsafe (#unsafe-call name-operation (: operation 16i32 : buffer restored-name))) 0i64))
  (#for-range (word #usize) 0usize 4usize
    (#assert (#u32::eq
      (#unsafe (#ptr-read (#ptr-offset original-name word)))
      (#unsafe (#ptr-read (#ptr-offset restored-name word))))))
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-prctl (: option -1i32 : arg2 0usize : arg3 0usize : arg4 0usize : arg5 0usize))) -22i64))
  (#let output (#ptr-mut #u8)
    (#unsafe (#asm (#ptr-mut #u8) ((rdi observed-name)) "mov rax, rdi")))
  (#assert (#i64::eq (#unsafe (#unsafe-call linux-write (: fd 1i64 : source output : count 3usize))) 3i64))
  (#let newline #u8 10u8)
  (#assert (#i64::eq (#call linux-write-byte (: source (#borrow newline))) 1i64))
  (#assert (#i64::eq (#unsafe (#linux-syscall #i64 lINUX-SYS-MUNMAP
    (memory 4096usize))) 0i64))
  (#return 42u64))
