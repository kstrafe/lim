; Validate once, then reuse that evidence across loop iterations.
(#struct User () (: ready #bool : data #u8))

(#fn validate (: user (#ref User)) #bool
  (#return (#get user ready)))

(#fn perform (: user (#ref User)) ()
  (#return ()))

(#fn process (: user (#ref User) : count #u8) #u8
  (#let-mut checked #bool false)
  (#let-mut remaining #u8 count)
  (#let-mut accepted #u8 0u8)
  (#label
    again
    (#while (#u8::gt remaining 0u8)
      (#if (#bool::not checked)
        (#block
          (#set checked (#call validate (: user user)))))
      (#if checked
        (#block
          (#call perform (: user user))
          (#set accepted (#u8::add-wrap accepted 1u8))))
      (#set remaining (#u8::sub-wrap remaining 1u8))))
  (#return accepted))

(#theorem cached-validation
  (#proof-loop-limit
    1
    (#proof-with-invariants
      (
        (process
          again
          (#proof-implies checked (#proof-validated (#parameter-of validate user) user))
          remaining))
      (#proof-requires-validation
        process
        (#parameter-of validate user)
        (#parameter-of perform user)))))

(#fn main () #u64
  (#let user User (#struct-literal User (: ready true : data 42u8)))
  (#let answer #u8 (#call process (: user (#borrow user) : count 42u8)))
  (#forget user)
  (#return (#as answer #u64)))
