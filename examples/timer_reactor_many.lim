; A bounded slice of borrowed timer owners can share one blocking poll call.
(#import "../library/timer_reactor1.lim")
(
  #fn
  main
  ()
  u64
  (
    #let
    created-a
    TimerCreate1
    (
      #call
      timer-reactor1-create
      (: nanoseconds 10000000u64)    )  )
  (
    #let-else
    (TimerCreated1 a)
    TimerCreate1
    created-a
    (#unreachable)
  )
  (
    #let
    created-b
    TimerCreate1
    (
      #call
      timer-reactor1-create
      (: nanoseconds 20000000u64)    )  )
  (
    #let-else
    (TimerCreated1 b)
    TimerCreate1
    created-b
    (#unreachable)
  )
  (
    #let
    created-c
    TimerCreate1
    (
      #call
      timer-reactor1-create
      (: nanoseconds 30000000u64)    )  )
  (
    #let-else
    (TimerCreated1 c)
    TimerCreate1
    created-c
    (#unreachable)
  )
  (
    #let
    duplicate-array
    (
      #array
      (#ref TimerReactor1)
      2
    )
    (
      #array-of
      (
        #array
        (#ref TimerReactor1)
        2
      )
      (#borrow a)
      (#borrow a)
    )
  )
  (
    #let
    duplicate-timers
    (
      #slice
      (#ref TimerReactor1)
    )
    (
      #slice-of
      (#borrow duplicate-array)
    )
  )
  (
    #let
    duplicate-result
    TimerManyWait
    (
      #call
      timer-reactor-many-wait
      (: timers duplicate-timers)    )  )
  (
    #assert
    (
      #match
      duplicate-result
      (
        #case
        (TimerManyFailed error)
        (
          #i64.==
          error
          (#literal i64 -22)
        )
      )
      (
        #case
        (TimerManyReady mask)
        false
      )
    )
  )
  (
    #let
    array
    (
      #array
      (#ref TimerReactor1)
      3
    )
    (
      #array-of
      (
        #array
        (#ref TimerReactor1)
        3
      )
      (#borrow a)
      (#borrow b)
      (#borrow c)
    )
  )
  (
    #let
    timers
    (
      #slice
      (#ref TimerReactor1)
    )
    (
      #slice-of
      (#borrow array)
    )
  )
  (
    #let
    wake
    TimerManyWait
    (
      #call
      timer-reactor-many-wait
      (: timers timers)    )  )
  (
    #let
    first-ready
    bool
    (
      #match
      wake
      (
        #case
        (TimerManyReady mask)
        (
          #u64.!=
          (
            #u64.&
            mask
            (#literal u64 1)
          )
          (#literal u64 0)
        )
      )
      (
        #case
        (TimerManyFailed error)
        false
      )
    )
  )
  (
    #let
    first-poll
    TimerPoll1
    (
      #call
      timer-reactor1-poll
      (: timer (#borrow a))    )  )
  (
    #let
    first-done
    bool
    (
      #match
      first-poll
      (
        #case
        (TimerReady1 count)
        (
          #u64.==
          count
          (#literal u64 1)
        )
      )
      (#case _ false)
    )
  )
  (
    #let
    closed-a
    i64
    (
      #call
      timer-reactor1-cancel
      (: timer a)    )  )
  (
    #let
    closed-b
    i64
    (
      #call
      timer-reactor1-cancel
      (: timer b)    )  )
  (
    #let
    closed-c
    i64
    (
      #call
      timer-reactor1-cancel
      (: timer c)    )  )
  (
    #return
    (
      #if
      (
        #bool.&&
        first-ready
        (
          #bool.&&
          first-done
          (
            #bool.&&
            (
              #i64.==
              closed-a
              (#literal i64 0)
            )
            (
              #bool.&&
              (
                #i64.==
                closed-b
                (#literal i64 0)
              )
              (
                #i64.==
                closed-c
                (#literal i64 0)
              )
            )
          )
        )
      )
      (#literal u64 42)
      (#literal u64 0)
    )
  ))
