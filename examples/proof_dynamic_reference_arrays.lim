; The weak helper contract preserves the index and conditional reference store.
(#struct Slot () (: reference (#ref #u8)))

(#fn replace-at (: slots (#ref-mut (#array Slot 2)) : index #usize : replace #bool : next (#ref #u8)) ()
  (#if replace
    (#deref-set
      (#borrow-mut (#index (#deref slots) index))
      (#struct-literal Slot (: reference next)))
    ())
  (#return ()))

(#theorem replace-at-contract
  (#proof-contract replace-at (#usize::lt index 2usize) true))

(#fn read-updated (: index #usize : replace #bool : left #u8 : right #u8 : next #u8) (#tuple #u8 #u8)
  (#let-mut slots (#array Slot 2)
    (#array-of
      (#array Slot 2)
      (#struct-literal Slot (: reference (#borrow left)))
      (#struct-literal Slot (: reference (#borrow right)))))
  (#call replace-at
    (: slots (#borrow-mut slots) : index index : replace replace : next (#borrow next)))
  (#return
    (#tuple
      (#tuple #u8 #u8)
      (#deref (#get (#index slots 0usize) reference))
      (#deref (#get (#index slots 1usize) reference)))))

(#theorem selected-and-sibling
  (#proof-using
    (replace-at-contract)
    (#proof-contract
      read-updated
      (#usize::lt index 2usize)
      (#proof-and
        (#proof-eq
          (#get (#proof-result) 0)
          (#if (#bool::and replace (#usize::eq index 0usize))
            next
            left))
        (#proof-eq
          (#get (#proof-result) 1)
          (#if (#bool::and replace (#usize::eq index 1usize))
            next
            right))))))

(#fn main () #u64
  (#let result (#tuple #u8 #u8)
    (#call read-updated (: index 1usize : replace true : left 4u8 : right 7u8 : next 42u8)))
  (#return
    (#u64::add-wrap (#u64::mul-wrap (#as (#get result 0) #u64) 10u64) (#as (#get result 1) #u64))))
