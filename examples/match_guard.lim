#enum Maybe () ((Maybe.Some #u64) Maybe.None)

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let value Maybe (Maybe.Some 42))
    (#return
      (#match value
        (#case (Maybe.Some payload) (#when (#u64::gt-wrap payload 40))
          (#u64::add-wrap payload 8))
        (#case (Maybe.Some _) 0)
        (#case Maybe.None 0)))
  );
}
