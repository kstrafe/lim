; Accessibility says that every predecessor is accessible. A child function
; takes a predecessor and relation evidence, returning its accessibility proof.
(#math-inductive accessible (u)
  ((A (#pt-type u)) (relation (#pt-pi ((from A) (to A)) #pt-prop)))
  (#indices
    (#parameter at A))
  #pt-prop
  (
    (intro
      (
        (point A)
        (lower
          (#pt-pi ((previous A) (edge (#pt-app relation previous point))) (#pt-self-at (previous)))))
      (point))))
; An accessible point cannot have a self edge. The IH is pointwise over both
; the predecessor and edge evidence, at the predecessor's actual index.
(#theorem accessible-no-self-edge
  (#universes u)
  (#parameters
    (#parameter A (#pt-type u))
    (#parameter relation (#pt-pi ((from A) (to A)) #pt-prop))
    (#parameter point A)
    (#parameter proof (#pt-app (#pt-use accessible (u)) A relation point)))
  (#statement (#pt-pi ((loop (#pt-app relation point point))) #pt-false))
  (#proof
    (#pt-induct
      accessible
      (u)
      (A relation)
      (#indices point)
      (#pt-lambda
        ((index A) (accessible-proof (#pt-app (#pt-use accessible (u)) A relation index)))
        (#pt-pi ((self-edge (#pt-app relation index index))) #pt-false))
      (
        (#pt-lambda
          (
            (current A)
            (lower
              (#pt-pi
                ((previous A) (edge (#pt-app relation previous current)))
                (#pt-app (#pt-use accessible (u)) A relation previous)))
            (ih
              (#pt-pi
                ((previous A) (edge (#pt-app relation previous current)))
                (#pt-pi ((self-edge (#pt-app relation previous previous))) #pt-false))))
          (#pt-lambda ((loop (#pt-app relation current current))) (#pt-app ih current loop loop))))
      proof)))
; The point field is exposed as the result index, and lower is proof-valued.
; Eliminating this proposition into data reveals no hidden constructor data.
(#math-definition well-founded-recursion (u v)
  (#pt-pi
    (
      (A (#pt-type u))
      (relation (#pt-pi ((from A) (to A)) #pt-prop))
      (motive (#pt-pi ((index A)) (#pt-type v)))
      (step
        (#pt-pi
          (
            (current A)
            (lower-results
              (#pt-pi
                ((previous A) (edge (#pt-app relation previous current)))
                (#pt-app motive previous))))
          (#pt-app motive current)))
      (point A)
      (proof (#pt-app (#pt-use accessible (u)) A relation point)))
    (#pt-app motive point))
  (#pt-lambda
    (
      (A (#pt-type u))
      (relation (#pt-pi ((from A) (to A)) #pt-prop))
      (motive (#pt-pi ((index A)) (#pt-type v)))
      (step
        (#pt-pi
          (
            (current A)
            (lower-results
              (#pt-pi
                ((previous A) (edge (#pt-app relation previous current)))
                (#pt-app motive previous))))
          (#pt-app motive current)))
      (point A)
      (proof (#pt-app (#pt-use accessible (u)) A relation point)))
    (#pt-induct
      accessible
      (u)
      (A relation)
      (#indices point)
      (#pt-lambda
        ((index A) (accessible-proof (#pt-app (#pt-use accessible (u)) A relation index)))
        (#pt-app motive index))
      (
        (#pt-lambda
          (
            (current A)
            (lower
              (#pt-pi
                ((previous A) (edge (#pt-app relation previous current)))
                (#pt-app (#pt-use accessible (u)) A relation previous)))
            (ih
              (#pt-pi
                ((previous A) (edge (#pt-app relation previous current)))
                (#pt-app motive previous))))
          (#pt-app step current ih)))
      proof)))
; A generic defining equation, checked for arbitrary domains, relations,
; dependent motives, steps, and predecessor proof functions.
(#theorem well-founded-recursion-unfolds
  (#universes u v)
  (#parameters
    (#parameter A (#pt-type u))
    (#parameter relation (#pt-pi ((from A) (to A)) #pt-prop))
    (#parameter motive (#pt-pi ((index A)) (#pt-type v)))
    (#parameter step (#pt-pi ((current A) (lower-results (#pt-pi ((previous A) (edge (#pt-app relation previous current))) (#pt-app motive previous)))) (#pt-app motive current)))
    (#parameter point A)
    (#parameter lower (#pt-pi ((previous A) (edge (#pt-app relation previous point))) (#pt-app (#pt-use accessible (u)) A relation previous))))
  (#statement
    (#pt-eq
      (#pt-app motive point)
      (#pt-app
        (#pt-use well-founded-recursion (u v))
        A
        relation
        motive
        step
        point
        (#pt-construct accessible (u) (A relation) intro (point lower)))
      (#pt-app
        step
        point
        (#pt-lambda
          ((previous A) (edge (#pt-app relation previous point)))
          (#pt-app
            (#pt-use well-founded-recursion (u v))
            A
            relation
            motive
            step
            previous
            (#pt-app lower previous edge))))))
  (#proof
    (#pt-refl
      (#pt-app motive point)
      (#pt-app
        step
        point
        (#pt-lambda
          ((previous A) (edge (#pt-app relation previous point)))
          (#pt-app
            (#pt-use well-founded-recursion (u v))
            A
            relation
            motive
            step
            previous
            (#pt-app lower previous edge)))))))
; Every point is accessible when the predecessor relation is False. This
; builds an actual proof; it does not introduce an axiom or assume a witness.
(#math-definition no-predecessors (u)
  (#pt-pi
    ((A (#pt-type u)) (point A))
    (#pt-app (#pt-use accessible (u)) A (#pt-lambda ((from A) (to A)) #pt-false) point))
  (#pt-lambda
    ((A (#pt-type u)) (point A))
    (#pt-construct
      accessible
      (u)
      (A (#pt-lambda ((from A) (to A)) #pt-false))
      intro
      (point
        (#pt-lambda
          ((previous A) (edge #pt-false))
          (#pt-induct
            #pt-false
            ()
            ()
            (#pt-lambda
              ((impossible #pt-false))
              (#pt-app (#pt-use accessible (u)) A (#pt-lambda ((from A) (to A)) #pt-false) previous))
            ()
            edge))))))
; Computation through the constructed accessibility proof returns a data
; value. This equation holds for every mathematical natural number.
(#theorem empty-relation-recursion-computes
  (#universes)
  (#parameters
    (#parameter value #pt-nat))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app
        (#pt-use well-founded-recursion (0 0))
        #pt-nat
        (#pt-lambda ((from #pt-nat) (to #pt-nat)) #pt-false)
        (#pt-lambda ((index #pt-nat)) #pt-nat)
        (#pt-lambda
          ((current #pt-nat) (lower-results (#pt-pi ((previous #pt-nat) (edge #pt-false)) #pt-nat)))
          (#pt-succ current))
        value
        (#pt-app (#pt-use no-predecessors (0)) #pt-nat value))
      (#pt-succ value)))
  (#proof (#pt-refl #pt-nat (#pt-succ value))))

(#fn main () #u64
  (#return 42u64))
