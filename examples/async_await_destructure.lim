; Await an aggregate, destructure it, then keep its leaves through another await.
(#struct Values ((z (#tuple #u16 #u16)) (a #u64)))
(#enum InputTask ((InputStart Values) (InputResume Values)))
(#enum InputPoll ((InputPending InputTask) (InputReady Values)))
(#fn input-poll ((task InputTask) (waker (#ref #u64))) InputPoll
  (#return (#match task
    (#case (InputStart values) (InputPending (InputResume values)))
    (#case (InputResume values) (InputReady values)))))
(#enum Step ((Start #u64) (Resume #u64)))
(#enum StepPoll ((StepPending Step) (StepReady #u64)))
(#fn step-poll ((task Step) (waker (#ref #u64))) StepPoll
  (#return (#match task
    (#case (Start value) (StepPending (Resume value)))
    (#case (Resume value) (StepReady value)))))

(@#async-fn ( : protocol WorkAwait : waker #u64 : function
  (#fn work ((values Values)) #u64
    (#let (Values (#tuple left right) bias) Values
      (#await Values InputTask InputPending InputReady input-poll (InputStart values)))
    (#let second #u64
      (#await #u64 Step StepPending StepReady step-poll (Start (#as right #u64))))
    (#return (#u64.+.wrap (#u64.+.wrap (#as left #u64) second) bias)))))

(#fn main () #u64
  (#let waker #u64 0u64)
  (#let-mut task work-task
    (#call work (: values
      (#struct-literal Values (: a 22u64 : z (#tuple (#tuple #u16 #u16) 9u16 11u16))))))
  (#for-range (attempt #u64) 0u64 4u64
    (#let result work-poll-result (#call work-poll (: task task : waker (#borrow waker))))
    (#match result
      (#case (work-pending next) (#block (#set task next) ()))
      (#case (work-ready value) (#block (#return value)))))
  (#forget task)
  (#return (#unreachable)))
