; Proofs are checked at compile time and emit no runtime instructions.
(#fn leaf () #u64
  (#return 42u64))

(#fn answer () #u64
  (#return (#call leaf ())))

(#theorem direct-call
  (#proof-calls-directly answer leaf))
(#theorem transitive-call
  (#proof-calls-transitively main leaf))
(#theorem wrapping-addition-commutes
  (#proof-for-all
    ((left #u8) (right #u8))
    (#proof-eq (#u8::add-wrap left right) (#u8::add-wrap right left))))
(#theorem increment-is-safe
  (#proof-for-all
    ((input #u8))
    (#proof-implies (#u8::lt input 255u8) (#proof-no-overflow #u8::add-wrap input 1u8))))

(#fn identity ((value #u8)) #u8
  (#return value))

(#theorem identity-contract
  (#proof-contract identity true (#proof-eq (#proof-result) (#proof-old value))))

(#fn validate (: input #u64) #bool
  (#return (#u64::eq input 42u64)))

(#fn perform (: input #u64) #u64
  (#return input))

(#fn guarded (: input #u64) #u64
  (#if (#bool::not (#call validate (($ input))))
    (#block
      (#return 0u64)))
  (#return (#call perform (($ input)))))
; On every execution where validation returns false, perform is never called.

(#theorem validation-gates-action
  (#proof-calls-when guarded validate false perform))

(#fn countdown (: count #u8) #u8
  (#let-mut remaining #u8 count)
  (#label
    again
    (#while (#u8::gt remaining 0u8)
      (#set remaining (#u8::sub-wrap remaining 1u8))))
  (#return remaining))
; Prove termination and the result without unrolling up to 255 iterations.

(#theorem countdown-contract
  (#proof-with-invariants
    ((countdown again true remaining))
    (#proof-contract countdown true (#proof-eq (#proof-result) 0u8))))

(#fn main () #u64
  (#return (#call guarded (: input (#call answer ())))))
