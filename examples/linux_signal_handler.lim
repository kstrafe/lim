#alias lINUX-SYS-RT-SIGPROCMASK = ../library/linux_x86_64_syscall_numbers.lim::lINUX-SYS-RT-SIGPROCMASK
#alias lINUX-SYS-RT-SIGRETURN = ../library/linux_x86_64_syscall_numbers.lim::lINUX-SYS-RT-SIGRETURN
#alias lINUX-SYS-SIGALTSTACK = ../library/linux_x86_64_syscall_numbers.lim::lINUX-SYS-SIGALTSTACK
#alias lINUX-SYS-WRITE = ../library/linux_x86_64_syscall_numbers.lim::lINUX-SYS-WRITE
#alias linux-getpid = ../library/linux_x86_64.lim::linux-getpid
#alias linux-gettid = ../library/linux_x86_64.lim::linux-gettid
#alias linux-getuid = ../library/linux_x86_64.lim::linux-getuid
#alias linux-mmap = ../library/linux_x86_64.lim::linux-mmap
#alias linux-munmap = ../library/linux_x86_64.lim::linux-munmap
#alias linux-rt-sigaction = ../library/linux_x86_64.lim::linux-rt-sigaction
#alias linux-rt-sigpending = ../library/linux_x86_64.lim::linux-rt-sigpending
#alias linux-rt-sigprocmask = ../library/linux_x86_64.lim::linux-rt-sigprocmask
#alias linux-rt-sigsuspend = ../library/linux_x86_64.lim::linux-rt-sigsuspend
#alias linux-sigaltstack = ../library/linux_x86_64.lim::linux-sigaltstack
#alias linux-tkill = ../library/linux_x86_64.lim::linux-tkill
#alias linux-write-byte = ../library/linux_x86_64.lim::linux-write-byte

// SAFETY: memory is this example's live 69632-byte mapping. The first page
// contains records; the following 64 KiB is the installed alternate stack.
// Call only after synchronous completion of a delivered SIGUSR1 handler.
#unsafe-fn check-handler {
  #params = ((memory (#ptr-mut #u8)) (count #u64));
  #returns = ();
  #effects = (#global-access #io);
  #body = (
    (#assert (#unsafe (#asm #bool ((rdi memory) (rsi count))
      "cmp QWORD PTR [rdi+272], rsi\nsete al\nmovzx eax, al")))
    // The actual entry RSP must be inside the alternate stack, not merely a
    // stack_t record claiming that one was configured.
    (#assert (#unsafe (#asm #bool ((rdi memory))
      "lea rdx, [rdi+4096]\nmov rcx, QWORD PTR [rdi+256]\ncmp rcx, rdx\nsetae al\nadd rdx, 65536\ncmp rcx, rdx\nsetb dl\nand al, dl\nmovzx eax, al")))
    (#assert (#unsafe (#asm #bool ((rdi memory))
      "cmp DWORD PTR [rdi+264], 10\nsete al\ncmp DWORD PTR [rdi+280], 10\nsete dl\nand al, dl\ncmp DWORD PTR [rdi+284], -6\nsete dl\nand al, dl\nmovzx eax, al")))
    // sigaltstack succeeds inside the handler, reports SS_ONSTACK, and rejects
    // disabling an actively used alternate stack with EPERM.
    (#assert (#unsafe (#asm #bool ((rdi memory))
      "cmp QWORD PTR [rdi+288], 0\nsete al\ncmp DWORD PTR [rdi+72], 1\nsete dl\nand al, dl\ncmp QWORD PTR [rdi+296], -1\nsete dl\nand al, dl\ncmp QWORD PTR [rdi+304], 2\nsete dl\nand al, dl\nmovzx eax, al")))
    // The running handler blocks both itself and SIGUSR2 from sa_mask.
    (#assert (#unsafe (#asm #bool ((rdi memory))
      "cmp QWORD PTR [rdi+392], 0\nsete al\nmov rdx, QWORD PTR [rdi+384]\nand edx, 2560\ncmp edx, 2560\nsete dl\nand al, dl\nmovzx eax, al")))
    (#return ())
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #effects = (#global-access #io (#effects-of check-handler) (#effects-of linux-getpid) (#effects-of linux-gettid) (#effects-of linux-getuid) (#effects-of linux-mmap) (#effects-of linux-munmap) (#effects-of linux-rt-sigaction) (#effects-of linux-rt-sigpending) (#effects-of linux-rt-sigprocmask) (#effects-of linux-rt-sigsuspend) (#effects-of linux-sigaltstack) (#effects-of linux-tkill) (#effects-of linux-write-byte));
  #body = (
    (#let memory (#ptr-mut #u8) (#unsafe (#unsafe-call linux-mmap ((address (#ptr-null (#ptr-mut #u8))) (length 69632usize) (protection 3u32) (flags 34u32) (fd -1i64) (offset 0i64)))))
    (#assert (#unsafe (#asm #bool ((rdi memory))
      "cmp rdi, -4095\nsetb al\nmovzx eax, al")))
    (#let words (#ptr-mut #i64) (#unsafe (#asm (#ptr-mut #i64)
      ((rdi memory)) "mov rax, rdi")))
    (#let null (#ptr-mut #u8) (#ptr-null (#ptr-mut #u8)))
    (#let null-word (#ptr-mut #i64) (#ptr-null (#ptr-mut #i64)))
    (#let requested (#ptr-mut #u8) (#unsafe (#ptr-offset memory 32usize)))
    (#let action (#ptr-mut #i64) (#unsafe (#ptr-offset words 16usize)))
    (#let original-action (#ptr-mut #i64) (#unsafe (#ptr-offset words 20usize)))
    (#let original-mask (#ptr-mut #i64) (#unsafe (#ptr-offset words 28usize)))
    (#let blocked-mask (#ptr-mut #i64) (#unsafe (#ptr-offset words 29usize)))
    (#let unblocked-mask (#ptr-mut #i64) (#unsafe (#ptr-offset words 30usize)))
    (#let observed-mask (#ptr-mut #i64) (#unsafe (#ptr-offset words 31usize)))
    (#let pending (#ptr-mut #i64) (#unsafe (#ptr-offset words 51usize)))
    (#let thread #i32 (#as (#call linux-gettid ()) #i32))
    (#let process #i64 (#call linux-getpid ()))
    (#let uid #i64 (#call linux-getuid ()))

    // The callback is raw Linux x86-64 code, not a Lim function pointer. Its
    // SA_SIGINFO third argument points to ucontext: uc_stack.ss_sp is at +16.
    // This recovers our record page without global mutable data. Numeric local
    // labels keep both callback addresses local to this assembly block.
    // Pin the four literal callback syscall numbers against the ABI catalog.
    (#assert (#usize::eq lINUX-SYS-WRITE 1usize))
    (#assert (#usize::eq lINUX-SYS-RT-SIGPROCMASK 14usize))
    (#assert (#usize::eq lINUX-SYS-RT-SIGRETURN 15usize))
    (#assert (#usize::eq lINUX-SYS-SIGALTSTACK 131usize))
    (#unsafe (#asm () ((rdi memory))
      "jmp 3f\n1:\nmov r8, QWORD PTR [rdx+16]\nsub r8, 4096\nmov QWORD PTR [r8+256], rsp\nmov DWORD PTR [r8+264], edi\ninc QWORD PTR [r8+272]\nmov eax, DWORD PTR [rsi]\nmov DWORD PTR [r8+280], eax\nmov eax, DWORD PTR [rsi+8]\nmov DWORD PTR [r8+284], eax\nmov rax, QWORD PTR [rsi+16]\nmov QWORD PTR [r8+352], rax\nadd edi, 62\nmov bYTE PTR [r8+312], dil\nmov bYTE PTR [r8+313], 10\nmov eax, 131\nxor edi, edi\nlea rsi, [r8+64]\nsyscall\nmov QWORD PTR [r8+288], rax\nmov eax, 131\nlea rdi, [r8+320]\nxor esi, esi\nsyscall\nmov QWORD PTR [r8+296], rax\nmov eax, 14\nmov edi, 2\nxor esi, esi\nlea rdx, [r8+384]\nmov r10d, 8\nsyscall\nmov QWORD PTR [r8+392], rax\nmov eax, 1\nmov edi, 1\nlea rsi, [r8+312]\nmov edx, 2\nsyscall\nmov QWORD PTR [r8+304], rax\nret\n2:\nmov eax, 15\nsyscall\nud2\n3:\nlea rax, [rip+1b]\nmov QWORD PTR [rdi+128], rax\nmov QWORD PTR [rdi+136], 0x0c000004\nlea rax, [rip+2b]\nmov QWORD PTR [rdi+144], rax\nmov QWORD PTR [rdi+152], 2048\nlea rax, [rdi+4096]\nmov QWORD PTR [rdi+32], rax\nmov QWORD PTR [rdi+48], 65536\nmov DWORD PTR [rdi+328], 2"))
    // Flags: SA_SIGINFO | SA_RESTORER | SA_ONSTACK. The restorer enters syscall
    // 15 at the kernel's signal-frame stack position; an ordinary Lim function
    // wrapper would add its own prologue and is not a valid substitute.
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-rt-sigprocmask ((how 2usize) (signal-set null-word) (old-set original-mask) (sigset-size 8usize)))) 0i64))
    (#unsafe (#block
      (#ptr-write blocked-mask (#i64::bit-or (#ptr-read original-mask) 512i64))
      (#ptr-write unblocked-mask (#i64::bit-and (#ptr-read original-mask) -513i64))))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-rt-sigprocmask ((how 2usize) (signal-set blocked-mask) (old-set null-word) (sigset-size 8usize)))) 0i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-sigaltstack ((new-stack requested) (old-stack memory)))) 0i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-rt-sigaction ((signal 10i64) (action action) (old-action original-action) (sigset-size 8usize)))) 0i64))

    // Invalid mask size and unreadable mask fail without sleeping or delivery.
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-rt-sigsuspend ((signal-set unblocked-mask) (sigset-size 4usize)))) -22i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-rt-sigsuspend ((signal-set null-word) (sigset-size 8usize)))) -14i64))
    // First delivery is unblocked and synchronous with the self-tkill return.
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-rt-sigprocmask ((how 2usize) (signal-set unblocked-mask) (old-set null-word) (sigset-size 8usize)))) 0i64))
    (#assert (#i64::eq (#call linux-tkill ((thread thread) (signal 10i32))) 0i64))
    (#unsafe (#unsafe-call check-handler ((memory memory) (count 1u64))))
    // Second delivery is held pending until sigsuspend atomically replaces the
    // mask. No sleep or cross-process scheduling assumption is needed.
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-rt-sigprocmask ((how 2usize) (signal-set blocked-mask) (old-set null-word) (sigset-size 8usize)))) 0i64))
    (#assert (#i64::eq (#call linux-tkill ((thread thread) (signal 10i32))) 0i64))
    (#assert (#u64::eq (#unsafe (#asm #u64 ((rdi memory))
      "mov rax, QWORD PTR [rdi+272]")) 1u64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-rt-sigpending ((signal-set pending) (sigset-size 8usize)))) 0i64))
    (#assert (#i64::eq (#i64::bit-and (#unsafe (#ptr-read pending)) 512i64) 512i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-rt-sigsuspend ((signal-set unblocked-mask) (sigset-size 8usize)))) -4i64))
    (#unsafe (#unsafe-call check-handler ((memory memory) (count 2u64))))
    (#assert (#unsafe (#asm #bool ((rdi memory) (rsi process) (rdx uid))
      "cmp DWORD PTR [rdi+352], esi\nsete al\ncmp DWORD PTR [rdi+356], edx\nsete dl\nand al, dl\nmovzx eax, al")))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-rt-sigprocmask ((how 2usize) (signal-set null-word) (old-set observed-mask) (sigset-size 8usize)))) 0i64))
    (#assert (#i64::eq (#unsafe (#ptr-read observed-mask)) (#unsafe (#ptr-read blocked-mask))))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-rt-sigpending ((signal-set pending) (sigset-size 8usize)))) 0i64))
    (#assert (#i64::eq (#i64::bit-and (#unsafe (#ptr-read pending)) 512i64) 0i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-sigaltstack ((new-stack null) (old-stack (#ptr-offset memory 96usize))))) 0i64))
    (#assert (#u32::eq (#unsafe (#asm #u32 ((rdi memory))
      "mov eax, DWORD PTR [rdi+104]")) 0u32))

    // Keep SIGUSR1 blocked until the old action and stack have been restored.
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-rt-sigaction ((signal 10i64) (action original-action) (old-action null-word) (sigset-size 8usize)))) 0i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-rt-sigaction ((signal 10i64) (action null-word) (old-action (#ptr-offset words 24usize)) (sigset-size 8usize)))) 0i64))
    (#for-range (slot #usize) 0usize 4usize
      (#assert (#i64::eq
        (#unsafe (#ptr-read (#ptr-offset original-action slot)))
        (#unsafe (#ptr-read (#ptr-offset words (#usize::add-wrap 24usize slot)))))))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-sigaltstack ((new-stack memory) (old-stack null)))) 0i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-sigaltstack ((new-stack null) (old-stack (#ptr-offset memory 96usize))))) 0i64))
    (#for-range (slot #usize) 0usize 24usize
      (#if (#bool::or (#usize::lt slot 12usize) (#usize::ge slot 16usize))
        (#assert (#u8::eq
          (#unsafe (#ptr-read (#ptr-offset memory slot)))
          (#unsafe (#ptr-read (#ptr-offset memory (#usize::add-wrap 96usize slot)))))) ()))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-rt-sigprocmask ((how 2usize) (signal-set original-mask) (old-set null-word) (sigset-size 8usize)))) 0i64))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-rt-sigprocmask ((how 2usize) (signal-set null-word) (old-set observed-mask) (sigset-size 8usize)))) 0i64))
    (#assert (#i64::eq (#unsafe (#ptr-read observed-mask)) (#unsafe (#ptr-read original-mask))))
    (#assert (#i64::eq (#unsafe (#unsafe-call linux-munmap ((address memory) (length 69632usize)))) 0i64))
    (#let letter #u8 83u8)
    (#let newline #u8 10u8)
    (#assert (#i64::eq (#call linux-write-byte ((source (#borrow letter)))) 1i64))
    (#assert (#i64::eq (#call linux-write-byte ((source (#borrow newline)))) 1i64))
    (#return 42u64)
  );
}
