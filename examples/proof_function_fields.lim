; Children may be a function, provided the recursive type occurs only in
; its result. No function domain may mention the type being declared.
(#math-inductive fan ()
  ()
  (#pt-type 0)
  ((leaf ()) (node ((children (#pt-pi ((key #pt-nat)) #pt-self))))))
; Follow the child at zero. The pointwise IH is itself a function: ih key
; gives the recursively computed result for children key.
(#math-definition fan-depth ()
  (#pt-pi ((tree (#pt-use fan ()))) #pt-nat)
  (#pt-lambda
    ((tree (#pt-use fan ())))
    (#pt-induct
      fan
      ()
      ()
      (#pt-lambda ((value (#pt-use fan ()))) #pt-nat)
      (#pt-zero
        (#pt-lambda
          (
            (children (#pt-pi ((key #pt-nat)) (#pt-use fan ())))
            (ih (#pt-pi ((key #pt-nat)) #pt-nat)))
          (#pt-succ (#pt-app ih #pt-zero))))
      tree)))
; The equation holds for every child function, not a finite sample of keys.
(#theorem fan-node-depth
  (#universes)
  (#parameters
    (#parameter children (#pt-pi ((key #pt-nat)) (#pt-use fan ()))))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use fan-depth ()) (#pt-construct fan () () node (children)))
      (#pt-succ (#pt-app (#pt-use fan-depth ()) (#pt-app children #pt-zero)))))
  (#proof
    (#pt-refl #pt-nat (#pt-succ (#pt-app (#pt-use fan-depth ()) (#pt-app children #pt-zero))))))

(#fn main () #u64
  (#return 42u64))
