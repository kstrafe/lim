(#struct BigValues () (: first #u64 : second #u64 : third #u64 : fourth #u64
  : fifth #u64 : sixth #u64 : seventh #u64))
(#enum LargePayload () ((LargePayload.Big BigValues) LargePayload.Empty))

(#fn make ((last #u64)) LargePayload
  (#return (LargePayload.Big (#struct-literal BigValues
    (: first 1u64 : second 2u64 : third 3u64 : fourth 4u64 : fifth 5u64 : sixth 6u64 : seventh last)))))

(#fn main () #u64
  (#return
    (#match (#call make (: last 42u64))
      (#case (LargePayload.Big values) (#get values seventh))
      (#case LargePayload.Empty 0u64))))
