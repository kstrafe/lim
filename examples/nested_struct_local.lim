#struct Inner () ((left #u64) (right #u64))
#struct Outer () ((inner Inner) (tail #u64))

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let value Outer (#struct-literal Outer
        ((inner (#struct-literal Inner ((left 10) (right 20)))) (tail 32))))
    (#return (#get value tail))
  );
}
