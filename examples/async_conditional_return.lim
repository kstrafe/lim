; A returning branch and the common tail each have their own suspension.
(#enum Child ((Waiting #u64) (Resume #u64)))
(#linear Child)
(#enum ChildPoll ((ChildPending Child) (ChildReady #u64)))
(#fn child-poll ((task Child) (waker (#ref #u64))) ChildPoll
  (#return (#match task
    (#case (Waiting value) (ChildPending (Resume value)))
    (#case (Resume value) (ChildReady value)))))

(@async-fn ( : protocol WorkAwait : waker #u64 : function
  (#fn work ((early #bool)) #u64
    (#if early
      (#block
        (#let first #u64 (#await #u64 Child ChildPending ChildReady child-poll (Waiting 7u64)))
        (#return first))
      ())
    (#let result #u64 (#await #u64 Child ChildPending ChildReady child-poll (Waiting 42u64)))
    (#return result))))

(#fn run ((early #bool) (waker (#ref #u64))) #u64
  (#let first work-poll-result (#call work-poll (: task (#call work (: early early)) : waker waker)))
  (#let-else (work-pending task) work-poll-result first (#unreachable))
  (#let second work-poll-result (#call work-poll (: task task : waker waker)))
  (#return (#match second
    (#case (work-ready value) value)
    (#case (work-pending unexpected) (#block (#forget unexpected) (#unreachable))))))

(#fn main () #u64
  (#let waker #u64 0u64)
  (#let early #u64 (#call run (: early true : waker (#borrow waker))))
  (#let later #u64 (#call run (: early false : waker (#borrow waker))))
  (#return (#u64.+.wrap early later)))
