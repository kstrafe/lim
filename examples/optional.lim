(@optional u64 Maybe?)

(
  #fn
  identity
  (
    (value Maybe?)
  )
  Maybe?
  (#return value)
)

(
  #fn
  main
  ()
  u64
  (
    #let
    value
    Maybe?
    (
      identity
      (Maybe?-construct 42)
    )
  )
  (
    #return
    (
      #if
      (Maybe?-is-some (#clone value))
      (Maybe?-unwrap-or value 0)
      0
    )
  )
)
