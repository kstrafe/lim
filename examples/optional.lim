(@optional u64 Maybe?)

(
  #fn
  identity
  (
    (value Maybe?)
  )
  Maybe?
  (#return value)
)

(
  #fn
  main
  ()
  u64
  (
    #let
    value
    Maybe?
    (#call identity (#fn-args (value (#call Maybe?-construct (#fn-args (value 42))))))
  )
  (
    #return
    (
      #if
      (#call Maybe?-is-some (#fn-args (value (#clone value))))
      (#call Maybe?-unwrap-or (#fn-args (value value) (fallback 0)))
      0
    )
  )
)
