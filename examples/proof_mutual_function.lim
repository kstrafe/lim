; Pointwise recursive hypotheses use each child's family and actual index.
(#math-inductive left ()
  ()
  (#mutual left right)
  (#indices
    (#parameter n #pt-nat))
  (#pt-type 0)
  ((with-children ((children (#pt-pi ((key #pt-nat)) (#pt-recur right (key))))) (#pt-zero))))
(#math-inductive right ()
  ()
  (#mutual left right)
  (#indices
    (#parameter n #pt-nat))
  (#pt-type 0)
  ((leaf ((key #pt-nat)) (key))))
(#math-definition left-count ()
  (#pt-pi ((index #pt-nat) (value (#pt-app (#pt-use left ()) index))) #pt-nat)
  (#pt-lambda
    ((index #pt-nat) (value (#pt-app (#pt-use left ()) index)))
    (#pt-mutual-induct
      left
      ()
      ()
      (#indices index)
      (
        (left
          (#pt-lambda ((at #pt-nat) (subject (#pt-app (#pt-use left ()) at))) #pt-nat)
          (
            (#pt-lambda
              (
                (children (#pt-pi ((key #pt-nat)) (#pt-app (#pt-use right ()) key)))
                (ih (#pt-pi ((key #pt-nat)) #pt-nat)))
              (#pt-succ (#pt-app ih #pt-zero)))))
        (right
          (#pt-lambda ((at #pt-nat) (subject (#pt-app (#pt-use right ()) at))) #pt-nat)
          ((#pt-lambda ((key #pt-nat)) key))))
      value)))
(#math-definition right-count ()
  (#pt-pi ((index #pt-nat) (value (#pt-app (#pt-use right ()) index))) #pt-nat)
  (#pt-lambda
    ((index #pt-nat) (value (#pt-app (#pt-use right ()) index)))
    (#pt-mutual-induct
      right
      ()
      ()
      (#indices index)
      (
        (left
          (#pt-lambda ((at #pt-nat) (subject (#pt-app (#pt-use left ()) at))) #pt-nat)
          (
            (#pt-lambda
              (
                (children (#pt-pi ((key #pt-nat)) (#pt-app (#pt-use right ()) key)))
                (ih (#pt-pi ((key #pt-nat)) #pt-nat)))
              (#pt-succ (#pt-app ih #pt-zero)))))
        (right
          (#pt-lambda ((at #pt-nat) (subject (#pt-app (#pt-use right ()) at))) #pt-nat)
          ((#pt-lambda ((key #pt-nat)) key))))
      value)))
(#theorem pointwise-mutual-ih
  (#universes)
  (#parameters
    (#parameter children (#pt-pi ((key #pt-nat)) (#pt-app (#pt-use right ()) key))))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use left-count ()) #pt-zero (#pt-construct left () () with-children (children)))
      (#pt-succ (#pt-app (#pt-use right-count ()) #pt-zero (#pt-app children #pt-zero)))))
  (#proof
    (#pt-refl
      #pt-nat
      (#pt-succ (#pt-app (#pt-use right-count ()) #pt-zero (#pt-app children #pt-zero))))))
(#theorem functional-mutual-computes
  (#universes)
  (#parameters)
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app
        (#pt-use left-count ())
        #pt-zero
        (#pt-construct
          left
          ()
          ()
          with-children
          ((#pt-lambda ((key #pt-nat)) (#pt-construct right () () leaf (key))))))
      (#pt-succ #pt-zero)))
  (#proof (#pt-refl #pt-nat (#pt-succ #pt-zero))))

(#fn main () #u64
  (#return 42u64))
