; Eta conversion reconstructs a function without changing it. The domain,
; range, bound argument, and application remain explicit.
(#theorem function-eta
  (#universes u v)
  (#parameters
    (#parameter Domain (#pt-sort u))
    (#parameter Range (#pt-pi ((argument Domain)) (#pt-sort v)))
    (#parameter function (#pt-pi ((argument Domain)) (#pt-app Range argument))))
  (#statement
    (#pt-eq
      (#pt-pi ((argument Domain)) (#pt-app Range argument))
      function
      (#pt-lambda ((argument Domain)) (#pt-app function argument))))
  (#proof (#pt-refl (#pt-pi ((argument Domain)) (#pt-app Range argument)) function)))
; A dependent pair is also equal to the reconstruction of its two projections.
; The second projection's type depends on the first projection's value.
(#theorem pair-eta
  (#universes)
  (#parameters
    (#parameter pair (#pt-sigma ((value #pt-nat)) (#pt-eq #pt-nat value value))))
  (#statement
    (#pt-eq
      (#pt-sigma ((value #pt-nat)) (#pt-eq #pt-nat value value))
      pair
      (#pt-pair
        (#pt-sigma ((value #pt-nat)) (#pt-eq #pt-nat value value))
        (#pt-first pair)
        (#pt-second pair))))
  (#proof (#pt-refl (#pt-sigma ((value #pt-nat)) (#pt-eq #pt-nat value value)) pair)))

(#fn main () #u64
  (#return 42u64))
