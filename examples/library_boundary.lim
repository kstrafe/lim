#alias counters@Counter = ./encapsulation/lib.lim::Counter
#alias counters@counter-destroy = ./encapsulation/lib.lim::counter-destroy
#alias counters@counter-new = ./encapsulation/lib.lim::counter-new
#alias counters@counter-read = ./encapsulation/lib.lim::counter-read

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let counter counters@Counter (#call counters@counter-new ((value 42u64))))
    (#let answer #u64 (#call counters@counter-read ((counter (#borrow counter)))))
    (#call counters@counter-destroy ((counter counter)))
    (#return answer)
  );
}
