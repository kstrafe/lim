; Typed literals and casts must select floating-point comparisons.
(#fn main () u64
  (#let nan32 f32 (#f32./ 0.0f32 0.0f32))
  (#let nan64 f64 (#f64./ 0.0f64 0.0f64))
  (#assert (#f32.!= nan32 nan32))
  (#assert (#f64.!= nan64 nan64))
  (#assert (#bool.! (#f32.== nan32 1.0f32)))
  (#assert (#bool.! (#f64.< nan64 1.0f64)))
  (#assert (#bool.! (#f64.>= nan64 1.0f64)))
  (#assert (#f32.== (#f32.+ 1.0f32 2.0f32) 3.0f32))
  (#assert (#f64.< (#as 1u64 f64) 2.0f64))
  (#assert (#f64.!= (#f64./ 0.0f64 0.0f64) 0.0f64))
  (#return 42u64))
