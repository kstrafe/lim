#fn consume {
  #params = ((values (#array #u64 8)) (scale #f64));
  #returns = #u64;
  #body = (
    (#return (#index values 7u64))
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let values (#array #u64 8)
      (#array (#array #u64 8)
        1u64 2u64 3u64 4u64 5u64 6u64 7u64 42u64))
    (#return (#call consume ((values values) (scale 1.0f64))))
  );
