#enum Maybe () ((Maybe.Some #u64) Maybe.None)

#fn classify {
  #params = ((value Maybe));
  #returns = #u64;
  #body = (
    (#return
      (#match value
        (#case (#or (Maybe.Some 1u64) (Maybe.Some 2u64) Maybe.None) 42u64)
        (#case _ 0u64)))
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#return (#call classify ((value (Maybe.Some 2u64)))))
  );
}
