; Ordinary pinned typed storage, with no async checker rules or field tags.
(#struct Token (: value #u64))
(#linear Token)
(#struct Owner (: kept (#ref #u64) : item Token))
(#enum Storage (Empty (Full Owner)))
(#unsafe-fn take-item (: item (#pin-ref-mut Token)) ()
  (#let moved Token (#unsafe (#pin-read item)))
  (#forget moved)
  (#return ()))
(#unsafe-fn restore-item (: item (#pin-ref-mut Token)) ()
  (#unsafe (#pin-write item (#struct-literal Token (: value 2u64))))
  (#return ()))
(#fn main () #u64
  (#let-mut seed #u64 40u64)
  (#let-mut storage Storage
    (Full (#struct-literal Owner
      (: kept (#borrow seed) : item (#struct-literal Token (: value 1u64))))))
  (#let owner (#pin-ref-mut Owner)
    (#pin-get-payload-mut (#pin-borrow-mut storage) Full 0))
  (#let kept (#pin-ref (#ref #u64)) (#pin-borrow (#get owner kept)))
  (#let address #usize (#ptr-address (#ref-ptr kept)))
  (#unsafe (#call take-item (: item (#pin-borrow-mut (#get owner item)))))
  (#unsafe (#call restore-item (: item (#pin-borrow-mut (#get owner item)))))
  (#let restored (#ref Owner) (#unsafe (#ptr-borrow owner (#ref-ptr owner))))
  (#let selected (#ref (#ref #u64)) (#borrow (#get restored kept)))
  (#assert (#usize.== address (#ptr-address (#ref-ptr selected))))
  (#let answer #u64
    (#u64.+.wrap (#deref (#get restored kept)) (#get (#get restored item) value)))
  (#forget selected)
  (#forget kept)
  (#forget restored)
  (#forget owner)
  (#forget storage)
  (#set seed 0u64)
  (#return answer))
