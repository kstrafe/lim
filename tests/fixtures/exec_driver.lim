(#import "../../library/linux_x86_64.lim")

; The Rust harness builds exec_target.lim as ./target in a private directory.
(#fn main () u64
  (#let memory (#ptr-mut u8) (#unsafe (#call linux-mmap (#fn-args
    (address (#ptr-null (#ptr-mut u8))) (length 4096usize)
    (protection 3u32) (flags 34u32) (fd -1i64) (offset 0i64)))))
  ; "target\0", followed by argv {path, NULL}, empty envp and empty path.
  (#unsafe (#asm () ((rdi memory))
    "mov DWORD PTR [rdi], 0x67726174\nmov WORD PTR [rdi+4], 0x7465\nmov QWORD PTR [rdi+16], rdi"))
  (#let arguments (#ptr-mut (#ptr-mut u8))
    (#unsafe (#asm (#ptr-mut (#ptr-mut u8)) ((rdi memory)) "lea rax, [rdi+16]")))
  (#let environment (#ptr-mut (#ptr-mut u8)) (#unsafe (#ptr-offset arguments 2usize)))
  (#let empty (#ptr-mut u8) (#unsafe (#ptr-offset memory 48usize)))
  (#assert (#i64.== (#unsafe (#call linux-execve (#fn-args
    (path empty) (arguments arguments) (environment environment)))) -2i64))
  (#assert (#i64.== (#unsafe (#call linux-execveat (#fn-args
    (directory -100i64) (path memory) (arguments arguments)
    (environment environment) (flags -1i32)))) -22i64))
  (#assert (#i64.== (#unsafe (#call linux-execveat (#fn-args
    (directory -1i64) (path memory) (arguments arguments)
    (environment environment) (flags 0i32)))) -9i64))
  (#let executable i64 (#unsafe (#call linux-openat (#fn-args
    (directory -100i64) (path memory) (flags 524288i32) (mode 0u32)))))
  (#assert (#i64.>= executable 0i64))
  (#for-range (iteration u32) 0u32 3u32
    (#let child i64 (#unsafe (#call linux-fork (#fn-args))))
    (#assert (#i64.>= child 0i64))
    (#if (#i64.== child 0i64)
      (#block
        (#if (#u32.== iteration 0u32)
          (#drop (#unsafe (#call linux-execve (#fn-args
            (path memory) (arguments arguments) (environment environment)))))
          (#if (#u32.== iteration 1u32)
            (#drop (#unsafe (#call linux-execveat (#fn-args
              (directory -100i64) (path memory) (arguments arguments)
              (environment environment) (flags 0i32)))))
            (#drop (#unsafe (#call linux-execveat (#fn-args
              (directory executable) (path empty) (arguments arguments)
              (environment environment) (flags 4096i32)))))))
        ; Reaching this means exec failed; do not continue the parent's loop.
        (#call linux-exit-group (#fn-args (status 99i32)))) ())
    (#let-mut status i32 0i32)
    (#assert (#i64.== (#unsafe (#linux-syscall i64 LINUX-SYS-WAIT4
      (child (#addr-of-mut status) 0i32 0usize))) child))
    (#assert (#i32.== status 9472i32)))
  (#assert (#i64.== (#call linux-close (#fn-args (fd executable))) 0i64))
  (#assert (#i64.== (#unsafe (#call linux-munmap (#fn-args
    (address memory) (length 4096usize)))) 0i64))
  (#return 42u64))
