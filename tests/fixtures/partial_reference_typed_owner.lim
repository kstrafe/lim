// Fully typed, contiguous backing: no Empty/Full wrapper or field flags.
#struct Token (#linear) ((value #u64))

#struct Owner () ((kept (#ref #u64)) (item Token))
#unsafe-fn take-item {
  #params = ((item (#pin-ref-mut Token)));
  #returns = ();
  #body = (
    (#let moved Token (#unsafe (#pin-read item)))
    (#forget moved)
    (#return ())
  );
}
#unsafe-fn restore-item {
  #params = ((item (#pin-ref-mut Token)));
  #returns = ();
  #body = (
    (#unsafe (#pin-write item (#struct-literal Token ((value 2u64)))))
    (#return ())
  );
}
#fn main {
  #params = ();
  #returns = #u64;
  #effects = (#global-access #io);
  #body = (
    (#assert (#usize::eq (#size-of Owner)
      (#usize::add-wrap (#size-of (#ref #u64)) (#size-of Token))))
    (#let-mut seed #u64 40u64)
    (#let-mut storage Owner
      (#struct-literal Owner
        ((kept (#borrow seed)) (item (#struct-literal Token ((value 1u64)))))))
    (#let owner (#pin-ref-mut Owner) (#pin-borrow-mut storage))
    (#let kept (#pin-ref (#ref #u64)) (#pin-borrow (#get owner kept)))
    (#let address #usize (#ptr-address (#ref-ptr kept)))
    (#unsafe (#unsafe-call take-item ((item (#pin-borrow-mut (#get owner item))))))
    (#unsafe (#unsafe-call restore-item ((item (#pin-borrow-mut (#get owner item))))))
    (#let restored (#ref Owner) (#unsafe (#ptr-borrow owner (#ref-ptr owner))))
    (#let selected (#ref (#ref #u64)) (#borrow (#get restored kept)))
    (#assert (#usize::eq address (#ptr-address (#ref-ptr selected))))
    (#let answer #u64
      (#u64::add-wrap (#deref (#get restored kept)) (#get (#get restored item) value)))
    (#forget selected)
    (#forget kept)
    (#forget restored)
    (#forget owner)
    (#forget storage)
    (#set seed 0u64)
    (#return answer)
  );
}
