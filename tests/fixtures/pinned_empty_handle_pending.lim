// Ordinary PendingResult.Pending results cannot export a reference to consumed storage.
// This is a negative architecture control, not generated async output.
#struct Token (#linear) ((value #u64))

#enum PendingResult () ((PendingResult.Pending (#pin-ref-mut Token)))
#fn suspend {
  #params = ((item (#pin-ref-mut Token)));
  #returns = PendingResult;
  #body = (
    (#let old Token (#unsafe (#pin-read item)))
    (#forget old)
    (#return (PendingResult.Pending item))
  );
}
#fn main {
  #params = ();
  #returns = #u64;
  #body = ( (#return 42u64)
  );
}
