; A partially moved owner must retain the address and provenance of its
; reference-bearing sibling when the restored owner is viewed as a whole.
(#struct Token (#linear) (: value #u64))

(#struct Owner () (: kept (#ref #u64) : item Token))
(#fn inspect (: owner (#ref Owner)) #u64
  (#return (#u64::add-wrap (#deref (#get owner kept)) (#get (#get owner item) value))))
(#enum Step (#linear) (Step.Start Step.Resume))

(#enum StepPoll () ((StepPoll.Pending Step) (StepPoll.Ready ())))
(#fn step-poll (: task Step : waker (#ref #u64)) StepPoll
  (#return (#match task (#case Step.Start (StepPoll.Pending Step.Resume)) (#case Step.Resume (StepPoll.Ready ())))))
(#generate #async-fn-pinned (: protocol WorkAwait : waker #u64 : function
  (#fn work (: seed (#ref #u64)) #u64
    (#let-mut owner Owner
      (#struct-literal Owner
        (: kept seed : item (#struct-literal Token (: value 1u64)))))
    (#let kept (#ref (#ref #u64)) (#borrow (#get owner kept)))
    (#let moved Token (#get owner item))
    (#forget moved)
    (#let ready () (#await () Step StepPoll.Pending StepPoll.Ready step-poll Step.Start))
    (#set-field owner item (#struct-literal Token (: value 2u64)))
    (#let whole (#ref Owner) (#borrow owner))
    (#let selected (#ref (#ref #u64)) (#borrow (#get whole kept)))
    (#let equal #bool
      (#usize::eq (#ptr-address (#ref-ptr kept)) (#ptr-address (#ref-ptr selected))))
    (#let answer #u64 (#call inspect (: owner whole)))
    (#forget selected) (#forget whole) (#forget kept) (#forget owner)
    (#return (#if equal answer 0u64)))))
(#fn main () #u64
  (#let seed #u64 40u64)
  (#let waker #u64 0u64)
  (#let-mut frame Work::Frame (#call work (: seed (#borrow seed))))
  (#let first Work::Poll
    (#call Work::poll (: task (#pin-borrow-mut frame) : waker (#borrow waker))))
  (#let-else (Work::Poll.Pending pending) Work::Poll first (#unreachable))
  (#let result #u64
    (#match (#call Work::poll (: task pending : waker (#borrow waker)))
      (#case (Work::Poll.Ready value) value)
      (#case (Work::Poll.Pending unexpected) (#block (#forget unexpected) (#unreachable)))))
  (#forget frame)
  (#return result))
