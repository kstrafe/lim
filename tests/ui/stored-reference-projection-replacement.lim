(#struct Holder (: view (#pin-ref (#tuple #u64 #u64))))
(#fn project (: holder (#pin-ref Holder)) (#pin-ref #u64)
  (#return (#pin-borrow (#get (#get holder view) 1))))
(#fn main () #u64
  (#let-mut values (#tuple #u64 #u64) (#tuple (#tuple #u64 #u64) 40u64 42u64))
  (#let holder Holder (#struct-literal Holder (: view (#pin-borrow values))))
  (#let selected (#pin-ref #u64) (#call project (: holder (#pin-borrow holder))))
  (#forget holder)
  (#set values (#tuple (#tuple #u64 #u64) 99u64 100u64))
  (#return (#deref selected)))
