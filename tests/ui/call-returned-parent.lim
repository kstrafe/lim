#struct Owner () ((value #u64))
#fn child-of {
  #params = ((owner (#ref-mut Owner)));
  #returns = (#ref-mut #u64);
  #body = (
    (#return (#borrow-mut (#get owner value)))
  );
}
#fn overwrite {
  #params = ((owner (#ref-mut Owner)));
  #returns = ();
  #body = (
    (#deref-set owner (#struct-literal Owner ((value 99u64)))) (#return ())
  );
}
#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let-mut owner Owner (#struct-literal Owner ((value 42u64))))
    (#let parent (#ref-mut Owner) (#borrow-mut owner))
    (#let child (#ref-mut #u64) (#call child-of ((owner parent))))
    (#call overwrite ((owner parent)))
    (#let answer #u64 (#deref child))
    (#drop child)
    (#drop parent)
    (#forget owner)
    (#return answer)
  );
}
