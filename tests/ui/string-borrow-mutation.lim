#alias String = (#unstable ../../library/string.lim::String)
#alias StringBytes = (#unstable ../../library/string.lim::StringBytes)
#alias new-string = (#unstable ../../library/string.lim::String::new)
#alias string-bytes = (#unstable ../../library/string.lim::String::bytes)
#alias string-clear = (#unstable ../../library/string.lim::String::clear)
#alias bytes-len = (#unstable ../../library/string.lim::StringBytes::len)
#alias string-free = (#unstable ../../library/string.lim::String::free)
#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let-mut text String (#call new-string ()))
    (#let bytes StringBytes
      (#call string-bytes ((string (#borrow text)))))
    (#call string-clear ((string (#borrow-mut text))))
    (#let value #usize (#call bytes-len ((bytes bytes))))
    (#drop bytes)
    (#call string-free ((string text)))
    (#return (#as value #u64))
  );
}
