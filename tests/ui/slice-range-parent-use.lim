(#fn main () #u64
  (#let-mut values (#array #u64 3) (#array-of (#array #u64 3) 1u64 2u64 3u64))
  (#let parent (#slice-mut #u64) (#borrow-slice-mut values))
  (#let child (#slice-mut #u64) (#slice-mut-range parent 1usize 3usize))
  (#let length #usize (#slice-mut-len parent))
  (#forget child)
  (#forget parent)
  (#return (#as length #u64)))
