#struct Pair () ((owner #u64))
#fn main {
  #params = ();
  #returns = (#tuple #u64 #u64);
  #body = (
    (#let-mut owner #u64 1u64)
    (#let pair Pair (#struct-literal Pair ((owner 2u64))))
    (#let reference (#ref-mut #u64) (#borrow-mut owner))
    (#return (#tuple (#get pair owner) owner))
  );
}
