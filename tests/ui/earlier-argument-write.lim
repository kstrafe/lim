#struct Holder () ((value (#ref-mut #u64)))
#fn read {
  #params = ((view (#ref-mut #u64)) (amount #u64));
  #returns = #u64;
  #body = (
    (#return (#u64::add-wrap (#deref view) amount))
  );
}
#fn work {
  #params = ((held Holder));
  #returns = #u64;
  #body = (
    (#let answer #u64
      (#call read
        ((view (#get held value))
         (amount (#block
            (#deref-set (#get held value) 99u64)
            2u64)))))
    (#forget held)
    (#return answer)
  );
}
#fn main {
  #params = ();
  #returns = #u64;
  #body = ( (#return 0u64)
  );
}
