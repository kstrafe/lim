(#struct Holder () ((value (#ref-mut #u64))))
(#fn read ((view (#ref-mut #u64)) (amount #u64)) #u64
  (#return (#u64::add-wrap (#deref view) amount)))
(#fn work ((held Holder)) #u64
  (#let answer #u64
    (#call read
      ((view (#get held value))
       (amount (#block
          (#deref-set (#get held value) 99u64)
          2u64)))))
  (#forget held)
  (#return answer))
(#fn main () #u64 (#return 0u64))
