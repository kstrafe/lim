#fn worker {
  #params = ((value #u64));
  #returns = #u64;
  #body = ( (#return value)
  );
}
#generate #thread-spawn ((task Task) (worker worker))
#fn bad {
  #params = ((task Task));
  #returns = #u64;
  #body = ( (#return 0u64)
  );
}
#fn main {
  #params = ();
  #returns = #u64;
  #body = ( (#return 0u64)
  );
}
