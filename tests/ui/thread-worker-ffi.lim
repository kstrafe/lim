#extern-fn  abs {
  #abi = #abi-c;
  #params = ((value #i32));
  #returns = #i32;
}
#fn work {
  #params = ();
  #returns = #i32;
  #body = ( (#return (#unsafe (#unsafe-call abs ((value -42i32)))))
  );
}
#thread-task Work work
#fn main {
  #params = ();
  #returns = #u64;
  #body = ( (#return 42u64)
  );
}
