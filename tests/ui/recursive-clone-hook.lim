#struct Value () ((number #u64))
#fn Value::clone {
  #params = ((value Value));
  #returns = Value;
  #body = (
    (#return (#clone value))
  );
}
#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let value Value (#struct-literal Value ((number 42u64))))
    (#let copied Value (#clone value))
    (#return (#get copied number))
  );
}
