(#struct Resource (: number #u64))
(#linear Resource)
(#fn main () ()
  (#let-mut owner Resource (#struct-literal Resource (: number 1u64)))
  (#let target (#pin-ref-mut Resource) (#pin-borrow-mut owner))
  (#unsafe (#pin-write target (#struct-literal Resource (: number 2u64))))
  (#drop target)
  (#forget owner)
  (#return ()))
