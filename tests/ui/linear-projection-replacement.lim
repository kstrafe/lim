(#struct Resource ((number #u64)))
(#linear Resource)
(#struct Owner ((item Resource)))
(#fn main () #u64
  (#let-mut owner Owner
    (#struct-literal Owner ((item (#struct-literal Resource ((number 1u64)))))))
  (#set-field owner item (#struct-literal Resource ((number 2u64))))
  (#forget owner)
  (#return 0u64))
