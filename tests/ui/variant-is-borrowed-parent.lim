(#import "/<lim-std>/enum_project.lim")
(#enum Choice () ((Choice.Number #u64) Choice.Empty))
(#generate #enum-project (: enum Choice : variant Choice.Number : payload #u64 : mode #pin-ref-mut : name NumberView))
(#fn main () #u64
  (#let-mut value Choice (Choice.Number 42u64))
  (#let parent (#pin-ref-mut Choice) (#pin-borrow-mut value))
  (#let-else (NumberView.Some child)
    (#call NumberView::project (: source (#pin-borrow-mut (#deref parent))))
    (#else (#return 0u64)))
  (#variant-is parent Choice.Number)
  (#let result #u64 (#deref child))
  (#drop child)
  (#drop parent)
  (#forget value)
  (#return result))
