#fn main () #u64
    (#let-mut values (#array #u64 3) (#array-of (#array #u64 3) 1u64 2u64 3u64))
    (#let left (#slice-mut #u64) (#borrow-slice-mut values 0usize 2usize))
    (#let right (#slice-mut #u64) (#borrow-slice-mut values 1usize 3usize))
    (#forget left)
    (#forget right)
    (#return 0u64)
