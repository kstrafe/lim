(#theorem ninth-sum-one-one
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter first-residue (#pt-app (#pt-use ninth-residue ()) first (#pt-numeral 1)))
    (#parameter second-residue (#pt-app (#pt-use ninth-residue ()) second (#pt-numeral 1))))
  (#statement
    (#pt-app (#pt-use ninth-residue ()) (#pt-app (#pt-use add ()) first second) (#pt-numeral 2)))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-ninth-quotient #pt-nat))
          (#pt-eq
            #pt-nat
            first
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use multiply ()) (#pt-numeral 9) candidate-ninth-quotient)
              (#pt-numeral 1)))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-ninth-quotient #pt-nat))
