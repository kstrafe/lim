      (#pt-lambda
        ((one-residue (#pt-app (#pt-use ninth-residue ()) number (#pt-numeral 1))))
        (#pt-app
          (#pt-app (#pt-use successor-not-zero ()) (#pt-numeral 0))
          (#pt-app
            (#pt-use symmetry (0))
            #pt-nat
            (#pt-numeral 0)
