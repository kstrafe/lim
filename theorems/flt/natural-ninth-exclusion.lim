                  #pt-nat
                  first
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use multiply ()) (#pt-numeral 9) candidate-ninth-quotient)
                    (#pt-numeral 1)))))))
        (#pt-app (#pt-use ninth-residue ()) (#pt-app (#pt-use add ()) first second) (#pt-numeral 2)))
      (
        (#pt-lambda
          (
            (first-quotient #pt-nat)
            (first-equation
              (#pt-eq
                #pt-nat
                first
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 9) first-quotient)
                  (#pt-numeral 1)))))
          (#pt-induct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-ninth-quotient #pt-nat))
                (#pt-eq
                  #pt-nat
                  second
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use multiply ()) (#pt-numeral 9) candidate-ninth-quotient)
                    (#pt-numeral 1)))))
            (#pt-lambda
              (
                (certificate
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((candidate-ninth-quotient #pt-nat))
                      (#pt-eq
                        #pt-nat
                        second
                        (#pt-app
                          (#pt-use add ())
                          (#pt-app (#pt-use multiply ()) (#pt-numeral 9) candidate-ninth-quotient)
                          (#pt-numeral 1)))))))
              (#pt-app
                (#pt-use ninth-residue ())
                (#pt-app (#pt-use add ()) first second)
                (#pt-numeral 2)))
            (
              (#pt-lambda
                (
                  (second-quotient #pt-nat)
                  (second-equation
                    (#pt-eq
                      #pt-nat
                      second
                      (#pt-app
                        (#pt-use add ())
                        (#pt-app (#pt-use multiply ()) (#pt-numeral 9) second-quotient)
                        (#pt-numeral 1)))))
                (#pt-construct
                  exists
                  (0)
                  (#pt-nat
                    (#pt-lambda
                      ((candidate-ninth-quotient #pt-nat))
                      (#pt-eq
                        #pt-nat
                        (#pt-app (#pt-use add ()) first second)
                        (#pt-app
                          (#pt-use add ())
                          (#pt-app (#pt-use multiply ()) (#pt-numeral 9) candidate-ninth-quotient)
                          (#pt-numeral 2)))))
                  introduce
                  (
                    (#pt-app (#pt-use add ()) first-quotient second-quotient)
                    (#pt-app
                      (#pt-use transitivity (0))
                      #pt-nat
                      (#pt-app (#pt-use add ()) first second)
                      (#pt-app
                        (#pt-use add ())
                        (#pt-app
                          (#pt-use add ())
                          (#pt-app (#pt-use multiply ()) (#pt-numeral 9) first-quotient)
                          (#pt-numeral 1))
                        (#pt-app
                          (#pt-use add ())
                          (#pt-app (#pt-use multiply ()) (#pt-numeral 9) second-quotient)
                          (#pt-numeral 1)))
                      (#pt-app
                        (#pt-use add ())
                        (#pt-app
                          (#pt-use multiply ())
                          (#pt-numeral 9)
                          (#pt-app (#pt-use add ()) first-quotient second-quotient))
                        (#pt-numeral 2))
                      (#pt-app
                        (#pt-use transitivity (0))
                        #pt-nat
                        (#pt-app (#pt-use add ()) first second)
                        (#pt-app
                          (#pt-use add ())
                          (#pt-app
                            (#pt-use add ())
                            (#pt-app (#pt-use multiply ()) (#pt-numeral 9) first-quotient)
                            (#pt-numeral 1))
                          second)
                        (#pt-app
                          (#pt-use add ())
                          (#pt-app
                            (#pt-use add ())
                            (#pt-app (#pt-use multiply ()) (#pt-numeral 9) first-quotient)
                            (#pt-numeral 1))
                          (#pt-app
                            (#pt-use add ())
                            (#pt-app (#pt-use multiply ()) (#pt-numeral 9) second-quotient)
                            (#pt-numeral 1)))
                        (#pt-app
                          (#pt-use congruence (0 0))
                          #pt-nat
                          #pt-nat
                          (#pt-lambda
                            ((endpoint #pt-nat))
                            (#pt-app (#pt-use add ()) endpoint second))
                          first
                          (#pt-app
                            (#pt-use add ())
                            (#pt-app (#pt-use multiply ()) (#pt-numeral 9) first-quotient)
                            (#pt-numeral 1))
                          first-equation)
                        (#pt-app
                          (#pt-use congruence (0 0))
                          #pt-nat
                          #pt-nat
                          (#pt-lambda
                            ((endpoint #pt-nat))
                            (#pt-app
                              (#pt-use add ())
                              (#pt-app
                                (#pt-use add ())
                                (#pt-app (#pt-use multiply ()) (#pt-numeral 9) first-quotient)
                                (#pt-numeral 1))
                              endpoint))
                          second
                          (#pt-app
                            (#pt-use add ())
                            (#pt-app (#pt-use multiply ()) (#pt-numeral 9) second-quotient)
                            (#pt-numeral 1))
                          second-equation))
                      (#pt-app (#pt-use ninth-residues-one-one ()) first-quotient second-quotient))))))
            second-residue)))
      first-residue)))
