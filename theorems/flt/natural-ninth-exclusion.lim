; Cube-residue sums cannot themselves have the nonmultiple-of-three cube residues.
; Every residue carries an explicit Nat quotient; uniqueness is checked, not assumed.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias exists = ./logic-exists.lim::exists)
(#alias ninth-residue = ./natural-ninth-residues.lim::ninth-residue)
