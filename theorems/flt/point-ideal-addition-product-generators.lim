; Generated by scripts/generate-flt-point-ideal-addition.py; checked native terms.
; Actual scaled point-pair
; products and their four actual product-member witnesses.
; These are ordinary saturated ideal operations, not data
; containing the addition conclusion.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias ring-ideal = ./ring-ideal-data.lim::ring-ideal)
(#alias ring-ideal-member = ./ring-ideal-data.lim::ring-ideal-member)
(#alias ring-ideal-pair = ./ring-ideal-pair.lim::ring-ideal-pair)
(#alias ring-ideal-pair-first = ./ring-ideal-pair.lim::ring-ideal-pair-first)
(#alias ring-ideal-pair-second = ./ring-ideal-pair.lim::ring-ideal-pair-second)
(#alias ring-ideal-principal = ./ring-ideal-principal.lim::ring-ideal-principal)
(#alias ring-ideal-principal-generator = ./ring-ideal-principal.lim::ring-ideal-principal-generator)
(#alias ring-ideal-product = ./ring-ideal-product.lim::ring-ideal-product)
(#alias ring-ideal-product-introduce = ./ring-ideal-product.lim::ring-ideal-product-introduce)
(#alias ring-ideal-sum = ./ring-ideal-sum.lim::ring-ideal-sum)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#math-definition point-ideal-addition-left-product ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (first-X Carrier)
      (second-X Carrier)
      (sum-X Carrier)
      (line Carrier)
      (opposite Carrier))
    (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (first-X Carrier)
      (second-X Carrier)
      (sum-X Carrier)
      (line Carrier)
      (opposite Carrier))
    (#pt-app
      (#pt-use ring-ideal-product ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring sum-X)
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring first-X line)
        (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring second-X line)))))
(#math-definition point-ideal-addition-common-ideal ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
