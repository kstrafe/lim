      (first-X Carrier)
      (second-X Carrier)
      (sum-X Carrier)
      (line Carrier)
      (opposite Carrier))
    (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (first-X Carrier)
      (second-X Carrier)
      (sum-X Carrier)
      (line Carrier)
      (opposite Carrier))
    (#pt-app
      (#pt-use ring-ideal-sum ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring first-X second-X)
      (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring line opposite))))
(#math-definition point-ideal-addition-right-product ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (first-X Carrier)
      (second-X Carrier)
      (sum-X Carrier)
      (line Carrier)
      (opposite Carrier))
    (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (first-X Carrier)
      (second-X Carrier)
      (sum-X Carrier)
      (line Carrier)
      (opposite Carrier))
    (#pt-app
      (#pt-use ring-ideal-product ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring line)
      (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring sum-X opposite))))
(#theorem point-ideal-addition-generator-XX
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-X Carrier)
    (#parameter second-X Carrier)
    (#parameter sum-X Carrier)
    (#parameter line Carrier)
    (#parameter opposite Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-member ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use point-ideal-addition-left-product ())
        Carrier
        coefficient-ring
        first-X
        second-X
        sum-X
        line
        opposite)
      (#pt-app
        (#pt-use ring-multiply ())
        Carrier
        coefficient-ring
        sum-X
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-X second-X))))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-product-introduce ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring sum-X)
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring first-X line)
        (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring second-X line))
      sum-X
      (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-X second-X)
      (#pt-app (#pt-use ring-ideal-principal-generator ()) Carrier coefficient-ring sum-X)
      (#pt-app
        (#pt-use ring-ideal-product-introduce ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring first-X line)
        (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring second-X line)
        first-X
        second-X
        (#pt-app (#pt-use ring-ideal-pair-first ()) Carrier coefficient-ring first-X line)
        (#pt-app (#pt-use ring-ideal-pair-first ()) Carrier coefficient-ring second-X line)))))
