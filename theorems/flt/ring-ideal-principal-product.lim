; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Prove principal(a)*principal(b)=principal(a*b)
; from the checked coefficient inclusion and principal minimality.
; This includes zero divisors and does not require a field.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias ring-ideal-equal = ./ring-ideal-data.lim::ring-ideal-equal)
(#alias ring-ideal-principal = ./ring-ideal-principal.lim::ring-ideal-principal)
(#alias ring-ideal-principal-generator = ./ring-ideal-principal.lim::ring-ideal-principal-generator)
(#alias
  ring-ideal-principal-least
  =
  ./ring-ideal-principal-universal.lim::ring-ideal-principal-least)
(#alias
  ring-ideal-principal-product-inclusion
  =
  ./ring-ideal-principal-product-inclusion.lim::ring-ideal-principal-product-inclusion)
(#alias ring-ideal-product = ./ring-ideal-product.lim::ring-ideal-product)
(#alias ring-ideal-product-introduce = ./ring-ideal-product.lim::ring-ideal-product-introduce)
(#alias ring-ideal-subset = ./ring-ideal-data.lim::ring-ideal-subset)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#theorem ring-ideal-principal-product
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-element Carrier)
    (#parameter second-element Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
        (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element))
      (#pt-app
        (#pt-use ring-ideal-principal ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element second-element))))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element))
        (#pt-app
          (#pt-use ring-ideal-principal ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element second-element)))
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-principal ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element second-element))
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element)))
      (#pt-app
        (#pt-use ring-ideal-principal-product-inclusion ())
        Carrier
        coefficient-ring
        first-element
        second-element)
      (#pt-app
        (#pt-use ring-ideal-principal-least ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element second-element)
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element))
        (#pt-app
          (#pt-use ring-ideal-product-introduce ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element)
          first-element
          second-element
          (#pt-app
            (#pt-use ring-ideal-principal-generator ())
            Carrier
            coefficient-ring
            first-element)
          (#pt-app
            (#pt-use ring-ideal-principal-generator ())
            Carrier
            coefficient-ring
            second-element))))))
