; Adapted source: pinned Mathlib Affine/Point.lean:409-470.
; All polynomial, coefficient-domain and index facts are proved.
; Generated by scripts/generate-flt-norm-degrees.py; checked native terms.
; Every nonzero actual coordinate element has nonzero
; norm, proved by the actual degree cases as a negative statement.
; This theorem requires only the coefficient-domain laws, not a
; coefficient zero decider or a supplied norm-kernel assumption.
(#alias add = ./../fermat_statement.lim::add)
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias
  coordinate-norm-degree-exhaustive-elimination
  =
  ./coordinate-norm-degree-exhaustive.lim::coordinate-norm-degree-exhaustive-elimination)
(#alias
  coordinate-norm-degree-maximum
  =
  ./coordinate-norm-degree-maximum.lim::coordinate-norm-degree-maximum)
(#alias
  coordinate-norm-degree-maximum-formula
  =
  ./coordinate-norm-degree-maximum-formula.lim::coordinate-norm-degree-maximum-formula)
(#alias
  coordinate-norm-degree-value
  =
  ./coordinate-norm-degree-formula.lim::coordinate-norm-degree-value)
(#alias
  coordinate-norm-degree-zero-constant
  =
  ./coordinate-norm-degree-zero-cases.lim::coordinate-norm-degree-zero-constant)
(#alias
  coordinate-norm-degree-zero-linear
  =
  ./coordinate-norm-degree-zero-cases.lim::coordinate-norm-degree-zero-linear)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias quadratic-element = ./quadratic-algebra-data.lim::quadratic-element)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias
  ring-polynomial-degree-nonzero
  =
  ./ring-polynomial-degree-leading.lim::ring-polynomial-degree-nonzero)
(#alias
  ring-polynomial-degree-witness
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-degree-witness)
(#alias
  ring-polynomial-domain-data
  =
  ./ring-polynomial-domain-data.lim::ring-polynomial-domain-data)
(#alias ring-polynomial-equal = ./ring-polynomial-data.lim::ring-polynomial-equal)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#alias
  weierstrass-coordinate-norm
  =
  ./weierstrass-coordinate-normal-form.lim::weierstrass-coordinate-norm)
(#alias
  weierstrass-coordinate-ring
  =
  ./weierstrass-coordinate-normal-form.lim::weierstrass-coordinate-ring)
(#theorem coordinate-norm-degree-pair-nonzero-norm
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter nonzero-coordinates (#pt-pi ((denied-evidence (#pt-app (#pt-use conjunction ()) (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring polynomial (#pt-construct finite-list () (Carrier) nil ())) (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring other-polynomial (#pt-construct finite-list () (Carrier) nil ()))))) #pt-false)))
  (#statement
    (#pt-pi
      (
        (denied-evidence
          (#pt-app
            (#pt-use ring-polynomial-equal ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use coordinate-norm-degree-value ())
              Carrier
              coefficient-ring
              a1
              a2
              a3
              a4
              a6
              polynomial
              other-polynomial)
            (#pt-construct finite-list () (Carrier) nil ()))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (zero-norm
          (#pt-app
            (#pt-use ring-polynomial-equal ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use coordinate-norm-degree-value ())
              Carrier
              coefficient-ring
              a1
              a2
              a3
              a4
              a6
              polynomial
              other-polynomial)
            (#pt-construct finite-list () (Carrier) nil ()))))
      (#pt-app
        (#pt-use coordinate-norm-degree-exhaustive-elimination ())
        Carrier
        coefficient-ring
        polynomial
        (#pt-lambda
          (
            (zero-constant
              (#pt-app
                (#pt-use ring-polynomial-equal ())
                Carrier
                coefficient-ring
                polynomial
                (#pt-construct finite-list () (Carrier) nil ()))))
          (#pt-app
            (#pt-use coordinate-norm-degree-exhaustive-elimination ())
            Carrier
            coefficient-ring
            other-polynomial
            (#pt-lambda
              (
                (zero-linear
                  (#pt-app
                    (#pt-use ring-polynomial-equal ())
                    Carrier
                    coefficient-ring
                    other-polynomial
                    (#pt-construct finite-list () (Carrier) nil ()))))
              (#pt-app
                nonzero-coordinates
                (#pt-app
                  (#pt-use conjunction-introduce ())
                  (#pt-app
                    (#pt-use ring-polynomial-equal ())
                    Carrier
                    coefficient-ring
                    polynomial
                    (#pt-construct finite-list () (Carrier) nil ()))
                  (#pt-app
                    (#pt-use ring-polynomial-equal ())
                    Carrier
                    coefficient-ring
                    other-polynomial
                    (#pt-construct finite-list () (Carrier) nil ()))
                  zero-constant
                  zero-linear)))
            (#pt-lambda
              (
                (linear-degree #pt-nat)
                (linear-certificate
                  (#pt-app
                    (#pt-use ring-polynomial-degree-witness ())
                    Carrier
                    coefficient-ring
                    other-polynomial
                    linear-degree)))
              (#pt-app
                (#pt-app
                  (#pt-use ring-polynomial-degree-nonzero ())
                  Carrier
                  coefficient-ring
                  (#pt-app
                    (#pt-use coordinate-norm-degree-value ())
                    Carrier
                    coefficient-ring
                    a1
                    a2
                    a3
                    a4
                    a6
                    polynomial
                    other-polynomial)
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use add ()) linear-degree linear-degree)
                    (#pt-numeral 3))
                  (#pt-app
                    (#pt-use coordinate-norm-degree-zero-constant ())
                    Carrier
                    coefficient-ring
                    coefficient-domain
                    a1
                    a2
                    a3
                    a4
                    a6
                    polynomial
                    other-polynomial
                    linear-degree
                    zero-constant
                    linear-certificate))
                zero-norm))))
        (#pt-lambda
          (
            (constant-degree #pt-nat)
            (constant-certificate
              (#pt-app
                (#pt-use ring-polynomial-degree-witness ())
                Carrier
                coefficient-ring
                polynomial
                constant-degree)))
          (#pt-app
            (#pt-use coordinate-norm-degree-exhaustive-elimination ())
            Carrier
            coefficient-ring
            other-polynomial
            (#pt-lambda
              (
                (zero-linear
                  (#pt-app
                    (#pt-use ring-polynomial-equal ())
                    Carrier
                    coefficient-ring
                    other-polynomial
                    (#pt-construct finite-list () (Carrier) nil ()))))
              (#pt-app
                (#pt-app
                  (#pt-use ring-polynomial-degree-nonzero ())
                  Carrier
                  coefficient-ring
                  (#pt-app
                    (#pt-use coordinate-norm-degree-value ())
                    Carrier
                    coefficient-ring
                    a1
                    a2
                    a3
                    a4
                    a6
                    polynomial
                    other-polynomial)
                  (#pt-app (#pt-use add ()) constant-degree constant-degree)
                  (#pt-app
                    (#pt-use coordinate-norm-degree-zero-linear ())
                    Carrier
                    coefficient-ring
                    coefficient-domain
                    a1
                    a2
                    a3
                    a4
                    a6
                    polynomial
                    other-polynomial
                    constant-degree
                    constant-certificate
                    zero-linear))
                zero-norm))
            (#pt-lambda
              (
                (linear-degree #pt-nat)
                (linear-certificate
                  (#pt-app
                    (#pt-use ring-polynomial-degree-witness ())
                    Carrier
                    coefficient-ring
                    other-polynomial
                    linear-degree)))
              (#pt-app
                (#pt-app
                  (#pt-use ring-polynomial-degree-nonzero ())
                  Carrier
                  coefficient-ring
                  (#pt-app
                    (#pt-use coordinate-norm-degree-value ())
                    Carrier
                    coefficient-ring
                    a1
                    a2
                    a3
                    a4
                    a6
                    polynomial
                    other-polynomial)
                  (#pt-app
                    (#pt-use coordinate-norm-degree-maximum ())
                    (#pt-app (#pt-use add ()) constant-degree constant-degree)
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use add ()) linear-degree linear-degree)
                      (#pt-numeral 3)))
                  (#pt-app
                    (#pt-use coordinate-norm-degree-maximum-formula ())
                    Carrier
                    coefficient-ring
                    coefficient-domain
                    a1
                    a2
                    a3
                    a4
                    a6
                    polynomial
                    other-polynomial
                    constant-degree
                    linear-degree
                    constant-certificate
                    linear-certificate))
                zero-norm))))))))
(#theorem coordinate-norm-degree-element-nonzero-norm
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter first-coordinate (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier)))
    (#parameter nonzero-coordinate (#pt-pi ((denied-evidence (#pt-app (#pt-use ring-equal ()) (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier)) (#pt-app (#pt-use weierstrass-coordinate-ring ()) Carrier coefficient-ring a1 a2 a3 a4 a6) first-coordinate (#pt-app (#pt-use ring-zero ()) (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier)) (#pt-app (#pt-use weierstrass-coordinate-ring ()) Carrier coefficient-ring a1 a2 a3 a4 a6))))) #pt-false)))
  (#statement
    (#pt-pi
      (
        (denied-evidence
          (#pt-app
            (#pt-use ring-polynomial-equal ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use weierstrass-coordinate-norm ())
              Carrier
              coefficient-ring
              a1
              a2
              a3
              a4
              a6
              first-coordinate)
            (#pt-construct finite-list () (Carrier) nil ()))))
      #pt-false))
  (#proof
    (#pt-app
      (#pt-use coordinate-norm-degree-pair-nonzero-norm ())
      Carrier
      coefficient-ring
      coefficient-domain
      a1
      a2
      a3
      a4
      a6
      (#pt-project quadratic-element 0 first-coordinate)
      (#pt-project quadratic-element 1 first-coordinate)
      nonzero-coordinate)))
