; Equality transport used by the direct FLT source port.
; These are proved with kernel equality elimination, not admitted laws.
(#theorem symmetry
  (#universes u)
  (#parameters
    (#parameter a (#pt-type u))
    (#parameter left a)
    (#parameter right a)
    (#parameter path (#pt-eq a left right)))
  (#statement (#pt-eq a right left))
  (#proof
    (#pt-eq-elim
      a
      left
      (#pt-lambda ((other a) (evidence (#pt-eq a left other))) (#pt-eq a other left))
      (#pt-refl a left)
      right
      path)))
(#theorem transitivity
  (#universes u)
  (#parameters
    (#parameter a (#pt-type u))
    (#parameter start a)
    (#parameter midpoint a)
    (#parameter endpoint a)
    (#parameter initial (#pt-eq a start midpoint))
    (#parameter following (#pt-eq a midpoint endpoint)))
  (#statement (#pt-eq a start endpoint))
  (#proof
    (#pt-eq-elim
      a
      midpoint
      (#pt-lambda ((other a) (evidence (#pt-eq a midpoint other))) (#pt-eq a start other))
      initial
      endpoint
      following)))
(#theorem congruence
  (#universes u v)
  (#parameters
    (#parameter a (#pt-type u))
    (#parameter b (#pt-type v))
    (#parameter function (#pt-pi ((argument a)) b))
    (#parameter left a)
    (#parameter right a)
    (#parameter path (#pt-eq a left right)))
  (#statement (#pt-eq b (#pt-app function left) (#pt-app function right)))
  (#proof
    (#pt-eq-elim
      a
      left
      (#pt-lambda
        ((other a) (evidence (#pt-eq a left other)))
        (#pt-eq b (#pt-app function left) (#pt-app function other)))
      (#pt-refl b (#pt-app function left))
      right
      path)))
; Transport a proposition-valued predicate along equality.
(#theorem substitution
  (#universes u)
  (#parameters
    (#parameter Carrier (#pt-type u))
    (#parameter property (#pt-pi ((point Carrier)) #pt-prop))
    (#parameter left Carrier)
    (#parameter right Carrier)
    (#parameter equality (#pt-eq Carrier left right))
    (#parameter evidence (#pt-app property left)))
  (#statement (#pt-app property right))
  (#proof
    (#pt-eq-elim
      Carrier
      left
      (#pt-lambda
        ((endpoint Carrier) (path (#pt-eq Carrier left endpoint)))
        (#pt-app property endpoint))
      evidence
      right
      equality)))
