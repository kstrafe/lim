; Adapted source: pinned Mathlib Affine/Point.lean:409-470.
; All polynomial, coefficient-domain and index facts are proved.
; Generated by scripts/generate-flt-norm-degrees.py; checked native terms.
; Prove the square and cubic-term degrees from actual
; domain products, and the cross-term upper support from polynomial
; multiplication and the actual Weierstrass linear bound. All input
; leading degrees include0, and all curve coefficients remain arbitrary.
(#alias add = ./../fermat_statement.lim::add)
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias
  ring-polynomial-degree-product
  =
  ./ring-polynomial-degree-product.lim::ring-polynomial-degree-product)
(#alias
  ring-polynomial-degree-weierstrass-cubic
  =
  ./ring-polynomial-degree-weierstrass.lim::ring-polynomial-degree-weierstrass-cubic)
(#alias
  ring-polynomial-degree-weierstrass-linear-bound
  =
  ./ring-polynomial-degree-weierstrass.lim::ring-polynomial-degree-weierstrass-linear-bound)
(#alias
  ring-polynomial-degree-witness
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-degree-witness)
(#alias
  ring-polynomial-domain-data
  =
  ./ring-polynomial-domain-data.lim::ring-polynomial-domain-data)
(#alias ring-polynomial-multiply = ./ring-polynomial-data.lim::ring-polynomial-multiply)
(#alias
  ring-polynomial-product-top
  =
  ./ring-polynomial-product-top.lim::ring-polynomial-product-top)
(#alias
  ring-polynomial-support-from
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-support-from)
(#alias
  weierstrass-coordinate-cubic
  =
  ./weierstrass-coordinate-normal-form.lim::weierstrass-coordinate-cubic)
(#alias
  weierstrass-coordinate-linear
  =
  ./weierstrass-coordinate-normal-form.lim::weierstrass-coordinate-linear)
(#theorem coordinate-norm-degree-square
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter constant-degree #pt-nat)
    (#parameter constant-certificate (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring polynomial constant-degree)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-degree-witness ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-polynomial-multiply ()) Carrier coefficient-ring polynomial polynomial)
      (#pt-app (#pt-use add ()) constant-degree constant-degree)))
  (#proof
    (#pt-app
      (#pt-use ring-polynomial-degree-product ())
      Carrier
      coefficient-ring
      coefficient-domain
      polynomial
      polynomial
      constant-degree
      constant-degree
      constant-certificate
      constant-certificate)))
(#theorem coordinate-norm-degree-cubic-term
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter linear-degree #pt-nat)
    (#parameter linear-certificate (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring other-polynomial linear-degree)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-degree-witness ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-multiply ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-multiply ())
          Carrier
          coefficient-ring
          other-polynomial
          other-polynomial)
        (#pt-app (#pt-use weierstrass-coordinate-cubic ()) Carrier coefficient-ring a1 a2 a3 a4 a6))
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use add ()) linear-degree linear-degree)
        (#pt-numeral 3))))
  (#proof
    (#pt-app
      (#pt-use ring-polynomial-degree-product ())
      Carrier
      coefficient-ring
      coefficient-domain
      (#pt-app
        (#pt-use ring-polynomial-multiply ())
        Carrier
        coefficient-ring
        other-polynomial
        other-polynomial)
      (#pt-app (#pt-use weierstrass-coordinate-cubic ()) Carrier coefficient-ring a1 a2 a3 a4 a6)
      (#pt-app (#pt-use add ()) linear-degree linear-degree)
      (#pt-numeral 3)
      (#pt-app
        (#pt-use ring-polynomial-degree-product ())
        Carrier
        coefficient-ring
        coefficient-domain
        other-polynomial
        other-polynomial
        linear-degree
        linear-degree
        linear-certificate
        linear-certificate)
      (#pt-app
        (#pt-use ring-polynomial-degree-weierstrass-cubic ())
        Carrier
        coefficient-ring
        coefficient-domain
        a1
        a2
        a3
        a4
        a6))))
(#theorem coordinate-norm-degree-cross-bound
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter constant-degree #pt-nat)
    (#parameter linear-degree #pt-nat)
    (#parameter constant-support (#pt-app (#pt-use ring-polynomial-support-from ()) Carrier coefficient-ring polynomial (#pt-succ constant-degree)))
    (#parameter linear-support (#pt-app (#pt-use ring-polynomial-support-from ()) Carrier coefficient-ring other-polynomial (#pt-succ linear-degree))))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-support-from ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-multiply ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-multiply ())
          Carrier
          coefficient-ring
          polynomial
          other-polynomial)
        (#pt-app (#pt-use weierstrass-coordinate-linear ()) Carrier coefficient-ring a1 a2 a3 a4 a6))
      (#pt-succ
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use add ()) constant-degree linear-degree)
          (#pt-numeral 1)))))
  (#proof
    (#pt-project
      conjunction
      0
      (#pt-app
        (#pt-use ring-polynomial-product-top ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-multiply ())
          Carrier
          coefficient-ring
          polynomial
          other-polynomial)
        (#pt-app (#pt-use weierstrass-coordinate-linear ()) Carrier coefficient-ring a1 a2 a3 a4 a6)
        (#pt-app (#pt-use add ()) constant-degree linear-degree)
        (#pt-numeral 1)
        (#pt-project
          conjunction
          0
          (#pt-app
            (#pt-use ring-polynomial-product-top ())
            Carrier
            coefficient-ring
            polynomial
            other-polynomial
            constant-degree
            linear-degree
            constant-support
            linear-support))
        (#pt-app
          (#pt-use ring-polynomial-degree-weierstrass-linear-bound ())
          Carrier
          coefficient-ring
          coefficient-domain
          a1
          a2
          a3
          a4
          a6)))))
