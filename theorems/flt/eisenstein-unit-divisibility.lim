; Units are exactly the actual divisors of one. Both directions
; retain explicit inverse/factor witnesses. Divisors of units, arbitrary
; unit divisibility and representation congruence follow constructively.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias eisenstein-unit = ./eisenstein-defs.lim::eisenstein-unit)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-commutative = ./eisenstein-ring.lim::eisenstein-multiply-commutative)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias exists = ./logic-exists.lim::exists)
(#alias
  eisenstein-divides-transitive
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-transitive)
(#alias eisenstein-one-divides = ./eisenstein-divisibility.lim::eisenstein-one-divides)
(#alias
  eisenstein-divides-congruent-divisor
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-congruent-divisor)
(#theorem eisenstein-unit-of-divides-one
  (#universes)
  (#parameters
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter divides-one (#pt-app (#pt-use eisenstein-divides ()) unit (#pt-use eisenstein-one ()))))
  (#statement (#pt-app (#pt-use eisenstein-unit ()) unit))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-use eisenstein-one ())
            (#pt-app (#pt-use eisenstein-multiply ()) unit candidate-factor))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-use eisenstein-one ())
                  (#pt-app (#pt-use eisenstein-multiply ()) unit candidate-factor))))))
        (#pt-app (#pt-use eisenstein-unit ()) unit))
      (
        (#pt-lambda
          (
            (inverse (#pt-use eisenstein ()))
            (factor-equivalence
              (#pt-app
                (#pt-use eisenstein-equal ())
                (#pt-use eisenstein-one ())
                (#pt-app (#pt-use eisenstein-multiply ()) unit inverse))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-inverse (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) unit candidate-inverse)
                    (#pt-use eisenstein-one ()))
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) candidate-inverse unit)
                    (#pt-use eisenstein-one ())))))
            introduce
            (inverse
              (#pt-app
                (#pt-use conjunction-introduce ())
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-multiply ()) unit inverse)
                  (#pt-use eisenstein-one ()))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-multiply ()) inverse unit)
                  (#pt-use eisenstein-one ()))
                (#pt-app
                  (#pt-use eisenstein-symmetric ())
                  (#pt-use eisenstein-one ())
                  (#pt-app (#pt-use eisenstein-multiply ()) unit inverse)
                  factor-equivalence)
                (#pt-app
                  (#pt-use eisenstein-transitive ())
                  (#pt-app (#pt-use eisenstein-multiply ()) inverse unit)
                  (#pt-app (#pt-use eisenstein-multiply ()) unit inverse)
                  (#pt-use eisenstein-one ())
                  (#pt-app (#pt-use eisenstein-multiply-commutative ()) inverse unit)
                  (#pt-app
                    (#pt-use eisenstein-symmetric ())
                    (#pt-use eisenstein-one ())
                    (#pt-app (#pt-use eisenstein-multiply ()) unit inverse)
                    factor-equivalence)))))))
      divides-one)))
(#theorem eisenstein-unit-divides-one
  (#universes)
  (#parameters
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter unit-proof (#pt-app (#pt-use eisenstein-unit ()) unit)))
  (#statement (#pt-app (#pt-use eisenstein-divides ()) unit (#pt-use eisenstein-one ())))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-inverse (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app (#pt-use eisenstein-multiply ()) unit candidate-inverse)
              (#pt-use eisenstein-one ()))
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app (#pt-use eisenstein-multiply ()) candidate-inverse unit)
              (#pt-use eisenstein-one ())))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-inverse (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) unit candidate-inverse)
                    (#pt-use eisenstein-one ()))
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) candidate-inverse unit)
                    (#pt-use eisenstein-one ())))))))
        (#pt-app (#pt-use eisenstein-divides ()) unit (#pt-use eisenstein-one ())))
      (
        (#pt-lambda
          (
            (inverse (#pt-use eisenstein ()))
            (inverse-certificate
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-multiply ()) unit inverse)
                  (#pt-use eisenstein-one ()))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-multiply ()) inverse unit)
                  (#pt-use eisenstein-one ())))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-use eisenstein-one ())
                  (#pt-app (#pt-use eisenstein-multiply ()) unit candidate-factor))))
            introduce
            (inverse
              (#pt-app
                (#pt-use eisenstein-symmetric ())
                (#pt-app (#pt-use eisenstein-multiply ()) unit inverse)
                (#pt-use eisenstein-one ())
                (#pt-app
                  (#pt-use conjunction-left ())
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) unit inverse)
                    (#pt-use eisenstein-one ()))
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) inverse unit)
                    (#pt-use eisenstein-one ()))
                  inverse-certificate))))))
      unit-proof)))
(#theorem eisenstein-divisor-of-unit-is-unit
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter unit-proof (#pt-app (#pt-use eisenstein-unit ()) unit))
    (#parameter divides-unit (#pt-app (#pt-use eisenstein-divides ()) divisor unit)))
  (#statement (#pt-app (#pt-use eisenstein-unit ()) divisor))
  (#proof
    (#pt-app
      (#pt-use eisenstein-unit-of-divides-one ())
      divisor
      (#pt-app
        (#pt-use eisenstein-divides-transitive ())
        divisor
        unit
        (#pt-use eisenstein-one ())
        divides-unit
        (#pt-app (#pt-use eisenstein-unit-divides-one ()) unit unit-proof)))))
(#theorem eisenstein-unit-divides-anything
  (#universes)
  (#parameters
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter number (#pt-use eisenstein ()))
    (#parameter unit-proof (#pt-app (#pt-use eisenstein-unit ()) unit)))
  (#statement (#pt-app (#pt-use eisenstein-divides ()) unit number))
  (#proof
    (#pt-app
      (#pt-use eisenstein-divides-transitive ())
      unit
      (#pt-use eisenstein-one ())
      number
      (#pt-app (#pt-use eisenstein-unit-divides-one ()) unit unit-proof)
      (#pt-app (#pt-use eisenstein-one-divides ()) number))))
(#theorem eisenstein-unit-congruent
  (#universes)
  (#parameters
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter inverse (#pt-use eisenstein ()))
    (#parameter equivalent (#pt-app (#pt-use eisenstein-equal ()) unit inverse))
    (#parameter unit-proof (#pt-app (#pt-use eisenstein-unit ()) unit)))
  (#statement (#pt-app (#pt-use eisenstein-unit ()) inverse))
  (#proof
    (#pt-app
      (#pt-use eisenstein-unit-of-divides-one ())
      inverse
      (#pt-app
        (#pt-use eisenstein-divides-congruent-divisor ())
        unit
        inverse
        (#pt-use eisenstein-one ())
        equivalent
        (#pt-app (#pt-use eisenstein-unit-divides-one ()) unit unit-proof)))))
