; Constructive infinite descent, needed by the source FLT exponent-four proof.
; Derived from the already checked strong induction theorem, for any Prop predicate.
; No decidability of an existential solution predicate or classical Nat.find is assumed.
; The mathematical descent construction itself must still be supplied as evidence.
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#alias strong-induction = ./natural-order.lim::strong-induction)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#theorem no-infinite-descent
  (#universes)
  (#parameters
    (#parameter property (#pt-pi ((candidate #pt-nat)) #pt-prop))
    (#parameter descend (#pt-pi ((witness #pt-nat) (witness-proof (#pt-app property witness))) (#pt-app (#pt-use exists (0)) #pt-nat (#pt-lambda ((smaller-candidate #pt-nat)) (#pt-app (#pt-use conjunction ()) (#pt-app (#pt-use less-than ()) smaller-candidate witness) (#pt-app property smaller-candidate)))))))
  (#statement
    (#pt-pi ((number #pt-nat)) (#pt-pi ((denied-proof (#pt-app property number))) #pt-false)))
  (#proof
    (#pt-app
      (#pt-use strong-induction ())
      (#pt-lambda ((index #pt-nat)) (#pt-pi ((denied-proof (#pt-app property index))) #pt-false))
      (#pt-lambda
        (
          (stage #pt-nat)
          (earlier-refutations
            (#pt-pi
              ((earlier #pt-nat) (earlier-proof (#pt-app (#pt-use less-than ()) earlier stage)))
              (#pt-pi ((denied-proof (#pt-app property earlier))) #pt-false)))
          (at-stage (#pt-app property stage)))
        (#pt-induct
          exists
          (0)
          (#pt-nat
            (#pt-lambda
              ((smaller-candidate #pt-nat))
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use less-than ()) smaller-candidate stage)
                (#pt-app property smaller-candidate))))
          (#pt-lambda
            (
              (descent-certificate
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((smaller-candidate #pt-nat))
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app (#pt-use less-than ()) smaller-candidate stage)
                      (#pt-app property smaller-candidate))))))
            #pt-false)
          (
            (#pt-lambda
              (
                (smaller-witness #pt-nat)
                (smaller-proof
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app (#pt-use less-than ()) smaller-witness stage)
                    (#pt-app property smaller-witness))))
              (#pt-app
                earlier-refutations
                smaller-witness
                (#pt-app
                  (#pt-use conjunction-left ())
                  (#pt-app (#pt-use less-than ()) smaller-witness stage)
                  (#pt-app property smaller-witness)
                  smaller-proof)
                (#pt-app
                  (#pt-use conjunction-right ())
                  (#pt-app (#pt-use less-than ()) smaller-witness stage)
                  (#pt-app property smaller-witness)
                  smaller-proof))))
          (#pt-app descend stage at-stage))))))
(#theorem descent-refutes-existence
  (#universes)
  (#parameters
    (#parameter property (#pt-pi ((candidate #pt-nat)) #pt-prop))
    (#parameter descend (#pt-pi ((witness #pt-nat) (witness-proof (#pt-app property witness))) (#pt-app (#pt-use exists (0)) #pt-nat (#pt-lambda ((smaller-candidate #pt-nat)) (#pt-app (#pt-use conjunction ()) (#pt-app (#pt-use less-than ()) smaller-candidate witness) (#pt-app property smaller-candidate))))))
    (#parameter found-witness (#pt-app (#pt-use exists (0)) #pt-nat property)))
  (#statement #pt-false)
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat property)
      (#pt-lambda
        ((existence-certificate (#pt-app (#pt-use exists (0)) #pt-nat property)))
        #pt-false)
      (
        (#pt-lambda
          ((witness #pt-nat) (at-witness (#pt-app property witness)))
          (#pt-app (#pt-app (#pt-use no-infinite-descent ()) property descend) witness at-witness)))
      found-witness)))
