(#theorem frey-package-two-divides-discriminant
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter package (#pt-app (#pt-use frey-package-certificate ()) exponent first second third))
    (#parameter integral-model (#pt-use integer-weierstrass-curve ()))
    (#parameter model-certificate (#pt-app (#pt-use integer-frey-model-certificate ()) first second exponent integral-model)))
  (#statement
    (#pt-app
      (#pt-use integer-divides ())
      (#pt-app (#pt-use integer-of-natural ()) (#pt-succ (#pt-succ #pt-zero)))
      (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-discriminant-index #pt-nat))
          (#pt-app
            (#pt-use exists (0))
            #pt-nat
            (#pt-lambda
              ((candidate-coordinate-index #pt-nat))
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app
                  (#pt-use integer-prime-order ())
                  (#pt-succ (#pt-succ #pt-zero))
                  candidate-discriminant-index
                  (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use integer-prime-order ())
                    (#pt-succ (#pt-succ #pt-zero))
                    candidate-coordinate-index
                    (#pt-app
                      (#pt-use integer-multiply ())
                      (#pt-app (#pt-use integer-multiply ()) first second)
                      third))
                  (#pt-eq
                    #pt-nat
                    (#pt-app (#pt-use add ()) candidate-discriminant-index (#pt-numeral 8))
                    (#pt-app
                      (#pt-use multiply ())
                      (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent)
                      candidate-coordinate-index))))))))
      (#pt-lambda
        (
          (valuation-existence
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-discriminant-index #pt-nat))
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((candidate-coordinate-index #pt-nat))
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app
                        (#pt-use integer-prime-order ())
                        (#pt-succ (#pt-succ #pt-zero))
                        candidate-discriminant-index
                        (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model))
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-app
                          (#pt-use integer-prime-order ())
                          (#pt-succ (#pt-succ #pt-zero))
                          candidate-coordinate-index
                          (#pt-app
                            (#pt-use integer-multiply ())
                            (#pt-app (#pt-use integer-multiply ()) first second)
                            third))
                        (#pt-eq
                          #pt-nat
                          (#pt-app (#pt-use add ()) candidate-discriminant-index (#pt-numeral 8))
                          (#pt-app
                            (#pt-use multiply ())
                            (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent)
                            candidate-coordinate-index))))))))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-succ (#pt-succ #pt-zero)))
          (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)))
      (
        (#pt-lambda
          (
            (discriminant-index #pt-nat)
            (coordinate-witnesses
              (#pt-app
                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((candidate-coordinate-index #pt-nat))
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app
                      (#pt-use integer-prime-order ())
                      (#pt-succ (#pt-succ #pt-zero))
                      discriminant-index
                      (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model))
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app
                        (#pt-use integer-prime-order ())
                        (#pt-succ (#pt-succ #pt-zero))
                        candidate-coordinate-index
                        (#pt-app
                          (#pt-use integer-multiply ())
                          (#pt-app (#pt-use integer-multiply ()) first second)
                          third))
                      (#pt-eq
                        #pt-nat
                        (#pt-app (#pt-use add ()) discriminant-index (#pt-numeral 8))
                        (#pt-app
                          (#pt-use multiply ())
                          (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent)
                          candidate-coordinate-index))))))))
          (#pt-induct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-coordinate-index #pt-nat))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use integer-prime-order ())
                    (#pt-succ (#pt-succ #pt-zero))
                    discriminant-index
                    (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model))
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app
                      (#pt-use integer-prime-order ())
                      (#pt-succ (#pt-succ #pt-zero))
                      candidate-coordinate-index
                      (#pt-app
                        (#pt-use integer-multiply ())
                        (#pt-app (#pt-use integer-multiply ()) first second)
                        third))
                    (#pt-eq
                      #pt-nat
                      (#pt-app (#pt-use add ()) discriminant-index (#pt-numeral 8))
                      (#pt-app
                        (#pt-use multiply ())
                        (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent)
                        candidate-coordinate-index))))))
            (#pt-lambda
              (
                (coordinate-existence
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((candidate-coordinate-index #pt-nat))
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-app
                          (#pt-use integer-prime-order ())
                          (#pt-succ (#pt-succ #pt-zero))
                          discriminant-index
                          (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model))
                        (#pt-app
                          (#pt-use conjunction ())
                          (#pt-app
                            (#pt-use integer-prime-order ())
                            (#pt-succ (#pt-succ #pt-zero))
                            candidate-coordinate-index
                            (#pt-app
                              (#pt-use integer-multiply ())
                              (#pt-app (#pt-use integer-multiply ()) first second)
                              third))
                          (#pt-eq
                            #pt-nat
                            (#pt-app (#pt-use add ()) discriminant-index (#pt-numeral 8))
                            (#pt-app
                              (#pt-use multiply ())
                              (#pt-app
                                (#pt-use multiply ())
                                (#pt-succ (#pt-succ #pt-zero))
                                exponent)
                              candidate-coordinate-index))))))))
              (#pt-app
                (#pt-use integer-divides ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-succ (#pt-succ #pt-zero)))
                (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)))
            (
              (#pt-lambda
                (
                  (coordinate-index #pt-nat)
                  (valuation-packet
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app
                        (#pt-use integer-prime-order ())
                        (#pt-succ (#pt-succ #pt-zero))
                        discriminant-index
                        (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model))
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-app
                          (#pt-use integer-prime-order ())
                          (#pt-succ (#pt-succ #pt-zero))
                          coordinate-index
                          (#pt-app
                            (#pt-use integer-multiply ())
                            (#pt-app (#pt-use integer-multiply ()) first second)
                            third))
                        (#pt-eq
                          #pt-nat
                          (#pt-app (#pt-use add ()) discriminant-index (#pt-numeral 8))
                          (#pt-app
                            (#pt-use multiply ())
                            (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent)
                            coordinate-index))))))
                (#pt-app
                  (#pt-use integer-prime-order-exponent-nondivisor-divides ())
                  (#pt-succ (#pt-succ #pt-zero))
                  (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)
                  discriminant-index
                  exponent
                  (#pt-project conjunction 0 valuation-packet)
                  (#pt-app
                    (#pt-use natural-shifted-valuation-nondivisible-above-four ())
                    exponent
                    discriminant-index
                    coordinate-index
                    (#pt-project conjunction 0 package)
                    (#pt-project conjunction 0 (#pt-project conjunction 1 package))
                    (#pt-project conjunction 1 (#pt-project conjunction 1 valuation-packet))))))
            coordinate-witnesses)))
      (#pt-app
        (#pt-use frey-package-has-local-valuations-at-two ())
        first
        second
        third
        exponent
        package
        integral-model
        model-certificate))))
(#theorem frey-package-coordinate-prime-divides-discriminant
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter package (#pt-app (#pt-use frey-package-certificate ()) exponent first second third))
    (#parameter integral-model (#pt-use integer-weierstrass-curve ()))
    (#parameter model-certificate (#pt-app (#pt-use integer-frey-model-certificate ()) first second exponent integral-model))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter coordinate-divides (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) (#pt-app (#pt-use integer-multiply ()) (#pt-app (#pt-use integer-multiply ()) first second) third))))
  (#statement
    (#pt-app
      (#pt-use integer-divides ())
      (#pt-app (#pt-use integer-of-natural ()) prime-number)
      (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-eq #pt-nat prime-number (#pt-succ (#pt-succ #pt-zero)))
      (#pt-pi
        ((denied-proof (#pt-eq #pt-nat prime-number (#pt-succ (#pt-succ #pt-zero)))))
        #pt-false)
      (#pt-app
        (#pt-use integer-divides ())
        (#pt-app (#pt-use integer-of-natural ()) prime-number)
        (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model))
      (#pt-lambda
        ((equal-two (#pt-eq #pt-nat prime-number (#pt-succ (#pt-succ #pt-zero)))))
        (#pt-eq-elim
          #pt-nat
          (#pt-succ (#pt-succ #pt-zero))
          (#pt-lambda
            (
              (transport-index #pt-nat)
              (transport-path (#pt-eq #pt-nat (#pt-succ (#pt-succ #pt-zero)) transport-index)))
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) transport-index)
              (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)))
          (#pt-app
            (#pt-use frey-package-two-divides-discriminant ())
            first
            second
            third
            exponent
            package
            integral-model
            model-certificate)
          prime-number
          (#pt-app
            (#pt-use symmetry (0))
            #pt-nat
            prime-number
            (#pt-succ (#pt-succ #pt-zero))
            equal-two)))
      (#pt-lambda
        (
          (not-two
            (#pt-pi
              ((denied-proof (#pt-eq #pt-nat prime-number (#pt-succ (#pt-succ #pt-zero)))))
              #pt-false)))
        (#pt-app
          (#pt-project
            conjunction
            1
            (#pt-app
              (#pt-use frey-package-prime-divisors-equivalent-away-two ())
              prime-number
              first
              second
              third
              exponent
              package
              integral-model
              model-certificate
              prime-proof
              not-two))
          coordinate-divides))
      (#pt-app (#pt-use natural-equality-decided ()) prime-number (#pt-succ (#pt-succ #pt-zero))))))
(#theorem frey-package-prime-divisors-equivalent
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter package (#pt-app (#pt-use frey-package-certificate ()) exponent first second third))
    (#parameter integral-model (#pt-use integer-weierstrass-curve ()))
    (#parameter model-certificate (#pt-app (#pt-use integer-frey-model-certificate ()) first second exponent integral-model))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number)))
  (#statement
    (#pt-app
      (#pt-use conjunction ())
      (#pt-pi
        (
          (discriminant-divides
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) prime-number)
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            third)))
      (#pt-pi
        (
          (coordinate-divides
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-multiply ()) first second)
                third))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) prime-number)
          (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)))))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-pi
        (
          (discriminant-divides
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) prime-number)
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            third)))
      (#pt-pi
        (
          (coordinate-divides
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-multiply ()) first second)
                third))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) prime-number)
          (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)))
      (#pt-lambda
        (
          (discriminant-divides
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model))))
        (#pt-app
          (#pt-use frey-package-integral-discriminant-prime-divisor ())
          prime-number
          first
          second
          third
          exponent
          package
          integral-model
          model-certificate
          prime-proof
          discriminant-divides))
      (#pt-lambda
        (
          (coordinate-divides
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-multiply ()) first second)
                third))))
        (#pt-app
          (#pt-use frey-package-coordinate-prime-divides-discriminant ())
          prime-number
          first
          second
          third
          exponent
          package
          integral-model
          model-certificate
          prime-proof
          coordinate-divides)))))
