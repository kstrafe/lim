; Prime product and power divisibility for arbitrary signed representatives.
; Reduce through proved magnitudes to the checked natural prime theorems.
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias power = ../fermat_statement.lim::power)
(#alias exists = ./logic-exists.lim::exists)
(#alias prime = ./natural-prime.lim::prime)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias prime-divides-product = ./natural-prime-divisibility.lim::prime-divides-product)
(#alias prime-divides-power = ./natural-prime-divisibility.lim::prime-divides-power)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-zero = ./integer-defs.lim::integer-zero)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-cube = ./integer-defs.lim::integer-cube)
(#alias integer-power = ./integer-defs.lim::integer-power)
(#alias integer-divides = ./integer-defs.lim::integer-divides)
(#alias integer-magnitude = ./integer-magnitude.lim::integer-magnitude)
(#alias integer-magnitude-exists = ./integer-magnitude.lim::integer-magnitude-exists)
(#alias integer-magnitude-multiply = ./integer-magnitude-products.lim::integer-magnitude-multiply)
(#alias integer-magnitude-power = ./integer-magnitude-products.lim::integer-magnitude-power)
(#alias integer-divides-magnitude = ./integer-magnitude.lim::integer-divides-magnitude)
(#alias integer-divides-of-magnitude = ./integer-magnitude.lim::integer-divides-of-magnitude)
(#alias integer-power-three-as-cube = ./integer-cube-normalization.lim::integer-power-three-as-cube)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias
  integer-divides-congruent-target
  =
  ./integer-divisibility.lim::integer-divides-congruent-target)
(#alias integer-divides-transitive = ./integer-divisibility.lim::integer-divides-transitive)
(#alias integer-divides-multiple = ./integer-divisibility.lim::integer-divides-multiple)
(#alias integer-divides-add = ./integer-divisibility-addition.lim::integer-divides-add)
(#alias
  integer-divides-zero-sum-other
  =
  ./integer-divisibility-addition.lim::integer-divides-zero-sum-other)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-left = ./logical-connectives.lim::disjunction-left)
(#alias disjunction-right = ./logical-connectives.lim::disjunction-right)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#theorem integer-prime-divides-product
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter product-divides (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) (#pt-app (#pt-use integer-multiply ()) first second))))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app
        (#pt-use integer-divides ())
        (#pt-app (#pt-use integer-of-natural ()) prime-number)
        first)
      (#pt-app
        (#pt-use integer-divides ())
        (#pt-app (#pt-use integer-of-natural ()) prime-number)
        second)))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-magnitude #pt-nat))
          (#pt-app (#pt-use integer-magnitude ()) first candidate-magnitude)))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-magnitude #pt-nat))
                (#pt-app (#pt-use integer-magnitude ()) first candidate-magnitude)))))
        (#pt-app
          (#pt-use disjunction ())
          (#pt-app
            (#pt-use integer-divides ())
            (#pt-app (#pt-use integer-of-natural ()) prime-number)
            first)
          (#pt-app
            (#pt-use integer-divides ())
            (#pt-app (#pt-use integer-of-natural ()) prime-number)
            second)))
      (
        (#pt-lambda
          (
            (first-magnitude #pt-nat)
            (first-magnitude-proof (#pt-app (#pt-use integer-magnitude ()) first first-magnitude)))
          (#pt-induct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-magnitude #pt-nat))
                (#pt-app (#pt-use integer-magnitude ()) second candidate-magnitude)))
            (#pt-lambda
              (
                (certificate
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((candidate-magnitude #pt-nat))
                      (#pt-app (#pt-use integer-magnitude ()) second candidate-magnitude)))))
              (#pt-app
                (#pt-use disjunction ())
                (#pt-app
                  (#pt-use integer-divides ())
                  (#pt-app (#pt-use integer-of-natural ()) prime-number)
                  first)
                (#pt-app
                  (#pt-use integer-divides ())
                  (#pt-app (#pt-use integer-of-natural ()) prime-number)
                  second)))
            (
              (#pt-lambda
                (
                  (second-magnitude #pt-nat)
                  (second-magnitude-proof
                    (#pt-app (#pt-use integer-magnitude ()) second second-magnitude)))
                (#pt-app
                  (#pt-use disjunction-eliminate ())
                  (#pt-app (#pt-use divides ()) prime-number first-magnitude)
                  (#pt-app (#pt-use divides ()) prime-number second-magnitude)
                  (#pt-app
                    (#pt-use disjunction ())
                    (#pt-app
                      (#pt-use integer-divides ())
                      (#pt-app (#pt-use integer-of-natural ()) prime-number)
                      first)
                    (#pt-app
                      (#pt-use integer-divides ())
                      (#pt-app (#pt-use integer-of-natural ()) prime-number)
                      second))
                  (#pt-lambda
                    (
                      (first-natural-divides
                        (#pt-app (#pt-use divides ()) prime-number first-magnitude)))
                    (#pt-app
                      (#pt-use disjunction-left ())
                      (#pt-app
                        (#pt-use integer-divides ())
                        (#pt-app (#pt-use integer-of-natural ()) prime-number)
                        first)
                      (#pt-app
                        (#pt-use integer-divides ())
                        (#pt-app (#pt-use integer-of-natural ()) prime-number)
                        second)
                      (#pt-app
                        (#pt-use integer-divides-of-magnitude ())
                        prime-number
                        first
                        first-magnitude
                        first-magnitude-proof
                        first-natural-divides)))
                  (#pt-lambda
                    (
                      (second-natural-divides
                        (#pt-app (#pt-use divides ()) prime-number second-magnitude)))
                    (#pt-app
                      (#pt-use disjunction-right ())
                      (#pt-app
                        (#pt-use integer-divides ())
                        (#pt-app (#pt-use integer-of-natural ()) prime-number)
                        first)
                      (#pt-app
                        (#pt-use integer-divides ())
                        (#pt-app (#pt-use integer-of-natural ()) prime-number)
                        second)
                      (#pt-app
                        (#pt-use integer-divides-of-magnitude ())
                        prime-number
                        second
                        second-magnitude
                        second-magnitude-proof
                        second-natural-divides)))
                  (#pt-app
                    (#pt-use prime-divides-product ())
                    prime-number
                    first-magnitude
                    second-magnitude
                    prime-proof
                    (#pt-app
                      (#pt-use integer-divides-magnitude ())
                      prime-number
                      (#pt-app (#pt-use integer-multiply ()) first second)
                      (#pt-app (#pt-use multiply ()) first-magnitude second-magnitude)
                      (#pt-app
                        (#pt-use integer-magnitude-multiply ())
                        first
                        second
                        first-magnitude
                        second-magnitude
                        first-magnitude-proof
                        second-magnitude-proof)
                      product-divides)))))
            (#pt-app (#pt-use integer-magnitude-exists ()) second))))
      (#pt-app (#pt-use integer-magnitude-exists ()) first))))
(#theorem integer-prime-divides-power
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter first (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter power-divides (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) (#pt-app (#pt-use integer-power ()) first exponent))))
  (#statement
    (#pt-app
      (#pt-use integer-divides ())
      (#pt-app (#pt-use integer-of-natural ()) prime-number)
      first))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-magnitude #pt-nat))
          (#pt-app (#pt-use integer-magnitude ()) first candidate-magnitude)))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-magnitude #pt-nat))
                (#pt-app (#pt-use integer-magnitude ()) first candidate-magnitude)))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) prime-number)
          first))
      (
        (#pt-lambda
          (
            (first-magnitude #pt-nat)
            (magnitude-proof (#pt-app (#pt-use integer-magnitude ()) first first-magnitude)))
          (#pt-app
            (#pt-use integer-divides-of-magnitude ())
            prime-number
            first
            first-magnitude
            magnitude-proof
            (#pt-app
              (#pt-use prime-divides-power ())
              prime-number
              first-magnitude
              exponent
              prime-proof
              (#pt-app
                (#pt-use integer-divides-magnitude ())
                prime-number
                (#pt-app (#pt-use integer-power ()) first exponent)
                (#pt-app (#pt-use power ()) first-magnitude exponent)
                (#pt-app
                  (#pt-use integer-magnitude-power ())
                  first
                  first-magnitude
                  exponent
                  magnitude-proof)
                power-divides)))))
      (#pt-app (#pt-use integer-magnitude-exists ()) first))))
(#theorem integer-prime-divides-cube
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter first (#pt-use integer ()))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter cube-divides (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) (#pt-app (#pt-use integer-cube ()) first))))
  (#statement
    (#pt-app
      (#pt-use integer-divides ())
      (#pt-app (#pt-use integer-of-natural ()) prime-number)
      first))
  (#proof
    (#pt-app
      (#pt-use integer-prime-divides-power ())
      prime-number
      first
      (#pt-numeral 3)
      prime-proof
      (#pt-app
        (#pt-use integer-divides-congruent-target ())
        (#pt-app (#pt-use integer-of-natural ()) prime-number)
        (#pt-app (#pt-use integer-cube ()) first)
        (#pt-app (#pt-use integer-power ()) first (#pt-numeral 3))
        (#pt-app
          (#pt-use integer-symmetric ())
          (#pt-app (#pt-use integer-power ()) first (#pt-numeral 3))
          (#pt-app (#pt-use integer-cube ()) first)
          (#pt-app (#pt-use integer-power-three-as-cube ()) first))
        cube-divides))))
(#theorem integer-prime-common-cubes-third
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter first-divides (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) first))
    (#parameter second-divides (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) second))
    (#parameter cubic-sum-zero (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-cube ()) first) (#pt-app (#pt-use integer-cube ()) second)) (#pt-app (#pt-use integer-cube ()) third)) (#pt-use integer-zero ()))))
  (#statement
    (#pt-app
      (#pt-use integer-divides ())
      (#pt-app (#pt-use integer-of-natural ()) prime-number)
      third))
  (#proof
    (#pt-app
      (#pt-use integer-prime-divides-cube ())
      prime-number
      third
      prime-proof
      (#pt-app
        (#pt-use integer-divides-zero-sum-other ())
        (#pt-app (#pt-use integer-of-natural ()) prime-number)
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app (#pt-use integer-cube ()) first)
          (#pt-app (#pt-use integer-cube ()) second))
        (#pt-app (#pt-use integer-cube ()) third)
        (#pt-app
          (#pt-use integer-divides-add ())
          (#pt-app (#pt-use integer-of-natural ()) prime-number)
          (#pt-app (#pt-use integer-cube ()) first)
          (#pt-app (#pt-use integer-cube ()) second)
          (#pt-app
            (#pt-use integer-divides-transitive ())
            (#pt-app (#pt-use integer-of-natural ()) prime-number)
            first
            (#pt-app (#pt-use integer-cube ()) first)
            first-divides
            (#pt-app
              (#pt-use integer-divides-multiple ())
              first
              (#pt-app (#pt-use integer-multiply ()) first first)))
          (#pt-app
            (#pt-use integer-divides-transitive ())
            (#pt-app (#pt-use integer-of-natural ()) prime-number)
            second
            (#pt-app (#pt-use integer-cube ()) second)
            second-divides
            (#pt-app
              (#pt-use integer-divides-multiple ())
              second
              (#pt-app (#pt-use integer-multiply ()) second second))))
        cubic-sum-zero))))
