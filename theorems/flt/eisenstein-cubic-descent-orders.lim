; Actual predecessor orders for FLT/Three.lean:713-733.
; A previous order above one gives a positive, strictly smaller
; predecessor. A lambda-powered free residual has that exact order,
; is nonzero, and is actually divisible by lambda at positive order.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-lambda = ./eisenstein-defs.lim::eisenstein-lambda)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-power = ./eisenstein-defs.lim::eisenstein-power)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias eisenstein-reflexive = ./eisenstein-equality.lim::eisenstein-reflexive)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-associative = ./eisenstein-ring.lim::eisenstein-multiply-associative)
(#alias eisenstein-lambda-order = ./eisenstein-lambda-order.lim::eisenstein-lambda-order)
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#alias less-than-successor = ./natural-order.lim::less-than-successor)
(#alias successor-less-reflect = ./natural-discrete-order.lim::successor-less-reflect)
(#alias substitution = ./equality.lim::substitution)
(#alias symmetry = ./equality.lim::symmetry)
(#alias
  eisenstein-lambda-order-of-residual
  =
  ./eisenstein-lambda-factor.lim::eisenstein-lambda-order-of-residual)
(#alias
  eisenstein-lambda-order-nonzero
  =
  ./eisenstein-lambda-order.lim::eisenstein-lambda-order-nonzero)
(#theorem natural-cubic-predecessor-positive
  (#universes)
  (#parameters
    (#parameter previous-order #pt-nat)
    (#parameter predecessor #pt-nat)
    (#parameter previous-large (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) previous-order))
    (#parameter predecessor-equation (#pt-eq #pt-nat previous-order (#pt-succ predecessor))))
  (#statement (#pt-app (#pt-use less-than ()) #pt-zero predecessor))
  (#proof
    (#pt-app
      (#pt-use successor-less-reflect ())
      #pt-zero
      predecessor
      (#pt-app
        (#pt-use substitution (0))
        #pt-nat
        (#pt-lambda
          ((endpoint #pt-nat))
          (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) endpoint))
        previous-order
        (#pt-succ predecessor)
        predecessor-equation
        previous-large))))
(#theorem natural-cubic-predecessor-smaller
  (#universes)
  (#parameters
    (#parameter previous-order #pt-nat)
    (#parameter predecessor #pt-nat)
    (#parameter predecessor-equation (#pt-eq #pt-nat previous-order (#pt-succ predecessor))))
  (#statement (#pt-app (#pt-use less-than ()) predecessor previous-order))
  (#proof
    (#pt-app
      (#pt-use substitution (0))
      #pt-nat
      (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use less-than ()) predecessor endpoint))
      (#pt-succ predecessor)
      previous-order
      (#pt-app
        (#pt-use symmetry (0))
        #pt-nat
        previous-order
        (#pt-succ predecessor)
        predecessor-equation)
      (#pt-app (#pt-use less-than-successor ()) predecessor))))
(#theorem eisenstein-positive-lambda-power-product-divides
  (#universes)
  (#parameters
    (#parameter predecessor #pt-nat)
    (#parameter residual (#pt-use eisenstein ()))
    (#parameter positive-order (#pt-app (#pt-use less-than ()) #pt-zero predecessor)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-divides ())
      (#pt-use eisenstein-lambda ())
      (#pt-app
        (#pt-use eisenstein-multiply ())
        (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) predecessor)
        residual)))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda ((candidate-gap #pt-nat)) (#pt-eq #pt-nat predecessor (#pt-succ candidate-gap))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-gap #pt-nat))
                (#pt-eq #pt-nat predecessor (#pt-succ candidate-gap))))))
        (#pt-app
          (#pt-use eisenstein-divides ())
          (#pt-use eisenstein-lambda ())
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) predecessor)
            residual)))
      (
        (#pt-lambda
          (
            (predecessor-gap #pt-nat)
            (order-equation (#pt-eq #pt-nat predecessor (#pt-succ predecessor-gap))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app
                      (#pt-use eisenstein-power ())
                      (#pt-use eisenstein-lambda ())
                      predecessor)
                    residual)
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-use eisenstein-lambda ())
                    candidate-factor))))
            introduce
            (
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-use eisenstein-lambda ())
                  predecessor-gap)
                residual)
              (#pt-app
                (#pt-use eisenstein-transitive ())
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) predecessor)
                  residual)
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app
                    (#pt-use eisenstein-power ())
                    (#pt-use eisenstein-lambda ())
                    (#pt-succ predecessor-gap))
                  residual)
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app
                      (#pt-use eisenstein-power ())
                      (#pt-use eisenstein-lambda ())
                      predecessor-gap)
                    residual))
                (#pt-app
                  (#pt-use substitution (0))
                  #pt-nat
                  (#pt-lambda
                    ((endpoint #pt-nat))
                    (#pt-app
                      (#pt-use eisenstein-equal ())
                      (#pt-app
                        (#pt-use eisenstein-multiply ())
                        (#pt-app
                          (#pt-use eisenstein-power ())
                          (#pt-use eisenstein-lambda ())
                          predecessor)
                        residual)
                      (#pt-app
                        (#pt-use eisenstein-multiply ())
                        (#pt-app
                          (#pt-use eisenstein-power ())
                          (#pt-use eisenstein-lambda ())
                          endpoint)
                        residual)))
                  predecessor
                  (#pt-succ predecessor-gap)
                  order-equation
                  (#pt-app
                    (#pt-use eisenstein-reflexive ())
                    (#pt-app
                      (#pt-use eisenstein-multiply ())
                      (#pt-app
                        (#pt-use eisenstein-power ())
                        (#pt-use eisenstein-lambda ())
                        predecessor)
                      residual)))
                (#pt-app
                  (#pt-use eisenstein-multiply-associative ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-app
                    (#pt-use eisenstein-power ())
                    (#pt-use eisenstein-lambda ())
                    predecessor-gap)
                  residual))))))
      positive-order)))
(#theorem eisenstein-lambda-powered-free-residual-order
  (#universes)
  (#parameters
    (#parameter predecessor #pt-nat)
    (#parameter residual (#pt-use eisenstein ()))
    (#parameter residual-lambda-free (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) residual))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-lambda-order ())
      (#pt-app
        (#pt-use eisenstein-multiply ())
        (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) predecessor)
        residual)
      predecessor))
  (#proof
    (#pt-app
      (#pt-use eisenstein-lambda-order-of-residual ())
      (#pt-app
        (#pt-use eisenstein-multiply ())
        (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) predecessor)
        residual)
      predecessor
      residual
      (#pt-app
        (#pt-use eisenstein-reflexive ())
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) predecessor)
          residual))
      residual-lambda-free)))
(#theorem eisenstein-lambda-powered-free-residual-nonzero
  (#universes)
  (#parameters
    (#parameter predecessor #pt-nat)
    (#parameter residual (#pt-use eisenstein ()))
    (#parameter residual-lambda-free (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) residual))) #pt-false)))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) predecessor)
              residual)
            (#pt-use eisenstein-zero ()))))
      #pt-false))
  (#proof
    (#pt-app
      (#pt-use eisenstein-lambda-order-nonzero ())
      (#pt-app
        (#pt-use eisenstein-multiply ())
        (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) predecessor)
        residual)
      predecessor
      (#pt-app
        (#pt-use eisenstein-lambda-powered-free-residual-order ())
        predecessor
        residual
        residual-lambda-free))))
