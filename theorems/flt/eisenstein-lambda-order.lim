(#alias strong-induction = ./natural-order.lim::strong-induction)
(#alias add = ../fermat_statement.lim::add)
(#math-inductive eisenstein-lambda-order ()
  ((number (#pt-use eisenstein ())) (exponent #pt-nat))
  #pt-prop
  (
    (introduce
      (
        (power-divides
          (#pt-app
            (#pt-use eisenstein-divides ())
            (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) exponent)
            number))
        (next-not-divides
          (#pt-pi
            (
              (denied-proof
                (#pt-app
                  (#pt-use eisenstein-divides ())
                  (#pt-app
                    (#pt-use eisenstein-power ())
                    (#pt-use eisenstein-lambda ())
                    (#pt-succ exponent))
                  number)))
            #pt-false))))))
(#theorem eisenstein-lambda-order-excludes-higher
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter exponent #pt-nat)
    (#parameter other-exponent #pt-nat)
    (#parameter order-proof (#pt-app (#pt-use eisenstein-lambda-order ()) number exponent))
    (#parameter higher-exponent (#pt-app (#pt-use less-than ()) exponent other-exponent)))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use eisenstein-divides ())
            (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) other-exponent)
            number)))
      #pt-false))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-gap #pt-nat))
          (#pt-eq
            #pt-nat
            other-exponent
            (#pt-app (#pt-use add ()) (#pt-succ exponent) candidate-gap))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-gap #pt-nat))
                (#pt-eq
                  #pt-nat
                  other-exponent
                  (#pt-app (#pt-use add ()) (#pt-succ exponent) candidate-gap))))))
        (#pt-pi
          (
            (denied-proof
              (#pt-app
                (#pt-use eisenstein-divides ())
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-use eisenstein-lambda ())
                  other-exponent)
                number)))
          #pt-false))
      (
        (#pt-lambda
          (
            (gap #pt-nat)
            (position
              (#pt-eq #pt-nat other-exponent (#pt-app (#pt-use add ()) (#pt-succ exponent) gap))))
          (#pt-lambda
            (
              (higher-divides
                (#pt-app
                  (#pt-use eisenstein-divides ())
                  (#pt-app
                    (#pt-use eisenstein-power ())
                    (#pt-use eisenstein-lambda ())
                    other-exponent)
                  number)))
            (#pt-app
              (#pt-project eisenstein-lambda-order 1 order-proof)
              (#pt-app
                (#pt-use eisenstein-divides-transitive ())
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-succ exponent))
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-use eisenstein-lambda ())
                  other-exponent)
                number
                (#pt-app
                  (#pt-use substitution (0))
                  #pt-nat
                  (#pt-lambda
                    ((endpoint #pt-nat))
                    (#pt-app
                      (#pt-use eisenstein-divides ())
                      (#pt-app
                        (#pt-use eisenstein-power ())
                        (#pt-use eisenstein-lambda ())
                        (#pt-succ exponent))
                      (#pt-app
                        (#pt-use eisenstein-power ())
                        (#pt-use eisenstein-lambda ())
                        endpoint)))
                  (#pt-app (#pt-use add ()) (#pt-succ exponent) gap)
                  other-exponent
                  (#pt-app
                    (#pt-use symmetry (0))
                    #pt-nat
                    other-exponent
                    (#pt-app (#pt-use add ()) (#pt-succ exponent) gap)
                    position)
                  (#pt-app
                    (#pt-use eisenstein-power-divides-add ())
                    (#pt-use eisenstein-lambda ())
                    (#pt-succ exponent)
                    gap))
                higher-divides)))))
      higher-exponent)))
(#theorem eisenstein-lambda-order-unique
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter exponent #pt-nat)
    (#parameter other-exponent #pt-nat)
    (#parameter first-order (#pt-app (#pt-use eisenstein-lambda-order ()) number exponent))
    (#parameter second-order (#pt-app (#pt-use eisenstein-lambda-order ()) number other-exponent)))
  (#statement (#pt-eq #pt-nat exponent other-exponent))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use less-than ()) exponent other-exponent)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-eq #pt-nat exponent other-exponent)
        (#pt-app (#pt-use less-than ()) other-exponent exponent))
      (#pt-eq #pt-nat exponent other-exponent)
      (#pt-lambda
        ((first-less (#pt-app (#pt-use less-than ()) exponent other-exponent)))
        (#pt-app
          (#pt-use false-elimination ())
          (#pt-eq #pt-nat exponent other-exponent)
          (#pt-app
            (#pt-app
              (#pt-use eisenstein-lambda-order-excludes-higher ())
              number
              exponent
              other-exponent
              first-order
              first-less)
            (#pt-project eisenstein-lambda-order 0 second-order))))
      (#pt-lambda
        (
          (not-first-less
            (#pt-app
              (#pt-use disjunction ())
              (#pt-eq #pt-nat exponent other-exponent)
              (#pt-app (#pt-use less-than ()) other-exponent exponent))))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-eq #pt-nat exponent other-exponent)
          (#pt-app (#pt-use less-than ()) other-exponent exponent)
          (#pt-eq #pt-nat exponent other-exponent)
          (#pt-lambda ((same-exponent (#pt-eq #pt-nat exponent other-exponent))) same-exponent)
          (#pt-lambda
            ((second-less (#pt-app (#pt-use less-than ()) other-exponent exponent)))
            (#pt-app
              (#pt-use false-elimination ())
              (#pt-eq #pt-nat exponent other-exponent)
              (#pt-app
                (#pt-app
                  (#pt-use eisenstein-lambda-order-excludes-higher ())
                  number
                  other-exponent
                  exponent
                  second-order
                  second-less)
                (#pt-project eisenstein-lambda-order 0 first-order))))
          not-first-less))
      (#pt-app (#pt-use natural-trichotomy ()) exponent other-exponent))))
(#theorem eisenstein-lambda-order-congruent
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter other (#pt-use eisenstein ()))
    (#parameter exponent #pt-nat)
    (#parameter equivalent (#pt-app (#pt-use eisenstein-equal ()) number other))
    (#parameter order-proof (#pt-app (#pt-use eisenstein-lambda-order ()) number exponent)))
  (#statement (#pt-app (#pt-use eisenstein-lambda-order ()) other exponent))
  (#proof
    (#pt-construct
      eisenstein-lambda-order
      ()
      (other exponent)
      introduce
      (
        (#pt-app
          (#pt-use eisenstein-divides-congruent-target ())
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) exponent)
          number
          other
          equivalent
          (#pt-project eisenstein-lambda-order 0 order-proof))
        (#pt-lambda
          (
            (next-divides
              (#pt-app
                (#pt-use eisenstein-divides ())
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-succ exponent))
                other)))
          (#pt-app
            (#pt-project eisenstein-lambda-order 1 order-proof)
            (#pt-app
              (#pt-use eisenstein-divides-congruent-target ())
              (#pt-app
                (#pt-use eisenstein-power ())
                (#pt-use eisenstein-lambda ())
                (#pt-succ exponent))
              other
              number
              (#pt-app (#pt-use eisenstein-symmetric ()) number other equivalent)
              next-divides)))))))
(#theorem eisenstein-lambda-order-nonzero
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter exponent #pt-nat)
    (#parameter order-proof (#pt-app (#pt-use eisenstein-lambda-order ()) number exponent)))
  (#statement
    (#pt-pi
      ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ()))))
      #pt-false))
  (#proof
    (#pt-lambda
      ((number-zero (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ()))))
      (#pt-app
        (#pt-project eisenstein-lambda-order 1 order-proof)
        (#pt-app
          (#pt-use eisenstein-divides-congruent-target ())
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-succ exponent))
          (#pt-use eisenstein-zero ())
          number
          (#pt-app
            (#pt-use eisenstein-symmetric ())
            number
            (#pt-use eisenstein-zero ())
            number-zero)
          (#pt-app
            (#pt-use eisenstein-divides-zero ())
            (#pt-app
              (#pt-use eisenstein-power ())
              (#pt-use eisenstein-lambda ())
              (#pt-succ exponent))))))))
(#theorem eisenstein-lambda-order-one
  (#universes)
  (#parameters)
  (#statement (#pt-app (#pt-use eisenstein-lambda-order ()) (#pt-use eisenstein-one ()) #pt-zero))
  (#proof
    (#pt-construct
      eisenstein-lambda-order
      ()
      ((#pt-use eisenstein-one ()) #pt-zero)
      introduce
      (
        (#pt-app (#pt-use eisenstein-one-divides ()) (#pt-use eisenstein-one ()))
        (#pt-lambda
          (
            (next-divides
              (#pt-app
                (#pt-use eisenstein-divides ())
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-succ #pt-zero))
                (#pt-use eisenstein-one ()))))
          (#pt-app
            (#pt-use eisenstein-lambda-not-divides-one ())
            (#pt-app
              (#pt-use eisenstein-divides-congruent-divisor ())
              (#pt-app
                (#pt-use eisenstein-power ())
                (#pt-use eisenstein-lambda ())
                (#pt-succ #pt-zero))
              (#pt-use eisenstein-lambda ())
              (#pt-use eisenstein-one ())
              (#pt-app (#pt-use eisenstein-power-one ()) (#pt-use eisenstein-lambda ()))
              next-divides)))))))
(#theorem eisenstein-lambda-order-step
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter exponent #pt-nat)
    (#parameter order-proof (#pt-app (#pt-use eisenstein-lambda-order ()) number exponent)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-lambda-order ())
      (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) number)
      (#pt-succ exponent)))
  (#proof
    (#pt-construct
      eisenstein-lambda-order
      ()
      (
        (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) number)
        (#pt-succ exponent))
      introduce
      (
        (#pt-app
          (#pt-use eisenstein-power-divides-product-raise ())
          (#pt-use eisenstein-lambda ())
          exponent
          number
          (#pt-project eisenstein-lambda-order 0 order-proof))
        (#pt-lambda
          (
            (next-divides
              (#pt-app
                (#pt-use eisenstein-divides ())
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-succ (#pt-succ exponent)))
                (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) number))))
          (#pt-app
            (#pt-project eisenstein-lambda-order 1 order-proof)
            (#pt-app
              (#pt-use eisenstein-lambda-power-divides-product-cancel ())
              (#pt-succ exponent)
              number
              next-divides)))))))
(#theorem eisenstein-lambda-order-exists
