; Adapted mathematical source: pinned Mathlib RingTheory/Ideal/Operations.lean
; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean.
; Generated by scripts/generate-flt-point-ideal-products.py; checked native terms.
; Unpack only the actual curve
; and Jacobian certificates to prove the source opposite
; point-ideal identity for a checked field. No ideal
; product conclusion is encoded in nonsingularity data.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias
  coordinate-point-ideal-X-class
  =
  ./coordinate-point-ideal-data.lim::coordinate-point-ideal-X-class)
(#alias coordinate-point-ideal-XY = ./coordinate-point-ideal-data.lim::coordinate-point-ideal-XY)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias
  point-ideal-product-field-data
  =
  ./point-ideal-product-field-data.lim::point-ideal-product-field-data)
(#alias
  point-ideal-product-negative-y
  =
  ./point-ideal-product-model-partials.lim::point-ideal-product-negative-y)
(#alias
  point-ideal-product-nonsingular
  =
  ./point-ideal-product-nonsingular-data.lim::point-ideal-product-nonsingular)
(#alias
  point-ideal-product-weierstrass-opposite
  =
  ./point-ideal-product-weierstrass-opposite.lim::point-ideal-product-weierstrass-opposite)
(#alias quadratic-element = ./quadratic-algebra-data.lim::quadratic-element)
(#alias ring-ideal-equal = ./ring-ideal-data.lim::ring-ideal-equal)
(#alias ring-ideal-principal = ./ring-ideal-principal.lim::ring-ideal-principal)
(#alias ring-ideal-product = ./ring-ideal-product.lim::ring-ideal-product)
(#alias
  weierstrass-coordinate-cubic
  =
  ./weierstrass-coordinate-normal-form.lim::weierstrass-coordinate-cubic)
(#alias
  weierstrass-coordinate-linear
  =
  ./weierstrass-coordinate-normal-form.lim::weierstrass-coordinate-linear)
(#alias
  weierstrass-coordinate-ring
  =
  ./weierstrass-coordinate-normal-form.lim::weierstrass-coordinate-ring)
(#theorem point-ideal-product-nonsingular-opposite
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter root Carrier)
    (#parameter ordinate Carrier)
    (#parameter field-data (#pt-app (#pt-use point-ideal-product-field-data ()) Carrier coefficient-ring))
    (#parameter nonsingular-point (#pt-app (#pt-use point-ideal-product-nonsingular ()) Carrier coefficient-ring a1 a2 a3 a4 a6 root ordinate)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
      (#pt-app (#pt-use weierstrass-coordinate-ring ()) Carrier coefficient-ring a1 a2 a3 a4 a6)
      (#pt-app
        (#pt-use ring-ideal-product ())
        (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
        (#pt-app (#pt-use weierstrass-coordinate-ring ()) Carrier coefficient-ring a1 a2 a3 a4 a6)
        (#pt-app
          (#pt-use coordinate-point-ideal-XY ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use weierstrass-coordinate-linear ())
            Carrier
            coefficient-ring
            a1
            a2
            a3
            a4
            a6)
          (#pt-app
            (#pt-use weierstrass-coordinate-cubic ())
            Carrier
            coefficient-ring
            a1
            a2
            a3
            a4
            a6)
          root
          (#pt-construct
            finite-list
            ()
            (Carrier)
            cons
            (
              (#pt-app
                (#pt-use point-ideal-product-negative-y ())
                Carrier
                coefficient-ring
                a1
                a2
                a3
                a4
                a6
                root
                ordinate)
              (#pt-construct finite-list () (Carrier) nil ()))))
        (#pt-app
          (#pt-use coordinate-point-ideal-XY ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use weierstrass-coordinate-linear ())
            Carrier
            coefficient-ring
            a1
            a2
            a3
            a4
            a6)
          (#pt-app
            (#pt-use weierstrass-coordinate-cubic ())
            Carrier
            coefficient-ring
            a1
            a2
            a3
            a4
            a6)
          root
          (#pt-construct
            finite-list
            ()
            (Carrier)
            cons
            (ordinate (#pt-construct finite-list () (Carrier) nil ())))))
      (#pt-app
        (#pt-use ring-ideal-principal ())
        (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
        (#pt-app (#pt-use weierstrass-coordinate-ring ()) Carrier coefficient-ring a1 a2 a3 a4 a6)
        (#pt-app (#pt-use coordinate-point-ideal-X-class ()) Carrier coefficient-ring root))))
  (#proof
    (#pt-app
      (#pt-use point-ideal-product-weierstrass-opposite ())
      Carrier
      coefficient-ring
      a1
      a2
      a3
      a4
      a6
      root
      ordinate
      (#pt-project conjunction 0 nonsingular-point)
      field-data
      (#pt-project conjunction 1 nonsingular-point))))
