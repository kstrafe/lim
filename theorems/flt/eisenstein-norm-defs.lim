; Concrete conjugation, signed norm a^2-a*b+b^2, and natural norm certificates.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-lambda = ./eisenstein-defs.lim::eisenstein-lambda)
(#alias eisenstein-of-integer = ./eisenstein-defs.lim::eisenstein-of-integer)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-add = ./eisenstein-defs.lim::eisenstein-add)
(#alias eisenstein-negate = ./eisenstein-defs.lim::eisenstein-negate)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-zero = ./integer-defs.lim::integer-zero)
(#alias integer-one = ./integer-defs.lim::integer-one)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias eisenstein-reflexive = ./eisenstein-equality.lim::eisenstein-reflexive)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-congruent = ./eisenstein-equality.lim::eisenstein-multiply-congruent)
(#alias eisenstein-add-congruent = ./eisenstein-equality.lim::eisenstein-add-congruent)
(#alias
  eisenstein-of-integer-injective
  =
  ./eisenstein-equality.lim::eisenstein-of-integer-injective)
(#alias integer-reflexive = ./integer-equality.lim::integer-reflexive)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias integer-add-congruent = ./integer-equality.lim::integer-add-congruent)
(#alias integer-negate-congruent = ./integer-equality.lim::integer-negate-congruent)
(#alias integer-multiply-congruent = ./integer-multiplication.lim::integer-multiply-congruent)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#math-definition eisenstein-conjugate ()
  (#pt-pi ((number (#pt-use eisenstein ()))) (#pt-use eisenstein ()))
  (#pt-lambda
    ((number (#pt-use eisenstein ())))
    (#pt-construct
      eisenstein
      ()
      ()
      pair
      (
        (#pt-app
          (#pt-use integer-add ())
          (#pt-project eisenstein 0 number)
          (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 number)))
        (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 number))))))
(#math-definition eisenstein-norm ()
  (#pt-pi ((number (#pt-use eisenstein ()))) (#pt-use integer ()))
  (#pt-lambda
    ((number (#pt-use eisenstein ())))
    (#pt-app
      (#pt-use integer-add ())
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-project eisenstein 0 number)
          (#pt-project eisenstein 0 number))
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project eisenstein 0 number)
            (#pt-project eisenstein 1 number))))
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-project eisenstein 1 number)
        (#pt-project eisenstein 1 number)))))
(#math-definition eisenstein-natural-norm ()
  (#pt-pi ((number (#pt-use eisenstein ())) (natural #pt-nat)) #pt-prop)
  (#pt-lambda
    ((number (#pt-use eisenstein ())) (natural #pt-nat))
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use eisenstein-norm ()) number)
      (#pt-app (#pt-use integer-of-natural ()) natural))))
