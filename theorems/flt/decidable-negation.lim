                ((counterexample (#pt-pi ((denied-evidence proposition)) #pt-false)))
                (#pt-app counterexample evidence))))))
      input-decision)))
(#theorem decision-negation-has-evidence
  (#universes)
  (#parameters
    (#parameter proposition #pt-prop)
    (#parameter input-decision (#pt-app (#pt-use decision ()) proposition)))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-pi ((denied-evidence proposition)) #pt-false)
      (#pt-pi ((denied-evidence (#pt-pi ((denied-evidence proposition)) #pt-false))) #pt-false)))
  (#proof
    (#pt-app
      (#pt-use decision-evidence ())
      (#pt-pi ((denied-evidence proposition)) #pt-false)
      (#pt-app (#pt-use decision-negation ()) proposition input-decision))))
