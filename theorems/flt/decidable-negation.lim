; Generated by scripts/generate-flt-signed-residues.py; checked native proof terms.
; Constructive negation of an explicit proof-carrying decision.
; The input decision is required; no excluded-middle oracle is added.
(#alias decision = ./logical-decision.lim::decision)
(#alias decision-evidence = ./decidable-logic.lim::decision-evidence)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#math-definition decision-negation ()
