    ((proposition #pt-prop) (input-decision (#pt-app (#pt-use decision ()) proposition)))
    (#pt-app (#pt-use decision ()) (#pt-pi ((denied-evidence proposition)) #pt-false)))
  (#pt-lambda
    ((proposition #pt-prop) (input-decision (#pt-app (#pt-use decision ()) proposition)))
    (#pt-induct
      decision
      ()
      (proposition)
      (#pt-lambda
        ((decision-subject (#pt-app (#pt-use decision ()) proposition)))
        (#pt-app (#pt-use decision ()) (#pt-pi ((denied-evidence proposition)) #pt-false)))
      (
        (#pt-lambda
          ((refutation (#pt-pi ((denied-evidence proposition)) #pt-false)))
          (#pt-construct
            decision
            ()
            ((#pt-pi ((denied-evidence proposition)) #pt-false))
            yes
            (refutation)))
        (#pt-lambda
          ((evidence proposition))
          (#pt-construct
            decision
            ()
            ((#pt-pi ((denied-evidence proposition)) #pt-false))
            no
            (
