; Adapted source: pinned Mathlib Algebra/Polynomial/Degree/Defs.lean
; and Degree/Operations.lean; Affine/Point.lean.
; Generated by scripts/generate-flt-polynomial-degrees.py; checked native terms.
; Eliminate actual degree data to prove its natural degree
; is a valid/unique leading degree for every nonzero polynomial. The
; zero/nonzero tags are sound even when natDegree is0 in both cases.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias
  ring-polynomial-degree-data
  =
  ./ring-polynomial-degree-data.lim::ring-polynomial-degree-data)
(#alias
  ring-polynomial-degree-data-has-leading
  =
  ./ring-polynomial-degree-data.lim::ring-polynomial-degree-data-has-leading)
(#alias
  ring-polynomial-degree-data-natural
  =
  ./ring-polynomial-degree-data.lim::ring-polynomial-degree-data-natural)
(#alias
  ring-polynomial-degree-nonzero
  =
  ./ring-polynomial-degree-leading.lim::ring-polynomial-degree-nonzero)
(#alias
  ring-polynomial-degree-unique
  =
  ./ring-polynomial-degree-uniqueness.lim::ring-polynomial-degree-unique)
(#alias
  ring-polynomial-degree-witness
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-degree-witness)
(#alias ring-polynomial-equal = ./ring-polynomial-data.lim::ring-polynomial-equal)
(#theorem ring-polynomial-degree-data-valid
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter degree-data (#pt-app (#pt-use ring-polynomial-degree-data ()) Carrier coefficient-ring polynomial))
    (#parameter nonzero-polynomial (#pt-pi ((denied-evidence (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring polynomial (#pt-construct finite-list () (Carrier) nil ())))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-degree-witness ())
      Carrier
      coefficient-ring
      polynomial
      (#pt-app
        (#pt-use ring-polynomial-degree-data-natural ())
        Carrier
        coefficient-ring
        polynomial
        degree-data)))
  (#proof
    (#pt-induct
      ring-polynomial-degree-data
      ()
      (Carrier coefficient-ring polynomial)
      (#pt-lambda
        (
          (selected-degree-data
            (#pt-app (#pt-use ring-polynomial-degree-data ()) Carrier coefficient-ring polynomial)))
        (#pt-app
          (#pt-use ring-polynomial-degree-witness ())
          Carrier
          coefficient-ring
          polynomial
          (#pt-app
            (#pt-use ring-polynomial-degree-data-natural ())
            Carrier
            coefficient-ring
            polynomial
            selected-degree-data)))
      (
        (#pt-lambda
          (
            (zero-equation
              (#pt-app
                (#pt-use ring-polynomial-equal ())
                Carrier
                coefficient-ring
                polynomial
                (#pt-construct finite-list () (Carrier) nil ()))))
          (#pt-app
            (#pt-use false-elimination ())
            (#pt-app
              (#pt-use ring-polynomial-degree-witness ())
              Carrier
              coefficient-ring
              polynomial
              #pt-zero)
            (#pt-app nonzero-polynomial zero-equation)))
        (#pt-lambda
          (
            (degree #pt-nat)
            (leading-certificate
              (#pt-app
                (#pt-use ring-polynomial-degree-witness ())
                Carrier
                coefficient-ring
                polynomial
                degree)))
          leading-certificate))
      degree-data)))
(#theorem ring-polynomial-degree-data-agrees
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter degree-data (#pt-app (#pt-use ring-polynomial-degree-data ()) Carrier coefficient-ring polynomial))
    (#parameter claimed-degree #pt-nat)
    (#parameter claimed-certificate (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring polynomial claimed-degree)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app
        (#pt-use ring-polynomial-degree-data-natural ())
        Carrier
        coefficient-ring
        polynomial
        degree-data)
      claimed-degree))
  (#proof
    (#pt-induct
      ring-polynomial-degree-data
      ()
      (Carrier coefficient-ring polynomial)
      (#pt-lambda
        (
          (selected-degree-data
            (#pt-app (#pt-use ring-polynomial-degree-data ()) Carrier coefficient-ring polynomial)))
        (#pt-eq
          #pt-nat
          (#pt-app
            (#pt-use ring-polynomial-degree-data-natural ())
            Carrier
            coefficient-ring
            polynomial
            selected-degree-data)
          claimed-degree))
      (
        (#pt-lambda
          (
            (zero-equation
              (#pt-app
                (#pt-use ring-polynomial-equal ())
                Carrier
                coefficient-ring
                polynomial
                (#pt-construct finite-list () (Carrier) nil ()))))
          (#pt-app
            (#pt-use false-elimination ())
            (#pt-eq #pt-nat #pt-zero claimed-degree)
            (#pt-app
              (#pt-app
                (#pt-use ring-polynomial-degree-nonzero ())
                Carrier
                coefficient-ring
                polynomial
                claimed-degree
                claimed-certificate)
              zero-equation)))
        (#pt-lambda
          (
            (degree #pt-nat)
            (leading-certificate
              (#pt-app
                (#pt-use ring-polynomial-degree-witness ())
                Carrier
                coefficient-ring
                polynomial
                degree)))
          (#pt-app
            (#pt-use ring-polynomial-degree-unique ())
            Carrier
            coefficient-ring
            polynomial
            degree
            claimed-degree
            leading-certificate
            claimed-certificate)))
      degree-data)))
(#theorem ring-polynomial-degree-data-zero-tag
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter degree-data (#pt-app (#pt-use ring-polynomial-degree-data ()) Carrier coefficient-ring polynomial))
    (#parameter zero-polynomial (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring polynomial (#pt-construct finite-list () (Carrier) nil ()))))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app
        (#pt-use ring-polynomial-degree-data-has-leading ())
        Carrier
        coefficient-ring
        polynomial
        degree-data)
      #pt-zero))
  (#proof
    (#pt-induct
      ring-polynomial-degree-data
      ()
      (Carrier coefficient-ring polynomial)
      (#pt-lambda
        (
          (selected-degree-data
            (#pt-app (#pt-use ring-polynomial-degree-data ()) Carrier coefficient-ring polynomial)))
        (#pt-eq
          #pt-nat
          (#pt-app
            (#pt-use ring-polynomial-degree-data-has-leading ())
            Carrier
            coefficient-ring
            polynomial
            selected-degree-data)
          #pt-zero))
      (
        (#pt-lambda
          (
            (zero-equation
              (#pt-app
                (#pt-use ring-polynomial-equal ())
                Carrier
                coefficient-ring
                polynomial
                (#pt-construct finite-list () (Carrier) nil ()))))
          (#pt-refl #pt-nat #pt-zero))
        (#pt-lambda
          (
            (degree #pt-nat)
            (leading-certificate
              (#pt-app
                (#pt-use ring-polynomial-degree-witness ())
                Carrier
                coefficient-ring
                polynomial
                degree)))
          (#pt-app
            (#pt-use false-elimination ())
            (#pt-eq #pt-nat (#pt-succ #pt-zero) #pt-zero)
            (#pt-app
              (#pt-app
                (#pt-use ring-polynomial-degree-nonzero ())
                Carrier
                coefficient-ring
                polynomial
                degree
                leading-certificate)
              zero-polynomial))))
      degree-data)))
(#theorem ring-polynomial-degree-data-nonzero-tag
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter degree-data (#pt-app (#pt-use ring-polynomial-degree-data ()) Carrier coefficient-ring polynomial))
    (#parameter nonzero-polynomial (#pt-pi ((denied-evidence (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring polynomial (#pt-construct finite-list () (Carrier) nil ())))) #pt-false)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app
        (#pt-use ring-polynomial-degree-data-has-leading ())
        Carrier
        coefficient-ring
        polynomial
        degree-data)
      (#pt-succ #pt-zero)))
  (#proof
    (#pt-induct
      ring-polynomial-degree-data
      ()
      (Carrier coefficient-ring polynomial)
      (#pt-lambda
        (
          (selected-degree-data
            (#pt-app (#pt-use ring-polynomial-degree-data ()) Carrier coefficient-ring polynomial)))
        (#pt-eq
          #pt-nat
          (#pt-app
            (#pt-use ring-polynomial-degree-data-has-leading ())
            Carrier
            coefficient-ring
            polynomial
            selected-degree-data)
          (#pt-succ #pt-zero)))
      (
        (#pt-lambda
          (
            (zero-equation
              (#pt-app
                (#pt-use ring-polynomial-equal ())
                Carrier
                coefficient-ring
                polynomial
                (#pt-construct finite-list () (Carrier) nil ()))))
          (#pt-app
            (#pt-use false-elimination ())
            (#pt-eq #pt-nat #pt-zero (#pt-succ #pt-zero))
            (#pt-app nonzero-polynomial zero-equation)))
        (#pt-lambda
          (
            (degree #pt-nat)
            (leading-certificate
              (#pt-app
                (#pt-use ring-polynomial-degree-witness ())
                Carrier
                coefficient-ring
                polynomial
                degree)))
          (#pt-refl #pt-nat (#pt-succ #pt-zero))))
      degree-data)))
