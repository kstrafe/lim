; Generated by scripts/generate-flt-point-evaluation.py; checked native terms.
; A vanishing polynomial has an actual
; principal ideal witness, the computed quotient. Its coefficient
; equation follows from the proved root-factor identity, including
; the multiplication-order conversion used by principal membership.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias point-evaluation-kernel = ./point-evaluation-kernel.lim::point-evaluation-kernel)
(#alias polynomial-root-divisor = ./polynomial-root-division-data.lim::polynomial-root-divisor)
(#alias
  polynomial-root-evaluation-morphism
  =
  ./polynomial-root-evaluation-morphism.lim::polynomial-root-evaluation-morphism)
(#alias polynomial-root-factor = ./polynomial-root-factor.lim::polynomial-root-factor)
(#alias polynomial-root-quotient = ./polynomial-root-division-data.lim::polynomial-root-quotient)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-ideal = ./ring-ideal-data.lim::ring-ideal)
(#alias ring-ideal-member = ./ring-ideal-data.lim::ring-ideal-member)
(#alias ring-ideal-principal = ./ring-ideal-principal.lim::ring-ideal-principal)
(#alias ring-ideal-principal-introduce = ./ring-ideal-principal.lim::ring-ideal-principal-introduce)
(#alias ring-polynomial-evaluate = ./ring-polynomial-data.lim::ring-polynomial-evaluate)
(#alias ring-polynomial-multiply = ./ring-polynomial-data.lim::ring-polynomial-multiply)
(#alias
  ring-polynomial-multiply-commutative
  =
  ./ring-polynomial-multiplication-laws.lim::ring-polynomial-multiply-commutative)
(#alias ring-polynomial-structure = ./ring-polynomial-structure.lim::ring-polynomial-structure)
(#alias ring-polynomial-transitive = ./ring-polynomial-equivalence.lim::ring-polynomial-transitive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#math-definition polynomial-root-kernel ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (root Carrier))
    (#pt-app
      (#pt-use ring-ideal ())
      (#pt-app (#pt-use finite-list ()) Carrier)
      (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (root Carrier))
    (#pt-app
      (#pt-use point-evaluation-kernel ())
      (#pt-app (#pt-use finite-list ()) Carrier)
      (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
      Carrier
      coefficient-ring
      (#pt-app (#pt-use polynomial-root-evaluation-morphism ()) Carrier coefficient-ring root))))
(#theorem polynomial-root-principal-member
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter root Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter root-equation (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring polynomial root) (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-member ())
      (#pt-app (#pt-use finite-list ()) Carrier)
      (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
      (#pt-app
        (#pt-use ring-ideal-principal ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root))
      polynomial))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-principal-introduce ())
      (#pt-app (#pt-use finite-list ()) Carrier)
      (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
      (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
      polynomial
      (#pt-app (#pt-use polynomial-root-quotient ()) Carrier coefficient-ring root polynomial)
      (#pt-app
        (#pt-use ring-polynomial-transitive ())
        Carrier
        coefficient-ring
        polynomial
        (#pt-app
          (#pt-use ring-polynomial-multiply ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
          (#pt-app (#pt-use polynomial-root-quotient ()) Carrier coefficient-ring root polynomial))
        (#pt-app
          (#pt-use ring-polynomial-multiply ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-quotient ()) Carrier coefficient-ring root polynomial)
          (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root))
        (#pt-app
          (#pt-use polynomial-root-factor ())
          Carrier
          coefficient-ring
          root
          polynomial
          root-equation)
        (#pt-app
          (#pt-use ring-polynomial-multiply-commutative ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
          (#pt-app (#pt-use polynomial-root-quotient ()) Carrier coefficient-ring root polynomial))))))
