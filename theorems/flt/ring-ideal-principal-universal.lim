; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Prove principal minimality and correspondence to
; the actual singleton span, then congruence under coefficient
; equivalence. The witness presentation and general span presentation
; are connected by checked membership maps in both directions.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias exists = ./logic-exists.lim::exists)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-ideal = ./ring-ideal-data.lim::ring-ideal)
(#alias ring-ideal-equal = ./ring-ideal-data.lim::ring-ideal-equal)
(#alias ring-ideal-member = ./ring-ideal-data.lim::ring-ideal-member)
(#alias ring-ideal-member-congruent = ./ring-ideal-data.lim::ring-ideal-member-congruent)
(#alias ring-ideal-multiply-left = ./ring-ideal-data.lim::ring-ideal-multiply-left)
(#alias ring-ideal-principal = ./ring-ideal-principal.lim::ring-ideal-principal)
(#alias ring-ideal-principal-generator = ./ring-ideal-principal.lim::ring-ideal-principal-generator)
(#alias ring-ideal-principal-member = ./ring-ideal-principal.lim::ring-ideal-principal-member)
(#alias ring-ideal-span = ./ring-ideal-span-construction.lim::ring-ideal-span)
(#alias ring-ideal-span-generator = ./ring-ideal-span-construction.lim::ring-ideal-span-generator)
(#alias ring-ideal-span-least = ./ring-ideal-span-universal.lim::ring-ideal-span-least)
(#alias ring-ideal-subset = ./ring-ideal-data.lim::ring-ideal-subset)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#alias ring-symmetric = ./commutative-ring-data.lim::ring-symmetric)
(#theorem ring-ideal-principal-least
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter generator Carrier)
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter generator-contained (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring first-ideal generator)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring generator)
      first-ideal))
  (#proof
    (#pt-lambda
      (
        (element Carrier)
        (member
          (#pt-app
            (#pt-use ring-ideal-member ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring generator)
            element)))
      (#pt-induct
        exists
        (0)
        (Carrier
          (#pt-lambda
            ((multiplier Carrier))
            (#pt-app
              (#pt-use ring-equal ())
              Carrier
              coefficient-ring
              element
              (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring multiplier generator))))
        (#pt-lambda
          (
            (principal-certificate
              (#pt-app
                (#pt-use ring-ideal-principal-member ())
                Carrier
                coefficient-ring
                generator
                element)))
          (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring first-ideal element))
        (
          (#pt-lambda
            (
              (multiplier Carrier)
              (multiple-equation
                (#pt-app
                  (#pt-use ring-equal ())
                  Carrier
                  coefficient-ring
                  element
                  (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring multiplier generator))))
            (#pt-app
              (#pt-use ring-ideal-member-congruent ())
              Carrier
              coefficient-ring
              first-ideal
              (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring multiplier generator)
              element
              (#pt-app
                (#pt-use ring-symmetric ())
                Carrier
                coefficient-ring
                element
                (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring multiplier generator)
                multiple-equation)
              (#pt-app
                (#pt-use ring-ideal-multiply-left ())
                Carrier
                coefficient-ring
                first-ideal
                multiplier
                generator
                generator-contained))))
        member))))
(#theorem ring-ideal-principal-span
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter generator Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring generator)
      (#pt-app
        (#pt-use ring-ideal-span ())
        Carrier
        coefficient-ring
        (#pt-lambda
          ((element Carrier))
          (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element generator)))))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring generator)
        (#pt-app
          (#pt-use ring-ideal-span ())
          Carrier
          coefficient-ring
          (#pt-lambda
            ((element Carrier))
            (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element generator))))
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-span ())
          Carrier
          coefficient-ring
          (#pt-lambda
            ((element Carrier))
            (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element generator)))
        (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring generator))
      (#pt-app
        (#pt-use ring-ideal-principal-least ())
        Carrier
        coefficient-ring
        generator
        (#pt-app
          (#pt-use ring-ideal-span ())
          Carrier
          coefficient-ring
          (#pt-lambda
            ((element Carrier))
            (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element generator)))
        (#pt-app
          (#pt-use ring-ideal-span-generator ())
          Carrier
          coefficient-ring
          (#pt-lambda
            ((element Carrier))
            (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element generator))
          generator
          (#pt-app (#pt-use ring-reflexive ()) Carrier coefficient-ring generator)))
      (#pt-app
        (#pt-use ring-ideal-span-least ())
        Carrier
        coefficient-ring
        (#pt-lambda
          ((element Carrier))
          (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element generator))
        (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring generator)
        (#pt-lambda
          (
            (element Carrier)
            (generator-equation
              (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element generator)))
          (#pt-app
            (#pt-use ring-ideal-member-congruent ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring generator)
            generator
            element
            (#pt-app
              (#pt-use ring-symmetric ())
              Carrier
              coefficient-ring
              element
              generator
              generator-equation)
            (#pt-app (#pt-use ring-ideal-principal-generator ()) Carrier coefficient-ring generator)))))))
(#theorem ring-ideal-principal-congruent
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-element Carrier)
    (#parameter second-element Carrier)
    (#parameter generator-equation (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring first-element second-element)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
      (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element)))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
        (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element))
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element)
        (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element))
      (#pt-app
        (#pt-use ring-ideal-principal-least ())
        Carrier
        coefficient-ring
        first-element
        (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element)
        (#pt-app
          (#pt-use ring-ideal-member-congruent ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element)
          second-element
          first-element
          (#pt-app
            (#pt-use ring-symmetric ())
            Carrier
            coefficient-ring
            first-element
            second-element
            generator-equation)
          (#pt-app
            (#pt-use ring-ideal-principal-generator ())
            Carrier
            coefficient-ring
            second-element)))
      (#pt-app
        (#pt-use ring-ideal-principal-least ())
        Carrier
        coefficient-ring
        second-element
        (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
        (#pt-app
          (#pt-use ring-ideal-member-congruent ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
          first-element
          second-element
          generator-equation
          (#pt-app
            (#pt-use ring-ideal-principal-generator ())
            Carrier
            coefficient-ring
            first-element))))))
