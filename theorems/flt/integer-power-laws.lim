(#theorem integer-negative-odd-power
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter odd-exponent (#pt-app (#pt-use odd ()) exponent)))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-power ()) (#pt-app (#pt-use integer-negate ()) number) exponent)
      (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-power ()) number exponent))))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-half #pt-nat))
          (#pt-eq
            #pt-nat
            exponent
            (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) candidate-half)))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-half #pt-nat))
                (#pt-eq
                  #pt-nat
                  exponent
                  (#pt-succ
                    (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) candidate-half)))))))
        (#pt-app
          (#pt-use integer-equal ())
          (#pt-app (#pt-use integer-power ()) (#pt-app (#pt-use integer-negate ()) number) exponent)
          (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-power ()) number exponent))))
      (
        (#pt-lambda
          (
            (odd-half #pt-nat)
            (odd-position
              (#pt-eq
                #pt-nat
                exponent
                (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) odd-half)))))
          (#pt-app
            (#pt-use substitution (0))
            #pt-nat
            (#pt-lambda
              ((endpoint #pt-nat))
              (#pt-app
                (#pt-use integer-equal ())
                (#pt-app
                  (#pt-use integer-power ())
                  (#pt-app (#pt-use integer-negate ()) number)
                  endpoint)
                (#pt-app
                  (#pt-use integer-negate ())
                  (#pt-app (#pt-use integer-power ()) number endpoint))))
            (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) odd-half))
            exponent
            (#pt-app
              (#pt-use symmetry (0))
              #pt-nat
              exponent
              (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) odd-half))
              odd-position)
            (#pt-app
              (#pt-use integer-transitive ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-negate ()) number)
                (#pt-app
                  (#pt-use integer-power ())
                  (#pt-app (#pt-use integer-negate ()) number)
                  (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) odd-half)))
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-negate ()) number)
                (#pt-app
                  (#pt-use integer-power ())
                  number
                  (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) odd-half)))
              (#pt-app
                (#pt-use integer-negate ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  number
                  (#pt-app
                    (#pt-use integer-power ())
                    number
                    (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) odd-half))))
              (#pt-app
                (#pt-use integer-multiply-congruent ())
                (#pt-app (#pt-use integer-negate ()) number)
                (#pt-app
                  (#pt-use integer-power ())
                  (#pt-app (#pt-use integer-negate ()) number)
                  (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) odd-half))
                (#pt-app (#pt-use integer-negate ()) number)
                (#pt-app
                  (#pt-use integer-power ())
                  number
                  (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) odd-half))
                (#pt-app
                  (#pt-use integer-reflexive ())
                  (#pt-app (#pt-use integer-negate ()) number))
                (#pt-app (#pt-use integer-negative-even-power ()) number odd-half))
              (#pt-app
                (#pt-use integer-multiply-negative ())
                number
                (#pt-app
                  (#pt-use integer-power ())
                  number
                  (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) odd-half)))))))
      odd-exponent)))
