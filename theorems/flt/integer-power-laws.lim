                (#pt-app (#pt-use integer-negate ()) number)
                (#pt-app
                  (#pt-use integer-power ())
                  (#pt-app (#pt-use integer-negate ()) number)
                  (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) previous-half))
                (#pt-app (#pt-use integer-negate ()) number)
