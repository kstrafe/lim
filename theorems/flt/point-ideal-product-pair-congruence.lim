; Adapted mathematical source: pinned Mathlib RingTheory/Ideal/Operations.lean
; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean.
; Generated by scripts/generate-flt-point-ideal-products.py; checked native terms.
; Two actual generator equivalences
; preserve the actual two-generator ideal, by proved principal
; and sum congruence. No ideal rewrite is assumed.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-ideal-equal = ./ring-ideal-data.lim::ring-ideal-equal)
(#alias ring-ideal-pair = ./ring-ideal-pair.lim::ring-ideal-pair)
(#alias ring-ideal-principal = ./ring-ideal-principal.lim::ring-ideal-principal)
(#alias
  ring-ideal-principal-congruent
  =
  ./ring-ideal-principal-universal.lim::ring-ideal-principal-congruent)
(#alias ring-ideal-sum-congruent = ./ring-ideal-operation-congruence.lim::ring-ideal-sum-congruent)
(#theorem point-ideal-product-pair-congruent
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first Carrier)
    (#parameter second Carrier)
    (#parameter third Carrier)
    (#parameter fourth Carrier)
    (#parameter first-equation (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring first third))
    (#parameter second-equation (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring second fourth)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring first second)
      (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring third fourth)))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-sum-congruent ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first)
      (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second)
      (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring third)
      (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring fourth)
      (#pt-app
        (#pt-use ring-ideal-principal-congruent ())
        Carrier
        coefficient-ring
        first
        third
        first-equation)
      (#pt-app
        (#pt-use ring-ideal-principal-congruent ())
        Carrier
        coefficient-ring
        second
        fourth
        second-equation))))
