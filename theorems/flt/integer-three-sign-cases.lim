; The eight signed forms of the already checked Nat cube-residue contradiction.
; These are proof lemmas for the integer first case, not a finite search over integers.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias cube = ./natural-ninth-residues.lim::cube)
