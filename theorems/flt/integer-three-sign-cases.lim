(#theorem natural-nonmultiple-three-nonzero
  (#universes)
  (#parameters
    (#parameter number #pt-nat)
    (#parameter not-three-divides (#pt-pi ((denied-proof (#pt-app (#pt-use divides ()) (#pt-numeral 3) number))) #pt-false)))
  (#statement (#pt-pi ((denied-proof (#pt-eq #pt-nat number #pt-zero))) #pt-false))
  (#proof
    (#pt-lambda
      ((zero-equation (#pt-eq #pt-nat number #pt-zero)))
      (#pt-app
        not-three-divides
        (#pt-app
          (#pt-use substitution (0))
          #pt-nat
          (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use divides ()) (#pt-numeral 3) endpoint))
          #pt-zero
          number
          (#pt-app (#pt-use symmetry (0)) #pt-nat number #pt-zero zero-equation)
          (#pt-app (#pt-use divides-zero ()) (#pt-numeral 3)))))))
(#theorem natural-nonmultiple-three-cube-nonzero
  (#universes)
  (#parameters
    (#parameter number #pt-nat)
    (#parameter not-three-divides (#pt-pi ((denied-proof (#pt-app (#pt-use divides ()) (#pt-numeral 3) number))) #pt-false)))
  (#statement
    (#pt-pi ((denied-proof (#pt-eq #pt-nat (#pt-app (#pt-use cube ()) number) #pt-zero))) #pt-false))
  (#proof
    (#pt-app
      (#pt-use multiply-nonzero ())
      number
      (#pt-app (#pt-use multiply ()) number number)
      (#pt-app (#pt-use natural-nonmultiple-three-nonzero ()) number not-three-divides)
      (#pt-app
        (#pt-use multiply-nonzero ())
        number
        number
        (#pt-app (#pt-use natural-nonmultiple-three-nonzero ()) number not-three-divides)
        (#pt-app (#pt-use natural-nonmultiple-three-nonzero ()) number not-three-divides)))))
(#theorem natural-cube-equation-impossible
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter third #pt-nat)
    (#parameter first-not-divisible (#pt-pi ((denied-proof (#pt-app (#pt-use divides ()) (#pt-numeral 3) first))) #pt-false))
    (#parameter second-not-divisible (#pt-pi ((denied-proof (#pt-app (#pt-use divides ()) (#pt-numeral 3) second))) #pt-false))
    (#parameter third-not-divisible (#pt-pi ((denied-proof (#pt-app (#pt-use divides ()) (#pt-numeral 3) third))) #pt-false))
    (#parameter natural-cube-equation (#pt-eq #pt-nat (#pt-app (#pt-use add ()) (#pt-app (#pt-use cube ()) first) (#pt-app (#pt-use cube ()) second)) (#pt-app (#pt-use cube ()) third))))
  (#statement #pt-false)
  (#proof
    (#pt-app
      (#pt-use ninth-cube-residues-exclude-sum ())
      (#pt-app (#pt-use cube ()) first)
      (#pt-app (#pt-use cube ()) second)
      (#pt-app (#pt-use cube ()) third)
      (#pt-app (#pt-use nonmultiple-three-cube-residue ()) first first-not-divisible)
      (#pt-app (#pt-use nonmultiple-three-cube-residue ()) second second-not-divisible)
      (#pt-app (#pt-use nonmultiple-three-cube-residue ()) third third-not-divisible)
      natural-cube-equation)))
