(#theorem point-ideal-addition-target-XX
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-X Carrier)
    (#parameter second-X Carrier)
    (#parameter sum-X Carrier)
    (#parameter line Carrier)
    (#parameter opposite Carrier)
    (#parameter norm-equation (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring line opposite) (#pt-app (#pt-use ring-negate ()) Carrier coefficient-ring (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring sum-X (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-X second-X))))))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-member ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use point-ideal-addition-right-product ())
        Carrier
        coefficient-ring
        first-X
        second-X
        sum-X
        line
        opposite)
      (#pt-app
        (#pt-use ring-multiply ())
        Carrier
        coefficient-ring
        sum-X
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-X second-X))))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-member-congruent ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use point-ideal-addition-right-product ())
        Carrier
        coefficient-ring
        first-X
        second-X
        sum-X
        line
        opposite)
      (#pt-app
        (#pt-use ring-negate ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring line opposite))
      (#pt-app
        (#pt-use ring-multiply ())
        Carrier
        coefficient-ring
        sum-X
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-X second-X))
      (#pt-app
        (#pt-use ring-transitive ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-negate ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring line opposite))
        (#pt-app
          (#pt-use ring-negate ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-negate ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              sum-X
              (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-X second-X))))
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          sum-X
          (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-X second-X))
        (#pt-app
          (#pt-use ring-negate-congruent ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring line opposite)
          (#pt-app
            (#pt-use ring-negate ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              sum-X
              (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-X second-X)))
          norm-equation)
        (#pt-app
          (#pt-use ring-negate-involution ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            sum-X
            (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-X second-X))))
      (#pt-app
        (#pt-use ring-ideal-negate ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use point-ideal-addition-right-product ())
          Carrier
          coefficient-ring
          first-X
          second-X
          sum-X
          line
          opposite)
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring line opposite)
        (#pt-app
          (#pt-use ring-ideal-product-introduce ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring line)
          (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring sum-X opposite)
          line
          opposite
          (#pt-app (#pt-use ring-ideal-principal-generator ()) Carrier coefficient-ring line)
          (#pt-app (#pt-use ring-ideal-pair-second ()) Carrier coefficient-ring sum-X opposite))))))
