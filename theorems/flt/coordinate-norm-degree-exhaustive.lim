; Adapted source: pinned Mathlib Affine/Point.lean:409-470.
; All polynomial, coefficient-domain and index facts are proved.
; Generated by scripts/generate-flt-norm-degrees.py; checked native terms.
; If zero and every possible leading-degree case both
; contradict a claim, that claim is false. Structural list induction
; proves this negative elimination rule without a zero-decision oracle
; or a new excluded-middle axiom for the coefficient carrier.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias
  ring-polynomial-cons-congruent
  =
  ./ring-polynomial-shift-laws.lim::ring-polynomial-cons-congruent)
(#alias
  ring-polynomial-degree-cons-successor
  =
  ./ring-polynomial-degree-leading.lim::ring-polynomial-degree-cons-successor)
(#alias
  ring-polynomial-degree-cons-zero
  =
  ./ring-polynomial-degree-leading.lim::ring-polynomial-degree-cons-zero)
(#alias
  ring-polynomial-degree-witness
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-degree-witness)
(#alias ring-polynomial-equal = ./ring-polynomial-data.lim::ring-polynomial-equal)
(#alias ring-polynomial-reflexive = ./ring-polynomial-equivalence.lim::ring-polynomial-reflexive)
(#alias ring-polynomial-shift = ./ring-polynomial-data.lim::ring-polynomial-shift)
(#alias ring-polynomial-shift-nil = ./ring-polynomial-shift-laws.lim::ring-polynomial-shift-nil)
(#alias ring-polynomial-transitive = ./ring-polynomial-equivalence.lim::ring-polynomial-transitive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#theorem coordinate-norm-degree-exhaustive-elimination
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter zero-refutation (#pt-pi ((denied-evidence (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring polynomial (#pt-construct finite-list () (Carrier) nil ())))) #pt-false))
    (#parameter degree-refutation (#pt-pi ((leading-degree #pt-nat) (leading-certificate (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring polynomial leading-degree))) #pt-false)))
  (#statement #pt-false)
  (#proof
    (#pt-app
      (#pt-induct
        finite-list
        ()
        (Carrier)
        (#pt-lambda
          ((selected-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
          (#pt-pi
            (
              (zero-refutation-bound-0000
                (#pt-pi
                  (
                    (denied-evidence
                      (#pt-app
                        (#pt-use ring-polynomial-equal ())
                        Carrier
                        coefficient-ring
                        selected-polynomial
                        (#pt-construct finite-list () (Carrier) nil ()))))
                  #pt-false))
              (degree-refutation-bound-0001
                (#pt-pi
                  (
                    (leading-degree #pt-nat)
                    (leading-certificate
                      (#pt-app
                        (#pt-use ring-polynomial-degree-witness ())
                        Carrier
                        coefficient-ring
                        selected-polynomial
                        leading-degree)))
                  #pt-false)))
            #pt-false))
        (
          (#pt-lambda
            (
              (zero-refutation-bound-0002
                (#pt-pi
                  (
                    (denied-evidence
                      (#pt-app
                        (#pt-use ring-polynomial-equal ())
                        Carrier
                        coefficient-ring
                        (#pt-construct finite-list () (Carrier) nil ())
                        (#pt-construct finite-list () (Carrier) nil ()))))
                  #pt-false))
              (degree-refutation-bound-0003
                (#pt-pi
                  (
                    (leading-degree #pt-nat)
                    (leading-certificate
                      (#pt-app
                        (#pt-use ring-polynomial-degree-witness ())
                        Carrier
                        coefficient-ring
                        (#pt-construct finite-list () (Carrier) nil ())
                        leading-degree)))
                  #pt-false)))
            (#pt-app
              zero-refutation-bound-0002
              (#pt-app
                (#pt-use ring-polynomial-reflexive ())
                Carrier
                coefficient-ring
                (#pt-construct finite-list () (Carrier) nil ()))))
          (#pt-lambda
            (
              (head Carrier)
              (tail (#pt-app (#pt-use finite-list ()) Carrier))
              (tail-elimination
                (#pt-pi
                  (
                    (zero-refutation-bound-0004
                      (#pt-pi
                        (
                          (denied-evidence
                            (#pt-app
                              (#pt-use ring-polynomial-equal ())
                              Carrier
                              coefficient-ring
                              tail
                              (#pt-construct finite-list () (Carrier) nil ()))))
                        #pt-false))
                    (degree-refutation-bound-0005
                      (#pt-pi
                        (
                          (leading-degree #pt-nat)
                          (leading-certificate
                            (#pt-app
                              (#pt-use ring-polynomial-degree-witness ())
                              Carrier
                              coefficient-ring
                              tail
                              leading-degree)))
                        #pt-false)))
                  #pt-false)))
            (#pt-lambda
              (
                (zero-refutation-bound-0006
                  (#pt-pi
                    (
                      (denied-evidence
                        (#pt-app
                          (#pt-use ring-polynomial-equal ())
                          Carrier
                          coefficient-ring
                          (#pt-construct finite-list () (Carrier) cons (head tail))
                          (#pt-construct finite-list () (Carrier) nil ()))))
                    #pt-false))
                (degree-refutation-bound-0007
                  (#pt-pi
                    (
                      (leading-degree #pt-nat)
                      (leading-certificate
                        (#pt-app
                          (#pt-use ring-polynomial-degree-witness ())
                          Carrier
                          coefficient-ring
                          (#pt-construct finite-list () (Carrier) cons (head tail))
                          leading-degree)))
                    #pt-false)))
              (#pt-app
                tail-elimination
                (#pt-lambda
                  (
                    (zero-tail
                      (#pt-app
                        (#pt-use ring-polynomial-equal ())
                        Carrier
                        coefficient-ring
                        tail
                        (#pt-construct finite-list () (Carrier) nil ()))))
                  (#pt-app
                    degree-refutation-bound-0007
                    #pt-zero
                    (#pt-app
                      (#pt-use ring-polynomial-degree-cons-zero ())
                      Carrier
                      coefficient-ring
                      head
                      tail
                      (#pt-lambda
                        (
                          (zero-head
                            (#pt-app
                              (#pt-use ring-equal ())
                              Carrier
                              coefficient-ring
                              head
                              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
                        (#pt-app
                          zero-refutation-bound-0006
                          (#pt-app
                            (#pt-use ring-polynomial-transitive ())
                            Carrier
                            coefficient-ring
                            (#pt-construct finite-list () (Carrier) cons (head tail))
                            (#pt-app
                              (#pt-use ring-polynomial-shift ())
                              Carrier
                              coefficient-ring
                              (#pt-construct finite-list () (Carrier) nil ()))
                            (#pt-construct finite-list () (Carrier) nil ())
                            (#pt-app
                              (#pt-use ring-polynomial-cons-congruent ())
                              Carrier
                              coefficient-ring
                              head
                              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
                              tail
                              (#pt-construct finite-list () (Carrier) nil ())
                              zero-head
                              zero-tail)
                            (#pt-app
                              (#pt-use ring-polynomial-shift-nil ())
                              Carrier
                              coefficient-ring))))
                      zero-tail)))
                (#pt-lambda
                  (
                    (tail-degree #pt-nat)
                    (tail-certificate
                      (#pt-app
                        (#pt-use ring-polynomial-degree-witness ())
                        Carrier
                        coefficient-ring
                        tail
                        tail-degree)))
                  (#pt-app
                    degree-refutation-bound-0007
                    (#pt-succ tail-degree)
                    (#pt-app
                      (#pt-use ring-polynomial-degree-cons-successor ())
                      Carrier
                      coefficient-ring
                      head
                      tail
                      tail-degree
                      tail-certificate)))))))
        polynomial)
      zero-refutation
      degree-refutation)))
