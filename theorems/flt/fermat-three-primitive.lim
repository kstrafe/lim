; Construct a primitive cubic counterexample from any positive one.
; Strong induction removes actual common prime factors and strictly reduces
; the third coordinate. No primitive-existence theorem is assumed.
; This is a constructive Nat adaptation of the primitive reduction used in
; Mathlib/NumberTheory/FLT/Three.lean:126-146 and FLT/Basic.lean.
; Copyright (c) 2023 Kevin Buzzard and contributors; 2024 Riccardo Brasca
; and contributors. Source adaptation under Apache-2.0; see LICENSE.MATHLIB.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias power = ../fermat_statement.lim::power)
(#alias exists = ./logic-exists.lim::exists)
(#alias cube = ./natural-ninth-residues.lim::cube)
(#alias power-three-as-cube = ./natural-ninth-residues.lim::power-three-as-cube)
(#alias natural-cubic-solution = ./fermat-three-defs.lim::natural-cubic-solution)
(#alias has-natural-primitive-cubic = ./fermat-three-defs.lim::has-natural-primitive-cubic)
(#alias has-smaller-natural-cubic = ./fermat-three-defs.lim::has-smaller-natural-cubic)
(#alias
  cubic-common-prime-descends
  =
  ./fermat-three-factor-descent.lim::cubic-common-prime-descends)
(#alias less-than = ./natural-order.lim::less-than)
(#alias strong-induction = ./natural-order.lim::strong-induction)
(#alias gcd-spec = ./natural-gcd.lim::gcd-spec)
(#alias has-gcd = ./natural-gcd.lim::has-gcd)
(#alias gcd-exists = ./natural-gcd.lim::gcd-exists)
(#alias coprime = ./natural-coprime.lim::coprime)
(#alias coprime-of-gcd-one = ./natural-coprime.lim::coprime-of-gcd-one)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias divides-transitive = ./natural-divisibility.lim::divides-transitive)
(#alias zero-divisor-equation = ./decidable-divisibility.lim::zero-divisor-equation)
(#alias zero-one-or-large = ./natural-small-cases.lim::zero-one-or-large)
(#alias prime = ./natural-prime.lim::prime)
(#alias exists-prime-divisor = ./natural-prime.lim::exists-prime-divisor)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#alias fermat-for = ./fermat-for.lim::fermat-for)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias congruence = ./equality.lim::congruence)
(#alias substitution = ./equality.lim::substitution)
(#theorem natural-cubic-primitive-induction-step
  (#universes)
  (#parameters
    (#parameter third #pt-nat)
    (#parameter smaller-cases (#pt-pi ((earlier #pt-nat) (earlier-proof (#pt-app (#pt-use less-than ()) earlier third))) (#pt-pi ((candidate-first #pt-nat) (candidate-second #pt-nat) (candidate-solution (#pt-app (#pt-use natural-cubic-solution ()) candidate-first candidate-second earlier))) (#pt-use has-natural-primitive-cubic ())))))
  (#statement
    (#pt-pi
      (
        (candidate-first #pt-nat)
        (candidate-second #pt-nat)
        (candidate-solution
          (#pt-app (#pt-use natural-cubic-solution ()) candidate-first candidate-second third)))
      (#pt-use has-natural-primitive-cubic ())))
  (#proof
    (#pt-lambda
      (
        (first #pt-nat)
        (second #pt-nat)
        (solution (#pt-app (#pt-use natural-cubic-solution ()) first second third)))
      (#pt-induct
        exists
        (0)
        (#pt-nat
          (#pt-lambda
            ((candidate-gcd #pt-nat))
            (#pt-app (#pt-use gcd-spec ()) first second candidate-gcd)))
        (#pt-lambda
          (
            (certificate
              (#pt-app
                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((candidate-gcd #pt-nat))
                  (#pt-app (#pt-use gcd-spec ()) first second candidate-gcd)))))
          (#pt-use has-natural-primitive-cubic ()))
        (
          (#pt-lambda
            (
              (greatest-divisor #pt-nat)
              (gcd-proof (#pt-app (#pt-use gcd-spec ()) first second greatest-divisor)))
            (#pt-app
              (#pt-use disjunction-eliminate ())
              (#pt-eq #pt-nat greatest-divisor #pt-zero)
              (#pt-app
                (#pt-use disjunction ())
                (#pt-eq #pt-nat greatest-divisor (#pt-succ #pt-zero))
                (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) greatest-divisor))
              (#pt-use has-natural-primitive-cubic ())
              (#pt-lambda
                ((zero-equation (#pt-eq #pt-nat greatest-divisor #pt-zero)))
                (#pt-app
                  (#pt-use false-elimination ())
                  (#pt-use has-natural-primitive-cubic ())
                  (#pt-app
                    (#pt-project natural-cubic-solution 0 solution)
                    (#pt-app
                      (#pt-use zero-divisor-equation ())
                      first
                      (#pt-app
                        (#pt-use substitution (0))
                        #pt-nat
                        (#pt-lambda
                          ((endpoint #pt-nat))
                          (#pt-app (#pt-use divides ()) endpoint first))
                        greatest-divisor
                        #pt-zero
                        zero-equation
                        (#pt-app
                          (#pt-use conjunction-left ())
                          (#pt-app (#pt-use divides ()) greatest-divisor first)
                          (#pt-app
                            (#pt-use conjunction ())
                            (#pt-app (#pt-use divides ()) greatest-divisor second)
                            (#pt-pi
                              (
                                (candidate-common #pt-nat)
                                (candidate-first
                                  (#pt-app (#pt-use divides ()) candidate-common first))
                                (candidate-second
                                  (#pt-app (#pt-use divides ()) candidate-common second)))
                              (#pt-app (#pt-use divides ()) candidate-common greatest-divisor)))
                          gcd-proof))))))
              (#pt-lambda
                (
                  (unit-or-large
                    (#pt-app
                      (#pt-use disjunction ())
                      (#pt-eq #pt-nat greatest-divisor (#pt-succ #pt-zero))
                      (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) greatest-divisor))))
                (#pt-app
                  (#pt-use disjunction-eliminate ())
                  (#pt-eq #pt-nat greatest-divisor (#pt-succ #pt-zero))
                  (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) greatest-divisor)
                  (#pt-use has-natural-primitive-cubic ())
                  (#pt-lambda
                    ((one-equation (#pt-eq #pt-nat greatest-divisor (#pt-succ #pt-zero))))
                    (#pt-construct
                      exists
                      (0)
                      (#pt-nat
                        (#pt-lambda
                          ((candidate-first #pt-nat))
                          (#pt-app
                            (#pt-use exists (0))
                            #pt-nat
                            (#pt-lambda
                              ((candidate-second #pt-nat))
                              (#pt-app
                                (#pt-use exists (0))
                                #pt-nat
                                (#pt-lambda
                                  ((candidate-third #pt-nat))
                                  (#pt-app
                                    (#pt-use conjunction ())
                                    (#pt-app
                                      (#pt-use natural-cubic-solution ())
                                      candidate-first
                                      candidate-second
                                      candidate-third)
                                    (#pt-app (#pt-use coprime ()) candidate-first candidate-second))))))))
                      introduce
                      (first
                        (#pt-construct
                          exists
                          (0)
                          (#pt-nat
                            (#pt-lambda
                              ((candidate-second #pt-nat))
                              (#pt-app
                                (#pt-use exists (0))
                                #pt-nat
                                (#pt-lambda
                                  ((candidate-third #pt-nat))
                                  (#pt-app
                                    (#pt-use conjunction ())
                                    (#pt-app
                                      (#pt-use natural-cubic-solution ())
                                      first
                                      candidate-second
                                      candidate-third)
                                    (#pt-app (#pt-use coprime ()) first candidate-second))))))
                          introduce
                          (second
                            (#pt-construct
                              exists
                              (0)
                              (#pt-nat
                                (#pt-lambda
                                  ((candidate-third #pt-nat))
                                  (#pt-app
                                    (#pt-use conjunction ())
                                    (#pt-app
                                      (#pt-use natural-cubic-solution ())
                                      first
                                      second
                                      candidate-third)
                                    (#pt-app (#pt-use coprime ()) first second))))
                              introduce
                              (third
                                (#pt-app
                                  (#pt-use conjunction-introduce ())
                                  (#pt-app (#pt-use natural-cubic-solution ()) first second third)
                                  (#pt-app (#pt-use coprime ()) first second)
                                  solution
                                  (#pt-app
                                    (#pt-use coprime-of-gcd-one ())
                                    first
                                    second
                                    greatest-divisor
                                    gcd-proof
                                    one-equation)))))))))
                  (#pt-lambda
                    (
                      (larger-than-one
                        (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) greatest-divisor)))
                    (#pt-induct
                      exists
                      (0)
                      (#pt-nat
                        (#pt-lambda
                          ((candidate-prime #pt-nat))
                          (#pt-app
                            (#pt-use conjunction ())
                            (#pt-app (#pt-use prime ()) candidate-prime)
                            (#pt-app (#pt-use divides ()) candidate-prime greatest-divisor))))
                      (#pt-lambda
                        (
                          (certificate
                            (#pt-app
                              (#pt-use exists (0))
                              #pt-nat
                              (#pt-lambda
                                ((candidate-prime #pt-nat))
                                (#pt-app
                                  (#pt-use conjunction ())
                                  (#pt-app (#pt-use prime ()) candidate-prime)
                                  (#pt-app (#pt-use divides ()) candidate-prime greatest-divisor))))))
                        (#pt-use has-natural-primitive-cubic ()))
                      (
                        (#pt-lambda
                          (
                            (prime-number #pt-nat)
                            (prime-certificate
                              (#pt-app
                                (#pt-use conjunction ())
                                (#pt-app (#pt-use prime ()) prime-number)
                                (#pt-app (#pt-use divides ()) prime-number greatest-divisor))))
                          (#pt-induct
                            exists
                            (0)
                            (#pt-nat
                              (#pt-lambda
                                ((candidate-first #pt-nat))
                                (#pt-app
                                  (#pt-use exists (0))
                                  #pt-nat
                                  (#pt-lambda
                                    ((candidate-second #pt-nat))
                                    (#pt-app
                                      (#pt-use exists (0))
                                      #pt-nat
                                      (#pt-lambda
                                        ((candidate-third #pt-nat))
                                        (#pt-app
                                          (#pt-use conjunction ())
                                          (#pt-app
                                            (#pt-use natural-cubic-solution ())
                                            candidate-first
                                            candidate-second
                                            candidate-third)
                                          (#pt-app (#pt-use less-than ()) candidate-third third))))))))
                            (#pt-lambda
                              (
                                (certificate
                                  (#pt-app
                                    (#pt-use exists (0))
                                    #pt-nat
                                    (#pt-lambda
                                      ((candidate-first #pt-nat))
                                      (#pt-app
                                        (#pt-use exists (0))
                                        #pt-nat
                                        (#pt-lambda
                                          ((candidate-second #pt-nat))
                                          (#pt-app
                                            (#pt-use exists (0))
                                            #pt-nat
                                            (#pt-lambda
                                              ((candidate-third #pt-nat))
                                              (#pt-app
                                                (#pt-use conjunction ())
                                                (#pt-app
                                                  (#pt-use natural-cubic-solution ())
                                                  candidate-first
                                                  candidate-second
                                                  candidate-third)
                                                (#pt-app
                                                  (#pt-use less-than ())
                                                  candidate-third
                                                  third))))))))))
                              (#pt-use has-natural-primitive-cubic ()))
                            (
                              (#pt-lambda
                                (
                                  (reduced-first #pt-nat)
                                  (second-certificate
                                    (#pt-app
                                      (#pt-use exists (0))
                                      #pt-nat
                                      (#pt-lambda
                                        ((candidate-second #pt-nat))
                                        (#pt-app
                                          (#pt-use exists (0))
                                          #pt-nat
                                          (#pt-lambda
                                            ((candidate-third #pt-nat))
                                            (#pt-app
                                              (#pt-use conjunction ())
                                              (#pt-app
                                                (#pt-use natural-cubic-solution ())
                                                reduced-first
                                                candidate-second
                                                candidate-third)
                                              (#pt-app (#pt-use less-than ()) candidate-third third))))))))
                                (#pt-induct
                                  exists
                                  (0)
                                  (#pt-nat
                                    (#pt-lambda
                                      ((candidate-second #pt-nat))
                                      (#pt-app
                                        (#pt-use exists (0))
                                        #pt-nat
                                        (#pt-lambda
                                          ((candidate-third #pt-nat))
                                          (#pt-app
                                            (#pt-use conjunction ())
                                            (#pt-app
                                              (#pt-use natural-cubic-solution ())
                                              reduced-first
                                              candidate-second
                                              candidate-third)
                                            (#pt-app (#pt-use less-than ()) candidate-third third))))))
                                  (#pt-lambda
                                    (
                                      (certificate
                                        (#pt-app
                                          (#pt-use exists (0))
                                          #pt-nat
                                          (#pt-lambda
                                            ((candidate-second #pt-nat))
                                            (#pt-app
                                              (#pt-use exists (0))
                                              #pt-nat
                                              (#pt-lambda
                                                ((candidate-third #pt-nat))
                                                (#pt-app
                                                  (#pt-use conjunction ())
                                                  (#pt-app
                                                    (#pt-use natural-cubic-solution ())
                                                    reduced-first
                                                    candidate-second
                                                    candidate-third)
                                                  (#pt-app
                                                    (#pt-use less-than ())
                                                    candidate-third
                                                    third))))))))
                                    (#pt-use has-natural-primitive-cubic ()))
                                  (
                                    (#pt-lambda
                                      (
                                        (reduced-second #pt-nat)
                                        (third-certificate
                                          (#pt-app
                                            (#pt-use exists (0))
                                            #pt-nat
                                            (#pt-lambda
                                              ((candidate-third #pt-nat))
                                              (#pt-app
                                                (#pt-use conjunction ())
                                                (#pt-app
                                                  (#pt-use natural-cubic-solution ())
                                                  reduced-first
                                                  reduced-second
                                                  candidate-third)
                                                (#pt-app
                                                  (#pt-use less-than ())
                                                  candidate-third
                                                  third))))))
                                      (#pt-induct
                                        exists
                                        (0)
                                        (#pt-nat
                                          (#pt-lambda
                                            ((candidate-third #pt-nat))
                                            (#pt-app
                                              (#pt-use conjunction ())
                                              (#pt-app
                                                (#pt-use natural-cubic-solution ())
                                                reduced-first
                                                reduced-second
                                                candidate-third)
                                              (#pt-app (#pt-use less-than ()) candidate-third third))))
                                        (#pt-lambda
                                          (
                                            (certificate
                                              (#pt-app
                                                (#pt-use exists (0))
                                                #pt-nat
                                                (#pt-lambda
                                                  ((candidate-third #pt-nat))
                                                  (#pt-app
                                                    (#pt-use conjunction ())
                                                    (#pt-app
                                                      (#pt-use natural-cubic-solution ())
                                                      reduced-first
                                                      reduced-second
                                                      candidate-third)
                                                    (#pt-app
                                                      (#pt-use less-than ())
                                                      candidate-third
                                                      third))))))
                                          (#pt-use has-natural-primitive-cubic ()))
                                        (
                                          (#pt-lambda
                                            (
                                              (reduced-third #pt-nat)
                                              (smaller-certificate
                                                (#pt-app
                                                  (#pt-use conjunction ())
                                                  (#pt-app
                                                    (#pt-use natural-cubic-solution ())
                                                    reduced-first
                                                    reduced-second
                                                    reduced-third)
                                                  (#pt-app
                                                    (#pt-use less-than ())
                                                    reduced-third
                                                    third))))
                                            (#pt-app
                                              (#pt-app
                                                smaller-cases
                                                reduced-third
                                                (#pt-app
                                                  (#pt-use conjunction-right ())
                                                  (#pt-app
                                                    (#pt-use natural-cubic-solution ())
                                                    reduced-first
                                                    reduced-second
                                                    reduced-third)
                                                  (#pt-app
                                                    (#pt-use less-than ())
                                                    reduced-third
                                                    third)
                                                  smaller-certificate))
                                              reduced-first
                                              reduced-second
                                              (#pt-app
                                                (#pt-use conjunction-left ())
                                                (#pt-app
                                                  (#pt-use natural-cubic-solution ())
                                                  reduced-first
                                                  reduced-second
                                                  reduced-third)
                                                (#pt-app (#pt-use less-than ()) reduced-third third)
                                                smaller-certificate))))
                                        third-certificate)))
                                  second-certificate)))
                            (#pt-app
                              (#pt-use cubic-common-prime-descends ())
                              first
                              second
                              third
                              solution
                              prime-number
                              (#pt-app
                                (#pt-use conjunction-left ())
                                (#pt-app (#pt-use prime ()) prime-number)
                                (#pt-app (#pt-use divides ()) prime-number greatest-divisor)
                                prime-certificate)
                              (#pt-app
                                (#pt-use divides-transitive ())
                                prime-number
                                greatest-divisor
                                first
                                (#pt-app
                                  (#pt-use conjunction-right ())
                                  (#pt-app (#pt-use prime ()) prime-number)
                                  (#pt-app (#pt-use divides ()) prime-number greatest-divisor)
                                  prime-certificate)
                                (#pt-app
                                  (#pt-use conjunction-left ())
                                  (#pt-app (#pt-use divides ()) greatest-divisor first)
                                  (#pt-app
                                    (#pt-use conjunction ())
                                    (#pt-app (#pt-use divides ()) greatest-divisor second)
                                    (#pt-pi
                                      (
                                        (candidate-common #pt-nat)
                                        (candidate-first
                                          (#pt-app (#pt-use divides ()) candidate-common first))
                                        (candidate-second
                                          (#pt-app (#pt-use divides ()) candidate-common second)))
                                      (#pt-app
                                        (#pt-use divides ())
                                        candidate-common
                                        greatest-divisor)))
                                  gcd-proof))
                              (#pt-app
                                (#pt-use divides-transitive ())
                                prime-number
                                greatest-divisor
                                second
                                (#pt-app
                                  (#pt-use conjunction-right ())
                                  (#pt-app (#pt-use prime ()) prime-number)
                                  (#pt-app (#pt-use divides ()) prime-number greatest-divisor)
                                  prime-certificate)
                                (#pt-app
                                  (#pt-use conjunction-left ())
                                  (#pt-app (#pt-use divides ()) greatest-divisor second)
                                  (#pt-pi
                                    (
                                      (candidate-common #pt-nat)
                                      (candidate-first
                                        (#pt-app (#pt-use divides ()) candidate-common first))
                                      (candidate-second
                                        (#pt-app (#pt-use divides ()) candidate-common second)))
                                    (#pt-app (#pt-use divides ()) candidate-common greatest-divisor))
                                  (#pt-app
                                    (#pt-use conjunction-right ())
                                    (#pt-app (#pt-use divides ()) greatest-divisor first)
                                    (#pt-app
                                      (#pt-use conjunction ())
                                      (#pt-app (#pt-use divides ()) greatest-divisor second)
                                      (#pt-pi
                                        (
                                          (candidate-common #pt-nat)
                                          (candidate-first
                                            (#pt-app (#pt-use divides ()) candidate-common first))
                                          (candidate-second
                                            (#pt-app (#pt-use divides ()) candidate-common second)))
                                        (#pt-app
                                          (#pt-use divides ())
                                          candidate-common
                                          greatest-divisor)))
                                    gcd-proof)))))))
                      (#pt-app (#pt-use exists-prime-divisor ()) greatest-divisor larger-than-one)))
                  unit-or-large))
              (#pt-app (#pt-use zero-one-or-large ()) greatest-divisor))))
        (#pt-app (#pt-use gcd-exists ()) first second)))))
(#theorem natural-cubic-has-primitive
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter third #pt-nat)
    (#parameter solution (#pt-app (#pt-use natural-cubic-solution ()) first second third)))
  (#statement (#pt-use has-natural-primitive-cubic ()))
  (#proof
    (#pt-app
      (#pt-app
        (#pt-app
          (#pt-use strong-induction ())
          (#pt-lambda
            ((bound #pt-nat))
            (#pt-pi
              (
                (candidate-first #pt-nat)
                (candidate-second #pt-nat)
                (candidate-solution
                  (#pt-app
                    (#pt-use natural-cubic-solution ())
                    candidate-first
                    candidate-second
                    bound)))
              (#pt-use has-natural-primitive-cubic ())))
          (#pt-lambda
            (
              (bound #pt-nat)
              (previous-cases
                (#pt-pi
                  ((earlier #pt-nat) (earlier-proof (#pt-app (#pt-use less-than ()) earlier bound)))
                  (#pt-pi
                    (
                      (candidate-first #pt-nat)
                      (candidate-second #pt-nat)
                      (candidate-solution
                        (#pt-app
                          (#pt-use natural-cubic-solution ())
                          candidate-first
                          candidate-second
                          earlier)))
                    (#pt-use has-natural-primitive-cubic ())))))
            (#pt-app (#pt-use natural-cubic-primitive-induction-step ()) bound previous-cases)))
        third)
      first
      second
      solution)))
(#theorem natural-cubic-refuted-by-primitive
  (#universes)
  (#parameters
    (#parameter primitive-case (#pt-pi ((case-first #pt-nat) (case-second #pt-nat) (case-third #pt-nat) (case-solution (#pt-app (#pt-use natural-cubic-solution ()) case-first case-second case-third)) (case-coprime (#pt-app (#pt-use coprime ()) case-first case-second))) #pt-false))
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter third #pt-nat)
    (#parameter solution (#pt-app (#pt-use natural-cubic-solution ()) first second third)))
  (#statement #pt-false)
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-first #pt-nat))
          (#pt-app
            (#pt-use exists (0))
            #pt-nat
            (#pt-lambda
              ((candidate-second #pt-nat))
              (#pt-app
                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((candidate-third #pt-nat))
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app
                      (#pt-use natural-cubic-solution ())
                      candidate-first
                      candidate-second
                      candidate-third)
                    (#pt-app (#pt-use coprime ()) candidate-first candidate-second))))))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-first #pt-nat))
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((candidate-second #pt-nat))
                    (#pt-app
                      (#pt-use exists (0))
                      #pt-nat
                      (#pt-lambda
                        ((candidate-third #pt-nat))
                        (#pt-app
                          (#pt-use conjunction ())
                          (#pt-app
                            (#pt-use natural-cubic-solution ())
                            candidate-first
                            candidate-second
                            candidate-third)
                          (#pt-app (#pt-use coprime ()) candidate-first candidate-second))))))))))
        #pt-false)
      (
        (#pt-lambda
          (
            (primitive-first #pt-nat)
            (second-certificate
              (#pt-app
                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((candidate-second #pt-nat))
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((candidate-third #pt-nat))
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-app
                          (#pt-use natural-cubic-solution ())
                          primitive-first
                          candidate-second
                          candidate-third)
                        (#pt-app (#pt-use coprime ()) primitive-first candidate-second))))))))
          (#pt-induct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-second #pt-nat))
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((candidate-third #pt-nat))
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app
                        (#pt-use natural-cubic-solution ())
                        primitive-first
