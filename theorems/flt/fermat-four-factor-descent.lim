(#theorem four-two-remove-second-prime-square
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter hypotenuse #pt-nat)
    (#parameter prime-number #pt-nat)
    (#parameter reduced-first #pt-nat)
    (#parameter reduced-second #pt-nat)
    (#parameter first-reduced-hypotenuse #pt-nat)
    (#parameter next-hypotenuse #pt-nat)
    (#parameter counterexample (#pt-app (#pt-use fermat-four-two ()) first second hypotenuse))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter first-equation (#pt-eq #pt-nat first (#pt-app (#pt-use multiply ()) prime-number reduced-first)))
    (#parameter second-equation (#pt-eq #pt-nat second (#pt-app (#pt-use multiply ()) prime-number reduced-second)))
    (#parameter hypotenuse-equation (#pt-eq #pt-nat hypotenuse (#pt-app (#pt-use multiply ()) prime-number first-reduced-hypotenuse)))
    (#parameter second-hypotenuse-equation (#pt-eq #pt-nat first-reduced-hypotenuse (#pt-app (#pt-use multiply ()) prime-number next-hypotenuse))))
  (#statement (#pt-app (#pt-use fermat-four-two ()) reduced-first reduced-second next-hypotenuse))
  (#proof
    (#pt-construct
      fermat-four-two
      ()
      (reduced-first reduced-second next-hypotenuse)
      introduce
      (
        (#pt-lambda
          ((zero-first (#pt-eq #pt-nat reduced-first #pt-zero)))
          (#pt-app
            (#pt-project fermat-four-two 0 counterexample)
            (#pt-app
              (#pt-use transitivity (0))
              #pt-nat
              first
              (#pt-app (#pt-use multiply ()) prime-number #pt-zero)
              #pt-zero
              (#pt-app
                (#pt-use transitivity (0))
                #pt-nat
                first
                (#pt-app (#pt-use multiply ()) prime-number reduced-first)
                (#pt-app (#pt-use multiply ()) prime-number #pt-zero)
                first-equation
                (#pt-app
                  (#pt-use congruence (0 0))
                  #pt-nat
                  #pt-nat
                  (#pt-lambda
                    ((endpoint #pt-nat))
                    (#pt-app (#pt-use multiply ()) prime-number endpoint))
                  reduced-first
                  #pt-zero
                  zero-first))
              (#pt-app (#pt-use multiply-zero-right ()) prime-number))))
        (#pt-lambda
          ((zero-second (#pt-eq #pt-nat reduced-second #pt-zero)))
          (#pt-app
            (#pt-project fermat-four-two 1 counterexample)
            (#pt-app
              (#pt-use transitivity (0))
              #pt-nat
              second
              (#pt-app (#pt-use multiply ()) prime-number #pt-zero)
              #pt-zero
              (#pt-app
                (#pt-use transitivity (0))
                #pt-nat
                second
                (#pt-app (#pt-use multiply ()) prime-number reduced-second)
                (#pt-app (#pt-use multiply ()) prime-number #pt-zero)
                second-equation
                (#pt-app
                  (#pt-use congruence (0 0))
                  #pt-nat
                  #pt-nat
                  (#pt-lambda
                    ((endpoint #pt-nat))
                    (#pt-app (#pt-use multiply ()) prime-number endpoint))
                  reduced-second
                  #pt-zero
                  zero-second))
              (#pt-app (#pt-use multiply-zero-right ()) prime-number))))
        (#pt-app
          (#pt-use multiply-cancel-left-nonzero ())
          (#pt-app (#pt-use multiply ()) prime-number prime-number)
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use quartic ()) reduced-first)
            (#pt-app (#pt-use quartic ()) reduced-second))
          (#pt-app (#pt-use multiply ()) next-hypotenuse next-hypotenuse)
          (#pt-app
            (#pt-use multiply-nonzero ())
            prime-number
            prime-number
            (#pt-app
              (#pt-use less-than-upper-nonzero ())
              (#pt-succ #pt-zero)
              prime-number
              (#pt-app (#pt-use prime-larger-than-one ()) prime-number prime-proof))
            (#pt-app
              (#pt-use less-than-upper-nonzero ())
              (#pt-succ #pt-zero)
              prime-number
              (#pt-app (#pt-use prime-larger-than-one ()) prime-number prime-proof)))
          (#pt-app
            (#pt-use transitivity (0))
            #pt-nat
            (#pt-app
              (#pt-use multiply ())
              (#pt-app (#pt-use multiply ()) prime-number prime-number)
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use quartic ()) reduced-first)
                (#pt-app (#pt-use quartic ()) reduced-second)))
            (#pt-app (#pt-use multiply ()) first-reduced-hypotenuse first-reduced-hypotenuse)
            (#pt-app
              (#pt-use multiply ())
              (#pt-app (#pt-use multiply ()) prime-number prime-number)
              (#pt-app (#pt-use multiply ()) next-hypotenuse next-hypotenuse))
            (#pt-app
              (#pt-use four-two-remove-first-prime-square ())
              first
              second
              hypotenuse
              prime-number
              reduced-first
              reduced-second
              first-reduced-hypotenuse
              counterexample
              prime-proof
              first-equation
              second-equation
              hypotenuse-equation)
            (#pt-app
              (#pt-use transitivity (0))
              #pt-nat
              (#pt-app (#pt-use multiply ()) first-reduced-hypotenuse first-reduced-hypotenuse)
              (#pt-app
                (#pt-use multiply ())
                (#pt-app (#pt-use multiply ()) prime-number next-hypotenuse)
                (#pt-app (#pt-use multiply ()) prime-number next-hypotenuse))
              (#pt-app
                (#pt-use multiply ())
                (#pt-app (#pt-use multiply ()) prime-number prime-number)
                (#pt-app (#pt-use multiply ()) next-hypotenuse next-hypotenuse))
              (#pt-app
                (#pt-use congruence (0 0))
                #pt-nat
                #pt-nat
                (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use multiply ()) endpoint endpoint))
                first-reduced-hypotenuse
                (#pt-app (#pt-use multiply ()) prime-number next-hypotenuse)
