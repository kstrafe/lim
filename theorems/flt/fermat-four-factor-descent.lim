(#theorem quartic-product
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use quartic ()) (#pt-app (#pt-use multiply ()) first second))
      (#pt-app
        (#pt-use multiply ())
        (#pt-app (#pt-use quartic ()) first)
        (#pt-app (#pt-use quartic ()) second))))
  (#proof
    (#pt-app
      (#pt-use transitivity (0))
      #pt-nat
      (#pt-app (#pt-use quartic ()) (#pt-app (#pt-use multiply ()) first second))
      (#pt-app
        (#pt-use multiply ())
        (#pt-app
          (#pt-use multiply ())
          (#pt-app (#pt-use multiply ()) first first)
          (#pt-app (#pt-use multiply ()) second second))
        (#pt-app
          (#pt-use multiply ())
          (#pt-app (#pt-use multiply ()) first first)
          (#pt-app (#pt-use multiply ()) second second)))
      (#pt-app
        (#pt-use multiply ())
        (#pt-app (#pt-use quartic ()) first)
        (#pt-app (#pt-use quartic ()) second))
      (#pt-app
        (#pt-use congruence (0 0))
        #pt-nat
        #pt-nat
        (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use multiply ()) endpoint endpoint))
        (#pt-app
          (#pt-use multiply ())
          (#pt-app (#pt-use multiply ()) first second)
          (#pt-app (#pt-use multiply ()) first second))
        (#pt-app
          (#pt-use multiply ())
          (#pt-app (#pt-use multiply ()) first first)
          (#pt-app (#pt-use multiply ()) second second))
        (#pt-app (#pt-use square-product ()) first second))
      (#pt-app
        (#pt-use square-product ())
        (#pt-app (#pt-use multiply ()) first first)
        (#pt-app (#pt-use multiply ()) second second)))))
