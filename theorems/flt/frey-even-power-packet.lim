(#math-definition integer-even-power-packet ()
  (#pt-pi
    (
      (exponent #pt-nat)
      (first (#pt-use integer ()))
      (second (#pt-use integer ()))
      (third (#pt-use integer ())))
    #pt-prop)
  (#pt-lambda
    (
      (exponent #pt-nat)
      (first (#pt-use integer ()))
      (second (#pt-use integer ()))
      (third (#pt-use integer ())))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-pi
        ((denied-proof (#pt-app (#pt-use integer-equal ()) first (#pt-use integer-zero ()))))
        #pt-false)
      (#pt-app
        (#pt-use conjunction ())
        (#pt-pi
          ((denied-proof (#pt-app (#pt-use integer-equal ()) second (#pt-use integer-zero ()))))
          #pt-false)
        (#pt-app
          (#pt-use conjunction ())
          (#pt-pi
            ((denied-proof (#pt-app (#pt-use integer-equal ()) third (#pt-use integer-zero ()))))
            #pt-false)
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app (#pt-use integer-gcd-spec ()) first second (#pt-succ #pt-zero))
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app
                (#pt-use integer-divides ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-succ (#pt-succ #pt-zero)))
                second)
              (#pt-app
                (#pt-use integer-equal ())
                (#pt-app
                  (#pt-use integer-add ())
                  (#pt-app (#pt-use integer-power ()) first exponent)
                  (#pt-app (#pt-use integer-power ()) second exponent))
                (#pt-app (#pt-use integer-power ()) third exponent)))))))))
(#math-definition has-integer-even-power-packet ()
  (#pt-pi ((exponent #pt-nat)) #pt-prop)
  (#pt-lambda
    ((exponent #pt-nat))
    (#pt-app
      (#pt-use exists (0))
      (#pt-use integer ())
      (#pt-lambda
        ((candidate-first (#pt-use integer ())))
        (#pt-app
          (#pt-use exists (0))
          (#pt-use integer ())
          (#pt-lambda
            ((candidate-second (#pt-use integer ())))
            (#pt-app
              (#pt-use exists (0))
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-third (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-even-power-packet ())
                  exponent
                  candidate-first
                  candidate-second
                  candidate-third)))))))))
