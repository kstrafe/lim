; Coefficientwise curve equivalence uses the proved integer/rational
; equivalences, not raw fraction or record identity. Integer embedding
; reflects every coefficient, giving actual integral-model uniqueness.
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias rational-equal = ./rational-defs.lim::rational-equal)
(#alias rational-reflexive = ./rational-equality.lim::rational-reflexive)
(#alias rational-symmetric = ./rational-equality.lim::rational-symmetric)
(#alias rational-transitive = ./rational-equality.lim::rational-transitive)
(#alias rational-weierstrass-curve = ./rational-weierstrass-defs.lim::rational-weierstrass-curve)
(#alias integer-weierstrass-curve = ./integer-weierstrass-defs.lim::integer-weierstrass-curve)
(#alias
  integer-weierstrass-map-rational
  =
  ./integer-weierstrass-defs.lim::integer-weierstrass-map-rational)
(#alias
  rational-integer-embedding-injective
  =
  ./rational-fractions.lim::rational-integer-embedding-injective)
(#math-definition rational-weierstrass-equivalent ()
  (#pt-pi
    (
      (first-curve (#pt-use rational-weierstrass-curve ()))
      (second-curve (#pt-use rational-weierstrass-curve ())))
    #pt-prop)
  (#pt-lambda
    (
      (first-curve (#pt-use rational-weierstrass-curve ()))
      (second-curve (#pt-use rational-weierstrass-curve ())))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app
        (#pt-use rational-equal ())
        (#pt-project rational-weierstrass-curve 0 first-curve)
        (#pt-project rational-weierstrass-curve 0 second-curve))
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app
          (#pt-use rational-equal ())
          (#pt-project rational-weierstrass-curve 1 first-curve)
          (#pt-project rational-weierstrass-curve 1 second-curve))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-project rational-weierstrass-curve 2 first-curve)
            (#pt-project rational-weierstrass-curve 2 second-curve))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 3 first-curve)
              (#pt-project rational-weierstrass-curve 3 second-curve))
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 4 first-curve)
              (#pt-project rational-weierstrass-curve 4 second-curve))))))))
(#math-definition integer-weierstrass-equivalent ()
  (#pt-pi
    (
      (first-curve (#pt-use integer-weierstrass-curve ()))
