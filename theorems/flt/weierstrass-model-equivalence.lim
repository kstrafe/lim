              (#pt-project integer-weierstrass-curve 4 first-curve)
              (#pt-project integer-weierstrass-curve 4 second-curve))))))))
(#theorem rational-weierstrass-reflexive
  (#universes)
  (#parameters
    (#parameter first-curve (#pt-use rational-weierstrass-curve ())))
  (#statement (#pt-app (#pt-use rational-weierstrass-equivalent ()) first-curve first-curve))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use rational-equal ())
        (#pt-project rational-weierstrass-curve 0 first-curve)
        (#pt-project rational-weierstrass-curve 0 first-curve))
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app
          (#pt-use rational-equal ())
          (#pt-project rational-weierstrass-curve 1 first-curve)
          (#pt-project rational-weierstrass-curve 1 first-curve))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-project rational-weierstrass-curve 2 first-curve)
            (#pt-project rational-weierstrass-curve 2 first-curve))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 3 first-curve)
              (#pt-project rational-weierstrass-curve 3 first-curve))
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 4 first-curve)
              (#pt-project rational-weierstrass-curve 4 first-curve)))))
      (#pt-app
        (#pt-use rational-reflexive ())
        (#pt-project rational-weierstrass-curve 0 first-curve))
      (#pt-app
        (#pt-use conjunction-introduce ())
        (#pt-app
          (#pt-use rational-equal ())
          (#pt-project rational-weierstrass-curve 1 first-curve)
          (#pt-project rational-weierstrass-curve 1 first-curve))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-project rational-weierstrass-curve 2 first-curve)
            (#pt-project rational-weierstrass-curve 2 first-curve))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 3 first-curve)
              (#pt-project rational-weierstrass-curve 3 first-curve))
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 4 first-curve)
              (#pt-project rational-weierstrass-curve 4 first-curve))))
        (#pt-app
          (#pt-use rational-reflexive ())
          (#pt-project rational-weierstrass-curve 1 first-curve))
        (#pt-app
          (#pt-use conjunction-introduce ())
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-project rational-weierstrass-curve 2 first-curve)
            (#pt-project rational-weierstrass-curve 2 first-curve))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 3 first-curve)
              (#pt-project rational-weierstrass-curve 3 first-curve))
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 4 first-curve)
              (#pt-project rational-weierstrass-curve 4 first-curve)))
          (#pt-app
            (#pt-use rational-reflexive ())
            (#pt-project rational-weierstrass-curve 2 first-curve))
          (#pt-app
            (#pt-use conjunction-introduce ())
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 3 first-curve)
              (#pt-project rational-weierstrass-curve 3 first-curve))
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 4 first-curve)
              (#pt-project rational-weierstrass-curve 4 first-curve))
            (#pt-app
              (#pt-use rational-reflexive ())
              (#pt-project rational-weierstrass-curve 3 first-curve))
            (#pt-app
              (#pt-use rational-reflexive ())
              (#pt-project rational-weierstrass-curve 4 first-curve))))))))
(#theorem rational-weierstrass-symmetric
  (#universes)
  (#parameters
    (#parameter first-curve (#pt-use rational-weierstrass-curve ()))
    (#parameter second-curve (#pt-use rational-weierstrass-curve ()))
    (#parameter coefficient-agreement (#pt-app (#pt-use rational-weierstrass-equivalent ()) first-curve second-curve)))
  (#statement (#pt-app (#pt-use rational-weierstrass-equivalent ()) second-curve first-curve))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use rational-equal ())
        (#pt-project rational-weierstrass-curve 0 second-curve)
        (#pt-project rational-weierstrass-curve 0 first-curve))
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app
          (#pt-use rational-equal ())
          (#pt-project rational-weierstrass-curve 1 second-curve)
          (#pt-project rational-weierstrass-curve 1 first-curve))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-project rational-weierstrass-curve 2 second-curve)
            (#pt-project rational-weierstrass-curve 2 first-curve))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 3 second-curve)
              (#pt-project rational-weierstrass-curve 3 first-curve))
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 4 second-curve)
              (#pt-project rational-weierstrass-curve 4 first-curve)))))
      (#pt-app
        (#pt-use rational-symmetric ())
        (#pt-project rational-weierstrass-curve 0 first-curve)
        (#pt-project rational-weierstrass-curve 0 second-curve)
        (#pt-project conjunction 0 coefficient-agreement))
      (#pt-app
        (#pt-use conjunction-introduce ())
        (#pt-app
          (#pt-use rational-equal ())
          (#pt-project rational-weierstrass-curve 1 second-curve)
          (#pt-project rational-weierstrass-curve 1 first-curve))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-project rational-weierstrass-curve 2 second-curve)
            (#pt-project rational-weierstrass-curve 2 first-curve))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 3 second-curve)
              (#pt-project rational-weierstrass-curve 3 first-curve))
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 4 second-curve)
              (#pt-project rational-weierstrass-curve 4 first-curve))))
        (#pt-app
          (#pt-use rational-symmetric ())
          (#pt-project rational-weierstrass-curve 1 first-curve)
          (#pt-project rational-weierstrass-curve 1 second-curve)
          (#pt-project conjunction 0 (#pt-project conjunction 1 coefficient-agreement)))
        (#pt-app
          (#pt-use conjunction-introduce ())
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-project rational-weierstrass-curve 2 second-curve)
            (#pt-project rational-weierstrass-curve 2 first-curve))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 3 second-curve)
              (#pt-project rational-weierstrass-curve 3 first-curve))
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 4 second-curve)
              (#pt-project rational-weierstrass-curve 4 first-curve)))
          (#pt-app
            (#pt-use rational-symmetric ())
            (#pt-project rational-weierstrass-curve 2 first-curve)
            (#pt-project rational-weierstrass-curve 2 second-curve)
            (#pt-project
              conjunction
              0
              (#pt-project conjunction 1 (#pt-project conjunction 1 coefficient-agreement))))
          (#pt-app
            (#pt-use conjunction-introduce ())
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 3 second-curve)
              (#pt-project rational-weierstrass-curve 3 first-curve))
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 4 second-curve)
              (#pt-project rational-weierstrass-curve 4 first-curve))
            (#pt-app
              (#pt-use rational-symmetric ())
              (#pt-project rational-weierstrass-curve 3 first-curve)
              (#pt-project rational-weierstrass-curve 3 second-curve)
              (#pt-project
                conjunction
                0
                (#pt-project
                  conjunction
                  1
                  (#pt-project conjunction 1 (#pt-project conjunction 1 coefficient-agreement)))))
            (#pt-app
              (#pt-use rational-symmetric ())
              (#pt-project rational-weierstrass-curve 4 first-curve)
              (#pt-project rational-weierstrass-curve 4 second-curve)
              (#pt-project
                conjunction
                1
                (#pt-project
                  conjunction
                  1
                  (#pt-project conjunction 1 (#pt-project conjunction 1 coefficient-agreement)))))))))))
(#theorem rational-weierstrass-transitive
  (#universes)
  (#parameters
    (#parameter first-curve (#pt-use rational-weierstrass-curve ()))
    (#parameter second-curve (#pt-use rational-weierstrass-curve ()))
    (#parameter third-curve (#pt-use rational-weierstrass-curve ()))
    (#parameter first-agreement (#pt-app (#pt-use rational-weierstrass-equivalent ()) first-curve second-curve))
    (#parameter second-agreement (#pt-app (#pt-use rational-weierstrass-equivalent ()) second-curve third-curve)))
  (#statement (#pt-app (#pt-use rational-weierstrass-equivalent ()) first-curve third-curve))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use rational-equal ())
        (#pt-project rational-weierstrass-curve 0 first-curve)
        (#pt-project rational-weierstrass-curve 0 third-curve))
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app
          (#pt-use rational-equal ())
          (#pt-project rational-weierstrass-curve 1 first-curve)
          (#pt-project rational-weierstrass-curve 1 third-curve))
