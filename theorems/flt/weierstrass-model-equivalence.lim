  (#pt-lambda
    (
      (first-curve (#pt-use integer-weierstrass-curve ()))
      (second-curve (#pt-use integer-weierstrass-curve ())))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project integer-weierstrass-curve 0 first-curve)
        (#pt-project integer-weierstrass-curve 0 second-curve))
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app
          (#pt-use integer-equal ())
          (#pt-project integer-weierstrass-curve 1 first-curve)
          (#pt-project integer-weierstrass-curve 1 second-curve))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-project integer-weierstrass-curve 2 first-curve)
            (#pt-project integer-weierstrass-curve 2 second-curve))
          (#pt-app
