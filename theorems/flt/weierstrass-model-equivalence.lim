              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 3 first-curve)
              (#pt-project rational-weierstrass-curve 3 third-curve))
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 4 first-curve)
              (#pt-project rational-weierstrass-curve 4 third-curve)))))
      (#pt-app
        (#pt-use rational-transitive ())
        (#pt-project rational-weierstrass-curve 0 first-curve)
        (#pt-project rational-weierstrass-curve 0 second-curve)
        (#pt-project rational-weierstrass-curve 0 third-curve)
        (#pt-project conjunction 0 first-agreement)
        (#pt-project conjunction 0 second-agreement))
      (#pt-app
        (#pt-use conjunction-introduce ())
        (#pt-app
          (#pt-use rational-equal ())
          (#pt-project rational-weierstrass-curve 1 first-curve)
          (#pt-project rational-weierstrass-curve 1 third-curve))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-project rational-weierstrass-curve 2 first-curve)
            (#pt-project rational-weierstrass-curve 2 third-curve))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 3 first-curve)
              (#pt-project rational-weierstrass-curve 3 third-curve))
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 4 first-curve)
              (#pt-project rational-weierstrass-curve 4 third-curve))))
        (#pt-app
          (#pt-use rational-transitive ())
          (#pt-project rational-weierstrass-curve 1 first-curve)
          (#pt-project rational-weierstrass-curve 1 second-curve)
          (#pt-project rational-weierstrass-curve 1 third-curve)
          (#pt-project conjunction 0 (#pt-project conjunction 1 first-agreement))
          (#pt-project conjunction 0 (#pt-project conjunction 1 second-agreement)))
        (#pt-app
          (#pt-use conjunction-introduce ())
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-project rational-weierstrass-curve 2 first-curve)
            (#pt-project rational-weierstrass-curve 2 third-curve))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 3 first-curve)
              (#pt-project rational-weierstrass-curve 3 third-curve))
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 4 first-curve)
              (#pt-project rational-weierstrass-curve 4 third-curve)))
          (#pt-app
            (#pt-use rational-transitive ())
            (#pt-project rational-weierstrass-curve 2 first-curve)
            (#pt-project rational-weierstrass-curve 2 second-curve)
            (#pt-project rational-weierstrass-curve 2 third-curve)
            (#pt-project
              conjunction
              0
              (#pt-project conjunction 1 (#pt-project conjunction 1 first-agreement)))
            (#pt-project
              conjunction
              0
              (#pt-project conjunction 1 (#pt-project conjunction 1 second-agreement))))
          (#pt-app
            (#pt-use conjunction-introduce ())
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 3 first-curve)
              (#pt-project rational-weierstrass-curve 3 third-curve))
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-project rational-weierstrass-curve 4 first-curve)
              (#pt-project rational-weierstrass-curve 4 third-curve))
            (#pt-app
              (#pt-use rational-transitive ())
              (#pt-project rational-weierstrass-curve 3 first-curve)
              (#pt-project rational-weierstrass-curve 3 second-curve)
              (#pt-project rational-weierstrass-curve 3 third-curve)
              (#pt-project
                conjunction
                0
                (#pt-project
                  conjunction
                  1
                  (#pt-project conjunction 1 (#pt-project conjunction 1 first-agreement))))
              (#pt-project
                conjunction
                0
                (#pt-project
                  conjunction
                  1
                  (#pt-project conjunction 1 (#pt-project conjunction 1 second-agreement)))))
            (#pt-app
              (#pt-use rational-transitive ())
              (#pt-project rational-weierstrass-curve 4 first-curve)
              (#pt-project rational-weierstrass-curve 4 second-curve)
              (#pt-project rational-weierstrass-curve 4 third-curve)
              (#pt-project
                conjunction
                1
                (#pt-project
                  conjunction
                  1
                  (#pt-project conjunction 1 (#pt-project conjunction 1 first-agreement))))
              (#pt-project
                conjunction
                1
                (#pt-project
                  conjunction
                  1
                  (#pt-project conjunction 1 (#pt-project conjunction 1 second-agreement)))))))))))
(#theorem integer-weierstrass-map-injective
  (#universes)
  (#parameters
    (#parameter first-curve (#pt-use integer-weierstrass-curve ()))
    (#parameter second-curve (#pt-use integer-weierstrass-curve ()))
    (#parameter coefficient-agreement (#pt-app (#pt-use rational-weierstrass-equivalent ()) (#pt-app (#pt-use integer-weierstrass-map-rational ()) first-curve) (#pt-app (#pt-use integer-weierstrass-map-rational ()) second-curve))))
  (#statement (#pt-app (#pt-use integer-weierstrass-equivalent ()) first-curve second-curve))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project integer-weierstrass-curve 0 first-curve)
        (#pt-project integer-weierstrass-curve 0 second-curve))
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app
          (#pt-use integer-equal ())
          (#pt-project integer-weierstrass-curve 1 first-curve)
