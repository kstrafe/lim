(#theorem integer-weierstrass-b2-map
  (#universes)
  (#parameters
    (#parameter curve (#pt-use integer-weierstrass-curve ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-weierstrass-b2 ())
        (#pt-app (#pt-use integer-weierstrass-map-rational ()) curve))
      (#pt-app (#pt-use rational-of-integer ()) (#pt-app (#pt-use integer-weierstrass-b2 ()) curve))))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project
            rational-weierstrass-curve
            0
            (#pt-app (#pt-use integer-weierstrass-map-rational ()) curve))
          (#pt-numeral 2))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
          (#pt-project
            rational-weierstrass-curve
            1
            (#pt-app (#pt-use integer-weierstrass-map-rational ()) curve))))
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app
            (#pt-use integer-power ())
            (#pt-project integer-weierstrass-curve 0 curve)
            (#pt-numeral 2)))
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))
            (#pt-project integer-weierstrass-curve 1 curve))))
      (#pt-app
        (#pt-use rational-of-integer ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-power ())
            (#pt-project integer-weierstrass-curve 0 curve)
            (#pt-numeral 2))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))
            (#pt-project integer-weierstrass-curve 1 curve))))
      (#pt-app
        (#pt-use rational-add-congruent ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project
            rational-weierstrass-curve
            0
            (#pt-app (#pt-use integer-weierstrass-map-rational ()) curve))
          (#pt-numeral 2))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
          (#pt-project
            rational-weierstrass-curve
            1
            (#pt-app (#pt-use integer-weierstrass-map-rational ()) curve)))
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app
            (#pt-use integer-power ())
            (#pt-project integer-weierstrass-curve 0 curve)
            (#pt-numeral 2)))
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))
            (#pt-project integer-weierstrass-curve 1 curve)))
        (#pt-app
          (#pt-use rational-transitive ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-project
              rational-weierstrass-curve
              0
              (#pt-app (#pt-use integer-weierstrass-map-rational ()) curve))
            (#pt-numeral 2))
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-project integer-weierstrass-curve 0 curve))
            (#pt-numeral 2))
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-power ())
              (#pt-project integer-weierstrass-curve 0 curve)
              (#pt-numeral 2)))
          (#pt-app
            (#pt-use rational-power-congruent ())
            (#pt-project
              rational-weierstrass-curve
              0
              (#pt-app (#pt-use integer-weierstrass-map-rational ()) curve))
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-project integer-weierstrass-curve 0 curve))
            (#pt-numeral 2)
            (#pt-app
              (#pt-use rational-reflexive ())
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-project integer-weierstrass-curve 0 curve))))
          (#pt-app
            (#pt-use rational-of-integer-power ())
            (#pt-project integer-weierstrass-curve 0 curve)
            (#pt-numeral 2)))
        (#pt-app
          (#pt-use rational-transitive ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
            (#pt-project
              rational-weierstrass-curve
              1
              (#pt-app (#pt-use integer-weierstrass-map-rational ()) curve)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-project integer-weierstrass-curve 1 curve)))
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))
              (#pt-project integer-weierstrass-curve 1 curve)))
          (#pt-app
            (#pt-use rational-multiply-congruent ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
            (#pt-project
              rational-weierstrass-curve
              1
              (#pt-app (#pt-use integer-weierstrass-map-rational ()) curve))
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-project integer-weierstrass-curve 1 curve))
            (#pt-app
              (#pt-use rational-reflexive ())
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))))
            (#pt-app
              (#pt-use rational-reflexive ())
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-project integer-weierstrass-curve 1 curve))))
          (#pt-app
            (#pt-use rational-of-integer-multiply ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))
            (#pt-project integer-weierstrass-curve 1 curve))))
      (#pt-app
        (#pt-use rational-of-integer-add ())
        (#pt-app
          (#pt-use integer-power ())
          (#pt-project integer-weierstrass-curve 0 curve)
          (#pt-numeral 2))
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))
          (#pt-project integer-weierstrass-curve 1 curve))))))
(#theorem integer-weierstrass-b4-map
  (#universes)
  (#parameters
    (#parameter curve (#pt-use integer-weierstrass-curve ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-weierstrass-b4 ())
        (#pt-app (#pt-use integer-weierstrass-map-rational ()) curve))
      (#pt-app (#pt-use rational-of-integer ()) (#pt-app (#pt-use integer-weierstrass-b4 ()) curve))))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
          (#pt-project
            rational-weierstrass-curve
            3
            (#pt-app (#pt-use integer-weierstrass-map-rational ()) curve)))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-project
            rational-weierstrass-curve
            0
            (#pt-app (#pt-use integer-weierstrass-map-rational ()) curve))
          (#pt-project
            rational-weierstrass-curve
            2
            (#pt-app (#pt-use integer-weierstrass-map-rational ()) curve))))
      (#pt-app
