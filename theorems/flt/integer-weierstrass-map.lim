              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
            (#pt-project
              rational-weierstrass-curve
              3
              (#pt-app (#pt-use integer-weierstrass-map-rational ()) curve)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-project integer-weierstrass-curve 3 curve)))
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))
              (#pt-project integer-weierstrass-curve 3 curve)))
          (#pt-app
            (#pt-use rational-multiply-congruent ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
            (#pt-project
              rational-weierstrass-curve
              3
              (#pt-app (#pt-use integer-weierstrass-map-rational ()) curve))
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-project integer-weierstrass-curve 3 curve))
            (#pt-app
              (#pt-use rational-reflexive ())
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))))
            (#pt-app
              (#pt-use rational-reflexive ())
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-project integer-weierstrass-curve 3 curve))))
