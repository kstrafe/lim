              rational-weierstrass-curve
              0
              (#pt-app (#pt-use integer-weierstrass-map-rational ()) curve))
            (#pt-project
              rational-weierstrass-curve
              2
              (#pt-app (#pt-use integer-weierstrass-map-rational ()) curve)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-project integer-weierstrass-curve 0 curve))
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-project integer-weierstrass-curve 2 curve)))
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project integer-weierstrass-curve 0 curve)
              (#pt-project integer-weierstrass-curve 2 curve)))
          (#pt-app
            (#pt-use rational-multiply-congruent ())
            (#pt-project
              rational-weierstrass-curve
              0
              (#pt-app (#pt-use integer-weierstrass-map-rational ()) curve))
            (#pt-project
              rational-weierstrass-curve
              2
              (#pt-app (#pt-use integer-weierstrass-map-rational ()) curve))
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-project integer-weierstrass-curve 0 curve))
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-project integer-weierstrass-curve 2 curve))
            (#pt-app
