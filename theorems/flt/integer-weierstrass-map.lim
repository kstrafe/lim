            (#pt-project integer-weierstrass-curve 2 curve))))
      (#pt-app
        (#pt-use rational-of-integer-add ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))
          (#pt-project integer-weierstrass-curve 3 curve))
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-project integer-weierstrass-curve 0 curve)
          (#pt-project integer-weierstrass-curve 2 curve))))))
