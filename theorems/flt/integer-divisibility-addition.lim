; Additive divisibility cancellation for all signed divisors, including zero.
; Factors and all ring rearrangements are carried by checked proof terms.
(#alias exists = ./logic-exists.lim::exists)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-zero = ./integer-defs.lim::integer-zero)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-cube = ./integer-defs.lim::integer-cube)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-divides = ./integer-defs.lim::integer-divides)
(#alias integer-reflexive = ./integer-equality.lim::integer-reflexive)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias integer-add-congruent = ./integer-equality.lim::integer-add-congruent)
(#alias integer-add-associative = ./integer-addition.lim::integer-add-associative)
(#alias integer-add-commutative = ./integer-addition.lim::integer-add-commutative)
(#alias integer-add-inverse = ./integer-addition.lim::integer-add-inverse)
(#alias integer-add-zero = ./integer-addition.lim::integer-add-zero)
(#alias integer-multiply-commutative = ./integer-multiplication.lim::integer-multiply-commutative)
(#alias integer-multiply-distributive = ./integer-multiplication.lim::integer-multiply-distributive)
(#alias
  integer-multiply-congruent-second
  =
  ./integer-multiplication.lim::integer-multiply-congruent-second)
(#alias integer-multiply-negative = ./integer-multiplication.lim::integer-multiply-negative)
(#alias integer-multiply-two-negatives = ./integer-divisibility.lim::integer-multiply-two-negatives)
(#alias integer-multiply-zero = ./integer-multiplication.lim::integer-multiply-zero)
(#alias
  integer-divides-congruent-target
  =
  ./integer-divisibility.lim::integer-divides-congruent-target)
(#alias
  integer-divides-congruent-divisor
  =
  ./integer-divisibility.lim::integer-divides-congruent-divisor)
(#alias
  integer-divides-negative-target
  =
  ./integer-divisibility.lim::integer-divides-negative-target)
(#alias integer-divides-zero = ./integer-divisibility.lim::integer-divides-zero)
(#theorem integer-multiply-distribute-second
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-multiply ()) first (#pt-app (#pt-use integer-add ()) second third))
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use integer-multiply ()) first second)
        (#pt-app (#pt-use integer-multiply ()) first third))))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app (#pt-use integer-multiply ()) first (#pt-app (#pt-use integer-add ()) second third))
      (#pt-app (#pt-use integer-multiply ()) (#pt-app (#pt-use integer-add ()) second third) first)
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use integer-multiply ()) first second)
        (#pt-app (#pt-use integer-multiply ()) first third))
      (#pt-app
        (#pt-use integer-multiply-commutative ())
        first
        (#pt-app (#pt-use integer-add ()) second third))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app (#pt-use integer-add ()) second third)
          first)
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app (#pt-use integer-multiply ()) second first)
          (#pt-app (#pt-use integer-multiply ()) third first))
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app (#pt-use integer-multiply ()) first second)
          (#pt-app (#pt-use integer-multiply ()) first third))
        (#pt-app (#pt-use integer-multiply-distributive ()) second third first)
        (#pt-app
          (#pt-use integer-add-congruent ())
          (#pt-app (#pt-use integer-multiply ()) second first)
          (#pt-app (#pt-use integer-multiply ()) third first)
          (#pt-app (#pt-use integer-multiply ()) first second)
          (#pt-app (#pt-use integer-multiply ()) first third)
          (#pt-app (#pt-use integer-multiply-commutative ()) second first)
          (#pt-app (#pt-use integer-multiply-commutative ()) third first))))))
(#theorem integer-zero-add
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-add ()) (#pt-use integer-zero ()) first)
      first))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app (#pt-use integer-add ()) (#pt-use integer-zero ()) first)
      (#pt-app (#pt-use integer-add ()) first (#pt-use integer-zero ()))
      first
      (#pt-app (#pt-use integer-add-commutative ()) (#pt-use integer-zero ()) first)
      (#pt-app (#pt-use integer-add-zero ()) first))))
(#theorem integer-add-negative-cancel
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use integer-negate ()) first)
        (#pt-app (#pt-use integer-add ()) first second))
      second))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use integer-negate ()) first)
        (#pt-app (#pt-use integer-add ()) first second))
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-negate ()) first) first)
        second)
      second
      (#pt-app
        (#pt-use integer-symmetric ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-negate ()) first) first)
          second)
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app (#pt-use integer-negate ()) first)
          (#pt-app (#pt-use integer-add ()) first second))
        (#pt-app
          (#pt-use integer-add-associative ())
          (#pt-app (#pt-use integer-negate ()) first)
          first
          second))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-negate ()) first) first)
          second)
        (#pt-app (#pt-use integer-add ()) (#pt-use integer-zero ()) second)
        second
        (#pt-app
          (#pt-use integer-add-congruent ())
          (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-negate ()) first) first)
          second
          (#pt-use integer-zero ())
          second
          (#pt-app
            (#pt-use integer-transitive ())
            (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-negate ()) first) first)
            (#pt-app (#pt-use integer-add ()) first (#pt-app (#pt-use integer-negate ()) first))
            (#pt-use integer-zero ())
            (#pt-app
              (#pt-use integer-add-commutative ())
              (#pt-app (#pt-use integer-negate ()) first)
              first)
            (#pt-app (#pt-use integer-add-inverse ()) first))
          (#pt-app (#pt-use integer-reflexive ()) second))
        (#pt-app (#pt-use integer-zero-add ()) second)))))
(#theorem integer-divides-add
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use integer ()))
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter first-divides (#pt-app (#pt-use integer-divides ()) divisor first))
    (#parameter second-divides (#pt-app (#pt-use integer-divides ()) divisor second)))
  (#statement
    (#pt-app (#pt-use integer-divides ()) divisor (#pt-app (#pt-use integer-add ()) first second)))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use integer ())
        (#pt-lambda
          ((candidate-factor (#pt-use integer ())))
          (#pt-app
            (#pt-use integer-equal ())
            first
            (#pt-app (#pt-use integer-multiply ()) divisor candidate-factor))))
      (#pt-lambda
        (
          (integer-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  first
                  (#pt-app (#pt-use integer-multiply ()) divisor candidate-factor))))))
        (#pt-app
          (#pt-use integer-divides ())
          divisor
          (#pt-app (#pt-use integer-add ()) first second)))
      (
        (#pt-lambda
          (
            (first-factor (#pt-use integer ()))
            (first-factor-equivalence
              (#pt-app
                (#pt-use integer-equal ())
                first
                (#pt-app (#pt-use integer-multiply ()) divisor first-factor))))
          (#pt-induct
            exists
            (0)
            (
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  second
                  (#pt-app (#pt-use integer-multiply ()) divisor candidate-factor))))
            (#pt-lambda
              (
                (integer-certificate
                  (#pt-app
                    (#pt-use exists (0))
                    (#pt-use integer ())
                    (#pt-lambda
                      ((candidate-factor (#pt-use integer ())))
                      (#pt-app
                        (#pt-use integer-equal ())
                        second
                        (#pt-app (#pt-use integer-multiply ()) divisor candidate-factor))))))
              (#pt-app
                (#pt-use integer-divides ())
                divisor
                (#pt-app (#pt-use integer-add ()) first second)))
            (
              (#pt-lambda
                (
                  (second-factor (#pt-use integer ()))
                  (second-factor-equivalence
                    (#pt-app
                      (#pt-use integer-equal ())
                      second
                      (#pt-app (#pt-use integer-multiply ()) divisor second-factor))))
                (#pt-construct
                  exists
                  (0)
                  (
                    (#pt-use integer ())
                    (#pt-lambda
                      ((candidate-factor (#pt-use integer ())))
                      (#pt-app
                        (#pt-use integer-equal ())
                        (#pt-app (#pt-use integer-add ()) first second)
                        (#pt-app (#pt-use integer-multiply ()) divisor candidate-factor))))
                  introduce
                  (
                    (#pt-app (#pt-use integer-add ()) first-factor second-factor)
                    (#pt-app
                      (#pt-use integer-transitive ())
                      (#pt-app (#pt-use integer-add ()) first second)
                      (#pt-app
                        (#pt-use integer-add ())
                        (#pt-app (#pt-use integer-multiply ()) divisor first-factor)
                        (#pt-app (#pt-use integer-multiply ()) divisor second-factor))
                      (#pt-app
                        (#pt-use integer-multiply ())
                        divisor
                        (#pt-app (#pt-use integer-add ()) first-factor second-factor))
                      (#pt-app
                        (#pt-use integer-add-congruent ())
                        first
                        second
                        (#pt-app (#pt-use integer-multiply ()) divisor first-factor)
                        (#pt-app (#pt-use integer-multiply ()) divisor second-factor)
                        first-factor-equivalence
                        second-factor-equivalence)
                      (#pt-app
                        (#pt-use integer-symmetric ())
                        (#pt-app
                          (#pt-use integer-multiply ())
                          divisor
                          (#pt-app (#pt-use integer-add ()) first-factor second-factor))
                        (#pt-app
                          (#pt-use integer-add ())
                          (#pt-app (#pt-use integer-multiply ()) divisor first-factor)
                          (#pt-app (#pt-use integer-multiply ()) divisor second-factor))
                        (#pt-app
                          (#pt-use integer-multiply-distribute-second ())
                          divisor
                          first-factor
                          second-factor)))))))
            second-divides)))
      first-divides)))
(#theorem integer-divides-add-cancel-left
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use integer ()))
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter first-divides (#pt-app (#pt-use integer-divides ()) divisor first))
    (#parameter sum-divides (#pt-app (#pt-use integer-divides ()) divisor (#pt-app (#pt-use integer-add ()) first second))))
  (#statement (#pt-app (#pt-use integer-divides ()) divisor second))
  (#proof
    (#pt-app
      (#pt-use integer-divides-congruent-target ())
      divisor
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use integer-negate ()) first)
        (#pt-app (#pt-use integer-add ()) first second))
      second
      (#pt-app (#pt-use integer-add-negative-cancel ()) first second)
      (#pt-app
        (#pt-use integer-divides-add ())
        divisor
        (#pt-app (#pt-use integer-negate ()) first)
        (#pt-app (#pt-use integer-add ()) first second)
        (#pt-app (#pt-use integer-divides-negative-target ()) divisor first first-divides)
        sum-divides))))
(#theorem integer-divides-add-cancel-right
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use integer ()))
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter second-divides (#pt-app (#pt-use integer-divides ()) divisor second))
    (#parameter sum-divides (#pt-app (#pt-use integer-divides ()) divisor (#pt-app (#pt-use integer-add ()) first second))))
  (#statement (#pt-app (#pt-use integer-divides ()) divisor first))
  (#proof
    (#pt-app
      (#pt-use integer-divides-add-cancel-left ())
      divisor
      second
      first
      second-divides
      (#pt-app
        (#pt-use integer-divides-congruent-target ())
        divisor
        (#pt-app (#pt-use integer-add ()) first second)
        (#pt-app (#pt-use integer-add ()) second first)
        (#pt-app (#pt-use integer-add-commutative ()) first second)
        sum-divides))))
(#theorem integer-divides-zero-sum-other
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use integer ()))
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter first-divides (#pt-app (#pt-use integer-divides ()) divisor first))
    (#parameter sum-zero (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) first second) (#pt-use integer-zero ()))))
  (#statement (#pt-app (#pt-use integer-divides ()) divisor second))
  (#proof
    (#pt-app
      (#pt-use integer-divides-add-cancel-left ())
      divisor
      first
      second
      first-divides
      (#pt-app
        (#pt-use integer-divides-congruent-target ())
        divisor
        (#pt-use integer-zero ())
        (#pt-app (#pt-use integer-add ()) first second)
        (#pt-app
          (#pt-use integer-symmetric ())
          (#pt-app (#pt-use integer-add ()) first second)
          (#pt-use integer-zero ())
          sum-zero)
        (#pt-app (#pt-use integer-divides-zero ()) divisor)))))
(#theorem integer-zero-divisor-equivalence
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter divides-proof (#pt-app (#pt-use integer-divides ()) (#pt-use integer-zero ()) number)))
  (#statement (#pt-app (#pt-use integer-equal ()) number (#pt-use integer-zero ())))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use integer ())
        (#pt-lambda
          ((candidate-factor (#pt-use integer ())))
          (#pt-app
            (#pt-use integer-equal ())
            number
            (#pt-app (#pt-use integer-multiply ()) (#pt-use integer-zero ()) candidate-factor))))
      (#pt-lambda
        (
          (integer-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  number
                  (#pt-app (#pt-use integer-multiply ()) (#pt-use integer-zero ()) candidate-factor))))))
        (#pt-app (#pt-use integer-equal ()) number (#pt-use integer-zero ())))
      (
        (#pt-lambda
          (
            (factor (#pt-use integer ()))
            (factor-equivalence
              (#pt-app
                (#pt-use integer-equal ())
                number
                (#pt-app (#pt-use integer-multiply ()) (#pt-use integer-zero ()) factor))))
          (#pt-app
            (#pt-use integer-transitive ())
            number
            (#pt-app (#pt-use integer-multiply ()) (#pt-use integer-zero ()) factor)
            (#pt-use integer-zero ())
            factor-equivalence
            (#pt-app
              (#pt-use integer-transitive ())
              (#pt-app (#pt-use integer-multiply ()) (#pt-use integer-zero ()) factor)
              (#pt-app (#pt-use integer-multiply ()) factor (#pt-use integer-zero ()))
              (#pt-use integer-zero ())
              (#pt-app (#pt-use integer-multiply-commutative ()) (#pt-use integer-zero ()) factor)
              (#pt-app (#pt-use integer-multiply-zero ()) factor)))))
      divides-proof)))
(#theorem integer-divisor-nonzero
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use integer ()))
    (#parameter number (#pt-use integer ()))
    (#parameter number-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use integer-equal ()) number (#pt-use integer-zero ())))) #pt-false))
    (#parameter divides-proof (#pt-app (#pt-use integer-divides ()) divisor number)))
  (#statement
    (#pt-pi
      ((denied-proof (#pt-app (#pt-use integer-equal ()) divisor (#pt-use integer-zero ()))))
      #pt-false))
  (#proof
    (#pt-lambda
      ((divisor-zero (#pt-app (#pt-use integer-equal ()) divisor (#pt-use integer-zero ()))))
      (#pt-app
        number-nonzero
        (#pt-app
          (#pt-use integer-zero-divisor-equivalence ())
          number
          (#pt-app
            (#pt-use integer-divides-congruent-divisor ())
            divisor
            (#pt-use integer-zero ())
            number
            divisor-zero
            divides-proof))))))
(#theorem integer-cube-negate
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-cube ()) (#pt-app (#pt-use integer-negate ()) first))
      (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-cube ()) first))))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app (#pt-use integer-cube ()) (#pt-app (#pt-use integer-negate ()) first))
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app (#pt-use integer-negate ()) first)
        (#pt-app (#pt-use integer-multiply ()) first first))
      (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-cube ()) first))
      (#pt-app
        (#pt-use integer-multiply-congruent-second ())
        (#pt-app (#pt-use integer-negate ()) first)
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app (#pt-use integer-negate ()) first)
          (#pt-app (#pt-use integer-negate ()) first))
        (#pt-app (#pt-use integer-multiply ()) first first)
        (#pt-app (#pt-use integer-multiply-two-negatives ()) first first))
      (#pt-app
        (#pt-use integer-multiply-negative ())
        first
        (#pt-app (#pt-use integer-multiply ()) first first)))))
