(#alias finite-weierstrass-neg-y = ./finite-weierstrass-neg-y.lim::finite-weierstrass-neg-y)
(#theorem finite-weierstrass-neg-y-involution
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
    (#parameter x-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter y-coordinate (#pt-app (#pt-use finite-residue ()) modulus)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-weierstrass-neg-y ())
          modulus
          positive-modulus
          curve
          x-coordinate
          (#pt-app
            (#pt-use finite-weierstrass-neg-y ())
            modulus
            positive-modulus
            curve
            x-coordinate
            y-coordinate)))
      (#pt-project finite-residue 0 y-coordinate)))
  (#proof
    (#pt-app
      (#pt-use finite-affine-neg-y-involution-polynomial ())
      modulus
      positive-modulus
      (#pt-project finite-weierstrass-curve 0 curve)
      (#pt-project finite-weierstrass-curve 2 curve)
      x-coordinate
      y-coordinate)))
(#theorem finite-weierstrass-neg-equation
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
