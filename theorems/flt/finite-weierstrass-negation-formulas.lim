(#theorem finite-weierstrass-equation-negate
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
    (#parameter x-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter y-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter equation-proof (#pt-app (#pt-use finite-weierstrass-equation ()) modulus positive-modulus curve x-coordinate y-coordinate)))
  (#statement
    (#pt-app
      (#pt-use finite-weierstrass-equation ())
      modulus
      positive-modulus
      curve
      x-coordinate
      (#pt-app
        (#pt-use finite-weierstrass-neg-y ())
        modulus
        positive-modulus
        curve
        x-coordinate
        y-coordinate)))
  (#proof
    (#pt-app
      (#pt-use transitivity (0))
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-weierstrass-polynomial ())
          modulus
          positive-modulus
          curve
          x-coordinate
          (#pt-app
            (#pt-use finite-weierstrass-neg-y ())
            modulus
            positive-modulus
            curve
            x-coordinate
            y-coordinate)))
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-weierstrass-polynomial ())
          modulus
          positive-modulus
          curve
          x-coordinate
          y-coordinate))
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus))
      (#pt-app
        (#pt-use finite-weierstrass-neg-equation ())
        modulus
        positive-modulus
        curve
        x-coordinate
        y-coordinate)
      equation-proof)))
(#theorem finite-weierstrass-neg-y-congruent
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
    (#parameter first-x (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter first-y (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second-x (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second-y (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter x-equation (#pt-eq #pt-nat (#pt-project finite-residue 0 first-x) (#pt-project finite-residue 0 second-x)))
    (#parameter y-equation (#pt-eq #pt-nat (#pt-project finite-residue 0 first-y) (#pt-project finite-residue 0 second-y))))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-weierstrass-neg-y ())
          modulus
          positive-modulus
          curve
          first-x
          first-y))
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-weierstrass-neg-y ())
          modulus
          positive-modulus
          curve
          second-x
          second-y))))
  (#proof
    (#pt-app
      (#pt-use finite-residue-difference-congruent ())
      modulus
      positive-modulus
      (#pt-app
        (#pt-use finite-residue-difference ())
        modulus
        positive-modulus
        (#pt-app (#pt-use finite-residue-negate ()) modulus positive-modulus first-y)
        (#pt-app
          (#pt-use finite-residue-multiply ())
          modulus
          positive-modulus
          (#pt-project finite-weierstrass-curve 0 curve)
          first-x))
      (#pt-project finite-weierstrass-curve 2 curve)
      (#pt-app
        (#pt-use finite-residue-difference ())
        modulus
        positive-modulus
        (#pt-app (#pt-use finite-residue-negate ()) modulus positive-modulus second-y)
        (#pt-app
          (#pt-use finite-residue-multiply ())
          modulus
          positive-modulus
          (#pt-project finite-weierstrass-curve 0 curve)
          second-x))
      (#pt-project finite-weierstrass-curve 2 curve)
      (#pt-app
        (#pt-use finite-residue-difference-congruent ())
        modulus
        positive-modulus
        (#pt-app (#pt-use finite-residue-negate ()) modulus positive-modulus first-y)
        (#pt-app
          (#pt-use finite-residue-multiply ())
          modulus
          positive-modulus
          (#pt-project finite-weierstrass-curve 0 curve)
          first-x)
        (#pt-app (#pt-use finite-residue-negate ()) modulus positive-modulus second-y)
        (#pt-app
          (#pt-use finite-residue-multiply ())
          modulus
          positive-modulus
          (#pt-project finite-weierstrass-curve 0 curve)
          second-x)
        (#pt-app
          (#pt-use finite-residue-negate-congruent ())
          modulus
          positive-modulus
          first-y
          second-y
          y-equation)
        (#pt-app
          (#pt-use finite-residue-multiply-congruent ())
          modulus
          positive-modulus
          (#pt-project finite-weierstrass-curve 0 curve)
          first-x
          (#pt-project finite-weierstrass-curve 0 curve)
          second-x
          (#pt-refl
            #pt-nat
            (#pt-project finite-residue 0 (#pt-project finite-weierstrass-curve 0 curve)))
          x-equation))
      (#pt-refl
        #pt-nat
        (#pt-project finite-residue 0 (#pt-project finite-weierstrass-curve 2 curve))))))
