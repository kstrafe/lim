            (#pt-project finite-weierstrass-curve 0 curve)
            (#pt-app
              (#pt-use finite-weierstrass-derivative-y ())
              modulus
              positive-modulus
              curve
              x-coordinate
              y-coordinate))))))
  (#proof
    (#pt-app
      (#pt-use finite-affine-neg-derivative-x-polynomial ())
      modulus
      positive-modulus
      (#pt-project finite-weierstrass-curve 0 curve)
      (#pt-project finite-weierstrass-curve 1 curve)
      (#pt-project finite-weierstrass-curve 2 curve)
