        second-X
        sum-X
        line
        opposite)
      (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring sum-X line)
      first-X
      (#pt-app
        (#pt-use ring-ideal-member-congruent ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use point-ideal-addition-left-product ())
          Carrier
          coefficient-ring
          first-X
          second-X
          sum-X
          line
          opposite)
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          sum-X
          (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-X line))
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          first-X
          (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring sum-X line))
        (#pt-app
          (#pt-use point-ideal-addition-permutation-first ())
          Carrier
          coefficient-ring
          first-X
          second-X
          sum-X
          line
          opposite)
        (#pt-app
          (#pt-use point-ideal-addition-generator-XL ())
          Carrier
          coefficient-ring
          first-X
          second-X
          sum-X
          line
          opposite)))))
