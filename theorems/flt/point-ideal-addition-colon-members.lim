  (#statement
    (#pt-app
      (#pt-use ring-ideal-member ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-ideal-colon-element ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use point-ideal-addition-left-product ())
          Carrier
          coefficient-ring
          first-X
          second-X
          sum-X
          line
          opposite)
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring sum-X line))
      first-X))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-colon-element-member ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use point-ideal-addition-left-product ())
