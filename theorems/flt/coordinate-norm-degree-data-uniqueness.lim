; Adapted source: pinned Mathlib Affine/Point.lean:409-470.
; All polynomial, coefficient-domain and index facts are proved.
; Generated by scripts/generate-flt-norm-degrees.py; checked native terms.
; Any two valid degree certificates for one actual
; polynomial agree on both natDegree and the zero/leading tag.
; Thus zero and nonzero constants cannot be conflated by the formula.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias
  ring-polynomial-degree-data
  =
  ./ring-polynomial-degree-data.lim::ring-polynomial-degree-data)
(#alias
  ring-polynomial-degree-data-agrees
  =
  ./ring-polynomial-degree-certificates.lim::ring-polynomial-degree-data-agrees)
(#alias
  ring-polynomial-degree-data-has-leading
  =
  ./ring-polynomial-degree-data.lim::ring-polynomial-degree-data-has-leading)
(#alias
  ring-polynomial-degree-data-natural
  =
  ./ring-polynomial-degree-data.lim::ring-polynomial-degree-data-natural)
(#alias
  ring-polynomial-degree-data-nonzero-tag
  =
  ./ring-polynomial-degree-certificates.lim::ring-polynomial-degree-data-nonzero-tag)
(#alias
  ring-polynomial-degree-data-zero-natural
  =
  ./ring-polynomial-degree-computed-congruence.lim::ring-polynomial-degree-data-zero-natural)
(#alias
  ring-polynomial-degree-data-zero-tag
  =
  ./ring-polynomial-degree-certificates.lim::ring-polynomial-degree-data-zero-tag)
(#alias
  ring-polynomial-degree-nonzero
  =
  ./ring-polynomial-degree-leading.lim::ring-polynomial-degree-nonzero)
(#alias
  ring-polynomial-degree-witness
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-degree-witness)
(#alias ring-polynomial-equal = ./ring-polynomial-data.lim::ring-polynomial-equal)
(#alias symmetry = ./equality.lim::symmetry)
(#theorem coordinate-norm-degree-data-index-unique
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter first-degree-data (#pt-app (#pt-use ring-polynomial-degree-data ()) Carrier coefficient-ring polynomial))
    (#parameter second-degree-data (#pt-app (#pt-use ring-polynomial-degree-data ()) Carrier coefficient-ring polynomial)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app
        (#pt-use ring-polynomial-degree-data-natural ())
        Carrier
        coefficient-ring
        polynomial
        first-degree-data)
      (#pt-app
        (#pt-use ring-polynomial-degree-data-natural ())
        Carrier
        coefficient-ring
        polynomial
        second-degree-data)))
  (#proof
    (#pt-induct
      ring-polynomial-degree-data
      ()
      (Carrier coefficient-ring polynomial)
      (#pt-lambda
        (
          (selected-degree-data
            (#pt-app (#pt-use ring-polynomial-degree-data ()) Carrier coefficient-ring polynomial)))
        (#pt-eq
          #pt-nat
          (#pt-app
            (#pt-use ring-polynomial-degree-data-natural ())
            Carrier
            coefficient-ring
            polynomial
            selected-degree-data)
          (#pt-app
            (#pt-use ring-polynomial-degree-data-natural ())
            Carrier
            coefficient-ring
            polynomial
            second-degree-data)))
      (
        (#pt-lambda
          (
            (zero-polynomial
              (#pt-app
                (#pt-use ring-polynomial-equal ())
                Carrier
                coefficient-ring
                polynomial
                (#pt-construct finite-list () (Carrier) nil ()))))
          (#pt-app
            (#pt-use symmetry (0))
            #pt-nat
            (#pt-app
              (#pt-use ring-polynomial-degree-data-natural ())
              Carrier
              coefficient-ring
              polynomial
              second-degree-data)
            #pt-zero
            (#pt-app
              (#pt-use ring-polynomial-degree-data-zero-natural ())
              Carrier
              coefficient-ring
              polynomial
              second-degree-data
              zero-polynomial)))
        (#pt-lambda
          (
            (constant-degree #pt-nat)
            (constant-certificate
              (#pt-app
                (#pt-use ring-polynomial-degree-witness ())
                Carrier
                coefficient-ring
                polynomial
                constant-degree)))
          (#pt-app
            (#pt-use symmetry (0))
            #pt-nat
            (#pt-app
              (#pt-use ring-polynomial-degree-data-natural ())
              Carrier
              coefficient-ring
              polynomial
              second-degree-data)
            constant-degree
            (#pt-app
              (#pt-use ring-polynomial-degree-data-agrees ())
              Carrier
              coefficient-ring
              polynomial
              second-degree-data
              constant-degree
              constant-certificate))))
      first-degree-data)))
(#theorem coordinate-norm-degree-data-tag-unique
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter first-degree-data (#pt-app (#pt-use ring-polynomial-degree-data ()) Carrier coefficient-ring polynomial))
    (#parameter second-degree-data (#pt-app (#pt-use ring-polynomial-degree-data ()) Carrier coefficient-ring polynomial)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app
        (#pt-use ring-polynomial-degree-data-has-leading ())
        Carrier
        coefficient-ring
        polynomial
        first-degree-data)
      (#pt-app
        (#pt-use ring-polynomial-degree-data-has-leading ())
        Carrier
        coefficient-ring
        polynomial
        second-degree-data)))
  (#proof
    (#pt-induct
      ring-polynomial-degree-data
      ()
      (Carrier coefficient-ring polynomial)
      (#pt-lambda
        (
          (selected-degree-data
            (#pt-app (#pt-use ring-polynomial-degree-data ()) Carrier coefficient-ring polynomial)))
        (#pt-eq
          #pt-nat
          (#pt-app
            (#pt-use ring-polynomial-degree-data-has-leading ())
            Carrier
            coefficient-ring
            polynomial
            selected-degree-data)
          (#pt-app
            (#pt-use ring-polynomial-degree-data-has-leading ())
            Carrier
            coefficient-ring
            polynomial
            second-degree-data)))
      (
        (#pt-lambda
          (
            (zero-polynomial
              (#pt-app
                (#pt-use ring-polynomial-equal ())
                Carrier
                coefficient-ring
                polynomial
                (#pt-construct finite-list () (Carrier) nil ()))))
          (#pt-app
            (#pt-use symmetry (0))
            #pt-nat
            (#pt-app
              (#pt-use ring-polynomial-degree-data-has-leading ())
              Carrier
              coefficient-ring
              polynomial
              second-degree-data)
            #pt-zero
            (#pt-app
              (#pt-use ring-polynomial-degree-data-zero-tag ())
              Carrier
              coefficient-ring
              polynomial
              second-degree-data
              zero-polynomial)))
        (#pt-lambda
          (
            (constant-degree #pt-nat)
            (constant-certificate
              (#pt-app
                (#pt-use ring-polynomial-degree-witness ())
                Carrier
                coefficient-ring
                polynomial
                constant-degree)))
          (#pt-app
            (#pt-use symmetry (0))
            #pt-nat
            (#pt-app
              (#pt-use ring-polynomial-degree-data-has-leading ())
              Carrier
              coefficient-ring
              polynomial
              second-degree-data)
            (#pt-numeral 1)
            (#pt-app
              (#pt-use ring-polynomial-degree-data-nonzero-tag ())
              Carrier
              coefficient-ring
              polynomial
              second-degree-data
              (#pt-app
                (#pt-use ring-polynomial-degree-nonzero ())
                Carrier
                coefficient-ring
                polynomial
                constant-degree
                constant-certificate)))))
      first-degree-data)))
