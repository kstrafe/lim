; Adapted source: pinned Mathlib Affine/Point.lean:409-470.
; All polynomial, coefficient-domain and index facts are proved.
; Generated by scripts/generate-flt-norm-degrees.py; checked native terms.
; Construct the actual polynomial domain from only
; the coefficient-domain laws. Exhaustive negative degree elimination
; derives product nonvanishing without coefficient equality decisions
; or an excluded-middle assumption.
(#alias add = ./../fermat_statement.lim::add)
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias
  coordinate-norm-degree-exhaustive-elimination
  =
  ./coordinate-norm-degree-exhaustive.lim::coordinate-norm-degree-exhaustive-elimination)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias ring-one = ./commutative-ring-data.lim::ring-one)
(#alias
  ring-polynomial-degree-nonzero
  =
  ./ring-polynomial-degree-leading.lim::ring-polynomial-degree-nonzero)
(#alias
  ring-polynomial-degree-one
  =
  ./ring-polynomial-degree-powers.lim::ring-polynomial-degree-one)
(#alias
  ring-polynomial-degree-product
  =
  ./ring-polynomial-degree-product.lim::ring-polynomial-degree-product)
(#alias
  ring-polynomial-degree-witness
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-degree-witness)
(#alias
  ring-polynomial-domain-data
  =
  ./ring-polynomial-domain-data.lim::ring-polynomial-domain-data)
(#alias
  ring-polynomial-domain-product-nonzero
  =
  ./ring-polynomial-domain-data.lim::ring-polynomial-domain-product-nonzero)
(#alias ring-polynomial-equal = ./ring-polynomial-data.lim::ring-polynomial-equal)
(#alias ring-polynomial-multiply = ./ring-polynomial-data.lim::ring-polynomial-multiply)
(#alias ring-polynomial-structure = ./ring-polynomial-structure.lim::ring-polynomial-structure)
(#math-definition coordinate-norm-degree-polynomial-domain ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (coefficient-domain
        (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring)))
    (#pt-app
      (#pt-use ring-polynomial-domain-data ())
      (#pt-app (#pt-use finite-list ()) Carrier)
      (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (coefficient-domain
        (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring)))
    (#pt-construct
      ring-polynomial-domain-data
      ()
      (
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring))
      domain
      (
        (#pt-app
          (#pt-use ring-polynomial-degree-nonzero ())
          Carrier
          coefficient-ring
          (#pt-construct
            finite-list
            ()
            (Carrier)
            cons
            (
              (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
              (#pt-construct finite-list () (Carrier) nil ())))
          #pt-zero
          (#pt-app
            (#pt-use ring-polynomial-degree-one ())
            Carrier
            coefficient-ring
            coefficient-domain))
        (#pt-lambda
          (
            (polynomial (#pt-app (#pt-use finite-list ()) Carrier))
            (other-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
            (first-nonzero
              (#pt-pi
                (
                  (denied-evidence
                    (#pt-app
                      (#pt-use ring-polynomial-equal ())
                      Carrier
                      coefficient-ring
                      polynomial
                      (#pt-construct finite-list () (Carrier) nil ()))))
                #pt-false))
            (second-nonzero
              (#pt-pi
                (
                  (denied-evidence
                    (#pt-app
                      (#pt-use ring-polynomial-equal ())
                      Carrier
                      coefficient-ring
                      other-polynomial
                      (#pt-construct finite-list () (Carrier) nil ()))))
                #pt-false)))
          (#pt-lambda
            (
              (zero-polynomial-product
                (#pt-app
                  (#pt-use ring-polynomial-equal ())
                  Carrier
                  coefficient-ring
                  (#pt-app
                    (#pt-use ring-polynomial-multiply ())
                    Carrier
                    coefficient-ring
                    polynomial
                    other-polynomial)
                  (#pt-construct finite-list () (Carrier) nil ()))))
            (#pt-app
              (#pt-use coordinate-norm-degree-exhaustive-elimination ())
              Carrier
              coefficient-ring
              polynomial
              (#pt-lambda
                (
                  (zero-first-polynomial
                    (#pt-app
                      (#pt-use ring-polynomial-equal ())
                      Carrier
                      coefficient-ring
                      polynomial
                      (#pt-construct finite-list () (Carrier) nil ()))))
                (#pt-app first-nonzero zero-first-polynomial))
              (#pt-lambda
                (
                  (constant-degree #pt-nat)
                  (constant-certificate
                    (#pt-app
                      (#pt-use ring-polynomial-degree-witness ())
                      Carrier
                      coefficient-ring
                      polynomial
                      constant-degree)))
                (#pt-app
                  (#pt-use coordinate-norm-degree-exhaustive-elimination ())
                  Carrier
                  coefficient-ring
                  other-polynomial
                  (#pt-lambda
                    (
                      (zero-second-polynomial
                        (#pt-app
                          (#pt-use ring-polynomial-equal ())
                          Carrier
                          coefficient-ring
                          other-polynomial
                          (#pt-construct finite-list () (Carrier) nil ()))))
                    (#pt-app second-nonzero zero-second-polynomial))
                  (#pt-lambda
                    (
                      (linear-degree #pt-nat)
                      (linear-certificate
                        (#pt-app
                          (#pt-use ring-polynomial-degree-witness ())
                          Carrier
                          coefficient-ring
                          other-polynomial
                          linear-degree)))
                    (#pt-app
                      (#pt-app
                        (#pt-use ring-polynomial-degree-nonzero ())
                        Carrier
                        coefficient-ring
                        (#pt-app
                          (#pt-use ring-polynomial-multiply ())
                          Carrier
                          coefficient-ring
                          polynomial
                          other-polynomial)
                        (#pt-app (#pt-use add ()) constant-degree linear-degree)
                        (#pt-app
                          (#pt-use ring-polynomial-degree-product ())
                          Carrier
                          coefficient-ring
                          coefficient-domain
                          polynomial
                          other-polynomial
                          constant-degree
                          linear-degree
                          constant-certificate
                          linear-certificate))
                      zero-polynomial-product)))))))))))
(#theorem coordinate-norm-degree-polynomial-domain-product
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter first-nonzero (#pt-pi ((denied-evidence (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring polynomial (#pt-construct finite-list () (Carrier) nil ())))) #pt-false))
    (#parameter second-nonzero (#pt-pi ((denied-evidence (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring other-polynomial (#pt-construct finite-list () (Carrier) nil ())))) #pt-false)))
  (#statement
    (#pt-pi
      (
        (denied-evidence
          (#pt-app
            (#pt-use ring-polynomial-equal ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-multiply ())
              Carrier
              coefficient-ring
              polynomial
              other-polynomial)
            (#pt-construct finite-list () (Carrier) nil ()))))
      #pt-false))
  (#proof
    (#pt-app
      (#pt-use ring-polynomial-domain-product-nonzero ())
      (#pt-app (#pt-use finite-list ()) Carrier)
      (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
      (#pt-app
        (#pt-use coordinate-norm-degree-polynomial-domain ())
        Carrier
        coefficient-ring
        coefficient-domain)
      polynomial
      other-polynomial
      first-nonzero
      second-nonzero)))
