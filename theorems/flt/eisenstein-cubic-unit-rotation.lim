; Actual inverse witnesses preserve nondivisibility and Bezout coprimality
; under right-coordinate multiplication by a unit. Every witness remains
; in Prop. These are the unit steps in FLT/Three.lean:339-362.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
