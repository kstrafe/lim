(#alias
  eisenstein-unit-divisibility-reflect
  =
  ./eisenstein-additive-divisibility.lim::eisenstein-unit-divisibility-reflect)
(#theorem eisenstein-unit-product-not-divides
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter number (#pt-use eisenstein ()))
    (#parameter unit-proof (#pt-app (#pt-use eisenstein-unit ()) unit))
    (#parameter number-not-divides (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) divisor number))) #pt-false)))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use eisenstein-divides ())
            divisor
            (#pt-app (#pt-use eisenstein-multiply ()) unit number))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (product-divides
          (#pt-app
            (#pt-use eisenstein-divides ())
            divisor
            (#pt-app (#pt-use eisenstein-multiply ()) unit number))))
      (#pt-app
        number-not-divides
        (#pt-app
          (#pt-use eisenstein-unit-divisibility-reflect ())
          divisor
          unit
          number
          unit-proof
          product-divides)))))
(#theorem eisenstein-unit-coprime-right
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter other (#pt-use eisenstein ()))
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter unit-proof (#pt-app (#pt-use eisenstein-unit ()) unit))
    (#parameter coprime-proof (#pt-app (#pt-use eisenstein-coprime ()) number other)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-coprime ())
      number
      (#pt-app (#pt-use eisenstein-multiply ()) unit other)))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-left (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use exists (0))
            (#pt-use eisenstein ())
            (#pt-lambda
              ((candidate-right (#pt-use eisenstein ())))
              (#pt-app
                (#pt-use eisenstein-equal ())
                (#pt-use eisenstein-one ())
                (#pt-app
                  (#pt-use eisenstein-add ())
                  (#pt-app (#pt-use eisenstein-multiply ()) candidate-left number)
                  (#pt-app (#pt-use eisenstein-multiply ()) candidate-right other)))))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-left (#pt-use eisenstein ())))
