                        (#pt-app (#pt-use eisenstein-multiply ()) candidate-left number)
                        (#pt-app (#pt-use eisenstein-multiply ()) candidate-right other)))))))))
        (#pt-app
          (#pt-use eisenstein-coprime ())
          number
          (#pt-app (#pt-use eisenstein-multiply ()) unit other)))
      (
        (#pt-lambda
          (
            (left-coefficient (#pt-use eisenstein ()))
            (right-certificate
              (#pt-app
                (#pt-use exists (0))
                (#pt-use eisenstein ())
                (#pt-lambda
                  ((candidate-right (#pt-use eisenstein ())))
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-use eisenstein-one ())
                    (#pt-app
                      (#pt-use eisenstein-add ())
                      (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient number)
                      (#pt-app (#pt-use eisenstein-multiply ()) candidate-right other)))))))
          (#pt-induct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-right (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-use eisenstein-one ())
                  (#pt-app
                    (#pt-use eisenstein-add ())
                    (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient number)
                    (#pt-app (#pt-use eisenstein-multiply ()) candidate-right other)))))
            (#pt-lambda
              (
                (eisenstein-certificate
                  (#pt-app
                    (#pt-use exists (0))
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-right (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use eisenstein-equal ())
                        (#pt-use eisenstein-one ())
                        (#pt-app
                          (#pt-use eisenstein-add ())
                          (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient number)
                          (#pt-app (#pt-use eisenstein-multiply ()) candidate-right other)))))))
              (#pt-app
                (#pt-use eisenstein-coprime ())
                number
                (#pt-app (#pt-use eisenstein-multiply ()) unit other)))
            (
              (#pt-lambda
                (
                  (right-coefficient (#pt-use eisenstein ()))
                  (bezout-equation
                    (#pt-app
                      (#pt-use eisenstein-equal ())
                      (#pt-use eisenstein-one ())
                      (#pt-app
                        (#pt-use eisenstein-add ())
                        (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient number)
                        (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient other)))))
                (#pt-induct
                  exists
                  (0)
                  (
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-inverse (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-app
                          (#pt-use eisenstein-equal ())
                          (#pt-app (#pt-use eisenstein-multiply ()) unit candidate-inverse)
                          (#pt-use eisenstein-one ()))
                        (#pt-app
                          (#pt-use eisenstein-equal ())
                          (#pt-app (#pt-use eisenstein-multiply ()) candidate-inverse unit)
                          (#pt-use eisenstein-one ())))))
                  (#pt-lambda
                    (
                      (eisenstein-certificate
                        (#pt-app
                          (#pt-use exists (0))
                          (#pt-use eisenstein ())
                          (#pt-lambda
                            ((candidate-inverse (#pt-use eisenstein ())))
                            (#pt-app
                              (#pt-use conjunction ())
                              (#pt-app
                                (#pt-use eisenstein-equal ())
                                (#pt-app (#pt-use eisenstein-multiply ()) unit candidate-inverse)
                                (#pt-use eisenstein-one ()))
                              (#pt-app
                                (#pt-use eisenstein-equal ())
                                (#pt-app (#pt-use eisenstein-multiply ()) candidate-inverse unit)
                                (#pt-use eisenstein-one ())))))))
                    (#pt-app
                      (#pt-use eisenstein-coprime ())
                      number
                      (#pt-app (#pt-use eisenstein-multiply ()) unit other)))
                  (
                    (#pt-lambda
                      (
                        (inverse (#pt-use eisenstein ()))
                        (inverse-equations
                          (#pt-app
                            (#pt-use conjunction ())
                            (#pt-app
                              (#pt-use eisenstein-equal ())
                              (#pt-app (#pt-use eisenstein-multiply ()) unit inverse)
                              (#pt-use eisenstein-one ()))
                            (#pt-app
                              (#pt-use eisenstein-equal ())
                              (#pt-app (#pt-use eisenstein-multiply ()) inverse unit)
                              (#pt-use eisenstein-one ())))))
                      (#pt-construct
                        exists
                        (0)
                        (
                          (#pt-use eisenstein ())
                          (#pt-lambda
                            ((candidate-left (#pt-use eisenstein ())))
                            (#pt-app
                              (#pt-use exists (0))
                              (#pt-use eisenstein ())
                              (#pt-lambda
                                ((candidate-right (#pt-use eisenstein ())))
                                (#pt-app
                                  (#pt-use eisenstein-equal ())
                                  (#pt-use eisenstein-one ())
                                  (#pt-app
                                    (#pt-use eisenstein-add ())
                                    (#pt-app (#pt-use eisenstein-multiply ()) candidate-left number)
                                    (#pt-app
                                      (#pt-use eisenstein-multiply ())
                                      candidate-right
                                      (#pt-app (#pt-use eisenstein-multiply ()) unit other))))))))
                        introduce
                        (left-coefficient
                          (#pt-construct
                            exists
                            (0)
                            (
                              (#pt-use eisenstein ())
                              (#pt-lambda
                                ((candidate-right (#pt-use eisenstein ())))
                                (#pt-app
                                  (#pt-use eisenstein-equal ())
                                  (#pt-use eisenstein-one ())
                                  (#pt-app
                                    (#pt-use eisenstein-add ())
                                    (#pt-app
                                      (#pt-use eisenstein-multiply ())
                                      left-coefficient
                                      number)
                                    (#pt-app
                                      (#pt-use eisenstein-multiply ())
                                      candidate-right
                                      (#pt-app (#pt-use eisenstein-multiply ()) unit other))))))
                            introduce
                            (
                              (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient inverse)
                              (#pt-app
                                (#pt-use eisenstein-transitive ())
                                (#pt-use eisenstein-one ())
                                (#pt-app
                                  (#pt-use eisenstein-add ())
                                  (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient number)
                                  (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient other))
                                (#pt-app
                                  (#pt-use eisenstein-add ())
                                  (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient number)
                                  (#pt-app
                                    (#pt-use eisenstein-multiply ())
                                    (#pt-app
                                      (#pt-use eisenstein-multiply ())
                                      right-coefficient
                                      inverse)
                                    (#pt-app (#pt-use eisenstein-multiply ()) unit other)))
                                bezout-equation
                                (#pt-app
                                  (#pt-use eisenstein-symmetric ())
                                  (#pt-app
                                    (#pt-use eisenstein-add ())
                                    (#pt-app
                                      (#pt-use eisenstein-multiply ())
                                      left-coefficient
                                      number)
                                    (#pt-app
                                      (#pt-use eisenstein-multiply ())
                                      (#pt-app
                                        (#pt-use eisenstein-multiply ())
                                        right-coefficient
                                        inverse)
                                      (#pt-app (#pt-use eisenstein-multiply ()) unit other)))
                                  (#pt-app
                                    (#pt-use eisenstein-add ())
                                    (#pt-app
                                      (#pt-use eisenstein-multiply ())
                                      left-coefficient
                                      number)
                                    (#pt-app
                                      (#pt-use eisenstein-multiply ())
                                      right-coefficient
                                      other))
                                  (#pt-app
                                    (#pt-use eisenstein-add-congruent ())
                                    (#pt-app
                                      (#pt-use eisenstein-multiply ())
                                      left-coefficient
                                      number)
                                    (#pt-app
                                      (#pt-use eisenstein-multiply ())
                                      (#pt-app
                                        (#pt-use eisenstein-multiply ())
                                        right-coefficient
                                        inverse)
                                      (#pt-app (#pt-use eisenstein-multiply ()) unit other))
                                    (#pt-app
                                      (#pt-use eisenstein-multiply ())
                                      left-coefficient
                                      number)
                                    (#pt-app
                                      (#pt-use eisenstein-multiply ())
                                      right-coefficient
                                      other)
                                    (#pt-app
                                      (#pt-use eisenstein-reflexive ())
                                      (#pt-app
                                        (#pt-use eisenstein-multiply ())
                                        left-coefficient
                                        number))
                                    (#pt-app
                                      (#pt-use eisenstein-transitive ())
                                      (#pt-app
                                        (#pt-use eisenstein-multiply ())
                                        (#pt-app
                                          (#pt-use eisenstein-multiply ())
                                          right-coefficient
                                          inverse)
                                        (#pt-app (#pt-use eisenstein-multiply ()) unit other))
                                      (#pt-app
                                        (#pt-use eisenstein-multiply ())
                                        right-coefficient
                                        (#pt-app
                                          (#pt-use eisenstein-multiply ())
                                          inverse
                                          (#pt-app (#pt-use eisenstein-multiply ()) unit other)))
                                      (#pt-app
                                        (#pt-use eisenstein-multiply ())
                                        right-coefficient
                                        other)
                                      (#pt-app
                                        (#pt-use eisenstein-multiply-associative ())
                                        right-coefficient
                                        inverse
                                        (#pt-app (#pt-use eisenstein-multiply ()) unit other))
                                      (#pt-app
                                        (#pt-use eisenstein-multiply-congruent ())
                                        right-coefficient
                                        (#pt-app
                                          (#pt-use eisenstein-multiply ())
                                          inverse
                                          (#pt-app (#pt-use eisenstein-multiply ()) unit other))
                                        right-coefficient
                                        other
                                        (#pt-app
                                          (#pt-use eisenstein-reflexive ())
                                          right-coefficient)
                                        (#pt-app
                                          (#pt-use eisenstein-transitive ())
                                          (#pt-app
                                            (#pt-use eisenstein-multiply ())
                                            inverse
                                            (#pt-app (#pt-use eisenstein-multiply ()) unit other))
                                          (#pt-app
                                            (#pt-use eisenstein-multiply ())
                                            (#pt-app (#pt-use eisenstein-multiply ()) inverse unit)
                                            other)
                                          other
                                          (#pt-app
                                            (#pt-use eisenstein-symmetric ())
                                            (#pt-app
                                              (#pt-use eisenstein-multiply ())
                                              (#pt-app
                                                (#pt-use eisenstein-multiply ())
                                                inverse
                                                unit)
                                              other)
                                            (#pt-app
                                              (#pt-use eisenstein-multiply ())
                                              inverse
                                              (#pt-app (#pt-use eisenstein-multiply ()) unit other))
                                            (#pt-app
                                              (#pt-use eisenstein-multiply-associative ())
                                              inverse
                                              unit
                                              other))
                                          (#pt-app
                                            (#pt-use eisenstein-transitive ())
                                            (#pt-app
                                              (#pt-use eisenstein-multiply ())
                                              (#pt-app
                                                (#pt-use eisenstein-multiply ())
                                                inverse
                                                unit)
                                              other)
                                            (#pt-app
                                              (#pt-use eisenstein-multiply ())
                                              (#pt-use eisenstein-one ())
                                              other)
                                            other
                                            (#pt-app
                                              (#pt-use eisenstein-multiply-congruent ())
                                              (#pt-app
                                                (#pt-use eisenstein-multiply ())
                                                inverse
                                                unit)
                                              other
                                              (#pt-use eisenstein-one ())
                                              other
                                              (#pt-app
