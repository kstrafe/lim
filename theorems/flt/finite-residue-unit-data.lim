; Mathematical source: pinned Mathlib Data/ZMod/Basic.lean.
; Generated by scripts/generate-flt-modular-inverses.py; checked native proof terms.
; A unit contains an actual inverse and its checked product
; certificate. Coprime inputs construct this data computationally;
; any two valid unit records have the same inverse value.
(#alias less-than = ./natural-order.lim::less-than)
(#alias coprime = ./natural-coprime.lim::coprime)
(#alias finite-residue = ./finite-residue-defs.lim::finite-residue)
(#alias finite-residue-one = ./finite-residue-semiring.lim::finite-residue-one)
(#alias finite-residue-multiply = ./finite-residue-operations.lim::finite-residue-multiply)
(#alias finite-residue-inverse = ./finite-residue-inverses.lim::finite-residue-inverse)
(#alias
  finite-residue-inverse-coprime-product
  =
  ./finite-residue-inverse-units.lim::finite-residue-inverse-coprime-product)
(#alias
  finite-residue-multiplicative-inverse-unique
  =
  ./finite-residue-inverse-units.lim::finite-residue-multiplicative-inverse-unique)
(#math-inductive finite-residue-unit-data ()
  (
    (modulus #pt-nat)
    (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (element (#pt-app (#pt-use finite-residue ()) modulus)))
  (#pt-type 0)
  (
    (invertible
      (
        (inverse (#pt-app (#pt-use finite-residue ()) modulus))
        (product-certificate
          (#pt-eq
            #pt-nat
            (#pt-project
              finite-residue
              0
              (#pt-app
                (#pt-use finite-residue-multiply ())
                modulus
                positive-modulus
                element
                inverse))
            (#pt-project
              finite-residue
              0
              (#pt-app (#pt-use finite-residue-one ()) modulus positive-modulus))))))))
(#math-definition computed-finite-residue-unit ()
  (#pt-pi
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (element (#pt-app (#pt-use finite-residue ()) modulus))
      (coprime-proof (#pt-app (#pt-use coprime ()) (#pt-project finite-residue 0 element) modulus)))
    (#pt-app (#pt-use finite-residue-unit-data ()) modulus positive-modulus element))
  (#pt-lambda
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (element (#pt-app (#pt-use finite-residue ()) modulus))
      (coprime-proof (#pt-app (#pt-use coprime ()) (#pt-project finite-residue 0 element) modulus)))
    (#pt-construct
      finite-residue-unit-data
      ()
      (modulus positive-modulus element)
      invertible
      (
        (#pt-app (#pt-use finite-residue-inverse ()) modulus positive-modulus element)
        (#pt-app
          (#pt-use finite-residue-inverse-coprime-product ())
          modulus
          positive-modulus
          element
          coprime-proof)))))
(#theorem finite-residue-unit-product
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter element (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter unit-data (#pt-app (#pt-use finite-residue-unit-data ()) modulus positive-modulus element)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-residue-multiply ())
          modulus
          positive-modulus
          element
          (#pt-project finite-residue-unit-data 0 unit-data)))
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-one ()) modulus positive-modulus))))
  (#proof (#pt-project finite-residue-unit-data 1 unit-data)))
(#theorem finite-residue-unit-inverse-unique
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter element (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter first-unit (#pt-app (#pt-use finite-residue-unit-data ()) modulus positive-modulus element))
    (#parameter second-unit (#pt-app (#pt-use finite-residue-unit-data ()) modulus positive-modulus element)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project finite-residue 0 (#pt-project finite-residue-unit-data 0 first-unit))
      (#pt-project finite-residue 0 (#pt-project finite-residue-unit-data 0 second-unit))))
  (#proof
    (#pt-app
      (#pt-use finite-residue-multiplicative-inverse-unique ())
      modulus
      positive-modulus
      element
      (#pt-project finite-residue-unit-data 0 first-unit)
      (#pt-project finite-residue-unit-data 0 second-unit)
      (#pt-project finite-residue-unit-data 1 first-unit)
      (#pt-project finite-residue-unit-data 1 second-unit))))
