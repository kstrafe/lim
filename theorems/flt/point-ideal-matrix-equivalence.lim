; Adapted mathematical source: pinned Mathlib LinearAlgebra/FreeModule/Norm.lean
; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean.
; Generated by scripts/generate-flt-point-ideal-basis.py; checked native terms.
; Explicit entrywise matrix symmetry and
; transitivity, using the existing actual four-entry matrix relation.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-matrix2 = ./ring-matrix2-data.lim::ring-matrix2)
(#alias ring-matrix2-equal = ./ring-matrix2-data.lim::ring-matrix2-equal)
(#alias ring-symmetric = ./commutative-ring-data.lim::ring-symmetric)
(#alias ring-transitive = ./commutative-ring-data.lim::ring-transitive)
(#theorem point-ideal-matrix-symmetric
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-matrix (#pt-app (#pt-use ring-matrix2 ()) Carrier))
    (#parameter second-matrix (#pt-app (#pt-use ring-matrix2 ()) Carrier))
    (#parameter matrix-equation (#pt-app (#pt-use ring-matrix2-equal ()) Carrier coefficient-ring first-matrix second-matrix)))
  (#statement
    (#pt-app (#pt-use ring-matrix2-equal ()) Carrier coefficient-ring second-matrix first-matrix))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-equal ())
        Carrier
        coefficient-ring
        (#pt-project ring-matrix2 0 second-matrix)
        (#pt-project ring-matrix2 0 first-matrix))
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app
          (#pt-use ring-equal ())
          Carrier
          coefficient-ring
          (#pt-project ring-matrix2 1 second-matrix)
          (#pt-project ring-matrix2 1 first-matrix))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-project ring-matrix2 2 second-matrix)
            (#pt-project ring-matrix2 2 first-matrix))
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-project ring-matrix2 3 second-matrix)
            (#pt-project ring-matrix2 3 first-matrix))))
      (#pt-app
        (#pt-use ring-symmetric ())
        Carrier
        coefficient-ring
        (#pt-project ring-matrix2 0 first-matrix)
        (#pt-project ring-matrix2 0 second-matrix)
        (#pt-project conjunction 0 matrix-equation))
      (#pt-app
        (#pt-use conjunction-introduce ())
        (#pt-app
          (#pt-use ring-equal ())
          Carrier
          coefficient-ring
          (#pt-project ring-matrix2 1 second-matrix)
          (#pt-project ring-matrix2 1 first-matrix))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-project ring-matrix2 2 second-matrix)
            (#pt-project ring-matrix2 2 first-matrix))
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-project ring-matrix2 3 second-matrix)
            (#pt-project ring-matrix2 3 first-matrix)))
        (#pt-app
          (#pt-use ring-symmetric ())
          Carrier
          coefficient-ring
          (#pt-project ring-matrix2 1 first-matrix)
          (#pt-project ring-matrix2 1 second-matrix)
          (#pt-project conjunction 0 (#pt-project conjunction 1 matrix-equation)))
        (#pt-app
          (#pt-use conjunction-introduce ())
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-project ring-matrix2 2 second-matrix)
            (#pt-project ring-matrix2 2 first-matrix))
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-project ring-matrix2 3 second-matrix)
            (#pt-project ring-matrix2 3 first-matrix))
          (#pt-app
            (#pt-use ring-symmetric ())
            Carrier
            coefficient-ring
            (#pt-project ring-matrix2 2 first-matrix)
            (#pt-project ring-matrix2 2 second-matrix)
            (#pt-project
              conjunction
              0
              (#pt-project conjunction 1 (#pt-project conjunction 1 matrix-equation))))
          (#pt-app
            (#pt-use ring-symmetric ())
            Carrier
            coefficient-ring
            (#pt-project ring-matrix2 3 first-matrix)
            (#pt-project ring-matrix2 3 second-matrix)
            (#pt-project
              conjunction
              1
              (#pt-project conjunction 1 (#pt-project conjunction 1 matrix-equation)))))))))
(#theorem point-ideal-matrix-transitive
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-matrix (#pt-app (#pt-use ring-matrix2 ()) Carrier))
    (#parameter second-matrix (#pt-app (#pt-use ring-matrix2 ()) Carrier))
    (#parameter third-matrix (#pt-app (#pt-use ring-matrix2 ()) Carrier))
    (#parameter first-equation (#pt-app (#pt-use ring-matrix2-equal ()) Carrier coefficient-ring first-matrix second-matrix))
    (#parameter second-equation (#pt-app (#pt-use ring-matrix2-equal ()) Carrier coefficient-ring second-matrix third-matrix)))
  (#statement
    (#pt-app (#pt-use ring-matrix2-equal ()) Carrier coefficient-ring first-matrix third-matrix))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-equal ())
        Carrier
        coefficient-ring
        (#pt-project ring-matrix2 0 first-matrix)
        (#pt-project ring-matrix2 0 third-matrix))
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app
          (#pt-use ring-equal ())
          Carrier
          coefficient-ring
          (#pt-project ring-matrix2 1 first-matrix)
          (#pt-project ring-matrix2 1 third-matrix))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-project ring-matrix2 2 first-matrix)
            (#pt-project ring-matrix2 2 third-matrix))
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-project ring-matrix2 3 first-matrix)
            (#pt-project ring-matrix2 3 third-matrix))))
      (#pt-app
        (#pt-use ring-transitive ())
        Carrier
        coefficient-ring
        (#pt-project ring-matrix2 0 first-matrix)
        (#pt-project ring-matrix2 0 second-matrix)
        (#pt-project ring-matrix2 0 third-matrix)
        (#pt-project conjunction 0 first-equation)
        (#pt-project conjunction 0 second-equation))
      (#pt-app
        (#pt-use conjunction-introduce ())
        (#pt-app
          (#pt-use ring-equal ())
          Carrier
          coefficient-ring
          (#pt-project ring-matrix2 1 first-matrix)
          (#pt-project ring-matrix2 1 third-matrix))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-project ring-matrix2 2 first-matrix)
            (#pt-project ring-matrix2 2 third-matrix))
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-project ring-matrix2 3 first-matrix)
            (#pt-project ring-matrix2 3 third-matrix)))
        (#pt-app
          (#pt-use ring-transitive ())
          Carrier
          coefficient-ring
          (#pt-project ring-matrix2 1 first-matrix)
          (#pt-project ring-matrix2 1 second-matrix)
          (#pt-project ring-matrix2 1 third-matrix)
          (#pt-project conjunction 0 (#pt-project conjunction 1 first-equation))
          (#pt-project conjunction 0 (#pt-project conjunction 1 second-equation)))
        (#pt-app
          (#pt-use conjunction-introduce ())
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-project ring-matrix2 2 first-matrix)
            (#pt-project ring-matrix2 2 third-matrix))
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-project ring-matrix2 3 first-matrix)
            (#pt-project ring-matrix2 3 third-matrix))
          (#pt-app
            (#pt-use ring-transitive ())
            Carrier
            coefficient-ring
            (#pt-project ring-matrix2 2 first-matrix)
            (#pt-project ring-matrix2 2 second-matrix)
            (#pt-project ring-matrix2 2 third-matrix)
            (#pt-project
              conjunction
              0
              (#pt-project conjunction 1 (#pt-project conjunction 1 first-equation)))
            (#pt-project
              conjunction
              0
              (#pt-project conjunction 1 (#pt-project conjunction 1 second-equation))))
          (#pt-app
            (#pt-use ring-transitive ())
            Carrier
            coefficient-ring
            (#pt-project ring-matrix2 3 first-matrix)
            (#pt-project ring-matrix2 3 second-matrix)
            (#pt-project ring-matrix2 3 third-matrix)
            (#pt-project
              conjunction
              1
              (#pt-project conjunction 1 (#pt-project conjunction 1 first-equation)))
            (#pt-project
              conjunction
              1
              (#pt-project conjunction 1 (#pt-project conjunction 1 second-equation)))))))))
