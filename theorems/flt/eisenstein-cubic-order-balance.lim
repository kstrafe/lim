(#theorem eisenstein-cubic-primary-nonzero-from-third-order
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter third (#pt-use eisenstein ()))
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter third-order #pt-nat)
    (#parameter unit-proof (#pt-app (#pt-use eisenstein-unit ()) unit))
    (#parameter third-order-certificate (#pt-app (#pt-use eisenstein-lambda-order ()) third third-order))
    (#parameter solution-equation (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-add ()) (#pt-app (#pt-use eisenstein-power ()) first (#pt-numeral 3)) (#pt-app (#pt-use eisenstein-power ()) second (#pt-numeral 3))) (#pt-app (#pt-use eisenstein-multiply ()) unit (#pt-app (#pt-use eisenstein-power ()) third (#pt-numeral 3))))))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app (#pt-use eisenstein-add ()) first second)
            (#pt-use eisenstein-zero ()))))
      #pt-false))
  (#proof
    (#pt-app
      (#pt-use eisenstein-divisor-nonzero ())
      (#pt-app (#pt-use eisenstein-add ()) first second)
      (#pt-app
        (#pt-use eisenstein-multiply ())
        unit
        (#pt-app (#pt-use eisenstein-power ()) third (#pt-numeral 3)))
      (#pt-app
        (#pt-use eisenstein-lambda-order-nonzero ())
        (#pt-app
          (#pt-use eisenstein-multiply ())
          unit
          (#pt-app (#pt-use eisenstein-power ()) third (#pt-numeral 3)))
        (#pt-app (#pt-use multiply ()) (#pt-numeral 3) third-order)
        (#pt-app
          (#pt-use eisenstein-lambda-order-unit-multiply ())
          unit
          (#pt-app (#pt-use eisenstein-power ()) third (#pt-numeral 3))
          (#pt-app (#pt-use multiply ()) (#pt-numeral 3) third-order)
          unit-proof
          (#pt-app
            (#pt-use eisenstein-lambda-order-power ())
            third
            third-order
            (#pt-numeral 3)
            third-order-certificate)))
      (#pt-app
        (#pt-use eisenstein-divides-congruent-target ())
        (#pt-app (#pt-use eisenstein-add ()) first second)
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-add ()) first second)
            (#pt-app
              (#pt-use eisenstein-add ())
              first
              (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-omega ()) second)))
          (#pt-app
            (#pt-use eisenstein-add ())
            first
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-omega ()) (#pt-numeral 2))
              second)))
        (#pt-app
          (#pt-use eisenstein-multiply ())
          unit
          (#pt-app (#pt-use eisenstein-power ()) third (#pt-numeral 3)))
        (#pt-app
          (#pt-use eisenstein-transitive ())
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-add ()) first second)
              (#pt-app
                (#pt-use eisenstein-add ())
                first
                (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-omega ()) second)))
            (#pt-app
              (#pt-use eisenstein-add ())
              first
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-use eisenstein-omega ())
                  (#pt-numeral 2))
                second)))
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-power ()) first (#pt-numeral 3))
            (#pt-app (#pt-use eisenstein-power ()) second (#pt-numeral 3)))
          (#pt-app
            (#pt-use eisenstein-multiply ())
            unit
            (#pt-app (#pt-use eisenstein-power ()) third (#pt-numeral 3)))
          (#pt-app
            (#pt-use eisenstein-symmetric ())
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-power ()) first (#pt-numeral 3))
              (#pt-app (#pt-use eisenstein-power ()) second (#pt-numeral 3)))
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app (#pt-use eisenstein-add ()) first second)
                (#pt-app
                  (#pt-use eisenstein-add ())
                  first
                  (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-omega ()) second)))
              (#pt-app
                (#pt-use eisenstein-add ())
                first
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app
                    (#pt-use eisenstein-power ())
                    (#pt-use eisenstein-omega ())
                    (#pt-numeral 2))
                  second)))
            (#pt-app (#pt-use eisenstein-sum-cubes-factor ()) first second))
          solution-equation)
        (#pt-app
          (#pt-use eisenstein-divides-product-left ())
          (#pt-app (#pt-use eisenstein-add ()) first second)
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-add ()) first second)
            (#pt-app
              (#pt-use eisenstein-add ())
              first
              (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-omega ()) second)))
          (#pt-app
            (#pt-use eisenstein-add ())
            first
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-omega ()) (#pt-numeral 2))
              second))
          (#pt-app
            (#pt-use eisenstein-divides-product-left ())
            (#pt-app (#pt-use eisenstein-add ()) first second)
            (#pt-app (#pt-use eisenstein-add ()) first second)
            (#pt-app
              (#pt-use eisenstein-add ())
              first
              (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-omega ()) second))
            (#pt-app
              (#pt-use eisenstein-divides-reflexive ())
              (#pt-app (#pt-use eisenstein-add ()) first second))))))))
(#theorem eisenstein-cubic-orders-balance
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter third (#pt-use eisenstein ()))
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter third-order #pt-nat)
    (#parameter unit-proof (#pt-app (#pt-use eisenstein-unit ()) unit))
    (#parameter third-order-certificate (#pt-app (#pt-use eisenstein-lambda-order ()) third third-order))
    (#parameter solution-equation (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-add ()) (#pt-app (#pt-use eisenstein-power ()) first (#pt-numeral 3)) (#pt-app (#pt-use eisenstein-power ()) second (#pt-numeral 3))) (#pt-app (#pt-use eisenstein-multiply ()) unit (#pt-app (#pt-use eisenstein-power ()) third (#pt-numeral 3)))))
    (#parameter second-not-divides (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) second))) #pt-false))
    (#parameter primary-square-divides (#pt-app (#pt-use eisenstein-divides ()) (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2)) (#pt-app (#pt-use eisenstein-add ()) first second)))
    (#parameter primary-order #pt-nat)
    (#parameter primary-order-certificate (#pt-app (#pt-use eisenstein-lambda-order ()) (#pt-app (#pt-use eisenstein-add ()) first second) primary-order)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use add ()) primary-order (#pt-succ #pt-zero))
        (#pt-succ #pt-zero))
      (#pt-app (#pt-use multiply ()) (#pt-numeral 3) third-order)))
  (#proof
    (#pt-app
      (#pt-use eisenstein-lambda-order-unique ())
      (#pt-app
        (#pt-use eisenstein-multiply ())
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app (#pt-use eisenstein-add ()) first second)
          (#pt-app
            (#pt-use eisenstein-add ())
            first
            (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-omega ()) second)))
        (#pt-app
          (#pt-use eisenstein-add ())
          first
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-omega ()) (#pt-numeral 2))
            second)))
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use add ()) primary-order (#pt-succ #pt-zero))
        (#pt-succ #pt-zero))
      (#pt-app (#pt-use multiply ()) (#pt-numeral 3) third-order)
      (#pt-app
        (#pt-use eisenstein-lambda-order-multiply ())
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app (#pt-use eisenstein-add ()) first second)
          (#pt-app
            (#pt-use eisenstein-add ())
            first
            (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-omega ()) second)))
        (#pt-app
          (#pt-use eisenstein-add ())
          first
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-omega ()) (#pt-numeral 2))
            second))
        (#pt-app (#pt-use add ()) primary-order (#pt-succ #pt-zero))
        (#pt-succ #pt-zero)
        (#pt-app
          (#pt-use eisenstein-lambda-order-multiply ())
          (#pt-app (#pt-use eisenstein-add ()) first second)
          (#pt-app
            (#pt-use eisenstein-add ())
            first
            (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-omega ()) second))
          primary-order
          (#pt-succ #pt-zero)
          primary-order-certificate
          (#pt-app
            (#pt-use eisenstein-cubic-omega-factor-order-one ())
            first
            second
            second-not-divides
            primary-square-divides))
        (#pt-app
          (#pt-use eisenstein-cubic-omega-square-factor-order-one ())
          first
          second
          second-not-divides
          primary-square-divides))
      (#pt-app
        (#pt-use eisenstein-lambda-order-congruent ())
        (#pt-app
          (#pt-use eisenstein-multiply ())
          unit
          (#pt-app (#pt-use eisenstein-power ()) third (#pt-numeral 3)))
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-add ()) first second)
            (#pt-app
              (#pt-use eisenstein-add ())
              first
              (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-omega ()) second)))
          (#pt-app
            (#pt-use eisenstein-add ())
            first
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-omega ()) (#pt-numeral 2))
              second)))
        (#pt-app (#pt-use multiply ()) (#pt-numeral 3) third-order)
        (#pt-app
          (#pt-use eisenstein-symmetric ())
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-add ()) first second)
              (#pt-app
                (#pt-use eisenstein-add ())
                first
                (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-omega ()) second)))
            (#pt-app
              (#pt-use eisenstein-add ())
              first
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-use eisenstein-omega ())
                  (#pt-numeral 2))
                second)))
          (#pt-app
            (#pt-use eisenstein-multiply ())
            unit
            (#pt-app (#pt-use eisenstein-power ()) third (#pt-numeral 3)))
          (#pt-app
            (#pt-use eisenstein-transitive ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app (#pt-use eisenstein-add ()) first second)
                (#pt-app
                  (#pt-use eisenstein-add ())
                  first
                  (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-omega ()) second)))
              (#pt-app
                (#pt-use eisenstein-add ())
                first
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app
                    (#pt-use eisenstein-power ())
                    (#pt-use eisenstein-omega ())
                    (#pt-numeral 2))
                  second)))
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-power ()) first (#pt-numeral 3))
              (#pt-app (#pt-use eisenstein-power ()) second (#pt-numeral 3)))
            (#pt-app
              (#pt-use eisenstein-multiply ())
              unit
              (#pt-app (#pt-use eisenstein-power ()) third (#pt-numeral 3)))
            (#pt-app
              (#pt-use eisenstein-symmetric ())
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-app (#pt-use eisenstein-power ()) first (#pt-numeral 3))
                (#pt-app (#pt-use eisenstein-power ()) second (#pt-numeral 3)))
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app (#pt-use eisenstein-add ()) first second)
                  (#pt-app
                    (#pt-use eisenstein-add ())
                    first
                    (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-omega ()) second)))
                (#pt-app
                  (#pt-use eisenstein-add ())
                  first
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app
                      (#pt-use eisenstein-power ())
                      (#pt-use eisenstein-omega ())
                      (#pt-numeral 2))
                    second)))
              (#pt-app (#pt-use eisenstein-sum-cubes-factor ()) first second))
            solution-equation))
        (#pt-app
          (#pt-use eisenstein-lambda-order-unit-multiply ())
          unit
          (#pt-app (#pt-use eisenstein-power ()) third (#pt-numeral 3))
          (#pt-app (#pt-use multiply ()) (#pt-numeral 3) third-order)
          unit-proof
          (#pt-app
            (#pt-use eisenstein-lambda-order-power ())
            third
            third-order
            (#pt-numeral 3)
            third-order-certificate))))))
(#theorem eisenstein-cubic-primary-order-exists
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter third (#pt-use eisenstein ()))
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter third-order #pt-nat)
    (#parameter unit-proof (#pt-app (#pt-use eisenstein-unit ()) unit))
    (#parameter third-order-certificate (#pt-app (#pt-use eisenstein-lambda-order ()) third third-order))
    (#parameter solution-equation (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-add ()) (#pt-app (#pt-use eisenstein-power ()) first (#pt-numeral 3)) (#pt-app (#pt-use eisenstein-power ()) second (#pt-numeral 3))) (#pt-app (#pt-use eisenstein-multiply ()) unit (#pt-app (#pt-use eisenstein-power ()) third (#pt-numeral 3)))))
    (#parameter second-not-divides (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) second))) #pt-false))
    (#parameter primary-square-divides (#pt-app (#pt-use eisenstein-divides ()) (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2)) (#pt-app (#pt-use eisenstein-add ()) first second))))
  (#statement
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-order #pt-nat))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app
            (#pt-use eisenstein-lambda-order ())
            (#pt-app (#pt-use eisenstein-add ()) first second)
            candidate-order)
          (#pt-eq
            #pt-nat
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use add ()) candidate-order (#pt-succ #pt-zero))
              (#pt-succ #pt-zero))
            (#pt-app (#pt-use multiply ()) (#pt-numeral 3) third-order))))))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-order #pt-nat))
          (#pt-app
            (#pt-use eisenstein-lambda-order ())
            (#pt-app (#pt-use eisenstein-add ()) first second)
            candidate-order)))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-order #pt-nat))
                (#pt-app
                  (#pt-use eisenstein-lambda-order ())
                  (#pt-app (#pt-use eisenstein-add ()) first second)
                  candidate-order)))))
        (#pt-app
          (#pt-use exists (0))
          #pt-nat
          (#pt-lambda
            ((candidate-order #pt-nat))
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app
                (#pt-use eisenstein-lambda-order ())
                (#pt-app (#pt-use eisenstein-add ()) first second)
                candidate-order)
              (#pt-eq
                #pt-nat
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use add ()) candidate-order (#pt-succ #pt-zero))
                  (#pt-succ #pt-zero))
                (#pt-app (#pt-use multiply ()) (#pt-numeral 3) third-order))))))
      (
        (#pt-lambda
          (
            (primary-order #pt-nat)
            (primary-order-certificate
              (#pt-app
                (#pt-use eisenstein-lambda-order ())
                (#pt-app (#pt-use eisenstein-add ()) first second)
                primary-order)))
          (#pt-construct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-order #pt-nat))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use eisenstein-lambda-order ())
                    (#pt-app (#pt-use eisenstein-add ()) first second)
                    candidate-order)
                  (#pt-eq
                    #pt-nat
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use add ()) candidate-order (#pt-succ #pt-zero))
                      (#pt-succ #pt-zero))
                    (#pt-app (#pt-use multiply ()) (#pt-numeral 3) third-order)))))
            introduce
            (primary-order
              (#pt-app
                (#pt-use conjunction-introduce ())
                (#pt-app
                  (#pt-use eisenstein-lambda-order ())
                  (#pt-app (#pt-use eisenstein-add ()) first second)
                  primary-order)
                (#pt-eq
                  #pt-nat
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use add ()) primary-order (#pt-succ #pt-zero))
                    (#pt-succ #pt-zero))
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 3) third-order))
                primary-order-certificate
                (#pt-app
                  (#pt-use eisenstein-cubic-orders-balance ())
                  first
                  second
                  third
                  unit
                  third-order
                  unit-proof
                  third-order-certificate
                  solution-equation
                  second-not-divides
                  primary-square-divides
                  primary-order
                  primary-order-certificate))))))
      (#pt-app
        (#pt-use eisenstein-lambda-order-exists ())
        (#pt-app (#pt-use eisenstein-add ()) first second)
        (#pt-app
          (#pt-use eisenstein-cubic-primary-nonzero-from-third-order ())
          first
          second
          third
          unit
          third-order
          unit-proof
          third-order-certificate
          solution-equation)))))
