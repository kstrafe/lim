                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-eq #pt-nat (#pt-succ previous-first-quotient) step-second-index)
                  (#pt-eq #pt-nat step-first-remainder step-second-remainder))))
            (#pt-lambda
              (
                (step-first-remainder #pt-nat)
                (step-second-remainder #pt-nat)
                (step-zero-first-bound
                  (#pt-app (#pt-use less-than ()) step-first-remainder divisor))
                (step-zero-second-bound
                  (#pt-app (#pt-use less-than ()) step-second-remainder divisor))
                (step-zero-sum-equation
                  (#pt-eq
                    #pt-nat
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use multiply ()) (#pt-succ previous-first-quotient) divisor)
                      step-first-remainder)
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use multiply ()) #pt-zero divisor)
                      step-second-remainder))))
              (#pt-app
                (#pt-use false-elimination ())
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-eq #pt-nat (#pt-succ previous-first-quotient) #pt-zero)
                  (#pt-eq #pt-nat step-first-remainder step-second-remainder))
                (#pt-app
                  (#pt-use small-remainder-excludes-positive-quotient ())
                  divisor
                  step-second-remainder
                  previous-first-quotient
                  step-first-remainder
                  step-zero-second-bound
                  (#pt-app
                    (#pt-use symmetry (0))
                    #pt-nat
