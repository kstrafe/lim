                      (#pt-use add ())
                      (#pt-app (#pt-use multiply ()) (#pt-succ base-second-predecessor) divisor)
                      base-second-remainder))))
              (#pt-app
                (#pt-use false-elimination ())
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-eq #pt-nat #pt-zero (#pt-succ base-second-predecessor))
                  (#pt-eq #pt-nat base-first-remainder base-second-remainder))
                (#pt-app
                  (#pt-use small-remainder-excludes-positive-quotient ())
                  divisor
                  base-first-remainder
                  base-second-predecessor
                  base-second-remainder
                  base-positive-first-bound
