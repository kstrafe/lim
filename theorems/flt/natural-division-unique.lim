                    #pt-nat
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use multiply ()) #pt-zero divisor)
                      base-first-remainder)
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use multiply ()) #pt-zero divisor)
                      base-second-remainder))))
