(#theorem division-unique
  (#universes)
  (#parameters
    (#parameter dividend #pt-nat)
    (#parameter divisor #pt-nat)
    (#parameter first-quotient #pt-nat)
    (#parameter first-remainder #pt-nat)
    (#parameter second-quotient #pt-nat)
    (#parameter second-remainder #pt-nat)
    (#parameter first-certificate (#pt-app (#pt-use division-spec ()) dividend divisor first-quotient first-remainder))
    (#parameter second-certificate (#pt-app (#pt-use division-spec ()) dividend divisor second-quotient second-remainder)))
  (#statement
    (#pt-app
      (#pt-use conjunction ())
      (#pt-eq #pt-nat first-quotient second-quotient)
      (#pt-eq #pt-nat first-remainder second-remainder)))
  (#proof
    (#pt-app
      (#pt-use quotient-remainder-unique ())
      divisor
      first-quotient
      second-quotient
      first-remainder
      second-remainder
      (#pt-app
        (#pt-use conjunction-right ())
        (#pt-eq
          #pt-nat
          dividend
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use multiply ()) first-quotient divisor)
            first-remainder))
        (#pt-app (#pt-use less-than ()) first-remainder divisor)
        first-certificate)
      (#pt-app
        (#pt-use conjunction-right ())
        (#pt-eq
          #pt-nat
          dividend
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use multiply ()) second-quotient divisor)
            second-remainder))
        (#pt-app (#pt-use less-than ()) second-remainder divisor)
        second-certificate)
      (#pt-app
        (#pt-use transitivity (0))
        #pt-nat
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use multiply ()) first-quotient divisor)
          first-remainder)
        dividend
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use multiply ()) second-quotient divisor)
          second-remainder)
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          dividend
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use multiply ()) first-quotient divisor)
            first-remainder)
          (#pt-app
            (#pt-use conjunction-left ())
            (#pt-eq
              #pt-nat
              dividend
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) first-quotient divisor)
                first-remainder))
            (#pt-app (#pt-use less-than ()) first-remainder divisor)
            first-certificate))
        (#pt-app
          (#pt-use conjunction-left ())
          (#pt-eq
            #pt-nat
            dividend
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use multiply ()) second-quotient divisor)
              second-remainder))
          (#pt-app (#pt-use less-than ()) second-remainder divisor)
          second-certificate)))))
