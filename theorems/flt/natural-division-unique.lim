                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-eq #pt-nat previous-first-quotient candidate-second-quotient)
                  (#pt-eq #pt-nat candidate-first-remainder candidate-second-remainder))))
            (step-second-quotient #pt-nat))
          (#pt-nat-induct
            (#pt-lambda
              ((step-second-index #pt-nat))
              (#pt-pi
                (
                  (step-first-remainder #pt-nat)
                  (step-second-remainder #pt-nat)
                  (step-test-first-bound
                    (#pt-app (#pt-use less-than ()) step-first-remainder divisor))
                  (step-test-second-bound
                    (#pt-app (#pt-use less-than ()) step-second-remainder divisor))
                  (step-test-sum-equation
                    (#pt-eq
                      #pt-nat
                      (#pt-app
                        (#pt-use add ())
                        (#pt-app (#pt-use multiply ()) (#pt-succ previous-first-quotient) divisor)
                        step-first-remainder)
