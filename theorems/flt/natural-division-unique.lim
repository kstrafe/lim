                      (step-first-remainder #pt-nat)
                      (step-second-remainder #pt-nat)
                      (step-earlier-first-bound
                        (#pt-app (#pt-use less-than ()) step-first-remainder divisor))
                      (step-earlier-second-bound
                        (#pt-app (#pt-use less-than ()) step-second-remainder divisor))
                      (step-earlier-sum-equation
                        (#pt-eq
                          #pt-nat
                          (#pt-app
                            (#pt-use add ())
                            (#pt-app
                              (#pt-use multiply ())
                              (#pt-succ previous-first-quotient)
                              divisor)
                            step-first-remainder)
                          (#pt-app
                            (#pt-use add ())
                            (#pt-app (#pt-use multiply ()) step-second-predecessor divisor)
                            step-second-remainder))))
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-eq #pt-nat (#pt-succ previous-first-quotient) step-second-predecessor)
                      (#pt-eq #pt-nat step-first-remainder step-second-remainder))))
                (step-first-remainder #pt-nat)
                (step-second-remainder #pt-nat)
                (step-positive-first-bound
