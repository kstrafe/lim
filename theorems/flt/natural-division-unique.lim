; Uniqueness of constructive natural quotient/remainder certificates.
; The cancellation proof follows structural induction on the quotient pair.
; This supplies the residue uniqueness needed by the exponent-three mod-nine proof.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias less-than = ./natural-order.lim::less-than)
(#alias not-less-than-addition = ./natural-discrete-order.lim::not-less-than-addition)
(#alias division-spec = ./natural-division.lim::division-spec)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias add-associative = ./natural-addition.lim::add-associative)
(#alias add-cancel-left = ./natural-cancellation.lim::add-cancel-left)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias congruence = ./equality.lim::congruence)
(#alias substitution = ./equality.lim::substitution)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#theorem small-remainder-excludes-positive-quotient
  (#universes)
  (#parameters
    (#parameter divisor #pt-nat)
    (#parameter remainder #pt-nat)
    (#parameter quotient-predecessor #pt-nat)
    (#parameter tail #pt-nat)
    (#parameter remainder-bound (#pt-app (#pt-use less-than ()) remainder divisor))
    (#parameter positive-quotient-equation (#pt-eq #pt-nat remainder (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) (#pt-succ quotient-predecessor) divisor) tail))))
  (#statement #pt-false)
  (#proof
    (#pt-app
      (#pt-app
        (#pt-use not-less-than-addition ())
        divisor
        (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) quotient-predecessor divisor) tail))
      (#pt-app
        (#pt-use substitution (0))
        #pt-nat
        (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use less-than ()) endpoint divisor))
        remainder
        (#pt-app
          (#pt-use add ())
          divisor
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use multiply ()) quotient-predecessor divisor)
            tail))
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          remainder
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use multiply ()) (#pt-succ quotient-predecessor) divisor)
            tail)
          (#pt-app
            (#pt-use add ())
            divisor
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use multiply ()) quotient-predecessor divisor)
              tail))
          positive-quotient-equation
          (#pt-app
            (#pt-use add-associative ())
            divisor
            (#pt-app (#pt-use multiply ()) quotient-predecessor divisor)
            tail))
        remainder-bound))))
(#theorem quotient-remainder-unique
  (#universes)
  (#parameters
    (#parameter divisor #pt-nat)
    (#parameter first-quotient #pt-nat)
    (#parameter second-quotient #pt-nat)
    (#parameter first-remainder #pt-nat)
    (#parameter second-remainder #pt-nat)
    (#parameter uniqueness-first-bound (#pt-app (#pt-use less-than ()) first-remainder divisor))
    (#parameter uniqueness-second-bound (#pt-app (#pt-use less-than ()) second-remainder divisor))
    (#parameter uniqueness-sum-equation (#pt-eq #pt-nat (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) first-quotient divisor) first-remainder) (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) second-quotient divisor) second-remainder))))
  (#statement
    (#pt-app
      (#pt-use conjunction ())
      (#pt-eq #pt-nat first-quotient second-quotient)
      (#pt-eq #pt-nat first-remainder second-remainder)))
  (#proof
    (#pt-app
      (#pt-nat-induct
        (#pt-lambda
          ((first-index #pt-nat))
          (#pt-pi
            (
              (candidate-second-quotient #pt-nat)
              (candidate-first-remainder #pt-nat)
              (candidate-second-remainder #pt-nat)
              (candidate-first-bound
                (#pt-app (#pt-use less-than ()) candidate-first-remainder divisor))
              (candidate-second-bound
                (#pt-app (#pt-use less-than ()) candidate-second-remainder divisor))
              (candidate-sum-equation
                (#pt-eq
                  #pt-nat
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use multiply ()) first-index divisor)
                    candidate-first-remainder)
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use multiply ()) candidate-second-quotient divisor)
                    candidate-second-remainder))))
            (#pt-app
              (#pt-use conjunction ())
              (#pt-eq #pt-nat first-index candidate-second-quotient)
              (#pt-eq #pt-nat candidate-first-remainder candidate-second-remainder))))
        (#pt-lambda
          ((base-second-quotient #pt-nat))
          (#pt-nat-induct
            (#pt-lambda
              ((base-second-index #pt-nat))
              (#pt-pi
                (
                  (base-first-remainder #pt-nat)
                  (base-second-remainder #pt-nat)
                  (base-test-first-bound
                    (#pt-app (#pt-use less-than ()) base-first-remainder divisor))
                  (base-test-second-bound
                    (#pt-app (#pt-use less-than ()) base-second-remainder divisor))
                  (base-test-sum-equation
                    (#pt-eq
                      #pt-nat
                      (#pt-app
                        (#pt-use add ())
