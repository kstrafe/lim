                            step-first-remainder)
                          (#pt-app
                            (#pt-use add ())
                            divisor
                            (#pt-app
                              (#pt-use add ())
                              (#pt-app (#pt-use multiply ()) step-second-predecessor divisor)
                              step-second-remainder))
                          (#pt-app
                            (#pt-use symmetry (0))
                            #pt-nat
                            (#pt-app
                              (#pt-use add ())
                              (#pt-app
                                (#pt-use multiply ())
                                (#pt-succ previous-first-quotient)
                                divisor)
                              step-first-remainder)
                            (#pt-app
                              (#pt-use add ())
                              divisor
