                          (#pt-use add ())
                          (#pt-app (#pt-use multiply ()) previous-first-quotient divisor)
                          step-first-remainder)
                        (#pt-app
                          (#pt-use add ())
                          (#pt-app (#pt-use multiply ()) step-second-predecessor divisor)
                          step-second-remainder)
                        (#pt-app
                          (#pt-use transitivity (0))
                          #pt-nat
                          (#pt-app
                            (#pt-use add ())
                            divisor
