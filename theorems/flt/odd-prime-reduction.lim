; The exponent-four proof and every odd-prime case are EXPLICIT parameters.
; This proves their reduction, not FLT or either mathematical case itself.
(#alias fermats-last-theorem-statement = ../fermat_statement.lim::fermats-last-theorem-statement)
(#alias add = ../fermat_statement.lim::add)
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias prime = ./natural-prime.lim::prime)
(#alias odd = ./natural-parity.lim::odd)
(#alias odd-prime-divisor = ./divisor-dichotomy.lim::odd-prime-divisor)
(#alias
  four-divides-or-odd-prime-divides
  =
  ./divisor-dichotomy.lim::four-divides-or-odd-prime-divides)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias fermat-for = ./fermat-for.lim::fermat-for)
(#alias fermat-for-monotone = ./fermat-for.lim::fermat-for-monotone)
(#alias successor-not-zero = ./natural-nonzero.lim::successor-not-zero)
(#alias power = ../fermat_statement.lim::power)
(#theorem fermat-for-from-odd-primes
  (#universes)
  (#parameters
    (#parameter exponent #pt-nat)
    (#parameter larger-than-two (#pt-app (#pt-use less-than ()) (#pt-succ (#pt-succ #pt-zero)) exponent))
    (#parameter four-case (#pt-app (#pt-use fermat-for ()) (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))))
    (#parameter odd-prime-cases (#pt-pi ((prime-exponent #pt-nat) (prime-evidence (#pt-app (#pt-use prime ()) prime-exponent)) (odd-evidence (#pt-app (#pt-use odd ()) prime-exponent))) (#pt-app (#pt-use fermat-for ()) prime-exponent))))
  (#statement (#pt-app (#pt-use fermat-for ()) exponent))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero)))) exponent)
      (#pt-app (#pt-use odd-prime-divisor ()) exponent)
      (#pt-app (#pt-use fermat-for ()) exponent)
      (#pt-lambda
        (
          (four-divides
            (#pt-app
              (#pt-use divides ())
              (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
              exponent)))
        (#pt-app
          (#pt-use fermat-for-monotone ())
          (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
          exponent
          four-divides
          four-case))
      (#pt-lambda
        ((odd-divisor-proof (#pt-app (#pt-use odd-prime-divisor ()) exponent)))
        (#pt-induct
          exists
          (0)
          (#pt-nat
            (#pt-lambda
              ((odd-prime-candidate #pt-nat))
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use prime ()) odd-prime-candidate)
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app (#pt-use divides ()) odd-prime-candidate exponent)
                  (#pt-app (#pt-use odd ()) odd-prime-candidate)))))
          (#pt-lambda
            (
              (certificate
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((odd-prime-candidate #pt-nat))
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app (#pt-use prime ()) odd-prime-candidate)
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-app (#pt-use divides ()) odd-prime-candidate exponent)
                        (#pt-app (#pt-use odd ()) odd-prime-candidate)))))))
            (#pt-app (#pt-use fermat-for ()) exponent))
          (
            (#pt-lambda
              (
                (prime-factor #pt-nat)
                (prime-certificate
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app (#pt-use prime ()) prime-factor)
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app (#pt-use divides ()) prime-factor exponent)
                      (#pt-app (#pt-use odd ()) prime-factor)))))
              (#pt-app
                (#pt-use fermat-for-monotone ())
                prime-factor
                exponent
                (#pt-app
                  (#pt-use conjunction-left ())
                  (#pt-app (#pt-use divides ()) prime-factor exponent)
                  (#pt-app (#pt-use odd ()) prime-factor)
                  (#pt-app
                    (#pt-use conjunction-right ())
                    (#pt-app (#pt-use prime ()) prime-factor)
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app (#pt-use divides ()) prime-factor exponent)
                      (#pt-app (#pt-use odd ()) prime-factor))
                    prime-certificate))
                (#pt-app
                  odd-prime-cases
                  prime-factor
                  (#pt-app
                    (#pt-use conjunction-left ())
                    (#pt-app (#pt-use prime ()) prime-factor)
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app (#pt-use divides ()) prime-factor exponent)
                      (#pt-app (#pt-use odd ()) prime-factor))
                    prime-certificate)
                  (#pt-app
                    (#pt-use conjunction-right ())
                    (#pt-app (#pt-use divides ()) prime-factor exponent)
                    (#pt-app (#pt-use odd ()) prime-factor)
                    (#pt-app
                      (#pt-use conjunction-right ())
                      (#pt-app (#pt-use prime ()) prime-factor)
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-app (#pt-use divides ()) prime-factor exponent)
                        (#pt-app (#pt-use odd ()) prime-factor))
                      prime-certificate))))))
          odd-divisor-proof))
      (#pt-app (#pt-use four-divides-or-odd-prime-divides ()) exponent larger-than-two))))
(#theorem fermat-statement-from-four-and-odd-primes
  (#universes)
  (#parameters
    (#parameter four-case (#pt-app (#pt-use fermat-for ()) (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))))
    (#parameter odd-prime-cases (#pt-pi ((prime-exponent #pt-nat) (prime-evidence (#pt-app (#pt-use prime ()) prime-exponent)) (odd-evidence (#pt-app (#pt-use odd ()) prime-exponent))) (#pt-app (#pt-use fermat-for ()) prime-exponent))))
  (#statement (#pt-use fermats-last-theorem-statement ()))
  (#proof
    (#pt-lambda
      (
        (a #pt-nat)
        (b #pt-nat)
        (c #pt-nat)
        (n #pt-nat)
        (counterexample
          (#pt-eq
            #pt-nat
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use power ()) (#pt-succ a) (#pt-succ (#pt-succ (#pt-succ n))))
              (#pt-app (#pt-use power ()) (#pt-succ b) (#pt-succ (#pt-succ (#pt-succ n)))))
            (#pt-app (#pt-use power ()) (#pt-succ c) (#pt-succ (#pt-succ (#pt-succ n)))))))
      (#pt-app
        (#pt-app
          (#pt-use fermat-for-from-odd-primes ())
          (#pt-succ (#pt-succ (#pt-succ n)))
          (#pt-construct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-gap #pt-nat))
                (#pt-eq
                  #pt-nat
                  (#pt-succ (#pt-succ (#pt-succ n)))
                  (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ (#pt-succ #pt-zero))) candidate-gap))))
            introduce
            (n (#pt-refl #pt-nat (#pt-succ (#pt-succ (#pt-succ n))))))
          four-case
          odd-prime-cases)
        (#pt-succ a)
        (#pt-succ b)
        (#pt-succ c)
        (#pt-app (#pt-use successor-not-zero ()) a)
        (#pt-app (#pt-use successor-not-zero ()) b)
        (#pt-app (#pt-use successor-not-zero ()) c)
        counterexample))))
