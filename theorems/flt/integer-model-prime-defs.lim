; Exact arithmetic IsGoodPrimeFor and IsSemistableModel predicates
; from Definitions/Def_FLTPrelim_Modularity.lean. These predicates
; alone assert neither a nonzero discriminant nor geometric reduction.
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-divides = ./integer-defs.lim::integer-divides)
(#alias integer-weierstrass-curve = ./integer-weierstrass-defs.lim::integer-weierstrass-curve)
(#alias integer-weierstrass-c4 = ./integer-weierstrass-defs.lim::integer-weierstrass-c4)
(#alias
  integer-weierstrass-discriminant
  =
  ./integer-weierstrass-defs.lim::integer-weierstrass-discriminant)
(#alias prime = ./natural-prime.lim::prime)
(#math-definition integer-is-good-prime-for ()
  (#pt-pi ((model (#pt-use integer-weierstrass-curve ())) (prime-number #pt-nat)) #pt-prop)
  (#pt-lambda
    ((model (#pt-use integer-weierstrass-curve ())) (prime-number #pt-nat))
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use integer-divides ())
            (#pt-app (#pt-use integer-of-natural ()) prime-number)
            (#pt-app (#pt-use integer-weierstrass-discriminant ()) model))))
      #pt-false)))
(#math-definition integer-is-semistable-model ()
  (#pt-pi ((model (#pt-use integer-weierstrass-curve ()))) #pt-prop)
  (#pt-lambda
    ((model (#pt-use integer-weierstrass-curve ())))
    (#pt-pi
      (
        (prime-number #pt-nat)
        (prime-proof (#pt-app (#pt-use prime ()) prime-number))
        (discriminant-divides
          (#pt-app
            (#pt-use integer-divides ())
            (#pt-app (#pt-use integer-of-natural ()) prime-number)
            (#pt-app (#pt-use integer-weierstrass-discriminant ()) model))))
      (#pt-pi
        (
          (denied-proof
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              (#pt-app (#pt-use integer-weierstrass-c4 ()) model))))
        #pt-false))))
