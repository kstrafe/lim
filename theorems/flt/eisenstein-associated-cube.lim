; Associated-cube certificates contain an actual root and unit inverse
; together with x=u*root^3. Zero, units and equivalent representatives
; have constructive certificates, without selecting canonical associates.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-power = ./eisenstein-defs.lim::eisenstein-power)
(#alias eisenstein-unit = ./eisenstein-defs.lim::eisenstein-unit)
(#alias eisenstein-reflexive = ./eisenstein-equality.lim::eisenstein-reflexive)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-one = ./eisenstein-ring.lim::eisenstein-multiply-one)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias exists = ./logic-exists.lim::exists)
(#alias eisenstein-one-unit = ./eisenstein-cubic-bridge.lim::eisenstein-one-unit)
(#math-definition eisenstein-associated-cube ()
  (#pt-pi ((number (#pt-use eisenstein ()))) #pt-prop)
  (#pt-lambda
    ((number (#pt-use eisenstein ())))
    (#pt-app
      (#pt-use exists (0))
      (#pt-use eisenstein ())
      (#pt-lambda
        ((candidate-cube-root (#pt-use eisenstein ())))
        (#pt-app
          (#pt-use exists (0))
          (#pt-use eisenstein ())
          (#pt-lambda
            ((candidate-unit (#pt-use eisenstein ())))
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app (#pt-use eisenstein-unit ()) candidate-unit)
              (#pt-app
                (#pt-use eisenstein-equal ())
                number
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  candidate-unit
                  (#pt-app (#pt-use eisenstein-power ()) candidate-cube-root (#pt-numeral 3)))))))))))
(#theorem eisenstein-zero-associated-cube
  (#universes)
  (#parameters)
  (#statement (#pt-app (#pt-use eisenstein-associated-cube ()) (#pt-use eisenstein-zero ())))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-cube-root (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use exists (0))
            (#pt-use eisenstein ())
            (#pt-lambda
              ((candidate-unit (#pt-use eisenstein ())))
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use eisenstein-unit ()) candidate-unit)
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-use eisenstein-zero ())
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    candidate-unit
                    (#pt-app (#pt-use eisenstein-power ()) candidate-cube-root (#pt-numeral 3)))))))))
      introduce
      (
        (#pt-use eisenstein-zero ())
        (#pt-construct
          exists
          (0)
          (
            (#pt-use eisenstein ())
            (#pt-lambda
              ((candidate-unit (#pt-use eisenstein ())))
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use eisenstein-unit ()) candidate-unit)
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-use eisenstein-zero ())
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    candidate-unit
                    (#pt-app
                      (#pt-use eisenstein-power ())
                      (#pt-use eisenstein-zero ())
                      (#pt-numeral 3)))))))
          introduce
          (
            (#pt-use eisenstein-one ())
            (#pt-app
              (#pt-use conjunction-introduce ())
              (#pt-app (#pt-use eisenstein-unit ()) (#pt-use eisenstein-one ()))
              (#pt-app
                (#pt-use eisenstein-equal ())
                (#pt-use eisenstein-zero ())
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-use eisenstein-one ())
                  (#pt-app
                    (#pt-use eisenstein-power ())
                    (#pt-use eisenstein-zero ())
                    (#pt-numeral 3))))
              (#pt-use eisenstein-one-unit ())
              (#pt-app (#pt-use eisenstein-reflexive ()) (#pt-use eisenstein-zero ())))))))))
(#theorem eisenstein-unit-associated-cube
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter unit-certificate (#pt-app (#pt-use eisenstein-unit ()) number)))
  (#statement (#pt-app (#pt-use eisenstein-associated-cube ()) number))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-cube-root (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use exists (0))
            (#pt-use eisenstein ())
            (#pt-lambda
              ((candidate-unit (#pt-use eisenstein ())))
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use eisenstein-unit ()) candidate-unit)
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  number
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    candidate-unit
                    (#pt-app (#pt-use eisenstein-power ()) candidate-cube-root (#pt-numeral 3)))))))))
      introduce
      (
        (#pt-use eisenstein-one ())
        (#pt-construct
          exists
          (0)
          (
            (#pt-use eisenstein ())
            (#pt-lambda
              ((candidate-unit (#pt-use eisenstein ())))
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use eisenstein-unit ()) candidate-unit)
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  number
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    candidate-unit
                    (#pt-app
                      (#pt-use eisenstein-power ())
                      (#pt-use eisenstein-one ())
                      (#pt-numeral 3)))))))
          introduce
          (number
            (#pt-app
              (#pt-use conjunction-introduce ())
              (#pt-app (#pt-use eisenstein-unit ()) number)
              (#pt-app
                (#pt-use eisenstein-equal ())
                number
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  number
                  (#pt-app
                    (#pt-use eisenstein-power ())
                    (#pt-use eisenstein-one ())
                    (#pt-numeral 3))))
              unit-certificate
              (#pt-app
                (#pt-use eisenstein-symmetric ())
                (#pt-app (#pt-use eisenstein-multiply ()) number (#pt-use eisenstein-one ()))
                number
                (#pt-app (#pt-use eisenstein-multiply-one ()) number)))))))))
(#theorem eisenstein-associated-cube-congruent
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter equivalent-number (#pt-use eisenstein ()))
    (#parameter value-equivalence (#pt-app (#pt-use eisenstein-equal ()) number equivalent-number))
    (#parameter associated-certificate (#pt-app (#pt-use eisenstein-associated-cube ()) number)))
  (#statement (#pt-app (#pt-use eisenstein-associated-cube ()) equivalent-number))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-cube-root (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use exists (0))
            (#pt-use eisenstein ())
            (#pt-lambda
              ((candidate-unit (#pt-use eisenstein ())))
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use eisenstein-unit ()) candidate-unit)
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  number
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    candidate-unit
                    (#pt-app (#pt-use eisenstein-power ()) candidate-cube-root (#pt-numeral 3)))))))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-cube-root (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use exists (0))
                  (#pt-use eisenstein ())
                  (#pt-lambda
                    ((candidate-unit (#pt-use eisenstein ())))
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app (#pt-use eisenstein-unit ()) candidate-unit)
                      (#pt-app
                        (#pt-use eisenstein-equal ())
                        number
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          candidate-unit
                          (#pt-app
                            (#pt-use eisenstein-power ())
                            candidate-cube-root
                            (#pt-numeral 3)))))))))))
        (#pt-app (#pt-use eisenstein-associated-cube ()) equivalent-number))
      (
        (#pt-lambda
          (
            (cube-root (#pt-use eisenstein ()))
            (unit-existence
              (#pt-app
                (#pt-use exists (0))
                (#pt-use eisenstein ())
                (#pt-lambda
                  ((candidate-unit (#pt-use eisenstein ())))
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app (#pt-use eisenstein-unit ()) candidate-unit)
                    (#pt-app
                      (#pt-use eisenstein-equal ())
                      number
                      (#pt-app
                        (#pt-use eisenstein-multiply ())
                        candidate-unit
                        (#pt-app (#pt-use eisenstein-power ()) cube-root (#pt-numeral 3)))))))))
          (#pt-induct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-unit (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app (#pt-use eisenstein-unit ()) candidate-unit)
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    number
                    (#pt-app
                      (#pt-use eisenstein-multiply ())
                      candidate-unit
                      (#pt-app (#pt-use eisenstein-power ()) cube-root (#pt-numeral 3)))))))
            (#pt-lambda
              (
                (eisenstein-certificate
                  (#pt-app
                    (#pt-use exists (0))
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-unit (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-app (#pt-use eisenstein-unit ()) candidate-unit)
                        (#pt-app
                          (#pt-use eisenstein-equal ())
                          number
                          (#pt-app
                            (#pt-use eisenstein-multiply ())
                            candidate-unit
                            (#pt-app (#pt-use eisenstein-power ()) cube-root (#pt-numeral 3)))))))))
              (#pt-app (#pt-use eisenstein-associated-cube ()) equivalent-number))
            (
              (#pt-lambda
                (
                  (cube-unit (#pt-use eisenstein ()))
                  (cube-certificate
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app (#pt-use eisenstein-unit ()) cube-unit)
                      (#pt-app
                        (#pt-use eisenstein-equal ())
                        number
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          cube-unit
                          (#pt-app (#pt-use eisenstein-power ()) cube-root (#pt-numeral 3)))))))
                (#pt-construct
                  exists
                  (0)
                  (
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-cube-root (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use exists (0))
                        (#pt-use eisenstein ())
                        (#pt-lambda
                          ((candidate-unit (#pt-use eisenstein ())))
                          (#pt-app
                            (#pt-use conjunction ())
                            (#pt-app (#pt-use eisenstein-unit ()) candidate-unit)
                            (#pt-app
                              (#pt-use eisenstein-equal ())
                              equivalent-number
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                candidate-unit
                                (#pt-app
                                  (#pt-use eisenstein-power ())
                                  candidate-cube-root
                                  (#pt-numeral 3)))))))))
                  introduce
                  (cube-root
                    (#pt-construct
                      exists
                      (0)
                      (
                        (#pt-use eisenstein ())
                        (#pt-lambda
                          ((candidate-unit (#pt-use eisenstein ())))
                          (#pt-app
                            (#pt-use conjunction ())
                            (#pt-app (#pt-use eisenstein-unit ()) candidate-unit)
                            (#pt-app
                              (#pt-use eisenstein-equal ())
                              equivalent-number
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                candidate-unit
                                (#pt-app (#pt-use eisenstein-power ()) cube-root (#pt-numeral 3)))))))
                      introduce
                      (cube-unit
                        (#pt-app
                          (#pt-use conjunction-introduce ())
                          (#pt-app (#pt-use eisenstein-unit ()) cube-unit)
                          (#pt-app
                            (#pt-use eisenstein-equal ())
                            equivalent-number
                            (#pt-app
                              (#pt-use eisenstein-multiply ())
                              cube-unit
                              (#pt-app (#pt-use eisenstein-power ()) cube-root (#pt-numeral 3))))
                          (#pt-app
                            (#pt-use conjunction-left ())
                            (#pt-app (#pt-use eisenstein-unit ()) cube-unit)
                            (#pt-app
                              (#pt-use eisenstein-equal ())
                              number
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                cube-unit
                                (#pt-app (#pt-use eisenstein-power ()) cube-root (#pt-numeral 3))))
                            cube-certificate)
                          (#pt-app
                            (#pt-use eisenstein-transitive ())
                            equivalent-number
                            number
                            (#pt-app
                              (#pt-use eisenstein-multiply ())
                              cube-unit
                              (#pt-app (#pt-use eisenstein-power ()) cube-root (#pt-numeral 3)))
                            (#pt-app
                              (#pt-use eisenstein-symmetric ())
                              number
                              equivalent-number
                              value-equivalence)
                            (#pt-app
                              (#pt-use conjunction-right ())
                              (#pt-app (#pt-use eisenstein-unit ()) cube-unit)
                              (#pt-app
                                (#pt-use eisenstein-equal ())
                                number
                                (#pt-app
                                  (#pt-use eisenstein-multiply ())
                                  cube-unit
                                  (#pt-app (#pt-use eisenstein-power ()) cube-root (#pt-numeral 3))))
                              cube-certificate)))))))))
            unit-existence)))
      associated-certificate)))
