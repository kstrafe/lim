; Concrete Eisenstein integer expressions a+b*omega with signed components.
; omega^2 = -omega-1 is represented by the explicit multiplication formula.
; Equality is componentwise integer equivalence, not record identity.
; Subsequent modules prove congruence, scalar embedding and the required
; algebraic facts; this definition alone assumes no PID or factorization law.
(#alias exists = ./logic-exists.lim::exists)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-zero = ./integer-defs.lim::integer-zero)
(#alias integer-one = ./integer-defs.lim::integer-one)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#math-inductive eisenstein ()
  ()
  (#pt-type 0)
  ((pair ((real (#pt-use integer ())) (omega (#pt-use integer ()))))))
(#math-definition eisenstein-of-integer ()
  (#pt-pi ((number (#pt-use integer ()))) (#pt-use eisenstein ()))
  (#pt-lambda
    ((number (#pt-use integer ())))
    (#pt-construct eisenstein () () pair (number (#pt-use integer-zero ())))))
(#math-definition eisenstein-zero ()
  (#pt-use eisenstein ())
  (#pt-app (#pt-use eisenstein-of-integer ()) (#pt-use integer-zero ())))
(#math-definition eisenstein-one ()
  (#pt-use eisenstein ())
  (#pt-app (#pt-use eisenstein-of-integer ()) (#pt-use integer-one ())))
(#math-definition eisenstein-omega ()
  (#pt-use eisenstein ())
  (#pt-construct eisenstein () () pair ((#pt-use integer-zero ()) (#pt-use integer-one ()))))
(#math-definition eisenstein-equal ()
  (#pt-pi ((first (#pt-use eisenstein ())) (second (#pt-use eisenstein ()))) #pt-prop)
  (#pt-lambda
    ((first (#pt-use eisenstein ())) (second (#pt-use eisenstein ())))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project eisenstein 0 first)
        (#pt-project eisenstein 0 second))
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project eisenstein 1 first)
        (#pt-project eisenstein 1 second)))))
(#math-definition eisenstein-negate ()
  (#pt-pi ((number (#pt-use eisenstein ()))) (#pt-use eisenstein ()))
  (#pt-lambda
    ((number (#pt-use eisenstein ())))
    (#pt-construct
      eisenstein
      ()
      ()
      pair
      (
        (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 0 number))
        (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 number))))))
(#math-definition eisenstein-add ()
  (#pt-pi
    ((first (#pt-use eisenstein ())) (second (#pt-use eisenstein ())))
    (#pt-use eisenstein ()))
  (#pt-lambda
    ((first (#pt-use eisenstein ())) (second (#pt-use eisenstein ())))
    (#pt-construct
      eisenstein
      ()
      ()
      pair
      (
        (#pt-app
          (#pt-use integer-add ())
          (#pt-project eisenstein 0 first)
          (#pt-project eisenstein 0 second))
        (#pt-app
          (#pt-use integer-add ())
          (#pt-project eisenstein 1 first)
          (#pt-project eisenstein 1 second))))))
(#math-definition eisenstein-multiply ()
  (#pt-pi
    ((first (#pt-use eisenstein ())) (second (#pt-use eisenstein ())))
    (#pt-use eisenstein ()))
  (#pt-lambda
    ((first (#pt-use eisenstein ())) (second (#pt-use eisenstein ())))
    (#pt-construct
      eisenstein
      ()
      ()
      pair
      (
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project eisenstein 0 first)
            (#pt-project eisenstein 0 second))
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project eisenstein 1 first)
              (#pt-project eisenstein 1 second))))
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project eisenstein 0 first)
              (#pt-project eisenstein 1 second))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project eisenstein 1 first)
              (#pt-project eisenstein 0 second)))
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project eisenstein 1 first)
              (#pt-project eisenstein 1 second))))))))
(#math-definition eisenstein-power ()
  (#pt-pi ((number (#pt-use eisenstein ())) (exponent #pt-nat)) (#pt-use eisenstein ()))
  (#pt-lambda
    ((number (#pt-use eisenstein ())) (exponent #pt-nat))
    (#pt-nat-induct
      (#pt-lambda ((ordinal #pt-nat)) (#pt-use eisenstein ()))
      (#pt-use eisenstein-one ())
      (#pt-lambda
        ((previous #pt-nat) (product (#pt-use eisenstein ())))
        (#pt-app (#pt-use eisenstein-multiply ()) number product))
      exponent)))
(#math-definition eisenstein-divides ()
  (#pt-pi ((first (#pt-use eisenstein ())) (second (#pt-use eisenstein ()))) #pt-prop)
  (#pt-lambda
    ((first (#pt-use eisenstein ())) (second (#pt-use eisenstein ())))
    (#pt-app
      (#pt-use exists (0))
      (#pt-use eisenstein ())
      (#pt-lambda
        ((factor (#pt-use eisenstein ())))
        (#pt-app
          (#pt-use eisenstein-equal ())
          second
          (#pt-app (#pt-use eisenstein-multiply ()) first factor))))))
(#math-definition eisenstein-coprime ()
  (#pt-pi ((first (#pt-use eisenstein ())) (second (#pt-use eisenstein ()))) #pt-prop)
  (#pt-lambda
    ((first (#pt-use eisenstein ())) (second (#pt-use eisenstein ())))
    (#pt-app
      (#pt-use exists (0))
      (#pt-use eisenstein ())
      (#pt-lambda
        ((left-coefficient (#pt-use eisenstein ())))
        (#pt-app
          (#pt-use exists (0))
          (#pt-use eisenstein ())
          (#pt-lambda
            ((right-coefficient (#pt-use eisenstein ())))
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-use eisenstein-one ())
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first)
                (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient second)))))))))
(#math-definition eisenstein-unit ()
  (#pt-pi ((number (#pt-use eisenstein ()))) #pt-prop)
  (#pt-lambda
    ((number (#pt-use eisenstein ())))
    (#pt-app
      (#pt-use exists (0))
      (#pt-use eisenstein ())
      (#pt-lambda
        ((inverse (#pt-use eisenstein ())))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app (#pt-use eisenstein-multiply ()) number inverse)
            (#pt-use eisenstein-one ()))
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app (#pt-use eisenstein-multiply ()) inverse number)
            (#pt-use eisenstein-one ())))))))
(#math-definition eisenstein-lambda ()
  (#pt-use eisenstein ())
  (#pt-app
    (#pt-use eisenstein-add ())
    (#pt-use eisenstein-omega ())
    (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))))
