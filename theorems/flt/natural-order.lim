; Strict natural order by an explicit nonnegative addition gap.
; a < b means there exists gap with b = succ(a) + gap.
; This is an unbounded Nat relation, not machine comparison or sampling.
(#alias add = ../fermat_statement.lim::add)
(#alias exists = ./logic-exists.lim::exists)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias congruence = ./equality.lim::congruence)
(#alias add-zero-right = ./natural-addition.lim::add-zero-right)
(#alias add-successor-right = ./natural-addition.lim::add-successor-right)
(#alias add-associative = ./natural-addition.lim::add-associative)
(#alias add-cancel-left = ./natural-cancellation.lim::add-cancel-left)
(#alias successor-not-zero = ./natural-nonzero.lim::successor-not-zero)
(#alias below = ./natural-strong-induction.lim::below)
(#alias strong-induction-with-gap = ./natural-strong-induction.lim::strong-induction-with-gap)
(#math-definition less-than ()
  (#pt-pi ((lower #pt-nat) (upper #pt-nat)) #pt-prop)
  (#pt-lambda
    ((lower #pt-nat) (upper #pt-nat))
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((difference #pt-nat))
        (#pt-eq #pt-nat upper (#pt-app (#pt-use add ()) (#pt-succ lower) difference))))))
(#theorem less-than-successor
  (#universes)
  (#parameters
    (#parameter number #pt-nat))
  (#statement (#pt-app (#pt-use less-than ()) number (#pt-succ number)))
  (#proof
    (#pt-construct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((difference #pt-nat))
          (#pt-eq #pt-nat (#pt-succ number) (#pt-app (#pt-use add ()) (#pt-succ number) difference))))
      introduce
      (#pt-zero
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          (#pt-app (#pt-use add ()) (#pt-succ number) #pt-zero)
          (#pt-succ number)
          (#pt-app (#pt-use add-zero-right ()) (#pt-succ number)))))))
(#theorem not-less-than-zero
  (#universes)
  (#parameters
    (#parameter number #pt-nat))
  (#statement (#pt-pi ((impossible (#pt-app (#pt-use less-than ()) number #pt-zero))) #pt-false))
  (#proof
    (#pt-lambda
      ((impossible (#pt-app (#pt-use less-than ()) number #pt-zero)))
      (#pt-induct
        exists
        (0)
        (#pt-nat
          (#pt-lambda
            ((difference #pt-nat))
            (#pt-eq #pt-nat #pt-zero (#pt-app (#pt-use add ()) (#pt-succ number) difference))))
        (#pt-lambda
          (
            (certificate
              (#pt-app
                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((difference #pt-nat))
                  (#pt-eq #pt-nat #pt-zero (#pt-app (#pt-use add ()) (#pt-succ number) difference))))))
          #pt-false)
        (
          (#pt-lambda
            (
              (gap #pt-nat)
              (position (#pt-eq #pt-nat #pt-zero (#pt-app (#pt-use add ()) (#pt-succ number) gap))))
            (#pt-app
              (#pt-app (#pt-use successor-not-zero ()) (#pt-app (#pt-use add ()) number gap))
              (#pt-app
                (#pt-use symmetry (0))
                #pt-nat
                #pt-zero
                (#pt-app (#pt-use add ()) (#pt-succ number) gap)
                position))))
        impossible))))
(#theorem not-less-than-self
  (#universes)
  (#parameters
    (#parameter number #pt-nat))
  (#statement (#pt-pi ((impossible (#pt-app (#pt-use less-than ()) number number))) #pt-false))
  (#proof
    (#pt-lambda
      ((impossible (#pt-app (#pt-use less-than ()) number number)))
      (#pt-induct
        exists
        (0)
        (#pt-nat
          (#pt-lambda
            ((difference #pt-nat))
            (#pt-eq #pt-nat number (#pt-app (#pt-use add ()) (#pt-succ number) difference))))
        (#pt-lambda
          (
            (certificate
              (#pt-app
                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((difference #pt-nat))
                  (#pt-eq #pt-nat number (#pt-app (#pt-use add ()) (#pt-succ number) difference))))))
          #pt-false)
        (
          (#pt-lambda
            (
              (gap #pt-nat)
              (position (#pt-eq #pt-nat number (#pt-app (#pt-use add ()) (#pt-succ number) gap))))
            (#pt-app
              (#pt-app (#pt-use successor-not-zero ()) gap)
              (#pt-app
                (#pt-use symmetry (0))
                #pt-nat
                #pt-zero
                (#pt-succ gap)
                (#pt-app
                  (#pt-use add-cancel-left ())
                  number
                  #pt-zero
                  (#pt-succ gap)
                  (#pt-app
                    (#pt-use transitivity (0))
                    #pt-nat
                    (#pt-app (#pt-use add ()) number #pt-zero)
                    number
                    (#pt-app (#pt-use add ()) number (#pt-succ gap))
                    (#pt-app (#pt-use add-zero-right ()) number)
                    (#pt-app
                      (#pt-use transitivity (0))
                      #pt-nat
                      number
                      (#pt-app (#pt-use add ()) (#pt-succ number) gap)
                      (#pt-app (#pt-use add ()) number (#pt-succ gap))
                      position
                      (#pt-app
                        (#pt-use symmetry (0))
                        #pt-nat
                        (#pt-app (#pt-use add ()) number (#pt-succ gap))
                        (#pt-app (#pt-use add ()) (#pt-succ number) gap)
                        (#pt-app (#pt-use add-successor-right ()) number gap)))))))))
        impossible))))
(#theorem less-than-transitive
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter third #pt-nat)
    (#parameter first-proof (#pt-app (#pt-use less-than ()) first second))
    (#parameter second-proof (#pt-app (#pt-use less-than ()) second third)))
  (#statement (#pt-app (#pt-use less-than ()) first third))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((difference #pt-nat))
          (#pt-eq #pt-nat second (#pt-app (#pt-use add ()) (#pt-succ first) difference))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((difference #pt-nat))
                (#pt-eq #pt-nat second (#pt-app (#pt-use add ()) (#pt-succ first) difference))))))
        (#pt-app (#pt-use less-than ()) first third))
      (
        (#pt-lambda
          (
            (first-gap #pt-nat)
            (first-position
              (#pt-eq #pt-nat second (#pt-app (#pt-use add ()) (#pt-succ first) first-gap))))
          (#pt-induct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((difference #pt-nat))
                (#pt-eq #pt-nat third (#pt-app (#pt-use add ()) (#pt-succ second) difference))))
            (#pt-lambda
              (
                (certificate
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((difference #pt-nat))
                      (#pt-eq #pt-nat third (#pt-app (#pt-use add ()) (#pt-succ second) difference))))))
              (#pt-app (#pt-use less-than ()) first third))
            (
              (#pt-lambda
                (
                  (second-gap #pt-nat)
                  (second-position
                    (#pt-eq #pt-nat third (#pt-app (#pt-use add ()) (#pt-succ second) second-gap))))
                (#pt-construct
                  exists
                  (0)
                  (#pt-nat
                    (#pt-lambda
                      ((difference #pt-nat))
                      (#pt-eq #pt-nat third (#pt-app (#pt-use add ()) (#pt-succ first) difference))))
                  introduce
                  (
                    (#pt-succ (#pt-app (#pt-use add ()) first-gap second-gap))
                    (#pt-app
                      (#pt-use transitivity (0))
                      #pt-nat
                      third
                      (#pt-app (#pt-use add ()) (#pt-succ second) second-gap)
                      (#pt-app
                        (#pt-use add ())
                        (#pt-succ first)
                        (#pt-succ (#pt-app (#pt-use add ()) first-gap second-gap)))
                      second-position
                      (#pt-app
                        (#pt-use transitivity (0))
                        #pt-nat
                        (#pt-app (#pt-use add ()) (#pt-succ second) second-gap)
                        (#pt-app
                          (#pt-use add ())
                          (#pt-succ (#pt-app (#pt-use add ()) (#pt-succ first) first-gap))
                          second-gap)
                        (#pt-app
                          (#pt-use add ())
                          (#pt-succ first)
                          (#pt-succ (#pt-app (#pt-use add ()) first-gap second-gap)))
                        (#pt-app
                          (#pt-use congruence (0 0))
                          #pt-nat
                          #pt-nat
                          (#pt-lambda
                            ((value #pt-nat))
                            (#pt-app (#pt-use add ()) (#pt-succ value) second-gap))
                          second
                          (#pt-app (#pt-use add ()) (#pt-succ first) first-gap)
                          first-position)
                        (#pt-app
                          (#pt-use transitivity (0))
                          #pt-nat
                          (#pt-app
                            (#pt-use add ())
                            (#pt-succ (#pt-app (#pt-use add ()) (#pt-succ first) first-gap))
                            second-gap)
                          (#pt-succ
                            (#pt-app
                              (#pt-use add ())
                              (#pt-succ first)
                              (#pt-app (#pt-use add ()) first-gap second-gap)))
                          (#pt-app
                            (#pt-use add ())
                            (#pt-succ first)
                            (#pt-succ (#pt-app (#pt-use add ()) first-gap second-gap)))
                          (#pt-app
                            (#pt-use congruence (0 0))
                            #pt-nat
                            #pt-nat
                            (#pt-lambda ((value #pt-nat)) (#pt-succ value))
                            (#pt-app
                              (#pt-use add ())
                              (#pt-app (#pt-use add ()) (#pt-succ first) first-gap)
                              second-gap)
                            (#pt-app
                              (#pt-use add ())
                              (#pt-succ first)
                              (#pt-app (#pt-use add ()) first-gap second-gap))
                            (#pt-app
                              (#pt-use add-associative ())
                              (#pt-succ first)
                              first-gap
                              second-gap))
                          (#pt-app
                            (#pt-use symmetry (0))
                            #pt-nat
                            (#pt-app
                              (#pt-use add ())
                              (#pt-succ first)
                              (#pt-succ (#pt-app (#pt-use add ()) first-gap second-gap)))
                            (#pt-succ
                              (#pt-app
                                (#pt-use add ())
                                (#pt-succ first)
                                (#pt-app (#pt-use add ()) first-gap second-gap)))
                            (#pt-app
                              (#pt-use add-successor-right ())
                              (#pt-succ first)
                              (#pt-app (#pt-use add ()) first-gap second-gap))))))))))
            second-proof)))
      first-proof)))
(#theorem strong-induction
  (#universes)
  (#parameters
    (#parameter property (#pt-pi ((index #pt-nat)) #pt-prop))
    (#parameter step-proof (#pt-pi ((stage #pt-nat) (prior (#pt-pi ((earlier #pt-nat) (position-proof (#pt-app (#pt-use less-than ()) earlier stage))) (#pt-app property earlier)))) (#pt-app property stage))))
  (#statement (#pt-pi ((number #pt-nat)) (#pt-app property number)))
  (#proof
    (#pt-app
      (#pt-use strong-induction-with-gap ())
      property
      (#pt-lambda
        ((stage #pt-nat) (gap-history (#pt-app (#pt-use below ()) property stage)))
        (#pt-app
          step-proof
          stage
          (#pt-lambda
            ((earlier #pt-nat) (position-proof (#pt-app (#pt-use less-than ()) earlier stage)))
            (#pt-induct
              exists
              (0)
              (#pt-nat
                (#pt-lambda
                  ((difference #pt-nat))
                  (#pt-eq #pt-nat stage (#pt-app (#pt-use add ()) (#pt-succ earlier) difference))))
              (#pt-lambda
                (
                  (certificate
                    (#pt-app
                      (#pt-use exists (0))
                      #pt-nat
                      (#pt-lambda
                        ((difference #pt-nat))
                        (#pt-eq
                          #pt-nat
                          stage
                          (#pt-app (#pt-use add ()) (#pt-succ earlier) difference))))))
                (#pt-app property earlier))
              (
                (#pt-lambda
                  (
                    (gap #pt-nat)
                    (position
                      (#pt-eq #pt-nat stage (#pt-app (#pt-use add ()) (#pt-succ earlier) gap))))
                  (#pt-app gap-history earlier gap position)))
              position-proof)))))))
