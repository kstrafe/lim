; Next arithmetic consequence of the source denominator calculation:
; for a natural prime q != 2, q divides the integral discriminant
; exactly when q divides a*b*c. Retain the actual integral model,
; coordinate equation and positive exponent. No valuation or
; geometric semistability conclusion is assumed or claimed.
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias power = ./../fermat_statement.lim::power)
(#alias less-than = ./natural-order.lim::less-than)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-power = ./integer-defs.lim::integer-power)
(#alias integer-divides = ./integer-defs.lim::integer-divides)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias multiply-nonzero = ./natural-nonzero.lim::multiply-nonzero)
(#alias successor-not-zero = ./natural-nonzero.lim::successor-not-zero)
(#alias
  integer-divides-congruent-target
  =
  ./integer-divisibility.lim::integer-divides-congruent-target)
(#alias integer-weierstrass-curve = ./integer-weierstrass-defs.lim::integer-weierstrass-curve)
(#alias
  integer-weierstrass-discriminant
  =
  ./integer-weierstrass-defs.lim::integer-weierstrass-discriminant)
(#alias integer-frey-model-certificate = ./integer-frey-model.lim::integer-frey-model-certificate)
(#alias prime = ./natural-prime.lim::prime)
(#alias
  integer-divides-positive-power
  =
  ./integer-prime-coprimality.lim::integer-divides-positive-power)
(#alias zero-less-nonzero = ./natural-square-order.lim::zero-less-nonzero)
(#alias less-than-upper-nonzero = ./natural-small-cases.lim::less-than-upper-nonzero)
(#alias
  integer-prime-away-two-not-divides-power
  =
  ./integer-prime-away-two.lim::integer-prime-away-two-not-divides-power)
(#alias integer-prime-cancel-right = ./integer-prime-away-two.lim::integer-prime-cancel-right)
(#alias
  integer-frey-discriminant-multiplied
  =
  ./integer-frey-invariants.lim::integer-frey-discriminant-multiplied)
(#alias
  integer-frey-discriminant-prime-divisor
  =
  ./integer-frey-c4-primes.lim::integer-frey-discriminant-prime-divisor)
(#alias frey-package-certificate = ./frey-package.lim::frey-package-certificate)
(#alias large-prime-positive-and-odd = ./frey-package.lim::large-prime-positive-and-odd)
(#theorem integer-frey-product-prime-divisor-away-two
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter power-exponent #pt-nat)
    (#parameter integral-model (#pt-use integer-weierstrass-curve ()))
    (#parameter model-certificate (#pt-app (#pt-use integer-frey-model-certificate ()) first second power-exponent integral-model))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter not-two (#pt-pi ((denied-proof (#pt-eq #pt-nat prime-number (#pt-succ (#pt-succ #pt-zero))))) #pt-false))
    (#parameter positive-exponent (#pt-app (#pt-use less-than ()) #pt-zero power-exponent))
    (#parameter power-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-power ()) first power-exponent) (#pt-app (#pt-use integer-power ()) second power-exponent)) (#pt-app (#pt-use integer-power ()) third power-exponent)))
    (#parameter coordinate-divides (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) (#pt-app (#pt-use integer-multiply ()) (#pt-app (#pt-use integer-multiply ()) first second) third))))
  (#statement
    (#pt-app
      (#pt-use integer-divides ())
      (#pt-app (#pt-use integer-of-natural ()) prime-number)
      (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)))
  (#proof
    (#pt-app
      (#pt-use integer-prime-cancel-right ())
      prime-number
      (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)
      (#pt-app
        (#pt-use integer-of-natural ())
        (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-numeral 8)))
      prime-proof
      (#pt-app
        (#pt-use integer-prime-away-two-not-divides-power ())
        prime-number
        (#pt-numeral 8)
        prime-proof
        not-two)
      (#pt-app
        (#pt-use integer-divides-congruent-target ())
        (#pt-app (#pt-use integer-of-natural ()) prime-number)
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            third)
          (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) power-exponent))
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)
          (#pt-app
            (#pt-use integer-of-natural ())
            (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-numeral 8))))
        (#pt-app
          (#pt-use integer-symmetric ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-numeral 8))))
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-multiply ()) first second)
              third)
            (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) power-exponent))
          (#pt-app
            (#pt-use integer-frey-discriminant-multiplied ())
            first
            second
            third
            power-exponent
            integral-model
            model-certificate
            power-equation))
        (#pt-app
          (#pt-use integer-divides-positive-power ())
          (#pt-app (#pt-use integer-of-natural ()) prime-number)
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            third)
          (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) power-exponent)
          (#pt-app
            (#pt-use zero-less-nonzero ())
            (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) power-exponent)
            (#pt-app
              (#pt-use multiply-nonzero ())
              (#pt-succ (#pt-succ #pt-zero))
              power-exponent
              (#pt-app (#pt-use successor-not-zero ()) (#pt-numeral 1))
              (#pt-app
                (#pt-use less-than-upper-nonzero ())
                #pt-zero
                power-exponent
                positive-exponent)))
          coordinate-divides)))))
(#theorem integer-frey-prime-divisors-equivalent-away-two
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter power-exponent #pt-nat)
    (#parameter integral-model (#pt-use integer-weierstrass-curve ()))
    (#parameter model-certificate (#pt-app (#pt-use integer-frey-model-certificate ()) first second power-exponent integral-model))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter not-two (#pt-pi ((denied-proof (#pt-eq #pt-nat prime-number (#pt-succ (#pt-succ #pt-zero))))) #pt-false))
    (#parameter positive-exponent (#pt-app (#pt-use less-than ()) #pt-zero power-exponent))
    (#parameter power-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-power ()) first power-exponent) (#pt-app (#pt-use integer-power ()) second power-exponent)) (#pt-app (#pt-use integer-power ()) third power-exponent))))
  (#statement
    (#pt-app
      (#pt-use conjunction ())
      (#pt-pi
        (
          (discriminant-divides
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) prime-number)
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            third)))
      (#pt-pi
        (
          (coordinate-divides
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-multiply ()) first second)
                third))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) prime-number)
          (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)))))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-pi
        (
          (discriminant-divides
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) prime-number)
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            third)))
      (#pt-pi
        (
          (coordinate-divides
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-multiply ()) first second)
                third))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) prime-number)
          (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)))
      (#pt-lambda
        (
          (discriminant-divides
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model))))
        (#pt-app
          (#pt-use integer-frey-discriminant-prime-divisor ())
          prime-number
          first
          second
          third
          power-exponent
          integral-model
          model-certificate
          prime-proof
          power-equation
          discriminant-divides))
      (#pt-lambda
        (
          (coordinate-divides
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-multiply ()) first second)
                third))))
        (#pt-app
          (#pt-use integer-frey-product-prime-divisor-away-two ())
          prime-number
          first
          second
          third
          power-exponent
          integral-model
          model-certificate
          prime-proof
          not-two
          positive-exponent
          power-equation
          coordinate-divides)))))
(#theorem frey-package-prime-divisors-equivalent-away-two
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter power-exponent #pt-nat)
    (#parameter package (#pt-app (#pt-use frey-package-certificate ()) power-exponent first second third))
    (#parameter integral-model (#pt-use integer-weierstrass-curve ()))
    (#parameter model-certificate (#pt-app (#pt-use integer-frey-model-certificate ()) first second power-exponent integral-model))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter not-two (#pt-pi ((denied-proof (#pt-eq #pt-nat prime-number (#pt-succ (#pt-succ #pt-zero))))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use conjunction ())
      (#pt-pi
        (
          (discriminant-divides
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) prime-number)
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            third)))
      (#pt-pi
        (
          (coordinate-divides
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-multiply ()) first second)
                third))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) prime-number)
          (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)))))
  (#proof
    (#pt-app
      (#pt-use integer-frey-prime-divisors-equivalent-away-two ())
      prime-number
      first
      second
      third
      power-exponent
      integral-model
      model-certificate
      prime-proof
      not-two
      (#pt-project
        conjunction
        0
        (#pt-app
          (#pt-use large-prime-positive-and-odd ())
          power-exponent
          (#pt-project conjunction 0 package)
          (#pt-project conjunction 0 (#pt-project conjunction 1 package))))
      (#pt-project
        conjunction
        1
        (#pt-project
          conjunction
          1
          (#pt-project
            conjunction
            1
            (#pt-project
              conjunction
              1
              (#pt-project
                conjunction
                1
                (#pt-project
                  conjunction
                  0
                  (#pt-project conjunction 1 (#pt-project conjunction 1 package)))))))))))
