; Direct mathematical source port of FLT/Three.lean:279-290.
; Connect the proved solution congruence to exact lambda multiplicity.
; Neither the fourth-power divisor nor the order bound is assumed.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-lambda = ./eisenstein-defs.lim::eisenstein-lambda)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-power = ./eisenstein-defs.lim::eisenstein-power)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias eisenstein-unit = ./eisenstein-defs.lim::eisenstein-unit)
(#alias eisenstein-lambda-order = ./eisenstein-lambda-order.lim::eisenstein-lambda-order)
(#alias eisenstein-add = ./eisenstein-defs.lim::eisenstein-add)
(#alias
  eisenstein-cubic-solution-fourth-power-divides
  =
  ./eisenstein-cubic-solution-congruences.lim::eisenstein-cubic-solution-fourth-power-divides)
(#alias
  eisenstein-lambda-square-divides-from-cube
  =
  ./eisenstein-lambda-cubic-divisibility.lim::eisenstein-lambda-square-divides-from-cube)
(#alias
  eisenstein-lambda-order-at-least-two-from-cube
  =
  ./eisenstein-lambda-cubic-divisibility.lim::eisenstein-lambda-order-at-least-two-from-cube)
(#alias less-than = ./natural-order.lim::less-than)
(#theorem eisenstein-cubic-solution-square-divides
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter third (#pt-use eisenstein ()))
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter unit-proof (#pt-app (#pt-use eisenstein-unit ()) unit))
    (#parameter first-not-divides (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) first))) #pt-false))
    (#parameter second-not-divides (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) second))) #pt-false))
    (#parameter third-divides (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) third))
    (#parameter solution-equation (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-add ()) (#pt-app (#pt-use eisenstein-power ()) first (#pt-numeral 3)) (#pt-app (#pt-use eisenstein-power ()) second (#pt-numeral 3))) (#pt-app (#pt-use eisenstein-multiply ()) unit (#pt-app (#pt-use eisenstein-power ()) third (#pt-numeral 3)))))
    (#parameter third-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) third (#pt-use eisenstein-zero ())))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-divides ())
      (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2))
      third))
  (#proof
    (#pt-app
      (#pt-use eisenstein-lambda-square-divides-from-cube ())
      third
      third-nonzero
      (#pt-app
        (#pt-use eisenstein-cubic-solution-fourth-power-divides ())
        first
        second
        third
        unit
        unit-proof
        first-not-divides
        second-not-divides
        third-divides
        solution-equation))))
(#theorem eisenstein-cubic-solution-order-at-least-two
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter third (#pt-use eisenstein ()))
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter unit-proof (#pt-app (#pt-use eisenstein-unit ()) unit))
    (#parameter first-not-divides (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) first))) #pt-false))
    (#parameter second-not-divides (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) second))) #pt-false))
    (#parameter third-divides (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) third))
    (#parameter solution-equation (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-add ()) (#pt-app (#pt-use eisenstein-power ()) first (#pt-numeral 3)) (#pt-app (#pt-use eisenstein-power ()) second (#pt-numeral 3))) (#pt-app (#pt-use eisenstein-multiply ()) unit (#pt-app (#pt-use eisenstein-power ()) third (#pt-numeral 3)))))
    (#parameter order-exponent #pt-nat)
    (#parameter order-certificate (#pt-app (#pt-use eisenstein-lambda-order ()) third order-exponent)))
  (#statement (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) order-exponent))
  (#proof
    (#pt-app
      (#pt-use eisenstein-lambda-order-at-least-two-from-cube ())
      third
      order-exponent
      order-certificate
      (#pt-app
        (#pt-use eisenstein-cubic-solution-fourth-power-divides ())
        first
        second
        third
        unit
        unit-proof
        first-not-divides
        second-not-divides
        third-divides
        solution-equation))))
