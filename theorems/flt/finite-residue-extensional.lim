; Mathematical source: pinned Mathlib Data/ZMod/Defs.lean.
; Generated by scripts/generate-flt-signed-residues.py; checked native proof terms.
; Equality of canonical values is equivalent to the actual record
; identity. J transports the bound and checked record eta/proof
; irrelevance removes the choice of range evidence.
(#alias congruence = ./equality.lim::congruence)
(#alias less-than = ./natural-order.lim::less-than)
(#alias finite-residue = ./finite-residue-defs.lim::finite-residue)
(#theorem finite-residue-extensional
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter first (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter equation (#pt-eq #pt-nat (#pt-project finite-residue 0 first) (#pt-project finite-residue 0 second))))
  (#statement (#pt-eq (#pt-app (#pt-use finite-residue ()) modulus) first second))
  (#proof
    (#pt-app
      (#pt-eq-elim
        #pt-nat
        (#pt-project finite-residue 0 first)
        (#pt-lambda
          (
            (new-representative #pt-nat)
            (representative-path
              (#pt-eq #pt-nat (#pt-project finite-residue 0 first) new-representative)))
          (#pt-pi
            ((new-range-proof (#pt-app (#pt-use less-than ()) new-representative modulus)))
            (#pt-eq
              (#pt-app (#pt-use finite-residue ()) modulus)
              first
              (#pt-construct
                finite-residue
                ()
                (modulus)
                representative
                (new-representative new-range-proof)))))
        (#pt-lambda
          (
            (new-range-proof
              (#pt-app (#pt-use less-than ()) (#pt-project finite-residue 0 first) modulus)))
          (#pt-refl (#pt-app (#pt-use finite-residue ()) modulus) first))
        (#pt-project finite-residue 0 second)
        equation)
      (#pt-project finite-residue 1 second))))
(#theorem finite-residue-value-congruence
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter first (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter record-equation (#pt-eq (#pt-app (#pt-use finite-residue ()) modulus) first second)))
  (#statement
    (#pt-eq #pt-nat (#pt-project finite-residue 0 first) (#pt-project finite-residue 0 second)))
  (#proof
    (#pt-app
      (#pt-use congruence (0 0))
      (#pt-app (#pt-use finite-residue ()) modulus)
      #pt-nat
      (#pt-lambda
        ((residue-argument (#pt-app (#pt-use finite-residue ()) modulus)))
        (#pt-project finite-residue 0 residue-argument))
      first
      second
      record-equation)))
