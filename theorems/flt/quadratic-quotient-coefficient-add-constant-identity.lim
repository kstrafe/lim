; are checked by Lim from the supplied concrete ring laws.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias ring-add = ./commutative-ring-data.lim::ring-add)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#theorem quadratic-quotient-coefficient-add-constant-identity
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-coefficient Carrier)
    (#parameter second-coefficient Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-add ()) Carrier coefficient-ring first-coefficient second-coefficient)
      (#pt-app (#pt-use ring-add ()) Carrier coefficient-ring first-coefficient second-coefficient)))
  (#proof
    (#pt-app
      (#pt-use ring-reflexive ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-add ()) Carrier coefficient-ring first-coefficient second-coefficient))))
