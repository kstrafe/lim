(#theorem polynomial-root-evaluate-congruent
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter root Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter coefficient-equation (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring polynomial other-polynomial)))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring polynomial root)
      (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring other-polynomial root)))
  (#proof
    (#pt-app
      (#pt-use ring-transitive ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring polynomial root)
      (#pt-app
        (#pt-use ring-evaluation ())
        Carrier
        coefficient-ring
        Carrier
        coefficient-ring
        (#pt-app (#pt-use polynomial-root-identity-morphism ()) Carrier coefficient-ring)
        root
        polynomial)
      (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring other-polynomial root)
      (#pt-app
        (#pt-use ring-symmetric ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-evaluation ())
          Carrier
          coefficient-ring
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-identity-morphism ()) Carrier coefficient-ring)
          root
          polynomial)
        (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring polynomial root)
        (#pt-app
          (#pt-use polynomial-root-evaluation-bridge ())
          Carrier
          coefficient-ring
          root
          polynomial))
      (#pt-app
        (#pt-use ring-transitive ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-evaluation ())
          Carrier
          coefficient-ring
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-identity-morphism ()) Carrier coefficient-ring)
          root
          polynomial)
        (#pt-app
          (#pt-use ring-evaluation ())
          Carrier
          coefficient-ring
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-identity-morphism ()) Carrier coefficient-ring)
          root
          other-polynomial)
        (#pt-app
          (#pt-use ring-polynomial-evaluate ())
          Carrier
          coefficient-ring
          other-polynomial
          root)
        (#pt-app
          (#pt-use ring-evaluation-congruent ())
          Carrier
          coefficient-ring
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-identity-morphism ()) Carrier coefficient-ring)
          root
          polynomial
          other-polynomial
          coefficient-equation)
        (#pt-app
          (#pt-use polynomial-root-evaluation-bridge ())
          Carrier
          coefficient-ring
          root
          other-polynomial)))))
