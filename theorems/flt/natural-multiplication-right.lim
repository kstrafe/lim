; Direct source-level Nat multiplication laws for the right argument.
; Lean 4.33.1 Init/Data/Nat/Basic.lean: Nat.mul_zero, Nat.mul_one.
; Multiplication recurses on its first argument in this Lim definition.
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias congruence = ./equality.lim::congruence)
(#theorem multiply-zero-right
  (#universes)
  (#parameters
    (#parameter number #pt-nat))
  (#statement (#pt-eq #pt-nat (#pt-app (#pt-use multiply ()) number #pt-zero) #pt-zero))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((ordinal #pt-nat))
        (#pt-eq #pt-nat (#pt-app (#pt-use multiply ()) ordinal #pt-zero) #pt-zero))
      (#pt-refl #pt-nat #pt-zero)
      (#pt-lambda
        (
          (previous #pt-nat)
          (induction-hypothesis
            (#pt-eq #pt-nat (#pt-app (#pt-use multiply ()) previous #pt-zero) #pt-zero)))
        induction-hypothesis)
      number)))
(#theorem multiply-one-right
  (#universes)
  (#parameters
    (#parameter number #pt-nat))
  (#statement (#pt-eq #pt-nat (#pt-app (#pt-use multiply ()) number (#pt-succ #pt-zero)) number))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((ordinal #pt-nat))
        (#pt-eq #pt-nat (#pt-app (#pt-use multiply ()) ordinal (#pt-succ #pt-zero)) ordinal))
      (#pt-refl #pt-nat #pt-zero)
      (#pt-lambda
        (
          (previous #pt-nat)
          (induction-hypothesis
            (#pt-eq #pt-nat (#pt-app (#pt-use multiply ()) previous (#pt-succ #pt-zero)) previous)))
        (#pt-app
          (#pt-use congruence (0 0))
          #pt-nat
          #pt-nat
          (#pt-lambda ((value #pt-nat)) (#pt-succ value))
          (#pt-app (#pt-use multiply ()) previous (#pt-succ #pt-zero))
          previous
          induction-hypothesis))
      number)))
