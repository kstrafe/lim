(#theorem point-evaluation-image-map-congruent
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter Image (#pt-type 0))
    (#parameter image-ring (#pt-app (#pt-use commutative-ring ()) Image))
    (#parameter morphism (#pt-app (#pt-use ring-evaluation-morphism ()) Carrier coefficient-ring Image image-ring))
    (#parameter first-value Carrier)
    (#parameter second-value Carrier)
    (#parameter image-equation (#pt-app (#pt-use ring-equal ()) Carrier (#pt-app (#pt-use point-evaluation-image-ring ()) Carrier coefficient-ring Image image-ring morphism) first-value second-value)))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Image
      image-ring
      (#pt-app
        (#pt-use ring-evaluation-map ())
        Carrier
        coefficient-ring
        Image
        image-ring
        morphism
        first-value)
      (#pt-app
        (#pt-use ring-evaluation-map ())
        Carrier
        coefficient-ring
        Image
        image-ring
        morphism
        second-value)))
  (#proof image-equation))
