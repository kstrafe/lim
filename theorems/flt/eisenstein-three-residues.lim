; Constructive replacement for the three-element quotient argument in
; Cyclotomic/Three.lean:129-151. Every Eisenstein x is0,1or-1modulo lambda.
; The coordinate sum criterion transports the signed integer residue proof.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-lambda = ./eisenstein-defs.lim::eisenstein-lambda)
(#alias eisenstein-add = ./eisenstein-defs.lim::eisenstein-add)
(#alias eisenstein-negate = ./eisenstein-defs.lim::eisenstein-negate)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias integer-one = ./integer-defs.lim::integer-one)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-divides = ./integer-defs.lim::integer-divides)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias
  eisenstein-coordinate-sum
  =
  ./eisenstein-lambda-decision-core.lim::eisenstein-coordinate-sum)
(#alias
  eisenstein-lambda-divides-of-coordinate-sum
  =
  ./eisenstein-lambda-decision-core.lim::eisenstein-lambda-divides-of-coordinate-sum)
(#alias
  integer-divides-congruent-target
  =
  ./integer-divisibility.lim::integer-divides-congruent-target)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias
  integer-has-three-residue-everywhere
  =
  ./integer-three-residues.lim::integer-has-three-residue-everywhere)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-left = ./logical-connectives.lim::disjunction-left)
(#alias disjunction-right = ./logical-connectives.lim::disjunction-right)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias
  eisenstein-cube-scalar-coordinate-plus-one
  =
  ./eisenstein-cube-scalar-coordinate-plus-one.lim::eisenstein-cube-scalar-coordinate-plus-one)
(#alias
  eisenstein-cube-scalar-coordinate-minus-one
  =
  ./eisenstein-cube-scalar-coordinate-minus-one.lim::eisenstein-cube-scalar-coordinate-minus-one)
(#theorem eisenstein-coordinate-sum-plus-one
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app
        (#pt-use eisenstein-coordinate-sum ())
        (#pt-app (#pt-use eisenstein-add ()) number (#pt-use eisenstein-one ())))
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use eisenstein-coordinate-sum ()) number)
        (#pt-use integer-one ()))))
  (#proof
    (#pt-app
      (#pt-use eisenstein-cube-scalar-coordinate-plus-one ())
      (#pt-project eisenstein 0 number)
      (#pt-project eisenstein 1 number))))
(#theorem eisenstein-coordinate-sum-minus-one
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app
        (#pt-use eisenstein-coordinate-sum ())
        (#pt-app
          (#pt-use eisenstein-add ())
          number
          (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))))
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use eisenstein-coordinate-sum ()) number)
        (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ())))))
  (#proof
    (#pt-app
      (#pt-use eisenstein-cube-scalar-coordinate-minus-one ())
      (#pt-project eisenstein 0 number)
      (#pt-project eisenstein 1 number))))
(#theorem eisenstein-lambda-three-residues
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-app
          (#pt-use eisenstein-divides ())
          (#pt-use eisenstein-lambda ())
          (#pt-app
            (#pt-use eisenstein-add ())
            number
            (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))))
        (#pt-app
          (#pt-use eisenstein-divides ())
          (#pt-use eisenstein-lambda ())
          (#pt-app (#pt-use eisenstein-add ()) number (#pt-use eisenstein-one ()))))))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app
        (#pt-use integer-divides ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
        (#pt-app (#pt-use eisenstein-coordinate-sum ()) number))
      (#pt-app
        (#pt-use disjunction ())
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app (#pt-use eisenstein-coordinate-sum ()) number)
            (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app (#pt-use eisenstein-coordinate-sum ()) number)
            (#pt-use integer-one ()))))
      (#pt-app
        (#pt-use disjunction ())
        (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number)
        (#pt-app
          (#pt-use disjunction ())
          (#pt-app
            (#pt-use eisenstein-divides ())
            (#pt-use eisenstein-lambda ())
            (#pt-app
              (#pt-use eisenstein-add ())
              number
              (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))))
          (#pt-app
            (#pt-use eisenstein-divides ())
            (#pt-use eisenstein-lambda ())
            (#pt-app (#pt-use eisenstein-add ()) number (#pt-use eisenstein-one ())))))
      (#pt-lambda
        (
          (zero-residue
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
              (#pt-app (#pt-use eisenstein-coordinate-sum ()) number))))
        (#pt-app
          (#pt-use disjunction-left ())
          (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number)
          (#pt-app
            (#pt-use disjunction ())
            (#pt-app
              (#pt-use eisenstein-divides ())
              (#pt-use eisenstein-lambda ())
              (#pt-app
                (#pt-use eisenstein-add ())
                number
                (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))))
            (#pt-app
              (#pt-use eisenstein-divides ())
              (#pt-use eisenstein-lambda ())
              (#pt-app (#pt-use eisenstein-add ()) number (#pt-use eisenstein-one ()))))
          (#pt-app (#pt-use eisenstein-lambda-divides-of-coordinate-sum ()) number zero-residue)))
      (#pt-lambda
        (
          (nonzero-residue
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app
                (#pt-use integer-divides ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                (#pt-app
                  (#pt-use integer-add ())
                  (#pt-app (#pt-use eisenstein-coordinate-sum ()) number)
                  (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
              (#pt-app
                (#pt-use integer-divides ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                (#pt-app
                  (#pt-use integer-add ())
                  (#pt-app (#pt-use eisenstein-coordinate-sum ()) number)
                  (#pt-use integer-one ()))))))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-app
            (#pt-use integer-divides ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app (#pt-use eisenstein-coordinate-sum ()) number)
              (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
          (#pt-app
            (#pt-use integer-divides ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app (#pt-use eisenstein-coordinate-sum ()) number)
              (#pt-use integer-one ())))
          (#pt-app
            (#pt-use disjunction ())
            (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number)
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app
                (#pt-use eisenstein-divides ())
                (#pt-use eisenstein-lambda ())
                (#pt-app
                  (#pt-use eisenstein-add ())
                  number
                  (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))))
              (#pt-app
                (#pt-use eisenstein-divides ())
                (#pt-use eisenstein-lambda ())
                (#pt-app (#pt-use eisenstein-add ()) number (#pt-use eisenstein-one ())))))
          (#pt-lambda
            (
              (one-residue
                (#pt-app
                  (#pt-use integer-divides ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app
                    (#pt-use integer-add ())
                    (#pt-app (#pt-use eisenstein-coordinate-sum ()) number)
                    (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))))
            (#pt-app
              (#pt-use disjunction-right ())
              (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number)
              (#pt-app
                (#pt-use disjunction ())
                (#pt-app
                  (#pt-use eisenstein-divides ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-app
                    (#pt-use eisenstein-add ())
                    number
                    (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))))
                (#pt-app
                  (#pt-use eisenstein-divides ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-app (#pt-use eisenstein-add ()) number (#pt-use eisenstein-one ()))))
              (#pt-app
                (#pt-use disjunction-left ())
                (#pt-app
                  (#pt-use eisenstein-divides ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-app
                    (#pt-use eisenstein-add ())
                    number
                    (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))))
                (#pt-app
                  (#pt-use eisenstein-divides ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-app (#pt-use eisenstein-add ()) number (#pt-use eisenstein-one ())))
                (#pt-app
                  (#pt-use eisenstein-lambda-divides-of-coordinate-sum ())
                  (#pt-app
                    (#pt-use eisenstein-add ())
                    number
                    (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ())))
                  (#pt-app
                    (#pt-use integer-divides-congruent-target ())
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                    (#pt-app
                      (#pt-use integer-add ())
                      (#pt-app (#pt-use eisenstein-coordinate-sum ()) number)
                      (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ())))
                    (#pt-app
                      (#pt-use eisenstein-coordinate-sum ())
                      (#pt-app
                        (#pt-use eisenstein-add ())
                        number
                        (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))))
                    (#pt-app
                      (#pt-use integer-symmetric ())
                      (#pt-app
                        (#pt-use eisenstein-coordinate-sum ())
                        (#pt-app
                          (#pt-use eisenstein-add ())
                          number
                          (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))))
                      (#pt-app
                        (#pt-use integer-add ())
                        (#pt-app (#pt-use eisenstein-coordinate-sum ()) number)
                        (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ())))
                      (#pt-app (#pt-use eisenstein-coordinate-sum-minus-one ()) number))
                    one-residue)))))
          (#pt-lambda
            (
              (negative-one-residue
                (#pt-app
                  (#pt-use integer-divides ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app
                    (#pt-use integer-add ())
                    (#pt-app (#pt-use eisenstein-coordinate-sum ()) number)
                    (#pt-use integer-one ())))))
            (#pt-app
              (#pt-use disjunction-right ())
              (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number)
              (#pt-app
                (#pt-use disjunction ())
                (#pt-app
                  (#pt-use eisenstein-divides ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-app
                    (#pt-use eisenstein-add ())
                    number
                    (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))))
                (#pt-app
                  (#pt-use eisenstein-divides ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-app (#pt-use eisenstein-add ()) number (#pt-use eisenstein-one ()))))
              (#pt-app
                (#pt-use disjunction-right ())
                (#pt-app
                  (#pt-use eisenstein-divides ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-app
                    (#pt-use eisenstein-add ())
                    number
                    (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))))
                (#pt-app
                  (#pt-use eisenstein-divides ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-app (#pt-use eisenstein-add ()) number (#pt-use eisenstein-one ())))
                (#pt-app
                  (#pt-use eisenstein-lambda-divides-of-coordinate-sum ())
                  (#pt-app (#pt-use eisenstein-add ()) number (#pt-use eisenstein-one ()))
                  (#pt-app
                    (#pt-use integer-divides-congruent-target ())
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                    (#pt-app
                      (#pt-use integer-add ())
                      (#pt-app (#pt-use eisenstein-coordinate-sum ()) number)
                      (#pt-use integer-one ()))
                    (#pt-app
                      (#pt-use eisenstein-coordinate-sum ())
                      (#pt-app (#pt-use eisenstein-add ()) number (#pt-use eisenstein-one ())))
                    (#pt-app
                      (#pt-use integer-symmetric ())
                      (#pt-app
                        (#pt-use eisenstein-coordinate-sum ())
                        (#pt-app (#pt-use eisenstein-add ()) number (#pt-use eisenstein-one ())))
                      (#pt-app
                        (#pt-use integer-add ())
                        (#pt-app (#pt-use eisenstein-coordinate-sum ()) number)
                        (#pt-use integer-one ()))
                      (#pt-app (#pt-use eisenstein-coordinate-sum-plus-one ()) number))
                    negative-one-residue)))))
          nonzero-residue))
      (#pt-app
        (#pt-use integer-has-three-residue-everywhere ())
        (#pt-app (#pt-use eisenstein-coordinate-sum ()) number)))))
(#theorem eisenstein-lambda-nondivisible-residue-cases
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter lambda-not-divides (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app
        (#pt-use eisenstein-divides ())
        (#pt-use eisenstein-lambda ())
        (#pt-app
          (#pt-use eisenstein-add ())
          number
          (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))))
      (#pt-app
        (#pt-use eisenstein-divides ())
        (#pt-use eisenstein-lambda ())
        (#pt-app (#pt-use eisenstein-add ()) number (#pt-use eisenstein-one ())))))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-app
          (#pt-use eisenstein-divides ())
          (#pt-use eisenstein-lambda ())
          (#pt-app
            (#pt-use eisenstein-add ())
            number
            (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))))
        (#pt-app
          (#pt-use eisenstein-divides ())
          (#pt-use eisenstein-lambda ())
          (#pt-app (#pt-use eisenstein-add ()) number (#pt-use eisenstein-one ()))))
      (#pt-app
        (#pt-use disjunction ())
        (#pt-app
          (#pt-use eisenstein-divides ())
          (#pt-use eisenstein-lambda ())
          (#pt-app
            (#pt-use eisenstein-add ())
            number
            (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))))
        (#pt-app
          (#pt-use eisenstein-divides ())
          (#pt-use eisenstein-lambda ())
          (#pt-app (#pt-use eisenstein-add ()) number (#pt-use eisenstein-one ()))))
      (#pt-lambda
        (
          (lambda-divides
            (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number)))
        (#pt-app
          (#pt-use false-elimination ())
          (#pt-app
            (#pt-use disjunction ())
            (#pt-app
              (#pt-use eisenstein-divides ())
              (#pt-use eisenstein-lambda ())
              (#pt-app
                (#pt-use eisenstein-add ())
                number
                (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))))
            (#pt-app
              (#pt-use eisenstein-divides ())
              (#pt-use eisenstein-lambda ())
              (#pt-app (#pt-use eisenstein-add ()) number (#pt-use eisenstein-one ()))))
          (#pt-app lambda-not-divides lambda-divides)))
      (#pt-lambda
        (
          (remaining-cases
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app
                (#pt-use eisenstein-divides ())
                (#pt-use eisenstein-lambda ())
                (#pt-app
                  (#pt-use eisenstein-add ())
                  number
                  (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))))
              (#pt-app
                (#pt-use eisenstein-divides ())
                (#pt-use eisenstein-lambda ())
                (#pt-app (#pt-use eisenstein-add ()) number (#pt-use eisenstein-one ()))))))
        remaining-cases)
      (#pt-app (#pt-use eisenstein-lambda-three-residues ()) number))))
