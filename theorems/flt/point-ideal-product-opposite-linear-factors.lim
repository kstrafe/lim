              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))))
      (#pt-app
        (#pt-use point-ideal-product-opposite-constant-identity ())
        Carrier
        coefficient-ring
        linear-coefficient
        constant-coefficient
        ordinate)
      (#pt-app
        (#pt-use point-ideal-product-opposite-linear-identity ())
        Carrier
        coefficient-ring
        linear-coefficient
        constant-coefficient
