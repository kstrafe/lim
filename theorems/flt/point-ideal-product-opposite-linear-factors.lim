; Generated by scripts/generate-flt-point-ideal-products.py; checked native terms.
; Actual (Y+alpha+y)*(Y-y)
; equals the embedded beta-alpha*y-y^2 in the actual
; quadratic algebra. Both coefficients are proved from the
; universal scalar identities, not a desired norm equation.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias
  point-ideal-product-opposite-constant-identity
  =
  ./point-ideal-product-opposite-constant-identity.lim::point-ideal-product-opposite-constant-identity)
(#alias
  point-ideal-product-opposite-linear-identity
  =
  ./point-ideal-product-opposite-linear-identity.lim::point-ideal-product-opposite-linear-identity)
(#alias quadratic-element = ./quadratic-algebra-data.lim::quadratic-element)
(#alias quadratic-equal = ./quadratic-algebra-data.lim::quadratic-equal)
(#alias quadratic-multiply = ./quadratic-algebra-data.lim::quadratic-multiply)
(#alias ring-add = ./commutative-ring-data.lim::ring-add)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-negate = ./commutative-ring-data.lim::ring-negate)
(#alias ring-one = ./commutative-ring-data.lim::ring-one)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#theorem point-ideal-product-opposite-linear-factors
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter linear-coefficient Carrier)
    (#parameter constant-coefficient Carrier)
    (#parameter ordinate Carrier))
  (#statement
    (#pt-app
      (#pt-use quadratic-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use quadratic-multiply ())
        Carrier
        coefficient-ring
        linear-coefficient
        constant-coefficient
        (#pt-construct
          quadratic-element
          ()
          (Carrier)
          coordinates
          (
            (#pt-app (#pt-use ring-add ()) Carrier coefficient-ring linear-coefficient ordinate)
            (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)))
        (#pt-construct
          quadratic-element
          ()
          (Carrier)
          coordinates
          (
            (#pt-app (#pt-use ring-negate ()) Carrier coefficient-ring ordinate)
            (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring))))
      (#pt-construct
        quadratic-element
        ()
        (Carrier)
        coordinates
        (
          (#pt-app
            (#pt-use ring-add ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-add ())
              Carrier
              coefficient-ring
              constant-coefficient
              (#pt-app
                (#pt-use ring-negate ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-multiply ())
                  Carrier
                  coefficient-ring
                  linear-coefficient
                  ordinate)))
            (#pt-app
              (#pt-use ring-negate ())
              Carrier
              coefficient-ring
              (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring ordinate ordinate)))
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-equal ())
        Carrier
        coefficient-ring
        (#pt-project
          quadratic-element
          0
          (#pt-app
            (#pt-use quadratic-multiply ())
            Carrier
            coefficient-ring
            linear-coefficient
            constant-coefficient
            (#pt-construct
              quadratic-element
              ()
              (Carrier)
              coordinates
              (
                (#pt-app (#pt-use ring-add ()) Carrier coefficient-ring linear-coefficient ordinate)
                (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)))
            (#pt-construct
              quadratic-element
              ()
              (Carrier)
              coordinates
              (
                (#pt-app (#pt-use ring-negate ()) Carrier coefficient-ring ordinate)
                (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)))))
        (#pt-project
          quadratic-element
          0
          (#pt-construct
            quadratic-element
            ()
            (Carrier)
            coordinates
            (
              (#pt-app
                (#pt-use ring-add ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-add ())
                  Carrier
                  coefficient-ring
                  constant-coefficient
                  (#pt-app
                    (#pt-use ring-negate ())
                    Carrier
                    coefficient-ring
                    (#pt-app
                      (#pt-use ring-multiply ())
                      Carrier
                      coefficient-ring
                      linear-coefficient
                      ordinate)))
                (#pt-app
                  (#pt-use ring-negate ())
                  Carrier
                  coefficient-ring
                  (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring ordinate ordinate)))
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))))
      (#pt-app
        (#pt-use ring-equal ())
        Carrier
        coefficient-ring
        (#pt-project
          quadratic-element
          1
          (#pt-app
            (#pt-use quadratic-multiply ())
            Carrier
            coefficient-ring
            linear-coefficient
            constant-coefficient
            (#pt-construct
              quadratic-element
              ()
              (Carrier)
              coordinates
              (
                (#pt-app (#pt-use ring-add ()) Carrier coefficient-ring linear-coefficient ordinate)
                (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)))
            (#pt-construct
              quadratic-element
              ()
              (Carrier)
              coordinates
              (
                (#pt-app (#pt-use ring-negate ()) Carrier coefficient-ring ordinate)
                (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)))))
        (#pt-project
          quadratic-element
          1
          (#pt-construct
            quadratic-element
            ()
            (Carrier)
            coordinates
            (
              (#pt-app
                (#pt-use ring-add ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-add ())
                  Carrier
                  coefficient-ring
