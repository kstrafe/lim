(#theorem eisenstein-omega-not-one
  (#universes)
  (#parameters)
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-use eisenstein-omega ())
            (#pt-use eisenstein-one ()))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (forbidden-equivalence
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-use eisenstein-omega ())
            (#pt-use eisenstein-one ()))))
      (#pt-app
        (#pt-app (#pt-use successor-not-zero ()) #pt-zero)
        (#pt-app
          (#pt-use integer-of-natural-injective ())
          (#pt-succ #pt-zero)
          #pt-zero
          (#pt-app
            (#pt-use conjunction-right ())
            (#pt-app
              (#pt-use integer-equal ())
              (#pt-project eisenstein 0 (#pt-use eisenstein-omega ()))
              (#pt-project eisenstein 0 (#pt-use eisenstein-one ())))
            (#pt-app
              (#pt-use integer-equal ())
              (#pt-project eisenstein 1 (#pt-use eisenstein-omega ()))
              (#pt-project eisenstein 1 (#pt-use eisenstein-one ())))
            forbidden-equivalence))))))
