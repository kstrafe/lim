(#theorem eisenstein-lambda-divides-three
  (#universes)
  (#parameters)
  (#statement
    (#pt-app
      (#pt-use eisenstein-divides ())
      (#pt-use eisenstein-lambda ())
      (#pt-app
        (#pt-use eisenstein-of-integer ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)))))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app
              (#pt-use eisenstein-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)))
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-use eisenstein-lambda ())
              candidate-factor))))
      introduce
      (
        (#pt-construct
          eisenstein
          ()
          ()
          pair
          (
            (#pt-app
              (#pt-use integer-negate ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
            (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
        (#pt-app
          (#pt-use conjunction-introduce ())
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-project
              eisenstein
              0
              (#pt-app
                (#pt-use eisenstein-of-integer ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))))
            (#pt-project
              eisenstein
              0
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-use eisenstein-lambda ())
                (#pt-construct
                  eisenstein
                  ()
                  ()
                  pair
                  (
                    (#pt-app
                      (#pt-use integer-negate ())
                      (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
                    (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ())))))))
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-project
              eisenstein
              1
              (#pt-app
                (#pt-use eisenstein-of-integer ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))))
            (#pt-project
              eisenstein
              1
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-use eisenstein-lambda ())
                (#pt-construct
                  eisenstein
                  ()
                  ()
                  pair
                  (
                    (#pt-app
                      (#pt-use integer-negate ())
                      (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
                    (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ())))))))
          (#pt-refl #pt-nat (#pt-numeral 3))
          (#pt-refl #pt-nat (#pt-numeral 2)))))))
