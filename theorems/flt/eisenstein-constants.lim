(#theorem eisenstein-omega-polynomial
  (#universes)
  (#parameters)
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-omega ()) (#pt-numeral 2))
          (#pt-use eisenstein-omega ()))
        (#pt-use eisenstein-one ()))
      (#pt-use eisenstein-zero ())))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project
          eisenstein
          0
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-omega ()) (#pt-numeral 2))
              (#pt-use eisenstein-omega ()))
            (#pt-use eisenstein-one ())))
        (#pt-project eisenstein 0 (#pt-use eisenstein-zero ())))
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project
          eisenstein
          1
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-omega ()) (#pt-numeral 2))
              (#pt-use eisenstein-omega ()))
            (#pt-use eisenstein-one ())))
        (#pt-project eisenstein 1 (#pt-use eisenstein-zero ())))
      (#pt-refl #pt-nat (#pt-numeral 1))
      (#pt-refl #pt-nat (#pt-numeral 1)))))
