; Prime factor removal for the associated-cube argument in FLT/Three.lean:567-578.
; Actual prime, divisor, coprime and inverse certificates are retained.
; Power divisibility uses Nat induction and rejects the unit zeroth power.
; The final theorem proves the root divisor, not complete cube extraction.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-power = ./eisenstein-defs.lim::eisenstein-power)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias eisenstein-unit = ./eisenstein-defs.lim::eisenstein-unit)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias
  eisenstein-divides-congruent-target
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-congruent-target)
(#alias
  eisenstein-divides-product-left
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-product-left)
(#alias
  eisenstein-unit-of-divides-one
  =
  ./eisenstein-unit-divisibility.lim::eisenstein-unit-of-divides-one)
(#alias
  eisenstein-divisor-of-unit-is-unit
  =
  ./eisenstein-unit-divisibility.lim::eisenstein-divisor-of-unit-is-unit)
(#alias eisenstein-coprime = ./eisenstein-defs.lim::eisenstein-coprime)
(#alias eisenstein-prime = ./eisenstein-lambda-prime.lim::eisenstein-prime)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#alias
  eisenstein-coprime-common-divisor-unit
  =
  ./eisenstein-coprime-factors.lim::eisenstein-coprime-common-divisor-unit)
(#alias
  eisenstein-coprime-of-common-divisors-unit
  =
  ./eisenstein-coprime-factors.lim::eisenstein-coprime-of-common-divisors-unit)
(#alias
  eisenstein-divides-transitive
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-transitive)
(#theorem eisenstein-prime-nonzero
  (#universes)
  (#parameters
    (#parameter prime (#pt-use eisenstein ()))
    (#parameter prime-certificate (#pt-app (#pt-use eisenstein-prime ()) prime)))
  (#statement
    (#pt-pi
      ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) prime (#pt-use eisenstein-zero ()))))
      #pt-false))
  (#proof
    (#pt-app
      (#pt-use conjunction-left ())
      (#pt-pi
        ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) prime (#pt-use eisenstein-zero ()))))
        #pt-false)
      (#pt-app
        (#pt-use conjunction ())
        (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) prime))) #pt-false)
        (#pt-pi
          (
            (candidate-first (#pt-use eisenstein ()))
            (candidate-second (#pt-use eisenstein ()))
            (product-evidence
              (#pt-app
                (#pt-use eisenstein-divides ())
                prime
                (#pt-app (#pt-use eisenstein-multiply ()) candidate-first candidate-second))))
          (#pt-app
            (#pt-use disjunction ())
            (#pt-app (#pt-use eisenstein-divides ()) prime candidate-first)
            (#pt-app (#pt-use eisenstein-divides ()) prime candidate-second))))
      prime-certificate)))
(#theorem eisenstein-prime-nonunit
  (#universes)
  (#parameters
    (#parameter prime (#pt-use eisenstein ()))
    (#parameter prime-certificate (#pt-app (#pt-use eisenstein-prime ()) prime)))
  (#statement (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) prime))) #pt-false))
  (#proof
    (#pt-app
      (#pt-use conjunction-left ())
      (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) prime))) #pt-false)
      (#pt-pi
        (
          (candidate-first (#pt-use eisenstein ()))
          (candidate-second (#pt-use eisenstein ()))
          (product-evidence
            (#pt-app
              (#pt-use eisenstein-divides ())
              prime
              (#pt-app (#pt-use eisenstein-multiply ()) candidate-first candidate-second))))
        (#pt-app
          (#pt-use disjunction ())
          (#pt-app (#pt-use eisenstein-divides ()) prime candidate-first)
          (#pt-app (#pt-use eisenstein-divides ()) prime candidate-second)))
      (#pt-app
        (#pt-use conjunction-right ())
        (#pt-pi
          (
            (denied-proof
              (#pt-app (#pt-use eisenstein-equal ()) prime (#pt-use eisenstein-zero ()))))
          #pt-false)
        (#pt-app
          (#pt-use conjunction ())
          (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) prime))) #pt-false)
          (#pt-pi
            (
              (candidate-first (#pt-use eisenstein ()))
              (candidate-second (#pt-use eisenstein ()))
              (product-evidence
                (#pt-app
                  (#pt-use eisenstein-divides ())
                  prime
                  (#pt-app (#pt-use eisenstein-multiply ()) candidate-first candidate-second))))
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app (#pt-use eisenstein-divides ()) prime candidate-first)
              (#pt-app (#pt-use eisenstein-divides ()) prime candidate-second))))
        prime-certificate))))
(#theorem eisenstein-prime-divides-product
  (#universes)
  (#parameters
    (#parameter prime (#pt-use eisenstein ()))
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter prime-certificate (#pt-app (#pt-use eisenstein-prime ()) prime))
    (#parameter product-divides (#pt-app (#pt-use eisenstein-divides ()) prime (#pt-app (#pt-use eisenstein-multiply ()) first second))))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app (#pt-use eisenstein-divides ()) prime first)
      (#pt-app (#pt-use eisenstein-divides ()) prime second)))
  (#proof
    (#pt-app
      (#pt-app
        (#pt-use conjunction-right ())
        (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) prime))) #pt-false)
        (#pt-pi
          (
            (candidate-first (#pt-use eisenstein ()))
            (candidate-second (#pt-use eisenstein ()))
            (product-evidence
              (#pt-app
                (#pt-use eisenstein-divides ())
                prime
                (#pt-app (#pt-use eisenstein-multiply ()) candidate-first candidate-second))))
          (#pt-app
            (#pt-use disjunction ())
            (#pt-app (#pt-use eisenstein-divides ()) prime candidate-first)
            (#pt-app (#pt-use eisenstein-divides ()) prime candidate-second)))
        (#pt-app
          (#pt-use conjunction-right ())
          (#pt-pi
            (
              (denied-proof
                (#pt-app (#pt-use eisenstein-equal ()) prime (#pt-use eisenstein-zero ()))))
            #pt-false)
          (#pt-app
            (#pt-use conjunction ())
            (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) prime))) #pt-false)
            (#pt-pi
              (
                (candidate-first (#pt-use eisenstein ()))
                (candidate-second (#pt-use eisenstein ()))
                (product-evidence
                  (#pt-app
                    (#pt-use eisenstein-divides ())
                    prime
                    (#pt-app (#pt-use eisenstein-multiply ()) candidate-first candidate-second))))
              (#pt-app
                (#pt-use disjunction ())
                (#pt-app (#pt-use eisenstein-divides ()) prime candidate-first)
                (#pt-app (#pt-use eisenstein-divides ()) prime candidate-second))))
          prime-certificate))
      first
      second
      product-divides)))
(#theorem eisenstein-prime-divides-power
  (#universes)
  (#parameters
    (#parameter prime (#pt-use eisenstein ()))
    (#parameter first (#pt-use eisenstein ()))
    (#parameter exponent #pt-nat)
    (#parameter prime-certificate (#pt-app (#pt-use eisenstein-prime ()) prime))
    (#parameter given-power-divides (#pt-app (#pt-use eisenstein-divides ()) prime (#pt-app (#pt-use eisenstein-power ()) first exponent))))
  (#statement (#pt-app (#pt-use eisenstein-divides ()) prime first))
  (#proof
    (#pt-app
      (#pt-nat-induct
        (#pt-lambda
          ((index #pt-nat))
          (#pt-pi
            (
              (power-divides
                (#pt-app
                  (#pt-use eisenstein-divides ())
                  prime
                  (#pt-app (#pt-use eisenstein-power ()) first index))))
            (#pt-app (#pt-use eisenstein-divides ()) prime first)))
        (#pt-lambda
          (
            (zeroth-power-divides
              (#pt-app
                (#pt-use eisenstein-divides ())
                prime
                (#pt-app (#pt-use eisenstein-power ()) first #pt-zero))))
          (#pt-app
            (#pt-use false-elimination ())
            (#pt-app (#pt-use eisenstein-divides ()) prime first)
            (#pt-app
              (#pt-app (#pt-use eisenstein-prime-nonunit ()) prime prime-certificate)
              (#pt-app (#pt-use eisenstein-unit-of-divides-one ()) prime zeroth-power-divides))))
        (#pt-lambda
          (
            (previous #pt-nat)
            (induction-hypothesis
              (#pt-pi
                (
                  (power-divides
                    (#pt-app
                      (#pt-use eisenstein-divides ())
                      prime
                      (#pt-app (#pt-use eisenstein-power ()) first previous))))
                (#pt-app (#pt-use eisenstein-divides ()) prime first)))
            (successor-power-divides
              (#pt-app
                (#pt-use eisenstein-divides ())
                prime
                (#pt-app (#pt-use eisenstein-power ()) first (#pt-succ previous)))))
          (#pt-app
            (#pt-use disjunction-eliminate ())
            (#pt-app (#pt-use eisenstein-divides ()) prime first)
            (#pt-app
              (#pt-use eisenstein-divides ())
              prime
              (#pt-app (#pt-use eisenstein-power ()) first previous))
            (#pt-app (#pt-use eisenstein-divides ()) prime first)
            (#pt-lambda
              ((base-divides (#pt-app (#pt-use eisenstein-divides ()) prime first)))
              base-divides)
            (#pt-lambda
              (
                (previous-power-divides
                  (#pt-app
                    (#pt-use eisenstein-divides ())
                    prime
                    (#pt-app (#pt-use eisenstein-power ()) first previous))))
              (#pt-app induction-hypothesis previous-power-divides))
            (#pt-app
              (#pt-use eisenstein-prime-divides-product ())
              prime
              first
              (#pt-app (#pt-use eisenstein-power ()) first previous)
              prime-certificate
              successor-power-divides)))
        exponent)
      given-power-divides)))
(#theorem eisenstein-coprime-divisor-left
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter coprime-certificate (#pt-app (#pt-use eisenstein-coprime ()) first second))
    (#parameter divisor-certificate (#pt-app (#pt-use eisenstein-divides ()) divisor first)))
  (#statement (#pt-app (#pt-use eisenstein-coprime ()) divisor second))
  (#proof
    (#pt-app
      (#pt-use eisenstein-coprime-of-common-divisors-unit ())
      divisor
      second
      (#pt-lambda
        (
          (common-divisor (#pt-use eisenstein ()))
          (divides-divisor (#pt-app (#pt-use eisenstein-divides ()) common-divisor divisor))
          (divides-second (#pt-app (#pt-use eisenstein-divides ()) common-divisor second)))
        (#pt-app
          (#pt-use eisenstein-coprime-common-divisor-unit ())
          first
          second
          common-divisor
          coprime-certificate
          (#pt-app
            (#pt-use eisenstein-divides-transitive ())
            common-divisor
            divisor
            first
            divides-divisor
            divisor-certificate)
          divides-second)))))
(#theorem eisenstein-prime-divisor-excludes-coprime-factor
  (#universes)
  (#parameters
    (#parameter prime (#pt-use eisenstein ()))
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter prime-certificate (#pt-app (#pt-use eisenstein-prime ()) prime))
    (#parameter coprime-certificate (#pt-app (#pt-use eisenstein-coprime ()) first second))
    (#parameter divides-first (#pt-app (#pt-use eisenstein-divides ()) prime first)))
  (#statement
    (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) prime second))) #pt-false))
  (#proof
    (#pt-lambda
      ((divides-second (#pt-app (#pt-use eisenstein-divides ()) prime second)))
      (#pt-app
        (#pt-app (#pt-use eisenstein-prime-nonunit ()) prime prime-certificate)
        (#pt-app
          (#pt-use eisenstein-coprime-common-divisor-unit ())
          first
          second
          prime
          coprime-certificate
          divides-first
          divides-second)))))
(#theorem eisenstein-prime-divides-unit-cube-root
  (#universes)
  (#parameters
    (#parameter prime (#pt-use eisenstein ()))
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter root (#pt-use eisenstein ()))
    (#parameter prime-certificate (#pt-app (#pt-use eisenstein-prime ()) prime))
    (#parameter unit-certificate (#pt-app (#pt-use eisenstein-unit ()) unit))
    (#parameter product-equation (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-multiply ()) first second) (#pt-app (#pt-use eisenstein-multiply ()) unit (#pt-app (#pt-use eisenstein-power ()) root (#pt-numeral 3)))))
    (#parameter divides-first (#pt-app (#pt-use eisenstein-divides ()) prime first)))
  (#statement (#pt-app (#pt-use eisenstein-divides ()) prime root))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use eisenstein-divides ()) prime unit)
      (#pt-app
        (#pt-use eisenstein-divides ())
        prime
        (#pt-app (#pt-use eisenstein-power ()) root (#pt-numeral 3)))
      (#pt-app (#pt-use eisenstein-divides ()) prime root)
      (#pt-lambda
        ((divides-unit (#pt-app (#pt-use eisenstein-divides ()) prime unit)))
        (#pt-app
          (#pt-use false-elimination ())
          (#pt-app (#pt-use eisenstein-divides ()) prime root)
          (#pt-app
            (#pt-app (#pt-use eisenstein-prime-nonunit ()) prime prime-certificate)
            (#pt-app
              (#pt-use eisenstein-divisor-of-unit-is-unit ())
              prime
              unit
              unit-certificate
              divides-unit))))
      (#pt-lambda
        (
          (divides-cube
            (#pt-app
              (#pt-use eisenstein-divides ())
              prime
              (#pt-app (#pt-use eisenstein-power ()) root (#pt-numeral 3)))))
        (#pt-app
          (#pt-use eisenstein-prime-divides-power ())
          prime
          root
          (#pt-numeral 3)
          prime-certificate
          divides-cube))
      (#pt-app
        (#pt-use eisenstein-prime-divides-product ())
        prime
        unit
        (#pt-app (#pt-use eisenstein-power ()) root (#pt-numeral 3))
        prime-certificate
        (#pt-app
          (#pt-use eisenstein-divides-congruent-target ())
          prime
          (#pt-app (#pt-use eisenstein-multiply ()) first second)
          (#pt-app
            (#pt-use eisenstein-multiply ())
            unit
            (#pt-app (#pt-use eisenstein-power ()) root (#pt-numeral 3)))
          product-equation
          (#pt-app (#pt-use eisenstein-divides-product-left ()) prime first second divides-first))))))
