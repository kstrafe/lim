; Adapted source: pinned Mathlib Affine/Point.lean:409-470.
; All polynomial, coefficient-domain and index facts are proved.
; Generated by scripts/generate-flt-norm-degrees.py; checked native terms.
; Prove the source degree/natDegree(norm)!=1 results
; for arbitrary actual coordinate elements. The positive natDegree
; bridge handles zero soundly. Only the computed natDegree function
; takes the actual coefficient zero decider; degree exclusion is generic.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias
  coordinate-norm-degree-not-one
  =
  ./coordinate-norm-degree-exclusion.lim::coordinate-norm-degree-not-one)
(#alias
  coordinate-norm-degree-value
  =
  ./coordinate-norm-degree-formula.lim::coordinate-norm-degree-value)
(#alias decision = ./logical-decision.lim::decision)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias quadratic-element = ./quadratic-algebra-data.lim::quadratic-element)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias
  ring-polynomial-degree-compute
  =
  ./ring-polynomial-degree-computation.lim::ring-polynomial-degree-compute)
(#alias
  ring-polynomial-degree-natural
  =
  ./ring-polynomial-degree-computation.lim::ring-polynomial-degree-natural)
(#alias
  ring-polynomial-degree-positive-natural-bridge
  =
  ./ring-polynomial-degree-positive-bridge.lim::ring-polynomial-degree-positive-natural-bridge)
(#alias
  ring-polynomial-degree-witness
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-degree-witness)
(#alias
  ring-polynomial-domain-data
  =
  ./ring-polynomial-domain-data.lim::ring-polynomial-domain-data)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#alias
  weierstrass-coordinate-norm
  =
  ./weierstrass-coordinate-normal-form.lim::weierstrass-coordinate-norm)
(#alias zero-less-successor = ./natural-discrete-order.lim::zero-less-successor)
(#theorem coordinate-norm-degree-natural-not-one
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter zero-decider (#pt-pi ((coefficient Carrier)) (#pt-app (#pt-use decision ()) (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring coefficient (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
  (#statement
    (#pt-pi
      (
        (denied-evidence
          (#pt-eq
            #pt-nat
            (#pt-app
              (#pt-use ring-polynomial-degree-natural ())
              Carrier
              coefficient-ring
              zero-decider
              (#pt-app
                (#pt-use coordinate-norm-degree-value ())
                Carrier
                coefficient-ring
                a1
                a2
                a3
                a4
                a6
                polynomial
                other-polynomial))
            (#pt-numeral 1))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (natural-degree-one
          (#pt-eq
            #pt-nat
            (#pt-app
              (#pt-use ring-polynomial-degree-natural ())
              Carrier
              coefficient-ring
              zero-decider
              (#pt-app
                (#pt-use coordinate-norm-degree-value ())
                Carrier
                coefficient-ring
                a1
                a2
                a3
                a4
                a6
                polynomial
                other-polynomial))
            (#pt-numeral 1))))
      (#pt-app
        (#pt-app
          (#pt-use coordinate-norm-degree-not-one ())
          Carrier
          coefficient-ring
          coefficient-domain
          a1
          a2
          a3
          a4
          a6
          polynomial
          other-polynomial)
        (#pt-app
          (#pt-use ring-polynomial-degree-positive-natural-bridge ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use coordinate-norm-degree-value ())
            Carrier
            coefficient-ring
            a1
            a2
            a3
            a4
            a6
            polynomial
            other-polynomial)
          (#pt-app
            (#pt-use ring-polynomial-degree-compute ())
            Carrier
            coefficient-ring
            zero-decider
            (#pt-app
              (#pt-use coordinate-norm-degree-value ())
              Carrier
              coefficient-ring
              a1
              a2
              a3
              a4
              a6
              polynomial
              other-polynomial))
          (#pt-numeral 1)
          (#pt-app (#pt-use zero-less-successor ()) #pt-zero)
          natural-degree-one)))))
(#theorem coordinate-norm-degree-element-not-one
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter coordinate-element (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))))
  (#statement
    (#pt-pi
      (
        (denied-evidence
          (#pt-app
            (#pt-use ring-polynomial-degree-witness ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use weierstrass-coordinate-norm ())
              Carrier
              coefficient-ring
              a1
              a2
              a3
              a4
              a6
              coordinate-element)
            (#pt-numeral 1))))
      #pt-false))
  (#proof
    (#pt-app
      (#pt-use coordinate-norm-degree-not-one ())
      Carrier
      coefficient-ring
      coefficient-domain
      a1
      a2
      a3
      a4
      a6
      (#pt-project quadratic-element 0 coordinate-element)
      (#pt-project quadratic-element 1 coordinate-element))))
