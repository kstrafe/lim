; Adapted source: pinned Mathlib Affine/Point.lean:409-470.
; All polynomial, coefficient-domain and index facts are proved.
; Generated by scripts/generate-flt-norm-degrees.py; checked native terms.
; A proved natural gap equation weakens an actual
; support bound to the exact desired index. No hidden inequality
; conversion or polynomial leading-degree fact is assumed.
(#alias add = ./../fermat_statement.lim::add)
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias
  ring-polynomial-support-from
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-support-from)
(#alias
  ring-polynomial-support-weaken
  =
  ./ring-polynomial-support-transport.lim::ring-polynomial-support-weaken)
(#alias substitution = ./equality.lim::substitution)
(#alias symmetry = ./equality.lim::symmetry)
(#theorem coordinate-norm-degree-weaken-support
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter original-bound #pt-nat)
    (#parameter gap #pt-nat)
    (#parameter desired-bound #pt-nat)
    (#parameter support (#pt-app (#pt-use ring-polynomial-support-from ()) Carrier coefficient-ring polynomial original-bound))
    (#parameter bound-equation (#pt-eq #pt-nat desired-bound (#pt-app (#pt-use add ()) original-bound gap))))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-support-from ())
      Carrier
      coefficient-ring
      polynomial
      desired-bound))
  (#proof
    (#pt-app
      (#pt-use substitution (0))
      #pt-nat
      (#pt-lambda
        ((selected-bound #pt-nat))
        (#pt-app
          (#pt-use ring-polynomial-support-from ())
          Carrier
          coefficient-ring
          polynomial
          selected-bound))
      (#pt-app (#pt-use add ()) original-bound gap)
      desired-bound
      (#pt-app
        (#pt-use symmetry (0))
        #pt-nat
        desired-bound
        (#pt-app (#pt-use add ()) original-bound gap)
        bound-equation)
      (#pt-app
        (#pt-use ring-polynomial-support-weaken ())
        Carrier
        coefficient-ring
        polynomial
        original-bound
        gap
        support))))
