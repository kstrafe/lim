; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Prove both inclusions into an ideal sum and its
; least-upper-bound property by explicit witness elimination.
; Sum commutativity follows from that proved universal property.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias exists = ./logic-exists.lim::exists)
(#alias ring-add = ./commutative-ring-data.lim::ring-add)
(#alias ring-add-zero = ./commutative-ring-data.lim::ring-add-zero)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-ideal = ./ring-ideal-data.lim::ring-ideal)
(#alias ring-ideal-add = ./ring-ideal-data.lim::ring-ideal-add)
(#alias ring-ideal-equal = ./ring-ideal-data.lim::ring-ideal-equal)
(#alias ring-ideal-member = ./ring-ideal-data.lim::ring-ideal-member)
(#alias ring-ideal-member-congruent = ./ring-ideal-data.lim::ring-ideal-member-congruent)
(#alias ring-ideal-subset = ./ring-ideal-data.lim::ring-ideal-subset)
(#alias ring-ideal-sum = ./ring-ideal-sum.lim::ring-ideal-sum)
(#alias ring-ideal-sum-member = ./ring-ideal-sum.lim::ring-ideal-sum-member)
(#alias ring-ideal-zero = ./ring-ideal-data.lim::ring-ideal-zero)
(#alias ring-symmetric = ./commutative-ring-data.lim::ring-symmetric)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#alias ring-zero-add = ./commutative-ring-elementary-laws.lim::ring-zero-add)
(#theorem ring-ideal-sum-left
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      first-ideal
      (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)))
  (#proof
    (#pt-lambda
      (
        (element Carrier)
        (member
          (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring first-ideal element)))
      (#pt-construct
        exists
        (0)
        (Carrier
          (#pt-lambda
            ((sum-left Carrier))
            (#pt-app
              (#pt-use exists (0))
              Carrier
              (#pt-lambda
                ((sum-right Carrier))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use ring-ideal-member ())
                    Carrier
                    coefficient-ring
                    first-ideal
                    sum-left)
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app
                      (#pt-use ring-ideal-member ())
                      Carrier
                      coefficient-ring
                      second-ideal
                      sum-right)
                    (#pt-app
                      (#pt-use ring-equal ())
                      Carrier
                      coefficient-ring
                      element
                      (#pt-app (#pt-use ring-add ()) Carrier coefficient-ring sum-left sum-right))))))))
        introduce
        (element
          (#pt-construct
            exists
            (0)
            (Carrier
              (#pt-lambda
                ((sum-right Carrier))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use ring-ideal-member ())
                    Carrier
                    coefficient-ring
                    first-ideal
                    element)
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app
                      (#pt-use ring-ideal-member ())
                      Carrier
                      coefficient-ring
                      second-ideal
                      sum-right)
                    (#pt-app
                      (#pt-use ring-equal ())
                      Carrier
                      coefficient-ring
                      element
                      (#pt-app (#pt-use ring-add ()) Carrier coefficient-ring element sum-right))))))
            introduce
            (
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
              (#pt-app
                (#pt-use conjunction-introduce ())
                (#pt-app
                  (#pt-use ring-ideal-member ())
                  Carrier
                  coefficient-ring
                  first-ideal
                  element)
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use ring-ideal-member ())
                    Carrier
                    coefficient-ring
                    second-ideal
                    (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
                  (#pt-app
                    (#pt-use ring-equal ())
                    Carrier
                    coefficient-ring
                    element
                    (#pt-app
                      (#pt-use ring-add ())
                      Carrier
                      coefficient-ring
                      element
                      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
                member
                (#pt-app
                  (#pt-use conjunction-introduce ())
                  (#pt-app
                    (#pt-use ring-ideal-member ())
                    Carrier
                    coefficient-ring
                    second-ideal
                    (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
                  (#pt-app
                    (#pt-use ring-equal ())
                    Carrier
                    coefficient-ring
                    element
                    (#pt-app
                      (#pt-use ring-add ())
                      Carrier
                      coefficient-ring
                      element
                      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
                  (#pt-app (#pt-use ring-ideal-zero ()) Carrier coefficient-ring second-ideal)
                  (#pt-app
                    (#pt-use ring-symmetric ())
                    Carrier
                    coefficient-ring
                    (#pt-app
                      (#pt-use ring-add ())
                      Carrier
                      coefficient-ring
                      element
                      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
                    element
                    (#pt-app (#pt-use ring-add-zero ()) Carrier coefficient-ring element)))))))))))
(#theorem ring-ideal-sum-right
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      second-ideal
      (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)))
  (#proof
    (#pt-lambda
      (
        (element Carrier)
        (member
          (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring second-ideal element)))
      (#pt-construct
        exists
        (0)
        (Carrier
          (#pt-lambda
            ((sum-left Carrier))
            (#pt-app
              (#pt-use exists (0))
              Carrier
              (#pt-lambda
                ((sum-right Carrier))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use ring-ideal-member ())
                    Carrier
                    coefficient-ring
                    first-ideal
                    sum-left)
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app
                      (#pt-use ring-ideal-member ())
                      Carrier
                      coefficient-ring
                      second-ideal
                      sum-right)
                    (#pt-app
                      (#pt-use ring-equal ())
                      Carrier
                      coefficient-ring
                      element
                      (#pt-app (#pt-use ring-add ()) Carrier coefficient-ring sum-left sum-right))))))))
        introduce
        (
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
          (#pt-construct
            exists
            (0)
            (Carrier
              (#pt-lambda
                ((sum-right Carrier))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use ring-ideal-member ())
                    Carrier
                    coefficient-ring
                    first-ideal
                    (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app
                      (#pt-use ring-ideal-member ())
                      Carrier
                      coefficient-ring
                      second-ideal
                      sum-right)
                    (#pt-app
                      (#pt-use ring-equal ())
                      Carrier
                      coefficient-ring
                      element
                      (#pt-app
                        (#pt-use ring-add ())
                        Carrier
                        coefficient-ring
                        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
                        sum-right))))))
            introduce
            (element
              (#pt-app
                (#pt-use conjunction-introduce ())
                (#pt-app
                  (#pt-use ring-ideal-member ())
                  Carrier
                  coefficient-ring
                  first-ideal
                  (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use ring-ideal-member ())
                    Carrier
                    coefficient-ring
                    second-ideal
                    element)
                  (#pt-app
                    (#pt-use ring-equal ())
                    Carrier
                    coefficient-ring
                    element
                    (#pt-app
                      (#pt-use ring-add ())
                      Carrier
                      coefficient-ring
                      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
                      element)))
                (#pt-app (#pt-use ring-ideal-zero ()) Carrier coefficient-ring first-ideal)
                (#pt-app
                  (#pt-use conjunction-introduce ())
                  (#pt-app
                    (#pt-use ring-ideal-member ())
                    Carrier
                    coefficient-ring
                    second-ideal
                    element)
                  (#pt-app
                    (#pt-use ring-equal ())
                    Carrier
                    coefficient-ring
                    element
                    (#pt-app
                      (#pt-use ring-add ())
                      Carrier
                      coefficient-ring
                      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
                      element))
                  member
                  (#pt-app
                    (#pt-use ring-symmetric ())
                    Carrier
                    coefficient-ring
                    (#pt-app
                      (#pt-use ring-add ())
                      Carrier
                      coefficient-ring
                      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
                      element)
                    element
                    (#pt-app (#pt-use ring-zero-add ()) Carrier coefficient-ring element)))))))))))
(#theorem ring-ideal-sum-least
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter third-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter left-inclusion (#pt-app (#pt-use ring-ideal-subset ()) Carrier coefficient-ring first-ideal third-ideal))
    (#parameter right-inclusion (#pt-app (#pt-use ring-ideal-subset ()) Carrier coefficient-ring second-ideal third-ideal)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)
      third-ideal))
  (#proof
    (#pt-lambda
      (
        (element Carrier)
        (member
          (#pt-app
            (#pt-use ring-ideal-member ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)
            element)))
      (#pt-induct
        exists
        (0)
        (Carrier
          (#pt-lambda
            ((sum-left Carrier))
            (#pt-app
              (#pt-use exists (0))
              Carrier
              (#pt-lambda
                ((sum-right Carrier))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use ring-ideal-member ())
                    Carrier
                    coefficient-ring
                    first-ideal
                    sum-left)
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app
                      (#pt-use ring-ideal-member ())
                      Carrier
                      coefficient-ring
                      second-ideal
                      sum-right)
                    (#pt-app
                      (#pt-use ring-equal ())
                      Carrier
                      coefficient-ring
                      element
                      (#pt-app (#pt-use ring-add ()) Carrier coefficient-ring sum-left sum-right))))))))
        (#pt-lambda
          (
            (sum-certificate
              (#pt-app
                (#pt-use ring-ideal-sum-member ())
                Carrier
                coefficient-ring
                first-ideal
                second-ideal
                element)))
          (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring third-ideal element))
        (
          (#pt-lambda
            (
              (summand-left-5 Carrier)
              (left-certificate-5
                (#pt-app
                  (#pt-use exists (0))
                  Carrier
                  (#pt-lambda
                    ((sum-right Carrier))
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app
                        (#pt-use ring-ideal-member ())
                        Carrier
                        coefficient-ring
                        first-ideal
                        summand-left-5)
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-app
                          (#pt-use ring-ideal-member ())
                          Carrier
                          coefficient-ring
                          second-ideal
                          sum-right)
                        (#pt-app
                          (#pt-use ring-equal ())
                          Carrier
                          coefficient-ring
                          element
                          (#pt-app
                            (#pt-use ring-add ())
                            Carrier
                            coefficient-ring
                            summand-left-5
                            sum-right))))))))
            (#pt-induct
              exists
              (0)
              (Carrier
                (#pt-lambda
                  ((sum-right Carrier))
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app
                      (#pt-use ring-ideal-member ())
                      Carrier
                      coefficient-ring
                      first-ideal
                      summand-left-5)
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app
                        (#pt-use ring-ideal-member ())
                        Carrier
                        coefficient-ring
                        second-ideal
                        sum-right)
                      (#pt-app
                        (#pt-use ring-equal ())
                        Carrier
                        coefficient-ring
                        element
                        (#pt-app
                          (#pt-use ring-add ())
                          Carrier
                          coefficient-ring
                          summand-left-5
                          sum-right))))))
              (#pt-lambda
                (
                  (right-certificate
                    (#pt-app
                      (#pt-use exists (0))
                      Carrier
                      (#pt-lambda
                        ((sum-right Carrier))
                        (#pt-app
                          (#pt-use conjunction ())
                          (#pt-app
                            (#pt-use ring-ideal-member ())
                            Carrier
                            coefficient-ring
                            first-ideal
                            summand-left-5)
                          (#pt-app
                            (#pt-use conjunction ())
                            (#pt-app
                              (#pt-use ring-ideal-member ())
                              Carrier
                              coefficient-ring
                              second-ideal
                              sum-right)
                            (#pt-app
                              (#pt-use ring-equal ())
                              Carrier
                              coefficient-ring
                              element
                              (#pt-app
                                (#pt-use ring-add ())
                                Carrier
                                coefficient-ring
                                summand-left-5
                                sum-right))))))))
                (#pt-app
                  (#pt-use ring-ideal-member ())
                  Carrier
                  coefficient-ring
                  third-ideal
                  element))
              (
                (#pt-lambda
                  (
                    (summand-right-5 Carrier)
                    (summand-evidence-5
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-app
                          (#pt-use ring-ideal-member ())
                          Carrier
                          coefficient-ring
                          first-ideal
                          summand-left-5)
                        (#pt-app
                          (#pt-use conjunction ())
                          (#pt-app
                            (#pt-use ring-ideal-member ())
                            Carrier
                            coefficient-ring
                            second-ideal
                            summand-right-5)
                          (#pt-app
                            (#pt-use ring-equal ())
                            Carrier
                            coefficient-ring
                            element
                            (#pt-app
                              (#pt-use ring-add ())
                              Carrier
                              coefficient-ring
                              summand-left-5
                              summand-right-5))))))
                  (#pt-app
                    (#pt-use ring-ideal-member-congruent ())
                    Carrier
                    coefficient-ring
                    third-ideal
                    (#pt-app
                      (#pt-use ring-add ())
                      Carrier
                      coefficient-ring
                      summand-left-5
                      summand-right-5)
                    element
                    (#pt-app
                      (#pt-use ring-symmetric ())
                      Carrier
                      coefficient-ring
                      element
                      (#pt-app
                        (#pt-use ring-add ())
                        Carrier
                        coefficient-ring
                        summand-left-5
                        summand-right-5)
                      (#pt-project conjunction 1 (#pt-project conjunction 1 summand-evidence-5)))
                    (#pt-app
                      (#pt-use ring-ideal-add ())
                      Carrier
                      coefficient-ring
                      third-ideal
                      summand-left-5
                      summand-right-5
                      (#pt-app
                        left-inclusion
                        summand-left-5
                        (#pt-project conjunction 0 summand-evidence-5))
                      (#pt-app
                        right-inclusion
                        summand-right-5
                        (#pt-project conjunction 0 (#pt-project conjunction 1 summand-evidence-5)))))))
              left-certificate-5)))
        member))))
(#theorem ring-ideal-sum-commutative
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)
      (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring second-ideal first-ideal)))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)
        (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring second-ideal first-ideal))
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring second-ideal first-ideal)
        (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal))
      (#pt-app
        (#pt-use ring-ideal-sum-least ())
        Carrier
        coefficient-ring
        first-ideal
        second-ideal
        (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring second-ideal first-ideal)
        (#pt-app
          (#pt-use ring-ideal-sum-right ())
          Carrier
          coefficient-ring
          second-ideal
          first-ideal)
        (#pt-app (#pt-use ring-ideal-sum-left ()) Carrier coefficient-ring second-ideal first-ideal))
      (#pt-app
        (#pt-use ring-ideal-sum-least ())
        Carrier
        coefficient-ring
        second-ideal
        first-ideal
        (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)
        (#pt-app
          (#pt-use ring-ideal-sum-right ())
          Carrier
          coefficient-ring
          first-ideal
          second-ideal)
        (#pt-app (#pt-use ring-ideal-sum-left ()) Carrier coefficient-ring first-ideal second-ideal)))))
