(#theorem integer-frey-discriminant-valuation-away-two
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter integral-model (#pt-use integer-weierstrass-curve ()))
    (#parameter model-certificate (#pt-app (#pt-use integer-frey-model-certificate ()) first second exponent integral-model))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter not-two (#pt-pi ((denied-proof (#pt-eq #pt-nat prime-number (#pt-succ (#pt-succ #pt-zero))))) #pt-false))
    (#parameter coordinate-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-power ()) first exponent) (#pt-app (#pt-use integer-power ()) second exponent)) (#pt-app (#pt-use integer-power ()) third exponent)))
    (#parameter discriminant-valuation #pt-nat)
    (#parameter coordinate-valuation #pt-nat)
    (#parameter discriminant-order (#pt-app (#pt-use integer-prime-order ()) prime-number discriminant-valuation (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)))
    (#parameter coordinate-order (#pt-app (#pt-use integer-prime-order ()) prime-number coordinate-valuation (#pt-app (#pt-use integer-multiply ()) (#pt-app (#pt-use integer-multiply ()) first second) third))))
  (#statement
    (#pt-eq
      #pt-nat
      discriminant-valuation
      (#pt-app
        (#pt-use multiply ())
        (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent)
        coordinate-valuation)))
  (#proof
    (#pt-app
      (#pt-use integer-prime-order-scaled-power ())
      prime-number
      (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)
      (#pt-app
        (#pt-use integer-of-natural ())
        (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-numeral 8)))
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app (#pt-use integer-multiply ()) first second)
        third)
      (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent)
      discriminant-valuation
      coordinate-valuation
      prime-proof
      (#pt-app
        (#pt-use integer-prime-away-two-not-divides-power ())
        prime-number
        (#pt-numeral 8)
        prime-proof
        not-two)
      (#pt-app
        (#pt-use integer-frey-discriminant-multiplied ())
        first
        second
        third
        exponent
        integral-model
        model-certificate
        coordinate-equation)
      discriminant-order
      coordinate-order)))
