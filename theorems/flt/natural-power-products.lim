; Arbitrary-exponent product and divisibility witnesses used by
; the Frey primitive normalization at S_FreyPackage_of_counterexample:17-29.
; Product powers follow by Nat induction and explicit regrouping.
; Divisibility passes to positive powers by an actual predecessor witness;
; exponent zero is not silently treated as positive.
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias power = ./../fermat_statement.lim::power)
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias congruence = ./equality.lim::congruence)
(#alias substitution = ./equality.lim::substitution)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias multiply-associative = ./natural-multiplication.lim::multiply-associative)
(#alias multiply-left-commutative = ./natural-square-arithmetic.lim::multiply-left-commutative)
(#alias divides-multiple = ./natural-divisibility.lim::divides-multiple)
(#alias divides-transitive = ./natural-divisibility.lim::divides-transitive)
(#theorem power-product
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter exponent #pt-nat))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use power ()) (#pt-app (#pt-use multiply ()) first second) exponent)
      (#pt-app
        (#pt-use multiply ())
        (#pt-app (#pt-use power ()) first exponent)
        (#pt-app (#pt-use power ()) second exponent))))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((index #pt-nat))
        (#pt-eq
          #pt-nat
          (#pt-app (#pt-use power ()) (#pt-app (#pt-use multiply ()) first second) index)
          (#pt-app
            (#pt-use multiply ())
            (#pt-app (#pt-use power ()) first index)
            (#pt-app (#pt-use power ()) second index))))
      (#pt-refl #pt-nat (#pt-succ #pt-zero))
      (#pt-lambda
        (
          (previous-exponent #pt-nat)
          (previous-product
            (#pt-eq
              #pt-nat
              (#pt-app
                (#pt-use power ())
                (#pt-app (#pt-use multiply ()) first second)
                previous-exponent)
              (#pt-app
                (#pt-use multiply ())
                (#pt-app (#pt-use power ()) first previous-exponent)
                (#pt-app (#pt-use power ()) second previous-exponent)))))
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          (#pt-app
            (#pt-use multiply ())
            (#pt-app (#pt-use multiply ()) first second)
            (#pt-app
              (#pt-use power ())
              (#pt-app (#pt-use multiply ()) first second)
              previous-exponent))
          (#pt-app
            (#pt-use multiply ())
            (#pt-app (#pt-use multiply ()) first second)
            (#pt-app
              (#pt-use multiply ())
              (#pt-app (#pt-use power ()) first previous-exponent)
              (#pt-app (#pt-use power ()) second previous-exponent)))
          (#pt-app
            (#pt-use multiply ())
            (#pt-app
              (#pt-use multiply ())
              first
              (#pt-app (#pt-use power ()) first previous-exponent))
            (#pt-app
              (#pt-use multiply ())
              second
              (#pt-app (#pt-use power ()) second previous-exponent)))
          (#pt-app
            (#pt-use congruence (0 0))
            #pt-nat
            #pt-nat
            (#pt-lambda
              ((endpoint #pt-nat))
              (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use multiply ()) first second) endpoint))
            (#pt-app
              (#pt-use power ())
              (#pt-app (#pt-use multiply ()) first second)
              previous-exponent)
            (#pt-app
              (#pt-use multiply ())
              (#pt-app (#pt-use power ()) first previous-exponent)
              (#pt-app (#pt-use power ()) second previous-exponent))
            previous-product)
          (#pt-app
            (#pt-use transitivity (0))
            #pt-nat
            (#pt-app
              (#pt-use multiply ())
              (#pt-app (#pt-use multiply ()) first second)
              (#pt-app
                (#pt-use multiply ())
                (#pt-app (#pt-use power ()) first previous-exponent)
                (#pt-app (#pt-use power ()) second previous-exponent)))
            (#pt-app
              (#pt-use multiply ())
              first
              (#pt-app
                (#pt-use multiply ())
                second
                (#pt-app
                  (#pt-use multiply ())
                  (#pt-app (#pt-use power ()) first previous-exponent)
                  (#pt-app (#pt-use power ()) second previous-exponent))))
            (#pt-app
              (#pt-use multiply ())
              (#pt-app
                (#pt-use multiply ())
                first
                (#pt-app (#pt-use power ()) first previous-exponent))
              (#pt-app
                (#pt-use multiply ())
                second
                (#pt-app (#pt-use power ()) second previous-exponent)))
            (#pt-app
              (#pt-use multiply-associative ())
              first
              second
              (#pt-app
                (#pt-use multiply ())
                (#pt-app (#pt-use power ()) first previous-exponent)
                (#pt-app (#pt-use power ()) second previous-exponent)))
            (#pt-app
              (#pt-use transitivity (0))
              #pt-nat
              (#pt-app
                (#pt-use multiply ())
                first
                (#pt-app
                  (#pt-use multiply ())
                  second
                  (#pt-app
                    (#pt-use multiply ())
                    (#pt-app (#pt-use power ()) first previous-exponent)
                    (#pt-app (#pt-use power ()) second previous-exponent))))
              (#pt-app
                (#pt-use multiply ())
                first
                (#pt-app
                  (#pt-use multiply ())
                  (#pt-app (#pt-use power ()) first previous-exponent)
                  (#pt-app
                    (#pt-use multiply ())
                    second
                    (#pt-app (#pt-use power ()) second previous-exponent))))
              (#pt-app
                (#pt-use multiply ())
                (#pt-app
                  (#pt-use multiply ())
                  first
                  (#pt-app (#pt-use power ()) first previous-exponent))
                (#pt-app
                  (#pt-use multiply ())
                  second
                  (#pt-app (#pt-use power ()) second previous-exponent)))
              (#pt-app
                (#pt-use congruence (0 0))
                #pt-nat
                #pt-nat
                (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use multiply ()) first endpoint))
                (#pt-app
                  (#pt-use multiply ())
                  second
                  (#pt-app
                    (#pt-use multiply ())
                    (#pt-app (#pt-use power ()) first previous-exponent)
                    (#pt-app (#pt-use power ()) second previous-exponent)))
                (#pt-app
                  (#pt-use multiply ())
                  (#pt-app (#pt-use power ()) first previous-exponent)
                  (#pt-app
                    (#pt-use multiply ())
                    second
                    (#pt-app (#pt-use power ()) second previous-exponent)))
                (#pt-app
                  (#pt-use multiply-left-commutative ())
                  second
                  (#pt-app (#pt-use power ()) first previous-exponent)
                  (#pt-app (#pt-use power ()) second previous-exponent)))
              (#pt-app
                (#pt-use symmetry (0))
                #pt-nat
                (#pt-app
                  (#pt-use multiply ())
                  (#pt-app
                    (#pt-use multiply ())
                    first
                    (#pt-app (#pt-use power ()) first previous-exponent))
                  (#pt-app
                    (#pt-use multiply ())
                    second
                    (#pt-app (#pt-use power ()) second previous-exponent)))
                (#pt-app
                  (#pt-use multiply ())
                  first
                  (#pt-app
                    (#pt-use multiply ())
                    (#pt-app (#pt-use power ()) first previous-exponent)
                    (#pt-app
                      (#pt-use multiply ())
                      second
                      (#pt-app (#pt-use power ()) second previous-exponent))))
                (#pt-app
                  (#pt-use multiply-associative ())
                  first
                  (#pt-app (#pt-use power ()) first previous-exponent)
                  (#pt-app
                    (#pt-use multiply ())
                    second
                    (#pt-app (#pt-use power ()) second previous-exponent))))))))
      exponent)))
(#theorem power-congruent
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter exponent #pt-nat)
    (#parameter base-equation (#pt-eq #pt-nat first second)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use power ()) first exponent)
      (#pt-app (#pt-use power ()) second exponent)))
  (#proof
    (#pt-app
      (#pt-use congruence (0 0))
      #pt-nat
      #pt-nat
      (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use power ()) endpoint exponent))
      first
      second
      base-equation)))
(#theorem divides-power-successor
  (#universes)
  (#parameters
    (#parameter divisor #pt-nat)
    (#parameter first #pt-nat)
    (#parameter exponent #pt-nat)
    (#parameter base-divides (#pt-app (#pt-use divides ()) divisor first)))
  (#statement
    (#pt-app (#pt-use divides ()) divisor (#pt-app (#pt-use power ()) first (#pt-succ exponent))))
  (#proof
    (#pt-app
      (#pt-use divides-transitive ())
      divisor
      first
      (#pt-app (#pt-use power ()) first (#pt-succ exponent))
      base-divides
      (#pt-app (#pt-use divides-multiple ()) first (#pt-app (#pt-use power ()) first exponent)))))
(#theorem divides-positive-power
  (#universes)
  (#parameters
    (#parameter divisor #pt-nat)
    (#parameter first #pt-nat)
    (#parameter exponent #pt-nat)
    (#parameter positive-exponent (#pt-app (#pt-use less-than ()) #pt-zero exponent))
    (#parameter base-divides (#pt-app (#pt-use divides ()) divisor first)))
  (#statement (#pt-app (#pt-use divides ()) divisor (#pt-app (#pt-use power ()) first exponent)))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda ((candidate-gap #pt-nat)) (#pt-eq #pt-nat exponent (#pt-succ candidate-gap))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-gap #pt-nat))
                (#pt-eq #pt-nat exponent (#pt-succ candidate-gap))))))
        (#pt-app (#pt-use divides ()) divisor (#pt-app (#pt-use power ()) first exponent)))
      (
        (#pt-lambda
          (
            (exponent-gap #pt-nat)
            (exponent-position (#pt-eq #pt-nat exponent (#pt-succ exponent-gap))))
          (#pt-app
            (#pt-use substitution (0))
            #pt-nat
            (#pt-lambda
              ((endpoint #pt-nat))
              (#pt-app (#pt-use divides ()) divisor (#pt-app (#pt-use power ()) first endpoint)))
            (#pt-succ exponent-gap)
            exponent
            (#pt-app
              (#pt-use symmetry (0))
              #pt-nat
              exponent
              (#pt-succ exponent-gap)
              exponent-position)
            (#pt-app (#pt-use divides-power-successor ()) divisor first exponent-gap base-divides))))
      positive-exponent)))
