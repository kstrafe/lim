                          (#pt-use eisenstein-lambda ())
                          (#pt-succ #pt-zero))
                        (#pt-use eisenstein-lambda ())
                        unit
                        (#pt-app (#pt-use eisenstein-power-one ()) (#pt-use eisenstein-lambda ()))
                        next-divides)))))))))
      unit-proof)))
