(#theorem eisenstein-lambda-order-power
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter base-order #pt-nat)
    (#parameter exponent #pt-nat)
    (#parameter order-certificate (#pt-app (#pt-use eisenstein-lambda-order ()) number base-order)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-lambda-order ())
      (#pt-app (#pt-use eisenstein-power ()) number exponent)
      (#pt-app (#pt-use multiply ()) exponent base-order)))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((index #pt-nat))
        (#pt-app
          (#pt-use eisenstein-lambda-order ())
          (#pt-app (#pt-use eisenstein-power ()) number index)
          (#pt-app (#pt-use multiply ()) index base-order)))
      (#pt-use eisenstein-lambda-order-one ())
      (#pt-lambda
        (
          (previous #pt-nat)
          (previous-order
            (#pt-app
              (#pt-use eisenstein-lambda-order ())
              (#pt-app (#pt-use eisenstein-power ()) number previous)
              (#pt-app (#pt-use multiply ()) previous base-order))))
        (#pt-app
          (#pt-use eisenstein-lambda-order-multiply ())
          number
          (#pt-app (#pt-use eisenstein-power ()) number previous)
          base-order
          (#pt-app (#pt-use multiply ()) previous base-order)
          order-certificate
          previous-order))
      exponent)))
(#theorem eisenstein-lambda-order-unit
  (#universes)
  (#parameters
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter unit-proof (#pt-app (#pt-use eisenstein-unit ()) unit)))
  (#statement (#pt-app (#pt-use eisenstein-lambda-order ()) unit #pt-zero))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-inverse (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app (#pt-use eisenstein-multiply ()) unit candidate-inverse)
              (#pt-use eisenstein-one ()))
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app (#pt-use eisenstein-multiply ()) candidate-inverse unit)
              (#pt-use eisenstein-one ())))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-inverse (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) unit candidate-inverse)
                    (#pt-use eisenstein-one ()))
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) candidate-inverse unit)
                    (#pt-use eisenstein-one ())))))))
        (#pt-app (#pt-use eisenstein-lambda-order ()) unit #pt-zero))
      (
        (#pt-lambda
          (
            (inverse (#pt-use eisenstein ()))
            (inverse-equations
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-multiply ()) unit inverse)
                  (#pt-use eisenstein-one ()))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-multiply ()) inverse unit)
                  (#pt-use eisenstein-one ())))))
          (#pt-construct
            eisenstein-lambda-order
            ()
            (unit #pt-zero)
            introduce
            (
              (#pt-app (#pt-use eisenstein-one-divides ()) unit)
              (#pt-lambda
                (
                  (next-divides
                    (#pt-app
                      (#pt-use eisenstein-divides ())
