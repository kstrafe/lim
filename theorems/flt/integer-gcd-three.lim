    (#parameter first-divides (#pt-app (#pt-use integer-divides ()) common-integer first))
    (#parameter second-divides (#pt-app (#pt-use integer-divides ()) common-integer second))
    (#parameter third-divides (#pt-app (#pt-use integer-divides ()) common-integer third)))
  (#statement (#pt-app (#pt-use integer-divides ()) common-integer (#pt-use integer-one ())))
  (#proof
    (#pt-app
      (#pt-app
        (#pt-use conjunction-right ())
