            second)
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-succ #pt-zero))
              third)
            (#pt-pi
              (
                (candidate-integer (#pt-use integer ()))
                (candidate-first (#pt-app (#pt-use integer-divides ()) candidate-integer first))
                (candidate-second (#pt-app (#pt-use integer-divides ()) candidate-integer second))
                (candidate-third (#pt-app (#pt-use integer-divides ()) candidate-integer third)))
              (#pt-app
                (#pt-use integer-divides ())
                candidate-integer
                (#pt-app (#pt-use integer-of-natural ()) (#pt-succ #pt-zero)))))
          (#pt-app
            (#pt-use conjunction-right ())
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-succ #pt-zero))
              first)
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app
                (#pt-use integer-divides ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-succ #pt-zero))
                second)
              (#pt-app
