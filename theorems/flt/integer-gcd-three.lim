                      (#pt-app
                        (#pt-use integer-divides ())
                        candidate-integer
                        (#pt-app (#pt-use integer-of-natural ()) greatest-divisor))))
                  (#pt-app
                    (#pt-use conjunction-right ())
                    (#pt-app
                      (#pt-use integer-divides ())
                      (#pt-app (#pt-use integer-of-natural ()) greatest-divisor)
                      first)
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app
                        (#pt-use integer-divides ())
                        (#pt-app (#pt-use integer-of-natural ()) greatest-divisor)
                        second)
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-app
                          (#pt-use integer-divides ())
                          (#pt-app (#pt-use integer-of-natural ()) greatest-divisor)
                          third)
                        (#pt-pi
                          (
                            (candidate-integer (#pt-use integer ()))
                            (candidate-first
                              (#pt-app (#pt-use integer-divides ()) candidate-integer first))
                            (candidate-second
                              (#pt-app (#pt-use integer-divides ()) candidate-integer second))
                            (candidate-third
                              (#pt-app (#pt-use integer-divides ()) candidate-integer third)))
                          (#pt-app
                            (#pt-use integer-divides ())
                            candidate-integer
                            (#pt-app (#pt-use integer-of-natural ()) greatest-divisor)))))
                    gcd-proof)))
              common-integer
              (#pt-app
                (#pt-use integer-divides-congruent-target ())
                common-integer
                other-first
                first
                (#pt-app (#pt-use integer-symmetric ()) first other-first equivalence-0)
                common-0)
              (#pt-app
                (#pt-use integer-divides-congruent-target ())
                common-integer
                other-second
                second
                (#pt-app (#pt-use integer-symmetric ()) second other-second equivalence-1)
                common-1)
              (#pt-app
                (#pt-use integer-divides-congruent-target ())
                common-integer
                other-third
                third
                (#pt-app (#pt-use integer-symmetric ()) third other-third equivalence-2)
                common-2))))))))
(#theorem integer-gcd-three-one-common-divisor
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter common-integer (#pt-use integer ()))
