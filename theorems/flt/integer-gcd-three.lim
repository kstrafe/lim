                  third)
                (#pt-pi
                  (
                    (candidate-integer (#pt-use integer ()))
                    (candidate-first (#pt-app (#pt-use integer-divides ()) candidate-integer first))
                    (candidate-second
                      (#pt-app (#pt-use integer-divides ()) candidate-integer second))
                    (candidate-third (#pt-app (#pt-use integer-divides ()) candidate-integer third)))
                  (#pt-app
                    (#pt-use integer-divides ())
                    candidate-integer
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-succ #pt-zero))))))
            gcd-one-proof)))
      common-integer
      first-divides
      second-divides
      third-divides)))
(#theorem integer-gcd-associative
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter pair-gcd #pt-nat)
    (#parameter greatest-divisor #pt-nat)
    (#parameter right-pair-gcd #pt-nat)
    (#parameter right-three-gcd #pt-nat)
    (#parameter left-pair-proof (#pt-app (#pt-use integer-gcd-spec ()) first second pair-gcd))
    (#parameter left-three-proof (#pt-app (#pt-use integer-gcd-spec ()) (#pt-app (#pt-use integer-of-natural ()) pair-gcd) third greatest-divisor))
    (#parameter right-pair-proof (#pt-app (#pt-use integer-gcd-spec ()) second third right-pair-gcd))
    (#parameter right-three-proof (#pt-app (#pt-use integer-gcd-spec ()) first (#pt-app (#pt-use integer-of-natural ()) right-pair-gcd) right-three-gcd)))
  (#statement (#pt-eq #pt-nat greatest-divisor right-three-gcd))
  (#proof
    (#pt-app
      (#pt-use integer-gcd-three-unique ())
      first
      second
      third
      greatest-divisor
      right-three-gcd
      (#pt-app
        (#pt-use integer-gcd-three-from-pairs ())
        first
        second
        third
        pair-gcd
        greatest-divisor
        left-pair-proof
        left-three-proof)
      (#pt-app
        (#pt-use integer-gcd-three-rotate ())
        second
        third
        first
        right-three-gcd
        (#pt-app
          (#pt-use integer-gcd-three-from-pairs ())
          second
          third
          first
          right-pair-gcd
          right-three-gcd
          right-pair-proof
          (#pt-app
            (#pt-use integer-gcd-symmetric ())
            first
            (#pt-app (#pt-use integer-of-natural ()) right-pair-gcd)
            right-three-gcd
            right-three-proof))))))
