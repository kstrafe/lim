; Checked ring cancellation for concrete cubic Bezout transport.
; Inverse-linear and complementary rows reconstruct the original two
; coordinates as explicit linear combinations of residuals.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-reflexive = ./eisenstein-equality.lim::eisenstein-reflexive)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-congruent = ./eisenstein-equality.lim::eisenstein-multiply-congruent)
(#alias eisenstein-multiply-associative = ./eisenstein-ring.lim::eisenstein-multiply-associative)
(#alias eisenstein-one-multiply = ./eisenstein-cubic-bridge.lim::eisenstein-one-multiply)
(#alias eisenstein-add = ./eisenstein-defs.lim::eisenstein-add)
(#alias eisenstein-negate = ./eisenstein-defs.lim::eisenstein-negate)
(#alias eisenstein-add-congruent = ./eisenstein-equality.lim::eisenstein-add-congruent)
(#alias eisenstein-negate-congruent = ./eisenstein-equality.lim::eisenstein-negate-congruent)
(#alias eisenstein-add-commutative = ./eisenstein-ring.lim::eisenstein-add-commutative)
(#alias eisenstein-add-associative = ./eisenstein-ring.lim::eisenstein-add-associative)
(#alias eisenstein-add-inverse = ./eisenstein-ring.lim::eisenstein-add-inverse)
(#alias eisenstein-add-cancel-left = ./eisenstein-ring.lim::eisenstein-add-cancel-left)
(#alias eisenstein-add-zero = ./eisenstein-ring.lim::eisenstein-add-zero)
(#alias eisenstein-multiply-negative = ./eisenstein-ring.lim::eisenstein-multiply-negative)
(#alias eisenstein-multiply-distributive = ./eisenstein-ring.lim::eisenstein-multiply-distributive)
(#alias
  eisenstein-multiply-distribute-second
  =
  ./eisenstein-ring.lim::eisenstein-multiply-distribute-second)
(#alias eisenstein-zero-add = ./eisenstein-additive-divisibility.lim::eisenstein-zero-add)
(#alias
  eisenstein-add-subtract-right
  =
  ./eisenstein-additive-divisibility.lim::eisenstein-add-subtract-right)
(#alias
  eisenstein-add-four-interchange
  =
  ./eisenstein-cubic-solution-algebra.lim::eisenstein-add-four-interchange)
(#theorem eisenstein-negative-add-inverse
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app (#pt-use eisenstein-add ()) (#pt-app (#pt-use eisenstein-negate ()) number) number)
      (#pt-use eisenstein-zero ())))
  (#proof
    (#pt-app
      (#pt-use eisenstein-transitive ())
      (#pt-app (#pt-use eisenstein-add ()) (#pt-app (#pt-use eisenstein-negate ()) number) number)
      (#pt-app (#pt-use eisenstein-add ()) number (#pt-app (#pt-use eisenstein-negate ()) number))
      (#pt-use eisenstein-zero ())
      (#pt-app
        (#pt-use eisenstein-add-commutative ())
        (#pt-app (#pt-use eisenstein-negate ()) number)
        number)
      (#pt-app (#pt-use eisenstein-add-inverse ()) number))))
(#theorem eisenstein-negative-add-cancel
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter other (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app (#pt-use eisenstein-negate ()) number)
        (#pt-app (#pt-use eisenstein-add ()) number other))
      other))
  (#proof
    (#pt-app
      (#pt-use eisenstein-transitive ())
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app (#pt-use eisenstein-negate ()) number)
        (#pt-app (#pt-use eisenstein-add ()) number other))
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app (#pt-use eisenstein-add ()) (#pt-app (#pt-use eisenstein-negate ()) number) number)
        other)
      other
      (#pt-app
        (#pt-use eisenstein-symmetric ())
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-negate ()) number)
            number)
          other)
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app (#pt-use eisenstein-negate ()) number)
          (#pt-app (#pt-use eisenstein-add ()) number other))
        (#pt-app
          (#pt-use eisenstein-add-associative ())
          (#pt-app (#pt-use eisenstein-negate ()) number)
          number
          other))
      (#pt-app
        (#pt-use eisenstein-transitive ())
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-negate ()) number)
            number)
          other)
        (#pt-app (#pt-use eisenstein-add ()) (#pt-use eisenstein-zero ()) other)
        other
        (#pt-app
          (#pt-use eisenstein-add-congruent ())
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-negate ()) number)
            number)
          other
          (#pt-use eisenstein-zero ())
          other
          (#pt-app (#pt-use eisenstein-negative-add-inverse ()) number)
          (#pt-app (#pt-use eisenstein-reflexive ()) other))
        (#pt-app (#pt-use eisenstein-zero-add ()) other)))))
(#theorem eisenstein-add-cancel-right
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter common (#pt-use eisenstein ()))
    (#parameter sum-equivalence (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-add ()) first common) (#pt-app (#pt-use eisenstein-add ()) second common))))
  (#statement (#pt-app (#pt-use eisenstein-equal ()) first second))
  (#proof
    (#pt-app
      (#pt-use eisenstein-add-cancel-left ())
      common
      first
      second
      (#pt-app
        (#pt-use eisenstein-transitive ())
        (#pt-app (#pt-use eisenstein-add ()) common first)
        (#pt-app (#pt-use eisenstein-add ()) first common)
        (#pt-app (#pt-use eisenstein-add ()) common second)
        (#pt-app (#pt-use eisenstein-add-commutative ()) common first)
        (#pt-app
          (#pt-use eisenstein-transitive ())
          (#pt-app (#pt-use eisenstein-add ()) first common)
          (#pt-app (#pt-use eisenstein-add ()) second common)
          (#pt-app (#pt-use eisenstein-add ()) common second)
          sum-equivalence
          (#pt-app (#pt-use eisenstein-add-commutative ()) second common))))))
(#theorem eisenstein-inverse-linear-second
  (#universes)
  (#parameters
    (#parameter shift (#pt-use eisenstein ()))
    (#parameter residual (#pt-use eisenstein ()))
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter inverse (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter projected (#pt-use eisenstein ()))
    (#parameter shift-equivalence (#pt-app (#pt-use eisenstein-equal ()) projected (#pt-app (#pt-use eisenstein-add ()) (#pt-app (#pt-use eisenstein-multiply ()) shift residual) (#pt-app (#pt-use eisenstein-multiply ()) unit second))))
    (#parameter inverse-equivalence (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-multiply ()) inverse unit) (#pt-use eisenstein-one ()))))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      second
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app
            (#pt-use eisenstein-negate ())
            (#pt-app (#pt-use eisenstein-multiply ()) inverse shift))
          residual)
        (#pt-app (#pt-use eisenstein-multiply ()) inverse projected))))
  (#proof
    (#pt-app
      (#pt-use eisenstein-symmetric ())
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app
            (#pt-use eisenstein-negate ())
            (#pt-app (#pt-use eisenstein-multiply ()) inverse shift))
          residual)
        (#pt-app (#pt-use eisenstein-multiply ()) inverse projected))
      second
      (#pt-app
        (#pt-use eisenstein-transitive ())
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app
              (#pt-use eisenstein-negate ())
              (#pt-app (#pt-use eisenstein-multiply ()) inverse shift))
            residual)
          (#pt-app (#pt-use eisenstein-multiply ()) inverse projected))
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app
            (#pt-use eisenstein-negate ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-multiply ()) inverse shift)
              residual))
          (#pt-app
            (#pt-use eisenstein-multiply ())
            inverse
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-multiply ()) shift residual)
              (#pt-app (#pt-use eisenstein-multiply ()) unit second))))
        second
        (#pt-app
          (#pt-use eisenstein-add-congruent ())
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app
              (#pt-use eisenstein-negate ())
              (#pt-app (#pt-use eisenstein-multiply ()) inverse shift))
            residual)
          (#pt-app (#pt-use eisenstein-multiply ()) inverse projected)
          (#pt-app
            (#pt-use eisenstein-negate ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-multiply ()) inverse shift)
              residual))
          (#pt-app
            (#pt-use eisenstein-multiply ())
            inverse
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-multiply ()) shift residual)
              (#pt-app (#pt-use eisenstein-multiply ()) unit second)))
          (#pt-app
            (#pt-use eisenstein-multiply-negative ())
            (#pt-app (#pt-use eisenstein-multiply ()) inverse shift)
            residual)
          (#pt-app
            (#pt-use eisenstein-multiply-congruent ())
            inverse
            projected
            inverse
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-multiply ()) shift residual)
              (#pt-app (#pt-use eisenstein-multiply ()) unit second))
            (#pt-app (#pt-use eisenstein-reflexive ()) inverse)
            shift-equivalence))
        (#pt-app
          (#pt-use eisenstein-transitive ())
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app
              (#pt-use eisenstein-negate ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app (#pt-use eisenstein-multiply ()) inverse shift)
                residual))
            (#pt-app
              (#pt-use eisenstein-multiply ())
              inverse
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-app (#pt-use eisenstein-multiply ()) shift residual)
                (#pt-app (#pt-use eisenstein-multiply ()) unit second))))
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app
              (#pt-use eisenstein-negate ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                inverse
                (#pt-app (#pt-use eisenstein-multiply ()) shift residual)))
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                inverse
                (#pt-app (#pt-use eisenstein-multiply ()) shift residual))
              (#pt-app
                (#pt-use eisenstein-multiply ())
                inverse
                (#pt-app (#pt-use eisenstein-multiply ()) unit second))))
          second
          (#pt-app
            (#pt-use eisenstein-add-congruent ())
            (#pt-app
              (#pt-use eisenstein-negate ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app (#pt-use eisenstein-multiply ()) inverse shift)
                residual))
            (#pt-app
              (#pt-use eisenstein-multiply ())
              inverse
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-app (#pt-use eisenstein-multiply ()) shift residual)
                (#pt-app (#pt-use eisenstein-multiply ()) unit second)))
            (#pt-app
              (#pt-use eisenstein-negate ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                inverse
                (#pt-app (#pt-use eisenstein-multiply ()) shift residual)))
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                inverse
                (#pt-app (#pt-use eisenstein-multiply ()) shift residual))
              (#pt-app
                (#pt-use eisenstein-multiply ())
                inverse
                (#pt-app (#pt-use eisenstein-multiply ()) unit second)))
            (#pt-app
              (#pt-use eisenstein-negate-congruent ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app (#pt-use eisenstein-multiply ()) inverse shift)
                residual)
              (#pt-app
                (#pt-use eisenstein-multiply ())
                inverse
                (#pt-app (#pt-use eisenstein-multiply ()) shift residual))
              (#pt-app (#pt-use eisenstein-multiply-associative ()) inverse shift residual))
            (#pt-app
              (#pt-use eisenstein-multiply-distribute-second ())
              inverse
              (#pt-app (#pt-use eisenstein-multiply ()) shift residual)
              (#pt-app (#pt-use eisenstein-multiply ()) unit second)))
          (#pt-app
            (#pt-use eisenstein-transitive ())
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app
                (#pt-use eisenstein-negate ())
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  inverse
                  (#pt-app (#pt-use eisenstein-multiply ()) shift residual)))
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  inverse
                  (#pt-app (#pt-use eisenstein-multiply ()) shift residual))
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  inverse
                  (#pt-app (#pt-use eisenstein-multiply ()) unit second))))
            (#pt-app
              (#pt-use eisenstein-multiply ())
              inverse
              (#pt-app (#pt-use eisenstein-multiply ()) unit second))
            second
            (#pt-app
              (#pt-use eisenstein-negative-add-cancel ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                inverse
                (#pt-app (#pt-use eisenstein-multiply ()) shift residual))
              (#pt-app
                (#pt-use eisenstein-multiply ())
                inverse
                (#pt-app (#pt-use eisenstein-multiply ()) unit second)))
            (#pt-app
              (#pt-use eisenstein-transitive ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                inverse
                (#pt-app (#pt-use eisenstein-multiply ()) unit second))
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app (#pt-use eisenstein-multiply ()) inverse unit)
                second)
              second
              (#pt-app
                (#pt-use eisenstein-symmetric ())
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app (#pt-use eisenstein-multiply ()) inverse unit)
                  second)
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  inverse
                  (#pt-app (#pt-use eisenstein-multiply ()) unit second))
                (#pt-app (#pt-use eisenstein-multiply-associative ()) inverse unit second))
              (#pt-app
                (#pt-use eisenstein-transitive ())
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app (#pt-use eisenstein-multiply ()) inverse unit)
                  second)
                (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) second)
                second
                (#pt-app
                  (#pt-use eisenstein-multiply-congruent ())
                  (#pt-app (#pt-use eisenstein-multiply ()) inverse unit)
                  second
                  (#pt-use eisenstein-one ())
                  second
                  inverse-equivalence
                  (#pt-app (#pt-use eisenstein-reflexive ()) second))
                (#pt-app (#pt-use eisenstein-one-multiply ()) second)))))))))
(#theorem eisenstein-complementary-linear-rows
  (#universes)
  (#parameters
    (#parameter primary (#pt-use eisenstein ()))
    (#parameter correction (#pt-use eisenstein ()))
    (#parameter coefficient (#pt-use eisenstein ()))
    (#parameter x (#pt-use eisenstein ()))
    (#parameter y (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-add ()) primary correction)
            x)
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-negate ()) coefficient)
            y))
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-negate ()) correction)
            x)
          (#pt-app (#pt-use eisenstein-multiply ()) coefficient y)))
      (#pt-app (#pt-use eisenstein-multiply ()) primary x)))
  (#proof
    (#pt-app
      (#pt-use eisenstein-transitive ())
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-add ()) primary correction)
            x)
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-negate ()) coefficient)
            y))
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-negate ()) correction)
            x)
          (#pt-app (#pt-use eisenstein-multiply ()) coefficient y)))
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-add ()) primary correction)
            x)
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-negate ()) correction)
            x))
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-negate ()) coefficient)
            y)
          (#pt-app (#pt-use eisenstein-multiply ()) coefficient y)))
      (#pt-app (#pt-use eisenstein-multiply ()) primary x)
      (#pt-app
        (#pt-use eisenstein-add-four-interchange ())
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app (#pt-use eisenstein-add ()) primary correction)
          x)
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app (#pt-use eisenstein-negate ()) correction)
          x)
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app (#pt-use eisenstein-negate ()) coefficient)
          y)
        (#pt-app (#pt-use eisenstein-multiply ()) coefficient y))
      (#pt-app
        (#pt-use eisenstein-transitive ())
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-add ()) primary correction)
              x)
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-negate ()) correction)
              x))
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-negate ()) coefficient)
              y)
            (#pt-app (#pt-use eisenstein-multiply ()) coefficient y)))
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app (#pt-use eisenstein-multiply ()) primary x)
          (#pt-use eisenstein-zero ()))
        (#pt-app (#pt-use eisenstein-multiply ()) primary x)
        (#pt-app
          (#pt-use eisenstein-add-congruent ())
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-add ()) primary correction)
              x)
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-negate ()) correction)
              x))
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-negate ()) coefficient)
              y)
            (#pt-app (#pt-use eisenstein-multiply ()) coefficient y))
          (#pt-app (#pt-use eisenstein-multiply ()) primary x)
          (#pt-use eisenstein-zero ())
          (#pt-app
            (#pt-use eisenstein-transitive ())
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app (#pt-use eisenstein-add ()) primary correction)
                x)
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app (#pt-use eisenstein-negate ()) correction)
                x))
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-app (#pt-use eisenstein-add ()) primary correction)
                (#pt-app (#pt-use eisenstein-negate ()) correction))
              x)
            (#pt-app (#pt-use eisenstein-multiply ()) primary x)
            (#pt-app
              (#pt-use eisenstein-symmetric ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app
                  (#pt-use eisenstein-add ())
                  (#pt-app (#pt-use eisenstein-add ()) primary correction)
                  (#pt-app (#pt-use eisenstein-negate ()) correction))
                x)
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app (#pt-use eisenstein-add ()) primary correction)
                  x)
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app (#pt-use eisenstein-negate ()) correction)
                  x))
              (#pt-app
                (#pt-use eisenstein-multiply-distributive ())
                (#pt-app (#pt-use eisenstein-add ()) primary correction)
                (#pt-app (#pt-use eisenstein-negate ()) correction)
                x))
            (#pt-app
              (#pt-use eisenstein-multiply-congruent ())
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-app (#pt-use eisenstein-add ()) primary correction)
                (#pt-app (#pt-use eisenstein-negate ()) correction))
              x
              primary
              x
              (#pt-app (#pt-use eisenstein-add-subtract-right ()) primary correction)
              (#pt-app (#pt-use eisenstein-reflexive ()) x)))
          (#pt-app
            (#pt-use eisenstein-transitive ())
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app (#pt-use eisenstein-negate ()) coefficient)
                y)
              (#pt-app (#pt-use eisenstein-multiply ()) coefficient y))
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app
