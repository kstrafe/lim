; Explicit scalar ring-law
; permutation used by the actual product and colon memberships.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias
  ring-multiply-left-commutative
  =
  ./commutative-ring-elementary-laws.lim::ring-multiply-left-commutative)
(#theorem point-ideal-addition-permutation-first
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-X Carrier)
    (#parameter second-X Carrier)
    (#parameter sum-X Carrier)
    (#parameter line Carrier)
    (#parameter opposite Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-multiply ())
        Carrier
        coefficient-ring
        sum-X
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-X line))
      (#pt-app
        (#pt-use ring-multiply ())
        Carrier
        coefficient-ring
        first-X
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring sum-X line))))
  (#proof
    (#pt-app
      (#pt-use ring-multiply-left-commutative ())
      Carrier
      coefficient-ring
      sum-X
      first-X
      line)))
