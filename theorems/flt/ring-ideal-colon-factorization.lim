; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Product containment is equivalent to
; containment in every fixed-factor colon ideal. Prove both
; implications for arbitrary ideal records before instantiating
; them with sums or nested products.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias ring-ideal = ./ring-ideal-data.lim::ring-ideal)
(#alias ring-ideal-colon-element = ./ring-ideal-colon-element.lim::ring-ideal-colon-element)
(#alias ring-ideal-member = ./ring-ideal-data.lim::ring-ideal-member)
(#alias ring-ideal-product = ./ring-ideal-product.lim::ring-ideal-product)
(#alias ring-ideal-product-introduce = ./ring-ideal-product.lim::ring-ideal-product-introduce)
(#alias ring-ideal-product-least = ./ring-ideal-product.lim::ring-ideal-product-least)
(#alias ring-ideal-subset = ./ring-ideal-data.lim::ring-ideal-subset)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#theorem ring-ideal-product-to-colon
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter third-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter product-inclusion (#pt-app (#pt-use ring-ideal-subset ()) Carrier coefficient-ring (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal second-ideal) third-ideal))
    (#parameter last-factor Carrier)
    (#parameter last-member (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring second-ideal last-factor)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      first-ideal
      (#pt-app
        (#pt-use ring-ideal-colon-element ())
        Carrier
        coefficient-ring
        third-ideal
        last-factor)))
  (#proof
    (#pt-lambda
      (
        (inner-first-factor Carrier)
        (inner-member
          (#pt-app
            (#pt-use ring-ideal-member ())
            Carrier
            coefficient-ring
            first-ideal
            inner-first-factor)))
      (#pt-app
        product-inclusion
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring inner-first-factor last-factor)
        (#pt-app
          (#pt-use ring-ideal-product-introduce ())
          Carrier
          coefficient-ring
          first-ideal
          second-ideal
          inner-first-factor
          last-factor
          inner-member
          last-member)))))
(#theorem ring-ideal-product-from-colon
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter third-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter colon-inclusions (#pt-pi ((last-factor Carrier) (last-member (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring second-ideal last-factor))) (#pt-app (#pt-use ring-ideal-subset ()) Carrier coefficient-ring first-ideal (#pt-app (#pt-use ring-ideal-colon-element ()) Carrier coefficient-ring third-ideal last-factor)))))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal second-ideal)
      third-ideal))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-product-least ())
      Carrier
      coefficient-ring
      first-ideal
      second-ideal
      third-ideal
      (#pt-lambda
        (
          (inner-first-factor Carrier)
          (last-factor Carrier)
          (inner-member
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              first-ideal
              inner-first-factor))
          (last-member
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              second-ideal
              last-factor)))
        (#pt-app colon-inclusions last-factor last-member inner-first-factor inner-member)))))
