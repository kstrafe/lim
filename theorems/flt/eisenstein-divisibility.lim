; Witnessed divisibility in the concrete Eisenstein commutative ring.
; Every congruence uses component equivalence, never record identity.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias eisenstein-reflexive = ./eisenstein-equality.lim::eisenstein-reflexive)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-congruent = ./eisenstein-equality.lim::eisenstein-multiply-congruent)
(#alias exists = ./logic-exists.lim::exists)
(#alias eisenstein-one-multiply = ./eisenstein-cubic-bridge.lim::eisenstein-one-multiply)
(#alias eisenstein-multiply-one = ./eisenstein-ring.lim::eisenstein-multiply-one)
(#alias eisenstein-multiply-zero = ./eisenstein-ring.lim::eisenstein-multiply-zero)
(#alias eisenstein-multiply-associative = ./eisenstein-ring.lim::eisenstein-multiply-associative)
(#alias eisenstein-multiply-commutative = ./eisenstein-ring.lim::eisenstein-multiply-commutative)
(#theorem eisenstein-divides-reflexive
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ())))
  (#statement (#pt-app (#pt-use eisenstein-divides ()) number number))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            number
            (#pt-app (#pt-use eisenstein-multiply ()) number candidate-factor))))
      introduce
      (
        (#pt-use eisenstein-one ())
        (#pt-app
          (#pt-use eisenstein-symmetric ())
          (#pt-app (#pt-use eisenstein-multiply ()) number (#pt-use eisenstein-one ()))
          number
          (#pt-app (#pt-use eisenstein-multiply-one ()) number))))))
(#theorem eisenstein-one-divides
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ())))
  (#statement (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-one ()) number))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            number
            (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) candidate-factor))))
      introduce
      (number
        (#pt-app
          (#pt-use eisenstein-symmetric ())
          (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) number)
          number
          (#pt-app (#pt-use eisenstein-one-multiply ()) number))))))
(#theorem eisenstein-divides-zero
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use eisenstein ())))
  (#statement (#pt-app (#pt-use eisenstein-divides ()) divisor (#pt-use eisenstein-zero ())))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-use eisenstein-zero ())
            (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))
      introduce
      (
        (#pt-use eisenstein-zero ())
        (#pt-app
          (#pt-use eisenstein-symmetric ())
          (#pt-app (#pt-use eisenstein-multiply ()) divisor (#pt-use eisenstein-zero ()))
          (#pt-use eisenstein-zero ())
          (#pt-app (#pt-use eisenstein-multiply-zero ()) divisor))))))
(#theorem eisenstein-divides-congruent-target
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter number (#pt-use eisenstein ()))
    (#parameter other (#pt-use eisenstein ()))
    (#parameter equivalent (#pt-app (#pt-use eisenstein-equal ()) number other))
    (#parameter divides-proof (#pt-app (#pt-use eisenstein-divides ()) divisor number)))
  (#statement (#pt-app (#pt-use eisenstein-divides ()) divisor other))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            number
            (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  number
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))))
        (#pt-app (#pt-use eisenstein-divides ()) divisor other))
      (
        (#pt-lambda
          (
            (factor (#pt-use eisenstein ()))
            (factor-equivalence
              (#pt-app
                (#pt-use eisenstein-equal ())
                number
                (#pt-app (#pt-use eisenstein-multiply ()) divisor factor))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  other
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))
            introduce
            (factor
              (#pt-app
                (#pt-use eisenstein-transitive ())
                other
                number
                (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
                (#pt-app (#pt-use eisenstein-symmetric ()) number other equivalent)
                factor-equivalence)))))
      divides-proof)))
(#theorem eisenstein-divides-congruent-divisor
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter other-divisor (#pt-use eisenstein ()))
    (#parameter number (#pt-use eisenstein ()))
    (#parameter equivalent (#pt-app (#pt-use eisenstein-equal ()) divisor other-divisor))
    (#parameter divides-proof (#pt-app (#pt-use eisenstein-divides ()) divisor number)))
  (#statement (#pt-app (#pt-use eisenstein-divides ()) other-divisor number))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            number
            (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  number
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))))
        (#pt-app (#pt-use eisenstein-divides ()) other-divisor number))
      (
        (#pt-lambda
          (
            (factor (#pt-use eisenstein ()))
            (factor-equivalence
              (#pt-app
                (#pt-use eisenstein-equal ())
                number
                (#pt-app (#pt-use eisenstein-multiply ()) divisor factor))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  number
                  (#pt-app (#pt-use eisenstein-multiply ()) other-divisor candidate-factor))))
            introduce
            (factor
              (#pt-app
                (#pt-use eisenstein-transitive ())
                number
                (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
                (#pt-app (#pt-use eisenstein-multiply ()) other-divisor factor)
                factor-equivalence
                (#pt-app
                  (#pt-use eisenstein-multiply-congruent ())
                  divisor
                  factor
                  other-divisor
                  factor
                  equivalent
                  (#pt-app (#pt-use eisenstein-reflexive ()) factor)))))))
      divides-proof)))
(#theorem eisenstein-divides-transitive
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter other-divisor (#pt-use eisenstein ()))
    (#parameter number (#pt-use eisenstein ()))
    (#parameter first-divides (#pt-app (#pt-use eisenstein-divides ()) divisor other-divisor))
    (#parameter second-divides (#pt-app (#pt-use eisenstein-divides ()) other-divisor number)))
  (#statement (#pt-app (#pt-use eisenstein-divides ()) divisor number))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            other-divisor
            (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  other-divisor
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))))
        (#pt-app (#pt-use eisenstein-divides ()) divisor number))
      (
        (#pt-lambda
          (
            (first-factor (#pt-use eisenstein ()))
            (first-equivalence
              (#pt-app
                (#pt-use eisenstein-equal ())
                other-divisor
                (#pt-app (#pt-use eisenstein-multiply ()) divisor first-factor))))
          (#pt-induct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  number
                  (#pt-app (#pt-use eisenstein-multiply ()) other-divisor candidate-factor))))
            (#pt-lambda
              (
                (eisenstein-certificate
                  (#pt-app
                    (#pt-use exists (0))
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-factor (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use eisenstein-equal ())
                        number
                        (#pt-app (#pt-use eisenstein-multiply ()) other-divisor candidate-factor))))))
              (#pt-app (#pt-use eisenstein-divides ()) divisor number))
            (
              (#pt-lambda
                (
                  (second-factor (#pt-use eisenstein ()))
                  (second-equivalence
                    (#pt-app
                      (#pt-use eisenstein-equal ())
                      number
                      (#pt-app (#pt-use eisenstein-multiply ()) other-divisor second-factor))))
                (#pt-construct
                  exists
                  (0)
                  (
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-factor (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use eisenstein-equal ())
                        number
                        (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))
                  introduce
                  (
                    (#pt-app (#pt-use eisenstein-multiply ()) first-factor second-factor)
                    (#pt-app
                      (#pt-use eisenstein-transitive ())
                      number
                      (#pt-app (#pt-use eisenstein-multiply ()) other-divisor second-factor)
                      (#pt-app
                        (#pt-use eisenstein-multiply ())
                        divisor
                        (#pt-app (#pt-use eisenstein-multiply ()) first-factor second-factor))
                      second-equivalence
                      (#pt-app
                        (#pt-use eisenstein-transitive ())
                        (#pt-app (#pt-use eisenstein-multiply ()) other-divisor second-factor)
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          (#pt-app (#pt-use eisenstein-multiply ()) divisor first-factor)
                          second-factor)
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          divisor
                          (#pt-app (#pt-use eisenstein-multiply ()) first-factor second-factor))
                        (#pt-app
                          (#pt-use eisenstein-multiply-congruent ())
                          other-divisor
                          second-factor
                          (#pt-app (#pt-use eisenstein-multiply ()) divisor first-factor)
                          second-factor
                          first-equivalence
                          (#pt-app (#pt-use eisenstein-reflexive ()) second-factor))
                        (#pt-app
                          (#pt-use eisenstein-multiply-associative ())
                          divisor
                          first-factor
                          second-factor)))))))
            second-divides)))
      first-divides)))
(#theorem eisenstein-divides-product-left
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter number (#pt-use eisenstein ()))
    (#parameter other (#pt-use eisenstein ()))
    (#parameter divides-proof (#pt-app (#pt-use eisenstein-divides ()) divisor number)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-divides ())
      divisor
      (#pt-app (#pt-use eisenstein-multiply ()) number other)))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            number
            (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  number
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))))
        (#pt-app
          (#pt-use eisenstein-divides ())
          divisor
          (#pt-app (#pt-use eisenstein-multiply ()) number other)))
      (
        (#pt-lambda
          (
            (factor (#pt-use eisenstein ()))
            (factor-equivalence
              (#pt-app
                (#pt-use eisenstein-equal ())
                number
                (#pt-app (#pt-use eisenstein-multiply ()) divisor factor))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-multiply ()) number other)
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))
            introduce
            (
              (#pt-app (#pt-use eisenstein-multiply ()) factor other)
              (#pt-app
                (#pt-use eisenstein-transitive ())
                (#pt-app (#pt-use eisenstein-multiply ()) number other)
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
                  other)
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  divisor
                  (#pt-app (#pt-use eisenstein-multiply ()) factor other))
                (#pt-app
                  (#pt-use eisenstein-multiply-congruent ())
                  number
                  other
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
                  other
                  factor-equivalence
                  (#pt-app (#pt-use eisenstein-reflexive ()) other))
                (#pt-app (#pt-use eisenstein-multiply-associative ()) divisor factor other))))))
      divides-proof)))
(#theorem eisenstein-divides-product-right
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter number (#pt-use eisenstein ()))
    (#parameter other (#pt-use eisenstein ()))
    (#parameter divides-proof (#pt-app (#pt-use eisenstein-divides ()) divisor other)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-divides ())
      divisor
      (#pt-app (#pt-use eisenstein-multiply ()) number other)))
  (#proof
    (#pt-app
      (#pt-use eisenstein-divides-congruent-target ())
      divisor
      (#pt-app (#pt-use eisenstein-multiply ()) other number)
      (#pt-app (#pt-use eisenstein-multiply ()) number other)
      (#pt-app (#pt-use eisenstein-multiply-commutative ()) other number)
      (#pt-app (#pt-use eisenstein-divides-product-left ()) divisor other number divides-proof))))
(#theorem eisenstein-divisor-nonzero
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter number (#pt-use eisenstein ()))
    (#parameter number-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ())))) #pt-false))
    (#parameter divides-proof (#pt-app (#pt-use eisenstein-divides ()) divisor number)))
  (#statement
    (#pt-pi
      ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) divisor (#pt-use eisenstein-zero ()))))
      #pt-false))
  (#proof
    (#pt-lambda
      ((divisor-zero (#pt-app (#pt-use eisenstein-equal ()) divisor (#pt-use eisenstein-zero ()))))
      (#pt-induct
        exists
        (0)
        (
          (#pt-use eisenstein ())
          (#pt-lambda
            ((candidate-factor (#pt-use eisenstein ())))
            (#pt-app
              (#pt-use eisenstein-equal ())
              number
              (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))
        (#pt-lambda
          (
            (eisenstein-certificate
              (#pt-app
                (#pt-use exists (0))
                (#pt-use eisenstein ())
                (#pt-lambda
                  ((candidate-factor (#pt-use eisenstein ())))
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    number
                    (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))))
          #pt-false)
        (
          (#pt-lambda
            (
              (factor (#pt-use eisenstein ()))
              (factor-equivalence
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  number
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor factor))))
            (#pt-app
              number-nonzero
              (#pt-app
                (#pt-use eisenstein-transitive ())
                number
                (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
                (#pt-use eisenstein-zero ())
                factor-equivalence
                (#pt-app
                  (#pt-use eisenstein-transitive ())
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
                  (#pt-app (#pt-use eisenstein-multiply ()) factor (#pt-use eisenstein-zero ()))
                  (#pt-use eisenstein-zero ())
                  (#pt-app
                    (#pt-use eisenstein-transitive ())
                    (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
                    (#pt-app (#pt-use eisenstein-multiply ()) factor divisor)
                    (#pt-app (#pt-use eisenstein-multiply ()) factor (#pt-use eisenstein-zero ()))
                    (#pt-app (#pt-use eisenstein-multiply-commutative ()) divisor factor)
                    (#pt-app
                      (#pt-use eisenstein-multiply-congruent ())
                      factor
                      divisor
                      factor
                      (#pt-use eisenstein-zero ())
                      (#pt-app (#pt-use eisenstein-reflexive ()) factor)
                      divisor-zero))
                  (#pt-app (#pt-use eisenstein-multiply-zero ()) factor))))))
        divides-proof))))
