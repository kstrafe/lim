(#theorem rational-variable-change-discriminant
  (#universes)
  (#parameters
    (#parameter change (#pt-use rational-variable-change ()))
    (#parameter curve (#pt-use rational-weierstrass-curve ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-weierstrass-discriminant ())
        (#pt-app (#pt-use rational-variable-change-act ()) change curve))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project rational-variable-change 1 change)
          (#pt-numeral 12))
        (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve))))
  (#proof
    (#pt-app
      (#pt-use rational-cancel-1728 ())
      (#pt-app
        (#pt-use rational-weierstrass-discriminant ())
        (#pt-app (#pt-use rational-variable-change-act ()) change curve))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project rational-variable-change 1 change)
          (#pt-numeral 12))
        (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve))
      (#pt-app (#pt-use rational-variable-change-discriminant-scaled ()) change curve))))
