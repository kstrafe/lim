              (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve))
            (#pt-app
              (#pt-use rational-reflexive ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-project rational-variable-change 1 change)
                (#pt-numeral 12)))
            (#pt-app
              (#pt-use rational-symmetric ())
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-of-integer ())
                  (#pt-app
                    (#pt-use integer-of-natural ())
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 13))
                      (#pt-numeral 64))))
                (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve))
