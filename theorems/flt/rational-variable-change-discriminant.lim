(#theorem rational-c-numerator-congruent
  (#universes)
  (#parameters
    (#parameter c4 (#pt-use rational ()))
    (#parameter c6 (#pt-use rational ()))
    (#parameter other-c4 (#pt-use rational ()))
    (#parameter other-c6 (#pt-use rational ()))
    (#parameter c4-equivalence (#pt-app (#pt-use rational-equal ()) c4 other-c4))
    (#parameter c6-equivalence (#pt-app (#pt-use rational-equal ()) c6 other-c6)))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-negate ())
          (#pt-app (#pt-use rational-power ()) c6 (#pt-numeral 2))))
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app (#pt-use rational-power ()) other-c4 (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-negate ())
          (#pt-app (#pt-use rational-power ()) other-c6 (#pt-numeral 2))))))
  (#proof
    (#pt-app
      (#pt-use rational-add-congruent ())
      (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3))
      (#pt-app
        (#pt-use rational-negate ())
        (#pt-app (#pt-use rational-power ()) c6 (#pt-numeral 2)))
      (#pt-app (#pt-use rational-power ()) other-c4 (#pt-numeral 3))
      (#pt-app
        (#pt-use rational-negate ())
        (#pt-app (#pt-use rational-power ()) other-c6 (#pt-numeral 2)))
      (#pt-app (#pt-use rational-power-congruent ()) c4 other-c4 (#pt-numeral 3) c4-equivalence)
      (#pt-app
        (#pt-use rational-negate-congruent ())
        (#pt-app (#pt-use rational-power ()) c6 (#pt-numeral 2))
        (#pt-app (#pt-use rational-power ()) other-c6 (#pt-numeral 2))
        (#pt-app (#pt-use rational-power-congruent ()) c6 other-c6 (#pt-numeral 2) c6-equivalence)))))
(#theorem rational-variable-change-c-numerator
  (#universes)
  (#parameters
    (#parameter change (#pt-use rational-variable-change ()))
    (#parameter curve (#pt-use rational-weierstrass-curve ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app
            (#pt-use rational-weierstrass-c4 ())
            (#pt-app (#pt-use rational-variable-change-act ()) change curve))
          (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-negate ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app
              (#pt-use rational-weierstrass-c6 ())
              (#pt-app (#pt-use rational-variable-change-act ()) change curve))
            (#pt-numeral 2))))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project rational-variable-change 1 change)
          (#pt-numeral 12))
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app (#pt-use rational-weierstrass-c4 ()) curve)
            (#pt-numeral 3))
          (#pt-app
            (#pt-use rational-negate ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-app (#pt-use rational-weierstrass-c6 ()) curve)
              (#pt-numeral 2)))))))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app
            (#pt-use rational-weierstrass-c4 ())
            (#pt-app (#pt-use rational-variable-change-act ()) change curve))
          (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-negate ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app
              (#pt-use rational-weierstrass-c6 ())
              (#pt-app (#pt-use rational-variable-change-act ()) change curve))
            (#pt-numeral 2))))
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-project rational-variable-change 1 change)
              (#pt-numeral 4))
            (#pt-app (#pt-use rational-weierstrass-c4 ()) curve))
          (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-negate ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-project rational-variable-change 1 change)
                (#pt-numeral 6))
              (#pt-app (#pt-use rational-weierstrass-c6 ()) curve))
            (#pt-numeral 2))))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project rational-variable-change 1 change)
          (#pt-numeral 12))
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app (#pt-use rational-weierstrass-c4 ()) curve)
            (#pt-numeral 3))
          (#pt-app
            (#pt-use rational-negate ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-app (#pt-use rational-weierstrass-c6 ()) curve)
              (#pt-numeral 2)))))
      (#pt-app
        (#pt-use rational-c-numerator-congruent ())
        (#pt-app
          (#pt-use rational-weierstrass-c4 ())
          (#pt-app (#pt-use rational-variable-change-act ()) change curve))
        (#pt-app
          (#pt-use rational-weierstrass-c6 ())
          (#pt-app (#pt-use rational-variable-change-act ()) change curve))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-project rational-variable-change 1 change)
            (#pt-numeral 4))
          (#pt-app (#pt-use rational-weierstrass-c4 ()) curve))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-project rational-variable-change 1 change)
            (#pt-numeral 6))
          (#pt-app (#pt-use rational-weierstrass-c6 ()) curve))
        (#pt-app (#pt-use rational-variable-change-c4 ()) change curve)
        (#pt-app (#pt-use rational-variable-change-c6 ()) change curve))
      (#pt-app
        (#pt-use rational-c-invariants-weight-polynomial ())
        (#pt-project rational-variable-change 1 change)
        (#pt-app (#pt-use rational-weierstrass-c4 ()) curve)
        (#pt-app (#pt-use rational-weierstrass-c6 ()) curve)))))
(#theorem rational-variable-change-discriminant-scaled
  (#universes)
  (#parameters
