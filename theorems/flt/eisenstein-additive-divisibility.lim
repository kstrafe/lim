  =
  ./eisenstein-divisibility.lim::eisenstein-divides-product-right)
(#theorem eisenstein-zero-add
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app (#pt-use eisenstein-add ()) (#pt-use eisenstein-zero ()) first)
      first))
  (#proof
    (#pt-app
      (#pt-use eisenstein-transitive ())
      (#pt-app (#pt-use eisenstein-add ()) (#pt-use eisenstein-zero ()) first)
      (#pt-app (#pt-use eisenstein-add ()) first (#pt-use eisenstein-zero ()))
      first
      (#pt-app (#pt-use eisenstein-add-commutative ()) (#pt-use eisenstein-zero ()) first)
      (#pt-app (#pt-use eisenstein-add-zero ()) first))))
(#theorem eisenstein-add-after-subtract
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app (#pt-use eisenstein-add ()) first (#pt-app (#pt-use eisenstein-negate ()) second))
        second)
      first))
  (#proof
    (#pt-app
      (#pt-use eisenstein-transitive ())
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app (#pt-use eisenstein-add ()) first (#pt-app (#pt-use eisenstein-negate ()) second))
        second)
      (#pt-app
        (#pt-use eisenstein-add ())
        first
        (#pt-app (#pt-use eisenstein-add ()) (#pt-app (#pt-use eisenstein-negate ()) second) second))
      first
      (#pt-app
        (#pt-use eisenstein-add-associative ())
        first
        (#pt-app (#pt-use eisenstein-negate ()) second)
        second)
      (#pt-app
        (#pt-use eisenstein-transitive ())
        (#pt-app
          (#pt-use eisenstein-add ())
          first
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-negate ()) second)
            second))
        (#pt-app
          (#pt-use eisenstein-add ())
          first
          (#pt-app
            (#pt-use eisenstein-add ())
            second
            (#pt-app (#pt-use eisenstein-negate ()) second)))
        first
        (#pt-app
          (#pt-use eisenstein-add-congruent ())
          first
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-negate ()) second)
            second)
          first
          (#pt-app
            (#pt-use eisenstein-add ())
            second
            (#pt-app (#pt-use eisenstein-negate ()) second))
          (#pt-app (#pt-use eisenstein-reflexive ()) first)
          (#pt-app
            (#pt-use eisenstein-add-commutative ())
            (#pt-app (#pt-use eisenstein-negate ()) second)
            second))
        (#pt-app
          (#pt-use eisenstein-transitive ())
          (#pt-app
            (#pt-use eisenstein-add ())
            first
            (#pt-app
              (#pt-use eisenstein-add ())
              second
              (#pt-app (#pt-use eisenstein-negate ()) second)))
          (#pt-app (#pt-use eisenstein-add ()) first (#pt-use eisenstein-zero ()))
          first
          (#pt-app
            (#pt-use eisenstein-add-congruent ())
            first
            (#pt-app
              (#pt-use eisenstein-add ())
              second
              (#pt-app (#pt-use eisenstein-negate ()) second))
            first
            (#pt-use eisenstein-zero ())
            (#pt-app (#pt-use eisenstein-reflexive ()) first)
            (#pt-app (#pt-use eisenstein-add-inverse ()) second))
          (#pt-app (#pt-use eisenstein-add-zero ()) first))))))
(#theorem eisenstein-divides-negative-target
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter first (#pt-use eisenstein ()))
    (#parameter divides-proof (#pt-app (#pt-use eisenstein-divides ()) divisor first)))
  (#statement
    (#pt-app (#pt-use eisenstein-divides ()) divisor (#pt-app (#pt-use eisenstein-negate ()) first)))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            first
            (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  first
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))))
        (#pt-app
          (#pt-use eisenstein-divides ())
          divisor
          (#pt-app (#pt-use eisenstein-negate ()) first)))
      (
        (#pt-lambda
          (
            (factor (#pt-use eisenstein ()))
            (factor-equivalence
              (#pt-app
                (#pt-use eisenstein-equal ())
                first
                (#pt-app (#pt-use eisenstein-multiply ()) divisor factor))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-negate ()) first)
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))
            introduce
            (
              (#pt-app (#pt-use eisenstein-negate ()) factor)
              (#pt-app
                (#pt-use eisenstein-transitive ())
                (#pt-app (#pt-use eisenstein-negate ()) first)
                (#pt-app
                  (#pt-use eisenstein-negate ())
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor factor))
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  divisor
                  (#pt-app (#pt-use eisenstein-negate ()) factor))
                (#pt-app
                  (#pt-use eisenstein-negate-congruent ())
                  first
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
                  factor-equivalence)
                (#pt-app
                  (#pt-use eisenstein-symmetric ())
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    divisor
                    (#pt-app (#pt-use eisenstein-negate ()) factor))
                  (#pt-app
                    (#pt-use eisenstein-negate ())
                    (#pt-app (#pt-use eisenstein-multiply ()) divisor factor))
                  (#pt-app (#pt-use eisenstein-multiply-negative-second ()) divisor factor)))))))
      divides-proof)))
(#theorem eisenstein-divides-add
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter first-divides (#pt-app (#pt-use eisenstein-divides ()) divisor first))
    (#parameter second-divides (#pt-app (#pt-use eisenstein-divides ()) divisor second)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-divides ())
      divisor
      (#pt-app (#pt-use eisenstein-add ()) first second)))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            first
            (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  first
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))))
        (#pt-app
          (#pt-use eisenstein-divides ())
          divisor
          (#pt-app (#pt-use eisenstein-add ()) first second)))
      (
        (#pt-lambda
          (
            (factor (#pt-use eisenstein ()))
            (first-equivalence
              (#pt-app
                (#pt-use eisenstein-equal ())
                first
                (#pt-app (#pt-use eisenstein-multiply ()) divisor factor))))
          (#pt-induct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  second
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))
            (#pt-lambda
              (
                (eisenstein-certificate
                  (#pt-app
                    (#pt-use exists (0))
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-factor (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use eisenstein-equal ())
                        second
                        (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))))
              (#pt-app
                (#pt-use eisenstein-divides ())
                divisor
                (#pt-app (#pt-use eisenstein-add ()) first second)))
            (
              (#pt-lambda
                (
                  (other-factor (#pt-use eisenstein ()))
                  (second-equivalence
                    (#pt-app
                      (#pt-use eisenstein-equal ())
                      second
                      (#pt-app (#pt-use eisenstein-multiply ()) divisor other-factor))))
                (#pt-construct
                  exists
                  (0)
                  (
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-factor (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use eisenstein-equal ())
                        (#pt-app (#pt-use eisenstein-add ()) first second)
                        (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))
                  introduce
                  (
                    (#pt-app (#pt-use eisenstein-add ()) factor other-factor)
                    (#pt-app
                      (#pt-use eisenstein-transitive ())
                      (#pt-app (#pt-use eisenstein-add ()) first second)
                      (#pt-app
                        (#pt-use eisenstein-add ())
                        (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
                        (#pt-app (#pt-use eisenstein-multiply ()) divisor other-factor))
                      (#pt-app
                        (#pt-use eisenstein-multiply ())
                        divisor
                        (#pt-app (#pt-use eisenstein-add ()) factor other-factor))
                      (#pt-app
                        (#pt-use eisenstein-add-congruent ())
                        first
                        second
                        (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
                        (#pt-app (#pt-use eisenstein-multiply ()) divisor other-factor)
                        first-equivalence
                        second-equivalence)
                      (#pt-app
                        (#pt-use eisenstein-symmetric ())
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          divisor
                          (#pt-app (#pt-use eisenstein-add ()) factor other-factor))
                        (#pt-app
                          (#pt-use eisenstein-add ())
                          (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
                          (#pt-app (#pt-use eisenstein-multiply ()) divisor other-factor))
                        (#pt-app
                          (#pt-use eisenstein-multiply-distribute-second ())
                          divisor
                          factor
                          other-factor)))))))
            second-divides)))
      first-divides)))
(#theorem eisenstein-divides-add-cancel-left
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter first-divides (#pt-app (#pt-use eisenstein-divides ()) divisor first))
    (#parameter sum-divides (#pt-app (#pt-use eisenstein-divides ()) divisor (#pt-app (#pt-use eisenstein-add ()) first second))))
  (#statement (#pt-app (#pt-use eisenstein-divides ()) divisor second))
  (#proof
    (#pt-app
      (#pt-use eisenstein-divides-congruent-target ())
      divisor
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app (#pt-use eisenstein-add ()) first second)
        (#pt-app (#pt-use eisenstein-negate ()) first))
      second
      (#pt-app
        (#pt-use eisenstein-transitive ())
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app (#pt-use eisenstein-add ()) first second)
          (#pt-app (#pt-use eisenstein-negate ()) first))
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app (#pt-use eisenstein-add ()) second first)
          (#pt-app (#pt-use eisenstein-negate ()) first))
        second
        (#pt-app
          (#pt-use eisenstein-add-congruent ())
          (#pt-app (#pt-use eisenstein-add ()) first second)
          (#pt-app (#pt-use eisenstein-negate ()) first)
          (#pt-app (#pt-use eisenstein-add ()) second first)
          (#pt-app (#pt-use eisenstein-negate ()) first)
          (#pt-app (#pt-use eisenstein-add-commutative ()) first second)
          (#pt-app (#pt-use eisenstein-reflexive ()) (#pt-app (#pt-use eisenstein-negate ()) first)))
        (#pt-app
          (#pt-use eisenstein-transitive ())
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-add ()) second first)
            (#pt-app (#pt-use eisenstein-negate ()) first))
          (#pt-app
            (#pt-use eisenstein-add ())
            second
            (#pt-app
              (#pt-use eisenstein-add ())
              first
              (#pt-app (#pt-use eisenstein-negate ()) first)))
          second
          (#pt-app
            (#pt-use eisenstein-add-associative ())
            second
            first
            (#pt-app (#pt-use eisenstein-negate ()) first))
          (#pt-app
            (#pt-use eisenstein-transitive ())
            (#pt-app
              (#pt-use eisenstein-add ())
              second
              (#pt-app
                (#pt-use eisenstein-add ())
                first
                (#pt-app (#pt-use eisenstein-negate ()) first)))
            (#pt-app (#pt-use eisenstein-add ()) second (#pt-use eisenstein-zero ()))
            second
            (#pt-app
              (#pt-use eisenstein-add-congruent ())
              second
              (#pt-app
                (#pt-use eisenstein-add ())
                first
                (#pt-app (#pt-use eisenstein-negate ()) first))
              second
              (#pt-use eisenstein-zero ())
              (#pt-app (#pt-use eisenstein-reflexive ()) second)
              (#pt-app (#pt-use eisenstein-add-inverse ()) first))
            (#pt-app (#pt-use eisenstein-add-zero ()) second))))
      (#pt-app
        (#pt-use eisenstein-divides-add ())
        divisor
        (#pt-app (#pt-use eisenstein-add ()) first second)
        (#pt-app (#pt-use eisenstein-negate ()) first)
        sum-divides
        (#pt-app (#pt-use eisenstein-divides-negative-target ()) divisor first first-divides)))))
(#theorem eisenstein-divides-add-cancel-right
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter second-divides (#pt-app (#pt-use eisenstein-divides ()) divisor second))
    (#parameter sum-divides (#pt-app (#pt-use eisenstein-divides ()) divisor (#pt-app (#pt-use eisenstein-add ()) first second))))
  (#statement (#pt-app (#pt-use eisenstein-divides ()) divisor first))
  (#proof
    (#pt-app
      (#pt-use eisenstein-divides-add-cancel-left ())
      divisor
      second
      first
      second-divides
      (#pt-app
        (#pt-use eisenstein-divides-congruent-target ())
        divisor
        (#pt-app (#pt-use eisenstein-add ()) first second)
        (#pt-app (#pt-use eisenstein-add ()) second first)
        (#pt-app (#pt-use eisenstein-add-commutative ()) first second)
        sum-divides))))
(#theorem eisenstein-unit-divisibility-reflect
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter number (#pt-use eisenstein ()))
    (#parameter unit-proof (#pt-app (#pt-use eisenstein-unit ()) unit))
    (#parameter product-divides (#pt-app (#pt-use eisenstein-divides ()) divisor (#pt-app (#pt-use eisenstein-multiply ()) unit number))))
  (#statement (#pt-app (#pt-use eisenstein-divides ()) divisor number))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-inverse (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app (#pt-use eisenstein-multiply ()) unit candidate-inverse)
              (#pt-use eisenstein-one ()))
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app (#pt-use eisenstein-multiply ()) candidate-inverse unit)
              (#pt-use eisenstein-one ())))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-inverse (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) unit candidate-inverse)
                    (#pt-use eisenstein-one ()))
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) candidate-inverse unit)
                    (#pt-use eisenstein-one ())))))))
        (#pt-app (#pt-use eisenstein-divides ()) divisor number))
      (
        (#pt-lambda
          (
            (inverse (#pt-use eisenstein ()))
            (inverse-equations
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-multiply ()) unit inverse)
                  (#pt-use eisenstein-one ()))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-multiply ()) inverse unit)
                  (#pt-use eisenstein-one ())))))
          (#pt-app
            (#pt-use eisenstein-divides-congruent-target ())
            divisor
            (#pt-app
              (#pt-use eisenstein-multiply ())
              inverse
              (#pt-app (#pt-use eisenstein-multiply ()) unit number))
            number
            (#pt-app
              (#pt-use eisenstein-transitive ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                inverse
                (#pt-app (#pt-use eisenstein-multiply ()) unit number))
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app (#pt-use eisenstein-multiply ()) inverse unit)
                number)
              number
              (#pt-app
                (#pt-use eisenstein-symmetric ())
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app (#pt-use eisenstein-multiply ()) inverse unit)
                  number)
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  inverse
                  (#pt-app (#pt-use eisenstein-multiply ()) unit number))
                (#pt-app (#pt-use eisenstein-multiply-associative ()) inverse unit number))
              (#pt-app
                (#pt-use eisenstein-transitive ())
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app (#pt-use eisenstein-multiply ()) inverse unit)
                  number)
                (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) number)
                number
                (#pt-app
                  (#pt-use eisenstein-multiply-congruent ())
                  (#pt-app (#pt-use eisenstein-multiply ()) inverse unit)
                  number
                  (#pt-use eisenstein-one ())
                  number
                  (#pt-app
                    (#pt-use conjunction-right ())
                    (#pt-app
                      (#pt-use eisenstein-equal ())
                      (#pt-app (#pt-use eisenstein-multiply ()) unit inverse)
                      (#pt-use eisenstein-one ()))
                    (#pt-app
                      (#pt-use eisenstein-equal ())
                      (#pt-app (#pt-use eisenstein-multiply ()) inverse unit)
                      (#pt-use eisenstein-one ()))
                    inverse-equations)
                  (#pt-app (#pt-use eisenstein-reflexive ()) number))
                (#pt-app (#pt-use eisenstein-one-multiply ()) number)))
            (#pt-app
              (#pt-use eisenstein-divides-product-right ())
              divisor
              inverse
              (#pt-app (#pt-use eisenstein-multiply ()) unit number)
              product-divides))))
      unit-proof)))
(#theorem eisenstein-add-subtract-right
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app (#pt-use eisenstein-add ()) first second)
        (#pt-app (#pt-use eisenstein-negate ()) second))
      first))
  (#proof
    (#pt-app
      (#pt-use eisenstein-transitive ())
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app (#pt-use eisenstein-add ()) first second)
        (#pt-app (#pt-use eisenstein-negate ()) second))
      (#pt-app
        (#pt-use eisenstein-add ())
        first
        (#pt-app (#pt-use eisenstein-add ()) second (#pt-app (#pt-use eisenstein-negate ()) second)))
      first
      (#pt-app
        (#pt-use eisenstein-add-associative ())
        first
        second
        (#pt-app (#pt-use eisenstein-negate ()) second))
      (#pt-app
        (#pt-use eisenstein-transitive ())
        (#pt-app
          (#pt-use eisenstein-add ())
          first
          (#pt-app
            (#pt-use eisenstein-add ())
            second
            (#pt-app (#pt-use eisenstein-negate ()) second)))
        (#pt-app (#pt-use eisenstein-add ()) first (#pt-use eisenstein-zero ()))
        first
        (#pt-app
          (#pt-use eisenstein-add-congruent ())
          first
          (#pt-app
            (#pt-use eisenstein-add ())
            second
            (#pt-app (#pt-use eisenstein-negate ()) second))
          first
          (#pt-use eisenstein-zero ())
          (#pt-app (#pt-use eisenstein-reflexive ()) first)
          (#pt-app (#pt-use eisenstein-add-inverse ()) second))
        (#pt-app (#pt-use eisenstein-add-zero ()) first)))))
