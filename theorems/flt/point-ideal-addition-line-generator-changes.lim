(#theorem point-ideal-addition-first-generator-change
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter quadratic-linear (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter quadratic-constant (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter line-first-x Carrier)
    (#parameter line-first-y Carrier)
    (#parameter slope Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
      (#pt-app
        (#pt-use quadratic-ring-structure ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        quadratic-linear
        quadratic-constant)
      (#pt-app
        (#pt-use coordinate-point-ideal-XY ())
        Carrier
        coefficient-ring
        quadratic-linear
        quadratic-constant
        line-first-x
        (#pt-construct
          finite-list
          ()
          (Carrier)
          cons
          (line-first-y (#pt-construct finite-list () (Carrier) nil ()))))
      (#pt-app
        (#pt-use coordinate-point-ideal-XY ())
        Carrier
        coefficient-ring
        quadratic-linear
        quadratic-constant
        line-first-x
        (#pt-app
          (#pt-use point-ideal-addition-line-polynomial ())
          Carrier
          coefficient-ring
          line-first-x
          line-first-y
          slope))))
  (#proof
    (#pt-app
      (#pt-use point-ideal-product-same-value-ideals ())
      Carrier
      coefficient-ring
      quadratic-linear
      quadratic-constant
      line-first-x
      (#pt-construct
        finite-list
        ()
        (Carrier)
        cons
        (line-first-y (#pt-construct finite-list () (Carrier) nil ())))
      (#pt-app
        (#pt-use point-ideal-addition-line-polynomial ())
        Carrier
        coefficient-ring
        line-first-x
        line-first-y
        slope)
      (#pt-app
        (#pt-use ring-transitive ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-evaluate ())
          Carrier
          coefficient-ring
          (#pt-construct
            finite-list
            ()
            (Carrier)
            cons
            (line-first-y (#pt-construct finite-list () (Carrier) nil ())))
          line-first-x)
        line-first-y
        (#pt-app
          (#pt-use ring-polynomial-evaluate ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use point-ideal-addition-line-polynomial ())
            Carrier
            coefficient-ring
            line-first-x
            line-first-y
            slope)
          line-first-x)
        (#pt-app
          (#pt-use polynomial-root-evaluate-constant ())
          Carrier
          coefficient-ring
          line-first-x
          line-first-y)
        (#pt-app
          (#pt-use ring-symmetric ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-evaluate ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use point-ideal-addition-line-polynomial ())
              Carrier
              coefficient-ring
              line-first-x
              line-first-y
              slope)
            line-first-x)
          line-first-y
          (#pt-app
            (#pt-use point-ideal-addition-line-first ())
            Carrier
            coefficient-ring
            line-first-x
            line-first-y
            slope))))))
