(#theorem finite-reduction-multiple
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter number #pt-nat)
    (#parameter quotient #pt-nat)
    (#parameter multiple-equation (#pt-eq #pt-nat number (#pt-app (#pt-use multiply ()) quotient modulus))))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-of-natural ()) modulus positive-modulus number))
      #pt-zero))
  (#proof
    (#pt-app
      (#pt-use finite-reduction-from-division ())
      modulus
      positive-modulus
      number
      quotient
      #pt-zero
      (#pt-app
        (#pt-use conjunction-introduce ())
        (#pt-eq
          #pt-nat
          number
          (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) quotient modulus) #pt-zero))
        (#pt-app (#pt-use less-than ()) #pt-zero modulus)
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          number
          (#pt-app (#pt-use multiply ()) quotient modulus)
          (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) quotient modulus) #pt-zero)
          multiple-equation
          (#pt-app
            (#pt-use symmetry (0))
            #pt-nat
            (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) quotient modulus) #pt-zero)
            (#pt-app (#pt-use multiply ()) quotient modulus)
            (#pt-app (#pt-use add-zero-right ()) (#pt-app (#pt-use multiply ()) quotient modulus))))
        positive-modulus))))
