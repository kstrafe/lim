(#math-inductive finite-residue ()
  ((size #pt-nat))
  (#pt-type 0)
  ((representative ((value #pt-nat) (range (#pt-app (#pt-use less-than ()) value size))))))
(#math-definition finite-residue-value ()
  (#pt-pi ((modulus #pt-nat) (residue (#pt-app (#pt-use finite-residue ()) modulus))) #pt-nat)
  (#pt-lambda
    ((modulus #pt-nat) (residue (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-project finite-residue 0 residue)))
(#math-definition finite-residue-equal ()
  (#pt-pi
    (
      (modulus #pt-nat)
      (first (#pt-app (#pt-use finite-residue ()) modulus))
      (second (#pt-app (#pt-use finite-residue ()) modulus)))
    #pt-prop)
  (#pt-lambda
    (
      (modulus #pt-nat)
      (first (#pt-app (#pt-use finite-residue ()) modulus))
      (second (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-eq #pt-nat (#pt-project finite-residue 0 first) (#pt-project finite-residue 0 second))))
(#math-definition finite-residue-of-natural ()
  (#pt-pi
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (number #pt-nat))
    (#pt-app (#pt-use finite-residue ()) modulus))
  (#pt-lambda
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (number #pt-nat))
    (#pt-construct
      finite-residue
      ()
      (modulus)
      representative
      (
        (#pt-project
          natural-division-data
          1
          (#pt-app (#pt-use compute-natural-division ()) modulus positive-modulus number))
        (#pt-app
          (#pt-use conjunction-right ())
          (#pt-eq
            #pt-nat
            number
            (#pt-app
              (#pt-use add ())
              (#pt-app
                (#pt-use multiply ())
                (#pt-project
                  natural-division-data
                  0
                  (#pt-app (#pt-use compute-natural-division ()) modulus positive-modulus number))
                modulus)
              (#pt-project
                natural-division-data
                1
                (#pt-app (#pt-use compute-natural-division ()) modulus positive-modulus number))))
          (#pt-app
            (#pt-use less-than ())
            (#pt-project
              natural-division-data
              1
              (#pt-app (#pt-use compute-natural-division ()) modulus positive-modulus number))
            modulus)
          (#pt-project
            natural-division-data
            2
            (#pt-app (#pt-use compute-natural-division ()) modulus positive-modulus number)))))))
(#theorem finite-residue-value-in-range
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter residue (#pt-app (#pt-use finite-residue ()) modulus)))
  (#statement (#pt-app (#pt-use less-than ()) (#pt-project finite-residue 0 residue) modulus))
  (#proof (#pt-project finite-residue 1 residue)))
(#theorem finite-reduction-certificate
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter number #pt-nat))
  (#statement
