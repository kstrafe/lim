      (#pt-app (#pt-use compute-natural-division ()) modulus positive-modulus number))))
(#theorem finite-reduction-from-division
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter number #pt-nat)
    (#parameter quotient #pt-nat)
    (#parameter remainder #pt-nat)
    (#parameter division-certificate (#pt-app (#pt-use division-spec ()) number modulus quotient remainder)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-of-natural ()) modulus positive-modulus number))
      remainder))
  (#proof
    (#pt-app
      (#pt-use conjunction-right ())
      (#pt-eq
        #pt-nat
        (#pt-project
          natural-division-data
          0
          (#pt-app (#pt-use compute-natural-division ()) modulus positive-modulus number))
        quotient)
      (#pt-eq
        #pt-nat
        (#pt-project
          finite-residue
          0
          (#pt-app (#pt-use finite-residue-of-natural ()) modulus positive-modulus number))
        remainder)
      (#pt-app
        (#pt-use division-unique ())
        number
        modulus
        (#pt-project
          natural-division-data
          0
          (#pt-app (#pt-use compute-natural-division ()) modulus positive-modulus number))
        (#pt-project
          finite-residue
          0
          (#pt-app (#pt-use finite-residue-of-natural ()) modulus positive-modulus number))
        quotient
        remainder
        (#pt-app (#pt-use finite-reduction-certificate ()) modulus positive-modulus number)
        division-certificate))))
(#theorem finite-reduction-small
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter number #pt-nat)
    (#parameter number-in-range (#pt-app (#pt-use less-than ()) number modulus)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-of-natural ()) modulus positive-modulus number))
      number))
  (#proof
    (#pt-app
      (#pt-use finite-reduction-from-division ())
      modulus
      positive-modulus
      number
      #pt-zero
      number
      (#pt-app
        (#pt-use conjunction-introduce ())
        (#pt-eq
          #pt-nat
          number
          (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) #pt-zero modulus) number))
