; finite ZMod branch in the pinned FLT reduction definitions.
; Equality compares values, never proof-carrying record identity.
; Modulus zero is deliberately not represented by this finite type.
(#alias add = ./../fermat_statement.lim::add)
(#alias multiply = ./../fermat_statement.lim::multiply)
