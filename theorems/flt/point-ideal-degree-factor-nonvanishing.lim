(#alias ring-zero-multiply = ./commutative-ring-elementary-laws.lim::ring-zero-multiply)
(#theorem point-ideal-degree-middle-nonzero
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
    (#parameter root Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter first-factor (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter second-factor (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter forward-equation (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring polynomial (#pt-app (#pt-use ring-polynomial-multiply ()) Carrier coefficient-ring (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root) first-factor)))
    (#parameter reverse-equation (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root) (#pt-app (#pt-use ring-polynomial-multiply ()) Carrier coefficient-ring polynomial second-factor))))
  (#statement
    (#pt-pi
      (
        (denied-evidence
          (#pt-app
            (#pt-use ring-polynomial-equal ())
            Carrier
            coefficient-ring
            polynomial
            (#pt-construct finite-list () (Carrier) nil ()))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (zero-equation
          (#pt-app
            (#pt-use ring-polynomial-equal ())
            Carrier
            coefficient-ring
            polynomial
            (#pt-construct finite-list () (Carrier) nil ()))))
      (#pt-app
        (#pt-app
          (#pt-use ring-polynomial-domain-one-nonzero ())
          Carrier
          coefficient-ring
          coefficient-domain)
        (#pt-app
          (#pt-app
            (#pt-use ring-polynomial-transitive ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
            (#pt-app
              (#pt-use ring-polynomial-multiply ())
              Carrier
              coefficient-ring
              polynomial
              second-factor)
            (#pt-construct finite-list () (Carrier) nil ())
            reverse-equation
            (#pt-app
              (#pt-use ring-polynomial-transitive ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-multiply ())
                Carrier
                coefficient-ring
                polynomial
                second-factor)
              (#pt-app
                (#pt-use ring-polynomial-multiply ())
                Carrier
                coefficient-ring
                (#pt-construct finite-list () (Carrier) nil ())
                second-factor)
              (#pt-construct finite-list () (Carrier) nil ())
              (#pt-app
                (#pt-use ring-polynomial-multiply-congruent ())
                Carrier
                coefficient-ring
                polynomial
                second-factor
                (#pt-construct finite-list () (Carrier) nil ())
                second-factor
                zero-equation
                (#pt-app
                  (#pt-use ring-polynomial-reflexive ())
                  Carrier
                  coefficient-ring
                  second-factor))
              (#pt-app
                (#pt-use ring-zero-multiply ())
                (#pt-app (#pt-use finite-list ()) Carrier)
                (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
                second-factor)))
          (#pt-numeral 1))))))
