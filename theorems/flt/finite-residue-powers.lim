(#math-definition finite-residue-power ()
  (#pt-pi
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (first (#pt-app (#pt-use finite-residue ()) modulus))
      (exponent #pt-nat))
    (#pt-app (#pt-use finite-residue ()) modulus))
  (#pt-lambda
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (first (#pt-app (#pt-use finite-residue ()) modulus))
      (exponent #pt-nat))
    (#pt-nat-induct
      (#pt-lambda ((power-index #pt-nat)) (#pt-app (#pt-use finite-residue ()) modulus))
      (#pt-app (#pt-use finite-residue-one ()) modulus positive-modulus)
      (#pt-lambda
        ((earlier-index #pt-nat) (earlier-power (#pt-app (#pt-use finite-residue ()) modulus)))
        (#pt-app (#pt-use finite-residue-multiply ()) modulus positive-modulus first earlier-power))
      exponent)))
(#theorem finite-residue-power-zero
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter first (#pt-app (#pt-use finite-residue ()) modulus)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-power ()) modulus positive-modulus first #pt-zero))
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-one ()) modulus positive-modulus))))
  (#proof
    (#pt-refl
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-one ()) modulus positive-modulus)))))
(#theorem finite-residue-power-successor
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter first (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter exponent #pt-nat))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-residue-power ())
          modulus
          positive-modulus
          first
          (#pt-succ exponent)))
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-residue-multiply ())
          modulus
          positive-modulus
          first
          (#pt-app (#pt-use finite-residue-power ()) modulus positive-modulus first exponent)))))
  (#proof
    (#pt-refl
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-residue-multiply ())
          modulus
          positive-modulus
          first
          (#pt-app (#pt-use finite-residue-power ()) modulus positive-modulus first exponent))))))
(#theorem finite-residue-power-congruent
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter first (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter exponent #pt-nat)
    (#parameter equation (#pt-eq #pt-nat (#pt-project finite-residue 0 first) (#pt-project finite-residue 0 second))))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-power ()) modulus positive-modulus first exponent))
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-power ()) modulus positive-modulus second exponent))))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((power-index #pt-nat))
        (#pt-eq
          #pt-nat
          (#pt-project
            finite-residue
            0
            (#pt-app (#pt-use finite-residue-power ()) modulus positive-modulus first power-index))
          (#pt-project
            finite-residue
            0
            (#pt-app (#pt-use finite-residue-power ()) modulus positive-modulus second power-index))))
      (#pt-refl
        #pt-nat
        (#pt-project
          finite-residue
          0
          (#pt-app (#pt-use finite-residue-one ()) modulus positive-modulus)))
      (#pt-lambda
        (
          (earlier-index #pt-nat)
          (earlier-equation
            (#pt-eq
              #pt-nat
              (#pt-project
                finite-residue
                0
                (#pt-app
                  (#pt-use finite-residue-power ())
                  modulus
                  positive-modulus
                  first
                  earlier-index))
              (#pt-project
                finite-residue
                0
                (#pt-app
                  (#pt-use finite-residue-power ())
                  modulus
                  positive-modulus
                  second
                  earlier-index)))))
        (#pt-app
          (#pt-use finite-residue-multiply-congruent ())
          modulus
          positive-modulus
          first
          (#pt-app (#pt-use finite-residue-power ()) modulus positive-modulus first earlier-index)
          second
          (#pt-app (#pt-use finite-residue-power ()) modulus positive-modulus second earlier-index)
          equation
          earlier-equation))
      exponent)))
