; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Prove the two-coefficient presentation equals
; the actual span of the two generators. Their order does not change
; the ideal, by the already proved sum commutativity law.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias disjunction-left = ./logical-connectives.lim::disjunction-left)
(#alias disjunction-right = ./logical-connectives.lim::disjunction-right)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-ideal-equal = ./ring-ideal-data.lim::ring-ideal-equal)
(#alias ring-ideal-member = ./ring-ideal-data.lim::ring-ideal-member)
(#alias ring-ideal-member-congruent = ./ring-ideal-data.lim::ring-ideal-member-congruent)
(#alias ring-ideal-pair = ./ring-ideal-pair.lim::ring-ideal-pair)
(#alias ring-ideal-pair-first = ./ring-ideal-pair.lim::ring-ideal-pair-first)
(#alias ring-ideal-pair-least = ./ring-ideal-pair.lim::ring-ideal-pair-least)
(#alias ring-ideal-pair-second = ./ring-ideal-pair.lim::ring-ideal-pair-second)
(#alias ring-ideal-principal = ./ring-ideal-principal.lim::ring-ideal-principal)
(#alias ring-ideal-span = ./ring-ideal-span-construction.lim::ring-ideal-span)
(#alias ring-ideal-span-generator = ./ring-ideal-span-construction.lim::ring-ideal-span-generator)
(#alias ring-ideal-span-least = ./ring-ideal-span-universal.lim::ring-ideal-span-least)
(#alias ring-ideal-subset = ./ring-ideal-data.lim::ring-ideal-subset)
(#alias ring-ideal-sum-commutative = ./ring-ideal-sum-universal.lim::ring-ideal-sum-commutative)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#alias ring-symmetric = ./commutative-ring-data.lim::ring-symmetric)
(#theorem ring-ideal-pair-span
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-element Carrier)
    (#parameter second-element Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring first-element second-element)
      (#pt-app
        (#pt-use ring-ideal-span ())
        Carrier
        coefficient-ring
        (#pt-lambda
          ((element Carrier))
          (#pt-app
            (#pt-use disjunction ())
            (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element first-element)
            (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element second-element))))))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring first-element second-element)
        (#pt-app
          (#pt-use ring-ideal-span ())
          Carrier
          coefficient-ring
          (#pt-lambda
            ((element Carrier))
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element first-element)
              (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element second-element)))))
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-span ())
          Carrier
          coefficient-ring
          (#pt-lambda
            ((element Carrier))
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element first-element)
              (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element second-element))))
        (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring first-element second-element))
      (#pt-app
        (#pt-use ring-ideal-pair-least ())
        Carrier
        coefficient-ring
        first-element
        second-element
        (#pt-app
          (#pt-use ring-ideal-span ())
          Carrier
          coefficient-ring
          (#pt-lambda
            ((element Carrier))
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element first-element)
              (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element second-element))))
        (#pt-app
          (#pt-use ring-ideal-span-generator ())
          Carrier
          coefficient-ring
          (#pt-lambda
            ((element Carrier))
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element first-element)
              (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element second-element)))
          first-element
          (#pt-app
            (#pt-use disjunction-left ())
            (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring first-element first-element)
            (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring first-element second-element)
            (#pt-app (#pt-use ring-reflexive ()) Carrier coefficient-ring first-element)))
        (#pt-app
          (#pt-use ring-ideal-span-generator ())
          Carrier
          coefficient-ring
          (#pt-lambda
            ((element Carrier))
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element first-element)
              (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element second-element)))
          second-element
          (#pt-app
            (#pt-use disjunction-right ())
            (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring second-element first-element)
            (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring second-element second-element)
            (#pt-app (#pt-use ring-reflexive ()) Carrier coefficient-ring second-element))))
      (#pt-app
        (#pt-use ring-ideal-span-least ())
        Carrier
        coefficient-ring
        (#pt-lambda
          ((element Carrier))
          (#pt-app
            (#pt-use disjunction ())
            (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element first-element)
            (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element second-element)))
        (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring first-element second-element)
        (#pt-lambda
          (
            (element Carrier)
            (generator-proof
              (#pt-app
                (#pt-lambda
                  ((element-bound-0000 Carrier))
                  (#pt-app
                    (#pt-use disjunction ())
                    (#pt-app
                      (#pt-use ring-equal ())
                      Carrier
                      coefficient-ring
                      element-bound-0000
                      first-element)
                    (#pt-app
                      (#pt-use ring-equal ())
                      Carrier
                      coefficient-ring
                      element-bound-0000
                      second-element)))
                element)))
          (#pt-app
            (#pt-use disjunction-eliminate ())
            (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element first-element)
            (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element second-element)
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-ideal-pair ())
                Carrier
                coefficient-ring
                first-element
                second-element)
              element)
            (#pt-lambda
              (
                (generator-equation
                  (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element first-element)))
              (#pt-app
                (#pt-use ring-ideal-member-congruent ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-ideal-pair ())
                  Carrier
                  coefficient-ring
                  first-element
                  second-element)
                first-element
                element
                (#pt-app
                  (#pt-use ring-symmetric ())
                  Carrier
                  coefficient-ring
                  element
                  first-element
                  generator-equation)
                (#pt-app
                  (#pt-use ring-ideal-pair-first ())
                  Carrier
                  coefficient-ring
                  first-element
                  second-element)))
            (#pt-lambda
              (
                (generator-equation
                  (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element second-element)))
              (#pt-app
                (#pt-use ring-ideal-member-congruent ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-ideal-pair ())
                  Carrier
                  coefficient-ring
                  first-element
                  second-element)
                second-element
                element
                (#pt-app
                  (#pt-use ring-symmetric ())
                  Carrier
                  coefficient-ring
                  element
                  second-element
                  generator-equation)
                (#pt-app
                  (#pt-use ring-ideal-pair-second ())
                  Carrier
                  coefficient-ring
                  first-element
                  second-element)))
            generator-proof))))))
(#theorem ring-ideal-pair-commutative
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-element Carrier)
    (#parameter second-element Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring first-element second-element)
      (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring second-element first-element)))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-sum-commutative ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
      (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element))))
