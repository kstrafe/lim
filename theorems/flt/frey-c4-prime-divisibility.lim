; Direct native proof of not_dvd_c4Int at
; S_FreyPackage_not_dvd_freyCurveInt_c4.lean. Split the actual prime
; divisor of a*b*c into all three coordinates. Retain gcd one, actual
; positive exponent and the power equation in each contradiction.
; No prime-coprimality or nondivisibility conclusion is assumed.
(#alias less-than = ./natural-order.lim::less-than)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-one = ./integer-defs.lim::integer-one)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-power = ./integer-defs.lim::integer-power)
(#alias integer-divides = ./integer-defs.lim::integer-divides)
(#alias integer-add-associative = ./integer-addition.lim::integer-add-associative)
(#alias
  integer-divides-congruent-target
  =
  ./integer-divisibility.lim::integer-divides-congruent-target)
(#alias
  integer-divides-negative-target
  =
  ./integer-divisibility.lim::integer-divides-negative-target)
(#alias integer-divides-add = ./integer-divisibility-addition.lim::integer-divides-add)
(#alias integer-negate-involution = ./integer-addition.lim::integer-negate-involution)
(#alias
  integer-divides-product-left
  =
  ./integer-power-divisibility.lim::integer-divides-product-left)
(#alias
  integer-divides-product-right
  =
  ./integer-power-divisibility.lim::integer-divides-product-right)
(#alias
  integer-divides-add-cancel-left
  =
  ./integer-divisibility-addition.lim::integer-divides-add-cancel-left)
(#alias
  integer-divides-add-cancel-right
  =
  ./integer-divisibility-addition.lim::integer-divides-add-cancel-right)
(#alias
  integer-prime-divides-product
  =
  ./integer-prime-divisibility.lim::integer-prime-divides-product)
(#alias integer-prime-divides-power = ./integer-prime-divisibility.lim::integer-prime-divides-power)
(#alias integer-gcd-spec = ./integer-gcd.lim::integer-gcd-spec)
(#alias prime = ./natural-prime.lim::prime)
(#alias frey-integer-c4-value = ./frey-c4-alternate.lim::frey-integer-c4-value)
(#alias
  frey-c4-power-equation-alternate
  =
  ./frey-c4-alternate.lim::frey-c4-power-equation-alternate)
(#alias
  integer-divides-positive-power
  =
  ./integer-prime-coprimality.lim::integer-divides-positive-power)
(#alias
  integer-prime-coprime-common
  =
  ./integer-prime-coprimality.lim::integer-prime-coprime-common)
(#alias
  integer-prime-solution-common-first-third
  =
  ./integer-prime-coprimality.lim::integer-prime-solution-common-first-third)
(#alias
  integer-prime-solution-common-second-third
  =
  ./integer-prime-coprimality.lim::integer-prime-solution-common-second-third)
(#theorem frey-c4-prime-first-impossible
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter positive-exponent (#pt-app (#pt-use less-than ()) #pt-zero exponent))
    (#parameter gcd-one (#pt-app (#pt-use integer-gcd-spec ()) first second (#pt-succ #pt-zero)))
    (#parameter first-divides (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) first))
    (#parameter c4-divides (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) (#pt-app (#pt-use frey-integer-c4-value ()) first second exponent))))
  (#statement #pt-false)
  (#proof
    (#pt-app
      (#pt-use integer-prime-coprime-common ())
      prime-number
      first
      second
      prime-proof
      gcd-one
      first-divides
      (#pt-app
        (#pt-use integer-prime-divides-power ())
        prime-number
        second
        exponent
        prime-proof
        (#pt-app
          (#pt-use integer-prime-divides-power ())
          prime-number
          (#pt-app (#pt-use integer-power ()) second exponent)
          (#pt-succ (#pt-succ #pt-zero))
          prime-proof
          (#pt-app
            (#pt-use integer-divides-add-cancel-left ())
            (#pt-app (#pt-use integer-of-natural ()) prime-number)
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-power ())
                (#pt-app (#pt-use integer-power ()) first exponent)
                (#pt-succ (#pt-succ #pt-zero)))
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-power ()) first exponent)
                (#pt-app (#pt-use integer-power ()) second exponent)))
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app (#pt-use integer-power ()) second exponent)
              (#pt-succ (#pt-succ #pt-zero)))
            (#pt-app
              (#pt-use integer-divides-add ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              (#pt-app
                (#pt-use integer-power ())
                (#pt-app (#pt-use integer-power ()) first exponent)
                (#pt-succ (#pt-succ #pt-zero)))
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-power ()) first exponent)
                (#pt-app (#pt-use integer-power ()) second exponent))
              (#pt-app
                (#pt-use integer-divides-product-left ())
                (#pt-app (#pt-use integer-of-natural ()) prime-number)
                (#pt-app (#pt-use integer-power ()) first exponent)
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-power ()) first exponent)
                  (#pt-use integer-one ()))
                (#pt-app
                  (#pt-use integer-divides-positive-power ())
                  (#pt-app (#pt-use integer-of-natural ()) prime-number)
                  first
                  exponent
                  positive-exponent
                  first-divides))
              (#pt-app
                (#pt-use integer-divides-product-left ())
                (#pt-app (#pt-use integer-of-natural ()) prime-number)
                (#pt-app (#pt-use integer-power ()) first exponent)
                (#pt-app (#pt-use integer-power ()) second exponent)
                (#pt-app
                  (#pt-use integer-divides-positive-power ())
                  (#pt-app (#pt-use integer-of-natural ()) prime-number)
                  first
                  exponent
                  positive-exponent
                  first-divides)))
            c4-divides))))))
(#theorem frey-c4-prime-second-impossible
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter positive-exponent (#pt-app (#pt-use less-than ()) #pt-zero exponent))
    (#parameter gcd-one (#pt-app (#pt-use integer-gcd-spec ()) first second (#pt-succ #pt-zero)))
    (#parameter second-divides (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) second))
    (#parameter c4-divides (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) (#pt-app (#pt-use frey-integer-c4-value ()) first second exponent))))
  (#statement #pt-false)
  (#proof
    (#pt-app
      (#pt-use integer-prime-coprime-common ())
      prime-number
      first
      second
      prime-proof
      gcd-one
      (#pt-app
        (#pt-use integer-prime-divides-power ())
        prime-number
        first
        exponent
        prime-proof
        (#pt-app
          (#pt-use integer-prime-divides-power ())
          prime-number
          (#pt-app (#pt-use integer-power ()) first exponent)
          (#pt-succ (#pt-succ #pt-zero))
          prime-proof
          (#pt-app
            (#pt-use integer-divides-add-cancel-right ())
            (#pt-app (#pt-use integer-of-natural ()) prime-number)
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app (#pt-use integer-power ()) first exponent)
              (#pt-succ (#pt-succ #pt-zero)))
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-power ()) first exponent)
                (#pt-app (#pt-use integer-power ()) second exponent))
              (#pt-app
                (#pt-use integer-power ())
                (#pt-app (#pt-use integer-power ()) second exponent)
                (#pt-succ (#pt-succ #pt-zero))))
            (#pt-app
              (#pt-use integer-divides-add ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-power ()) first exponent)
                (#pt-app (#pt-use integer-power ()) second exponent))
              (#pt-app
                (#pt-use integer-power ())
                (#pt-app (#pt-use integer-power ()) second exponent)
                (#pt-succ (#pt-succ #pt-zero)))
              (#pt-app
                (#pt-use integer-divides-product-right ())
                (#pt-app (#pt-use integer-of-natural ()) prime-number)
                (#pt-app (#pt-use integer-power ()) second exponent)
                (#pt-app (#pt-use integer-power ()) first exponent)
                (#pt-app
                  (#pt-use integer-divides-positive-power ())
                  (#pt-app (#pt-use integer-of-natural ()) prime-number)
                  second
                  exponent
                  positive-exponent
                  second-divides))
              (#pt-app
                (#pt-use integer-divides-product-left ())
                (#pt-app (#pt-use integer-of-natural ()) prime-number)
                (#pt-app (#pt-use integer-power ()) second exponent)
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-power ()) second exponent)
                  (#pt-use integer-one ()))
                (#pt-app
                  (#pt-use integer-divides-positive-power ())
                  (#pt-app (#pt-use integer-of-natural ()) prime-number)
                  second
                  exponent
                  positive-exponent
                  second-divides)))
            (#pt-app
              (#pt-use integer-divides-congruent-target ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              (#pt-app (#pt-use frey-integer-c4-value ()) first second exponent)
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app
                  (#pt-use integer-power ())
                  (#pt-app (#pt-use integer-power ()) first exponent)
                  (#pt-succ (#pt-succ #pt-zero)))
                (#pt-app
                  (#pt-use integer-add ())
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-app (#pt-use integer-power ()) first exponent)
                    (#pt-app (#pt-use integer-power ()) second exponent))
                  (#pt-app
                    (#pt-use integer-power ())
                    (#pt-app (#pt-use integer-power ()) second exponent)
                    (#pt-succ (#pt-succ #pt-zero)))))
              (#pt-app
                (#pt-use integer-add-associative ())
                (#pt-app
                  (#pt-use integer-power ())
                  (#pt-app (#pt-use integer-power ()) first exponent)
                  (#pt-succ (#pt-succ #pt-zero)))
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-power ()) first exponent)
                  (#pt-app (#pt-use integer-power ()) second exponent))
                (#pt-app
                  (#pt-use integer-power ())
                  (#pt-app (#pt-use integer-power ()) second exponent)
                  (#pt-succ (#pt-succ #pt-zero))))
              c4-divides))))
      second-divides)))
(#theorem frey-c4-prime-third-impossible
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter positive-exponent (#pt-app (#pt-use less-than ()) #pt-zero exponent))
    (#parameter gcd-one (#pt-app (#pt-use integer-gcd-spec ()) first second (#pt-succ #pt-zero)))
    (#parameter power-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-power ()) first exponent) (#pt-app (#pt-use integer-power ()) second exponent)) (#pt-app (#pt-use integer-power ()) third exponent)))
    (#parameter third-divides (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) third))
    (#parameter c4-divides (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) (#pt-app (#pt-use frey-integer-c4-value ()) first second exponent))))
  (#statement #pt-false)
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app
        (#pt-use integer-divides ())
        (#pt-app (#pt-use integer-of-natural ()) prime-number)
        first)
      (#pt-app
        (#pt-use integer-divides ())
        (#pt-app (#pt-use integer-of-natural ()) prime-number)
        second)
      #pt-false
      (#pt-lambda
        (
          (first-divides
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              first)))
        (#pt-app
          (#pt-use integer-prime-solution-common-first-third ())
          prime-number
          first
          second
          third
          exponent
          prime-proof
          positive-exponent
          gcd-one
          power-equation
          first-divides
          third-divides))
      (#pt-lambda
        (
          (second-divides
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              second)))
        (#pt-app
          (#pt-use integer-prime-solution-common-second-third ())
          prime-number
          first
          second
          third
          exponent
          prime-proof
          positive-exponent
          gcd-one
          power-equation
          second-divides
          third-divides))
      (#pt-app
        (#pt-use integer-prime-divides-product ())
        prime-number
        first
        second
        prime-proof
        (#pt-app
          (#pt-use integer-prime-divides-power ())
          prime-number
          (#pt-app (#pt-use integer-multiply ()) first second)
          exponent
          prime-proof
          (#pt-app
            (#pt-use integer-divides-congruent-target ())
            (#pt-app (#pt-use integer-of-natural ()) prime-number)
            (#pt-app
              (#pt-use integer-negate ())
              (#pt-app
                (#pt-use integer-negate ())
                (#pt-app
                  (#pt-use integer-power ())
                  (#pt-app (#pt-use integer-multiply ()) first second)
                  exponent)))
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app (#pt-use integer-multiply ()) first second)
              exponent)
            (#pt-app
              (#pt-use integer-negate-involution ())
              (#pt-app
                (#pt-use integer-power ())
                (#pt-app (#pt-use integer-multiply ()) first second)
                exponent))
            (#pt-app
              (#pt-use integer-divides-negative-target ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              (#pt-app
                (#pt-use integer-negate ())
                (#pt-app
                  (#pt-use integer-power ())
                  (#pt-app (#pt-use integer-multiply ()) first second)
                  exponent))
              (#pt-app
                (#pt-use integer-divides-add-cancel-left ())
                (#pt-app (#pt-use integer-of-natural ()) prime-number)
                (#pt-app
                  (#pt-use integer-power ())
                  (#pt-app (#pt-use integer-power ()) third exponent)
                  (#pt-succ (#pt-succ #pt-zero)))
                (#pt-app
                  (#pt-use integer-negate ())
                  (#pt-app
                    (#pt-use integer-power ())
                    (#pt-app (#pt-use integer-multiply ()) first second)
                    exponent))
                (#pt-app
                  (#pt-use integer-divides-product-left ())
                  (#pt-app (#pt-use integer-of-natural ()) prime-number)
                  (#pt-app (#pt-use integer-power ()) third exponent)
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-app (#pt-use integer-power ()) third exponent)
                    (#pt-use integer-one ()))
                  (#pt-app
                    (#pt-use integer-divides-positive-power ())
                    (#pt-app (#pt-use integer-of-natural ()) prime-number)
                    third
                    exponent
                    positive-exponent
                    third-divides))
                (#pt-app
                  (#pt-use integer-divides-congruent-target ())
                  (#pt-app (#pt-use integer-of-natural ()) prime-number)
                  (#pt-app (#pt-use frey-integer-c4-value ()) first second exponent)
                  (#pt-app
                    (#pt-use integer-add ())
                    (#pt-app
                      (#pt-use integer-power ())
                      (#pt-app (#pt-use integer-power ()) third exponent)
                      (#pt-succ (#pt-succ #pt-zero)))
                    (#pt-app
                      (#pt-use integer-negate ())
                      (#pt-app
                        (#pt-use integer-power ())
                        (#pt-app (#pt-use integer-multiply ()) first second)
                        exponent)))
                  (#pt-app
                    (#pt-use frey-c4-power-equation-alternate ())
                    first
                    second
                    third
                    exponent
                    power-equation)
                  c4-divides)))))))))
(#theorem frey-c4-prime-nondivisibility
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter positive-exponent (#pt-app (#pt-use less-than ()) #pt-zero exponent))
    (#parameter gcd-one (#pt-app (#pt-use integer-gcd-spec ()) first second (#pt-succ #pt-zero)))
    (#parameter power-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-power ()) first exponent) (#pt-app (#pt-use integer-power ()) second exponent)) (#pt-app (#pt-use integer-power ()) third exponent)))
    (#parameter product-divides (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) (#pt-app (#pt-use integer-multiply ()) (#pt-app (#pt-use integer-multiply ()) first second) third))))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use integer-divides ())
            (#pt-app (#pt-use integer-of-natural ()) prime-number)
            (#pt-app (#pt-use frey-integer-c4-value ()) first second exponent))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (c4-divides
          (#pt-app
            (#pt-use integer-divides ())
            (#pt-app (#pt-use integer-of-natural ()) prime-number)
            (#pt-app (#pt-use frey-integer-c4-value ()) first second exponent))))
      (#pt-app
        (#pt-use disjunction-eliminate ())
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) prime-number)
          (#pt-app (#pt-use integer-multiply ()) first second))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) prime-number)
          third)
        #pt-false
        (#pt-lambda
          (
            (first-second-divides
              (#pt-app
                (#pt-use integer-divides ())
                (#pt-app (#pt-use integer-of-natural ()) prime-number)
                (#pt-app (#pt-use integer-multiply ()) first second))))
          (#pt-app
            (#pt-use disjunction-eliminate ())
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              first)
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              second)
            #pt-false
            (#pt-lambda
              (
                (first-divides
                  (#pt-app
                    (#pt-use integer-divides ())
                    (#pt-app (#pt-use integer-of-natural ()) prime-number)
                    first)))
              (#pt-app
                (#pt-use frey-c4-prime-first-impossible ())
                prime-number
                first
                second
                exponent
                prime-proof
                positive-exponent
                gcd-one
                first-divides
                c4-divides))
            (#pt-lambda
              (
                (second-divides
                  (#pt-app
                    (#pt-use integer-divides ())
                    (#pt-app (#pt-use integer-of-natural ()) prime-number)
                    second)))
              (#pt-app
                (#pt-use frey-c4-prime-second-impossible ())
                prime-number
                first
                second
                exponent
                prime-proof
                positive-exponent
                gcd-one
                second-divides
                c4-divides))
            (#pt-app
              (#pt-use integer-prime-divides-product ())
              prime-number
              first
              second
              prime-proof
              first-second-divides)))
        (#pt-lambda
          (
            (third-divides
              (#pt-app
                (#pt-use integer-divides ())
                (#pt-app (#pt-use integer-of-natural ()) prime-number)
                third)))
          (#pt-app
            (#pt-use frey-c4-prime-third-impossible ())
            prime-number
            first
            second
            third
            exponent
            prime-proof
            positive-exponent
            gcd-one
            power-equation
            third-divides
            c4-divides))
        (#pt-app
          (#pt-use integer-prime-divides-product ())
          prime-number
          (#pt-app (#pt-use integer-multiply ()) first second)
          third
          prime-proof
          product-divides)))))
