(#alias
  ring-polynomial-domain-data
  =
  ./ring-polynomial-domain-data.lim::ring-polynomial-domain-data)
(#alias ring-polynomial-equal = ./ring-polynomial-data.lim::ring-polynomial-equal)
(#alias ring-polynomial-multiply = ./ring-polynomial-data.lim::ring-polynomial-multiply)
(#alias ring-polynomial-symmetric = ./ring-polynomial-equivalence.lim::ring-polynomial-symmetric)
(#alias substitution = ./equality.lim::substitution)
(#theorem point-ideal-degree-linear-mutual-factors
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
    (#parameter root Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter first-factor (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter second-factor (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter forward-equation (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring polynomial (#pt-app (#pt-use ring-polynomial-multiply ()) Carrier coefficient-ring (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root) first-factor)))
    (#parameter reverse-equation (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root) (#pt-app (#pt-use ring-polynomial-multiply ()) Carrier coefficient-ring polynomial second-factor)))
    (#parameter degree-one-refutation (#pt-pi ((denied-evidence (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring polynomial (#pt-numeral 1)))) #pt-false)))
  (#statement #pt-false)
  (#proof
    (#pt-app
      (#pt-use coordinate-norm-degree-exhaustive-elimination ())
      Carrier
      coefficient-ring
      first-factor
      (#pt-app
        (#pt-use point-ideal-degree-first-factor-nonzero ())
        Carrier
        coefficient-ring
        coefficient-domain
        root
        polynomial
        first-factor
        second-factor
        forward-equation
        reverse-equation)
      (#pt-lambda
        (
          (first-degree #pt-nat)
          (first-certificate
            (#pt-app
              (#pt-use ring-polynomial-degree-witness ())
              Carrier
              coefficient-ring
              first-factor
              first-degree)))
        (#pt-app
          (#pt-use coordinate-norm-degree-exhaustive-elimination ())
          Carrier
          coefficient-ring
          second-factor
          (#pt-app
            (#pt-use point-ideal-degree-second-factor-nonzero ())
            Carrier
            coefficient-ring
            coefficient-domain
            root
            polynomial
            first-factor
            second-factor
            forward-equation
            reverse-equation)
          (#pt-lambda
            (
              (second-degree #pt-nat)
              (second-certificate
                (#pt-app
                  (#pt-use ring-polynomial-degree-witness ())
                  Carrier
                  coefficient-ring
                  second-factor
                  second-degree)))
            (#pt-app
              degree-one-refutation
              (#pt-app
                (#pt-use substitution (0))
                #pt-nat
                (#pt-lambda
                  ((degree-index #pt-nat))
                  (#pt-app
                    (#pt-use ring-polynomial-degree-witness ())
                    Carrier
                    coefficient-ring
                    polynomial
                    degree-index))
                (#pt-app (#pt-use add ()) (#pt-numeral 1) first-degree)
                (#pt-numeral 1)
                (#pt-app
                  (#pt-use point-ideal-degree-one-sum-collapse ())
                  first-degree
                  second-degree
                  (#pt-app
                    (#pt-use ring-polynomial-degree-unique ())
                    Carrier
                    coefficient-ring
                    (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use add ()) (#pt-numeral 1) first-degree)
                      second-degree)
                    (#pt-numeral 1)
                    (#pt-app
                      (#pt-use ring-polynomial-degree-congruent ())
                      Carrier
                      coefficient-ring
                      (#pt-app
                        (#pt-use ring-polynomial-multiply ())
                        Carrier
                        coefficient-ring
                        polynomial
                        second-factor)
                      (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
                      (#pt-app
                        (#pt-use add ())
                        (#pt-app (#pt-use add ()) (#pt-numeral 1) first-degree)
                        second-degree)
                      (#pt-app
                        (#pt-use ring-polynomial-symmetric ())
                        Carrier
                        coefficient-ring
                        (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
                        (#pt-app
                          (#pt-use ring-polynomial-multiply ())
                          Carrier
                          coefficient-ring
                          polynomial
                          second-factor)
                        reverse-equation)
                      (#pt-app
                        (#pt-use ring-polynomial-degree-product ())
                        Carrier
                        coefficient-ring
                        coefficient-domain
                        polynomial
                        second-factor
                        (#pt-app (#pt-use add ()) (#pt-numeral 1) first-degree)
                        second-degree
                        (#pt-app
                          (#pt-use ring-polynomial-degree-congruent ())
                          Carrier
                          coefficient-ring
                          (#pt-app
                            (#pt-use ring-polynomial-multiply ())
                            Carrier
                            coefficient-ring
                            (#pt-app
                              (#pt-use polynomial-root-divisor ())
                              Carrier
                              coefficient-ring
                              root)
                            first-factor)
                          polynomial
                          (#pt-app (#pt-use add ()) (#pt-numeral 1) first-degree)
                          (#pt-app
                            (#pt-use ring-polynomial-symmetric ())
                            Carrier
                            coefficient-ring
                            polynomial
                            (#pt-app
                              (#pt-use ring-polynomial-multiply ())
                              Carrier
                              coefficient-ring
                              (#pt-app
                                (#pt-use polynomial-root-divisor ())
                                Carrier
                                coefficient-ring
                                root)
                              first-factor)
                            forward-equation)
                          (#pt-app
                            (#pt-use ring-polynomial-degree-product ())
                            Carrier
                            coefficient-ring
                            coefficient-domain
                            (#pt-app
                              (#pt-use polynomial-root-divisor ())
                              Carrier
                              coefficient-ring
                              root)
                            first-factor
                            (#pt-numeral 1)
                            first-degree
                            (#pt-app
                              (#pt-use point-ideal-degree-root-linear ())
                              Carrier
                              coefficient-ring
                              coefficient-domain
                              root)
                            first-certificate))
                        second-certificate))
                    (#pt-app
                      (#pt-use point-ideal-degree-root-linear ())
                      Carrier
                      coefficient-ring
                      coefficient-domain
                      root)))
                (#pt-app
                  (#pt-use ring-polynomial-degree-congruent ())
                  Carrier
                  coefficient-ring
                  (#pt-app
                    (#pt-use ring-polynomial-multiply ())
                    Carrier
                    coefficient-ring
                    (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
                    first-factor)
                  polynomial
                  (#pt-app (#pt-use add ()) (#pt-numeral 1) first-degree)
                  (#pt-app
                    (#pt-use ring-polynomial-symmetric ())
                    Carrier
                    coefficient-ring
                    polynomial
                    (#pt-app
                      (#pt-use ring-polynomial-multiply ())
                      Carrier
                      coefficient-ring
                      (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
                      first-factor)
                    forward-equation)
                  (#pt-app
                    (#pt-use ring-polynomial-degree-product ())
                    Carrier
                    coefficient-ring
                    coefficient-domain
                    (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
                    first-factor
                    (#pt-numeral 1)
                    first-degree
                    (#pt-app
                      (#pt-use point-ideal-degree-root-linear ())
                      Carrier
                      coefficient-ring
                      coefficient-domain
                      root)
                    first-certificate))))))))))
