; Direct concrete algebra for FLT/Three.lean:378-414.
; omega+1 has inverse -omega. Both rotated factors are the primary sum
; plus lambda times an actual unit multiple of the second coordinate.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-lambda = ./eisenstein-defs.lim::eisenstein-lambda)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-power = ./eisenstein-defs.lim::eisenstein-power)
(#alias eisenstein-unit = ./eisenstein-defs.lim::eisenstein-unit)
(#alias eisenstein-reflexive = ./eisenstein-equality.lim::eisenstein-reflexive)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-congruent = ./eisenstein-equality.lim::eisenstein-multiply-congruent)
(#alias eisenstein-multiply-commutative = ./eisenstein-ring.lim::eisenstein-multiply-commutative)
(#alias eisenstein-multiply-associative = ./eisenstein-ring.lim::eisenstein-multiply-associative)
(#alias eisenstein-one-multiply = ./eisenstein-cubic-bridge.lim::eisenstein-one-multiply)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias exists = ./logic-exists.lim::exists)
(#alias eisenstein-add = ./eisenstein-defs.lim::eisenstein-add)
(#alias eisenstein-negate = ./eisenstein-defs.lim::eisenstein-negate)
(#alias eisenstein-omega = ./eisenstein-defs.lim::eisenstein-omega)
(#alias eisenstein-add-congruent = ./eisenstein-equality.lim::eisenstein-add-congruent)
(#alias eisenstein-multiply-distributive = ./eisenstein-ring.lim::eisenstein-multiply-distributive)
(#alias eisenstein-add-associative = ./eisenstein-ring.lim::eisenstein-add-associative)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#theorem eisenstein-omega-plus-one-unit
  (#universes)
  (#parameters)
  (#statement
    (#pt-app
      (#pt-use eisenstein-unit ())
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-use eisenstein-omega ())
        (#pt-use eisenstein-one ()))))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-inverse (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app
                  (#pt-use eisenstein-add ())
                  (#pt-use eisenstein-omega ())
                  (#pt-use eisenstein-one ()))
                candidate-inverse)
              (#pt-use eisenstein-one ()))
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                candidate-inverse
                (#pt-app
                  (#pt-use eisenstein-add ())
                  (#pt-use eisenstein-omega ())
                  (#pt-use eisenstein-one ())))
              (#pt-use eisenstein-one ())))))
      introduce
      (
        (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ()))
        (#pt-app
          (#pt-use conjunction-introduce ())
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-use eisenstein-omega ())
                (#pt-use eisenstein-one ()))
              (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ())))
            (#pt-use eisenstein-one ()))
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ()))
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-use eisenstein-omega ())
                (#pt-use eisenstein-one ())))
            (#pt-use eisenstein-one ()))
          (#pt-app
            (#pt-use conjunction-introduce ())
            (#pt-app
              (#pt-use integer-equal ())
              (#pt-project
                eisenstein
                0
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app
                    (#pt-use eisenstein-add ())
                    (#pt-use eisenstein-omega ())
                    (#pt-use eisenstein-one ()))
                  (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ()))))
              (#pt-project eisenstein 0 (#pt-use eisenstein-one ())))
            (#pt-app
              (#pt-use integer-equal ())
              (#pt-project
                eisenstein
                1
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app
                    (#pt-use eisenstein-add ())
                    (#pt-use eisenstein-omega ())
                    (#pt-use eisenstein-one ()))
                  (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ()))))
              (#pt-project eisenstein 1 (#pt-use eisenstein-one ())))
            (#pt-refl #pt-nat (#pt-succ #pt-zero))
            (#pt-refl #pt-nat (#pt-succ #pt-zero)))
          (#pt-app
            (#pt-use eisenstein-transitive ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ()))
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-use eisenstein-omega ())
                (#pt-use eisenstein-one ())))
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-use eisenstein-omega ())
                (#pt-use eisenstein-one ()))
              (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ())))
            (#pt-use eisenstein-one ())
            (#pt-app
              (#pt-use eisenstein-multiply-commutative ())
              (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ()))
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-use eisenstein-omega ())
                (#pt-use eisenstein-one ())))
            (#pt-app
              (#pt-use conjunction-introduce ())
              (#pt-app
                (#pt-use integer-equal ())
                (#pt-project
                  eisenstein
                  0
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app
                      (#pt-use eisenstein-add ())
                      (#pt-use eisenstein-omega ())
                      (#pt-use eisenstein-one ()))
                    (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ()))))
                (#pt-project eisenstein 0 (#pt-use eisenstein-one ())))
              (#pt-app
                (#pt-use integer-equal ())
                (#pt-project
                  eisenstein
                  1
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app
                      (#pt-use eisenstein-add ())
                      (#pt-use eisenstein-omega ())
                      (#pt-use eisenstein-one ()))
                    (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ()))))
                (#pt-project eisenstein 1 (#pt-use eisenstein-one ())))
              (#pt-refl #pt-nat (#pt-succ #pt-zero))
              (#pt-refl #pt-nat (#pt-succ #pt-zero)))))))))
(#theorem eisenstein-omega-lambda-unit-shift
  (#universes)
  (#parameters)
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-use eisenstein-omega ())
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-use eisenstein-one ())
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-use eisenstein-lambda ())
          (#pt-use eisenstein-one ())))))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project eisenstein 0 (#pt-use eisenstein-omega ()))
        (#pt-project
          eisenstein
          0
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-use eisenstein-one ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-use eisenstein-lambda ())
              (#pt-use eisenstein-one ())))))
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project eisenstein 1 (#pt-use eisenstein-omega ()))
        (#pt-project
          eisenstein
          1
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-use eisenstein-one ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-use eisenstein-lambda ())
              (#pt-use eisenstein-one ())))))
      (#pt-refl #pt-nat (#pt-succ #pt-zero))
      (#pt-refl #pt-nat (#pt-succ #pt-zero)))))
(#theorem eisenstein-omega-square-lambda-unit-shift
  (#universes)
  (#parameters)
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-omega ()) (#pt-numeral 2))
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-use eisenstein-one ())
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-use eisenstein-lambda ())
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-use eisenstein-omega ())
            (#pt-use eisenstein-one ()))))))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project
          eisenstein
          0
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-omega ()) (#pt-numeral 2)))
        (#pt-project
          eisenstein
          0
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-use eisenstein-one ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-use eisenstein-lambda ())
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-use eisenstein-omega ())
                (#pt-use eisenstein-one ()))))))
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project
          eisenstein
          1
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-omega ()) (#pt-numeral 2)))
        (#pt-project
          eisenstein
          1
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-use eisenstein-one ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-use eisenstein-lambda ())
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-use eisenstein-omega ())
                (#pt-use eisenstein-one ()))))))
      (#pt-refl #pt-nat (#pt-numeral 2))
      (#pt-refl #pt-nat (#pt-numeral 2)))))
(#theorem eisenstein-cubic-factor-unit-shift
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter root (#pt-use eisenstein ()))
    (#parameter coefficient (#pt-use eisenstein ()))
    (#parameter root-equivalence (#pt-app (#pt-use eisenstein-equal ()) root (#pt-app (#pt-use eisenstein-add ()) (#pt-use eisenstein-one ()) (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) coefficient)))))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app
        (#pt-use eisenstein-add ())
        first
        (#pt-app (#pt-use eisenstein-multiply ()) root second))
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app (#pt-use eisenstein-add ()) first second)
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-use eisenstein-lambda ())
          (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)))))
  (#proof
    (#pt-app
      (#pt-use eisenstein-transitive ())
      (#pt-app
        (#pt-use eisenstein-add ())
        first
        (#pt-app (#pt-use eisenstein-multiply ()) root second))
      (#pt-app
        (#pt-use eisenstein-add ())
        first
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-use eisenstein-one ())
            (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) coefficient))
          second))
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app (#pt-use eisenstein-add ()) first second)
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-use eisenstein-lambda ())
          (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)))
      (#pt-app
        (#pt-use eisenstein-add-congruent ())
        first
        (#pt-app (#pt-use eisenstein-multiply ()) root second)
        first
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-use eisenstein-one ())
            (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) coefficient))
          second)
        (#pt-app (#pt-use eisenstein-reflexive ()) first)
        (#pt-app
          (#pt-use eisenstein-multiply-congruent ())
          root
          second
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-use eisenstein-one ())
            (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) coefficient))
          second
          root-equivalence
          (#pt-app (#pt-use eisenstein-reflexive ()) second)))
      (#pt-app
        (#pt-use eisenstein-transitive ())
        (#pt-app
          (#pt-use eisenstein-add ())
          first
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-use eisenstein-one ())
              (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) coefficient))
            second))
        (#pt-app
          (#pt-use eisenstein-add ())
          first
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) second)
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) coefficient)
              second)))
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app (#pt-use eisenstein-add ()) first second)
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-use eisenstein-lambda ())
            (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)))
        (#pt-app
          (#pt-use eisenstein-add-congruent ())
          first
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-use eisenstein-one ())
              (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) coefficient))
            second)
          first
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) second)
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) coefficient)
              second))
          (#pt-app (#pt-use eisenstein-reflexive ()) first)
          (#pt-app
            (#pt-use eisenstein-multiply-distributive ())
            (#pt-use eisenstein-one ())
            (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) coefficient)
            second))
        (#pt-app
          (#pt-use eisenstein-transitive ())
          (#pt-app
            (#pt-use eisenstein-add ())
            first
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) second)
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-use eisenstein-lambda ())
                  coefficient)
                second)))
          (#pt-app
            (#pt-use eisenstein-add ())
            first
            (#pt-app
              (#pt-use eisenstein-add ())
              second
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-use eisenstein-lambda ())
                (#pt-app (#pt-use eisenstein-multiply ()) coefficient second))))
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-add ()) first second)
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-use eisenstein-lambda ())
              (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)))
          (#pt-app
            (#pt-use eisenstein-add-congruent ())
            first
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) second)
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-use eisenstein-lambda ())
                  coefficient)
                second))
            first
            (#pt-app
              (#pt-use eisenstein-add ())
              second
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-use eisenstein-lambda ())
                (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)))
            (#pt-app (#pt-use eisenstein-reflexive ()) first)
            (#pt-app
              (#pt-use eisenstein-add-congruent ())
              (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) second)
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-use eisenstein-lambda ())
                  coefficient)
                second)
              second
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-use eisenstein-lambda ())
                (#pt-app (#pt-use eisenstein-multiply ()) coefficient second))
              (#pt-app (#pt-use eisenstein-one-multiply ()) second)
              (#pt-app
                (#pt-use eisenstein-multiply-associative ())
                (#pt-use eisenstein-lambda ())
                coefficient
                second)))
          (#pt-app
            (#pt-use eisenstein-symmetric ())
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-add ()) first second)
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-use eisenstein-lambda ())
                (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)))
            (#pt-app
              (#pt-use eisenstein-add ())
              first
              (#pt-app
                (#pt-use eisenstein-add ())
                second
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-app (#pt-use eisenstein-multiply ()) coefficient second))))
            (#pt-app
              (#pt-use eisenstein-add-associative ())
              first
              second
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-use eisenstein-lambda ())
                (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)))))))))
