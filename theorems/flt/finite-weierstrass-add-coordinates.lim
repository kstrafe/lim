(#math-definition finite-weierstrass-add-x ()
  (#pt-pi
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
      (first-x (#pt-app (#pt-use finite-residue ()) modulus))
      (second-x (#pt-app (#pt-use finite-residue ()) modulus))
      (line-slope (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-app (#pt-use finite-residue ()) modulus))
  (#pt-lambda
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
      (first-x (#pt-app (#pt-use finite-residue ()) modulus))
      (second-x (#pt-app (#pt-use finite-residue ()) modulus))
      (line-slope (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-app
      (#pt-use finite-residue-difference ())
      modulus
      positive-modulus
      (#pt-app
        (#pt-use finite-residue-difference ())
