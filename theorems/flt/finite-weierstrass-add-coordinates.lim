(#theorem finite-weierstrass-add-y-inverse
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
    (#parameter first-x (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second-x (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter first-y (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter line-slope (#pt-app (#pt-use finite-residue ()) modulus)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-weierstrass-neg-y ())
          modulus
          positive-modulus
          curve
          (#pt-app
            (#pt-use finite-weierstrass-add-x ())
            modulus
            positive-modulus
            curve
            first-x
            second-x
            line-slope)
          (#pt-app
            (#pt-use finite-weierstrass-add-y ())
            modulus
            positive-modulus
            curve
            first-x
            second-x
            first-y
            line-slope)))
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-weierstrass-neg-add-y ())
          modulus
          positive-modulus
          curve
          first-x
          second-x
          first-y
          line-slope))))
  (#proof
    (#pt-app
      (#pt-use finite-weierstrass-neg-y-involution ())
      modulus
      positive-modulus
      curve
      (#pt-app
        (#pt-use finite-weierstrass-add-x ())
        modulus
        positive-modulus
        curve
        first-x
        second-x
        line-slope)
      (#pt-app
        (#pt-use finite-weierstrass-neg-add-y ())
        modulus
        positive-modulus
        curve
        first-x
        second-x
        first-y
        line-slope))))
