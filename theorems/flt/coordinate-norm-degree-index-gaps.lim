(#theorem coordinate-norm-degree-low-square-gap
  (#universes)
  (#parameters
    (#parameter constant-degree #pt-nat)
    (#parameter linear-degree #pt-nat)
    (#parameter gap #pt-nat)
    (#parameter low-relation (#pt-eq #pt-nat (#pt-succ linear-degree) (#pt-app (#pt-use add ()) constant-degree gap))))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use add ()) linear-degree linear-degree)
        (#pt-numeral 3))
      (#pt-app
        (#pt-use add ())
        (#pt-succ (#pt-app (#pt-use add ()) constant-degree constant-degree))
        (#pt-app (#pt-use add ()) gap gap))))
  (#proof
    (#pt-app
      (#pt-use transitivity (0))
      #pt-nat
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use add ()) linear-degree linear-degree)
        (#pt-numeral 3))
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use add ()) (#pt-succ linear-degree) (#pt-succ linear-degree))
        (#pt-numeral 1))
      (#pt-app
        (#pt-use add ())
        (#pt-succ (#pt-app (#pt-use add ()) constant-degree constant-degree))
        (#pt-app (#pt-use add ()) gap gap))
      (#pt-app (#pt-use coordinate-norm-degree-cubic-successor-identity ()) linear-degree)
      (#pt-app
        (#pt-use transitivity (0))
        #pt-nat
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use add ()) (#pt-succ linear-degree) (#pt-succ linear-degree))
          (#pt-numeral 1))
        (#pt-app
          (#pt-use add ())
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use add ()) constant-degree gap)
            (#pt-app (#pt-use add ()) constant-degree gap))
          (#pt-numeral 1))
        (#pt-app
          (#pt-use add ())
          (#pt-succ (#pt-app (#pt-use add ()) constant-degree constant-degree))
          (#pt-app (#pt-use add ()) gap gap))
        (#pt-app
          (#pt-use congruence (0 0))
          #pt-nat
          #pt-nat
          (#pt-lambda
            ((degree-input #pt-nat))
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use add ()) degree-input degree-input)
              (#pt-numeral 1)))
          (#pt-succ linear-degree)
          (#pt-app (#pt-use add ()) constant-degree gap)
          low-relation)
        (#pt-app (#pt-use coordinate-norm-degree-low-square-identity ()) constant-degree gap)))))
