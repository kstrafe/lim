      (#pt-app
        (#pt-use add ())
        (#pt-succ
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use add ()) constant-degree linear-degree)
            (#pt-numeral 1)))
        gap)))
  (#proof
    (#pt-app
