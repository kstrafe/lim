; Direct Nat.succ.inj proof through the structural predecessor.
(#alias congruence = ./equality.lim::congruence)
(#math-definition predecessor ()
  (#pt-pi ((number #pt-nat)) #pt-nat)
  (#pt-lambda
    ((number #pt-nat))
    (#pt-nat-induct
      (#pt-lambda ((ordinal #pt-nat)) #pt-nat)
      #pt-zero
      (#pt-lambda ((previous #pt-nat) (previous-predecessor #pt-nat)) previous)
      number)))
(#theorem successor-injective
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter equality (#pt-eq #pt-nat (#pt-succ first) (#pt-succ second))))
  (#statement (#pt-eq #pt-nat first second))
  (#proof
    (#pt-app
      (#pt-use congruence (0 0))
      #pt-nat
      #pt-nat
      (#pt-use predecessor ())
      (#pt-succ first)
      (#pt-succ second)
      equality)))
