; Every formal difference has a witnessed positive or negative normal form.
; Construct the magnitude from the proved trichotomy of its natural components.
; The two zero representations coincide; no excluded-middle oracle is needed.
(#alias add = ../fermat_statement.lim::add)
(#alias exists = ./logic-exists.lim::exists)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-negative-natural = ./integer-defs.lim::integer-negative-natural)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias less-than = ./natural-order.lim::less-than)
(#alias natural-trichotomy = ./natural-discrete-order.lim::natural-trichotomy)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-left = ./logical-connectives.lim::disjunction-left)
(#alias disjunction-right = ./logical-connectives.lim::disjunction-right)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias add-zero-right = ./natural-addition.lim::add-zero-right)
(#alias add-commutative = ./natural-addition.lim::add-commutative)
(#alias add-successor-right = ./natural-addition.lim::add-successor-right)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#theorem integer-normal-form
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app
        (#pt-use exists (0))
        #pt-nat
        (#pt-lambda
          ((magnitude #pt-nat))
          (#pt-app
            (#pt-use integer-equal ())
            number
            (#pt-app (#pt-use integer-of-natural ()) magnitude))))
      (#pt-app
        (#pt-use exists (0))
        #pt-nat
        (#pt-lambda
          ((magnitude #pt-nat))
          (#pt-app
            (#pt-use integer-equal ())
            number
            (#pt-app (#pt-use integer-negative-natural ()) magnitude))))))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use less-than ()) (#pt-project integer 0 number) (#pt-project integer 1 number))
      (#pt-app
        (#pt-use disjunction ())
        (#pt-eq #pt-nat (#pt-project integer 0 number) (#pt-project integer 1 number))
        (#pt-app
          (#pt-use less-than ())
          (#pt-project integer 1 number)
          (#pt-project integer 0 number)))
      (#pt-app
        (#pt-use disjunction ())
        (#pt-app
          (#pt-use exists (0))
          #pt-nat
          (#pt-lambda
            ((magnitude #pt-nat))
            (#pt-app
              (#pt-use integer-equal ())
              number
              (#pt-app (#pt-use integer-of-natural ()) magnitude))))
        (#pt-app
          (#pt-use exists (0))
          #pt-nat
          (#pt-lambda
            ((magnitude #pt-nat))
            (#pt-app
              (#pt-use integer-equal ())
              number
              (#pt-app (#pt-use integer-negative-natural ()) magnitude)))))
      (#pt-lambda
        (
          (negative-bound
            (#pt-app
              (#pt-use less-than ())
              (#pt-project integer 0 number)
              (#pt-project integer 1 number))))
        (#pt-induct
          exists
          (0)
          (#pt-nat
            (#pt-lambda
              ((candidate-gap #pt-nat))
              (#pt-eq
                #pt-nat
                (#pt-project integer 1 number)
                (#pt-app (#pt-use add ()) (#pt-succ (#pt-project integer 0 number)) candidate-gap))))
          (#pt-lambda
            (
              (certificate
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((candidate-gap #pt-nat))
                    (#pt-eq
                      #pt-nat
                      (#pt-project integer 1 number)
                      (#pt-app
                        (#pt-use add ())
                        (#pt-succ (#pt-project integer 0 number))
                        candidate-gap))))))
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app
                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((magnitude #pt-nat))
                  (#pt-app
                    (#pt-use integer-equal ())
                    number
                    (#pt-app (#pt-use integer-of-natural ()) magnitude))))
              (#pt-app
                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((magnitude #pt-nat))
                  (#pt-app
                    (#pt-use integer-equal ())
                    number
                    (#pt-app (#pt-use integer-negative-natural ()) magnitude))))))
          (
            (#pt-lambda
              (
                (gap #pt-nat)
                (gap-equation
                  (#pt-eq
                    #pt-nat
                    (#pt-project integer 1 number)
                    (#pt-app (#pt-use add ()) (#pt-succ (#pt-project integer 0 number)) gap))))
              (#pt-app
                (#pt-use disjunction-right ())
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((magnitude #pt-nat))
                    (#pt-app
                      (#pt-use integer-equal ())
                      number
                      (#pt-app (#pt-use integer-of-natural ()) magnitude))))
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((magnitude #pt-nat))
                    (#pt-app
                      (#pt-use integer-equal ())
                      number
                      (#pt-app (#pt-use integer-negative-natural ()) magnitude))))
                (#pt-construct
                  exists
                  (0)
                  (#pt-nat
                    (#pt-lambda
                      ((magnitude #pt-nat))
                      (#pt-app
                        (#pt-use integer-equal ())
                        number
                        (#pt-app (#pt-use integer-negative-natural ()) magnitude))))
                  introduce
                  (
                    (#pt-succ gap)
                    (#pt-app
                      (#pt-use transitivity (0))
                      #pt-nat
                      (#pt-app (#pt-use add ()) (#pt-project integer 0 number) (#pt-succ gap))
                      (#pt-app (#pt-use add ()) (#pt-succ (#pt-project integer 0 number)) gap)
                      (#pt-project integer 1 number)
                      (#pt-app (#pt-use add-successor-right ()) (#pt-project integer 0 number) gap)
                      (#pt-app
                        (#pt-use symmetry (0))
                        #pt-nat
                        (#pt-project integer 1 number)
                        (#pt-app (#pt-use add ()) (#pt-succ (#pt-project integer 0 number)) gap)
                        gap-equation)))))))
          negative-bound))
      (#pt-lambda
        (
          (nonnegative-case
            (#pt-app
              (#pt-use disjunction ())
              (#pt-eq #pt-nat (#pt-project integer 0 number) (#pt-project integer 1 number))
              (#pt-app
                (#pt-use less-than ())
                (#pt-project integer 1 number)
                (#pt-project integer 0 number)))))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-eq #pt-nat (#pt-project integer 0 number) (#pt-project integer 1 number))
          (#pt-app
            (#pt-use less-than ())
            (#pt-project integer 1 number)
            (#pt-project integer 0 number))
          (#pt-app
            (#pt-use disjunction ())
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((magnitude #pt-nat))
                (#pt-app
                  (#pt-use integer-equal ())
                  number
                  (#pt-app (#pt-use integer-of-natural ()) magnitude))))
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((magnitude #pt-nat))
                (#pt-app
                  (#pt-use integer-equal ())
                  number
                  (#pt-app (#pt-use integer-negative-natural ()) magnitude)))))
          (#pt-lambda
            (
              (components-equal
                (#pt-eq #pt-nat (#pt-project integer 0 number) (#pt-project integer 1 number))))
            (#pt-app
              (#pt-use disjunction-left ())
              (#pt-app
                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((magnitude #pt-nat))
                  (#pt-app
                    (#pt-use integer-equal ())
                    number
                    (#pt-app (#pt-use integer-of-natural ()) magnitude))))
              (#pt-app
                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((magnitude #pt-nat))
                  (#pt-app
                    (#pt-use integer-equal ())
                    number
                    (#pt-app (#pt-use integer-negative-natural ()) magnitude))))
              (#pt-construct
                exists
                (0)
                (#pt-nat
                  (#pt-lambda
                    ((magnitude #pt-nat))
                    (#pt-app
                      (#pt-use integer-equal ())
                      number
                      (#pt-app (#pt-use integer-of-natural ()) magnitude))))
                introduce
                (#pt-zero
                  (#pt-app
                    (#pt-use transitivity (0))
                    #pt-nat
                    (#pt-app (#pt-use add ()) (#pt-project integer 0 number) #pt-zero)
                    (#pt-project integer 0 number)
                    (#pt-project integer 1 number)
                    (#pt-app (#pt-use add-zero-right ()) (#pt-project integer 0 number))
                    components-equal)))))
          (#pt-lambda
            (
              (positive-bound
                (#pt-app
                  (#pt-use less-than ())
                  (#pt-project integer 1 number)
                  (#pt-project integer 0 number))))
            (#pt-induct
              exists
              (0)
              (#pt-nat
                (#pt-lambda
                  ((candidate-gap #pt-nat))
                  (#pt-eq
                    #pt-nat
                    (#pt-project integer 0 number)
                    (#pt-app
                      (#pt-use add ())
                      (#pt-succ (#pt-project integer 1 number))
                      candidate-gap))))
              (#pt-lambda
                (
                  (certificate
                    (#pt-app
                      (#pt-use exists (0))
                      #pt-nat
                      (#pt-lambda
                        ((candidate-gap #pt-nat))
                        (#pt-eq
                          #pt-nat
                          (#pt-project integer 0 number)
                          (#pt-app
                            (#pt-use add ())
                            (#pt-succ (#pt-project integer 1 number))
                            candidate-gap))))))
                (#pt-app
                  (#pt-use disjunction ())
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((magnitude #pt-nat))
                      (#pt-app
                        (#pt-use integer-equal ())
                        number
                        (#pt-app (#pt-use integer-of-natural ()) magnitude))))
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((magnitude #pt-nat))
                      (#pt-app
                        (#pt-use integer-equal ())
                        number
                        (#pt-app (#pt-use integer-negative-natural ()) magnitude))))))
              (
                (#pt-lambda
                  (
                    (gap #pt-nat)
                    (gap-equation
                      (#pt-eq
                        #pt-nat
                        (#pt-project integer 0 number)
                        (#pt-app (#pt-use add ()) (#pt-succ (#pt-project integer 1 number)) gap))))
                  (#pt-app
                    (#pt-use disjunction-left ())
                    (#pt-app
                      (#pt-use exists (0))
                      #pt-nat
                      (#pt-lambda
                        ((magnitude #pt-nat))
                        (#pt-app
                          (#pt-use integer-equal ())
                          number
                          (#pt-app (#pt-use integer-of-natural ()) magnitude))))
                    (#pt-app
                      (#pt-use exists (0))
                      #pt-nat
                      (#pt-lambda
                        ((magnitude #pt-nat))
                        (#pt-app
                          (#pt-use integer-equal ())
                          number
                          (#pt-app (#pt-use integer-negative-natural ()) magnitude))))
                    (#pt-construct
                      exists
                      (0)
                      (#pt-nat
                        (#pt-lambda
                          ((magnitude #pt-nat))
                          (#pt-app
                            (#pt-use integer-equal ())
                            number
                            (#pt-app (#pt-use integer-of-natural ()) magnitude))))
                      introduce
                      (
                        (#pt-succ gap)
                        (#pt-app
                          (#pt-use transitivity (0))
                          #pt-nat
                          (#pt-app (#pt-use add ()) (#pt-project integer 0 number) #pt-zero)
                          (#pt-project integer 0 number)
                          (#pt-app (#pt-use add ()) (#pt-succ gap) (#pt-project integer 1 number))
                          (#pt-app (#pt-use add-zero-right ()) (#pt-project integer 0 number))
                          (#pt-app
                            (#pt-use transitivity (0))
                            #pt-nat
                            (#pt-project integer 0 number)
                            (#pt-app (#pt-use add ()) (#pt-succ (#pt-project integer 1 number)) gap)
                            (#pt-app (#pt-use add ()) (#pt-succ gap) (#pt-project integer 1 number))
                            gap-equation
                            (#pt-app
                              (#pt-use transitivity (0))
                              #pt-nat
                              (#pt-app
                                (#pt-use add ())
                                (#pt-succ (#pt-project integer 1 number))
                                gap)
                              (#pt-app
                                (#pt-use add ())
                                (#pt-project integer 1 number)
                                (#pt-succ gap))
                              (#pt-app
                                (#pt-use add ())
                                (#pt-succ gap)
                                (#pt-project integer 1 number))
                              (#pt-app
                                (#pt-use symmetry (0))
                                #pt-nat
                                (#pt-app
                                  (#pt-use add ())
                                  (#pt-project integer 1 number)
                                  (#pt-succ gap))
                                (#pt-app
                                  (#pt-use add ())
                                  (#pt-succ (#pt-project integer 1 number))
                                  gap)
                                (#pt-app
                                  (#pt-use add-successor-right ())
                                  (#pt-project integer 1 number)
                                  gap))
                              (#pt-app
                                (#pt-use add-commutative ())
                                (#pt-project integer 1 number)
                                (#pt-succ gap))))))))))
              positive-bound))
          nonnegative-case))
      (#pt-app
        (#pt-use natural-trichotomy ())
        (#pt-project integer 0 number)
        (#pt-project integer 1 number)))))
