; Construct the actual signed cofactor from its natural magnitude
; factorization and both proved sign branches. Retain x=q^k*u and
; q not dividing u, without extracting a data-valued choice from Prop.
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias power = ./../fermat_statement.lim::power)
(#alias exists = ./logic-exists.lim::exists)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-power = ./integer-defs.lim::integer-power)
(#alias integer-divides = ./integer-defs.lim::integer-divides)
(#alias integer-reflexive = ./integer-equality.lim::integer-reflexive)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias integer-negate-congruent = ./integer-equality.lim::integer-negate-congruent)
(#alias integer-multiply-congruent = ./integer-multiplication.lim::integer-multiply-congruent)
(#alias integer-multiply-of-natural = ./integer-multiplication.lim::integer-multiply-of-natural)
(#alias
  integer-multiply-negative-second
  =
  ./integer-divisibility.lim::integer-multiply-negative-second)
(#alias
  integer-divides-negative-target
  =
  ./integer-divisibility.lim::integer-divides-negative-target)
(#alias integer-power-of-natural = ./integer-power-laws.lim::integer-power-of-natural)
(#alias
  integer-natural-divisibility-reflects
  =
  ./integer-natural-bridge.lim::integer-natural-divisibility-reflects)
(#alias natural-prime-order = ./natural-prime-order-defs.lim::natural-prime-order)
(#alias integer-magnitude = ./integer-magnitude.lim::integer-magnitude)
(#alias integer-prime-order = ./integer-prime-order-defs.lim::integer-prime-order)
(#alias integer-negative-natural = ./integer-defs.lim::integer-negative-natural)
(#theorem integer-prime-factor-embedding
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter magnitude #pt-nat)
    (#parameter valuation #pt-nat)
    (#parameter cofactor #pt-nat)
    (#parameter factor-equation (#pt-eq #pt-nat magnitude (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use power ()) prime-number valuation) cofactor))))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-of-natural ()) magnitude)
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app (#pt-use integer-of-natural ()) prime-number)
          valuation)
        (#pt-app (#pt-use integer-of-natural ()) cofactor))))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app (#pt-use integer-of-natural ()) magnitude)
      (#pt-app
        (#pt-use integer-of-natural ())
        (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use power ()) prime-number valuation) cofactor))
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app (#pt-use integer-of-natural ()) prime-number)
          valuation)
        (#pt-app (#pt-use integer-of-natural ()) cofactor))
      (#pt-eq-elim
        #pt-nat
        magnitude
        (#pt-lambda
          ((transport-index #pt-nat) (transport-path (#pt-eq #pt-nat magnitude transport-index)))
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-app (#pt-use integer-of-natural ()) magnitude)
            (#pt-app (#pt-use integer-of-natural ()) transport-index)))
        (#pt-app (#pt-use integer-reflexive ()) (#pt-app (#pt-use integer-of-natural ()) magnitude))
        (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use power ()) prime-number valuation) cofactor)
        factor-equation)
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app
          (#pt-use integer-of-natural ())
          (#pt-app
            (#pt-use multiply ())
            (#pt-app (#pt-use power ()) prime-number valuation)
            cofactor))
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app
            (#pt-use integer-of-natural ())
            (#pt-app (#pt-use power ()) prime-number valuation))
          (#pt-app (#pt-use integer-of-natural ()) cofactor))
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app (#pt-use integer-of-natural ()) prime-number)
            valuation)
          (#pt-app (#pt-use integer-of-natural ()) cofactor))
        (#pt-app
          (#pt-use integer-symmetric ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app (#pt-use power ()) prime-number valuation))
            (#pt-app (#pt-use integer-of-natural ()) cofactor))
          (#pt-app
            (#pt-use integer-of-natural ())
            (#pt-app
              (#pt-use multiply ())
              (#pt-app (#pt-use power ()) prime-number valuation)
              cofactor))
          (#pt-app
            (#pt-use integer-multiply-of-natural ())
            (#pt-app (#pt-use power ()) prime-number valuation)
            cofactor))
        (#pt-app
          (#pt-use integer-multiply-congruent ())
          (#pt-app
            (#pt-use integer-of-natural ())
            (#pt-app (#pt-use power ()) prime-number valuation))
          (#pt-app (#pt-use integer-of-natural ()) cofactor)
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app (#pt-use integer-of-natural ()) prime-number)
            valuation)
          (#pt-app (#pt-use integer-of-natural ()) cofactor)
          (#pt-app
            (#pt-use integer-symmetric ())
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              valuation)
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app (#pt-use power ()) prime-number valuation))
            (#pt-app (#pt-use integer-power-of-natural ()) prime-number valuation))
          (#pt-app
            (#pt-use integer-reflexive ())
            (#pt-app (#pt-use integer-of-natural ()) cofactor)))))))
(#theorem integer-prime-order-cofactor
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter number (#pt-use integer ()))
    (#parameter valuation #pt-nat)
    (#parameter order-certificate (#pt-app (#pt-use integer-prime-order ()) prime-number valuation number)))
  (#statement
    (#pt-app
      (#pt-use exists (0))
      (#pt-use integer ())
      (#pt-lambda
        ((candidate-cofactor (#pt-use integer ())))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app
            (#pt-use integer-equal ())
            number
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app
                (#pt-use integer-power ())
                (#pt-app (#pt-use integer-of-natural ()) prime-number)
                valuation)
              candidate-cofactor))
          (#pt-pi
            (
              (denied-proof
                (#pt-app
                  (#pt-use integer-divides ())
                  (#pt-app (#pt-use integer-of-natural ()) prime-number)
                  candidate-cofactor)))
            #pt-false)))))
  (#proof
    (#pt-induct
      integer-prime-order
      ()
      (prime-number valuation number)
      (#pt-lambda
        (
          (signed-order-subject
            (#pt-app (#pt-use integer-prime-order ()) prime-number valuation number)))
        (#pt-app
          (#pt-use exists (0))
          (#pt-use integer ())
          (#pt-lambda
            ((candidate-cofactor (#pt-use integer ())))
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app
                (#pt-use integer-equal ())
                number
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app
                    (#pt-use integer-power ())
                    (#pt-app (#pt-use integer-of-natural ()) prime-number)
                    valuation)
                  candidate-cofactor))
              (#pt-pi
                (
                  (denied-proof
                    (#pt-app
                      (#pt-use integer-divides ())
                      (#pt-app (#pt-use integer-of-natural ()) prime-number)
                      candidate-cofactor)))
                #pt-false)))))
      (
        (#pt-lambda
          (
            (magnitude #pt-nat)
            (packet-natural
              (#pt-app (#pt-use natural-prime-order ()) prime-number magnitude valuation))
            (packet-magnitude (#pt-app (#pt-use integer-magnitude ()) number magnitude)))
          (#pt-app
            (#pt-lambda
              (
                (packet
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app (#pt-use natural-prime-order ()) prime-number magnitude valuation)
                    (#pt-app (#pt-use integer-magnitude ()) number magnitude))))
              (#pt-induct
                exists
                (0)
                (#pt-nat
                  (#pt-lambda
                    ((candidate-cofactor #pt-nat))
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-eq
                        #pt-nat
                        magnitude
                        (#pt-app
                          (#pt-use multiply ())
                          (#pt-app (#pt-use power ()) prime-number valuation)
                          candidate-cofactor))
                      (#pt-pi
                        (
                          (denied-proof
                            (#pt-app (#pt-use divides ()) prime-number candidate-cofactor)))
                        #pt-false))))
                (#pt-lambda
                  (
                    (certificate
                      (#pt-app
                        (#pt-use exists (0))
                        #pt-nat
                        (#pt-lambda
                          ((candidate-cofactor #pt-nat))
                          (#pt-app
                            (#pt-use conjunction ())
                            (#pt-eq
                              #pt-nat
                              magnitude
                              (#pt-app
                                (#pt-use multiply ())
                                (#pt-app (#pt-use power ()) prime-number valuation)
                                candidate-cofactor))
                            (#pt-pi
                              (
                                (denied-proof
                                  (#pt-app (#pt-use divides ()) prime-number candidate-cofactor)))
                              #pt-false))))))
                  (#pt-app
                    (#pt-use exists (0))
                    (#pt-use integer ())
                    (#pt-lambda
                      ((candidate-cofactor (#pt-use integer ())))
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-app
                          (#pt-use integer-equal ())
                          number
                          (#pt-app
                            (#pt-use integer-multiply ())
                            (#pt-app
                              (#pt-use integer-power ())
                              (#pt-app (#pt-use integer-of-natural ()) prime-number)
                              valuation)
                            candidate-cofactor))
                        (#pt-pi
                          (
                            (denied-proof
                              (#pt-app
                                (#pt-use integer-divides ())
                                (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                candidate-cofactor)))
                          #pt-false)))))
                (
                  (#pt-lambda
                    (
                      (cofactor #pt-nat)
                      (natural-cofactor
                        (#pt-app
                          (#pt-use conjunction ())
                          (#pt-eq
                            #pt-nat
                            magnitude
                            (#pt-app
                              (#pt-use multiply ())
                              (#pt-app (#pt-use power ()) prime-number valuation)
                              cofactor))
                          (#pt-pi
                            ((denied-proof (#pt-app (#pt-use divides ()) prime-number cofactor)))
                            #pt-false))))
                    (#pt-app
                      (#pt-use disjunction-eliminate ())
                      (#pt-app
                        (#pt-use integer-equal ())
                        number
                        (#pt-app (#pt-use integer-of-natural ()) magnitude))
                      (#pt-app
                        (#pt-use integer-equal ())
                        number
                        (#pt-app (#pt-use integer-negative-natural ()) magnitude))
                      (#pt-app
                        (#pt-use exists (0))
                        (#pt-use integer ())
                        (#pt-lambda
                          ((candidate-cofactor (#pt-use integer ())))
                          (#pt-app
                            (#pt-use conjunction ())
                            (#pt-app
                              (#pt-use integer-equal ())
                              number
                              (#pt-app
                                (#pt-use integer-multiply ())
                                (#pt-app
                                  (#pt-use integer-power ())
                                  (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                  valuation)
                                candidate-cofactor))
                            (#pt-pi
                              (
                                (denied-proof
                                  (#pt-app
                                    (#pt-use integer-divides ())
                                    (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                    candidate-cofactor)))
                              #pt-false))))
                      (#pt-lambda
                        (
                          (positive-form
                            (#pt-app
                              (#pt-use integer-equal ())
                              number
                              (#pt-app (#pt-use integer-of-natural ()) magnitude))))
                        (#pt-construct
                          exists
                          (0)
                          (
                            (#pt-use integer ())
                            (#pt-lambda
                              ((candidate-cofactor (#pt-use integer ())))
                              (#pt-app
                                (#pt-use conjunction ())
                                (#pt-app
                                  (#pt-use integer-equal ())
                                  number
                                  (#pt-app
                                    (#pt-use integer-multiply ())
                                    (#pt-app
                                      (#pt-use integer-power ())
                                      (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                      valuation)
                                    candidate-cofactor))
                                (#pt-pi
                                  (
                                    (denied-proof
                                      (#pt-app
                                        (#pt-use integer-divides ())
                                        (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                        candidate-cofactor)))
                                  #pt-false))))
                          introduce
                          (
                            (#pt-app (#pt-use integer-of-natural ()) cofactor)
                            (#pt-app
                              (#pt-use conjunction-introduce ())
                              (#pt-app
                                (#pt-use integer-equal ())
                                number
                                (#pt-app
                                  (#pt-use integer-multiply ())
                                  (#pt-app
                                    (#pt-use integer-power ())
                                    (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                    valuation)
                                  (#pt-app (#pt-use integer-of-natural ()) cofactor)))
                              (#pt-pi
                                (
                                  (denied-proof
                                    (#pt-app
                                      (#pt-use integer-divides ())
                                      (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                      (#pt-app (#pt-use integer-of-natural ()) cofactor))))
                                #pt-false)
                              (#pt-app
                                (#pt-use integer-transitive ())
                                number
                                (#pt-app (#pt-use integer-of-natural ()) magnitude)
                                (#pt-app
                                  (#pt-use integer-multiply ())
                                  (#pt-app
                                    (#pt-use integer-power ())
                                    (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                    valuation)
                                  (#pt-app (#pt-use integer-of-natural ()) cofactor))
                                positive-form
                                (#pt-app
                                  (#pt-use integer-prime-factor-embedding ())
                                  prime-number
                                  magnitude
                                  valuation
                                  cofactor
                                  (#pt-project conjunction 0 natural-cofactor)))
                              (#pt-lambda
                                (
                                  (cofactor-divides
                                    (#pt-app
                                      (#pt-use integer-divides ())
                                      (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                      (#pt-app (#pt-use integer-of-natural ()) cofactor))))
                                (#pt-app
                                  (#pt-project conjunction 1 natural-cofactor)
                                  (#pt-app
                                    (#pt-use integer-natural-divisibility-reflects ())
                                    prime-number
                                    cofactor
                                    cofactor-divides)))))))
                      (#pt-lambda
                        (
                          (negative-form
                            (#pt-app
                              (#pt-use integer-equal ())
                              number
                              (#pt-app (#pt-use integer-negative-natural ()) magnitude))))
                        (#pt-construct
                          exists
                          (0)
                          (
                            (#pt-use integer ())
                            (#pt-lambda
                              ((candidate-cofactor (#pt-use integer ())))
                              (#pt-app
                                (#pt-use conjunction ())
                                (#pt-app
                                  (#pt-use integer-equal ())
                                  number
                                  (#pt-app
                                    (#pt-use integer-multiply ())
                                    (#pt-app
                                      (#pt-use integer-power ())
                                      (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                      valuation)
                                    candidate-cofactor))
                                (#pt-pi
                                  (
                                    (denied-proof
                                      (#pt-app
                                        (#pt-use integer-divides ())
                                        (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                        candidate-cofactor)))
                                  #pt-false))))
                          introduce
                          (
                            (#pt-app (#pt-use integer-negative-natural ()) cofactor)
                            (#pt-app
                              (#pt-use conjunction-introduce ())
                              (#pt-app
                                (#pt-use integer-equal ())
                                number
                                (#pt-app
                                  (#pt-use integer-multiply ())
                                  (#pt-app
                                    (#pt-use integer-power ())
                                    (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                    valuation)
                                  (#pt-app (#pt-use integer-negative-natural ()) cofactor)))
                              (#pt-pi
                                (
                                  (denied-proof
                                    (#pt-app
                                      (#pt-use integer-divides ())
                                      (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                      (#pt-app (#pt-use integer-negative-natural ()) cofactor))))
                                #pt-false)
                              (#pt-app
                                (#pt-use integer-transitive ())
                                number
                                (#pt-app (#pt-use integer-negative-natural ()) magnitude)
                                (#pt-app
                                  (#pt-use integer-multiply ())
                                  (#pt-app
                                    (#pt-use integer-power ())
                                    (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                    valuation)
                                  (#pt-app (#pt-use integer-negative-natural ()) cofactor))
                                negative-form
                                (#pt-app
                                  (#pt-use integer-transitive ())
                                  (#pt-app (#pt-use integer-negative-natural ()) magnitude)
                                  (#pt-app
                                    (#pt-use integer-negate ())
                                    (#pt-app
                                      (#pt-use integer-multiply ())
                                      (#pt-app
                                        (#pt-use integer-power ())
                                        (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                        valuation)
                                      (#pt-app (#pt-use integer-of-natural ()) cofactor)))
                                  (#pt-app
                                    (#pt-use integer-multiply ())
                                    (#pt-app
                                      (#pt-use integer-power ())
                                      (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                      valuation)
                                    (#pt-app (#pt-use integer-negative-natural ()) cofactor))
                                  (#pt-app
                                    (#pt-use integer-negate-congruent ())
                                    (#pt-app (#pt-use integer-of-natural ()) magnitude)
                                    (#pt-app
                                      (#pt-use integer-multiply ())
                                      (#pt-app
                                        (#pt-use integer-power ())
                                        (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                        valuation)
                                      (#pt-app (#pt-use integer-of-natural ()) cofactor))
                                    (#pt-app
                                      (#pt-use integer-prime-factor-embedding ())
                                      prime-number
                                      magnitude
                                      valuation
                                      cofactor
                                      (#pt-project conjunction 0 natural-cofactor)))
                                  (#pt-app
                                    (#pt-use integer-symmetric ())
                                    (#pt-app
                                      (#pt-use integer-multiply ())
                                      (#pt-app
                                        (#pt-use integer-power ())
                                        (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                        valuation)
                                      (#pt-app (#pt-use integer-negative-natural ()) cofactor))
                                    (#pt-app
                                      (#pt-use integer-negate ())
                                      (#pt-app
                                        (#pt-use integer-multiply ())
                                        (#pt-app
                                          (#pt-use integer-power ())
                                          (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                          valuation)
                                        (#pt-app (#pt-use integer-of-natural ()) cofactor)))
                                    (#pt-app
                                      (#pt-use integer-multiply-negative-second ())
                                      (#pt-app
                                        (#pt-use integer-power ())
                                        (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                        valuation)
                                      (#pt-app (#pt-use integer-of-natural ()) cofactor)))))
                              (#pt-lambda
                                (
                                  (cofactor-divides
                                    (#pt-app
                                      (#pt-use integer-divides ())
                                      (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                      (#pt-app (#pt-use integer-negative-natural ()) cofactor))))
                                (#pt-app
                                  (#pt-project conjunction 1 natural-cofactor)
                                  (#pt-app
                                    (#pt-use integer-natural-divisibility-reflects ())
                                    prime-number
                                    cofactor
                                    (#pt-app
                                      (#pt-use integer-divides-negative-target ())
                                      (#pt-app (#pt-use integer-of-natural ()) prime-number)
                                      (#pt-app (#pt-use integer-negative-natural ()) cofactor)
                                      cofactor-divides))))))))
                      (#pt-project conjunction 1 packet))))
                (#pt-project conjunction 0 packet)))
            (#pt-app
              (#pt-use conjunction-introduce ())
              (#pt-app (#pt-use natural-prime-order ()) prime-number magnitude valuation)
              (#pt-app (#pt-use integer-magnitude ()) number magnitude)
              packet-natural
              packet-magnitude))))
      order-certificate)))
