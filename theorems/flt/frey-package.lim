      (#pt-app (#pt-use less-than ()) #pt-zero exponent)
      (#pt-app (#pt-use odd ()) exponent)))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app (#pt-use less-than ()) #pt-zero exponent)
      (#pt-app (#pt-use odd ()) exponent)
      (#pt-app
        (#pt-use less-than-transitive ())
        #pt-zero
        (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
        exponent
        (#pt-app (#pt-use zero-less-successor ()) (#pt-numeral 3))
        large-exponent)
      (#pt-app
        (#pt-use prime-not-two-is-odd ())
        exponent
        prime-certificate
        (#pt-lambda
          ((exponent-is-two (#pt-eq #pt-nat exponent (#pt-succ (#pt-succ #pt-zero)))))
          (#pt-app
            (#pt-app (#pt-use not-less-than-self ()) (#pt-succ (#pt-succ #pt-zero)))
            (#pt-app
