              (#pt-succ (#pt-succ #pt-zero))
              (#pt-app
                (#pt-use less-than-transitive ())
                (#pt-succ (#pt-succ #pt-zero))
                (#pt-numeral 3)
                (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
                (#pt-app (#pt-use less-than-successor ()) (#pt-succ (#pt-succ #pt-zero)))
                (#pt-app (#pt-use less-than-successor ()) (#pt-numeral 3)))
              (#pt-app
                (#pt-use substitution (0))
                #pt-nat
                (#pt-lambda
                  ((endpoint #pt-nat))
                  (#pt-app
                    (#pt-use less-than ())
                    (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
                    endpoint))
                exponent
                (#pt-succ (#pt-succ #pt-zero))
                exponent-is-two
                large-exponent))))))))
