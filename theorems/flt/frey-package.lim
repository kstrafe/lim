(#theorem fermat-for-large-prime-from-frey-refutation
  (#universes)
  (#parameters
    (#parameter exponent #pt-nat)
    (#parameter prime-certificate (#pt-app (#pt-use prime ()) exponent))
    (#parameter large-exponent (#pt-app (#pt-use less-than ()) (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero)))) exponent))
    (#parameter frey-refutation (#pt-use frey-packages-refuted ())))
  (#statement (#pt-app (#pt-use fermat-for ()) exponent))
  (#proof
    (#pt-lambda
      (
        (first-natural #pt-nat)
        (second-natural #pt-nat)
        (third-natural #pt-nat)
        (first-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat first-natural #pt-zero))) #pt-false))
        (second-nonzero
          (#pt-pi ((denied-proof (#pt-eq #pt-nat second-natural #pt-zero))) #pt-false))
        (third-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat third-natural #pt-zero))) #pt-false))
        (power-equation
          (#pt-eq
            #pt-nat
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use power ()) first-natural exponent)
              (#pt-app (#pt-use power ()) second-natural exponent))
            (#pt-app (#pt-use power ()) third-natural exponent))))
      (#pt-induct
        exists
        (0)
        (
          (#pt-use integer ())
          (#pt-lambda
            ((candidate-first (#pt-use integer ())))
            (#pt-app
              (#pt-use exists (0))
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-second (#pt-use integer ())))
                (#pt-app
                  (#pt-use exists (0))
                  (#pt-use integer ())
                  (#pt-lambda
                    ((candidate-third (#pt-use integer ())))
                    (#pt-app
                      (#pt-use frey-package-certificate ())
                      exponent
                      candidate-first
                      candidate-second
                      candidate-third)))))))
        (#pt-lambda
          (
            (integer-certificate
              (#pt-app
                (#pt-use exists (0))
                (#pt-use integer ())
                (#pt-lambda
                  ((candidate-first (#pt-use integer ())))
                  (#pt-app
                    (#pt-use exists (0))
                    (#pt-use integer ())
                    (#pt-lambda
                      ((candidate-second (#pt-use integer ())))
                      (#pt-app
                        (#pt-use exists (0))
                        (#pt-use integer ())
                        (#pt-lambda
                          ((candidate-third (#pt-use integer ())))
                          (#pt-app
                            (#pt-use frey-package-certificate ())
                            exponent
                            candidate-first
                            candidate-second
                            candidate-third)))))))))
          #pt-false)
        (
          (#pt-lambda
            (
              (package-first (#pt-use integer ()))
              (second-package-exists
                (#pt-app
                  (#pt-use exists (0))
                  (#pt-use integer ())
                  (#pt-lambda
