; Generated by scripts/generate-flt-point-ideal-addition.py; checked native terms.
; The actual scaled pair-product
; identity used by secant and tangent addition. Assumptions
; are a scalar line-norm equation and a common-ideal unit,
; not an ideal-product conclusion or a point-group law.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias
  point-ideal-addition-common-ideal
  =
  ./point-ideal-addition-product-generators.lim::point-ideal-addition-common-ideal)
(#alias
  point-ideal-addition-forward-inclusion
  =
  ./point-ideal-addition-forward-inclusion.lim::point-ideal-addition-forward-inclusion)
(#alias
  point-ideal-addition-left-product
  =
  ./point-ideal-addition-product-generators.lim::point-ideal-addition-left-product)
(#alias
  point-ideal-addition-reverse-inclusion
  =
  ./point-ideal-addition-reverse-inclusion.lim::point-ideal-addition-reverse-inclusion)
(#alias
  point-ideal-addition-right-product
  =
  ./point-ideal-addition-product-generators.lim::point-ideal-addition-right-product)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-ideal-equal = ./ring-ideal-data.lim::ring-ideal-equal)
(#alias ring-ideal-subset = ./ring-ideal-data.lim::ring-ideal-subset)
(#alias ring-ideal-top = ./ring-ideal-zero-unit.lim::ring-ideal-top)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-negate = ./commutative-ring-data.lim::ring-negate)
(#theorem point-ideal-addition-identity
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-X Carrier)
    (#parameter second-X Carrier)
    (#parameter sum-X Carrier)
    (#parameter line Carrier)
    (#parameter opposite Carrier)
    (#parameter norm-equation (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring line opposite) (#pt-app (#pt-use ring-negate ()) Carrier coefficient-ring (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring sum-X (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-X second-X)))))
    (#parameter common-unit (#pt-app (#pt-use ring-ideal-equal ()) Carrier coefficient-ring (#pt-app (#pt-use point-ideal-addition-common-ideal ()) Carrier coefficient-ring first-X second-X sum-X line opposite) (#pt-app (#pt-use ring-ideal-top ()) Carrier coefficient-ring))))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use point-ideal-addition-left-product ())
        Carrier
        coefficient-ring
        first-X
        second-X
        sum-X
        line
        opposite)
      (#pt-app
        (#pt-use point-ideal-addition-right-product ())
        Carrier
        coefficient-ring
        first-X
        second-X
        sum-X
        line
        opposite)))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use point-ideal-addition-left-product ())
          Carrier
          coefficient-ring
          first-X
          second-X
          sum-X
          line
          opposite)
        (#pt-app
          (#pt-use point-ideal-addition-right-product ())
          Carrier
          coefficient-ring
          first-X
          second-X
          sum-X
          line
          opposite))
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use point-ideal-addition-right-product ())
          Carrier
          coefficient-ring
          first-X
          second-X
          sum-X
          line
          opposite)
        (#pt-app
          (#pt-use point-ideal-addition-left-product ())
          Carrier
          coefficient-ring
          first-X
          second-X
          sum-X
          line
          opposite))
      (#pt-app
        (#pt-use point-ideal-addition-forward-inclusion ())
        Carrier
        coefficient-ring
        first-X
        second-X
        sum-X
        line
        opposite
        norm-equation)
      (#pt-app
        (#pt-use point-ideal-addition-reverse-inclusion ())
        Carrier
        coefficient-ring
        first-X
        second-X
        sum-X
        line
        opposite
        norm-equation
        common-unit))))
