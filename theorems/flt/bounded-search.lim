; Exhaustive prefix search with proof-carrying results for every Nat bound.
; Pointwise decisions are explicit inputs, not an unchecked logical oracle.
(#alias add = ../fermat_statement.lim::add)
(#alias exists = ./logic-exists.lim::exists)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias any-up-to = ./bounded-existence.lim::any-up-to)
(#alias any-up-to-grow = ./bounded-existence.lim::any-up-to-grow)
(#alias any-up-to-here = ./bounded-existence.lim::any-up-to-here)
(#alias decision = ./logical-decision.lim::decision)
(#alias decision-disjunction = ./decidable-logic.lim::decision-disjunction)
(#alias decision-evidence = ./decidable-logic.lim::decision-evidence)
(#alias symmetry = ./equality.lim::symmetry)
(#alias substitution = ./equality.lim::substitution)
(#alias add-zero-right = ./natural-addition.lim::add-zero-right)
(#alias add-successor-right = ./natural-addition.lim::add-successor-right)
(#theorem any-up-to-has-witness
  (#universes)
  (#parameters
    (#parameter property (#pt-pi ((index #pt-nat)) #pt-prop))
    (#parameter bound #pt-nat)
    (#parameter prefix-found (#pt-app (#pt-use any-up-to ()) property bound)))
  (#statement (#pt-app (#pt-use exists (0)) #pt-nat property))
  (#proof
    (#pt-app
      (#pt-nat-induct
        (#pt-lambda
          ((ordinal #pt-nat))
          (#pt-pi
            ((candidate-proof (#pt-app (#pt-use any-up-to ()) property ordinal)))
            (#pt-app (#pt-use exists (0)) #pt-nat property)))
        (#pt-lambda
          ((at-zero (#pt-app property #pt-zero)))
          (#pt-construct exists (0) (#pt-nat property) introduce (#pt-zero at-zero)))
        (#pt-lambda
          (
            (previous #pt-nat)
            (previous-witness
              (#pt-pi
                ((candidate-proof (#pt-app (#pt-use any-up-to ()) property previous)))
                (#pt-app (#pt-use exists (0)) #pt-nat property)))
            (current-proof (#pt-app (#pt-use any-up-to ()) property (#pt-succ previous))))
          (#pt-app
            (#pt-use disjunction-eliminate ())
            (#pt-app (#pt-use any-up-to ()) property previous)
            (#pt-app property (#pt-succ previous))
            (#pt-app (#pt-use exists (0)) #pt-nat property)
            (#pt-lambda
              ((found-before (#pt-app (#pt-use any-up-to ()) property previous)))
              (#pt-app previous-witness found-before))
            (#pt-lambda
              ((at-endpoint (#pt-app property (#pt-succ previous))))
              (#pt-construct
                exists
                (0)
                (#pt-nat property)
                introduce
                ((#pt-succ previous) at-endpoint)))
            current-proof))
        bound)
      prefix-found)))
(#theorem any-up-to-with-gap
  (#universes)
  (#parameters
    (#parameter property (#pt-pi ((index #pt-nat)) #pt-prop))
    (#parameter witness #pt-nat)
    (#parameter gap #pt-nat)
    (#parameter at-witness (#pt-app property witness)))
  (#statement (#pt-app (#pt-use any-up-to ()) property (#pt-app (#pt-use add ()) witness gap)))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((difference #pt-nat))
        (#pt-app (#pt-use any-up-to ()) property (#pt-app (#pt-use add ()) witness difference)))
      (#pt-app
        (#pt-use substitution (0))
        #pt-nat
        (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use any-up-to ()) property endpoint))
        witness
        (#pt-app (#pt-use add ()) witness #pt-zero)
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          (#pt-app (#pt-use add ()) witness #pt-zero)
          witness
          (#pt-app (#pt-use add-zero-right ()) witness))
        (#pt-app (#pt-use any-up-to-here ()) property witness at-witness))
      (#pt-lambda
        (
          (previous #pt-nat)
          (previous-result
            (#pt-app (#pt-use any-up-to ()) property (#pt-app (#pt-use add ()) witness previous))))
        (#pt-app
          (#pt-use substitution (0))
          #pt-nat
          (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use any-up-to ()) property endpoint))
          (#pt-succ (#pt-app (#pt-use add ()) witness previous))
          (#pt-app (#pt-use add ()) witness (#pt-succ previous))
          (#pt-app
            (#pt-use symmetry (0))
            #pt-nat
            (#pt-app (#pt-use add ()) witness (#pt-succ previous))
            (#pt-succ (#pt-app (#pt-use add ()) witness previous))
            (#pt-app (#pt-use add-successor-right ()) witness previous))
          (#pt-app
            (#pt-use any-up-to-grow ())
            property
            (#pt-app (#pt-use add ()) witness previous)
            previous-result)))
      gap)))
(#math-definition decide-any-up-to ()
  (#pt-pi
    (
      (property (#pt-pi ((index #pt-nat)) #pt-prop))
      (pointwise-decision
        (#pt-pi ((candidate #pt-nat)) (#pt-app (#pt-use decision ()) (#pt-app property candidate))))
      (bound #pt-nat))
    (#pt-app (#pt-use decision ()) (#pt-app (#pt-use any-up-to ()) property bound)))
  (#pt-lambda
    (
      (property (#pt-pi ((index #pt-nat)) #pt-prop))
      (pointwise-decision
        (#pt-pi ((candidate #pt-nat)) (#pt-app (#pt-use decision ()) (#pt-app property candidate))))
      (bound #pt-nat))
    (#pt-nat-induct
      (#pt-lambda
        ((ordinal #pt-nat))
        (#pt-app (#pt-use decision ()) (#pt-app (#pt-use any-up-to ()) property ordinal)))
      (#pt-app pointwise-decision #pt-zero)
      (#pt-lambda
        (
          (previous #pt-nat)
          (previous-decision
            (#pt-app (#pt-use decision ()) (#pt-app (#pt-use any-up-to ()) property previous))))
        (#pt-app
          (#pt-use decision-disjunction ())
          (#pt-app (#pt-use any-up-to ()) property previous)
          (#pt-app property (#pt-succ previous))
          previous-decision
          (#pt-app pointwise-decision (#pt-succ previous))))
      bound)))
(#theorem bounded-existence-decided
  (#universes)
  (#parameters
    (#parameter property (#pt-pi ((index #pt-nat)) #pt-prop))
    (#parameter pointwise-decision (#pt-pi ((candidate #pt-nat)) (#pt-app (#pt-use decision ()) (#pt-app property candidate))))
    (#parameter bound #pt-nat))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app (#pt-use any-up-to ()) property bound)
      (#pt-pi ((denied-proof (#pt-app (#pt-use any-up-to ()) property bound))) #pt-false)))
  (#proof
    (#pt-app
      (#pt-use decision-evidence ())
      (#pt-app (#pt-use any-up-to ()) property bound)
      (#pt-app (#pt-use decide-any-up-to ()) property pointwise-decision bound))))
