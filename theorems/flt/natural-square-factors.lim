        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-eq #pt-nat remaining-factor (#pt-succ #pt-zero))
          (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) remaining-factor)
          (#pt-app (#pt-use is-square ()) first)
          (#pt-lambda
            ((one-equation (#pt-eq #pt-nat remaining-factor (#pt-succ #pt-zero))))
            (#pt-construct
              exists
              (0)
              (#pt-nat
                (#pt-lambda
                  ((candidate-root #pt-nat))
                  (#pt-eq
                    #pt-nat
                    first
                    (#pt-app (#pt-use multiply ()) candidate-root candidate-root))))
              introduce
              (prime-number
                (#pt-app
                  (#pt-use transitivity (0))
                  #pt-nat
                  first
                  (#pt-app
                    (#pt-use multiply ())
                    prime-number
                    (#pt-app (#pt-use multiply ()) prime-number remaining-factor))
                  (#pt-app (#pt-use multiply ()) prime-number prime-number)
                  factor-equation
                  (#pt-app
                    (#pt-use transitivity (0))
                    #pt-nat
                    (#pt-app
                      (#pt-use multiply ())
                      prime-number
                      (#pt-app (#pt-use multiply ()) prime-number remaining-factor))
                    (#pt-app
                      (#pt-use multiply ())
                      prime-number
                      (#pt-app (#pt-use multiply ()) prime-number (#pt-succ #pt-zero)))
                    (#pt-app (#pt-use multiply ()) prime-number prime-number)
                    (#pt-app
                      (#pt-use congruence (0 0))
                      #pt-nat
                      #pt-nat
                      (#pt-lambda
                        ((factor-value #pt-nat))
                        (#pt-app
                          (#pt-use multiply ())
                          prime-number
                          (#pt-app (#pt-use multiply ()) prime-number factor-value)))
                      remaining-factor
                      (#pt-succ #pt-zero)
                      one-equation)
                    (#pt-app
                      (#pt-use congruence (0 0))
                      #pt-nat
                      #pt-nat
                      (#pt-lambda
                        ((factor-value #pt-nat))
                        (#pt-app (#pt-use multiply ()) prime-number factor-value))
                      (#pt-app (#pt-use multiply ()) prime-number (#pt-succ #pt-zero))
                      prime-number
                      (#pt-app (#pt-use multiply-one-right ()) prime-number)))))))
          (#pt-lambda
            (
              (larger-than-one
                (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) remaining-factor)))
            (#pt-induct
              exists
              (0)
              (#pt-nat
                (#pt-lambda
                  ((candidate-root #pt-nat))
