; A coprime natural factor of a square is itself a square.
; This specializes the mathematical square-extraction prerequisite used by
; Int.sq_of_gcd_eq_one in FLT/Four.lean to nonnegative natural factors.
; Strong induction removes a prime square; Euclid's lemma supplies the second factor.
; This is not the signed-integer theorem or the FLT exponent-four theorem.
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#alias less-than-transitive = ./natural-order.lim::less-than-transitive)
(#alias strong-induction = ./natural-order.lim::strong-induction)
(#alias zero-one-or-large = ./natural-small-cases.lim::zero-one-or-large)
(#alias less-than-upper-nonzero = ./natural-small-cases.lim::less-than-upper-nonzero)
(#alias multiply-zero-right = ./natural-multiplication-right.lim::multiply-zero-right)
(#alias multiply-one-right = ./natural-multiplication-right.lim::multiply-one-right)
(#alias multiply-associative = ./natural-multiplication.lim::multiply-associative)
(#alias multiply-commutative = ./natural-multiplication-commutative.lim::multiply-commutative)
(#alias multiply-nonzero = ./natural-nonzero.lim::multiply-nonzero)
(#alias square-product = ./natural-square-arithmetic.lim::square-product)
(#alias
  multiply-cancel-left-nonzero
