(#theorem square-factor-prime-step
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter root #pt-nat)
    (#parameter prime-number #pt-nat)
    (#parameter smaller-cases (#pt-pi ((earlier #pt-nat) (earlier-proof (#pt-app (#pt-use less-than ()) earlier first))) (#pt-pi ((other #pt-nat) (square-root #pt-nat) (coprime-evidence (#pt-app (#pt-use coprime ()) earlier other)) (square-equation (#pt-eq #pt-nat (#pt-app (#pt-use multiply ()) earlier other) (#pt-app (#pt-use multiply ()) square-root square-root)))) (#pt-app (#pt-use is-square ()) earlier))))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter prime-divides (#pt-app (#pt-use divides ()) prime-number first))
    (#parameter coprime-proof (#pt-app (#pt-use coprime ()) first second))
    (#parameter square-equation (#pt-eq #pt-nat (#pt-app (#pt-use multiply ()) first second) (#pt-app (#pt-use multiply ()) root root))))
  (#statement (#pt-app (#pt-use is-square ()) first))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-factor #pt-nat))
          (#pt-eq #pt-nat first (#pt-app (#pt-use multiply ()) prime-number candidate-factor))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
