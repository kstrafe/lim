                        #pt-nat
                        first
                        (#pt-app
                          (#pt-use multiply ())
                          prime-number
                          (#pt-app (#pt-use multiply ()) prime-number remaining-factor))
                        (#pt-app
                          (#pt-use multiply ())
                          (#pt-app (#pt-use multiply ()) prime-number smaller-root)
                          (#pt-app (#pt-use multiply ()) prime-number smaller-root))
                        factor-equation
                        (#pt-app
                          (#pt-use transitivity (0))
                          #pt-nat
                          (#pt-app
                            (#pt-use multiply ())
                            prime-number
                            (#pt-app (#pt-use multiply ()) prime-number remaining-factor))
                          (#pt-app
                            (#pt-use multiply ())
                            (#pt-app (#pt-use multiply ()) prime-number prime-number)
                            remaining-factor)
                          (#pt-app
                            (#pt-use multiply ())
                            (#pt-app (#pt-use multiply ()) prime-number smaller-root)
                            (#pt-app (#pt-use multiply ()) prime-number smaller-root))
                          (#pt-app
                            (#pt-use symmetry (0))
                            #pt-nat
                            (#pt-app
                              (#pt-use multiply ())
                              (#pt-app (#pt-use multiply ()) prime-number prime-number)
                              remaining-factor)
                            (#pt-app
                              (#pt-use multiply ())
                              prime-number
                              (#pt-app (#pt-use multiply ()) prime-number remaining-factor))
                            (#pt-app
                              (#pt-use multiply-associative ())
                              prime-number
                              prime-number
                              remaining-factor))
                          (#pt-app
                            (#pt-use transitivity (0))
                            #pt-nat
                            (#pt-app
                              (#pt-use multiply ())
                              (#pt-app (#pt-use multiply ()) prime-number prime-number)
                              remaining-factor)
                            (#pt-app
                              (#pt-use multiply ())
                              (#pt-app (#pt-use multiply ()) prime-number prime-number)
                              (#pt-app (#pt-use multiply ()) smaller-root smaller-root))
                            (#pt-app
                              (#pt-use multiply ())
                              (#pt-app (#pt-use multiply ()) prime-number smaller-root)
                              (#pt-app (#pt-use multiply ()) prime-number smaller-root))
                            (#pt-app
                              (#pt-use congruence (0 0))
                              #pt-nat
                              #pt-nat
                              (#pt-lambda
                                ((factor-value #pt-nat))
                                (#pt-app
                                  (#pt-use multiply ())
                                  (#pt-app (#pt-use multiply ()) prime-number prime-number)
                                  factor-value))
                              remaining-factor
                              (#pt-app (#pt-use multiply ()) smaller-root smaller-root)
                              smaller-equation)
                            (#pt-app
                              (#pt-use symmetry (0))
                              #pt-nat
                              (#pt-app
                                (#pt-use multiply ())
                                (#pt-app (#pt-use multiply ()) prime-number smaller-root)
                                (#pt-app (#pt-use multiply ()) prime-number smaller-root))
                              (#pt-app
                                (#pt-use multiply ())
                                (#pt-app (#pt-use multiply ()) prime-number prime-number)
                                (#pt-app (#pt-use multiply ()) smaller-root smaller-root))
