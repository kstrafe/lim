(#alias divides-multiple = ./natural-divisibility.lim::divides-multiple)
(#alias divides-transitive = ./natural-divisibility.lim::divides-transitive)
(#alias prime = ./natural-prime.lim::prime)
(#alias prime-larger-than-one = ./natural-prime.lim::prime-larger-than-one)
(#alias exists-prime-divisor = ./natural-prime.lim::exists-prime-divisor)
(#alias prime-not-one = ./natural-prime-divisibility.lim::prime-not-one)
(#alias prime-divides-square = ./natural-prime-divisibility.lim::prime-divides-square)
(#alias prime-divides-product = ./natural-prime-divisibility.lim::prime-divides-product)
(#alias coprime = ./natural-coprime.lim::coprime)
(#alias coprime-symmetric = ./natural-coprime.lim::coprime-symmetric)
(#alias coprime-divisor-right = ./natural-euclid.lim::coprime-divisor-right)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias congruence = ./equality.lim::congruence)
(#alias substitution = ./equality.lim::substitution)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#math-definition is-square ()
  (#pt-pi ((number #pt-nat)) #pt-prop)
  (#pt-lambda
    ((number #pt-nat))
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-root #pt-nat))
        (#pt-eq #pt-nat number (#pt-app (#pt-use multiply ()) candidate-root candidate-root))))))
(#theorem square-remove-first-factor
  (#universes)
  (#parameters
    (#parameter factor #pt-nat)
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter root-factor #pt-nat)
    (#parameter factor-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat factor #pt-zero))) #pt-false))
    (#parameter equation (#pt-eq #pt-nat (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use multiply ()) factor first) second) (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use multiply ()) factor root-factor) (#pt-app (#pt-use multiply ()) factor root-factor)))))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use multiply ()) first second)
      (#pt-app (#pt-use multiply ()) factor (#pt-app (#pt-use multiply ()) root-factor root-factor))))
  (#proof
    (#pt-app
      (#pt-use multiply-cancel-left-nonzero ())
      factor
      (#pt-app (#pt-use multiply ()) first second)
      (#pt-app (#pt-use multiply ()) factor (#pt-app (#pt-use multiply ()) root-factor root-factor))
      factor-nonzero
      (#pt-app
        (#pt-use transitivity (0))
        #pt-nat
        (#pt-app (#pt-use multiply ()) factor (#pt-app (#pt-use multiply ()) first second))
        (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use multiply ()) factor first) second)
        (#pt-app
          (#pt-use multiply ())
          factor
          (#pt-app
            (#pt-use multiply ())
            factor
            (#pt-app (#pt-use multiply ()) root-factor root-factor)))
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use multiply ()) factor first) second)
          (#pt-app (#pt-use multiply ()) factor (#pt-app (#pt-use multiply ()) first second))
          (#pt-app (#pt-use multiply-associative ()) factor first second))
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use multiply ()) factor first) second)
          (#pt-app
            (#pt-use multiply ())
            (#pt-app (#pt-use multiply ()) factor root-factor)
            (#pt-app (#pt-use multiply ()) factor root-factor))
          (#pt-app
            (#pt-use multiply ())
            factor
            (#pt-app
              (#pt-use multiply ())
              factor
              (#pt-app (#pt-use multiply ()) root-factor root-factor)))
          equation
          (#pt-app
            (#pt-use transitivity (0))
            #pt-nat
            (#pt-app
              (#pt-use multiply ())
              (#pt-app (#pt-use multiply ()) factor root-factor)
              (#pt-app (#pt-use multiply ()) factor root-factor))
            (#pt-app
              (#pt-use multiply ())
              (#pt-app (#pt-use multiply ()) factor factor)
              (#pt-app (#pt-use multiply ()) root-factor root-factor))
            (#pt-app
              (#pt-use multiply ())
              factor
              (#pt-app
                (#pt-use multiply ())
                factor
                (#pt-app (#pt-use multiply ()) root-factor root-factor)))
            (#pt-app (#pt-use square-product ()) factor root-factor)
            (#pt-app
              (#pt-use multiply-associative ())
              factor
              factor
              (#pt-app (#pt-use multiply ()) root-factor root-factor))))))))
(#theorem square-remove-second-factor
  (#universes)
  (#parameters
    (#parameter factor #pt-nat)
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter root-factor #pt-nat)
    (#parameter factor-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat factor #pt-zero))) #pt-false))
    (#parameter equation (#pt-eq #pt-nat (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use multiply ()) factor first) second) (#pt-app (#pt-use multiply ()) factor (#pt-app (#pt-use multiply ()) root-factor root-factor)))))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use multiply ()) first second)
      (#pt-app (#pt-use multiply ()) root-factor root-factor)))
  (#proof
    (#pt-app
      (#pt-use multiply-cancel-left-nonzero ())
      factor
      (#pt-app (#pt-use multiply ()) first second)
      (#pt-app (#pt-use multiply ()) root-factor root-factor)
      factor-nonzero
      (#pt-app
        (#pt-use transitivity (0))
        #pt-nat
        (#pt-app (#pt-use multiply ()) factor (#pt-app (#pt-use multiply ()) first second))
        (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use multiply ()) factor first) second)
        (#pt-app
          (#pt-use multiply ())
          factor
          (#pt-app (#pt-use multiply ()) root-factor root-factor))
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use multiply ()) factor first) second)
          (#pt-app (#pt-use multiply ()) factor (#pt-app (#pt-use multiply ()) first second))
          (#pt-app (#pt-use multiply-associative ()) factor first second))
        equation))))
(#theorem square-restore-double-prime-factor
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter prime-number #pt-nat)
    (#parameter remaining-factor #pt-nat)
    (#parameter reduced-root #pt-nat)
    (#parameter smaller-cases (#pt-pi ((earlier #pt-nat) (earlier-proof (#pt-app (#pt-use less-than ()) earlier first))) (#pt-pi ((other #pt-nat) (square-root #pt-nat) (coprime-evidence (#pt-app (#pt-use coprime ()) earlier other)) (square-equation (#pt-eq #pt-nat (#pt-app (#pt-use multiply ()) earlier other) (#pt-app (#pt-use multiply ()) square-root square-root)))) (#pt-app (#pt-use is-square ()) earlier))))
    (#parameter factor-equation (#pt-eq #pt-nat first (#pt-app (#pt-use multiply ()) prime-number (#pt-app (#pt-use multiply ()) prime-number remaining-factor))))
    (#parameter reduced-equation (#pt-eq #pt-nat (#pt-app (#pt-use multiply ()) remaining-factor second) (#pt-app (#pt-use multiply ()) reduced-root reduced-root)))
    (#parameter coprime-proof (#pt-app (#pt-use coprime ()) first second))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number)))
  (#statement (#pt-app (#pt-use is-square ()) first))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-eq #pt-nat remaining-factor #pt-zero)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-eq #pt-nat remaining-factor (#pt-succ #pt-zero))
        (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) remaining-factor))
      (#pt-app (#pt-use is-square ()) first)
      (#pt-lambda
        ((zero-equation (#pt-eq #pt-nat remaining-factor #pt-zero)))
        (#pt-construct
          exists
          (0)
          (#pt-nat
            (#pt-lambda
              ((candidate-root #pt-nat))
              (#pt-eq #pt-nat first (#pt-app (#pt-use multiply ()) candidate-root candidate-root))))
          introduce
          (#pt-zero
            (#pt-app
              (#pt-use transitivity (0))
              #pt-nat
              first
              (#pt-app
                (#pt-use multiply ())
                prime-number
                (#pt-app (#pt-use multiply ()) prime-number remaining-factor))
              #pt-zero
              factor-equation
              (#pt-app
                (#pt-use transitivity (0))
                #pt-nat
                (#pt-app
                  (#pt-use multiply ())
