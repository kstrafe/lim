                    (#pt-app (#pt-use multiply ()) prime-number #pt-zero))
                  (#pt-app (#pt-use multiply ()) prime-number #pt-zero)
                  #pt-zero
                  (#pt-app
                    (#pt-use congruence (0 0))
                    #pt-nat
                    #pt-nat
                    (#pt-lambda
                      ((factor-value #pt-nat))
                      (#pt-app (#pt-use multiply ()) prime-number factor-value))
                    (#pt-app (#pt-use multiply ()) prime-number #pt-zero)
