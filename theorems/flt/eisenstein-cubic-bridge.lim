  =
  ./eisenstein-lambda.lim::eisenstein-lambda-divides-of-three)
(#theorem eisenstein-one-multiply
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) number)
      number))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project
          eisenstein
          0
          (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) number))
        (#pt-project eisenstein 0 number))
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project
          eisenstein
          1
          (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) number))
        (#pt-project eisenstein 1 number))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-project
          eisenstein
          0
          (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) number))
        (#pt-app
          (#pt-use integer-add ())
          (#pt-project eisenstein 0 number)
          (#pt-use integer-zero ()))
        (#pt-project eisenstein 0 number)
        (#pt-app
          (#pt-use integer-add-congruent ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-use integer-one ())
            (#pt-project eisenstein 0 number))
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-use integer-zero ())
              (#pt-project eisenstein 1 number)))
          (#pt-project eisenstein 0 number)
          (#pt-use integer-zero ())
          (#pt-app (#pt-use integer-one-multiply ()) (#pt-project eisenstein 0 number))
          (#pt-app
            (#pt-use integer-negate-congruent ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-use integer-zero ())
              (#pt-project eisenstein 1 number))
            (#pt-use integer-zero ())
            (#pt-app (#pt-use integer-zero-multiply ()) (#pt-project eisenstein 1 number))))
        (#pt-app (#pt-use integer-add-zero ()) (#pt-project eisenstein 0 number)))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-project
          eisenstein
          1
          (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) number))
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-project eisenstein 1 number)
            (#pt-use integer-zero ()))
          (#pt-use integer-zero ()))
        (#pt-project eisenstein 1 number)
        (#pt-app
          (#pt-use integer-add-congruent ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-use integer-one ())
              (#pt-project eisenstein 1 number))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-use integer-zero ())
              (#pt-project eisenstein 0 number)))
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-use integer-zero ())
              (#pt-project eisenstein 1 number)))
          (#pt-app
            (#pt-use integer-add ())
            (#pt-project eisenstein 1 number)
            (#pt-use integer-zero ()))
          (#pt-use integer-zero ())
          (#pt-app
            (#pt-use integer-add-congruent ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-use integer-one ())
              (#pt-project eisenstein 1 number))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-use integer-zero ())
              (#pt-project eisenstein 0 number))
            (#pt-project eisenstein 1 number)
            (#pt-use integer-zero ())
            (#pt-app (#pt-use integer-one-multiply ()) (#pt-project eisenstein 1 number))
            (#pt-app (#pt-use integer-zero-multiply ()) (#pt-project eisenstein 0 number)))
          (#pt-app
            (#pt-use integer-negate-congruent ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-use integer-zero ())
              (#pt-project eisenstein 1 number))
            (#pt-use integer-zero ())
            (#pt-app (#pt-use integer-zero-multiply ()) (#pt-project eisenstein 1 number))))
        (#pt-app
          (#pt-use integer-transitive ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-project eisenstein 1 number)
              (#pt-use integer-zero ()))
            (#pt-use integer-zero ()))
          (#pt-app
            (#pt-use integer-add ())
            (#pt-project eisenstein 1 number)
            (#pt-use integer-zero ()))
          (#pt-project eisenstein 1 number)
          (#pt-app
            (#pt-use integer-add-congruent ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-project eisenstein 1 number)
              (#pt-use integer-zero ()))
            (#pt-use integer-zero ())
            (#pt-project eisenstein 1 number)
            (#pt-use integer-zero ())
            (#pt-app (#pt-use integer-add-zero ()) (#pt-project eisenstein 1 number))
            (#pt-app (#pt-use integer-reflexive ()) (#pt-use integer-zero ())))
          (#pt-app (#pt-use integer-add-zero ()) (#pt-project eisenstein 1 number)))))))
(#theorem eisenstein-one-unit
  (#universes)
  (#parameters)
  (#statement (#pt-app (#pt-use eisenstein-unit ()) (#pt-use eisenstein-one ())))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-inverse (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-use eisenstein-one ())
                candidate-inverse)
              (#pt-use eisenstein-one ()))
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                candidate-inverse
                (#pt-use eisenstein-one ()))
              (#pt-use eisenstein-one ())))))
      introduce
      (
        (#pt-use eisenstein-one ())
        (#pt-app
          (#pt-use conjunction-introduce ())
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-use eisenstein-one ())
              (#pt-use eisenstein-one ()))
            (#pt-use eisenstein-one ()))
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-use eisenstein-one ())
              (#pt-use eisenstein-one ()))
            (#pt-use eisenstein-one ()))
          (#pt-app (#pt-use eisenstein-one-multiply ()) (#pt-use eisenstein-one ()))
          (#pt-app (#pt-use eisenstein-one-multiply ()) (#pt-use eisenstein-one ())))))))
(#math-definition eisenstein-fermat-three-general ()
  #pt-prop
  (#pt-pi
    (
      (first (#pt-use eisenstein ()))
      (second (#pt-use eisenstein ()))
      (third (#pt-use eisenstein ()))
      (unit (#pt-use eisenstein ()))
      (unit-proof (#pt-app (#pt-use eisenstein-unit ()) unit))
      (third-nonzero
        (#pt-pi
          (
            (denied-proof
              (#pt-app (#pt-use eisenstein-equal ()) third (#pt-use eisenstein-zero ()))))
          #pt-false))
      (first-nondivisible
        (#pt-pi
          (
            (denied-proof
              (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) first)))
          #pt-false))
      (second-nondivisible
        (#pt-pi
          (
            (denied-proof
              (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) second)))
          #pt-false))
      (third-divisible
        (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) third))
      (pair-coprime (#pt-app (#pt-use eisenstein-coprime ()) first second)))
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-power ()) first (#pt-numeral 3))
              (#pt-app (#pt-use eisenstein-power ()) second (#pt-numeral 3)))
            (#pt-app
              (#pt-use eisenstein-multiply ())
              unit
              (#pt-app (#pt-use eisenstein-power ()) third (#pt-numeral 3))))))
      #pt-false)))
(#theorem integer-fermat-three-residual-of-eisenstein
  (#universes)
  (#parameters
    (#parameter general-case (#pt-use eisenstein-fermat-three-general ()))
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter third-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use integer-equal ()) third (#pt-use integer-zero ())))) #pt-false))
    (#parameter first-nondivisible (#pt-pi ((denied-proof (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)) first))) #pt-false))
    (#parameter second-nondivisible (#pt-pi ((denied-proof (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)) second))) #pt-false))
    (#parameter third-divisible (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)) third))
    (#parameter pair-coprime (#pt-app (#pt-use integer-coprime ()) first second)))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app (#pt-use integer-power ()) first (#pt-numeral 3))
              (#pt-app (#pt-use integer-power ()) second (#pt-numeral 3)))
            (#pt-app (#pt-use integer-power ()) third (#pt-numeral 3)))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (integer-equation
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app (#pt-use integer-power ()) first (#pt-numeral 3))
              (#pt-app (#pt-use integer-power ()) second (#pt-numeral 3)))
            (#pt-app (#pt-use integer-power ()) third (#pt-numeral 3)))))
      (#pt-app
        (#pt-app
          general-case
          (#pt-app (#pt-use eisenstein-of-integer ()) first)
          (#pt-app (#pt-use eisenstein-of-integer ()) second)
          (#pt-app (#pt-use eisenstein-of-integer ()) third)
          (#pt-use eisenstein-one ())
          (#pt-use eisenstein-one-unit ())
          (#pt-app (#pt-use eisenstein-embedded-nonzero ()) third third-nonzero)
          (#pt-app (#pt-use eisenstein-lambda-not-divides-of-integer ()) first first-nondivisible)
          (#pt-app (#pt-use eisenstein-lambda-not-divides-of-integer ()) second second-nondivisible)
          (#pt-app (#pt-use eisenstein-lambda-divides-of-three ()) third third-divisible)
          (#pt-app (#pt-use eisenstein-coprime-of-integer ()) first second pair-coprime))
        (#pt-app
          (#pt-use eisenstein-transitive ())
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app
              (#pt-use eisenstein-power ())
              (#pt-app (#pt-use eisenstein-of-integer ()) first)
              (#pt-numeral 3))
            (#pt-app
              (#pt-use eisenstein-power ())
              (#pt-app (#pt-use eisenstein-of-integer ()) second)
              (#pt-numeral 3)))
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app
              (#pt-use eisenstein-of-integer ())
              (#pt-app (#pt-use integer-power ()) first (#pt-numeral 3)))
            (#pt-app
              (#pt-use eisenstein-of-integer ())
              (#pt-app (#pt-use integer-power ()) second (#pt-numeral 3))))
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-use eisenstein-one ())
            (#pt-app
              (#pt-use eisenstein-power ())
              (#pt-app (#pt-use eisenstein-of-integer ()) third)
              (#pt-numeral 3)))
          (#pt-app
            (#pt-use eisenstein-add-congruent ())
            (#pt-app
              (#pt-use eisenstein-power ())
              (#pt-app (#pt-use eisenstein-of-integer ()) first)
              (#pt-numeral 3))
            (#pt-app
              (#pt-use eisenstein-power ())
              (#pt-app (#pt-use eisenstein-of-integer ()) second)
              (#pt-numeral 3))
            (#pt-app
              (#pt-use eisenstein-of-integer ())
              (#pt-app (#pt-use integer-power ()) first (#pt-numeral 3)))
            (#pt-app
              (#pt-use eisenstein-of-integer ())
              (#pt-app (#pt-use integer-power ()) second (#pt-numeral 3)))
            (#pt-app
              (#pt-use eisenstein-symmetric ())
              (#pt-app
                (#pt-use eisenstein-of-integer ())
                (#pt-app (#pt-use integer-power ()) first (#pt-numeral 3)))
              (#pt-app
                (#pt-use eisenstein-power ())
                (#pt-app (#pt-use eisenstein-of-integer ()) first)
                (#pt-numeral 3))
              (#pt-app (#pt-use eisenstein-of-integer-power ()) first (#pt-numeral 3)))
            (#pt-app
              (#pt-use eisenstein-symmetric ())
              (#pt-app
                (#pt-use eisenstein-of-integer ())
                (#pt-app (#pt-use integer-power ()) second (#pt-numeral 3)))
              (#pt-app
                (#pt-use eisenstein-power ())
                (#pt-app (#pt-use eisenstein-of-integer ()) second)
                (#pt-numeral 3))
              (#pt-app (#pt-use eisenstein-of-integer-power ()) second (#pt-numeral 3))))
          (#pt-app
            (#pt-use eisenstein-transitive ())
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app
                (#pt-use eisenstein-of-integer ())
                (#pt-app (#pt-use integer-power ()) first (#pt-numeral 3)))
              (#pt-app
                (#pt-use eisenstein-of-integer ())
                (#pt-app (#pt-use integer-power ()) second (#pt-numeral 3))))
            (#pt-app
              (#pt-use eisenstein-of-integer ())
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app (#pt-use integer-power ()) first (#pt-numeral 3))
                (#pt-app (#pt-use integer-power ()) second (#pt-numeral 3))))
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-use eisenstein-one ())
              (#pt-app
                (#pt-use eisenstein-power ())
                (#pt-app (#pt-use eisenstein-of-integer ()) third)
                (#pt-numeral 3)))
            (#pt-app
              (#pt-use eisenstein-symmetric ())
              (#pt-app
                (#pt-use eisenstein-of-integer ())
                (#pt-app
                  (#pt-use integer-add ())
                  (#pt-app (#pt-use integer-power ()) first (#pt-numeral 3))
                  (#pt-app (#pt-use integer-power ()) second (#pt-numeral 3))))
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-app
                  (#pt-use eisenstein-of-integer ())
                  (#pt-app (#pt-use integer-power ()) first (#pt-numeral 3)))
                (#pt-app
                  (#pt-use eisenstein-of-integer ())
                  (#pt-app (#pt-use integer-power ()) second (#pt-numeral 3))))
              (#pt-app
                (#pt-use eisenstein-of-integer-add ())
                (#pt-app (#pt-use integer-power ()) first (#pt-numeral 3))
                (#pt-app (#pt-use integer-power ()) second (#pt-numeral 3))))
            (#pt-app
              (#pt-use eisenstein-transitive ())
              (#pt-app
                (#pt-use eisenstein-of-integer ())
                (#pt-app
                  (#pt-use integer-add ())
                  (#pt-app (#pt-use integer-power ()) first (#pt-numeral 3))
                  (#pt-app (#pt-use integer-power ()) second (#pt-numeral 3))))
              (#pt-app
                (#pt-use eisenstein-of-integer ())
                (#pt-app (#pt-use integer-power ()) third (#pt-numeral 3)))
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-use eisenstein-one ())
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-app (#pt-use eisenstein-of-integer ()) third)
                  (#pt-numeral 3)))
              (#pt-app
                (#pt-use eisenstein-of-integer-congruent ())
                (#pt-app
                  (#pt-use integer-add ())
                  (#pt-app (#pt-use integer-power ()) first (#pt-numeral 3))
                  (#pt-app (#pt-use integer-power ()) second (#pt-numeral 3)))
                (#pt-app (#pt-use integer-power ()) third (#pt-numeral 3))
                integer-equation)
              (#pt-app
                (#pt-use eisenstein-transitive ())
                (#pt-app
                  (#pt-use eisenstein-of-integer ())
                  (#pt-app (#pt-use integer-power ()) third (#pt-numeral 3)))
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-app (#pt-use eisenstein-of-integer ()) third)
                  (#pt-numeral 3))
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-use eisenstein-one ())
                  (#pt-app
                    (#pt-use eisenstein-power ())
                    (#pt-app (#pt-use eisenstein-of-integer ()) third)
                    (#pt-numeral 3)))
                (#pt-app (#pt-use eisenstein-of-integer-power ()) third (#pt-numeral 3))
                (#pt-app
                  (#pt-use eisenstein-symmetric ())
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-use eisenstein-one ())
                    (#pt-app
                      (#pt-use eisenstein-power ())
                      (#pt-app (#pt-use eisenstein-of-integer ()) third)
                      (#pt-numeral 3)))
                  (#pt-app
                    (#pt-use eisenstein-power ())
                    (#pt-app (#pt-use eisenstein-of-integer ()) third)
                    (#pt-numeral 3))
                  (#pt-app
                    (#pt-use eisenstein-one-multiply ())
                    (#pt-app
                      (#pt-use eisenstein-power ())
                      (#pt-app (#pt-use eisenstein-of-integer ()) third)
                      (#pt-numeral 3))))))))))))
(#theorem integer-fermat-three-residual-gcd-of-eisenstein
  (#universes)
  (#parameters
    (#parameter general-case (#pt-use eisenstein-fermat-three-general ()))
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter third-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use integer-equal ()) third (#pt-use integer-zero ())))) #pt-false))
    (#parameter first-nondivisible (#pt-pi ((denied-proof (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)) first))) #pt-false))
    (#parameter second-nondivisible (#pt-pi ((denied-proof (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)) second))) #pt-false))
    (#parameter third-divisible (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)) third))
    (#parameter pair-gcd-one (#pt-app (#pt-use integer-gcd-spec ()) first second (#pt-succ #pt-zero))))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app (#pt-use integer-power ()) first (#pt-numeral 3))
              (#pt-app (#pt-use integer-power ()) second (#pt-numeral 3)))
            (#pt-app (#pt-use integer-power ()) third (#pt-numeral 3)))))
      #pt-false))
  (#proof
    (#pt-app
      (#pt-use integer-fermat-three-residual-of-eisenstein ())
      general-case
      first
      second
      third
      third-nonzero
      first-nondivisible
      second-nondivisible
      third-divisible
      (#pt-app (#pt-use integer-coprime-of-gcd-one ()) first second pair-gcd-one))))
