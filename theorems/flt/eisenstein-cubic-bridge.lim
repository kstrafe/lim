  eisenstein-of-integer-congruent
  =
  ./eisenstein-equality.lim::eisenstein-of-integer-congruent)
(#alias eisenstein-of-integer-add = ./eisenstein-embedding.lim::eisenstein-of-integer-add)
(#alias eisenstein-of-integer-power = ./eisenstein-embedding.lim::eisenstein-of-integer-power)
(#alias eisenstein-embedded-nonzero = ./eisenstein-embedding.lim::eisenstein-embedded-nonzero)
