; Adapted mathematical source: pinned Mathlib RingTheory/Ideal/Operations.lean
; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean:268-376.
; Generated by scripts/generate-flt-point-ideal-addition.py; checked native terms.
; A checked common-ideal unit
; supplies sum-X*line in the actual scaled product. There
; is no cancellation of an arbitrary ideal or line element.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias
  point-ideal-addition-common-colon
  =
  ./point-ideal-addition-common-colon.lim::point-ideal-addition-common-colon)
(#alias
  point-ideal-addition-common-ideal
  =
  ./point-ideal-addition-product-generators.lim::point-ideal-addition-common-ideal)
(#alias
  point-ideal-addition-left-product
  =
  ./point-ideal-addition-product-generators.lim::point-ideal-addition-left-product)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-ideal-equal = ./ring-ideal-data.lim::ring-ideal-equal)
(#alias ring-ideal-member = ./ring-ideal-data.lim::ring-ideal-member)
(#alias ring-ideal-member-congruent = ./ring-ideal-data.lim::ring-ideal-member-congruent)
(#alias ring-ideal-top = ./ring-ideal-zero-unit.lim::ring-ideal-top)
(#alias ring-ideal-top-member = ./ring-ideal-zero-unit.lim::ring-ideal-top-member)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-negate = ./commutative-ring-data.lim::ring-negate)
(#alias ring-one = ./commutative-ring-data.lim::ring-one)
(#alias ring-one-multiply = ./commutative-ring-elementary-laws.lim::ring-one-multiply)
(#theorem point-ideal-addition-line-member
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-X Carrier)
    (#parameter second-X Carrier)
    (#parameter sum-X Carrier)
    (#parameter line Carrier)
    (#parameter opposite Carrier)
    (#parameter norm-equation (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring line opposite) (#pt-app (#pt-use ring-negate ()) Carrier coefficient-ring (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring sum-X (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-X second-X)))))
    (#parameter common-unit (#pt-app (#pt-use ring-ideal-equal ()) Carrier coefficient-ring (#pt-app (#pt-use point-ideal-addition-common-ideal ()) Carrier coefficient-ring first-X second-X sum-X line opposite) (#pt-app (#pt-use ring-ideal-top ()) Carrier coefficient-ring))))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-member ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use point-ideal-addition-left-product ())
        Carrier
        coefficient-ring
        first-X
        second-X
        sum-X
        line
        opposite)
      (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring sum-X line)))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-member-congruent ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use point-ideal-addition-left-product ())
        Carrier
        coefficient-ring
        first-X
        second-X
        sum-X
        line
        opposite)
      (#pt-app
        (#pt-use ring-multiply ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring sum-X line))
      (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring sum-X line)
      (#pt-app
        (#pt-use ring-one-multiply ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring sum-X line))
      (#pt-app
        (#pt-app
          (#pt-use point-ideal-addition-common-colon ())
          Carrier
          coefficient-ring
          first-X
          second-X
          sum-X
          line
          opposite
          norm-equation)
        (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
        (#pt-app
          (#pt-project conjunction 1 common-unit)
          (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
          (#pt-app
            (#pt-use ring-ideal-top-member ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)))))))
