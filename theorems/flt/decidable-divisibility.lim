; Constructive divisibility decision for every mathematical Nat pair.
; For a successor divisor, any witness k satisfies n = k + remaining,
; so the prefix search through n is exhaustive. Divisor zero is separate.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias exists = ./logic-exists.lim::exists)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias symmetry = ./equality.lim::symmetry)
(#alias substitution = ./equality.lim::substitution)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias decision = ./logical-decision.lim::decision)
(#alias decision-map = ./logical-decision.lim::decision-map)
(#alias decision-evidence = ./decidable-logic.lim::decision-evidence)
(#alias decide-equality = ./natural-decision.lim::decide-equality)
(#alias any-up-to = ./bounded-existence.lim::any-up-to)
(#alias any-up-to-with-gap = ./bounded-search.lim::any-up-to-with-gap)
(#alias any-up-to-has-witness = ./bounded-search.lim::any-up-to-has-witness)
(#alias decide-any-up-to = ./bounded-search.lim::decide-any-up-to)
(#theorem positive-divisor-bounded
  (#universes)
  (#parameters
    (#parameter predecessor #pt-nat)
    (#parameter multiple #pt-nat)
    (#parameter divisibility-proof (#pt-app (#pt-use divides ()) (#pt-succ predecessor) multiple)))
  (#statement
    (#pt-app
      (#pt-use any-up-to ())
      (#pt-lambda
        ((candidate-factor #pt-nat))
        (#pt-eq
          #pt-nat
          multiple
          (#pt-app (#pt-use multiply ()) (#pt-succ predecessor) candidate-factor)))
      multiple))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-factor #pt-nat))
          (#pt-eq
            #pt-nat
            multiple
            (#pt-app (#pt-use multiply ()) (#pt-succ predecessor) candidate-factor))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-factor #pt-nat))
                (#pt-eq
                  #pt-nat
                  multiple
                  (#pt-app (#pt-use multiply ()) (#pt-succ predecessor) candidate-factor))))))
        (#pt-app
          (#pt-use any-up-to ())
          (#pt-lambda
            ((candidate-factor #pt-nat))
            (#pt-eq
              #pt-nat
              multiple
              (#pt-app (#pt-use multiply ()) (#pt-succ predecessor) candidate-factor)))
          multiple))
      (
        (#pt-lambda
          (
            (factor #pt-nat)
            (factor-equation
              (#pt-eq
                #pt-nat
                multiple
                (#pt-app (#pt-use multiply ()) (#pt-succ predecessor) factor))))
          (#pt-app
            (#pt-use substitution (0))
            #pt-nat
            (#pt-lambda
              ((endpoint #pt-nat))
              (#pt-app
                (#pt-use any-up-to ())
                (#pt-lambda
                  ((candidate-factor #pt-nat))
                  (#pt-eq
                    #pt-nat
                    multiple
                    (#pt-app (#pt-use multiply ()) (#pt-succ predecessor) candidate-factor)))
                endpoint))
            (#pt-app (#pt-use add ()) factor (#pt-app (#pt-use multiply ()) predecessor factor))
            multiple
            (#pt-app
              (#pt-use symmetry (0))
              #pt-nat
              multiple
              (#pt-app (#pt-use add ()) factor (#pt-app (#pt-use multiply ()) predecessor factor))
              factor-equation)
            (#pt-app
              (#pt-use any-up-to-with-gap ())
              (#pt-lambda
                ((candidate-factor #pt-nat))
                (#pt-eq
                  #pt-nat
                  multiple
                  (#pt-app (#pt-use multiply ()) (#pt-succ predecessor) candidate-factor)))
              factor
              (#pt-app (#pt-use multiply ()) predecessor factor)
              factor-equation))))
      divisibility-proof)))
(#theorem zero-divisor-equation
  (#universes)
  (#parameters
    (#parameter multiple #pt-nat)
    (#parameter divisibility-proof (#pt-app (#pt-use divides ()) #pt-zero multiple)))
  (#statement (#pt-eq #pt-nat multiple #pt-zero))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-factor #pt-nat))
          (#pt-eq #pt-nat multiple (#pt-app (#pt-use multiply ()) #pt-zero candidate-factor))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-factor #pt-nat))
                (#pt-eq #pt-nat multiple (#pt-app (#pt-use multiply ()) #pt-zero candidate-factor))))))
        (#pt-eq #pt-nat multiple #pt-zero))
      (
        (#pt-lambda
          (
            (factor #pt-nat)
            (factor-equation
              (#pt-eq #pt-nat multiple (#pt-app (#pt-use multiply ()) #pt-zero factor))))
          factor-equation))
      divisibility-proof)))
(#theorem zero-divisor-witness
  (#universes)
  (#parameters
    (#parameter multiple #pt-nat)
    (#parameter zero-equation (#pt-eq #pt-nat multiple #pt-zero)))
  (#statement (#pt-app (#pt-use divides ()) #pt-zero multiple))
  (#proof
    (#pt-construct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-factor #pt-nat))
          (#pt-eq #pt-nat multiple (#pt-app (#pt-use multiply ()) #pt-zero candidate-factor))))
      introduce
      (#pt-zero zero-equation))))
(#math-definition decide-positive-divides ()
  (#pt-pi
    ((predecessor #pt-nat) (multiple #pt-nat))
    (#pt-app (#pt-use decision ()) (#pt-app (#pt-use divides ()) (#pt-succ predecessor) multiple)))
  (#pt-lambda
    ((predecessor #pt-nat) (multiple #pt-nat))
    (#pt-app
      (#pt-use decision-map ())
      (#pt-app
        (#pt-use any-up-to ())
        (#pt-lambda
          ((candidate-factor #pt-nat))
          (#pt-eq
            #pt-nat
            multiple
            (#pt-app (#pt-use multiply ()) (#pt-succ predecessor) candidate-factor)))
        multiple)
      (#pt-app (#pt-use divides ()) (#pt-succ predecessor) multiple)
      (#pt-lambda
        (
          (prefix-proof
            (#pt-app
              (#pt-use any-up-to ())
              (#pt-lambda
                ((candidate-factor #pt-nat))
                (#pt-eq
                  #pt-nat
                  multiple
                  (#pt-app (#pt-use multiply ()) (#pt-succ predecessor) candidate-factor)))
              multiple)))
        (#pt-app
          (#pt-use any-up-to-has-witness ())
          (#pt-lambda
            ((candidate-factor #pt-nat))
            (#pt-eq
              #pt-nat
              multiple
              (#pt-app (#pt-use multiply ()) (#pt-succ predecessor) candidate-factor)))
          multiple
          prefix-proof))
      (#pt-lambda
        ((divisibility-proof (#pt-app (#pt-use divides ()) (#pt-succ predecessor) multiple)))
        (#pt-app (#pt-use positive-divisor-bounded ()) predecessor multiple divisibility-proof))
      (#pt-app
        (#pt-use decide-any-up-to ())
        (#pt-lambda
          ((candidate-factor #pt-nat))
          (#pt-eq
            #pt-nat
            multiple
            (#pt-app (#pt-use multiply ()) (#pt-succ predecessor) candidate-factor)))
        (#pt-lambda
          ((candidate #pt-nat))
          (#pt-app
            (#pt-use decide-equality ())
            multiple
            (#pt-app (#pt-use multiply ()) (#pt-succ predecessor) candidate)))
        multiple))))
(#math-definition decide-divides ()
  (#pt-pi
    ((divisor #pt-nat) (multiple #pt-nat))
    (#pt-app (#pt-use decision ()) (#pt-app (#pt-use divides ()) divisor multiple)))
  (#pt-lambda
    ((divisor #pt-nat) (multiple #pt-nat))
    (#pt-nat-induct
      (#pt-lambda
        ((test-divisor #pt-nat))
        (#pt-app (#pt-use decision ()) (#pt-app (#pt-use divides ()) test-divisor multiple)))
      (#pt-app
        (#pt-use decision-map ())
        (#pt-eq #pt-nat multiple #pt-zero)
        (#pt-app (#pt-use divides ()) #pt-zero multiple)
        (#pt-lambda
          ((zero-equation (#pt-eq #pt-nat multiple #pt-zero)))
          (#pt-app (#pt-use zero-divisor-witness ()) multiple zero-equation))
        (#pt-lambda
          ((divisibility-proof (#pt-app (#pt-use divides ()) #pt-zero multiple)))
          (#pt-app (#pt-use zero-divisor-equation ()) multiple divisibility-proof))
        (#pt-app (#pt-use decide-equality ()) multiple #pt-zero))
      (#pt-lambda
        (
          (previous #pt-nat)
          (unused-decision
            (#pt-app (#pt-use decision ()) (#pt-app (#pt-use divides ()) previous multiple))))
        (#pt-app (#pt-use decide-positive-divides ()) previous multiple))
      divisor)))
(#theorem natural-divisibility-decided
  (#universes)
  (#parameters
    (#parameter divisor #pt-nat)
    (#parameter multiple #pt-nat))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app (#pt-use divides ()) divisor multiple)
      (#pt-pi ((denied-proof (#pt-app (#pt-use divides ()) divisor multiple))) #pt-false)))
  (#proof
    (#pt-app
      (#pt-use decision-evidence ())
      (#pt-app (#pt-use divides ()) divisor multiple)
      (#pt-app (#pt-use decide-divides ()) divisor multiple))))
