; Source repository: Copyright 2026 Anthropic, PBC; see NOTICE.FLT.
; Construct an actual integral curve from every retained Frey package,
; with exact quotient and rational-map witnesses. Its discriminant
; multiplication identity and nonvanishing use the actual package
; equation and three nonzero coordinates, not assumed curve properties.
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias power = ./../fermat_statement.lim::power)
(#alias exists = ./logic-exists.lim::exists)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-zero = ./integer-defs.lim::integer-zero)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-power = ./integer-defs.lim::integer-power)
(#alias integer-weierstrass-curve = ./integer-weierstrass-defs.lim::integer-weierstrass-curve)
(#alias
  integer-weierstrass-discriminant
  =
  ./integer-weierstrass-defs.lim::integer-weierstrass-discriminant)
(#alias integer-frey-model-certificate = ./integer-frey-model.lim::integer-frey-model-certificate)
(#alias integer-frey-model-exists = ./integer-frey-model.lim::integer-frey-model-exists)
(#alias
  integer-frey-discriminant-multiplied
  =
  ./integer-frey-invariants.lim::integer-frey-discriminant-multiplied)
(#alias
  integer-frey-discriminant-nonzero
  =
  ./integer-frey-invariants.lim::integer-frey-discriminant-nonzero)
(#alias frey-package-certificate = ./frey-package.lim::frey-package-certificate)
(#alias
  frey-package-coefficients-divisible
  =
  ./frey-package-coefficients.lim::frey-package-coefficients-divisible)
(#theorem frey-package-has-integral-model
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter package (#pt-app (#pt-use frey-package-certificate ()) exponent first second third)))
  (#statement
    (#pt-app
      (#pt-use exists (0))
      (#pt-use integer-weierstrass-curve ())
      (#pt-lambda
        ((candidate-model (#pt-use integer-weierstrass-curve ())))
        (#pt-app (#pt-use integer-frey-model-certificate ()) first second exponent candidate-model))))
  (#proof
    (#pt-app
      (#pt-use integer-frey-model-exists ())
      first
      second
      exponent
      (#pt-project
        conjunction
        0
        (#pt-app
          (#pt-use frey-package-coefficients-divisible ())
          first
          second
          third
          exponent
          package))
      (#pt-project
        conjunction
        1
        (#pt-app
          (#pt-use frey-package-coefficients-divisible ())
          first
          second
          third
          exponent
          package)))))
(#theorem frey-package-integral-discriminant
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter package (#pt-app (#pt-use frey-package-certificate ()) exponent first second third))
    (#parameter integral-model (#pt-use integer-weierstrass-curve ()))
    (#parameter model-certificate (#pt-app (#pt-use integer-frey-model-certificate ()) first second exponent integral-model)))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)
        (#pt-app
          (#pt-use integer-of-natural ())
          (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-numeral 8))))
      (#pt-app
        (#pt-use integer-power ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app (#pt-use integer-multiply ()) first second)
          third)
        (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent))))
  (#proof
    (#pt-app
      (#pt-use integer-frey-discriminant-multiplied ())
      first
      second
      third
      exponent
      integral-model
      model-certificate
      (#pt-project
        conjunction
        1
        (#pt-project
          conjunction
          1
          (#pt-project
            conjunction
            1
            (#pt-project
              conjunction
              1
              (#pt-project
                conjunction
                1
                (#pt-project
                  conjunction
                  0
                  (#pt-project conjunction 1 (#pt-project conjunction 1 package)))))))))))
(#theorem frey-package-integral-discriminant-nonzero
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter package (#pt-app (#pt-use frey-package-certificate ()) exponent first second third))
    (#parameter integral-model (#pt-use integer-weierstrass-curve ()))
    (#parameter model-certificate (#pt-app (#pt-use integer-frey-model-certificate ()) first second exponent integral-model)))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)
            (#pt-use integer-zero ()))))
      #pt-false))
  (#proof
    (#pt-app
      (#pt-use integer-frey-discriminant-nonzero ())
      first
      second
      third
      exponent
      integral-model
      model-certificate
      (#pt-project
        conjunction
        1
        (#pt-project
          conjunction
          1
          (#pt-project
            conjunction
            1
            (#pt-project
              conjunction
              1
              (#pt-project
                conjunction
                1
                (#pt-project
                  conjunction
                  0
                  (#pt-project conjunction 1 (#pt-project conjunction 1 package))))))))
      (#pt-project
        conjunction
        0
        (#pt-project conjunction 0 (#pt-project conjunction 1 (#pt-project conjunction 1 package))))
      (#pt-project
        conjunction
        0
        (#pt-project
          conjunction
          1
          (#pt-project
            conjunction
            0
            (#pt-project conjunction 1 (#pt-project conjunction 1 package)))))
      (#pt-project
        conjunction
        0
        (#pt-project
          conjunction
          1
          (#pt-project
            conjunction
            1
            (#pt-project
              conjunction
              0
              (#pt-project conjunction 1 (#pt-project conjunction 1 package)))))))))
