(#math-definition frey-rational-model ()
  (#pt-pi
    ((first-power (#pt-use integer ())) (second-power (#pt-use integer ())))
    (#pt-use rational-weierstrass-curve ()))
  (#pt-lambda
    ((first-power (#pt-use integer ())) (second-power (#pt-use integer ())))
    (#pt-construct
      rational-weierstrass-curve
      ()
      ()
      coefficients
      (
        (#pt-use rational-one ())
        (#pt-construct
          rational
          ()
          ()
          fraction
          (
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-add ())
                second-power
                (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ())))
              (#pt-app (#pt-use integer-negate ()) first-power))
            (#pt-numeral 4)
            (#pt-app (#pt-use successor-not-zero ()) (#pt-numeral 3))))
        (#pt-use rational-zero ())
        (#pt-construct
          rational
          ()
          ()
          fraction
          (
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-negate ()) first-power)
              second-power)
            (#pt-numeral 16)
            (#pt-app (#pt-use successor-not-zero ()) (#pt-numeral 15))))
        (#pt-use rational-zero ())))))
(#math-definition frey-rational-curve ()
  (#pt-pi
    ((first (#pt-use integer ())) (second (#pt-use integer ())) (exponent #pt-nat))
    (#pt-use rational-weierstrass-curve ()))
  (#pt-lambda
    ((first (#pt-use integer ())) (second (#pt-use integer ())) (exponent #pt-nat))
    (#pt-app
      (#pt-use frey-rational-model ())
      (#pt-app (#pt-use integer-power ()) first exponent)
      (#pt-app (#pt-use integer-power ()) second exponent))))
