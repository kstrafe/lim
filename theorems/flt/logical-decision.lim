; Proof-carrying decisions, matching the constructive Decidable pattern.
; This defines no oracle: a value must contain a proof or a refutation.
(#math-inductive decision ()
  ((proposition #pt-prop))
  (#pt-type 0)
  ((no ((refutation (#pt-pi ((evidence proposition)) #pt-false)))) (yes ((evidence proposition)))))
(#math-definition decision-map ()
  (#pt-pi
    (
      (proposition #pt-prop)
      (conclusion #pt-prop)
      (forward (#pt-pi ((evidence proposition)) conclusion))
      (reverse (#pt-pi ((evidence conclusion)) proposition))
      (value (#pt-app (#pt-use decision ()) proposition)))
    (#pt-app (#pt-use decision ()) conclusion))
  (#pt-lambda
    (
      (proposition #pt-prop)
      (conclusion #pt-prop)
      (forward (#pt-pi ((evidence proposition)) conclusion))
      (reverse (#pt-pi ((evidence conclusion)) proposition))
      (value (#pt-app (#pt-use decision ()) proposition)))
    (#pt-induct
      decision
      ()
      (proposition)
      (#pt-lambda
        ((decision-value (#pt-app (#pt-use decision ()) proposition)))
        (#pt-app (#pt-use decision ()) conclusion))
      (
        (#pt-lambda
          ((refutation (#pt-pi ((evidence proposition)) #pt-false)))
          (#pt-construct
            decision
            ()
            (conclusion)
            no
            (
              (#pt-lambda
                ((conclusion-proof conclusion))
                (#pt-app refutation (#pt-app reverse conclusion-proof))))))
        (#pt-lambda
          ((proposition-proof proposition))
          (#pt-construct decision () (conclusion) yes ((#pt-app forward proposition-proof)))))
      value)))
