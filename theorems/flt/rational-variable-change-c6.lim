(#alias rational-variable-change = ./rational-variable-change-defs.lim::rational-variable-change)
(#alias
  rational-variable-change-act
  =
  ./rational-variable-change-defs.lim::rational-variable-change-act)
(#alias rational-variable-change-b2 = ./rational-variable-change.lim::rational-variable-change-b2)
(#alias
  rational-variable-change-b4
  =
  ./rational-variable-change-invariants.lim::rational-variable-change-b4)
(#alias
  rational-variable-change-b6
  =
