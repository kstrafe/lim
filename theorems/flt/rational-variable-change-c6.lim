(#alias rational-c6-scaling-polynomial = ./rational-c6-scaling.lim::rational-c6-scaling-polynomial)
(#math-definition rational-c6-value ()
  (#pt-pi
    ((b2 (#pt-use rational ())) (b4 (#pt-use rational ())) (b6 (#pt-use rational ())))
    (#pt-use rational ()))
  (#pt-lambda
    ((b2 (#pt-use rational ())) (b4 (#pt-use rational ())) (b6 (#pt-use rational ())))
    (#pt-app
      (#pt-use rational-add ())
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app
          (#pt-use rational-negate ())
          (#pt-app (#pt-use rational-power ()) b2 (#pt-numeral 3)))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 36)))
            b2)
          b4))
      (#pt-app
        (#pt-use rational-negate ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 1))
                (#pt-numeral 88))))
          b6)))))
(#theorem rational-c6-value-congruent
  (#universes)
  (#parameters
    (#parameter b2 (#pt-use rational ()))
    (#parameter b4 (#pt-use rational ()))
    (#parameter b6 (#pt-use rational ()))
    (#parameter other-b2 (#pt-use rational ()))
    (#parameter other-b4 (#pt-use rational ()))
    (#parameter other-b6 (#pt-use rational ()))
    (#parameter b2-equivalence (#pt-app (#pt-use rational-equal ()) b2 other-b2))
    (#parameter b4-equivalence (#pt-app (#pt-use rational-equal ()) b4 other-b4))
    (#parameter b6-equivalence (#pt-app (#pt-use rational-equal ()) b6 other-b6)))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-negate ())
            (#pt-app (#pt-use rational-power ()) b2 (#pt-numeral 3)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 36)))
              b2)
            b4))
        (#pt-app
          (#pt-use rational-negate ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app
                (#pt-use integer-of-natural ())
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 1))
                  (#pt-numeral 88))))
            b6)))
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-negate ())
            (#pt-app (#pt-use rational-power ()) other-b2 (#pt-numeral 3)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 36)))
              other-b2)
            other-b4))
        (#pt-app
          (#pt-use rational-negate ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app
                (#pt-use integer-of-natural ())
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 1))
                  (#pt-numeral 88))))
            other-b6)))))
  (#proof
    (#pt-app
      (#pt-use rational-add-congruent ())
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app
          (#pt-use rational-negate ())
          (#pt-app (#pt-use rational-power ()) b2 (#pt-numeral 3)))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 36)))
            b2)
          b4))
      (#pt-app
        (#pt-use rational-negate ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 1))
                (#pt-numeral 88))))
          b6))
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app
          (#pt-use rational-negate ())
          (#pt-app (#pt-use rational-power ()) other-b2 (#pt-numeral 3)))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 36)))
            other-b2)
          other-b4))
      (#pt-app
        (#pt-use rational-negate ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 1))
                (#pt-numeral 88))))
          other-b6))
      (#pt-app
        (#pt-use rational-add-congruent ())
        (#pt-app
          (#pt-use rational-negate ())
          (#pt-app (#pt-use rational-power ()) b2 (#pt-numeral 3)))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 36)))
            b2)
          b4)
        (#pt-app
          (#pt-use rational-negate ())
          (#pt-app (#pt-use rational-power ()) other-b2 (#pt-numeral 3)))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 36)))
            other-b2)
          other-b4)
        (#pt-app
          (#pt-use rational-negate-congruent ())
          (#pt-app (#pt-use rational-power ()) b2 (#pt-numeral 3))
          (#pt-app (#pt-use rational-power ()) other-b2 (#pt-numeral 3))
          (#pt-app (#pt-use rational-power-congruent ()) b2 other-b2 (#pt-numeral 3) b2-equivalence))
        (#pt-app
          (#pt-use rational-multiply-congruent ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 36)))
            b2)
          b4
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 36)))
            other-b2)
          other-b4
          (#pt-app
            (#pt-use rational-multiply-congruent ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 36)))
            b2
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 36)))
            other-b2
            (#pt-app
              (#pt-use rational-reflexive ())
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 36))))
            b2-equivalence)
          b4-equivalence))
      (#pt-app
        (#pt-use rational-negate-congruent ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 1))
                (#pt-numeral 88))))
          b6)
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 1))
                (#pt-numeral 88))))
          other-b6)
        (#pt-app
          (#pt-use rational-multiply-congruent ())
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 1))
                (#pt-numeral 88))))
          b6
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 1))
                (#pt-numeral 88))))
          other-b6
          (#pt-app
            (#pt-use rational-reflexive ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app
                (#pt-use integer-of-natural ())
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 1))
                  (#pt-numeral 88)))))
          b6-equivalence)))))
(#theorem rational-variable-change-c6
  (#universes)
  (#parameters
    (#parameter change (#pt-use rational-variable-change ()))
    (#parameter curve (#pt-use rational-weierstrass-curve ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-weierstrass-c6 ())
        (#pt-app (#pt-use rational-variable-change-act ()) change curve))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project rational-variable-change 1 change)
          (#pt-numeral 6))
        (#pt-app (#pt-use rational-weierstrass-c6 ()) curve))))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app
        (#pt-use rational-weierstrass-c6 ())
        (#pt-app (#pt-use rational-variable-change-act ()) change curve))
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-negate ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-power ())
                  (#pt-project rational-variable-change 1 change)
                  (#pt-numeral 2))
                (#pt-app
                  (#pt-use rational-add ())
                  (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)
                  (#pt-app
                    (#pt-use rational-multiply ())
                    (#pt-app
                      (#pt-use rational-of-integer ())
                      (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 12)))
                    (#pt-project rational-variable-change 2 change))))
              (#pt-numeral 3)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 36)))
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-power ())
                  (#pt-project rational-variable-change 1 change)
                  (#pt-numeral 2))
                (#pt-app
                  (#pt-use rational-add ())
                  (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)
                  (#pt-app
                    (#pt-use rational-multiply ())
                    (#pt-app
                      (#pt-use rational-of-integer ())
                      (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 12)))
                    (#pt-project rational-variable-change 2 change)))))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-project rational-variable-change 1 change)
                (#pt-numeral 4))
              (#pt-app
                (#pt-use rational-add ())
                (#pt-app
                  (#pt-use rational-add ())
                  (#pt-app (#pt-use rational-weierstrass-b4 ()) curve)
                  (#pt-app
                    (#pt-use rational-multiply ())
                    (#pt-project rational-variable-change 2 change)
                    (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)))
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app
                    (#pt-use rational-of-integer ())
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 6)))
                  (#pt-app
                    (#pt-use rational-power ())
                    (#pt-project rational-variable-change 2 change)
                    (#pt-numeral 2)))))))
        (#pt-app
          (#pt-use rational-negate ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app
                (#pt-use integer-of-natural ())
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 1))
                  (#pt-numeral 88))))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-project rational-variable-change 1 change)
                (#pt-numeral 6))
              (#pt-app
                (#pt-use rational-add ())
                (#pt-app
                  (#pt-use rational-add ())
                  (#pt-app
                    (#pt-use rational-add ())
                    (#pt-app (#pt-use rational-weierstrass-b6 ()) curve)
                    (#pt-app
                      (#pt-use rational-multiply ())
                      (#pt-app
                        (#pt-use rational-multiply ())
                        (#pt-app
                          (#pt-use rational-of-integer ())
                          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
                        (#pt-project rational-variable-change 2 change))
                      (#pt-app (#pt-use rational-weierstrass-b4 ()) curve)))
                  (#pt-app
                    (#pt-use rational-multiply ())
                    (#pt-app
                      (#pt-use rational-power ())
                      (#pt-project rational-variable-change 2 change)
                      (#pt-numeral 2))
                    (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)))
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app
                    (#pt-use rational-of-integer ())
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
                  (#pt-app
                    (#pt-use rational-power ())
                    (#pt-project rational-variable-change 2 change)
                    (#pt-numeral 3))))))))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project rational-variable-change 1 change)
          (#pt-numeral 6))
        (#pt-app (#pt-use rational-weierstrass-c6 ()) curve))
      (#pt-app
        (#pt-use rational-c6-value-congruent ())
        (#pt-app
          (#pt-use rational-weierstrass-b2 ())
          (#pt-app (#pt-use rational-variable-change-act ()) change curve))
        (#pt-app
          (#pt-use rational-weierstrass-b4 ())
          (#pt-app (#pt-use rational-variable-change-act ()) change curve))
        (#pt-app
          (#pt-use rational-weierstrass-b6 ())
          (#pt-app (#pt-use rational-variable-change-act ()) change curve))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-project rational-variable-change 1 change)
            (#pt-numeral 2))
          (#pt-app
            (#pt-use rational-add ())
            (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 12)))
              (#pt-project rational-variable-change 2 change))))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-project rational-variable-change 1 change)
            (#pt-numeral 4))
          (#pt-app
            (#pt-use rational-add ())
            (#pt-app
              (#pt-use rational-add ())
              (#pt-app (#pt-use rational-weierstrass-b4 ()) curve)
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-project rational-variable-change 2 change)
                (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 6)))
              (#pt-app
                (#pt-use rational-power ())
                (#pt-project rational-variable-change 2 change)
                (#pt-numeral 2)))))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-project rational-variable-change 1 change)
            (#pt-numeral 6))
          (#pt-app
            (#pt-use rational-add ())
            (#pt-app
              (#pt-use rational-add ())
              (#pt-app
                (#pt-use rational-add ())
                (#pt-app (#pt-use rational-weierstrass-b6 ()) curve)
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app
                    (#pt-use rational-multiply ())
                    (#pt-app
                      (#pt-use rational-of-integer ())
                      (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
                    (#pt-project rational-variable-change 2 change))
                  (#pt-app (#pt-use rational-weierstrass-b4 ()) curve)))
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-power ())
                  (#pt-project rational-variable-change 2 change)
                  (#pt-numeral 2))
                (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
              (#pt-app
                (#pt-use rational-power ())
                (#pt-project rational-variable-change 2 change)
                (#pt-numeral 3)))))
        (#pt-app (#pt-use rational-variable-change-b2 ()) change curve)
        (#pt-app (#pt-use rational-variable-change-b4 ()) change curve)
        (#pt-app (#pt-use rational-variable-change-b6 ()) change curve))
      (#pt-app
        (#pt-use rational-transitive ())
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-add ())
            (#pt-app
              (#pt-use rational-negate ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app
                    (#pt-use rational-power ())
                    (#pt-project rational-variable-change 1 change)
                    (#pt-numeral 2))
                  (#pt-app
                    (#pt-use rational-add ())
                    (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)
                    (#pt-app
                      (#pt-use rational-multiply ())
                      (#pt-app
                        (#pt-use rational-of-integer ())
                        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 12)))
                      (#pt-project rational-variable-change 2 change))))
                (#pt-numeral 3)))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-of-integer ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 36)))
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app
                    (#pt-use rational-power ())
                    (#pt-project rational-variable-change 1 change)
                    (#pt-numeral 2))
                  (#pt-app
                    (#pt-use rational-add ())
                    (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)
                    (#pt-app
                      (#pt-use rational-multiply ())
                      (#pt-app
                        (#pt-use rational-of-integer ())
                        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 12)))
                      (#pt-project rational-variable-change 2 change)))))
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-power ())
                  (#pt-project rational-variable-change 1 change)
                  (#pt-numeral 4))
                (#pt-app
                  (#pt-use rational-add ())
                  (#pt-app
                    (#pt-use rational-add ())
                    (#pt-app (#pt-use rational-weierstrass-b4 ()) curve)
                    (#pt-app
                      (#pt-use rational-multiply ())
                      (#pt-project rational-variable-change 2 change)
                      (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)))
                  (#pt-app
