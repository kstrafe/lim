; Every signed formal-difference integer is0,1or-1modulo three.
; Increment rotates the three witnessed divisibility cases. Natural
; induction and the proved signed normal forms cover every integer.
; No quotient, classical choice, finite cutoff or residue oracle is used.
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-one = ./integer-defs.lim::integer-one)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-negative-natural = ./integer-defs.lim::integer-negative-natural)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-divides = ./integer-defs.lim::integer-divides)
(#alias integer-reflexive = ./integer-equality.lim::integer-reflexive)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias integer-add-congruent = ./integer-equality.lim::integer-add-congruent)
(#alias integer-add-commutative = ./integer-addition.lim::integer-add-commutative)
(#alias integer-negate-add = ./integer-addition.lim::integer-negate-add)
(#alias integer-negate-involution = ./integer-addition.lim::integer-negate-involution)
(#alias integer-divides-zero = ./integer-divisibility.lim::integer-divides-zero)
(#alias integer-divides-reflexive = ./integer-divisibility.lim::integer-divides-reflexive)
(#alias
  integer-divides-congruent-target
  =
  ./integer-divisibility.lim::integer-divides-congruent-target)
(#alias
  integer-divides-negative-target
  =
  ./integer-divisibility.lim::integer-divides-negative-target)
(#alias integer-divides-add = ./integer-divisibility-addition.lim::integer-divides-add)
(#alias
  integer-add-negative-cancel
  =
  ./integer-divisibility-addition.lim::integer-add-negative-cancel)
(#alias integer-add-of-natural = ./integer-multiplication.lim::integer-add-of-natural)
(#alias integer-normal-form = ./integer-normal-form.lim::integer-normal-form)
(#alias
  eisenstein-cube-scalar-integer-shift-cycle
  =
  ./eisenstein-cube-scalar-integer-shift-cycle.lim::eisenstein-cube-scalar-integer-shift-cycle)
(#alias exists = ./logic-exists.lim::exists)
(#alias add-successor-right = ./natural-addition.lim::add-successor-right)
(#alias add-zero-right = ./natural-addition.lim::add-zero-right)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias congruence = ./equality.lim::congruence)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-left = ./logical-connectives.lim::disjunction-left)
(#alias disjunction-right = ./logical-connectives.lim::disjunction-right)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias add = ../fermat_statement.lim::add)
(#theorem integer-add-subtract-right
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use integer-add ()) first second)
        (#pt-app (#pt-use integer-negate ()) second))
      first))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use integer-add ()) first second)
        (#pt-app (#pt-use integer-negate ()) second))
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use integer-negate ()) second)
        (#pt-app (#pt-use integer-add ()) first second))
      first
      (#pt-app
        (#pt-use integer-add-commutative ())
        (#pt-app (#pt-use integer-add ()) first second)
        (#pt-app (#pt-use integer-negate ()) second))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app (#pt-use integer-negate ()) second)
          (#pt-app (#pt-use integer-add ()) first second))
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app (#pt-use integer-negate ()) second)
          (#pt-app (#pt-use integer-add ()) second first))
        first
        (#pt-app
          (#pt-use integer-add-congruent ())
          (#pt-app (#pt-use integer-negate ()) second)
          (#pt-app (#pt-use integer-add ()) first second)
          (#pt-app (#pt-use integer-negate ()) second)
          (#pt-app (#pt-use integer-add ()) second first)
          (#pt-app (#pt-use integer-reflexive ()) (#pt-app (#pt-use integer-negate ()) second))
          (#pt-app (#pt-use integer-add-commutative ()) first second))
        (#pt-app (#pt-use integer-add-negative-cancel ()) second first)))))
(#theorem integer-natural-successor
  (#universes)
  (#parameters
    (#parameter number #pt-nat))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-of-natural ()) (#pt-succ number))
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use integer-of-natural ()) number)
        (#pt-use integer-one ()))))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app (#pt-use integer-of-natural ()) (#pt-succ number))
      (#pt-app
        (#pt-use integer-of-natural ())
        (#pt-app (#pt-use add ()) number (#pt-succ #pt-zero)))
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use integer-of-natural ()) number)
        (#pt-use integer-one ()))
      (#pt-app
        (#pt-use congruence (0 0))
        #pt-nat
        #pt-nat
        (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use add ()) endpoint #pt-zero))
        (#pt-succ number)
        (#pt-app (#pt-use add ()) number (#pt-succ #pt-zero))
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          (#pt-app (#pt-use add ()) number (#pt-succ #pt-zero))
          (#pt-succ number)
          (#pt-app
            (#pt-use transitivity (0))
            #pt-nat
            (#pt-app (#pt-use add ()) number (#pt-succ #pt-zero))
            (#pt-succ (#pt-app (#pt-use add ()) number #pt-zero))
            (#pt-succ number)
            (#pt-app (#pt-use add-successor-right ()) number #pt-zero)
            (#pt-app
              (#pt-use congruence (0 0))
              #pt-nat
              #pt-nat
              (#pt-lambda ((endpoint #pt-nat)) (#pt-succ endpoint))
              (#pt-app (#pt-use add ()) number #pt-zero)
              number
              (#pt-app (#pt-use add-zero-right ()) number)))))
      (#pt-app
        (#pt-use integer-symmetric ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app (#pt-use integer-of-natural ()) number)
          (#pt-use integer-one ()))
        (#pt-app
          (#pt-use integer-of-natural ())
          (#pt-app (#pt-use add ()) number (#pt-succ #pt-zero)))
        (#pt-app (#pt-use integer-add-of-natural ()) number (#pt-succ #pt-zero))))))
(#math-definition integer-has-three-residue ()
  (#pt-pi ((value (#pt-use integer ()))) #pt-prop)
  (#pt-lambda
    ((value (#pt-use integer ())))
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app
        (#pt-use integer-divides ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
        value)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
          (#pt-app
            (#pt-use integer-add ())
            value
            (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
          (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ())))))))
(#theorem integer-three-residue-congruent
  (#universes)
  (#parameters
    (#parameter value (#pt-use integer ()))
    (#parameter other (#pt-use integer ()))
    (#parameter equivalent (#pt-app (#pt-use integer-equal ()) value other))
    (#parameter residue-proof (#pt-app (#pt-use integer-has-three-residue ()) value)))
  (#statement (#pt-app (#pt-use integer-has-three-residue ()) other))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app
        (#pt-use integer-divides ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
        value)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
          (#pt-app
            (#pt-use integer-add ())
            value
            (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
          (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ()))))
      (#pt-app (#pt-use integer-has-three-residue ()) other)
      (#pt-lambda
        (
          (residue-zero
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
              value)))
        (#pt-app
          (#pt-use disjunction-left ())
          (#pt-app
            (#pt-use integer-divides ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
            other)
          (#pt-app
            (#pt-use disjunction ())
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
              (#pt-app
                (#pt-use integer-add ())
                other
                (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
              (#pt-app (#pt-use integer-add ()) other (#pt-use integer-one ()))))
          (#pt-app
            (#pt-use integer-divides-congruent-target ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
            value
            other
            equivalent
            residue-zero)))
      (#pt-lambda
        (
          (residue-one-or-negative-one
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app
                (#pt-use integer-divides ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                (#pt-app
                  (#pt-use integer-add ())
                  value
                  (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
              (#pt-app
                (#pt-use integer-divides ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ()))))))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-app
            (#pt-use integer-divides ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
            (#pt-app
              (#pt-use integer-add ())
              value
              (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
          (#pt-app
            (#pt-use integer-divides ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
            (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ())))
          (#pt-app (#pt-use integer-has-three-residue ()) other)
          (#pt-lambda
            (
              (residue-one
                (#pt-app
                  (#pt-use integer-divides ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app
                    (#pt-use integer-add ())
                    value
                    (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))))
            (#pt-app
              (#pt-use disjunction-right ())
              (#pt-app
                (#pt-use integer-divides ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                other)
              (#pt-app
                (#pt-use disjunction ())
                (#pt-app
                  (#pt-use integer-divides ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app
                    (#pt-use integer-add ())
                    other
                    (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
                (#pt-app
                  (#pt-use integer-divides ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app (#pt-use integer-add ()) other (#pt-use integer-one ()))))
              (#pt-app
                (#pt-use disjunction-left ())
                (#pt-app
                  (#pt-use integer-divides ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app
                    (#pt-use integer-add ())
                    other
                    (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
                (#pt-app
                  (#pt-use integer-divides ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app (#pt-use integer-add ()) other (#pt-use integer-one ())))
                (#pt-app
                  (#pt-use integer-divides-congruent-target ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app
                    (#pt-use integer-add ())
                    value
                    (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ())))
                  (#pt-app
                    (#pt-use integer-add ())
                    other
                    (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ())))
                  (#pt-app
                    (#pt-use integer-add-congruent ())
                    value
                    (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))
                    other
                    (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))
                    equivalent
                    (#pt-app
                      (#pt-use integer-reflexive ())
                      (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
                  residue-one))))
          (#pt-lambda
            (
              (residue-negative-one
                (#pt-app
                  (#pt-use integer-divides ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ())))))
            (#pt-app
              (#pt-use disjunction-right ())
              (#pt-app
                (#pt-use integer-divides ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                other)
              (#pt-app
                (#pt-use disjunction ())
                (#pt-app
                  (#pt-use integer-divides ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app
                    (#pt-use integer-add ())
                    other
                    (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
                (#pt-app
                  (#pt-use integer-divides ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app (#pt-use integer-add ()) other (#pt-use integer-one ()))))
              (#pt-app
                (#pt-use disjunction-right ())
                (#pt-app
                  (#pt-use integer-divides ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app
                    (#pt-use integer-add ())
                    other
                    (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
                (#pt-app
                  (#pt-use integer-divides ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app (#pt-use integer-add ()) other (#pt-use integer-one ())))
                (#pt-app
                  (#pt-use integer-divides-congruent-target ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ()))
                  (#pt-app (#pt-use integer-add ()) other (#pt-use integer-one ()))
                  (#pt-app
                    (#pt-use integer-add-congruent ())
                    value
                    (#pt-use integer-one ())
                    other
                    (#pt-use integer-one ())
                    equivalent
                    (#pt-app (#pt-use integer-reflexive ()) (#pt-use integer-one ())))
                  residue-negative-one))))
          residue-one-or-negative-one))
      residue-proof)))
(#theorem integer-three-residue-increment
  (#universes)
  (#parameters
    (#parameter value (#pt-use integer ()))
    (#parameter residue-proof (#pt-app (#pt-use integer-has-three-residue ()) value)))
  (#statement
    (#pt-app
      (#pt-use integer-has-three-residue ())
      (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ()))))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app
        (#pt-use integer-divides ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
        value)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
          (#pt-app
            (#pt-use integer-add ())
            value
            (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
          (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ()))))
      (#pt-app
        (#pt-use integer-has-three-residue ())
        (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ())))
      (#pt-lambda
        (
          (residue-zero
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
              value)))
        (#pt-app
          (#pt-use disjunction-right ())
          (#pt-app
            (#pt-use integer-divides ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
            (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ())))
          (#pt-app
            (#pt-use disjunction ())
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ()))
                (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ()))
                (#pt-use integer-one ()))))
          (#pt-app
            (#pt-use disjunction-left ())
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ()))
                (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ()))
                (#pt-use integer-one ())))
            (#pt-app
              (#pt-use integer-divides-congruent-target ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
              value
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ()))
                (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ())))
              (#pt-app
                (#pt-use integer-symmetric ())
                (#pt-app
                  (#pt-use integer-add ())
                  (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ()))
                  (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ())))
                value
                (#pt-app (#pt-use integer-add-subtract-right ()) value (#pt-use integer-one ())))
              residue-zero))))
      (#pt-lambda
        (
          (residue-one-or-negative-one
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app
                (#pt-use integer-divides ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                (#pt-app
                  (#pt-use integer-add ())
                  value
                  (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
              (#pt-app
                (#pt-use integer-divides ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ()))))))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-app
            (#pt-use integer-divides ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
            (#pt-app
              (#pt-use integer-add ())
              value
              (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
          (#pt-app
            (#pt-use integer-divides ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
            (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ())))
          (#pt-app
            (#pt-use integer-has-three-residue ())
            (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ())))
          (#pt-lambda
            (
              (residue-one
