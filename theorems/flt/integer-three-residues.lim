                (#pt-use integer-divides ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ())))
              (#pt-app
                (#pt-use disjunction ())
                (#pt-app
                  (#pt-use integer-divides ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app
                    (#pt-use integer-add ())
                    (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ()))
                    (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
                (#pt-app
                  (#pt-use integer-divides ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app
                    (#pt-use integer-add ())
                    (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ()))
                    (#pt-use integer-one ()))))
              (#pt-app
                (#pt-use disjunction-right ())
                (#pt-app
                  (#pt-use integer-divides ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app
                    (#pt-use integer-add ())
                    (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ()))
                    (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
                (#pt-app
                  (#pt-use integer-divides ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app
                    (#pt-use integer-add ())
                    (#pt-app (#pt-use integer-add ()) value (#pt-use integer-one ()))
                    (#pt-use integer-one ())))
                (#pt-app
                  (#pt-use integer-divides-congruent-target ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app
                    (#pt-use integer-add ())
                    (#pt-app
                      (#pt-use integer-add ())
                      value
                      (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ())))
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)))
                  (#pt-app
