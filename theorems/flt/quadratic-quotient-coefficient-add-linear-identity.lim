(#theorem quadratic-quotient-coefficient-add-linear-identity
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
      (#pt-app
        (#pt-use ring-add ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
  (#proof
    (#pt-app
      (#pt-use ring-symmetric ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-add ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
      (#pt-app
        (#pt-use ring-zero-add ())
