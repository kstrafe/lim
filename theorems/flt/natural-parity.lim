; Constructive parity and oddness of a prime different from two.
; Odd is witnessed as a successor of a double, equivalent to the Nat Odd form.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias divides-zero = ./natural-divisibility.lim::divides-zero)
(#alias
  multiply-successor-right
  =
  ./natural-multiplication-commutative.lim::multiply-successor-right)
(#alias prime = ./natural-prime.lim::prime)
(#alias prime-larger-than-one = ./natural-prime.lim::prime-larger-than-one)
(#alias prime-excludes-proper-divisor = ./natural-prime.lim::prime-excludes-proper-divisor)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-left = ./logical-connectives.lim::disjunction-left)
(#alias disjunction-right = ./logical-connectives.lim::disjunction-right)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias congruence = ./equality.lim::congruence)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#math-definition odd ()
  (#pt-pi ((number #pt-nat)) #pt-prop)
  (#pt-lambda
    ((number #pt-nat))
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-half #pt-nat))
        (#pt-eq
          #pt-nat
          number
          (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) candidate-half)))))))
(#theorem even-or-odd
  (#universes)
  (#parameters
    (#parameter number #pt-nat))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) number)
      (#pt-app (#pt-use odd ()) number)))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((index #pt-nat))
        (#pt-app
          (#pt-use disjunction ())
          (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) index)
          (#pt-app (#pt-use odd ()) index)))
      (#pt-app
        (#pt-use disjunction-left ())
        (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) #pt-zero)
        (#pt-app (#pt-use odd ()) #pt-zero)
        (#pt-app (#pt-use divides-zero ()) (#pt-succ (#pt-succ #pt-zero))))
      (#pt-lambda
        (
          (previous #pt-nat)
          (previous-parity
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) previous)
              (#pt-app (#pt-use odd ()) previous))))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) previous)
          (#pt-app (#pt-use odd ()) previous)
          (#pt-app
            (#pt-use disjunction ())
            (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-succ previous))
            (#pt-app (#pt-use odd ()) (#pt-succ previous)))
          (#pt-lambda
            ((even-proof (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) previous)))
            (#pt-induct
              exists
              (0)
              (#pt-nat
                (#pt-lambda
                  ((candidate-factor #pt-nat))
                  (#pt-eq
                    #pt-nat
                    previous
                    (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) candidate-factor))))
              (#pt-lambda
                (
                  (certificate
                    (#pt-app
                      (#pt-use exists (0))
                      #pt-nat
                      (#pt-lambda
                        ((candidate-factor #pt-nat))
                        (#pt-eq
                          #pt-nat
                          previous
                          (#pt-app
                            (#pt-use multiply ())
                            (#pt-succ (#pt-succ #pt-zero))
                            candidate-factor))))))
                (#pt-app
                  (#pt-use disjunction ())
                  (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-succ previous))
                  (#pt-app (#pt-use odd ()) (#pt-succ previous))))
              (
                (#pt-lambda
                  (
                    (half #pt-nat)
                    (half-equation
                      (#pt-eq
                        #pt-nat
                        previous
                        (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half))))
                  (#pt-app
                    (#pt-use disjunction-right ())
                    (#pt-app
                      (#pt-use divides ())
                      (#pt-succ (#pt-succ #pt-zero))
                      (#pt-succ previous))
                    (#pt-app (#pt-use odd ()) (#pt-succ previous))
                    (#pt-construct
                      exists
                      (0)
                      (#pt-nat
                        (#pt-lambda
                          ((candidate-half #pt-nat))
                          (#pt-eq
                            #pt-nat
                            (#pt-succ previous)
                            (#pt-succ
                              (#pt-app
                                (#pt-use multiply ())
                                (#pt-succ (#pt-succ #pt-zero))
                                candidate-half)))))
                      introduce
                      (half
                        (#pt-app
                          (#pt-use congruence (0 0))
                          #pt-nat
                          #pt-nat
                          (#pt-lambda ((endpoint #pt-nat)) (#pt-succ endpoint))
                          previous
                          (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half)
                          half-equation))))))
              even-proof))
          (#pt-lambda
            ((odd-proof (#pt-app (#pt-use odd ()) previous)))
            (#pt-induct
              exists
              (0)
              (#pt-nat
                (#pt-lambda
                  ((candidate-half #pt-nat))
                  (#pt-eq
                    #pt-nat
                    previous
                    (#pt-succ
                      (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) candidate-half)))))
              (#pt-lambda
                (
                  (certificate
                    (#pt-app
                      (#pt-use exists (0))
                      #pt-nat
                      (#pt-lambda
                        ((candidate-half #pt-nat))
                        (#pt-eq
                          #pt-nat
                          previous
                          (#pt-succ
                            (#pt-app
                              (#pt-use multiply ())
                              (#pt-succ (#pt-succ #pt-zero))
                              candidate-half)))))))
                (#pt-app
                  (#pt-use disjunction ())
                  (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-succ previous))
                  (#pt-app (#pt-use odd ()) (#pt-succ previous))))
              (
                (#pt-lambda
                  (
                    (half #pt-nat)
                    (half-equation
                      (#pt-eq
                        #pt-nat
                        previous
                        (#pt-succ
                          (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half)))))
                  (#pt-app
                    (#pt-use disjunction-left ())
                    (#pt-app
                      (#pt-use divides ())
                      (#pt-succ (#pt-succ #pt-zero))
                      (#pt-succ previous))
                    (#pt-app (#pt-use odd ()) (#pt-succ previous))
                    (#pt-construct
                      exists
                      (0)
                      (#pt-nat
                        (#pt-lambda
                          ((candidate-factor #pt-nat))
                          (#pt-eq
                            #pt-nat
                            (#pt-succ previous)
                            (#pt-app
                              (#pt-use multiply ())
                              (#pt-succ (#pt-succ #pt-zero))
                              candidate-factor))))
                      introduce
                      (
                        (#pt-succ half)
                        (#pt-app
                          (#pt-use transitivity (0))
                          #pt-nat
                          (#pt-succ previous)
                          (#pt-succ
                            (#pt-succ
                              (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half)))
                          (#pt-app
                            (#pt-use multiply ())
                            (#pt-succ (#pt-succ #pt-zero))
                            (#pt-succ half))
                          (#pt-app
                            (#pt-use congruence (0 0))
                            #pt-nat
                            #pt-nat
                            (#pt-lambda ((endpoint #pt-nat)) (#pt-succ endpoint))
                            previous
                            (#pt-succ
                              (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half))
                            half-equation)
                          (#pt-app
                            (#pt-use symmetry (0))
                            #pt-nat
                            (#pt-app
                              (#pt-use multiply ())
                              (#pt-succ (#pt-succ #pt-zero))
                              (#pt-succ half))
                            (#pt-succ
                              (#pt-succ
                                (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half)))
                            (#pt-app
                              (#pt-use multiply-successor-right ())
                              (#pt-succ (#pt-succ #pt-zero))
                              half))))))))
              odd-proof))
          previous-parity))
      number)))
(#theorem prime-not-two-above-two
  (#universes)
  (#parameters
    (#parameter number #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) number))
    (#parameter not-two (#pt-pi ((denied-proof (#pt-eq #pt-nat number (#pt-succ (#pt-succ #pt-zero))))) #pt-false)))
  (#statement (#pt-app (#pt-use less-than ()) (#pt-succ (#pt-succ #pt-zero)) number))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-gap #pt-nat))
          (#pt-eq
            #pt-nat
            number
            (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ #pt-zero)) candidate-gap))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-gap #pt-nat))
                (#pt-eq
                  #pt-nat
                  number
                  (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ #pt-zero)) candidate-gap))))))
        (#pt-app (#pt-use less-than ()) (#pt-succ (#pt-succ #pt-zero)) number))
      (
        (#pt-lambda
          (
            (gap #pt-nat)
            (gap-equation
              (#pt-eq #pt-nat number (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ #pt-zero)) gap))))
          (#pt-app
            (#pt-nat-induct
              (#pt-lambda
                ((index #pt-nat))
                (#pt-pi
                  (
                    (gap-evidence
                      (#pt-eq
                        #pt-nat
                        number
                        (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ #pt-zero)) index))))
                  (#pt-app (#pt-use less-than ()) (#pt-succ (#pt-succ #pt-zero)) number)))
              (#pt-lambda
                (
                  (zero-gap-equation
                    (#pt-eq
                      #pt-nat
                      number
                      (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ #pt-zero)) #pt-zero))))
                (#pt-app
                  (#pt-use false-elimination ())
                  (#pt-app (#pt-use less-than ()) (#pt-succ (#pt-succ #pt-zero)) number)
                  (#pt-app not-two zero-gap-equation)))
              (#pt-lambda
                (
                  (predecessor #pt-nat)
                  (unused-previous
                    (#pt-pi
                      (
                        (previous-equation
                          (#pt-eq
                            #pt-nat
                            number
                            (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ #pt-zero)) predecessor))))
                      (#pt-app (#pt-use less-than ()) (#pt-succ (#pt-succ #pt-zero)) number)))
                  (positive-gap-equation
                    (#pt-eq
                      #pt-nat
                      number
                      (#pt-app
                        (#pt-use add ())
                        (#pt-succ (#pt-succ #pt-zero))
                        (#pt-succ predecessor)))))
                (#pt-construct
                  exists
                  (0)
                  (#pt-nat
                    (#pt-lambda
                      ((candidate-gap #pt-nat))
                      (#pt-eq
                        #pt-nat
                        number
                        (#pt-app
                          (#pt-use add ())
                          (#pt-succ (#pt-succ (#pt-succ #pt-zero)))
                          candidate-gap))))
                  introduce
                  (predecessor positive-gap-equation)))
              gap)
            gap-equation)))
      (#pt-app (#pt-use prime-larger-than-one ()) number prime-proof))))
(#theorem prime-not-two-is-odd
  (#universes)
  (#parameters
    (#parameter number #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) number))
    (#parameter not-two (#pt-pi ((denied-proof (#pt-eq #pt-nat number (#pt-succ (#pt-succ #pt-zero))))) #pt-false)))
  (#statement (#pt-app (#pt-use odd ()) number))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) number)
      (#pt-app (#pt-use odd ()) number)
      (#pt-app (#pt-use odd ()) number)
      (#pt-lambda
        ((even-proof (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) number)))
        (#pt-app
          (#pt-use false-elimination ())
          (#pt-app (#pt-use odd ()) number)
          (#pt-app
            (#pt-app (#pt-use prime-excludes-proper-divisor ()) number prime-proof)
            (#pt-succ (#pt-succ #pt-zero))
            (#pt-construct
              exists
              (0)
              (#pt-nat
                (#pt-lambda
                  ((candidate-gap #pt-nat))
                  (#pt-eq
                    #pt-nat
                    (#pt-succ (#pt-succ #pt-zero))
                    (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ #pt-zero)) candidate-gap))))
              introduce
              (#pt-zero (#pt-refl #pt-nat (#pt-succ (#pt-succ #pt-zero)))))
            (#pt-app (#pt-use prime-not-two-above-two ()) number prime-proof not-two)
            even-proof)))
      (#pt-lambda ((odd-proof (#pt-app (#pt-use odd ()) number))) odd-proof)
      (#pt-app (#pt-use even-or-odd ()) number))))
