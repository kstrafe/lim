  eisenstein-unit-norm-is-one
  =
  ./eisenstein-unit-coordinate-bounds.lim::eisenstein-unit-norm-is-one)
(#alias
  eisenstein-unit-omega-small
  =
  ./eisenstein-unit-coordinate-bounds.lim::eisenstein-unit-omega-small)
(#alias successor-not-zero = ./natural-nonzero.lim::successor-not-zero)
(#alias successor-injective = ./natural-successor.lim::successor-injective)
(#alias symmetry = ./equality.lim::symmetry)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#alias disjunction-left = ./logical-connectives.lim::disjunction-left)
(#alias disjunction-right = ./logical-connectives.lim::disjunction-right)
(#theorem eisenstein-unit-norm-value-impossible
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter representative (#pt-use eisenstein ()))
    (#parameter norm-value #pt-nat)
    (#parameter unit-proof (#pt-app (#pt-use eisenstein-unit ()) number))
    (#parameter representative-equivalence (#pt-app (#pt-use eisenstein-equal ()) number representative))
    (#parameter representative-norm (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use eisenstein-norm ()) representative) (#pt-app (#pt-use integer-of-natural ()) norm-value)))
    (#parameter norm-not-one (#pt-pi ((denied-proof (#pt-eq #pt-nat norm-value (#pt-succ #pt-zero)))) #pt-false)))
  (#statement #pt-false)
  (#proof
    (#pt-app
      norm-not-one
      (#pt-app
        (#pt-use integer-of-natural-injective ())
        norm-value
        (#pt-succ #pt-zero)
        (#pt-app
          (#pt-use integer-transitive ())
          (#pt-app (#pt-use integer-of-natural ()) norm-value)
          (#pt-app (#pt-use eisenstein-norm ()) number)
          (#pt-use integer-one ())
          (#pt-app
            (#pt-use integer-symmetric ())
            (#pt-app (#pt-use eisenstein-norm ()) number)
            (#pt-app (#pt-use integer-of-natural ()) norm-value)
            (#pt-app
              (#pt-use integer-transitive ())
              (#pt-app (#pt-use eisenstein-norm ()) number)
              (#pt-app (#pt-use eisenstein-norm ()) representative)
              (#pt-app (#pt-use integer-of-natural ()) norm-value)
              (#pt-app
                (#pt-use eisenstein-norm-congruent ())
                number
                representative
                representative-equivalence)
              representative-norm))
          (#pt-app (#pt-use eisenstein-unit-norm-is-one ()) number unit-proof))))))
(#theorem eisenstein-unit-zero-real-cases
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter unit-proof (#pt-app (#pt-use eisenstein-unit ()) number))
    (#parameter real-equivalence (#pt-app (#pt-use integer-equal ()) (#pt-project eisenstein 0 number) (#pt-use integer-zero ()))))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-omega ()))
      (#pt-app
        (#pt-use eisenstein-equal ())
        number
        (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ())))))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project eisenstein 1 number)
        (#pt-use integer-zero ()))
      (#pt-app
        (#pt-use disjunction ())
        (#pt-app
          (#pt-use integer-equal ())
          (#pt-project eisenstein 1 number)
          (#pt-use integer-one ()))
        (#pt-app
          (#pt-use integer-equal ())
          (#pt-project eisenstein 1 number)
          (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))
      (#pt-app
        (#pt-use disjunction ())
        (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-omega ()))
        (#pt-app
          (#pt-use eisenstein-equal ())
          number
          (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ()))))
      (#pt-lambda
        (
          (omega-zero
            (#pt-app
              (#pt-use integer-equal ())
              (#pt-project eisenstein 1 number)
              (#pt-use integer-zero ()))))
        (#pt-app
          (#pt-use false-elimination ())
          (#pt-app
            (#pt-use disjunction ())
            (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-omega ()))
            (#pt-app
              (#pt-use eisenstein-equal ())
              number
              (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ()))))
          (#pt-app
            (#pt-use eisenstein-unit-norm-value-impossible ())
            number
            (#pt-construct
              eisenstein
              ()
              ()
              pair
              ((#pt-use integer-zero ()) (#pt-use integer-zero ())))
            #pt-zero
            unit-proof
            (#pt-app
              (#pt-use conjunction-introduce ())
              (#pt-app
                (#pt-use integer-equal ())
                (#pt-project eisenstein 0 number)
                (#pt-project
                  eisenstein
                  0
                  (#pt-construct
                    eisenstein
                    ()
                    ()
                    pair
                    ((#pt-use integer-zero ()) (#pt-use integer-zero ())))))
              (#pt-app
                (#pt-use integer-equal ())
                (#pt-project eisenstein 1 number)
                (#pt-project
                  eisenstein
                  1
                  (#pt-construct
                    eisenstein
                    ()
                    ()
                    pair
                    ((#pt-use integer-zero ()) (#pt-use integer-zero ())))))
              real-equivalence
              omega-zero)
            (#pt-refl #pt-nat #pt-zero)
            (#pt-lambda
              ((impossible-norm (#pt-eq #pt-nat #pt-zero (#pt-succ #pt-zero))))
              (#pt-app
                (#pt-app (#pt-use successor-not-zero ()) #pt-zero)
                (#pt-app
                  (#pt-use symmetry (0))
                  #pt-nat
                  #pt-zero
                  (#pt-succ #pt-zero)
                  impossible-norm))))))
      (#pt-lambda
        (
          (omega-nonzero
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app
                (#pt-use integer-equal ())
                (#pt-project eisenstein 1 number)
                (#pt-use integer-one ()))
              (#pt-app
                (#pt-use integer-equal ())
                (#pt-project eisenstein 1 number)
                (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-project eisenstein 1 number)
            (#pt-use integer-one ()))
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-project eisenstein 1 number)
            (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ())))
          (#pt-app
            (#pt-use disjunction ())
            (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-omega ()))
            (#pt-app
              (#pt-use eisenstein-equal ())
              number
              (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ()))))
          (#pt-lambda
            (
              (omega-positive
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-project eisenstein 1 number)
                  (#pt-use integer-one ()))))
            (#pt-app
              (#pt-use disjunction-left ())
              (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-omega ()))
              (#pt-app
                (#pt-use eisenstein-equal ())
                number
                (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ())))
              (#pt-app
                (#pt-use conjunction-introduce ())
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-project eisenstein 0 number)
                  (#pt-project eisenstein 0 (#pt-use eisenstein-omega ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-project eisenstein 1 number)
                  (#pt-project eisenstein 1 (#pt-use eisenstein-omega ())))
                real-equivalence
                omega-positive)))
          (#pt-lambda
            (
              (omega-negative
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-project eisenstein 1 number)
                  (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ())))))
            (#pt-app
              (#pt-use disjunction-right ())
              (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-omega ()))
              (#pt-app
                (#pt-use eisenstein-equal ())
                number
                (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ())))
              (#pt-app
                (#pt-use conjunction-introduce ())
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-project eisenstein 0 number)
                  (#pt-project
                    eisenstein
                    0
                    (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ()))))
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-project eisenstein 1 number)
                  (#pt-project
                    eisenstein
                    1
                    (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ()))))
                real-equivalence
                omega-negative)))
          omega-nonzero))
      (#pt-app (#pt-use eisenstein-unit-omega-small ()) number unit-proof))))
(#theorem eisenstein-unit-positive-real-cases
