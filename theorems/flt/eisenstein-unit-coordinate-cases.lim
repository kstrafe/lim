; Exhaust the three signed omega-coordinate cases for each real
; coordinate allowed by norm one. Norm zero and norm three exclude
; the three invalid lattice points; each remaining point is one of
; the six concrete roots in Cyclotomic/Three.lean:54-81.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-power = ./eisenstein-defs.lim::eisenstein-power)
(#alias eisenstein-unit = ./eisenstein-defs.lim::eisenstein-unit)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias eisenstein-omega = ./eisenstein-defs.lim::eisenstein-omega)
(#alias eisenstein-negate = ./eisenstein-defs.lim::eisenstein-negate)
