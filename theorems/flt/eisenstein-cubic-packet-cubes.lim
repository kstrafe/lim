; Apply the proved cube extraction to the actual constructed residual
; packet, supplying its three proved pairwise Bezout witnesses and
; witnessed product equation. This produces the actual root/unit
; existentials needed at FLT/Three.lean:567-578; none are hypotheses.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-lambda = ./eisenstein-defs.lim::eisenstein-lambda)
(#alias eisenstein-power = ./eisenstein-defs.lim::eisenstein-power)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias eisenstein-unit = ./eisenstein-defs.lim::eisenstein-unit)
(#alias eisenstein-lambda-order = ./eisenstein-lambda-order.lim::eisenstein-lambda-order)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias eisenstein-add = ./eisenstein-defs.lim::eisenstein-add)
(#alias eisenstein-coprime = ./eisenstein-defs.lim::eisenstein-coprime)
(#alias eisenstein-associated-cube = ./eisenstein-associated-cube.lim::eisenstein-associated-cube)
(#alias
  eisenstein-coprime-triple-associated-cubes
  =
  ./eisenstein-coprime-cube-triple.lim::eisenstein-coprime-triple-associated-cubes)
(#alias
  eisenstein-cubic-residual-packet
  =
  ./eisenstein-cubic-residual-equation.lim::eisenstein-cubic-residual-packet)
(#alias
  eisenstein-cubic-packet-residuals-coprime
  =
  ./eisenstein-cubic-packet-coprime.lim::eisenstein-cubic-packet-residuals-coprime)
(#theorem eisenstein-cubic-packet-residuals-associated-cubes
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter third (#pt-use eisenstein ()))
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter primary-order #pt-nat)
    (#parameter third-order #pt-nat)
    (#parameter primary-residual (#pt-use eisenstein ()))
    (#parameter omega-residual (#pt-use eisenstein ()))
    (#parameter square-residual (#pt-use eisenstein ()))
    (#parameter third-residual (#pt-use eisenstein ()))
    (#parameter primary-order-certificate (#pt-app (#pt-use eisenstein-lambda-order ()) (#pt-app (#pt-use eisenstein-add ()) first second) primary-order))
    (#parameter primary-square-divisor (#pt-app (#pt-use eisenstein-divides ()) (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2)) (#pt-app (#pt-use eisenstein-add ()) first second)))
    (#parameter coprime-proof (#pt-app (#pt-use eisenstein-coprime ()) first second))
    (#parameter residual-packet (#pt-app (#pt-use eisenstein-cubic-residual-packet ()) first second third unit primary-order third-order primary-residual omega-residual square-residual third-residual))
    (#parameter unit-certificate (#pt-app (#pt-use eisenstein-unit ()) unit)))
  (#statement
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app (#pt-use eisenstein-associated-cube ()) primary-residual)
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app (#pt-use eisenstein-associated-cube ()) omega-residual)
        (#pt-app (#pt-use eisenstein-associated-cube ()) square-residual))))
  (#proof
    (#pt-app
      (#pt-use eisenstein-coprime-triple-associated-cubes ())
      primary-residual
      omega-residual
      square-residual
      unit
      third-residual
      (#pt-project
        conjunction
        0
        (#pt-app
          (#pt-use eisenstein-cubic-packet-residuals-coprime ())
          first
          second
          third
          unit
          primary-order
          third-order
          primary-residual
          omega-residual
          square-residual
          third-residual
          primary-order-certificate
          primary-square-divisor
          coprime-proof
          residual-packet))
      (#pt-project
        conjunction
        0
        (#pt-project
          conjunction
          1
          (#pt-app
            (#pt-use eisenstein-cubic-packet-residuals-coprime ())
            first
            second
            third
            unit
            primary-order
            third-order
            primary-residual
            omega-residual
            square-residual
            third-residual
            primary-order-certificate
            primary-square-divisor
            coprime-proof
            residual-packet)))
      (#pt-project
        conjunction
        1
        (#pt-project
          conjunction
          1
          (#pt-app
            (#pt-use eisenstein-cubic-packet-residuals-coprime ())
            first
            second
            third
            unit
            primary-order
            third-order
            primary-residual
            omega-residual
            square-residual
            third-residual
            primary-order-certificate
            primary-square-divisor
            coprime-proof
            residual-packet)))
      unit-certificate
      (#pt-project
        conjunction
        1
        (#pt-project
          conjunction
          1
          (#pt-project
            conjunction
            1
            (#pt-project
              conjunction
              1
              (#pt-project
                conjunction
                1
                (#pt-project
                  conjunction
                  1
                  (#pt-project conjunction 1 (#pt-project conjunction 1 residual-packet)))))))))))
