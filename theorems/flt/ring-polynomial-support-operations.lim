; Coefficient formulas prove support bounds for sums,
; negation, scaling, shifts and constants. These upper bounds do not
; assume a domain or that a sum/product retains a leading term.
(#alias add = ./../fermat_statement.lim::add)
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias ring-add = ./commutative-ring-data.lim::ring-add)
