      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-polynomial-shift ()) Carrier coefficient-ring polynomial)
      (#pt-succ support-bound)))
  (#proof support))
(#theorem ring-polynomial-support-cons-successor
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter head Carrier)
    (#parameter tail (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter support-bound #pt-nat)
    (#parameter support (#pt-app (#pt-use ring-polynomial-support-from ()) Carrier coefficient-ring tail support-bound)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-support-from ())
      Carrier
      coefficient-ring
      (#pt-construct finite-list () (Carrier) cons (head tail))
      (#pt-succ support-bound)))
  (#proof support))
(#theorem ring-polynomial-support-tail
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter head Carrier)
    (#parameter tail (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter support-bound #pt-nat)
    (#parameter support (#pt-app (#pt-use ring-polynomial-support-from ()) Carrier coefficient-ring (#pt-construct finite-list () (Carrier) cons (head tail)) (#pt-succ support-bound))))
  (#statement
    (#pt-app (#pt-use ring-polynomial-support-from ()) Carrier coefficient-ring tail support-bound))
  (#proof support))
(#theorem ring-polynomial-support-constant
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter scalar Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-support-from ())
      Carrier
      coefficient-ring
      (#pt-construct
        finite-list
        ()
        (Carrier)
        cons
        (scalar (#pt-construct finite-list () (Carrier) nil ())))
      (#pt-succ #pt-zero)))
  (#proof
    (#pt-lambda
      ((index #pt-nat))
      (#pt-app
        (#pt-use ring-reflexive ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))))
