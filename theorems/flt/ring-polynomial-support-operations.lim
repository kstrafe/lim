(#alias
  ring-polynomial-support-from
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-support-from)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#alias ring-transitive = ./commutative-ring-data.lim::ring-transitive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#theorem ring-polynomial-support-add
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter support-bound #pt-nat)
    (#parameter first-support (#pt-app (#pt-use ring-polynomial-support-from ()) Carrier coefficient-ring polynomial support-bound))
    (#parameter second-support (#pt-app (#pt-use ring-polynomial-support-from ()) Carrier coefficient-ring other-polynomial support-bound)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-support-from ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-add ())
        Carrier
        coefficient-ring
        polynomial
        other-polynomial)
      support-bound))
  (#proof
    (#pt-lambda
      ((index #pt-nat))
      (#pt-app
        (#pt-use ring-transitive ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-coefficient ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-add ())
            Carrier
            coefficient-ring
            polynomial
            other-polynomial)
          (#pt-app (#pt-use add ()) support-bound index))
        (#pt-app
          (#pt-use ring-add ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-coefficient ())
            Carrier
            coefficient-ring
            polynomial
            (#pt-app (#pt-use add ()) support-bound index))
          (#pt-app
            (#pt-use ring-polynomial-coefficient ())
            Carrier
            coefficient-ring
            other-polynomial
            (#pt-app (#pt-use add ()) support-bound index)))
        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
        (#pt-app
          (#pt-use ring-polynomial-add-coefficient ())
          Carrier
          coefficient-ring
          polynomial
          other-polynomial
          (#pt-app (#pt-use add ()) support-bound index))
        (#pt-app
          (#pt-use ring-transitive ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-add ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-coefficient ())
              Carrier
              coefficient-ring
              polynomial
              (#pt-app (#pt-use add ()) support-bound index))
            (#pt-app
              (#pt-use ring-polynomial-coefficient ())
              Carrier
              coefficient-ring
              other-polynomial
              (#pt-app (#pt-use add ()) support-bound index)))
          (#pt-app
            (#pt-use ring-add ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
          (#pt-app
            (#pt-use ring-add-congruent ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-coefficient ())
              Carrier
              coefficient-ring
              polynomial
              (#pt-app (#pt-use add ()) support-bound index))
            (#pt-app
              (#pt-use ring-polynomial-coefficient ())
              Carrier
              coefficient-ring
              other-polynomial
              (#pt-app (#pt-use add ()) support-bound index))
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
            (#pt-app first-support index)
            (#pt-app second-support index))
          (#pt-app
            (#pt-use ring-add-zero ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))))))
(#theorem ring-polynomial-support-negate
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter support-bound #pt-nat)
    (#parameter support (#pt-app (#pt-use ring-polynomial-support-from ()) Carrier coefficient-ring polynomial support-bound)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-support-from ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-polynomial-negate ()) Carrier coefficient-ring polynomial)
      support-bound))
  (#proof
    (#pt-lambda
      ((index #pt-nat))
      (#pt-app
        (#pt-use ring-transitive ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-coefficient ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-polynomial-negate ()) Carrier coefficient-ring polynomial)
          (#pt-app (#pt-use add ()) support-bound index))
        (#pt-app
          (#pt-use ring-negate ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-coefficient ())
            Carrier
            coefficient-ring
            polynomial
            (#pt-app (#pt-use add ()) support-bound index)))
        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
        (#pt-app
          (#pt-use ring-polynomial-negate-coefficient ())
          Carrier
          coefficient-ring
          polynomial
          (#pt-app (#pt-use add ()) support-bound index))
        (#pt-app
          (#pt-use ring-transitive ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-negate ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-coefficient ())
              Carrier
              coefficient-ring
              polynomial
              (#pt-app (#pt-use add ()) support-bound index)))
          (#pt-app
            (#pt-use ring-negate ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
          (#pt-app
            (#pt-use ring-negate-congruent ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-coefficient ())
              Carrier
              coefficient-ring
              polynomial
              (#pt-app (#pt-use add ()) support-bound index))
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
            (#pt-app support index))
          (#pt-app (#pt-use ring-negate-zero ()) Carrier coefficient-ring))))))
(#theorem ring-polynomial-support-scale
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter scalar Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter support-bound #pt-nat)
    (#parameter support (#pt-app (#pt-use ring-polynomial-support-from ()) Carrier coefficient-ring polynomial support-bound)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-support-from ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-polynomial-scale ()) Carrier coefficient-ring scalar polynomial)
      support-bound))
  (#proof
    (#pt-lambda
      ((index #pt-nat))
      (#pt-app
        (#pt-use ring-transitive ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-coefficient ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-polynomial-scale ()) Carrier coefficient-ring scalar polynomial)
          (#pt-app (#pt-use add ()) support-bound index))
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          scalar
          (#pt-app
            (#pt-use ring-polynomial-coefficient ())
            Carrier
            coefficient-ring
            polynomial
            (#pt-app (#pt-use add ()) support-bound index)))
        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
        (#pt-app
          (#pt-use ring-polynomial-scale-coefficient ())
          Carrier
          coefficient-ring
          scalar
          polynomial
          (#pt-app (#pt-use add ()) support-bound index))
        (#pt-app
          (#pt-use ring-transitive ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            scalar
            (#pt-app
              (#pt-use ring-polynomial-coefficient ())
              Carrier
              coefficient-ring
              polynomial
              (#pt-app (#pt-use add ()) support-bound index)))
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            scalar
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
          (#pt-app
            (#pt-use ring-multiply-congruent ())
            Carrier
            coefficient-ring
            scalar
            (#pt-app
              (#pt-use ring-polynomial-coefficient ())
              Carrier
              coefficient-ring
              polynomial
              (#pt-app (#pt-use add ()) support-bound index))
            scalar
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
            (#pt-app (#pt-use ring-reflexive ()) Carrier coefficient-ring scalar)
            (#pt-app support index))
          (#pt-app (#pt-use ring-multiply-zero ()) Carrier coefficient-ring scalar))))))
(#theorem ring-polynomial-support-shift
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
