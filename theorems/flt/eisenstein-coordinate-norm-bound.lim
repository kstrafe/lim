; A concrete remainder with natural coordinates a,b<d has norm<d*d.
; Its actual natural norm certificate gives n+a*b=a*a+b*b;
; the proved rectangular budget bound supplies the strict inequality.
; No Euclidean division or factorization conclusion is assumed.
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-reflexive = ./integer-equality.lim::integer-reflexive)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias integer-add-congruent = ./integer-equality.lim::integer-add-congruent)
(#alias integer-of-natural-injective = ./integer-equality.lim::integer-of-natural-injective)
(#alias integer-add-associative = ./integer-addition.lim::integer-add-associative)
(#alias integer-add-commutative = ./integer-addition.lim::integer-add-commutative)
(#alias integer-multiply-of-natural = ./integer-multiplication.lim::integer-multiply-of-natural)
(#alias integer-add-of-natural = ./integer-multiplication.lim::integer-add-of-natural)
(#alias
  integer-add-negative-cancel
  =
  ./integer-divisibility-addition.lim::integer-add-negative-cancel)
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-norm = ./eisenstein-norm-defs.lim::eisenstein-norm)
(#alias eisenstein-natural-norm = ./eisenstein-norm-defs.lim::eisenstein-natural-norm)
(#alias
  natural-rectangle-square-budget-bound
  =
  ./natural-rectangle-norm-bound.lim::natural-rectangle-square-budget-bound)
(#alias add = ./../fermat_statement.lim::add)
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias less-than = ./natural-order.lim::less-than)
(#theorem eisenstein-norm-plus-coordinate-product
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use eisenstein-norm ()) number)
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-project eisenstein 0 number)
          (#pt-project eisenstein 1 number)))
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-project eisenstein 0 number)
          (#pt-project eisenstein 0 number))
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-project eisenstein 1 number)
          (#pt-project eisenstein 1 number)))))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use eisenstein-norm ()) number)
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-project eisenstein 0 number)
          (#pt-project eisenstein 1 number)))
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project eisenstein 0 number)
            (#pt-project eisenstein 0 number))
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project eisenstein 0 number)
              (#pt-project eisenstein 1 number))))
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project eisenstein 1 number)
            (#pt-project eisenstein 1 number))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project eisenstein 0 number)
            (#pt-project eisenstein 1 number))))
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-project eisenstein 0 number)
          (#pt-project eisenstein 0 number))
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-project eisenstein 1 number)
          (#pt-project eisenstein 1 number)))
      (#pt-app
        (#pt-use integer-add-associative ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project eisenstein 0 number)
            (#pt-project eisenstein 0 number))
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project eisenstein 0 number)
              (#pt-project eisenstein 1 number))))
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-project eisenstein 1 number)
          (#pt-project eisenstein 1 number))
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-project eisenstein 0 number)
          (#pt-project eisenstein 1 number)))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project eisenstein 0 number)
              (#pt-project eisenstein 0 number))
            (#pt-app
              (#pt-use integer-negate ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project eisenstein 0 number)
                (#pt-project eisenstein 1 number))))
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project eisenstein 1 number)
              (#pt-project eisenstein 1 number))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project eisenstein 0 number)
              (#pt-project eisenstein 1 number))))
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project eisenstein 0 number)
            (#pt-project eisenstein 0 number))
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app
              (#pt-use integer-negate ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project eisenstein 0 number)
                (#pt-project eisenstein 1 number)))
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project eisenstein 1 number)
                (#pt-project eisenstein 1 number))
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project eisenstein 0 number)
                (#pt-project eisenstein 1 number)))))
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project eisenstein 0 number)
            (#pt-project eisenstein 0 number))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project eisenstein 1 number)
            (#pt-project eisenstein 1 number)))
        (#pt-app
          (#pt-use integer-add-associative ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project eisenstein 0 number)
            (#pt-project eisenstein 0 number))
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project eisenstein 0 number)
              (#pt-project eisenstein 1 number)))
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project eisenstein 1 number)
              (#pt-project eisenstein 1 number))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project eisenstein 0 number)
              (#pt-project eisenstein 1 number))))
        (#pt-app
          (#pt-use integer-add-congruent ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project eisenstein 0 number)
            (#pt-project eisenstein 0 number))
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app
              (#pt-use integer-negate ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project eisenstein 0 number)
                (#pt-project eisenstein 1 number)))
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project eisenstein 1 number)
                (#pt-project eisenstein 1 number))
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project eisenstein 0 number)
                (#pt-project eisenstein 1 number))))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project eisenstein 0 number)
            (#pt-project eisenstein 0 number))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project eisenstein 1 number)
            (#pt-project eisenstein 1 number))
          (#pt-app
            (#pt-use integer-reflexive ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project eisenstein 0 number)
              (#pt-project eisenstein 0 number)))
          (#pt-app
            (#pt-use integer-transitive ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-negate ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-project eisenstein 0 number)
                  (#pt-project eisenstein 1 number)))
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-project eisenstein 1 number)
                  (#pt-project eisenstein 1 number))
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-project eisenstein 0 number)
                  (#pt-project eisenstein 1 number))))
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-negate ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-project eisenstein 0 number)
                  (#pt-project eisenstein 1 number)))
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-project eisenstein 0 number)
                  (#pt-project eisenstein 1 number))
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-project eisenstein 1 number)
                  (#pt-project eisenstein 1 number))))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project eisenstein 1 number)
              (#pt-project eisenstein 1 number))
            (#pt-app
              (#pt-use integer-add-congruent ())
              (#pt-app
                (#pt-use integer-negate ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-project eisenstein 0 number)
                  (#pt-project eisenstein 1 number)))
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-project eisenstein 1 number)
                  (#pt-project eisenstein 1 number))
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-project eisenstein 0 number)
                  (#pt-project eisenstein 1 number)))
              (#pt-app
                (#pt-use integer-negate ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-project eisenstein 0 number)
                  (#pt-project eisenstein 1 number)))
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-project eisenstein 0 number)
                  (#pt-project eisenstein 1 number))
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-project eisenstein 1 number)
                  (#pt-project eisenstein 1 number)))
              (#pt-app
                (#pt-use integer-reflexive ())
                (#pt-app
                  (#pt-use integer-negate ())
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-project eisenstein 0 number)
                    (#pt-project eisenstein 1 number))))
              (#pt-app
                (#pt-use integer-add-commutative ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-project eisenstein 1 number)
                  (#pt-project eisenstein 1 number))
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-project eisenstein 0 number)
                  (#pt-project eisenstein 1 number))))
            (#pt-app
              (#pt-use integer-add-negative-cancel ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project eisenstein 0 number)
                (#pt-project eisenstein 1 number))
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project eisenstein 1 number)
                (#pt-project eisenstein 1 number)))))))))
(#theorem eisenstein-natural-coordinate-norm-balance
  (#universes)
  (#parameters
    (#parameter real-coordinate #pt-nat)
    (#parameter omega-coordinate #pt-nat)
    (#parameter natural-norm #pt-nat)
    (#parameter norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) (#pt-construct eisenstein () () pair ((#pt-app (#pt-use integer-of-natural ()) real-coordinate) (#pt-app (#pt-use integer-of-natural ()) omega-coordinate))) natural-norm)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app
        (#pt-use add ())
        natural-norm
        (#pt-app (#pt-use multiply ()) real-coordinate omega-coordinate))
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use multiply ()) real-coordinate real-coordinate)
        (#pt-app (#pt-use multiply ()) omega-coordinate omega-coordinate))))
  (#proof
    (#pt-app
      (#pt-use integer-of-natural-injective ())
      (#pt-app
        (#pt-use add ())
        natural-norm
        (#pt-app (#pt-use multiply ()) real-coordinate omega-coordinate))
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use multiply ()) real-coordinate real-coordinate)
        (#pt-app (#pt-use multiply ()) omega-coordinate omega-coordinate))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app
          (#pt-use integer-of-natural ())
          (#pt-app
            (#pt-use add ())
            natural-norm
            (#pt-app (#pt-use multiply ()) real-coordinate omega-coordinate)))
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app (#pt-use integer-of-natural ()) natural-norm)
          (#pt-app
            (#pt-use integer-of-natural ())
            (#pt-app (#pt-use multiply ()) real-coordinate omega-coordinate)))
        (#pt-app
          (#pt-use integer-of-natural ())
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use multiply ()) real-coordinate real-coordinate)
            (#pt-app (#pt-use multiply ()) omega-coordinate omega-coordinate)))
        (#pt-app
          (#pt-use integer-symmetric ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app (#pt-use integer-of-natural ()) natural-norm)
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app (#pt-use multiply ()) real-coordinate omega-coordinate)))
          (#pt-app
            (#pt-use integer-of-natural ())
            (#pt-app
              (#pt-use add ())
              natural-norm
              (#pt-app (#pt-use multiply ()) real-coordinate omega-coordinate)))
          (#pt-app
            (#pt-use integer-add-of-natural ())
            natural-norm
            (#pt-app (#pt-use multiply ()) real-coordinate omega-coordinate)))
        (#pt-app
          (#pt-use integer-transitive ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app (#pt-use integer-of-natural ()) natural-norm)
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app (#pt-use multiply ()) real-coordinate omega-coordinate)))
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app
              (#pt-use eisenstein-norm ())
              (#pt-construct
                eisenstein
                ()
                ()
                pair
                (
                  (#pt-app (#pt-use integer-of-natural ()) real-coordinate)
                  (#pt-app (#pt-use integer-of-natural ()) omega-coordinate))))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-of-natural ()) real-coordinate)
              (#pt-app (#pt-use integer-of-natural ()) omega-coordinate)))
          (#pt-app
            (#pt-use integer-of-natural ())
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use multiply ()) real-coordinate real-coordinate)
              (#pt-app (#pt-use multiply ()) omega-coordinate omega-coordinate)))
          (#pt-app
            (#pt-use integer-add-congruent ())
            (#pt-app (#pt-use integer-of-natural ()) natural-norm)
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app (#pt-use multiply ()) real-coordinate omega-coordinate))
            (#pt-app
              (#pt-use eisenstein-norm ())
              (#pt-construct
                eisenstein
                ()
                ()
                pair
                (
                  (#pt-app (#pt-use integer-of-natural ()) real-coordinate)
                  (#pt-app (#pt-use integer-of-natural ()) omega-coordinate))))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-of-natural ()) real-coordinate)
              (#pt-app (#pt-use integer-of-natural ()) omega-coordinate))
            (#pt-app
              (#pt-use integer-symmetric ())
              (#pt-app
                (#pt-use eisenstein-norm ())
                (#pt-construct
                  eisenstein
                  ()
                  ()
                  pair
                  (
                    (#pt-app (#pt-use integer-of-natural ()) real-coordinate)
                    (#pt-app (#pt-use integer-of-natural ()) omega-coordinate))))
              (#pt-app (#pt-use integer-of-natural ()) natural-norm)
              norm-certificate)
            (#pt-app
              (#pt-use integer-symmetric ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-of-natural ()) real-coordinate)
                (#pt-app (#pt-use integer-of-natural ()) omega-coordinate))
              (#pt-app
                (#pt-use integer-of-natural ())
                (#pt-app (#pt-use multiply ()) real-coordinate omega-coordinate))
              (#pt-app (#pt-use integer-multiply-of-natural ()) real-coordinate omega-coordinate)))
          (#pt-app
            (#pt-use integer-transitive ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use eisenstein-norm ())
                (#pt-construct
                  eisenstein
                  ()
                  ()
                  pair
                  (
                    (#pt-app (#pt-use integer-of-natural ()) real-coordinate)
                    (#pt-app (#pt-use integer-of-natural ()) omega-coordinate))))
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-of-natural ()) real-coordinate)
                (#pt-app (#pt-use integer-of-natural ()) omega-coordinate)))
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-of-natural ()) real-coordinate)
                (#pt-app (#pt-use integer-of-natural ()) real-coordinate))
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-of-natural ()) omega-coordinate)
                (#pt-app (#pt-use integer-of-natural ()) omega-coordinate)))
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) real-coordinate real-coordinate)
                (#pt-app (#pt-use multiply ()) omega-coordinate omega-coordinate)))
            (#pt-app
              (#pt-use eisenstein-norm-plus-coordinate-product ())
              (#pt-construct
                eisenstein
                ()
                ()
                pair
                (
                  (#pt-app (#pt-use integer-of-natural ()) real-coordinate)
                  (#pt-app (#pt-use integer-of-natural ()) omega-coordinate))))
            (#pt-app
              (#pt-use integer-transitive ())
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-of-natural ()) real-coordinate)
                  (#pt-app (#pt-use integer-of-natural ()) real-coordinate))
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-of-natural ()) omega-coordinate)
                  (#pt-app (#pt-use integer-of-natural ()) omega-coordinate)))
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app
                  (#pt-use integer-of-natural ())
                  (#pt-app (#pt-use multiply ()) real-coordinate real-coordinate))
                (#pt-app
                  (#pt-use integer-of-natural ())
                  (#pt-app (#pt-use multiply ()) omega-coordinate omega-coordinate)))
              (#pt-app
                (#pt-use integer-of-natural ())
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) real-coordinate real-coordinate)
                  (#pt-app (#pt-use multiply ()) omega-coordinate omega-coordinate)))
              (#pt-app
                (#pt-use integer-add-congruent ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-of-natural ()) real-coordinate)
                  (#pt-app (#pt-use integer-of-natural ()) real-coordinate))
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-of-natural ()) omega-coordinate)
                  (#pt-app (#pt-use integer-of-natural ()) omega-coordinate))
                (#pt-app
                  (#pt-use integer-of-natural ())
                  (#pt-app (#pt-use multiply ()) real-coordinate real-coordinate))
                (#pt-app
                  (#pt-use integer-of-natural ())
                  (#pt-app (#pt-use multiply ()) omega-coordinate omega-coordinate))
                (#pt-app (#pt-use integer-multiply-of-natural ()) real-coordinate real-coordinate)
                (#pt-app (#pt-use integer-multiply-of-natural ()) omega-coordinate omega-coordinate))
              (#pt-app
                (#pt-use integer-add-of-natural ())
                (#pt-app (#pt-use multiply ()) real-coordinate real-coordinate)
                (#pt-app (#pt-use multiply ()) omega-coordinate omega-coordinate)))))))))
(#theorem eisenstein-natural-coordinate-norm-bound
  (#universes)
  (#parameters
    (#parameter real-coordinate #pt-nat)
    (#parameter omega-coordinate #pt-nat)
    (#parameter natural-norm #pt-nat)
    (#parameter bound #pt-nat)
    (#parameter norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) (#pt-construct eisenstein () () pair ((#pt-app (#pt-use integer-of-natural ()) real-coordinate) (#pt-app (#pt-use integer-of-natural ()) omega-coordinate))) natural-norm))
    (#parameter real-bound (#pt-app (#pt-use less-than ()) real-coordinate bound))
    (#parameter omega-bound (#pt-app (#pt-use less-than ()) omega-coordinate bound)))
  (#statement
    (#pt-app (#pt-use less-than ()) natural-norm (#pt-app (#pt-use multiply ()) bound bound)))
  (#proof
    (#pt-app
      (#pt-use natural-rectangle-square-budget-bound ())
      real-coordinate
      omega-coordinate
      natural-norm
      bound
      (#pt-app
        (#pt-use eisenstein-natural-coordinate-norm-balance ())
        real-coordinate
        omega-coordinate
        natural-norm
        norm-certificate)
      real-bound
      omega-bound)))
