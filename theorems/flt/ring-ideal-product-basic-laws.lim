; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Prove actual ideal product commutativity, both
; factor containments and monotonicity from the product universal
; property and the checked input ideal closures.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias ring-ideal = ./ring-ideal-data.lim::ring-ideal)
(#alias ring-ideal-equal = ./ring-ideal-data.lim::ring-ideal-equal)
(#alias ring-ideal-member = ./ring-ideal-data.lim::ring-ideal-member)
(#alias ring-ideal-member-congruent = ./ring-ideal-data.lim::ring-ideal-member-congruent)
(#alias ring-ideal-multiply-left = ./ring-ideal-data.lim::ring-ideal-multiply-left)
(#alias ring-ideal-multiply-right = ./ring-ideal-data.lim::ring-ideal-multiply-right)
(#alias ring-ideal-product = ./ring-ideal-product.lim::ring-ideal-product)
(#alias ring-ideal-product-introduce = ./ring-ideal-product.lim::ring-ideal-product-introduce)
(#alias ring-ideal-product-least = ./ring-ideal-product.lim::ring-ideal-product-least)
(#alias ring-ideal-subset = ./ring-ideal-data.lim::ring-ideal-subset)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-multiply-commutative = ./commutative-ring-data.lim::ring-multiply-commutative)
(#theorem ring-ideal-product-commutative
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal second-ideal)
      (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring second-ideal first-ideal)))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal second-ideal)
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring second-ideal first-ideal))
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring second-ideal first-ideal)
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal second-ideal))
      (#pt-app
        (#pt-use ring-ideal-product-least ())
        Carrier
        coefficient-ring
        first-ideal
        second-ideal
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring second-ideal first-ideal)
        (#pt-lambda
          (
            (first-element Carrier)
            (second-element Carrier)
            (left-member
              (#pt-app
                (#pt-use ring-ideal-member ())
                Carrier
                coefficient-ring
                first-ideal
                first-element))
            (right-member
              (#pt-app
                (#pt-use ring-ideal-member ())
                Carrier
                coefficient-ring
                second-ideal
                second-element)))
          (#pt-app
            (#pt-use ring-ideal-member-congruent ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-ideal-product ())
              Carrier
              coefficient-ring
              second-ideal
              first-ideal)
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              second-element
              first-element)
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              first-element
              second-element)
            (#pt-app
              (#pt-use ring-multiply-commutative ())
              Carrier
              coefficient-ring
              second-element
              first-element)
            (#pt-app
              (#pt-use ring-ideal-product-introduce ())
              Carrier
              coefficient-ring
              second-ideal
              first-ideal
              second-element
              first-element
              right-member
              left-member))))
      (#pt-app
        (#pt-use ring-ideal-product-least ())
        Carrier
        coefficient-ring
        second-ideal
        first-ideal
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal second-ideal)
        (#pt-lambda
          (
            (first-element Carrier)
            (second-element Carrier)
            (left-member
              (#pt-app
                (#pt-use ring-ideal-member ())
                Carrier
                coefficient-ring
                second-ideal
                first-element))
            (right-member
              (#pt-app
                (#pt-use ring-ideal-member ())
                Carrier
                coefficient-ring
                first-ideal
                second-element)))
          (#pt-app
            (#pt-use ring-ideal-member-congruent ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-ideal-product ())
              Carrier
              coefficient-ring
              first-ideal
              second-ideal)
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              second-element
              first-element)
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              first-element
              second-element)
            (#pt-app
              (#pt-use ring-multiply-commutative ())
              Carrier
              coefficient-ring
              second-element
              first-element)
            (#pt-app
              (#pt-use ring-ideal-product-introduce ())
              Carrier
              coefficient-ring
              first-ideal
              second-ideal
              second-element
              first-element
              right-member
              left-member)))))))
(#theorem ring-ideal-product-left-contained
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal second-ideal)
      first-ideal))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-product-least ())
      Carrier
      coefficient-ring
      first-ideal
      second-ideal
      first-ideal
      (#pt-lambda
        (
          (first-element Carrier)
          (second-element Carrier)
          (left-member
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              first-ideal
              first-element))
          (right-member
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              second-ideal
              second-element)))
        (#pt-app
          (#pt-use ring-ideal-multiply-right ())
          Carrier
          coefficient-ring
          first-ideal
          first-element
          second-element
          left-member)))))
(#theorem ring-ideal-product-right-contained
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal second-ideal)
      second-ideal))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-product-least ())
      Carrier
      coefficient-ring
      first-ideal
      second-ideal
      second-ideal
      (#pt-lambda
        (
          (first-element Carrier)
          (second-element Carrier)
          (left-member
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              first-ideal
              first-element))
          (right-member
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              second-ideal
              second-element)))
        (#pt-app
          (#pt-use ring-ideal-multiply-left ())
          Carrier
          coefficient-ring
          second-ideal
          first-element
          second-element
          right-member)))))
(#theorem ring-ideal-product-monotone
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter larger-first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter larger-second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter first-inclusion (#pt-app (#pt-use ring-ideal-subset ()) Carrier coefficient-ring first-ideal larger-first-ideal))
    (#parameter second-inclusion (#pt-app (#pt-use ring-ideal-subset ()) Carrier coefficient-ring second-ideal larger-second-ideal)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal second-ideal)
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        larger-first-ideal
        larger-second-ideal)))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-product-least ())
      Carrier
      coefficient-ring
      first-ideal
      second-ideal
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        larger-first-ideal
        larger-second-ideal)
      (#pt-lambda
        (
          (first-element Carrier)
          (second-element Carrier)
          (left-member
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              first-ideal
              first-element))
          (right-member
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              second-ideal
              second-element)))
        (#pt-app
          (#pt-use ring-ideal-product-introduce ())
          Carrier
          coefficient-ring
          larger-first-ideal
          larger-second-ideal
          first-element
          second-element
          (#pt-app first-inclusion first-element left-member)
          (#pt-app second-inclusion second-element right-member))))))
