; Connect the constructed residual packet to actual pairwise Bezout
; witnesses, matching FLT/Three.lean:535-547. The primary exponent
; is positive because its exact order also supports a square divisor.
; This derives positivity and coprimality without PID or prime oracles.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-lambda = ./eisenstein-defs.lim::eisenstein-lambda)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-power = ./eisenstein-defs.lim::eisenstein-power)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias eisenstein-lambda-order = ./eisenstein-lambda-order.lim::eisenstein-lambda-order)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias exists = ./logic-exists.lim::exists)
(#alias eisenstein-add = ./eisenstein-defs.lim::eisenstein-add)
(#alias eisenstein-coprime = ./eisenstein-defs.lim::eisenstein-coprime)
(#alias
  eisenstein-power-divides-step
  =
  ./eisenstein-power-divisibility.lim::eisenstein-power-divides-step)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#alias substitution = ./equality.lim::substitution)
(#alias
  eisenstein-cubic-residual-packet
  =
  ./eisenstein-cubic-residual-equation.lim::eisenstein-cubic-residual-packet)
(#alias
  eisenstein-cubic-primary-omega-residuals-coprime
  =
  ./eisenstein-cubic-residual-coprime.lim::eisenstein-cubic-primary-omega-residuals-coprime)
(#alias
  eisenstein-cubic-primary-square-residuals-coprime
  =
  ./eisenstein-cubic-residual-coprime.lim::eisenstein-cubic-primary-square-residuals-coprime)
(#alias
  eisenstein-cubic-rotated-residuals-coprime
  =
  ./eisenstein-cubic-residual-coprime.lim::eisenstein-cubic-rotated-residuals-coprime)
(#theorem eisenstein-square-divisible-order-predecessor
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter order-exponent #pt-nat)
    (#parameter given-order (#pt-app (#pt-use eisenstein-lambda-order ()) number order-exponent))
    (#parameter given-square (#pt-app (#pt-use eisenstein-divides ()) (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2)) number)))
  (#statement
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-predecessor #pt-nat))
        (#pt-eq #pt-nat order-exponent (#pt-succ candidate-predecessor)))))
  (#proof
    (#pt-app
      (#pt-nat-induct
        (#pt-lambda
          ((index #pt-nat))
          (#pt-pi
            (
              (order-certificate (#pt-app (#pt-use eisenstein-lambda-order ()) number index))
              (square-divisor
                (#pt-app
                  (#pt-use eisenstein-divides ())
                  (#pt-app
                    (#pt-use eisenstein-power ())
                    (#pt-use eisenstein-lambda ())
                    (#pt-numeral 2))
                  number)))
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-predecessor #pt-nat))
                (#pt-eq #pt-nat index (#pt-succ candidate-predecessor))))))
        (#pt-lambda
          (
            (order-certificate (#pt-app (#pt-use eisenstein-lambda-order ()) number #pt-zero))
            (square-divisor
              (#pt-app
                (#pt-use eisenstein-divides ())
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-numeral 2))
                number)))
          (#pt-app
            (#pt-use false-elimination ())
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-predecessor #pt-nat))
                (#pt-eq #pt-nat #pt-zero (#pt-succ candidate-predecessor))))
            (#pt-app
              (#pt-project eisenstein-lambda-order 1 order-certificate)
              (#pt-app
                (#pt-use eisenstein-power-divides-step ())
                (#pt-use eisenstein-lambda ())
                (#pt-succ #pt-zero)
                number
                square-divisor))))
        (#pt-lambda
          (
            (predecessor #pt-nat)
            (history
              (#pt-pi
                (
                  (order-certificate
                    (#pt-app (#pt-use eisenstein-lambda-order ()) number predecessor))
                  (square-divisor
                    (#pt-app
                      (#pt-use eisenstein-divides ())
                      (#pt-app
                        (#pt-use eisenstein-power ())
                        (#pt-use eisenstein-lambda ())
                        (#pt-numeral 2))
                      number)))
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((candidate-predecessor #pt-nat))
                    (#pt-eq #pt-nat predecessor (#pt-succ candidate-predecessor))))))
            (order-certificate
              (#pt-app (#pt-use eisenstein-lambda-order ()) number (#pt-succ predecessor)))
            (square-divisor
              (#pt-app
                (#pt-use eisenstein-divides ())
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-numeral 2))
                number)))
          (#pt-construct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-predecessor #pt-nat))
                (#pt-eq #pt-nat (#pt-succ predecessor) (#pt-succ candidate-predecessor))))
            introduce
            (predecessor (#pt-refl #pt-nat (#pt-succ predecessor)))))
        order-exponent)
      given-order
      given-square)))
(#math-definition eisenstein-cubic-residual-pairwise-coprime ()
  (#pt-pi
    (
      (primary-residual (#pt-use eisenstein ()))
      (omega-residual (#pt-use eisenstein ()))
      (square-residual (#pt-use eisenstein ())))
    #pt-prop)
  (#pt-lambda
    (
      (primary-residual (#pt-use eisenstein ()))
      (omega-residual (#pt-use eisenstein ()))
      (square-residual (#pt-use eisenstein ())))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app (#pt-use eisenstein-coprime ()) primary-residual omega-residual)
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app (#pt-use eisenstein-coprime ()) primary-residual square-residual)
        (#pt-app (#pt-use eisenstein-coprime ()) omega-residual square-residual)))))
(#theorem eisenstein-cubic-packet-residuals-coprime
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter third (#pt-use eisenstein ()))
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter primary-order #pt-nat)
    (#parameter third-order #pt-nat)
    (#parameter primary-residual (#pt-use eisenstein ()))
    (#parameter omega-residual (#pt-use eisenstein ()))
    (#parameter square-residual (#pt-use eisenstein ()))
    (#parameter third-residual (#pt-use eisenstein ()))
    (#parameter primary-order-certificate (#pt-app (#pt-use eisenstein-lambda-order ()) (#pt-app (#pt-use eisenstein-add ()) first second) primary-order))
    (#parameter primary-square-divisor (#pt-app (#pt-use eisenstein-divides ()) (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2)) (#pt-app (#pt-use eisenstein-add ()) first second)))
    (#parameter coprime-proof (#pt-app (#pt-use eisenstein-coprime ()) first second))
    (#parameter residual-packet (#pt-app (#pt-use eisenstein-cubic-residual-packet ()) first second third unit primary-order third-order primary-residual omega-residual square-residual third-residual)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-cubic-residual-pairwise-coprime ())
      primary-residual
      omega-residual
      square-residual))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-predecessor #pt-nat))
          (#pt-eq #pt-nat primary-order (#pt-succ candidate-predecessor))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-predecessor #pt-nat))
                (#pt-eq #pt-nat primary-order (#pt-succ candidate-predecessor))))))
        (#pt-app
          (#pt-use eisenstein-cubic-residual-pairwise-coprime ())
          primary-residual
          omega-residual
          square-residual))
      (
        (#pt-lambda
          (
            (predecessor #pt-nat)
            (order-position (#pt-eq #pt-nat primary-order (#pt-succ predecessor))))
          (#pt-app
            (#pt-use conjunction-introduce ())
            (#pt-app (#pt-use eisenstein-coprime ()) primary-residual omega-residual)
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app (#pt-use eisenstein-coprime ()) primary-residual square-residual)
              (#pt-app (#pt-use eisenstein-coprime ()) omega-residual square-residual))
            (#pt-app
              (#pt-use eisenstein-cubic-primary-omega-residuals-coprime ())
              first
              second
              predecessor
              primary-residual
              omega-residual
              (#pt-app
                (#pt-use substitution (0))
                #pt-nat
                (#pt-lambda
                  ((endpoint #pt-nat))
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-add ()) first second)
                    (#pt-app
                      (#pt-use eisenstein-multiply ())
                      (#pt-app
                        (#pt-use eisenstein-power ())
                        (#pt-use eisenstein-lambda ())
                        endpoint)
                      primary-residual)))
                primary-order
                (#pt-succ predecessor)
                order-position
                (#pt-project conjunction 0 residual-packet))
              (#pt-project conjunction 0 (#pt-project conjunction 1 residual-packet))
              coprime-proof)
            (#pt-app
              (#pt-use conjunction-introduce ())
              (#pt-app (#pt-use eisenstein-coprime ()) primary-residual square-residual)
              (#pt-app (#pt-use eisenstein-coprime ()) omega-residual square-residual)
              (#pt-app
                (#pt-use eisenstein-cubic-primary-square-residuals-coprime ())
                first
                second
                predecessor
                primary-residual
                square-residual
                (#pt-app
                  (#pt-use substitution (0))
                  #pt-nat
                  (#pt-lambda
                    ((endpoint #pt-nat))
                    (#pt-app
                      (#pt-use eisenstein-equal ())
                      (#pt-app (#pt-use eisenstein-add ()) first second)
                      (#pt-app
                        (#pt-use eisenstein-multiply ())
                        (#pt-app
                          (#pt-use eisenstein-power ())
                          (#pt-use eisenstein-lambda ())
                          endpoint)
                        primary-residual)))
                  primary-order
                  (#pt-succ predecessor)
                  order-position
                  (#pt-project conjunction 0 residual-packet))
                (#pt-project
                  conjunction
                  0
                  (#pt-project conjunction 1 (#pt-project conjunction 1 residual-packet)))
                coprime-proof)
              (#pt-app
                (#pt-use eisenstein-cubic-rotated-residuals-coprime ())
                first
                second
                omega-residual
                square-residual
                (#pt-project conjunction 0 (#pt-project conjunction 1 residual-packet))
                (#pt-project
                  conjunction
                  0
                  (#pt-project conjunction 1 (#pt-project conjunction 1 residual-packet)))
                coprime-proof)))))
      (#pt-app
        (#pt-use eisenstein-square-divisible-order-predecessor ())
        (#pt-app (#pt-use eisenstein-add ()) first second)
        primary-order
        primary-order-certificate
        primary-square-divisor))))
