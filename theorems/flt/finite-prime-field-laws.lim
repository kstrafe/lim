                  (#pt-project
                    finite-residue
                    0
                    (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus))
                  #pt-zero
                  (#pt-app (#pt-use finite-residue-zero-value ()) modulus positive-modulus)))
              (#pt-app
                (#pt-use symmetry (0))
                #pt-nat
                (#pt-project
                  finite-residue
                  0
                  (#pt-app
                    (#pt-use finite-residue-multiply ())
                    modulus
                    positive-modulus
                    element
                    (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)))
                (#pt-project
                  finite-residue
                  0
                  (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus))
                (#pt-app
                  (#pt-use finite-residue-multiply-zero-right ())
                  modulus
                  positive-modulus
                  element))))
          (#pt-app (#pt-use finite-residue-zero-value ()) modulus positive-modulus))))))
