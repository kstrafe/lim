; Adapted mathematical source: pinned Mathlib Algebra/Ring/Defs.lean
; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean:82-208,409-468.
; Generated by scripts/generate-flt-coordinate-algebra.py; checked native terms.
; The list length is a proved finite support bound: every
; coefficient at length plus any offset equals the actual ring zero.
; The proof is structural, not a supplied support certificate.
(#alias add = ./../fermat_statement.lim::add)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias finite-list-length = ./finite-list-defs.lim::finite-list-length)
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#alias ring-polynomial-coefficient = ./ring-polynomial-data.lim::ring-polynomial-coefficient)
(#theorem ring-polynomial-finite-support
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
  (#statement
    (#pt-pi
      ((support-offset #pt-nat))
      (#pt-app
        (#pt-use ring-equal ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-coefficient ())
          Carrier
          coefficient-ring
          polynomial
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use finite-list-length ()) Carrier polynomial)
            support-offset))
        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
  (#proof
    (#pt-induct
      finite-list
      ()
      (Carrier)
      (#pt-lambda
        ((selected-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
        (#pt-pi
          ((support-offset #pt-nat))
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-coefficient ())
              Carrier
              coefficient-ring
              selected-polynomial
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use finite-list-length ()) Carrier selected-polynomial)
                support-offset))
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
      (
        (#pt-lambda
          ((support-offset #pt-nat))
          (#pt-app
            (#pt-use ring-reflexive ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
        (#pt-lambda
          (
            (multiplication-head Carrier)
            (multiplication-tail (#pt-app (#pt-use finite-list ()) Carrier))
            (multiplication-result
              (#pt-pi
                ((support-offset #pt-nat))
                (#pt-app
                  (#pt-use ring-equal ())
                  Carrier
                  coefficient-ring
                  (#pt-app
                    (#pt-use ring-polynomial-coefficient ())
                    Carrier
                    coefficient-ring
                    multiplication-tail
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use finite-list-length ()) Carrier multiplication-tail)
                      support-offset))
                  (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))))
          (#pt-lambda ((support-offset #pt-nat)) (#pt-app multiplication-result support-offset))))
      polynomial)))
