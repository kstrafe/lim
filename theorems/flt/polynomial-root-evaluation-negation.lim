; Generated by scripts/generate-flt-point-evaluation.py; checked native terms.
; Actual polynomial evaluation preserves
; negation by the proved generic evaluation bridge and inverse law.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias
  polynomial-root-evaluation-bridge
  =
  ./polynomial-root-evaluation-bridge.lim::polynomial-root-evaluation-bridge)
(#alias
  polynomial-root-identity-morphism
  =
  ./polynomial-root-identity-morphism.lim::polynomial-root-identity-morphism)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-evaluation = ./ring-evaluation-data.lim::ring-evaluation)
(#alias ring-evaluation-negate = ./ring-evaluation-negation.lim::ring-evaluation-negate)
(#alias ring-negate = ./commutative-ring-data.lim::ring-negate)
(#alias ring-negate-congruent = ./commutative-ring-data.lim::ring-negate-congruent)
(#alias ring-polynomial-evaluate = ./ring-polynomial-data.lim::ring-polynomial-evaluate)
(#alias ring-polynomial-negate = ./ring-polynomial-data.lim::ring-polynomial-negate)
(#alias ring-symmetric = ./commutative-ring-data.lim::ring-symmetric)
(#alias ring-transitive = ./commutative-ring-data.lim::ring-transitive)
(#theorem polynomial-root-evaluate-negate
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter root Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-evaluate ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-polynomial-negate ()) Carrier coefficient-ring polynomial)
        root)
      (#pt-app
        (#pt-use ring-negate ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring polynomial root))))
  (#proof
    (#pt-app
      (#pt-use ring-transitive ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-evaluate ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-polynomial-negate ()) Carrier coefficient-ring polynomial)
        root)
      (#pt-app
        (#pt-use ring-evaluation ())
        Carrier
        coefficient-ring
        Carrier
        coefficient-ring
        (#pt-app (#pt-use polynomial-root-identity-morphism ()) Carrier coefficient-ring)
        root
        (#pt-app (#pt-use ring-polynomial-negate ()) Carrier coefficient-ring polynomial))
      (#pt-app
        (#pt-use ring-negate ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring polynomial root))
      (#pt-app
        (#pt-use ring-symmetric ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-evaluation ())
          Carrier
          coefficient-ring
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-identity-morphism ()) Carrier coefficient-ring)
          root
          (#pt-app (#pt-use ring-polynomial-negate ()) Carrier coefficient-ring polynomial))
        (#pt-app
          (#pt-use ring-polynomial-evaluate ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-polynomial-negate ()) Carrier coefficient-ring polynomial)
          root)
        (#pt-app
          (#pt-use polynomial-root-evaluation-bridge ())
          Carrier
          coefficient-ring
          root
          (#pt-app (#pt-use ring-polynomial-negate ()) Carrier coefficient-ring polynomial)))
      (#pt-app
        (#pt-use ring-transitive ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-evaluation ())
          Carrier
          coefficient-ring
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-identity-morphism ()) Carrier coefficient-ring)
          root
          (#pt-app (#pt-use ring-polynomial-negate ()) Carrier coefficient-ring polynomial))
        (#pt-app
          (#pt-use ring-negate ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-evaluation ())
            Carrier
            coefficient-ring
            Carrier
            coefficient-ring
            (#pt-app (#pt-use polynomial-root-identity-morphism ()) Carrier coefficient-ring)
            root
            polynomial))
        (#pt-app
          (#pt-use ring-negate ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring polynomial root))
        (#pt-app
          (#pt-use ring-evaluation-negate ())
          Carrier
          coefficient-ring
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-identity-morphism ()) Carrier coefficient-ring)
          root
          polynomial)
        (#pt-app
          (#pt-use ring-negate-congruent ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-evaluation ())
            Carrier
            coefficient-ring
            Carrier
            coefficient-ring
            (#pt-app (#pt-use polynomial-root-identity-morphism ()) Carrier coefficient-ring)
            root
            polynomial)
          (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring polynomial root)
          (#pt-app
            (#pt-use polynomial-root-evaluation-bridge ())
            Carrier
            coefficient-ring
            root
            polynomial))))))
