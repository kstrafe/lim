; Adapted mathematical source: pinned Mathlib RingTheory/Ideal/Operations.lean
; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean.
; Generated by scripts/generate-flt-point-ideal-products.py; checked native terms.
; Kernel identity implies the
; supplied ring equivalence by identity elimination and ring
; reflexivity. This adds no reduction or reflection rule.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#alias substitution = ./equality.lim::substitution)
(#theorem point-ideal-product-from-identity
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter left-value Carrier)
    (#parameter right-value Carrier)
    (#parameter identity (#pt-eq Carrier left-value right-value)))
  (#statement (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring left-value right-value))
  (#proof
    (#pt-app
      (#pt-use substitution (0))
      Carrier
      (#pt-lambda
        ((endpoint Carrier))
        (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring left-value endpoint))
      left-value
      right-value
      identity
      (#pt-app (#pt-use ring-reflexive ()) Carrier coefficient-ring left-value))))
