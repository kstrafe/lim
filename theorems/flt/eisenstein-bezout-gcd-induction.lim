; Constructive strong induction on the second input natural norm.
; Norm zero is the actual zero case; positive norm permits Euclidean
; division. The induction hypothesis is used only at the certified
; strictly smaller remainder norm, retaining actual Bezout coefficients.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias exists = ./logic-exists.lim::exists)
(#alias eisenstein-add = ./eisenstein-defs.lim::eisenstein-add)
(#alias eisenstein-has-bezout-gcd = ./eisenstein-bezout-gcd-defs.lim::eisenstein-has-bezout-gcd)
(#alias
  eisenstein-bezout-gcd-at-norm
  =
  ./eisenstein-bezout-gcd-defs.lim::eisenstein-bezout-gcd-at-norm)
(#alias eisenstein-natural-norm = ./eisenstein-norm-defs.lim::eisenstein-natural-norm)
(#alias
  eisenstein-bezout-gcd-zero-right
  =
  ./eisenstein-bezout-gcd-defs.lim::eisenstein-bezout-gcd-zero-right)
(#alias
  eisenstein-bezout-gcd-euclidean-backward
  =
  ./eisenstein-bezout-gcd-euclidean.lim::eisenstein-bezout-gcd-euclidean-backward)
(#alias
  eisenstein-natural-norm-unique
  =
  ./eisenstein-natural-norm-transport.lim::eisenstein-natural-norm-unique)
(#alias
  eisenstein-zero-implies-norm-zero
  =
  ./eisenstein-norm-nondegenerate.lim::eisenstein-zero-implies-norm-zero)
(#alias
  eisenstein-norm-zero-implies-zero
  =
  ./eisenstein-norm-nondegenerate.lim::eisenstein-norm-zero-implies-zero)
(#alias less-than = ./natural-order.lim::less-than)
(#alias strong-induction = ./natural-order.lim::strong-induction)
(#alias less-than-upper-nonzero = ./natural-small-cases.lim::less-than-upper-nonzero)
(#alias natural-zero-or-positive = ./natural-remainder-complement.lim::natural-zero-or-positive)
(#alias substitution = ./equality.lim::substitution)
(#alias
  eisenstein-euclidean-division-spec
  =
  ./eisenstein-euclidean-division.lim::eisenstein-euclidean-division-spec)
(#alias
  eisenstein-euclidean-division-with-norm-exists
  =
  ./eisenstein-euclidean-division.lim::eisenstein-euclidean-division-with-norm-exists)
(#theorem eisenstein-natural-norm-positive-nonzero
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter natural-norm #pt-nat)
    (#parameter norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) number natural-norm))
    (#parameter positive-norm (#pt-app (#pt-use less-than ()) #pt-zero natural-norm)))
  (#statement
    (#pt-pi
      ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ()))))
      #pt-false))
  (#proof
    (#pt-lambda
      ((number-zero (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ()))))
      (#pt-app
        (#pt-app (#pt-use less-than-upper-nonzero ()) #pt-zero natural-norm positive-norm)
        (#pt-app
          (#pt-use eisenstein-natural-norm-unique ())
          number
          natural-norm
          #pt-zero
          norm-certificate
          (#pt-app (#pt-use eisenstein-zero-implies-norm-zero ()) number number-zero))))))
(#theorem eisenstein-bezout-gcd-division-step
  (#universes)
  (#parameters
    (#parameter divisor-norm #pt-nat)
    (#parameter given-history (#pt-pi ((earlier-norm #pt-nat) (earlier-position (#pt-app (#pt-use less-than ()) earlier-norm divisor-norm))) (#pt-app (#pt-use eisenstein-bezout-gcd-at-norm ()) earlier-norm)))
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter quotient (#pt-use eisenstein ()))
    (#parameter remainder (#pt-use eisenstein ()))
    (#parameter remainder-norm #pt-nat)
    (#parameter division-certificate (#pt-app (#pt-use eisenstein-euclidean-division-spec ()) first second divisor-norm quotient remainder remainder-norm)))
  (#statement (#pt-app (#pt-use eisenstein-has-bezout-gcd ()) first second))
  (#proof
    (#pt-app
      (#pt-use eisenstein-bezout-gcd-euclidean-backward ())
      first
      second
      quotient
      remainder
      (#pt-app
        (#pt-use conjunction-left ())
        (#pt-app
          (#pt-use eisenstein-equal ())
          first
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-multiply ()) second quotient)
            remainder))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app (#pt-use eisenstein-natural-norm ()) remainder remainder-norm)
          (#pt-app (#pt-use less-than ()) remainder-norm divisor-norm))
        division-certificate)
      (#pt-app
        given-history
        remainder-norm
        (#pt-app
          (#pt-use conjunction-right ())
          (#pt-app (#pt-use eisenstein-natural-norm ()) remainder remainder-norm)
          (#pt-app (#pt-use less-than ()) remainder-norm divisor-norm)
          (#pt-app
            (#pt-use conjunction-right ())
            (#pt-app
              (#pt-use eisenstein-equal ())
              first
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-app (#pt-use eisenstein-multiply ()) second quotient)
                remainder))
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app (#pt-use eisenstein-natural-norm ()) remainder remainder-norm)
              (#pt-app (#pt-use less-than ()) remainder-norm divisor-norm))
            division-certificate))
        second
        remainder
        (#pt-app
          (#pt-use conjunction-left ())
          (#pt-app (#pt-use eisenstein-natural-norm ()) remainder remainder-norm)
          (#pt-app (#pt-use less-than ()) remainder-norm divisor-norm)
          (#pt-app
            (#pt-use conjunction-right ())
            (#pt-app
              (#pt-use eisenstein-equal ())
              first
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-app (#pt-use eisenstein-multiply ()) second quotient)
                remainder))
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app (#pt-use eisenstein-natural-norm ()) remainder remainder-norm)
              (#pt-app (#pt-use less-than ()) remainder-norm divisor-norm))
            division-certificate))))))
(#theorem eisenstein-bezout-gcd-positive-step
  (#universes)
  (#parameters
    (#parameter divisor-norm #pt-nat)
    (#parameter given-history (#pt-pi ((earlier-norm #pt-nat) (earlier-position (#pt-app (#pt-use less-than ()) earlier-norm divisor-norm))) (#pt-app (#pt-use eisenstein-bezout-gcd-at-norm ()) earlier-norm)))
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) second divisor-norm))
    (#parameter positive-norm (#pt-app (#pt-use less-than ()) #pt-zero divisor-norm)))
  (#statement (#pt-app (#pt-use eisenstein-has-bezout-gcd ()) first second))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-quotient (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use exists (0))
            (#pt-use eisenstein ())
            (#pt-lambda
              ((candidate-remainder (#pt-use eisenstein ())))
              (#pt-app
                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((candidate-remainder-norm #pt-nat))
                  (#pt-app
                    (#pt-use eisenstein-euclidean-division-spec ())
                    first
                    second
                    divisor-norm
                    candidate-quotient
                    candidate-remainder
                    candidate-remainder-norm)))))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-quotient (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use exists (0))
                  (#pt-use eisenstein ())
                  (#pt-lambda
                    ((candidate-remainder (#pt-use eisenstein ())))
                    (#pt-app
                      (#pt-use exists (0))
                      #pt-nat
                      (#pt-lambda
                        ((candidate-remainder-norm #pt-nat))
                        (#pt-app
                          (#pt-use eisenstein-euclidean-division-spec ())
                          first
                          second
                          divisor-norm
                          candidate-quotient
                          candidate-remainder
                          candidate-remainder-norm)))))))))
        (#pt-app (#pt-use eisenstein-has-bezout-gcd ()) first second))
      (
        (#pt-lambda
          (
            (quotient (#pt-use eisenstein ()))
            (remainder-existence
              (#pt-app
                (#pt-use exists (0))
                (#pt-use eisenstein ())
                (#pt-lambda
                  ((candidate-remainder (#pt-use eisenstein ())))
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((candidate-remainder-norm #pt-nat))
                      (#pt-app
                        (#pt-use eisenstein-euclidean-division-spec ())
                        first
                        second
                        divisor-norm
                        quotient
                        candidate-remainder
                        candidate-remainder-norm)))))))
          (#pt-induct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-remainder (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((candidate-remainder-norm #pt-nat))
                    (#pt-app
                      (#pt-use eisenstein-euclidean-division-spec ())
                      first
                      second
                      divisor-norm
                      quotient
                      candidate-remainder
                      candidate-remainder-norm)))))
            (#pt-lambda
              (
                (eisenstein-certificate
                  (#pt-app
                    (#pt-use exists (0))
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-remainder (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use exists (0))
                        #pt-nat
                        (#pt-lambda
                          ((candidate-remainder-norm #pt-nat))
                          (#pt-app
                            (#pt-use eisenstein-euclidean-division-spec ())
                            first
                            second
                            divisor-norm
                            quotient
                            candidate-remainder
                            candidate-remainder-norm)))))))
              (#pt-app (#pt-use eisenstein-has-bezout-gcd ()) first second))
            (
              (#pt-lambda
                (
                  (remainder (#pt-use eisenstein ()))
                  (remainder-norm-existence
                    (#pt-app
                      (#pt-use exists (0))
                      #pt-nat
                      (#pt-lambda
                        ((candidate-remainder-norm #pt-nat))
                        (#pt-app
                          (#pt-use eisenstein-euclidean-division-spec ())
                          first
                          second
                          divisor-norm
                          quotient
                          remainder
                          candidate-remainder-norm)))))
                (#pt-induct
                  exists
                  (0)
                  (#pt-nat
                    (#pt-lambda
                      ((candidate-remainder-norm #pt-nat))
                      (#pt-app
                        (#pt-use eisenstein-euclidean-division-spec ())
                        first
                        second
                        divisor-norm
                        quotient
                        remainder
                        candidate-remainder-norm)))
                  (#pt-lambda
                    (
                      (certificate
                        (#pt-app
                          (#pt-use exists (0))
                          #pt-nat
                          (#pt-lambda
                            ((candidate-remainder-norm #pt-nat))
                            (#pt-app
                              (#pt-use eisenstein-euclidean-division-spec ())
                              first
                              second
                              divisor-norm
                              quotient
                              remainder
                              candidate-remainder-norm)))))
                    (#pt-app (#pt-use eisenstein-has-bezout-gcd ()) first second))
                  (
                    (#pt-lambda
                      (
                        (remainder-norm #pt-nat)
                        (division-certificate
                          (#pt-app
                            (#pt-use eisenstein-euclidean-division-spec ())
                            first
                            second
                            divisor-norm
                            quotient
                            remainder
                            remainder-norm)))
                      (#pt-app
                        (#pt-use eisenstein-bezout-gcd-division-step ())
                        divisor-norm
                        given-history
                        first
                        second
                        quotient
                        remainder
                        remainder-norm
                        division-certificate)))
                  remainder-norm-existence)))
            remainder-existence)))
      (#pt-app
        (#pt-use eisenstein-euclidean-division-with-norm-exists ())
        first
        second
        divisor-norm
        norm-certificate
        (#pt-app
          (#pt-use eisenstein-natural-norm-positive-nonzero ())
          second
          divisor-norm
          norm-certificate
          positive-norm)))))
(#theorem eisenstein-bezout-gcd-induction-step
  (#universes)
  (#parameters
    (#parameter divisor-norm #pt-nat)
    (#parameter given-history (#pt-pi ((earlier-norm #pt-nat) (earlier-position (#pt-app (#pt-use less-than ()) earlier-norm divisor-norm))) (#pt-app (#pt-use eisenstein-bezout-gcd-at-norm ()) earlier-norm))))
  (#statement (#pt-app (#pt-use eisenstein-bezout-gcd-at-norm ()) divisor-norm))
  (#proof
    (#pt-lambda
      (
        (first (#pt-use eisenstein ()))
        (second (#pt-use eisenstein ()))
        (norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) second divisor-norm)))
      (#pt-app
        (#pt-use disjunction-eliminate ())
        (#pt-eq #pt-nat divisor-norm #pt-zero)
        (#pt-app (#pt-use less-than ()) #pt-zero divisor-norm)
        (#pt-app (#pt-use eisenstein-has-bezout-gcd ()) first second)
        (#pt-lambda
          ((zero-norm (#pt-eq #pt-nat divisor-norm #pt-zero)))
          (#pt-app
            (#pt-use eisenstein-bezout-gcd-zero-right ())
            first
            second
            (#pt-app
              (#pt-use eisenstein-norm-zero-implies-zero ())
              second
              (#pt-app
                (#pt-use substitution (0))
                #pt-nat
                (#pt-lambda
                  ((endpoint #pt-nat))
                  (#pt-app (#pt-use eisenstein-natural-norm ()) second endpoint))
                divisor-norm
                #pt-zero
                zero-norm
                norm-certificate))))
        (#pt-lambda
          ((positive-norm (#pt-app (#pt-use less-than ()) #pt-zero divisor-norm)))
          (#pt-app
            (#pt-use eisenstein-bezout-gcd-positive-step ())
            divisor-norm
            given-history
            first
            second
            norm-certificate
            positive-norm))
        (#pt-app (#pt-use natural-zero-or-positive ()) divisor-norm)))))
(#theorem eisenstein-bezout-gcd-with-norm-exists
  (#universes)
  (#parameters
    (#parameter divisor-norm #pt-nat)
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) second divisor-norm)))
  (#statement (#pt-app (#pt-use eisenstein-has-bezout-gcd ()) first second))
  (#proof
    (#pt-app
      (#pt-app
        (#pt-use strong-induction ())
        (#pt-lambda
          ((norm-index #pt-nat))
          (#pt-app (#pt-use eisenstein-bezout-gcd-at-norm ()) norm-index))
        (#pt-lambda
          (
            (stage #pt-nat)
            (stage-history
              (#pt-pi
                (
                  (earlier-norm #pt-nat)
                  (earlier-position (#pt-app (#pt-use less-than ()) earlier-norm stage)))
                (#pt-app (#pt-use eisenstein-bezout-gcd-at-norm ()) earlier-norm))))
          (#pt-app (#pt-use eisenstein-bezout-gcd-induction-step ()) stage stage-history)))
      divisor-norm
      first
      second
      norm-certificate)))
