; Adapted source: pinned Mathlib Algebra/Polynomial/Degree/Defs.lean
; and Degree/Operations.lean; Affine/Point.lean.
; Generated by scripts/generate-flt-polynomial-degrees.py; checked native terms.
; If the formal tail is zero, the actual Horner product
; equals coefficient scaling. The proof retains arbitrarily many
; trailing zero representatives and uses multiplication congruence.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias ring-polynomial-add = ./ring-polynomial-data.lim::ring-polynomial-add)
(#alias
  ring-polynomial-add-congruent
  =
  ./ring-polynomial-congruence.lim::ring-polynomial-add-congruent)
(#alias ring-polynomial-add-zero = ./ring-polynomial-additive-laws.lim::ring-polynomial-add-zero)
(#alias ring-polynomial-equal = ./ring-polynomial-data.lim::ring-polynomial-equal)
(#alias ring-polynomial-multiply = ./ring-polynomial-data.lim::ring-polynomial-multiply)
(#alias
  ring-polynomial-multiply-congruent
  =
  ./ring-polynomial-multiplication-laws.lim::ring-polynomial-multiply-congruent)
(#alias ring-polynomial-reflexive = ./ring-polynomial-equivalence.lim::ring-polynomial-reflexive)
(#alias ring-polynomial-scale = ./ring-polynomial-data.lim::ring-polynomial-scale)
(#alias ring-polynomial-shift = ./ring-polynomial-data.lim::ring-polynomial-shift)
(#alias
  ring-polynomial-shift-congruent
  =
  ./ring-polynomial-congruence.lim::ring-polynomial-shift-congruent)
(#alias ring-polynomial-shift-nil = ./ring-polynomial-shift-laws.lim::ring-polynomial-shift-nil)
(#alias ring-polynomial-transitive = ./ring-polynomial-equivalence.lim::ring-polynomial-transitive)
(#theorem ring-polynomial-degree-product-constant-head
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter head Carrier)
    (#parameter tail (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter zero-tail (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring tail (#pt-construct finite-list () (Carrier) nil ()))))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-multiply ())
        Carrier
        coefficient-ring
        (#pt-construct finite-list () (Carrier) cons (head tail))
        other-polynomial)
      (#pt-app (#pt-use ring-polynomial-scale ()) Carrier coefficient-ring head other-polynomial)))
  (#proof
    (#pt-app
      (#pt-use ring-polynomial-transitive ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-multiply ())
        Carrier
        coefficient-ring
        (#pt-construct finite-list () (Carrier) cons (head tail))
        other-polynomial)
      (#pt-app
        (#pt-use ring-polynomial-add ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-polynomial-scale ()) Carrier coefficient-ring head other-polynomial)
        (#pt-construct finite-list () (Carrier) nil ()))
      (#pt-app (#pt-use ring-polynomial-scale ()) Carrier coefficient-ring head other-polynomial)
      (#pt-app
        (#pt-use ring-polynomial-add-congruent ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-polynomial-scale ()) Carrier coefficient-ring head other-polynomial)
        (#pt-app
          (#pt-use ring-polynomial-shift ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-multiply ())
            Carrier
            coefficient-ring
            tail
            other-polynomial))
        (#pt-app (#pt-use ring-polynomial-scale ()) Carrier coefficient-ring head other-polynomial)
        (#pt-construct finite-list () (Carrier) nil ())
        (#pt-app
          (#pt-use ring-polynomial-reflexive ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-scale ())
            Carrier
            coefficient-ring
            head
            other-polynomial))
        (#pt-app
          (#pt-use ring-polynomial-transitive ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-shift ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-multiply ())
              Carrier
              coefficient-ring
              tail
              other-polynomial))
          (#pt-app
            (#pt-use ring-polynomial-shift ())
            Carrier
            coefficient-ring
            (#pt-construct finite-list () (Carrier) nil ()))
          (#pt-construct finite-list () (Carrier) nil ())
          (#pt-app
            (#pt-use ring-polynomial-shift-congruent ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-multiply ())
              Carrier
              coefficient-ring
              tail
              other-polynomial)
            (#pt-construct finite-list () (Carrier) nil ())
            (#pt-app
              (#pt-use ring-polynomial-multiply-congruent ())
              Carrier
              coefficient-ring
              tail
              other-polynomial
              (#pt-construct finite-list () (Carrier) nil ())
              other-polynomial
              zero-tail
              (#pt-app
                (#pt-use ring-polynomial-reflexive ())
                Carrier
                coefficient-ring
                other-polynomial)))
          (#pt-app (#pt-use ring-polynomial-shift-nil ()) Carrier coefficient-ring)))
      (#pt-app
        (#pt-use ring-polynomial-add-zero ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-polynomial-scale ()) Carrier coefficient-ring head other-polynomial)))))
