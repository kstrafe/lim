(#alias
  ring-polynomial-degree-witness
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-degree-witness)
(#alias
  ring-polynomial-domain-data
  =
  ./ring-polynomial-domain-data.lim::ring-polynomial-domain-data)
(#alias substitution = ./equality.lim::substitution)
(#alias symmetry = ./equality.lim::symmetry)
(#theorem coordinate-norm-degree-maximum-formula
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter constant-degree #pt-nat)
    (#parameter linear-degree #pt-nat)
    (#parameter constant-certificate (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring polynomial constant-degree))
    (#parameter linear-certificate (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring other-polynomial linear-degree)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-degree-witness ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use coordinate-norm-degree-value ())
        Carrier
        coefficient-ring
        a1
        a2
        a3
        a4
        a6
        polynomial
        other-polynomial)
      (#pt-app
        (#pt-use coordinate-norm-degree-maximum ())
        (#pt-app (#pt-use add ()) constant-degree constant-degree)
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use add ()) linear-degree linear-degree)
          (#pt-numeral 3)))))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app
        (#pt-use exists (0))
        #pt-nat
        (#pt-lambda
          ((gap #pt-nat))
          (#pt-eq #pt-nat (#pt-succ linear-degree) (#pt-app (#pt-use add ()) constant-degree gap))))
      (#pt-app
        (#pt-use exists (0))
        #pt-nat
        (#pt-lambda
          ((gap #pt-nat))
          (#pt-eq
            #pt-nat
            constant-degree
            (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ linear-degree)) gap))))
      (#pt-app
        (#pt-use ring-polynomial-degree-witness ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use coordinate-norm-degree-value ())
          Carrier
          coefficient-ring
          a1
          a2
          a3
          a4
          a6
          polynomial
          other-polynomial)
        (#pt-app
          (#pt-use coordinate-norm-degree-maximum ())
          (#pt-app (#pt-use add ()) constant-degree constant-degree)
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use add ()) linear-degree linear-degree)
            (#pt-numeral 3))))
      (#pt-lambda
        (
          (low-certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((gap #pt-nat))
                (#pt-eq
                  #pt-nat
                  (#pt-succ linear-degree)
                  (#pt-app (#pt-use add ()) constant-degree gap))))))
        (#pt-induct
          exists
          (0)
          (#pt-nat
            (#pt-lambda
              ((gap #pt-nat))
              (#pt-eq
                #pt-nat
                (#pt-succ linear-degree)
                (#pt-app (#pt-use add ()) constant-degree gap))))
          (#pt-lambda
            (
              (low-certificate-bound-0000
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((gap #pt-nat))
                    (#pt-eq
                      #pt-nat
                      (#pt-succ linear-degree)
                      (#pt-app (#pt-use add ()) constant-degree gap))))))
            (#pt-app
              (#pt-use ring-polynomial-degree-witness ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use coordinate-norm-degree-value ())
                Carrier
                coefficient-ring
                a1
                a2
                a3
                a4
                a6
                polynomial
                other-polynomial)
              (#pt-app
                (#pt-use coordinate-norm-degree-maximum ())
                (#pt-app (#pt-use add ()) constant-degree constant-degree)
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use add ()) linear-degree linear-degree)
                  (#pt-numeral 3)))))
          (
            (#pt-lambda
              (
                (gap #pt-nat)
                (low-relation
                  (#pt-eq
                    #pt-nat
                    (#pt-succ linear-degree)
                    (#pt-app (#pt-use add ()) constant-degree gap))))
              (#pt-app
                (#pt-use substitution (0))
                #pt-nat
                (#pt-lambda
                  ((selected-degree #pt-nat))
                  (#pt-app
                    (#pt-use ring-polynomial-degree-witness ())
                    Carrier
                    coefficient-ring
                    (#pt-app
                      (#pt-use coordinate-norm-degree-value ())
                      Carrier
                      coefficient-ring
                      a1
                      a2
                      a3
                      a4
                      a6
                      polynomial
                      other-polynomial)
                    selected-degree))
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use add ()) linear-degree linear-degree)
                  (#pt-numeral 3))
                (#pt-app
                  (#pt-use coordinate-norm-degree-maximum ())
                  (#pt-app (#pt-use add ()) constant-degree constant-degree)
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use add ()) linear-degree linear-degree)
                    (#pt-numeral 3)))
                (#pt-app
                  (#pt-use symmetry (0))
                  #pt-nat
                  (#pt-app
                    (#pt-use coordinate-norm-degree-maximum ())
                    (#pt-app (#pt-use add ()) constant-degree constant-degree)
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use add ()) linear-degree linear-degree)
                      (#pt-numeral 3)))
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use add ()) linear-degree linear-degree)
                    (#pt-numeral 3))
                  (#pt-app
                    (#pt-use coordinate-norm-degree-maximum-strict-right ())
                    (#pt-app (#pt-use add ()) constant-degree constant-degree)
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use add ()) linear-degree linear-degree)
                      (#pt-numeral 3))
                    (#pt-app (#pt-use add ()) gap gap)
                    (#pt-app
                      (#pt-use coordinate-norm-degree-low-square-gap ())
                      constant-degree
                      linear-degree
                      gap
                      low-relation)))
                (#pt-app
                  (#pt-use coordinate-norm-degree-cubic-dominant ())
                  Carrier
                  coefficient-ring
                  coefficient-domain
                  a1
                  a2
                  a3
                  a4
                  a6
                  polynomial
                  other-polynomial
                  constant-degree
                  linear-degree
                  gap
                  constant-certificate
                  linear-certificate
                  low-relation))))
          low-certificate))
      (#pt-lambda
        (
          (high-certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((gap #pt-nat))
                (#pt-eq
                  #pt-nat
                  constant-degree
                  (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ linear-degree)) gap))))))
        (#pt-induct
          exists
          (0)
          (#pt-nat
            (#pt-lambda
              ((gap #pt-nat))
              (#pt-eq
                #pt-nat
                constant-degree
                (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ linear-degree)) gap))))
          (#pt-lambda
            (
              (high-certificate-bound-0001
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((gap #pt-nat))
                    (#pt-eq
                      #pt-nat
                      constant-degree
                      (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ linear-degree)) gap))))))
            (#pt-app
              (#pt-use ring-polynomial-degree-witness ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use coordinate-norm-degree-value ())
                Carrier
                coefficient-ring
                a1
                a2
                a3
                a4
                a6
                polynomial
                other-polynomial)
              (#pt-app
                (#pt-use coordinate-norm-degree-maximum ())
                (#pt-app (#pt-use add ()) constant-degree constant-degree)
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use add ()) linear-degree linear-degree)
                  (#pt-numeral 3)))))
          (
            (#pt-lambda
              (
                (gap #pt-nat)
                (high-relation
                  (#pt-eq
                    #pt-nat
                    constant-degree
                    (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ linear-degree)) gap))))
              (#pt-app
                (#pt-use substitution (0))
                #pt-nat
                (#pt-lambda
                  ((selected-degree #pt-nat))
                  (#pt-app
                    (#pt-use ring-polynomial-degree-witness ())
                    Carrier
                    coefficient-ring
                    (#pt-app
                      (#pt-use coordinate-norm-degree-value ())
                      Carrier
                      coefficient-ring
                      a1
                      a2
                      a3
                      a4
                      a6
                      polynomial
                      other-polynomial)
                    selected-degree))
                (#pt-app (#pt-use add ()) constant-degree constant-degree)
                (#pt-app
                  (#pt-use coordinate-norm-degree-maximum ())
                  (#pt-app (#pt-use add ()) constant-degree constant-degree)
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use add ()) linear-degree linear-degree)
                    (#pt-numeral 3)))
                (#pt-app
                  (#pt-use symmetry (0))
                  #pt-nat
                  (#pt-app
                    (#pt-use coordinate-norm-degree-maximum ())
                    (#pt-app (#pt-use add ()) constant-degree constant-degree)
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use add ()) linear-degree linear-degree)
                      (#pt-numeral 3)))
                  (#pt-app (#pt-use add ()) constant-degree constant-degree)
                  (#pt-app
                    (#pt-use coordinate-norm-degree-maximum-strict-left ())
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use add ()) linear-degree linear-degree)
                      (#pt-numeral 3))
                    (#pt-app (#pt-use add ()) constant-degree constant-degree)
                    (#pt-app (#pt-use add ()) gap gap)
                    (#pt-app
                      (#pt-use coordinate-norm-degree-high-cubic-gap ())
                      constant-degree
                      linear-degree
                      gap
                      high-relation)))
                (#pt-app
                  (#pt-use coordinate-norm-degree-square-dominant ())
                  Carrier
                  coefficient-ring
                  coefficient-domain
                  a1
                  a2
                  a3
                  a4
                  a6
                  polynomial
                  other-polynomial
                  constant-degree
                  linear-degree
                  gap
                  constant-certificate
                  linear-certificate
                  high-relation))))
          high-certificate))
      (#pt-app (#pt-use coordinate-norm-degree-gap-dichotomy ()) constant-degree linear-degree))))
