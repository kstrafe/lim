; Local prime valuations as actual factorization certificates.
; A cofactor is retained with m = q^k * cofactor and q not dividing it.
; Exponents and cofactors are unbounded Nat witnesses in Prop; no oracle.
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias power = ./../fermat_statement.lim::power)
(#alias exists = ./logic-exists.lim::exists)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#math-definition natural-prime-order ()
  (#pt-pi ((prime-number #pt-nat) (number #pt-nat) (valuation #pt-nat)) #pt-prop)
  (#pt-lambda
    ((prime-number #pt-nat) (number #pt-nat) (valuation #pt-nat))
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-cofactor #pt-nat))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-eq
            #pt-nat
            number
            (#pt-app
              (#pt-use multiply ())
              (#pt-app (#pt-use power ()) prime-number valuation)
              candidate-cofactor))
          (#pt-pi
            ((denied-proof (#pt-app (#pt-use divides ()) prime-number candidate-cofactor)))
            #pt-false))))))
