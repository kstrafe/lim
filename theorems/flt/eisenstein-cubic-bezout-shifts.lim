; Checked concrete changes of coordinates for FLT/Three.lean:535-547.
; The actual factor equations and cancellation recover the original
; coordinates inside each pair of residuals. No PID is assumed.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-lambda = ./eisenstein-defs.lim::eisenstein-lambda)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-power = ./eisenstein-defs.lim::eisenstein-power)
(#alias eisenstein-reflexive = ./eisenstein-equality.lim::eisenstein-reflexive)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-congruent = ./eisenstein-equality.lim::eisenstein-multiply-congruent)
(#alias eisenstein-multiply-associative = ./eisenstein-ring.lim::eisenstein-multiply-associative)
(#alias
  eisenstein-lambda-multiply-cancel
  =
  ./eisenstein-lambda-cancellation.lim::eisenstein-lambda-multiply-cancel)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias eisenstein-add = ./eisenstein-defs.lim::eisenstein-add)
(#alias eisenstein-omega = ./eisenstein-defs.lim::eisenstein-omega)
(#alias eisenstein-add-congruent = ./eisenstein-equality.lim::eisenstein-add-congruent)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias eisenstein-multiply-distributive = ./eisenstein-ring.lim::eisenstein-multiply-distributive)
(#alias
  eisenstein-multiply-distribute-second
  =
  ./eisenstein-ring.lim::eisenstein-multiply-distribute-second)
(#alias eisenstein-add-associative = ./eisenstein-ring.lim::eisenstein-add-associative)
(#alias
  eisenstein-cubic-factor-unit-shift
  =
  ./eisenstein-cubic-shifts.lim::eisenstein-cubic-factor-unit-shift)
(#theorem eisenstein-square-root-lambda-difference
  (#universes)
  (#parameters)
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-omega ()) (#pt-numeral 2))
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-use eisenstein-omega ())
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-use eisenstein-lambda ())
          (#pt-use eisenstein-omega ())))))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project
          eisenstein
          0
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-omega ()) (#pt-numeral 2)))
        (#pt-project
          eisenstein
          0
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-use eisenstein-omega ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-use eisenstein-lambda ())
              (#pt-use eisenstein-omega ())))))
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project
          eisenstein
          1
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-omega ()) (#pt-numeral 2)))
        (#pt-project
          eisenstein
          1
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-use eisenstein-omega ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-use eisenstein-lambda ())
              (#pt-use eisenstein-omega ())))))
      (#pt-refl #pt-nat (#pt-succ #pt-zero))
      (#pt-refl #pt-nat (#pt-numeral 2)))))
(#theorem eisenstein-linear-factor-shift
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter base-root (#pt-use eisenstein ()))
    (#parameter root (#pt-use eisenstein ()))
    (#parameter coefficient (#pt-use eisenstein ()))
    (#parameter root-equivalence (#pt-app (#pt-use eisenstein-equal ()) root (#pt-app (#pt-use eisenstein-add ()) base-root (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) coefficient)))))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app
        (#pt-use eisenstein-add ())
        first
        (#pt-app (#pt-use eisenstein-multiply ()) root second))
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app
          (#pt-use eisenstein-add ())
          first
          (#pt-app (#pt-use eisenstein-multiply ()) base-root second))
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-use eisenstein-lambda ())
          (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)))))
  (#proof
    (#pt-app
      (#pt-use eisenstein-transitive ())
      (#pt-app
        (#pt-use eisenstein-add ())
        first
        (#pt-app (#pt-use eisenstein-multiply ()) root second))
      (#pt-app
        (#pt-use eisenstein-add ())
        first
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app
            (#pt-use eisenstein-add ())
            base-root
            (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) coefficient))
          second))
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app
          (#pt-use eisenstein-add ())
          first
          (#pt-app (#pt-use eisenstein-multiply ()) base-root second))
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-use eisenstein-lambda ())
          (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)))
      (#pt-app
        (#pt-use eisenstein-add-congruent ())
        first
        (#pt-app (#pt-use eisenstein-multiply ()) root second)
        first
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app
            (#pt-use eisenstein-add ())
            base-root
            (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) coefficient))
          second)
        (#pt-app (#pt-use eisenstein-reflexive ()) first)
        (#pt-app
          (#pt-use eisenstein-multiply-congruent ())
          root
          second
          (#pt-app
            (#pt-use eisenstein-add ())
            base-root
            (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) coefficient))
          second
          root-equivalence
          (#pt-app (#pt-use eisenstein-reflexive ()) second)))
      (#pt-app
        (#pt-use eisenstein-transitive ())
        (#pt-app
          (#pt-use eisenstein-add ())
          first
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app
              (#pt-use eisenstein-add ())
              base-root
              (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) coefficient))
            second))
        (#pt-app
          (#pt-use eisenstein-add ())
          first
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-multiply ()) base-root second)
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) coefficient)
              second)))
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app
            (#pt-use eisenstein-add ())
            first
            (#pt-app (#pt-use eisenstein-multiply ()) base-root second))
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-use eisenstein-lambda ())
            (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)))
        (#pt-app
          (#pt-use eisenstein-add-congruent ())
          first
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app
              (#pt-use eisenstein-add ())
              base-root
              (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) coefficient))
            second)
          first
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-multiply ()) base-root second)
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) coefficient)
              second))
          (#pt-app (#pt-use eisenstein-reflexive ()) first)
          (#pt-app
            (#pt-use eisenstein-multiply-distributive ())
            base-root
            (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) coefficient)
            second))
        (#pt-app
          (#pt-use eisenstein-transitive ())
          (#pt-app
            (#pt-use eisenstein-add ())
            first
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-multiply ()) base-root second)
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-use eisenstein-lambda ())
                  coefficient)
                second)))
          (#pt-app
            (#pt-use eisenstein-add ())
            first
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-multiply ()) base-root second)
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-use eisenstein-lambda ())
                (#pt-app (#pt-use eisenstein-multiply ()) coefficient second))))
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app
              (#pt-use eisenstein-add ())
              first
              (#pt-app (#pt-use eisenstein-multiply ()) base-root second))
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-use eisenstein-lambda ())
              (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)))
          (#pt-app
            (#pt-use eisenstein-add-congruent ())
            first
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-multiply ()) base-root second)
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-use eisenstein-lambda ())
                  coefficient)
                second))
            first
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-multiply ()) base-root second)
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-use eisenstein-lambda ())
                (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)))
            (#pt-app (#pt-use eisenstein-reflexive ()) first)
            (#pt-app
              (#pt-use eisenstein-add-congruent ())
              (#pt-app (#pt-use eisenstein-multiply ()) base-root second)
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-use eisenstein-lambda ())
                  coefficient)
                second)
              (#pt-app (#pt-use eisenstein-multiply ()) base-root second)
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-use eisenstein-lambda ())
                (#pt-app (#pt-use eisenstein-multiply ()) coefficient second))
              (#pt-app
                (#pt-use eisenstein-reflexive ())
                (#pt-app (#pt-use eisenstein-multiply ()) base-root second))
              (#pt-app
                (#pt-use eisenstein-multiply-associative ())
                (#pt-use eisenstein-lambda ())
                coefficient
                second)))
          (#pt-app
            (#pt-use eisenstein-symmetric ())
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app
                (#pt-use eisenstein-add ())
                first
                (#pt-app (#pt-use eisenstein-multiply ()) base-root second))
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-use eisenstein-lambda ())
                (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)))
            (#pt-app
              (#pt-use eisenstein-add ())
              first
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-app (#pt-use eisenstein-multiply ()) base-root second)
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-app (#pt-use eisenstein-multiply ()) coefficient second))))
            (#pt-app
              (#pt-use eisenstein-add-associative ())
              first
              (#pt-app (#pt-use eisenstein-multiply ()) base-root second)
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-use eisenstein-lambda ())
                (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)))))))))
(#theorem eisenstein-lambda-residual-add
  (#universes)
  (#parameters
    (#parameter primary (#pt-use eisenstein ()))
    (#parameter shifted (#pt-use eisenstein ()))
    (#parameter primary-residual (#pt-use eisenstein ()))
    (#parameter shifted-residual (#pt-use eisenstein ()))
    (#parameter shift (#pt-use eisenstein ()))
    (#parameter primary-equivalence (#pt-app (#pt-use eisenstein-equal ()) primary (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) primary-residual)))
    (#parameter shifted-equivalence (#pt-app (#pt-use eisenstein-equal ()) shifted (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) shifted-residual)))
    (#parameter shift-equivalence (#pt-app (#pt-use eisenstein-equal ()) shifted (#pt-app (#pt-use eisenstein-add ()) primary (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) shift)))))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      shifted-residual
      (#pt-app (#pt-use eisenstein-add ()) primary-residual shift)))
  (#proof
    (#pt-app
      (#pt-use eisenstein-lambda-multiply-cancel ())
      shifted-residual
      (#pt-app (#pt-use eisenstein-add ()) primary-residual shift)
      (#pt-app
        (#pt-use eisenstein-transitive ())
        (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) shifted-residual)
        shifted
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-use eisenstein-lambda ())
          (#pt-app (#pt-use eisenstein-add ()) primary-residual shift))
        (#pt-app
          (#pt-use eisenstein-symmetric ())
          shifted
          (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) shifted-residual)
          shifted-equivalence)
        (#pt-app
          (#pt-use eisenstein-transitive ())
          shifted
          (#pt-app
            (#pt-use eisenstein-add ())
            primary
            (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) shift))
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-use eisenstein-lambda ())
            (#pt-app (#pt-use eisenstein-add ()) primary-residual shift))
          shift-equivalence
          (#pt-app
            (#pt-use eisenstein-transitive ())
            (#pt-app
              (#pt-use eisenstein-add ())
              primary
              (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) shift))
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-use eisenstein-lambda ())
                primary-residual)
              (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) shift))
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-use eisenstein-lambda ())
              (#pt-app (#pt-use eisenstein-add ()) primary-residual shift))
            (#pt-app
              (#pt-use eisenstein-add-congruent ())
              primary
              (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) shift)
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-use eisenstein-lambda ())
                primary-residual)
              (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) shift)
              primary-equivalence
              (#pt-app
                (#pt-use eisenstein-reflexive ())
                (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) shift)))
            (#pt-app
              (#pt-use eisenstein-symmetric ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-use eisenstein-lambda ())
                (#pt-app (#pt-use eisenstein-add ()) primary-residual shift))
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-use eisenstein-lambda ())
                  primary-residual)
                (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) shift))
              (#pt-app
                (#pt-use eisenstein-multiply-distribute-second ())
                (#pt-use eisenstein-lambda ())
                primary-residual
                shift))))))))
(#theorem eisenstein-cubic-primary-rotated-residual-shift
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter predecessor #pt-nat)
    (#parameter primary-residual (#pt-use eisenstein ()))
    (#parameter rotated-residual (#pt-use eisenstein ()))
    (#parameter root (#pt-use eisenstein ()))
    (#parameter coefficient (#pt-use eisenstein ()))
    (#parameter primary-equivalence (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-add ()) first second) (#pt-app (#pt-use eisenstein-multiply ()) (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-succ predecessor)) primary-residual)))
    (#parameter rotated-equivalence (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-add ()) first (#pt-app (#pt-use eisenstein-multiply ()) root second)) (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) rotated-residual)))
    (#parameter root-equivalence (#pt-app (#pt-use eisenstein-equal ()) root (#pt-app (#pt-use eisenstein-add ()) (#pt-use eisenstein-one ()) (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) coefficient)))))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      rotated-residual
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) predecessor)
          primary-residual)
        (#pt-app (#pt-use eisenstein-multiply ()) coefficient second))))
  (#proof
    (#pt-app
      (#pt-use eisenstein-lambda-residual-add ())
      (#pt-app (#pt-use eisenstein-add ()) first second)
      (#pt-app
        (#pt-use eisenstein-add ())
        first
        (#pt-app (#pt-use eisenstein-multiply ()) root second))
      (#pt-app
        (#pt-use eisenstein-multiply ())
        (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) predecessor)
        primary-residual)
      rotated-residual
      (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)
      (#pt-app
        (#pt-use eisenstein-transitive ())
        (#pt-app (#pt-use eisenstein-add ()) first second)
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app
            (#pt-use eisenstein-power ())
            (#pt-use eisenstein-lambda ())
            (#pt-succ predecessor))
          primary-residual)
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-use eisenstein-lambda ())
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) predecessor)
            primary-residual))
        primary-equivalence
        (#pt-app
          (#pt-use eisenstein-multiply-associative ())
          (#pt-use eisenstein-lambda ())
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) predecessor)
          primary-residual))
      rotated-equivalence
      (#pt-app
        (#pt-use eisenstein-cubic-factor-unit-shift ())
        first
        second
        root
        coefficient
        root-equivalence))))
(#theorem eisenstein-cubic-rotated-pair-residual-shift
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter omega-residual (#pt-use eisenstein ()))
    (#parameter square-residual (#pt-use eisenstein ()))
    (#parameter omega-equivalence (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-add ()) first (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-omega ()) second)) (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) omega-residual)))
    (#parameter square-equivalence (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-add ()) first (#pt-app (#pt-use eisenstein-multiply ()) (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-omega ()) (#pt-numeral 2)) second)) (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) square-residual))))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      square-residual
      (#pt-app
        (#pt-use eisenstein-add ())
        omega-residual
        (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-omega ()) second))))
  (#proof
    (#pt-app
      (#pt-use eisenstein-lambda-residual-add ())
      (#pt-app
        (#pt-use eisenstein-add ())
        first
        (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-omega ()) second))
      (#pt-app
        (#pt-use eisenstein-add ())
        first
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-omega ()) (#pt-numeral 2))
          second))
      omega-residual
      square-residual
      (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-omega ()) second)
      omega-equivalence
      square-equivalence
      (#pt-app
        (#pt-use eisenstein-linear-factor-shift ())
        first
        second
        (#pt-use eisenstein-omega ())
        (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-omega ()) (#pt-numeral 2))
        (#pt-use eisenstein-omega ())
        (#pt-use eisenstein-square-root-lambda-difference ())))))
