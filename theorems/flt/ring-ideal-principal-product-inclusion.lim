; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Eliminate the two actual principal
; membership witnesses and multiply their coefficients. Product
; minimality then proves the forward inclusion without assuming
; divisibility or a principal-product identity.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias exists = ./logic-exists.lim::exists)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-ideal-member = ./ring-ideal-data.lim::ring-ideal-member)
(#alias ring-ideal-principal = ./ring-ideal-principal.lim::ring-ideal-principal)
(#alias ring-ideal-principal-member = ./ring-ideal-principal.lim::ring-ideal-principal-member)
(#alias
  ring-ideal-principal-product-reorder
  =
  ./ring-ideal-principal-product-reorder.lim::ring-ideal-principal-product-reorder)
(#alias ring-ideal-product = ./ring-ideal-product.lim::ring-ideal-product)
(#alias ring-ideal-product-least = ./ring-ideal-product.lim::ring-ideal-product-least)
(#alias ring-ideal-subset = ./ring-ideal-data.lim::ring-ideal-subset)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-multiply-congruent = ./commutative-ring-data.lim::ring-multiply-congruent)
(#alias ring-transitive = ./commutative-ring-data.lim::ring-transitive)
(#theorem ring-ideal-principal-product-inclusion
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-element Carrier)
    (#parameter second-element Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
        (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element))
      (#pt-app
        (#pt-use ring-ideal-principal ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element second-element))))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-product-least ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
      (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element)
      (#pt-app
        (#pt-use ring-ideal-principal ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element second-element))
      (#pt-lambda
        (
          (left-value Carrier)
          (right-value Carrier)
          (left-member
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
              left-value))
          (right-member
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element)
              right-value)))
        (#pt-induct
          exists
          (0)
          (Carrier
            (#pt-lambda
              ((multiplier Carrier))
              (#pt-app
                (#pt-use ring-equal ())
                Carrier
                coefficient-ring
                left-value
                (#pt-app
                  (#pt-use ring-multiply ())
                  Carrier
                  coefficient-ring
                  multiplier
                  first-element))))
          (#pt-lambda
            (
              (principal-certificate
                (#pt-app
                  (#pt-use ring-ideal-principal-member ())
                  Carrier
                  coefficient-ring
                  first-element
                  left-value)))
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-ideal-principal ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-multiply ())
                  Carrier
                  coefficient-ring
                  first-element
                  second-element))
              (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring left-value right-value)))
          (
            (#pt-lambda
              (
                (first-coefficient Carrier)
                (left-equation
                  (#pt-app
                    (#pt-use ring-equal ())
                    Carrier
                    coefficient-ring
                    left-value
                    (#pt-app
                      (#pt-use ring-multiply ())
                      Carrier
                      coefficient-ring
                      first-coefficient
                      first-element))))
              (#pt-induct
                exists
                (0)
                (Carrier
                  (#pt-lambda
                    ((multiplier Carrier))
                    (#pt-app
                      (#pt-use ring-equal ())
                      Carrier
                      coefficient-ring
                      right-value
                      (#pt-app
                        (#pt-use ring-multiply ())
                        Carrier
                        coefficient-ring
                        multiplier
                        second-element))))
                (#pt-lambda
                  (
                    (principal-certificate
                      (#pt-app
                        (#pt-use ring-ideal-principal-member ())
                        Carrier
                        coefficient-ring
                        second-element
                        right-value)))
                  (#pt-app
                    (#pt-use ring-ideal-member ())
                    Carrier
                    coefficient-ring
                    (#pt-app
                      (#pt-use ring-ideal-principal ())
                      Carrier
                      coefficient-ring
                      (#pt-app
                        (#pt-use ring-multiply ())
                        Carrier
                        coefficient-ring
                        first-element
                        second-element))
                    (#pt-app
                      (#pt-use ring-multiply ())
                      Carrier
                      coefficient-ring
                      left-value
                      right-value)))
                (
                  (#pt-lambda
                    (
                      (second-coefficient Carrier)
                      (right-equation
                        (#pt-app
                          (#pt-use ring-equal ())
                          Carrier
                          coefficient-ring
                          right-value
                          (#pt-app
                            (#pt-use ring-multiply ())
                            Carrier
                            coefficient-ring
                            second-coefficient
                            second-element))))
                    (#pt-construct
                      exists
                      (0)
                      (Carrier
                        (#pt-lambda
                          ((multiplier Carrier))
                          (#pt-app
                            (#pt-use ring-equal ())
                            Carrier
                            coefficient-ring
                            (#pt-app
                              (#pt-use ring-multiply ())
                              Carrier
                              coefficient-ring
                              left-value
                              right-value)
                            (#pt-app
                              (#pt-use ring-multiply ())
                              Carrier
                              coefficient-ring
                              multiplier
                              (#pt-app
                                (#pt-use ring-multiply ())
                                Carrier
                                coefficient-ring
                                first-element
                                second-element)))))
                      introduce
                      (
                        (#pt-app
                          (#pt-use ring-multiply ())
                          Carrier
                          coefficient-ring
                          first-coefficient
                          second-coefficient)
                        (#pt-app
                          (#pt-use ring-transitive ())
                          Carrier
                          coefficient-ring
                          (#pt-app
                            (#pt-use ring-multiply ())
                            Carrier
                            coefficient-ring
                            left-value
                            right-value)
                          (#pt-app
                            (#pt-use ring-multiply ())
                            Carrier
                            coefficient-ring
                            (#pt-app
                              (#pt-use ring-multiply ())
                              Carrier
                              coefficient-ring
                              first-coefficient
                              first-element)
                            (#pt-app
                              (#pt-use ring-multiply ())
                              Carrier
                              coefficient-ring
                              second-coefficient
                              second-element))
                          (#pt-app
                            (#pt-use ring-multiply ())
                            Carrier
                            coefficient-ring
                            (#pt-app
                              (#pt-use ring-multiply ())
                              Carrier
                              coefficient-ring
                              first-coefficient
                              second-coefficient)
                            (#pt-app
                              (#pt-use ring-multiply ())
                              Carrier
                              coefficient-ring
                              first-element
                              second-element))
                          (#pt-app
                            (#pt-use ring-multiply-congruent ())
                            Carrier
                            coefficient-ring
                            left-value
                            right-value
                            (#pt-app
                              (#pt-use ring-multiply ())
                              Carrier
                              coefficient-ring
                              first-coefficient
                              first-element)
                            (#pt-app
                              (#pt-use ring-multiply ())
                              Carrier
                              coefficient-ring
                              second-coefficient
                              second-element)
                            left-equation
                            right-equation)
                          (#pt-app
                            (#pt-use ring-ideal-principal-product-reorder ())
                            Carrier
                            coefficient-ring
                            first-coefficient
                            first-element
                            second-coefficient
                            second-element))))))
                right-member)))
          left-member)))))
