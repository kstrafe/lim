      (#pt-app (#pt-use polynomial-root-kernel ()) Carrier coefficient-ring root)
      (#pt-app
        (#pt-use ring-ideal-principal ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root))))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-ideal-subset ())
