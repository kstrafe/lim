; Natural-number formulation of the stronger fourth-power/square equation.
; A counterexample has nonzero a,b and a^4+b^4=c^2; c nonzero is derived.
; This is the positive-Nat adaptation of Mathlib FLT/Four.lean's Fermat42.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias power = ../fermat_statement.lim::power)
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias multiply-nonzero = ./natural-nonzero.lim::multiply-nonzero)
(#alias add-nonzero-left = ./natural-nonzero.lim::add-nonzero-left)
(#alias multiply-one-right = ./natural-multiplication-right.lim::multiply-one-right)
(#alias power-multiply = ./natural-powers.lim::power-multiply)
(#alias add-commutative = ./natural-addition.lim::add-commutative)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias congruence = ./equality.lim::congruence)
(#math-definition quartic ()
  (#pt-pi ((number #pt-nat)) #pt-nat)
  (#pt-lambda
    ((number #pt-nat))
    (#pt-app
      (#pt-use multiply ())
      (#pt-app (#pt-use multiply ()) number number)
      (#pt-app (#pt-use multiply ()) number number))))
(#math-inductive fermat-four-two ()
  ((first #pt-nat) (second #pt-nat) (hypotenuse #pt-nat))
  #pt-prop
  (
    (introduce
      (
        (first-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat first #pt-zero))) #pt-false))
        (second-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat second #pt-zero))) #pt-false))
        (equation
          (#pt-eq
            #pt-nat
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use quartic ()) first)
              (#pt-app (#pt-use quartic ()) second))
            (#pt-app (#pt-use multiply ()) hypotenuse hypotenuse)))))))
(#math-definition four-two-counterexample-at ()
  (#pt-pi ((hypotenuse #pt-nat)) #pt-prop)
  (#pt-lambda
    ((hypotenuse #pt-nat))
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-first #pt-nat))
        (#pt-app
          (#pt-use exists (0))
          #pt-nat
          (#pt-lambda
            ((candidate-second #pt-nat))
            (#pt-app (#pt-use fermat-four-two ()) candidate-first candidate-second hypotenuse)))))))
(#math-definition four-two-smaller-than ()
  (#pt-pi ((bound #pt-nat)) #pt-prop)
  (#pt-lambda
    ((bound #pt-nat))
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-first #pt-nat))
        (#pt-app
          (#pt-use exists (0))
          #pt-nat
          (#pt-lambda
            ((candidate-second #pt-nat))
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-hypotenuse #pt-nat))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use fermat-four-two ())
                    candidate-first
                    candidate-second
                    candidate-hypotenuse)
                  (#pt-app (#pt-use less-than ()) candidate-hypotenuse bound))))))))))
(#theorem quartic-nonzero
  (#universes)
  (#parameters
    (#parameter number #pt-nat)
    (#parameter nonzero-proof (#pt-pi ((denied-proof (#pt-eq #pt-nat number #pt-zero))) #pt-false)))
  (#statement
    (#pt-pi
      ((denied-proof (#pt-eq #pt-nat (#pt-app (#pt-use quartic ()) number) #pt-zero)))
      #pt-false))
  (#proof
    (#pt-app
      (#pt-use multiply-nonzero ())
      (#pt-app (#pt-use multiply ()) number number)
      (#pt-app (#pt-use multiply ()) number number)
      (#pt-app (#pt-use multiply-nonzero ()) number number nonzero-proof nonzero-proof)
      (#pt-app (#pt-use multiply-nonzero ()) number number nonzero-proof nonzero-proof))))
(#theorem four-two-hypotenuse-nonzero
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter hypotenuse #pt-nat)
    (#parameter counterexample (#pt-app (#pt-use fermat-four-two ()) first second hypotenuse)))
  (#statement (#pt-pi ((denied-proof (#pt-eq #pt-nat hypotenuse #pt-zero))) #pt-false))
  (#proof
    (#pt-lambda
      ((zero-equation (#pt-eq #pt-nat hypotenuse #pt-zero)))
      (#pt-app
        (#pt-app
          (#pt-use add-nonzero-left ())
          (#pt-app (#pt-use quartic ()) first)
          (#pt-app (#pt-use quartic ()) second)
          (#pt-app
            (#pt-use quartic-nonzero ())
            first
            (#pt-project fermat-four-two 0 counterexample)))
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use quartic ()) first)
            (#pt-app (#pt-use quartic ()) second))
          (#pt-app (#pt-use multiply ()) hypotenuse hypotenuse)
          (#pt-app (#pt-use multiply ()) #pt-zero #pt-zero)
          (#pt-project fermat-four-two 2 counterexample)
          (#pt-app
            (#pt-use congruence (0 0))
            #pt-nat
            #pt-nat
            (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use multiply ()) endpoint endpoint))
            hypotenuse
            #pt-zero
            zero-equation))))))
(#theorem four-two-swap
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter hypotenuse #pt-nat)
    (#parameter counterexample (#pt-app (#pt-use fermat-four-two ()) first second hypotenuse)))
  (#statement (#pt-app (#pt-use fermat-four-two ()) second first hypotenuse))
  (#proof
    (#pt-construct
      fermat-four-two
      ()
      (second first hypotenuse)
      introduce
      (
        (#pt-project fermat-four-two 1 counterexample)
        (#pt-project fermat-four-two 0 counterexample)
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use quartic ()) second)
            (#pt-app (#pt-use quartic ()) first))
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use quartic ()) first)
            (#pt-app (#pt-use quartic ()) second))
          (#pt-app (#pt-use multiply ()) hypotenuse hypotenuse)
          (#pt-app
            (#pt-use add-commutative ())
            (#pt-app (#pt-use quartic ()) second)
            (#pt-app (#pt-use quartic ()) first))
          (#pt-project fermat-four-two 2 counterexample))))))
(#theorem power-two-as-square
  (#universes)
  (#parameters
    (#parameter number #pt-nat))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use power ()) number (#pt-succ (#pt-succ #pt-zero)))
      (#pt-app (#pt-use multiply ()) number number)))
  (#proof
    (#pt-app
      (#pt-use congruence (0 0))
      #pt-nat
      #pt-nat
      (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use multiply ()) number endpoint))
      (#pt-app (#pt-use multiply ()) number (#pt-succ #pt-zero))
      number
      (#pt-app (#pt-use multiply-one-right ()) number))))
(#theorem power-four-as-quartic
  (#universes)
  (#parameters
    (#parameter number #pt-nat))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use power ()) number (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero)))))
      (#pt-app (#pt-use quartic ()) number)))
  (#proof
    (#pt-app
      (#pt-use transitivity (0))
      #pt-nat
      (#pt-app (#pt-use power ()) number (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero)))))
      (#pt-app
        (#pt-use power ())
        (#pt-app (#pt-use power ()) number (#pt-succ (#pt-succ #pt-zero)))
        (#pt-succ (#pt-succ #pt-zero)))
      (#pt-app
        (#pt-use multiply ())
        (#pt-app (#pt-use multiply ()) number number)
        (#pt-app (#pt-use multiply ()) number number))
      (#pt-app
        (#pt-use power-multiply ())
        number
        (#pt-succ (#pt-succ #pt-zero))
        (#pt-succ (#pt-succ #pt-zero)))
      (#pt-app
        (#pt-use transitivity (0))
        #pt-nat
        (#pt-app
          (#pt-use power ())
          (#pt-app (#pt-use power ()) number (#pt-succ (#pt-succ #pt-zero)))
          (#pt-succ (#pt-succ #pt-zero)))
        (#pt-app
          (#pt-use multiply ())
          (#pt-app (#pt-use power ()) number (#pt-succ (#pt-succ #pt-zero)))
          (#pt-app (#pt-use power ()) number (#pt-succ (#pt-succ #pt-zero))))
        (#pt-app
          (#pt-use multiply ())
          (#pt-app (#pt-use multiply ()) number number)
          (#pt-app (#pt-use multiply ()) number number))
        (#pt-app
          (#pt-use power-two-as-square ())
          (#pt-app (#pt-use power ()) number (#pt-succ (#pt-succ #pt-zero))))
        (#pt-app
          (#pt-use congruence (0 0))
          #pt-nat
          #pt-nat
          (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use multiply ()) endpoint endpoint))
          (#pt-app (#pt-use power ()) number (#pt-succ (#pt-succ #pt-zero)))
          (#pt-app (#pt-use multiply ()) number number)
          (#pt-app (#pt-use power-two-as-square ()) number))))))
