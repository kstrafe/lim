        (#pt-lambda
          (
            (common-divisor #pt-nat)
            (divides-first (#pt-app (#pt-use divides ()) common-divisor divisor))
            (divides-second (#pt-app (#pt-use divides ()) common-divisor remainder)))
          (#pt-app
            (#pt-app
              (#pt-use conjunction-right ())
              (#pt-app (#pt-use divides ()) greatest-divisor divisor)
              (#pt-pi
                (
                  (candidate-common #pt-nat)
                  (candidate-first (#pt-app (#pt-use divides ()) candidate-common dividend))
                  (candidate-second (#pt-app (#pt-use divides ()) candidate-common divisor)))
                (#pt-app (#pt-use divides ()) candidate-common greatest-divisor))
              (#pt-app
                (#pt-use conjunction-right ())
                (#pt-app (#pt-use divides ()) greatest-divisor dividend)
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app (#pt-use divides ()) greatest-divisor divisor)
                  (#pt-pi
                    (
                      (candidate-common #pt-nat)
                      (candidate-first (#pt-app (#pt-use divides ()) candidate-common dividend))
                      (candidate-second (#pt-app (#pt-use divides ()) candidate-common divisor)))
                    (#pt-app (#pt-use divides ()) candidate-common greatest-divisor)))
                original-gcd))
            common-divisor
            (#pt-app
              (#pt-use substitution (0))
              #pt-nat
              (#pt-lambda
                ((endpoint #pt-nat))
                (#pt-app (#pt-use divides ()) common-divisor endpoint))
              (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) quotient divisor) remainder)
              dividend
              (#pt-app
                (#pt-use symmetry (0))
                #pt-nat
                dividend
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) quotient divisor)
                  remainder)
                (#pt-app
                  (#pt-use conjunction-left ())
                  (#pt-eq
                    #pt-nat
                    dividend
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use multiply ()) quotient divisor)
                      remainder))
                  (#pt-app (#pt-use less-than ()) remainder divisor)
                  division-proof))
              (#pt-app
                (#pt-use divides-add ())
                common-divisor
                (#pt-app (#pt-use multiply ()) quotient divisor)
                remainder
                (#pt-app
                  (#pt-use divides-transitive ())
                  common-divisor
                  divisor
                  (#pt-app (#pt-use multiply ()) quotient divisor)
                  divides-first
                  (#pt-app
                    (#pt-use substitution (0))
                    #pt-nat
                    (#pt-lambda
                      ((endpoint #pt-nat))
                      (#pt-app (#pt-use divides ()) divisor endpoint))
                    (#pt-app (#pt-use multiply ()) divisor quotient)
                    (#pt-app (#pt-use multiply ()) quotient divisor)
                    (#pt-app (#pt-use multiply-commutative ()) divisor quotient)
                    (#pt-app (#pt-use divides-multiple ()) divisor quotient)))
                divides-second))
            divides-first))))))
(#theorem gcd-scale-induction-step
  (#universes)
  (#parameters
    (#parameter scale-predecessor #pt-nat)
    (#parameter stage #pt-nat)
    (#parameter given-history (#pt-pi ((earlier #pt-nat) (earlier-proof (#pt-app (#pt-use less-than ()) earlier stage))) (#pt-pi ((number #pt-nat) (candidate #pt-nat) (candidate-proof (#pt-app (#pt-use gcd-spec ()) number earlier candidate))) (#pt-app (#pt-use gcd-spec ()) (#pt-app (#pt-use multiply ()) number (#pt-succ scale-predecessor)) (#pt-app (#pt-use multiply ()) earlier (#pt-succ scale-predecessor)) (#pt-app (#pt-use multiply ()) candidate (#pt-succ scale-predecessor)))))))
  (#statement
    (#pt-pi
      (
        (number #pt-nat)
        (candidate #pt-nat)
        (candidate-proof (#pt-app (#pt-use gcd-spec ()) number stage candidate)))
      (#pt-app
        (#pt-use gcd-spec ())
        (#pt-app (#pt-use multiply ()) number (#pt-succ scale-predecessor))
        (#pt-app (#pt-use multiply ()) stage (#pt-succ scale-predecessor))
        (#pt-app (#pt-use multiply ()) candidate (#pt-succ scale-predecessor)))))
  (#proof
    (#pt-app
      (#pt-nat-induct
        (#pt-lambda
          ((index #pt-nat))
          (#pt-pi
            (
              (stage-history
                (#pt-pi
                  ((earlier #pt-nat) (earlier-proof (#pt-app (#pt-use less-than ()) earlier index)))
                  (#pt-pi
                    (
                      (number #pt-nat)
                      (candidate #pt-nat)
                      (candidate-proof (#pt-app (#pt-use gcd-spec ()) number earlier candidate)))
                    (#pt-app
                      (#pt-use gcd-spec ())
                      (#pt-app (#pt-use multiply ()) number (#pt-succ scale-predecessor))
                      (#pt-app (#pt-use multiply ()) earlier (#pt-succ scale-predecessor))
                      (#pt-app (#pt-use multiply ()) candidate (#pt-succ scale-predecessor)))))))
            (#pt-pi
              (
                (number #pt-nat)
                (candidate #pt-nat)
                (candidate-proof (#pt-app (#pt-use gcd-spec ()) number index candidate)))
              (#pt-app
                (#pt-use gcd-spec ())
                (#pt-app (#pt-use multiply ()) number (#pt-succ scale-predecessor))
                (#pt-app (#pt-use multiply ()) index (#pt-succ scale-predecessor))
                (#pt-app (#pt-use multiply ()) candidate (#pt-succ scale-predecessor))))))
        (#pt-lambda
          (
            (smaller-cases
              (#pt-pi
                (
                  (earlier #pt-nat)
                  (earlier-proof (#pt-app (#pt-use less-than ()) earlier #pt-zero)))
                (#pt-pi
                  (
                    (number #pt-nat)
                    (candidate #pt-nat)
                    (candidate-proof (#pt-app (#pt-use gcd-spec ()) number earlier candidate)))
                  (#pt-app
                    (#pt-use gcd-spec ())
                    (#pt-app (#pt-use multiply ()) number (#pt-succ scale-predecessor))
                    (#pt-app (#pt-use multiply ()) earlier (#pt-succ scale-predecessor))
                    (#pt-app (#pt-use multiply ()) candidate (#pt-succ scale-predecessor))))))
            (number #pt-nat)
            (candidate #pt-nat)
            (candidate-proof (#pt-app (#pt-use gcd-spec ()) number #pt-zero candidate)))
          (#pt-app
            (#pt-use substitution (0))
            #pt-nat
            (#pt-lambda
              ((endpoint #pt-nat))
              (#pt-app
                (#pt-use gcd-spec ())
                (#pt-app (#pt-use multiply ()) number (#pt-succ scale-predecessor))
                #pt-zero
                endpoint))
            (#pt-app (#pt-use multiply ()) number (#pt-succ scale-predecessor))
            (#pt-app (#pt-use multiply ()) candidate (#pt-succ scale-predecessor))
            (#pt-app
              (#pt-use congruence (0 0))
              #pt-nat
              #pt-nat
              (#pt-lambda
                ((factor #pt-nat))
                (#pt-app (#pt-use multiply ()) factor (#pt-succ scale-predecessor)))
              number
              candidate
              (#pt-app
                (#pt-use symmetry (0))
                #pt-nat
                candidate
                number
