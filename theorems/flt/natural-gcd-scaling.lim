          (#pt-app
            (#pt-use substitution (0))
            #pt-nat
            (#pt-lambda
              ((endpoint #pt-nat))
              (#pt-app (#pt-use divides ()) greatest-divisor endpoint))
            dividend
            (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) quotient divisor) remainder)
            (#pt-app
              (#pt-use conjunction-left ())
              (#pt-eq
                #pt-nat
                dividend
