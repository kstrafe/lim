                                  (#pt-use multiply-associative ())
                                  quotient
                                  (#pt-succ previous-divisor)
                                  (#pt-succ scale-predecessor)))))
                          (#pt-app
                            (#pt-use multiply-less-right-successor ())
                            scale-predecessor
                            remainder
                            (#pt-succ previous-divisor)
                            (#pt-app
                              (#pt-use conjunction-right ())
                              (#pt-eq
                                #pt-nat
                                number
                                (#pt-app
                                  (#pt-use add ())
                                  (#pt-app
                                    (#pt-use multiply ())
                                    quotient
                                    (#pt-succ previous-divisor))
                                  remainder))
                              (#pt-app (#pt-use less-than ()) remainder (#pt-succ previous-divisor))
                              division-proof)))
                        (#pt-app (#pt-use multiply ()) candidate (#pt-succ scale-predecessor))
                        (#pt-app
                          smaller-cases
                          remainder
                          (#pt-app
                            (#pt-use conjunction-right ())
                            (#pt-eq
                              #pt-nat
                              number
                              (#pt-app
                                (#pt-use add ())
                                (#pt-app (#pt-use multiply ()) quotient (#pt-succ previous-divisor))
                                remainder))
                            (#pt-app (#pt-use less-than ()) remainder (#pt-succ previous-divisor))
                            division-proof)
                          (#pt-succ previous-divisor)
                          candidate
                          (#pt-app
                            (#pt-use gcd-euclidean-reverse ())
                            number
                            (#pt-succ previous-divisor)
                            quotient
                            remainder
                            division-proof
                            candidate
                            candidate-proof)))))
                  remainder-certificate)))
            (#pt-app
              (#pt-use division-exists ())
              number
              (#pt-succ previous-divisor)
              (#pt-app (#pt-use zero-less-successor ()) previous-divisor))))
        stage)
      given-history)))
(#theorem gcd-scale-right-successor
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter greatest-divisor #pt-nat)
    (#parameter scale-predecessor #pt-nat)
    (#parameter original-gcd (#pt-app (#pt-use gcd-spec ()) first second greatest-divisor)))
  (#statement
    (#pt-app
      (#pt-use gcd-spec ())
      (#pt-app (#pt-use multiply ()) first (#pt-succ scale-predecessor))
      (#pt-app (#pt-use multiply ()) second (#pt-succ scale-predecessor))
      (#pt-app (#pt-use multiply ()) greatest-divisor (#pt-succ scale-predecessor))))
  (#proof
    (#pt-app
      (#pt-app
        (#pt-use strong-induction ())
        (#pt-lambda
          ((index #pt-nat))
          (#pt-pi
            (
              (number #pt-nat)
              (candidate #pt-nat)
              (candidate-proof (#pt-app (#pt-use gcd-spec ()) number index candidate)))
            (#pt-app
              (#pt-use gcd-spec ())
              (#pt-app (#pt-use multiply ()) number (#pt-succ scale-predecessor))
              (#pt-app (#pt-use multiply ()) index (#pt-succ scale-predecessor))
              (#pt-app (#pt-use multiply ()) candidate (#pt-succ scale-predecessor)))))
        (#pt-lambda
          (
            (stage #pt-nat)
            (smaller-cases
              (#pt-pi
                ((earlier #pt-nat) (earlier-proof (#pt-app (#pt-use less-than ()) earlier stage)))
                (#pt-pi
                  (
                    (number #pt-nat)
                    (candidate #pt-nat)
                    (candidate-proof (#pt-app (#pt-use gcd-spec ()) number earlier candidate)))
                  (#pt-app
                    (#pt-use gcd-spec ())
                    (#pt-app (#pt-use multiply ()) number (#pt-succ scale-predecessor))
                    (#pt-app (#pt-use multiply ()) earlier (#pt-succ scale-predecessor))
                    (#pt-app (#pt-use multiply ()) candidate (#pt-succ scale-predecessor)))))))
          (#pt-app (#pt-use gcd-scale-induction-step ()) scale-predecessor stage smaller-cases)))
      second
      first
      greatest-divisor
      original-gcd)))
(#theorem gcd-scale-right
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter greatest-divisor #pt-nat)
    (#parameter scale #pt-nat)
    (#parameter original-gcd (#pt-app (#pt-use gcd-spec ()) first second greatest-divisor)))
  (#statement
    (#pt-app
      (#pt-use gcd-spec ())
      (#pt-app (#pt-use multiply ()) first scale)
      (#pt-app (#pt-use multiply ()) second scale)
      (#pt-app (#pt-use multiply ()) greatest-divisor scale)))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((scale-value #pt-nat))
        (#pt-app
          (#pt-use gcd-spec ())
          (#pt-app (#pt-use multiply ()) first scale-value)
          (#pt-app (#pt-use multiply ()) second scale-value)
          (#pt-app (#pt-use multiply ()) greatest-divisor scale-value)))
      (#pt-app
        (#pt-use substitution (0))
        #pt-nat
        (#pt-lambda
          ((endpoint #pt-nat))
          (#pt-app
            (#pt-use gcd-spec ())
            (#pt-app (#pt-use multiply ()) first #pt-zero)
            (#pt-app (#pt-use multiply ()) second #pt-zero)
            endpoint))
        #pt-zero
        (#pt-app (#pt-use multiply ()) greatest-divisor #pt-zero)
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          (#pt-app (#pt-use multiply ()) greatest-divisor #pt-zero)
          #pt-zero
          (#pt-app (#pt-use multiply-zero-right ()) greatest-divisor))
        (#pt-app
          (#pt-use substitution (0))
          #pt-nat
          (#pt-lambda
            ((endpoint #pt-nat))
            (#pt-app
              (#pt-use gcd-spec ())
              (#pt-app (#pt-use multiply ()) first #pt-zero)
              endpoint
              #pt-zero))
          #pt-zero
          (#pt-app (#pt-use multiply ()) second #pt-zero)
          (#pt-app
            (#pt-use symmetry (0))
            #pt-nat
            (#pt-app (#pt-use multiply ()) second #pt-zero)
            #pt-zero
            (#pt-app (#pt-use multiply-zero-right ()) second))
          (#pt-app
            (#pt-use substitution (0))
            #pt-nat
            (#pt-lambda
              ((endpoint #pt-nat))
              (#pt-app (#pt-use gcd-spec ()) endpoint #pt-zero #pt-zero))
            #pt-zero
            (#pt-app (#pt-use multiply ()) first #pt-zero)
            (#pt-app
              (#pt-use symmetry (0))
              #pt-nat
              (#pt-app (#pt-use multiply ()) first #pt-zero)
              #pt-zero
              (#pt-app (#pt-use multiply-zero-right ()) first))
            (#pt-app (#pt-use gcd-zero-right ()) #pt-zero))))
      (#pt-lambda
        (
          (scale-predecessor #pt-nat)
          (unused-scaled
            (#pt-app
              (#pt-use gcd-spec ())
              (#pt-app (#pt-use multiply ()) first scale-predecessor)
              (#pt-app (#pt-use multiply ()) second scale-predecessor)
              (#pt-app (#pt-use multiply ()) greatest-divisor scale-predecessor))))
        (#pt-app
          (#pt-use gcd-scale-right-successor ())
          first
          second
          greatest-divisor
          scale-predecessor
          original-gcd))
      scale)))
