    (#parameter greatest-divisor #pt-nat)
    (#parameter original-gcd (#pt-app (#pt-use gcd-spec ()) dividend divisor greatest-divisor)))
  (#statement (#pt-app (#pt-use gcd-spec ()) divisor remainder greatest-divisor))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app (#pt-use divides ()) greatest-divisor divisor)
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app (#pt-use divides ()) greatest-divisor remainder)
        (#pt-pi
          (
            (candidate-common #pt-nat)
            (candidate-first (#pt-app (#pt-use divides ()) candidate-common divisor))
            (candidate-second (#pt-app (#pt-use divides ()) candidate-common remainder)))
          (#pt-app (#pt-use divides ()) candidate-common greatest-divisor)))
      (#pt-app
        (#pt-use conjunction-left ())
        (#pt-app (#pt-use divides ()) greatest-divisor divisor)
        (#pt-pi
          (
            (candidate-common #pt-nat)
            (candidate-first (#pt-app (#pt-use divides ()) candidate-common dividend))
            (candidate-second (#pt-app (#pt-use divides ()) candidate-common divisor)))
          (#pt-app (#pt-use divides ()) candidate-common greatest-divisor))
        (#pt-app
          (#pt-use conjunction-right ())
          (#pt-app (#pt-use divides ()) greatest-divisor dividend)
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app (#pt-use divides ()) greatest-divisor divisor)
            (#pt-pi
              (
                (candidate-common #pt-nat)
                (candidate-first (#pt-app (#pt-use divides ()) candidate-common dividend))
                (candidate-second (#pt-app (#pt-use divides ()) candidate-common divisor)))
              (#pt-app (#pt-use divides ()) candidate-common greatest-divisor)))
          original-gcd))
      (#pt-app
        (#pt-use conjunction-introduce ())
        (#pt-app (#pt-use divides ()) greatest-divisor remainder)
        (#pt-pi
          (
            (candidate-common #pt-nat)
            (candidate-first (#pt-app (#pt-use divides ()) candidate-common divisor))
            (candidate-second (#pt-app (#pt-use divides ()) candidate-common remainder)))
          (#pt-app (#pt-use divides ()) candidate-common greatest-divisor))
        (#pt-app
          (#pt-use divides-add-cancel-left ())
          greatest-divisor
          (#pt-app (#pt-use multiply ()) quotient divisor)
          remainder
          (#pt-app
            (#pt-use divides-transitive ())
            greatest-divisor
            divisor
            (#pt-app (#pt-use multiply ()) quotient divisor)
            (#pt-app
