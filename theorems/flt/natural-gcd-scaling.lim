                (#pt-use gcd-spec ())
                (#pt-app (#pt-use multiply ()) number (#pt-succ scale-predecessor))
                (#pt-app
                  (#pt-use multiply ())
                  (#pt-succ previous-divisor)
                  (#pt-succ scale-predecessor))
                (#pt-app (#pt-use multiply ()) candidate (#pt-succ scale-predecessor))))
            (
              (#pt-lambda
                (
                  (quotient #pt-nat)
