              #pt-nat
              (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use divides ()) divisor endpoint))
              (#pt-app (#pt-use multiply ()) divisor quotient)
              (#pt-app (#pt-use multiply ()) quotient divisor)
