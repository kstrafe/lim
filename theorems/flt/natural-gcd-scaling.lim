                  (#pt-use gcd-unique ())
                  number
                  #pt-zero
                  candidate
                  number
                  candidate-proof
                  (#pt-app (#pt-use gcd-zero-right ()) number))))
            (#pt-app
              (#pt-use gcd-zero-right ())
              (#pt-app (#pt-use multiply ()) number (#pt-succ scale-predecessor)))))
        (#pt-lambda
          (
            (previous-divisor #pt-nat)
            (unused-previous
              (#pt-pi
                (
                  (prior-history
                    (#pt-pi
                      (
                        (earlier #pt-nat)
                        (earlier-proof (#pt-app (#pt-use less-than ()) earlier previous-divisor)))
