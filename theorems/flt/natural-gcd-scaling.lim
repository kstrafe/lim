                        (#pt-app
                          (#pt-use conjunction-introduce ())
                          (#pt-eq
                            #pt-nat
                            (#pt-app (#pt-use multiply ()) number (#pt-succ scale-predecessor))
                            (#pt-app
                              (#pt-use add ())
