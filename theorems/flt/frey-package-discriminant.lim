; Source repository: Copyright 2026 Anthropic, PBC; see NOTICE.FLT.
; Extract the actual equation and nonzero coordinates from a Frey
; package and apply the checked exact rational discriminant formula.
; No package existence or refutation is postulated.
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias power = ./../fermat_statement.lim::power)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-power = ./integer-defs.lim::integer-power)
(#alias rational = ./rational-defs.lim::rational)
(#alias rational-equal = ./rational-defs.lim::rational-equal)
(#alias rational-zero = ./rational-defs.lim::rational-zero)
(#alias successor-not-zero = ./natural-nonzero.lim::successor-not-zero)
(#alias
  rational-weierstrass-discriminant
  =
  ./rational-weierstrass-defs.lim::rational-weierstrass-discriminant)
(#alias frey-rational-curve = ./frey-rational-curve.lim::frey-rational-curve)
(#alias power-nonzero = ./natural-nonzero.lim::power-nonzero)
(#alias frey-package-certificate = ./frey-package.lim::frey-package-certificate)
(#alias
  frey-rational-curve-discriminant
  =
  ./frey-discriminant.lim::frey-rational-curve-discriminant)
(#alias
  frey-rational-curve-discriminant-nonzero
  =
  ./frey-discriminant.lim::frey-rational-curve-discriminant-nonzero)
(#theorem frey-package-discriminant
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter package (#pt-app (#pt-use frey-package-certificate ()) exponent first second third)))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-weierstrass-discriminant ())
        (#pt-app (#pt-use frey-rational-curve ()) first second exponent))
      (#pt-construct
        rational
        ()
        ()
        fraction
        (
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-multiply ()) first second)
              third)
            (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent))
          (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-numeral 8))
          (#pt-app
            (#pt-use power-nonzero ())
            (#pt-succ (#pt-succ #pt-zero))
            (#pt-numeral 8)
            (#pt-app (#pt-use successor-not-zero ()) (#pt-numeral 1)))))))
  (#proof
    (#pt-app
      (#pt-use frey-rational-curve-discriminant ())
      first
      second
      third
      exponent
      (#pt-project
        conjunction
        1
        (#pt-project
          conjunction
          1
          (#pt-project
            conjunction
            1
            (#pt-project
              conjunction
              1
              (#pt-project
                conjunction
                1
                (#pt-project
                  conjunction
                  0
                  (#pt-project conjunction 1 (#pt-project conjunction 1 package)))))))))))
(#theorem frey-package-discriminant-nonzero
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter package (#pt-app (#pt-use frey-package-certificate ()) exponent first second third)))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-app
              (#pt-use rational-weierstrass-discriminant ())
              (#pt-app (#pt-use frey-rational-curve ()) first second exponent))
            (#pt-use rational-zero ()))))
      #pt-false))
  (#proof
    (#pt-app
      (#pt-use frey-rational-curve-discriminant-nonzero ())
      first
      second
      third
      exponent
      (#pt-project
        conjunction
        1
        (#pt-project
          conjunction
          1
          (#pt-project
            conjunction
            1
            (#pt-project
              conjunction
              1
              (#pt-project
                conjunction
                1
                (#pt-project
                  conjunction
                  0
                  (#pt-project conjunction 1 (#pt-project conjunction 1 package))))))))
      (#pt-project
        conjunction
        0
        (#pt-project conjunction 0 (#pt-project conjunction 1 (#pt-project conjunction 1 package))))
      (#pt-project
        conjunction
        0
        (#pt-project
          conjunction
          1
          (#pt-project
            conjunction
            0
            (#pt-project conjunction 1 (#pt-project conjunction 1 package)))))
      (#pt-project
        conjunction
        0
        (#pt-project
          conjunction
          1
          (#pt-project
            conjunction
            1
            (#pt-project
              conjunction
              0
              (#pt-project conjunction 1 (#pt-project conjunction 1 package)))))))))
