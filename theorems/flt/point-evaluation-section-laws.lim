(#theorem point-evaluation-section-congruent
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter Image (#pt-type 0))
    (#parameter image-ring (#pt-app (#pt-use commutative-ring ()) Image))
    (#parameter morphism (#pt-app (#pt-use ring-evaluation-morphism ()) Carrier coefficient-ring Image image-ring))
    (#parameter section (#pt-pi ((first-value Image)) Carrier))
    (#parameter section-right-inverse (#pt-pi ((first-value Image)) (#pt-app (#pt-use ring-equal ()) Image image-ring (#pt-app (#pt-use ring-evaluation-map ()) Carrier coefficient-ring Image image-ring morphism (#pt-app section first-value)) first-value)))
    (#parameter first-value Image)
    (#parameter second-value Image)
    (#parameter equation (#pt-app (#pt-use ring-equal ()) Image image-ring first-value second-value)))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      (#pt-app
        (#pt-use point-evaluation-image-ring ())
        Carrier
        coefficient-ring
        Image
        image-ring
        morphism)
      (#pt-app section first-value)
      (#pt-app section second-value)))
  (#proof
    (#pt-app
      (#pt-lambda
        (
          (first-value-bound-0000 Image)
          (second-value-bound-0001 Image)
          (equation-bound-0002
            (#pt-app
              (#pt-use ring-equal ())
              Image
              image-ring
              first-value-bound-0000
              second-value-bound-0001)))
        (#pt-app
          (#pt-use ring-transitive ())
          Image
          image-ring
          (#pt-app
            (#pt-use ring-evaluation-map ())
            Carrier
            coefficient-ring
            Image
            image-ring
            morphism
            (#pt-app section first-value-bound-0000))
          first-value-bound-0000
          (#pt-app
            (#pt-use ring-evaluation-map ())
            Carrier
            coefficient-ring
            Image
            image-ring
            morphism
            (#pt-app section second-value-bound-0001))
          (#pt-app section-right-inverse first-value-bound-0000)
          (#pt-app
            (#pt-use ring-transitive ())
            Image
            image-ring
            first-value-bound-0000
            second-value-bound-0001
            (#pt-app
              (#pt-use ring-evaluation-map ())
              Carrier
              coefficient-ring
              Image
              image-ring
              morphism
              (#pt-app section second-value-bound-0001))
            equation-bound-0002
            (#pt-app
              (#pt-use ring-symmetric ())
              Image
              image-ring
              (#pt-app
                (#pt-use ring-evaluation-map ())
                Carrier
                coefficient-ring
                Image
                image-ring
                morphism
                (#pt-app section second-value-bound-0001))
              second-value-bound-0001
              (#pt-app section-right-inverse second-value-bound-0001)))))
      first-value
      second-value
      equation)))
