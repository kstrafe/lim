; Constructive proposition-valued decisions for every lambda power.
; A divisible branch uses its actual factor; nonzero lambda cancellation
; relates the successor question to the preceding question on that factor.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-lambda = ./eisenstein-defs.lim::eisenstein-lambda)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-power = ./eisenstein-defs.lim::eisenstein-power)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-left = ./logical-connectives.lim::disjunction-left)
(#alias disjunction-right = ./logical-connectives.lim::disjunction-right)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias eisenstein-one-divides = ./eisenstein-divisibility.lim::eisenstein-one-divides)
(#alias
  eisenstein-divides-congruent-target
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-congruent-target)
(#alias
  eisenstein-divides-transitive
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-transitive)
(#alias eisenstein-power-divisor = ./eisenstein-power-divisibility.lim::eisenstein-power-divisor)
(#alias
  eisenstein-power-divides-product-raise
  =
  ./eisenstein-power-divisibility.lim::eisenstein-power-divides-product-raise)
(#alias
  eisenstein-lambda-power-divides-product-cancel
  =
  ./eisenstein-lambda-cancellation.lim::eisenstein-lambda-power-divides-product-cancel)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-lambda-nonzero = ./eisenstein-constants.lim::eisenstein-lambda-nonzero)
(#alias
  eisenstein-lambda-divisibility-decided
  =
  ./eisenstein-lambda-decision-core.lim::eisenstein-lambda-divisibility-decided)
(#alias exists = ./logic-exists.lim::exists)
(#theorem eisenstein-lambda-power-divisibility-decided
  (#universes)
  (#parameters
    (#parameter exponent #pt-nat)
    (#parameter input-number (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app
        (#pt-use eisenstein-divides ())
        (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) exponent)
        input-number)
      (#pt-pi
        (
          (denied-proof
            (#pt-app
              (#pt-use eisenstein-divides ())
              (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) exponent)
              input-number)))
        #pt-false)))
  (#proof
    (#pt-app
      (#pt-nat-induct
        (#pt-lambda
          ((index #pt-nat))
          (#pt-pi
            ((number (#pt-use eisenstein ())))
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app
                (#pt-use eisenstein-divides ())
                (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) index)
                number)
              (#pt-pi
                (
                  (denied-proof
                    (#pt-app
                      (#pt-use eisenstein-divides ())
                      (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) index)
                      number)))
                #pt-false))))
        (#pt-lambda
          ((number (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use disjunction-left ())
            (#pt-app
              (#pt-use eisenstein-divides ())
              (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) #pt-zero)
              number)
            (#pt-pi
              (
                (denied-proof
                  (#pt-app
                    (#pt-use eisenstein-divides ())
                    (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) #pt-zero)
                    number)))
              #pt-false)
            (#pt-app (#pt-use eisenstein-one-divides ()) number)))
        (#pt-lambda
          (
            (previous #pt-nat)
            (previous-decisions
              (#pt-pi
                ((number (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use disjunction ())
                  (#pt-app
                    (#pt-use eisenstein-divides ())
                    (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) previous)
                    number)
                  (#pt-pi
                    (
                      (denied-proof
                        (#pt-app
                          (#pt-use eisenstein-divides ())
                          (#pt-app
                            (#pt-use eisenstein-power ())
                            (#pt-use eisenstein-lambda ())
                            previous)
                          number)))
                    #pt-false))))
            (number (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use disjunction-eliminate ())
            (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number)
            (#pt-pi
              (
                (denied-proof
                  (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number)))
              #pt-false)
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app
                (#pt-use eisenstein-divides ())
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-succ previous))
                number)
              (#pt-pi
                (
                  (denied-proof
                    (#pt-app
                      (#pt-use eisenstein-divides ())
                      (#pt-app
                        (#pt-use eisenstein-power ())
                        (#pt-use eisenstein-lambda ())
                        (#pt-succ previous))
                      number)))
                #pt-false))
            (#pt-lambda
              (
                (lambda-divides
                  (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number)))
              (#pt-induct
                exists
                (0)
                (
                  (#pt-use eisenstein ())
                  (#pt-lambda
                    ((candidate-factor (#pt-use eisenstein ())))
                    (#pt-app
                      (#pt-use eisenstein-equal ())
                      number
                      (#pt-app
                        (#pt-use eisenstein-multiply ())
                        (#pt-use eisenstein-lambda ())
                        candidate-factor))))
                (#pt-lambda
                  (
                    (eisenstein-certificate
                      (#pt-app
                        (#pt-use exists (0))
                        (#pt-use eisenstein ())
                        (#pt-lambda
                          ((candidate-factor (#pt-use eisenstein ())))
                          (#pt-app
                            (#pt-use eisenstein-equal ())
                            number
                            (#pt-app
                              (#pt-use eisenstein-multiply ())
                              (#pt-use eisenstein-lambda ())
                              candidate-factor))))))
                  (#pt-app
                    (#pt-use disjunction ())
                    (#pt-app
                      (#pt-use eisenstein-divides ())
                      (#pt-app
                        (#pt-use eisenstein-power ())
                        (#pt-use eisenstein-lambda ())
                        (#pt-succ previous))
                      number)
                    (#pt-pi
                      (
                        (denied-proof
                          (#pt-app
                            (#pt-use eisenstein-divides ())
                            (#pt-app
                              (#pt-use eisenstein-power ())
                              (#pt-use eisenstein-lambda ())
                              (#pt-succ previous))
                            number)))
                      #pt-false)))
                (
                  (#pt-lambda
                    (
                      (factor (#pt-use eisenstein ()))
                      (factor-equivalence
                        (#pt-app
                          (#pt-use eisenstein-equal ())
                          number
                          (#pt-app
                            (#pt-use eisenstein-multiply ())
                            (#pt-use eisenstein-lambda ())
                            factor))))
                    (#pt-app
                      (#pt-use disjunction-eliminate ())
                      (#pt-app
                        (#pt-use eisenstein-divides ())
                        (#pt-app
                          (#pt-use eisenstein-power ())
                          (#pt-use eisenstein-lambda ())
                          previous)
                        factor)
                      (#pt-pi
                        (
                          (denied-proof
                            (#pt-app
                              (#pt-use eisenstein-divides ())
                              (#pt-app
                                (#pt-use eisenstein-power ())
                                (#pt-use eisenstein-lambda ())
                                previous)
                              factor)))
                        #pt-false)
                      (#pt-app
                        (#pt-use disjunction ())
                        (#pt-app
                          (#pt-use eisenstein-divides ())
                          (#pt-app
                            (#pt-use eisenstein-power ())
                            (#pt-use eisenstein-lambda ())
                            (#pt-succ previous))
                          number)
                        (#pt-pi
                          (
                            (denied-proof
                              (#pt-app
                                (#pt-use eisenstein-divides ())
                                (#pt-app
                                  (#pt-use eisenstein-power ())
                                  (#pt-use eisenstein-lambda ())
                                  (#pt-succ previous))
                                number)))
                          #pt-false))
                      (#pt-lambda
                        (
                          (previous-power-divides
                            (#pt-app
                              (#pt-use eisenstein-divides ())
                              (#pt-app
                                (#pt-use eisenstein-power ())
                                (#pt-use eisenstein-lambda ())
                                previous)
                              factor)))
                        (#pt-app
                          (#pt-use disjunction-left ())
                          (#pt-app
                            (#pt-use eisenstein-divides ())
                            (#pt-app
                              (#pt-use eisenstein-power ())
                              (#pt-use eisenstein-lambda ())
                              (#pt-succ previous))
                            number)
                          (#pt-pi
                            (
                              (denied-proof
                                (#pt-app
                                  (#pt-use eisenstein-divides ())
                                  (#pt-app
                                    (#pt-use eisenstein-power ())
                                    (#pt-use eisenstein-lambda ())
                                    (#pt-succ previous))
                                  number)))
                            #pt-false)
                          (#pt-app
                            (#pt-use eisenstein-divides-congruent-target ())
                            (#pt-app
                              (#pt-use eisenstein-power ())
                              (#pt-use eisenstein-lambda ())
                              (#pt-succ previous))
                            (#pt-app
                              (#pt-use eisenstein-multiply ())
                              (#pt-use eisenstein-lambda ())
                              factor)
                            number
                            (#pt-app
                              (#pt-use eisenstein-symmetric ())
                              number
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                (#pt-use eisenstein-lambda ())
                                factor)
                              factor-equivalence)
                            (#pt-app
                              (#pt-use eisenstein-power-divides-product-raise ())
                              (#pt-use eisenstein-lambda ())
                              previous
                              factor
                              previous-power-divides))))
                      (#pt-lambda
                        (
                          (previous-power-not-divides
                            (#pt-pi
                              (
                                (denied-proof
                                  (#pt-app
                                    (#pt-use eisenstein-divides ())
                                    (#pt-app
                                      (#pt-use eisenstein-power ())
                                      (#pt-use eisenstein-lambda ())
                                      previous)
                                    factor)))
                              #pt-false)))
                        (#pt-app
                          (#pt-use disjunction-right ())
                          (#pt-app
                            (#pt-use eisenstein-divides ())
                            (#pt-app
                              (#pt-use eisenstein-power ())
                              (#pt-use eisenstein-lambda ())
                              (#pt-succ previous))
                            number)
                          (#pt-pi
                            (
                              (denied-proof
                                (#pt-app
                                  (#pt-use eisenstein-divides ())
                                  (#pt-app
                                    (#pt-use eisenstein-power ())
                                    (#pt-use eisenstein-lambda ())
                                    (#pt-succ previous))
                                  number)))
                            #pt-false)
                          (#pt-lambda
                            (
                              (successor-power-divides
                                (#pt-app
                                  (#pt-use eisenstein-divides ())
                                  (#pt-app
                                    (#pt-use eisenstein-power ())
                                    (#pt-use eisenstein-lambda ())
                                    (#pt-succ previous))
                                  number)))
                            (#pt-app
                              previous-power-not-divides
                              (#pt-app
                                (#pt-use eisenstein-lambda-power-divides-product-cancel ())
                                previous
                                factor
                                (#pt-app
                                  (#pt-use eisenstein-divides-congruent-target ())
                                  (#pt-app
                                    (#pt-use eisenstein-power ())
                                    (#pt-use eisenstein-lambda ())
                                    (#pt-succ previous))
                                  number
                                  (#pt-app
                                    (#pt-use eisenstein-multiply ())
                                    (#pt-use eisenstein-lambda ())
                                    factor)
                                  factor-equivalence
                                  successor-power-divides))))))
                      (#pt-app previous-decisions factor))))
                lambda-divides))
            (#pt-lambda
              (
                (lambda-not-divides
                  (#pt-pi
                    (
                      (denied-proof
                        (#pt-app
                          (#pt-use eisenstein-divides ())
                          (#pt-use eisenstein-lambda ())
                          number)))
                    #pt-false)))
              (#pt-app
                (#pt-use disjunction-right ())
                (#pt-app
                  (#pt-use eisenstein-divides ())
                  (#pt-app
                    (#pt-use eisenstein-power ())
                    (#pt-use eisenstein-lambda ())
                    (#pt-succ previous))
                  number)
                (#pt-pi
                  (
                    (denied-proof
                      (#pt-app
                        (#pt-use eisenstein-divides ())
                        (#pt-app
                          (#pt-use eisenstein-power ())
                          (#pt-use eisenstein-lambda ())
                          (#pt-succ previous))
                        number)))
                  #pt-false)
                (#pt-lambda
                  (
                    (successor-power-divides
                      (#pt-app
                        (#pt-use eisenstein-divides ())
                        (#pt-app
                          (#pt-use eisenstein-power ())
                          (#pt-use eisenstein-lambda ())
                          (#pt-succ previous))
                        number)))
                  (#pt-app
                    lambda-not-divides
                    (#pt-app
                      (#pt-use eisenstein-divides-transitive ())
                      (#pt-use eisenstein-lambda ())
                      (#pt-app
                        (#pt-use eisenstein-power ())
                        (#pt-use eisenstein-lambda ())
                        (#pt-succ previous))
                      number
                      (#pt-app
                        (#pt-use eisenstein-power-divisor ())
                        (#pt-use eisenstein-lambda ())
                        previous)
                      successor-power-divides)))))
            (#pt-app (#pt-use eisenstein-lambda-divisibility-decided ()) number)))
        exponent)
      input-number)))
