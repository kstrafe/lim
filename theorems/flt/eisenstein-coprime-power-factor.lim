                      step-residual)))))
            (
              (#pt-lambda
                (
                  (quotient (#pt-use eisenstein ()))
                  (single-certificate
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app
                        (#pt-use eisenstein-equal ())
                        step-first
                        (#pt-app (#pt-use eisenstein-multiply ()) factor quotient))
                      (#pt-app
                        (#pt-use eisenstein-equal ())
