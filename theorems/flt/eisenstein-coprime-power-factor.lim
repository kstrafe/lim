                    (#pt-app
                      (#pt-use eisenstein-multiply ())
                      (#pt-app (#pt-use eisenstein-power ()) factor index)
                      candidate-quotient))
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) candidate-quotient second)
                    step-residual))))))
        (#pt-lambda
          (
            (step-first (#pt-use eisenstein ()))
            (step-residual (#pt-use eisenstein ()))
            (step-equation
              (#pt-app
                (#pt-use eisenstein-equal ())
                (#pt-app (#pt-use eisenstein-multiply ()) step-first second)
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app (#pt-use eisenstein-power ()) factor #pt-zero)
                  step-residual))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-quotient (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    step-first
                    (#pt-app
                      (#pt-use eisenstein-multiply ())
                      (#pt-app (#pt-use eisenstein-power ()) factor #pt-zero)
                      candidate-quotient))
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) candidate-quotient second)
                    step-residual))))
            introduce
            (step-first
              (#pt-app
                (#pt-use conjunction-introduce ())
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  step-first
                  (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) step-first))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-multiply ()) step-first second)
                  step-residual)
                (#pt-app
                  (#pt-use eisenstein-symmetric ())
                  (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) step-first)
                  step-first
