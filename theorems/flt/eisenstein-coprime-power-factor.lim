                                      (#pt-succ previous))
                                    final-quotient)
                                  (#pt-app
                                    (#pt-use eisenstein-multiply ())
                                    factor
                                    (#pt-app
                                      (#pt-use eisenstein-multiply ())
                                      (#pt-app (#pt-use eisenstein-power ()) factor previous)
                                      final-quotient))
                                  (#pt-app
                                    (#pt-use eisenstein-multiply-associative ())
                                    factor
                                    (#pt-app (#pt-use eisenstein-power ()) factor previous)
                                    final-quotient))))
                            (#pt-app
                              (#pt-use conjunction-right ())
                              (#pt-app
                                (#pt-use eisenstein-equal ())
                                quotient
                                (#pt-app
                                  (#pt-use eisenstein-multiply ())
                                  (#pt-app (#pt-use eisenstein-power ()) factor previous)
                                  final-quotient))
                              (#pt-app
                                (#pt-use eisenstein-equal ())
                                (#pt-app (#pt-use eisenstein-multiply ()) final-quotient second)
                                step-residual)
                              power-certificate))))))
                  (#pt-app
                    induction-hypothesis
                    quotient
                    step-residual
                    (#pt-app
                      (#pt-use conjunction-right ())
                      (#pt-app
                        (#pt-use eisenstein-equal ())
                        step-first
                        (#pt-app (#pt-use eisenstein-multiply ()) factor quotient))
                      (#pt-app
                        (#pt-use eisenstein-equal ())
                        (#pt-app (#pt-use eisenstein-multiply ()) quotient second)
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          (#pt-app (#pt-use eisenstein-power ()) factor previous)
                          step-residual))
                      single-certificate)))))
            (#pt-app
              (#pt-use eisenstein-coprime-extract-factor ())
              factor
              step-first
              second
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app (#pt-use eisenstein-power ()) factor previous)
                step-residual)
              factor-nonzero
              coprime-certificate
              (#pt-app
                (#pt-use eisenstein-transitive ())
                (#pt-app (#pt-use eisenstein-multiply ()) step-first second)
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app (#pt-use eisenstein-power ()) factor (#pt-succ previous))
                  step-residual)
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  factor
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app (#pt-use eisenstein-power ()) factor previous)
                    step-residual))
                step-equation
                (#pt-app
                  (#pt-use eisenstein-multiply-associative ())
                  factor
                  (#pt-app (#pt-use eisenstein-power ()) factor previous)
                  step-residual)))))
        exponent)
      given-first
      given-residual
      given-equation)))
