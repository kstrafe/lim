; Witness-preserving factor removal for the associated-cube argument.
; Actual coprimality chooses the quotient; nonzero domain cancellation
; preserves its residual equation. Nat induction removes any witnessed
; power, including exponent zero, without choice or factorization axioms.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-power = ./eisenstein-defs.lim::eisenstein-power)
(#alias eisenstein-reflexive = ./eisenstein-equality.lim::eisenstein-reflexive)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-congruent = ./eisenstein-equality.lim::eisenstein-multiply-congruent)
(#alias eisenstein-multiply-commutative = ./eisenstein-ring.lim::eisenstein-multiply-commutative)
(#alias eisenstein-multiply-associative = ./eisenstein-ring.lim::eisenstein-multiply-associative)
(#alias eisenstein-one-multiply = ./eisenstein-cubic-bridge.lim::eisenstein-one-multiply)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias exists = ./logic-exists.lim::exists)
(#alias eisenstein-divides-reflexive = ./eisenstein-divisibility.lim::eisenstein-divides-reflexive)
(#alias
  eisenstein-divides-congruent-target
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-congruent-target)
(#alias
  eisenstein-divides-product-left
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-product-left)
(#alias eisenstein-coprime = ./eisenstein-defs.lim::eisenstein-coprime)
(#alias
  eisenstein-multiply-cancel-first
  =
  ./eisenstein-domain.lim::eisenstein-multiply-cancel-first)
(#alias
  eisenstein-coprime-divides-product
  =
  ./eisenstein-coprime-factors.lim::eisenstein-coprime-divides-product)
(#theorem eisenstein-coprime-extract-factor
  (#universes)
  (#parameters
    (#parameter factor (#pt-use eisenstein ()))
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter residual (#pt-use eisenstein ()))
    (#parameter factor-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) factor (#pt-use eisenstein-zero ())))) #pt-false))
    (#parameter coprime-certificate (#pt-app (#pt-use eisenstein-coprime ()) factor second))
    (#parameter product-equation (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-multiply ()) first second) (#pt-app (#pt-use eisenstein-multiply ()) factor residual))))
  (#statement
    (#pt-app
      (#pt-use exists (0))
      (#pt-use eisenstein ())
      (#pt-lambda
        ((candidate-quotient (#pt-use eisenstein ())))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app
            (#pt-use eisenstein-equal ())
            first
            (#pt-app (#pt-use eisenstein-multiply ()) factor candidate-quotient))
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app (#pt-use eisenstein-multiply ()) candidate-quotient second)
            residual)))))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            first
            (#pt-app (#pt-use eisenstein-multiply ()) factor candidate-factor))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  first
                  (#pt-app (#pt-use eisenstein-multiply ()) factor candidate-factor))))))
        (#pt-app
          (#pt-use exists (0))
          (#pt-use eisenstein ())
          (#pt-lambda
            ((candidate-quotient (#pt-use eisenstein ())))
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app
                (#pt-use eisenstein-equal ())
                first
                (#pt-app (#pt-use eisenstein-multiply ()) factor candidate-quotient))
              (#pt-app
                (#pt-use eisenstein-equal ())
                (#pt-app (#pt-use eisenstein-multiply ()) candidate-quotient second)
                residual)))))
      (
        (#pt-lambda
          (
            (quotient (#pt-use eisenstein ()))
            (first-factor-equation
              (#pt-app
                (#pt-use eisenstein-equal ())
                first
                (#pt-app (#pt-use eisenstein-multiply ()) factor quotient))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-quotient (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    first
                    (#pt-app (#pt-use eisenstein-multiply ()) factor candidate-quotient))
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) candidate-quotient second)
                    residual))))
            introduce
            (quotient
              (#pt-app
                (#pt-use conjunction-introduce ())
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  first
                  (#pt-app (#pt-use eisenstein-multiply ()) factor quotient))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-multiply ()) quotient second)
                  residual)
                first-factor-equation
                (#pt-app
                  (#pt-use eisenstein-multiply-cancel-first ())
                  factor
                  (#pt-app (#pt-use eisenstein-multiply ()) quotient second)
                  residual
                  factor-nonzero
                  (#pt-app
                    (#pt-use eisenstein-transitive ())
                    (#pt-app
                      (#pt-use eisenstein-multiply ())
                      factor
                      (#pt-app (#pt-use eisenstein-multiply ()) quotient second))
                    (#pt-app
                      (#pt-use eisenstein-multiply ())
                      (#pt-app (#pt-use eisenstein-multiply ()) factor quotient)
                      second)
                    (#pt-app (#pt-use eisenstein-multiply ()) factor residual)
                    (#pt-app
                      (#pt-use eisenstein-symmetric ())
                      (#pt-app
                        (#pt-use eisenstein-multiply ())
                        (#pt-app (#pt-use eisenstein-multiply ()) factor quotient)
                        second)
                      (#pt-app
                        (#pt-use eisenstein-multiply ())
                        factor
                        (#pt-app (#pt-use eisenstein-multiply ()) quotient second))
                      (#pt-app (#pt-use eisenstein-multiply-associative ()) factor quotient second))
                    (#pt-app
                      (#pt-use eisenstein-transitive ())
                      (#pt-app
                        (#pt-use eisenstein-multiply ())
                        (#pt-app (#pt-use eisenstein-multiply ()) factor quotient)
                        second)
                      (#pt-app (#pt-use eisenstein-multiply ()) first second)
                      (#pt-app (#pt-use eisenstein-multiply ()) factor residual)
                      (#pt-app
                        (#pt-use eisenstein-multiply-congruent ())
                        (#pt-app (#pt-use eisenstein-multiply ()) factor quotient)
                        second
                        first
                        second
                        (#pt-app
                          (#pt-use eisenstein-symmetric ())
                          first
                          (#pt-app (#pt-use eisenstein-multiply ()) factor quotient)
                          first-factor-equation)
                        (#pt-app (#pt-use eisenstein-reflexive ()) second))
                      product-equation))))))))
      (#pt-app
        (#pt-use eisenstein-coprime-divides-product ())
        factor
        second
        first
        coprime-certificate
        (#pt-app
          (#pt-use eisenstein-divides-congruent-target ())
          factor
          (#pt-app (#pt-use eisenstein-multiply ()) first second)
          (#pt-app (#pt-use eisenstein-multiply ()) second first)
          (#pt-app (#pt-use eisenstein-multiply-commutative ()) first second)
          (#pt-app
            (#pt-use eisenstein-divides-congruent-target ())
            factor
            (#pt-app (#pt-use eisenstein-multiply ()) factor residual)
            (#pt-app (#pt-use eisenstein-multiply ()) first second)
            (#pt-app
              (#pt-use eisenstein-symmetric ())
              (#pt-app (#pt-use eisenstein-multiply ()) first second)
              (#pt-app (#pt-use eisenstein-multiply ()) factor residual)
              product-equation)
            (#pt-app
              (#pt-use eisenstein-divides-product-left ())
              factor
              factor
              residual
              (#pt-app (#pt-use eisenstein-divides-reflexive ()) factor))))))))
(#theorem eisenstein-coprime-extract-power
  (#universes)
  (#parameters
    (#parameter factor (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter exponent #pt-nat)
    (#parameter given-first (#pt-use eisenstein ()))
    (#parameter given-residual (#pt-use eisenstein ()))
    (#parameter factor-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) factor (#pt-use eisenstein-zero ())))) #pt-false))
    (#parameter coprime-certificate (#pt-app (#pt-use eisenstein-coprime ()) factor second))
    (#parameter given-equation (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-multiply ()) given-first second) (#pt-app (#pt-use eisenstein-multiply ()) (#pt-app (#pt-use eisenstein-power ()) factor exponent) given-residual))))
  (#statement
    (#pt-app
      (#pt-use exists (0))
      (#pt-use eisenstein ())
      (#pt-lambda
        ((candidate-quotient (#pt-use eisenstein ())))
