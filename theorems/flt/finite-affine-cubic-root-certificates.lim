                first-x
                (#pt-app
                  (#pt-use finite-cubic-third-x ())
                  modulus
                  positive-modulus
                  cubic-quadratic
                  first-x
                  first-x))
              (#pt-app (#pt-use finite-residue-difference-self ()) modulus positive-modulus first-x))))
        (#pt-app
          (#pt-use finite-residue-add-identity ())
          modulus
          positive-modulus
          (#pt-app
            (#pt-use finite-cubic-derivative ())
            modulus
            positive-modulus
            cubic-quadratic
            cubic-linear
            first-x))))))
(#theorem finite-cubic-stationary-factorization
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter cubic-quadratic (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter cubic-linear (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter cubic-constant (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter first-x (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter first-root (#pt-eq #pt-nat (#pt-project finite-residue 0 (#pt-app (#pt-use finite-cubic-value ()) modulus positive-modulus cubic-quadratic cubic-linear cubic-constant first-x)) (#pt-project finite-residue 0 (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus))))
    (#parameter stationary-root (#pt-eq #pt-nat (#pt-project finite-residue 0 (#pt-app (#pt-use finite-cubic-derivative ()) modulus positive-modulus cubic-quadratic cubic-linear first-x)) (#pt-project finite-residue 0 (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus))))
    (#parameter evaluation-x (#pt-app (#pt-use finite-residue ()) modulus)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-cubic-value ())
          modulus
          positive-modulus
          cubic-quadratic
          cubic-linear
          cubic-constant
          evaluation-x))
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-residue-negate ())
          modulus
          positive-modulus
          (#pt-app
            (#pt-use finite-residue-multiply ())
            modulus
            positive-modulus
            (#pt-app
              (#pt-use finite-residue-multiply ())
              modulus
              positive-modulus
              (#pt-app
                (#pt-use finite-residue-difference ())
                modulus
                positive-modulus
                evaluation-x
                first-x)
              (#pt-app
                (#pt-use finite-residue-difference ())
                modulus
                positive-modulus
                evaluation-x
                first-x))
            (#pt-app
              (#pt-use finite-residue-difference ())
              modulus
              positive-modulus
              evaluation-x
              (#pt-app
                (#pt-use finite-cubic-third-x ())
                modulus
                positive-modulus
                cubic-quadratic
                first-x
                first-x)))))))
  (#proof
    (#pt-app
      (#pt-use finite-cubic-root-factorization ())
      modulus
      positive-modulus
      cubic-quadratic
      cubic-linear
      cubic-constant
      first-x
      first-x
      first-root
      (#pt-app
        (#pt-use transitivity (0))
        #pt-nat
        (#pt-project
          finite-residue
          0
          (#pt-app
            (#pt-use finite-cubic-quotient ())
            modulus
            positive-modulus
            cubic-quadratic
            cubic-linear
            first-x
            first-x))
        (#pt-project
          finite-residue
          0
          (#pt-app
            (#pt-use finite-cubic-derivative ())
            modulus
            positive-modulus
            cubic-quadratic
            cubic-linear
            first-x))
        (#pt-project
          finite-residue
          0
          (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus))
        (#pt-app
          (#pt-use finite-cubic-quotient-diagonal ())
          modulus
          positive-modulus
          cubic-quadratic
          cubic-linear
          first-x)
        stationary-root)
      evaluation-x)))
