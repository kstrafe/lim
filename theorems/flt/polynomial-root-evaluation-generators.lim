; Adapted mathematical source: pinned Mathlib RingTheory/AdjoinRoot.lean
; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean.
; Generated by scripts/generate-flt-point-evaluation.py; checked native terms.
; Compute actual evaluation of constants,
; shifts and X-root. The generator really vanishes, including in
; characteristic two, without assuming root-factor divisibility.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias polynomial-root-divisor = ./polynomial-root-division-data.lim::polynomial-root-divisor)
(#alias ring-add = ./commutative-ring-data.lim::ring-add)
(#alias ring-add-congruent = ./commutative-ring-data.lim::ring-add-congruent)
(#alias ring-add-inverse-left = ./commutative-ring-elementary-laws.lim::ring-add-inverse-left)
(#alias ring-add-zero = ./commutative-ring-data.lim::ring-add-zero)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-multiply-congruent = ./commutative-ring-data.lim::ring-multiply-congruent)
(#alias ring-multiply-one = ./commutative-ring-data.lim::ring-multiply-one)
(#alias ring-multiply-zero = ./commutative-ring-data.lim::ring-multiply-zero)
(#alias ring-negate = ./commutative-ring-data.lim::ring-negate)
(#alias ring-one = ./commutative-ring-data.lim::ring-one)
(#alias ring-polynomial-evaluate = ./ring-polynomial-data.lim::ring-polynomial-evaluate)
(#alias ring-polynomial-shift = ./ring-polynomial-data.lim::ring-polynomial-shift)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#alias ring-transitive = ./commutative-ring-data.lim::ring-transitive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#alias ring-zero-add = ./commutative-ring-elementary-laws.lim::ring-zero-add)
(#theorem polynomial-root-evaluate-constant
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter root Carrier)
    (#parameter first-value Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-evaluate ())
        Carrier
        coefficient-ring
        (#pt-construct
          finite-list
          ()
          (Carrier)
          cons
          (first-value (#pt-construct finite-list () (Carrier) nil ())))
        root)
      first-value))
  (#proof
    (#pt-app
      (#pt-use ring-transitive ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-evaluate ())
        Carrier
        coefficient-ring
        (#pt-construct
          finite-list
          ()
          (Carrier)
          cons
          (first-value (#pt-construct finite-list () (Carrier) nil ())))
        root)
      (#pt-app
        (#pt-use ring-add ())
        Carrier
        coefficient-ring
        first-value
        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
      first-value
      (#pt-app
        (#pt-use ring-add-congruent ())
        Carrier
        coefficient-ring
        first-value
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          root
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
        first-value
        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
        (#pt-app (#pt-use ring-reflexive ()) Carrier coefficient-ring first-value)
        (#pt-app (#pt-use ring-multiply-zero ()) Carrier coefficient-ring root))
      (#pt-app (#pt-use ring-add-zero ()) Carrier coefficient-ring first-value))))
(#theorem polynomial-root-evaluate-shift
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter root Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-evaluate ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-polynomial-shift ()) Carrier coefficient-ring polynomial)
        root)
      (#pt-app
        (#pt-use ring-multiply ())
        Carrier
        coefficient-ring
        root
        (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring polynomial root))))
  (#proof
    (#pt-app
      (#pt-use ring-zero-add ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-multiply ())
        Carrier
        coefficient-ring
        root
        (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring polynomial root)))))
(#theorem polynomial-root-evaluate-divisor
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter root Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-evaluate ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
        root)
      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
  (#proof
    (#pt-app
      (#pt-use ring-transitive ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-evaluate ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
        root)
      (#pt-app
        (#pt-use ring-add ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-negate ()) Carrier coefficient-ring root)
        root)
      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
      (#pt-app
        (#pt-use ring-add-congruent ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-negate ()) Carrier coefficient-ring root)
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          root
          (#pt-app
            (#pt-use ring-polynomial-evaluate ())
            Carrier
            coefficient-ring
            (#pt-construct
              finite-list
              ()
              (Carrier)
              cons
              (
                (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
                (#pt-construct finite-list () (Carrier) nil ())))
            root))
        (#pt-app (#pt-use ring-negate ()) Carrier coefficient-ring root)
        root
        (#pt-app
          (#pt-use ring-reflexive ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-negate ()) Carrier coefficient-ring root))
        (#pt-app
          (#pt-use ring-transitive ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            root
            (#pt-app
              (#pt-use ring-polynomial-evaluate ())
              Carrier
              coefficient-ring
              (#pt-construct
                finite-list
                ()
                (Carrier)
                cons
                (
                  (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
                  (#pt-construct finite-list () (Carrier) nil ())))
              root))
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            root
            (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring))
          root
          (#pt-app
            (#pt-use ring-multiply-congruent ())
            Carrier
            coefficient-ring
            root
            (#pt-app
              (#pt-use ring-polynomial-evaluate ())
              Carrier
              coefficient-ring
              (#pt-construct
                finite-list
                ()
                (Carrier)
                cons
                (
                  (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
                  (#pt-construct finite-list () (Carrier) nil ())))
              root)
            root
            (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
            (#pt-app (#pt-use ring-reflexive ()) Carrier coefficient-ring root)
            (#pt-app
              (#pt-use polynomial-root-evaluate-constant ())
              Carrier
              coefficient-ring
              root
              (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)))
          (#pt-app (#pt-use ring-multiply-one ()) Carrier coefficient-ring root)))
      (#pt-app (#pt-use ring-add-inverse-left ()) Carrier coefficient-ring root))))
