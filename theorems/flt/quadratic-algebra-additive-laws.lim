(#theorem quadratic-symmetric
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-element (#pt-app (#pt-use quadratic-element ()) Carrier))
    (#parameter second-element (#pt-app (#pt-use quadratic-element ()) Carrier))
    (#parameter equation (#pt-app (#pt-use quadratic-equal ()) Carrier coefficient-ring first-element second-element)))
  (#statement
    (#pt-app (#pt-use quadratic-equal ()) Carrier coefficient-ring second-element first-element))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-equal ())
        Carrier
        coefficient-ring
        (#pt-project quadratic-element 0 second-element)
        (#pt-project quadratic-element 0 first-element))
      (#pt-app
        (#pt-use ring-equal ())
        Carrier
        coefficient-ring
        (#pt-project quadratic-element 1 second-element)
        (#pt-project quadratic-element 1 first-element))
      (#pt-app
        (#pt-use ring-symmetric ())
        Carrier
        coefficient-ring
        (#pt-project quadratic-element 0 first-element)
        (#pt-project quadratic-element 0 second-element)
        (#pt-project conjunction 0 equation))
      (#pt-app
        (#pt-use ring-symmetric ())
        Carrier
        coefficient-ring
        (#pt-project quadratic-element 1 first-element)
        (#pt-project quadratic-element 1 second-element)
        (#pt-project conjunction 1 equation)))))
