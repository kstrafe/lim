(#theorem eisenstein-multiply-swap-inner
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter third (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app
        (#pt-use eisenstein-multiply ())
        first
        (#pt-app (#pt-use eisenstein-multiply ()) second third))
      (#pt-app
        (#pt-use eisenstein-multiply ())
        second
        (#pt-app (#pt-use eisenstein-multiply ()) first third))))
  (#proof
    (#pt-app
      (#pt-use eisenstein-transitive ())
      (#pt-app
        (#pt-use eisenstein-multiply ())
        first
        (#pt-app (#pt-use eisenstein-multiply ()) second third))
      (#pt-app
        (#pt-use eisenstein-multiply ())
        (#pt-app (#pt-use eisenstein-multiply ()) first second)
        third)
      (#pt-app
        (#pt-use eisenstein-multiply ())
        second
        (#pt-app (#pt-use eisenstein-multiply ()) first third))
      (#pt-app
        (#pt-use eisenstein-symmetric ())
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app (#pt-use eisenstein-multiply ()) first second)
          third)
        (#pt-app
          (#pt-use eisenstein-multiply ())
          first
          (#pt-app (#pt-use eisenstein-multiply ()) second third))
        (#pt-app (#pt-use eisenstein-multiply-associative ()) first second third))
      (#pt-app
        (#pt-use eisenstein-transitive ())
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app (#pt-use eisenstein-multiply ()) first second)
          third)
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app (#pt-use eisenstein-multiply ()) second first)
          third)
        (#pt-app
          (#pt-use eisenstein-multiply ())
          second
          (#pt-app (#pt-use eisenstein-multiply ()) first third))
        (#pt-app
          (#pt-use eisenstein-multiply-congruent ())
          (#pt-app (#pt-use eisenstein-multiply ()) first second)
          third
          (#pt-app (#pt-use eisenstein-multiply ()) second first)
          third
          (#pt-app (#pt-use eisenstein-multiply-commutative ()) first second)
          (#pt-app (#pt-use eisenstein-reflexive ()) third))
        (#pt-app (#pt-use eisenstein-multiply-associative ()) second first third)))))
(#theorem eisenstein-scale-three-sum
  (#universes)
  (#parameters
    (#parameter scale (#pt-use eisenstein ()))
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter third (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app
        (#pt-use eisenstein-multiply ())
        scale
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app (#pt-use eisenstein-add ()) first second)
          third))
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app (#pt-use eisenstein-multiply ()) scale first)
          (#pt-app (#pt-use eisenstein-multiply ()) scale second))
        (#pt-app (#pt-use eisenstein-multiply ()) scale third))))
  (#proof
    (#pt-app
      (#pt-use eisenstein-transitive ())
      (#pt-app
        (#pt-use eisenstein-multiply ())
        scale
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app (#pt-use eisenstein-add ()) first second)
          third))
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app
          (#pt-use eisenstein-multiply ())
          scale
          (#pt-app (#pt-use eisenstein-add ()) first second))
        (#pt-app (#pt-use eisenstein-multiply ()) scale third))
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app (#pt-use eisenstein-multiply ()) scale first)
          (#pt-app (#pt-use eisenstein-multiply ()) scale second))
        (#pt-app (#pt-use eisenstein-multiply ()) scale third))
      (#pt-app
        (#pt-use eisenstein-multiply-distribute-second ())
        scale
        (#pt-app (#pt-use eisenstein-add ()) first second)
        third)
      (#pt-app
        (#pt-use eisenstein-add-congruent ())
        (#pt-app
          (#pt-use eisenstein-multiply ())
          scale
          (#pt-app (#pt-use eisenstein-add ()) first second))
        (#pt-app (#pt-use eisenstein-multiply ()) scale third)
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app (#pt-use eisenstein-multiply ()) scale first)
          (#pt-app (#pt-use eisenstein-multiply ()) scale second))
        (#pt-app (#pt-use eisenstein-multiply ()) scale third)
        (#pt-app (#pt-use eisenstein-multiply-distribute-second ()) scale first second)
        (#pt-app
          (#pt-use eisenstein-reflexive ())
          (#pt-app (#pt-use eisenstein-multiply ()) scale third))))))
(#theorem eisenstein-three-sum-zero-solve-first
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter third (#pt-use eisenstein ()))
    (#parameter sum-zero (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-add ()) (#pt-app (#pt-use eisenstein-add ()) first second) third) (#pt-use eisenstein-zero ()))))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app (#pt-use eisenstein-add ()) second third)
      (#pt-app (#pt-use eisenstein-negate ()) first)))
  (#proof
    (#pt-app
      (#pt-use eisenstein-add-cancel-left ())
      first
      (#pt-app (#pt-use eisenstein-add ()) second third)
      (#pt-app (#pt-use eisenstein-negate ()) first)
      (#pt-app
        (#pt-use eisenstein-transitive ())
        (#pt-app
          (#pt-use eisenstein-add ())
          first
          (#pt-app (#pt-use eisenstein-add ()) second third))
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app (#pt-use eisenstein-add ()) first second)
          third)
        (#pt-app (#pt-use eisenstein-add ()) first (#pt-app (#pt-use eisenstein-negate ()) first))
        (#pt-app
          (#pt-use eisenstein-symmetric ())
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-add ()) first second)
            third)
          (#pt-app
            (#pt-use eisenstein-add ())
            first
            (#pt-app (#pt-use eisenstein-add ()) second third))
          (#pt-app (#pt-use eisenstein-add-associative ()) first second third))
        (#pt-app
          (#pt-use eisenstein-transitive ())
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-add ()) first second)
            third)
          (#pt-use eisenstein-zero ())
          (#pt-app (#pt-use eisenstein-add ()) first (#pt-app (#pt-use eisenstein-negate ()) first))
          sum-zero
          (#pt-app
            (#pt-use eisenstein-symmetric ())
            (#pt-app
              (#pt-use eisenstein-add ())
              first
              (#pt-app (#pt-use eisenstein-negate ()) first))
            (#pt-use eisenstein-zero ())
            (#pt-app (#pt-use eisenstein-add-inverse ()) first)))))))
