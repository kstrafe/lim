; The exact general Weierstrass negation coordinate, kept separate
; from its polynomial proofs so coordinate users have a small dependency.
(#alias less-than = ./natural-order.lim::less-than)
(#alias finite-residue = ./finite-residue-defs.lim::finite-residue)
(#alias finite-residue-multiply = ./finite-residue-operations.lim::finite-residue-multiply)
(#alias finite-residue-negate = ./finite-residue-negation.lim::finite-residue-negate)
(#alias finite-residue-difference = ./finite-residue-differences.lim::finite-residue-difference)
(#alias finite-weierstrass-curve = ./finite-weierstrass-reduction.lim::finite-weierstrass-curve)
(#math-definition finite-weierstrass-neg-y ()
  (#pt-pi
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
      (x-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
      (y-coordinate (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-app (#pt-use finite-residue ()) modulus))
  (#pt-lambda
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
      (x-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
      (y-coordinate (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-app
      (#pt-use finite-residue-difference ())
      modulus
      positive-modulus
      (#pt-app
        (#pt-use finite-residue-difference ())
        modulus
        positive-modulus
        (#pt-app (#pt-use finite-residue-negate ()) modulus positive-modulus y-coordinate)
        (#pt-app
          (#pt-use finite-residue-multiply ())
          modulus
          positive-modulus
          (#pt-project finite-weierstrass-curve 0 curve)
          x-coordinate))
      (#pt-project finite-weierstrass-curve 2 curve))))
(#theorem finite-weierstrass-neg-y-definition
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
    (#parameter x-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter y-coordinate (#pt-app (#pt-use finite-residue ()) modulus)))
  (#statement
    (#pt-eq
      (#pt-app (#pt-use finite-residue ()) modulus)
      (#pt-app
        (#pt-use finite-weierstrass-neg-y ())
        modulus
        positive-modulus
        curve
        x-coordinate
        y-coordinate)
      (#pt-app
        (#pt-use finite-residue-difference ())
        modulus
        positive-modulus
        (#pt-app
          (#pt-use finite-residue-difference ())
          modulus
          positive-modulus
          (#pt-app (#pt-use finite-residue-negate ()) modulus positive-modulus y-coordinate)
          (#pt-app
            (#pt-use finite-residue-multiply ())
            modulus
            positive-modulus
            (#pt-project finite-weierstrass-curve 0 curve)
            x-coordinate))
        (#pt-project finite-weierstrass-curve 2 curve))))
  (#proof
    (#pt-refl
      (#pt-app (#pt-use finite-residue ()) modulus)
      (#pt-app
        (#pt-use finite-residue-difference ())
        modulus
        positive-modulus
        (#pt-app
          (#pt-use finite-residue-difference ())
          modulus
          positive-modulus
          (#pt-app (#pt-use finite-residue-negate ()) modulus positive-modulus y-coordinate)
          (#pt-app
            (#pt-use finite-residue-multiply ())
            modulus
            positive-modulus
            (#pt-project finite-weierstrass-curve 0 curve)
            x-coordinate))
        (#pt-project finite-weierstrass-curve 2 curve)))))
