    (#parameter second-nonzero (#pt-pi ((denied-evidence (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring other-polynomial (#pt-construct finite-list () (Carrier) nil ())))) #pt-false)))
