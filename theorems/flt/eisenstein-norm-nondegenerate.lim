; The norm vanishes exactly at the zero Eisenstein equivalence class.
; A completed-square identity and constructive scalar positivity prove this.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-lambda = ./eisenstein-defs.lim::eisenstein-lambda)
(#alias eisenstein-of-integer = ./eisenstein-defs.lim::eisenstein-of-integer)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-add = ./eisenstein-defs.lim::eisenstein-add)
(#alias eisenstein-negate = ./eisenstein-defs.lim::eisenstein-negate)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-zero = ./integer-defs.lim::integer-zero)
(#alias integer-one = ./integer-defs.lim::integer-one)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias eisenstein-reflexive = ./eisenstein-equality.lim::eisenstein-reflexive)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-congruent = ./eisenstein-equality.lim::eisenstein-multiply-congruent)
(#alias eisenstein-add-congruent = ./eisenstein-equality.lim::eisenstein-add-congruent)
(#alias
  eisenstein-of-integer-injective
  =
  ./eisenstein-equality.lim::eisenstein-of-integer-injective)
(#alias integer-reflexive = ./integer-equality.lim::integer-reflexive)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias integer-add-congruent = ./integer-equality.lim::integer-add-congruent)
(#alias integer-negate-congruent = ./integer-equality.lim::integer-negate-congruent)
(#alias integer-multiply-congruent = ./integer-multiplication.lim::integer-multiply-congruent)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias eisenstein-conjugate = ./eisenstein-norm-defs.lim::eisenstein-conjugate)
(#alias eisenstein-norm = ./eisenstein-norm-defs.lim::eisenstein-norm)
(#alias eisenstein-natural-norm = ./eisenstein-norm-defs.lim::eisenstein-natural-norm)
(#alias integer-nonnegative = ./integer-nonnegative.lim::integer-nonnegative)
(#alias integer-natural-nonnegative = ./integer-nonnegative.lim::integer-natural-nonnegative)
(#alias integer-square-nonnegative = ./integer-nonnegative.lim::integer-square-nonnegative)
(#alias integer-nonnegative-multiply = ./integer-nonnegative.lim::integer-nonnegative-multiply)
(#alias
  integer-nonnegative-zero-sum-second
  =
  ./integer-nonnegative.lim::integer-nonnegative-zero-sum-second)
(#alias integer-natural-embedding-nonzero = ./integer-domain.lim::integer-natural-embedding-nonzero)
(#alias integer-product-zero-cancel-first = ./integer-domain.lim::integer-product-zero-cancel-first)
(#alias integer-square-zero = ./integer-domain.lim::integer-square-zero)
(#alias eisenstein-norm-congruent = ./eisenstein-norm-basic.lim::eisenstein-norm-congruent)
(#alias eisenstein-norm-zero = ./eisenstein-norm-basic.lim::eisenstein-norm-zero)
(#alias eisenstein-norm-four-squares = ./eisenstein-norm-squares.lim::eisenstein-norm-four-squares)
(#alias eisenstein-norm-of-integer = ./eisenstein-norm-squares.lim::eisenstein-norm-of-integer)
(#alias
  integer-multiply-congruent-second
  =
  ./integer-multiplication.lim::integer-multiply-congruent-second)
(#alias integer-multiply-zero = ./integer-multiplication.lim::integer-multiply-zero)
(#alias successor-not-zero = ./natural-nonzero.lim::successor-not-zero)
(#theorem eisenstein-norm-zero-omega
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter norm-zero (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use eisenstein-norm ()) number) (#pt-use integer-zero ()))))
  (#statement
    (#pt-app (#pt-use integer-equal ()) (#pt-project eisenstein 1 number) (#pt-use integer-zero ())))
  (#proof
    (#pt-app
      (#pt-use integer-square-zero ())
      (#pt-project eisenstein 1 number)
      (#pt-app
        (#pt-use integer-product-zero-cancel-first ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-project eisenstein 1 number)
          (#pt-project eisenstein 1 number))
        (#pt-app
          (#pt-use integer-natural-embedding-nonzero ())
          (#pt-numeral 3)
          (#pt-app (#pt-use successor-not-zero ()) (#pt-numeral 2)))
        (#pt-app
          (#pt-use integer-nonnegative-zero-sum-second ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))
                (#pt-project eisenstein 0 number))
              (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 number)))
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))
                (#pt-project eisenstein 0 number))
              (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 number))))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project eisenstein 1 number)
              (#pt-project eisenstein 1 number)))
          (#pt-app
            (#pt-use integer-square-nonnegative ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))
                (#pt-project eisenstein 0 number))
              (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 number))))
          (#pt-app
            (#pt-use integer-nonnegative-multiply ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project eisenstein 1 number)
              (#pt-project eisenstein 1 number))
            (#pt-app (#pt-use integer-natural-nonnegative ()) (#pt-numeral 3))
            (#pt-app (#pt-use integer-square-nonnegative ()) (#pt-project eisenstein 1 number)))
          (#pt-app
            (#pt-use integer-transitive ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app
                  (#pt-use integer-add ())
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))
                    (#pt-project eisenstein 0 number))
                  (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 number)))
                (#pt-app
                  (#pt-use integer-add ())
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))
                    (#pt-project eisenstein 0 number))
                  (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 number))))
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-project eisenstein 1 number)
                  (#pt-project eisenstein 1 number))))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))
              (#pt-app (#pt-use eisenstein-norm ()) number))
            (#pt-use integer-zero ())
            (#pt-app
              (#pt-use integer-symmetric ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))
                (#pt-app (#pt-use eisenstein-norm ()) number))
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app
                    (#pt-use integer-add ())
                    (#pt-app
                      (#pt-use integer-multiply ())
                      (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))
                      (#pt-project eisenstein 0 number))
                    (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 number)))
                  (#pt-app
                    (#pt-use integer-add ())
                    (#pt-app
                      (#pt-use integer-multiply ())
                      (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))
                      (#pt-project eisenstein 0 number))
                    (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 number))))
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-project eisenstein 1 number)
                    (#pt-project eisenstein 1 number))))
              (#pt-app (#pt-use eisenstein-norm-four-squares ()) number))
            (#pt-app
              (#pt-use integer-transitive ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))
                (#pt-app (#pt-use eisenstein-norm ()) number))
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))
                (#pt-use integer-zero ()))
              (#pt-use integer-zero ())
              (#pt-app
                (#pt-use integer-multiply-congruent-second ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))
                (#pt-app (#pt-use eisenstein-norm ()) number)
                (#pt-use integer-zero ())
                norm-zero)
              (#pt-app
                (#pt-use integer-multiply-zero ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))))))))))
(#theorem eisenstein-norm-zero-real
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter norm-zero (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use eisenstein-norm ()) number) (#pt-use integer-zero ()))))
  (#statement
    (#pt-app (#pt-use integer-equal ()) (#pt-project eisenstein 0 number) (#pt-use integer-zero ())))
  (#proof
    (#pt-app
      (#pt-use integer-square-zero ())
      (#pt-project eisenstein 0 number)
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-project eisenstein 0 number)
          (#pt-project eisenstein 0 number))
        (#pt-app
          (#pt-use eisenstein-norm ())
          (#pt-app (#pt-use eisenstein-of-integer ()) (#pt-project eisenstein 0 number)))
        (#pt-use integer-zero ())
        (#pt-app
          (#pt-use integer-symmetric ())
          (#pt-app
            (#pt-use eisenstein-norm ())
            (#pt-app (#pt-use eisenstein-of-integer ()) (#pt-project eisenstein 0 number)))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project eisenstein 0 number)
            (#pt-project eisenstein 0 number))
          (#pt-app (#pt-use eisenstein-norm-of-integer ()) (#pt-project eisenstein 0 number)))
        (#pt-app
          (#pt-use integer-transitive ())
          (#pt-app
            (#pt-use eisenstein-norm ())
            (#pt-app (#pt-use eisenstein-of-integer ()) (#pt-project eisenstein 0 number)))
          (#pt-app (#pt-use eisenstein-norm ()) number)
          (#pt-use integer-zero ())
          (#pt-app
            (#pt-use integer-symmetric ())
            (#pt-app (#pt-use eisenstein-norm ()) number)
            (#pt-app
              (#pt-use eisenstein-norm ())
              (#pt-app (#pt-use eisenstein-of-integer ()) (#pt-project eisenstein 0 number)))
            (#pt-app
              (#pt-use eisenstein-norm-congruent ())
              number
              (#pt-app (#pt-use eisenstein-of-integer ()) (#pt-project eisenstein 0 number))
              (#pt-app
                (#pt-use conjunction-introduce ())
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-project eisenstein 0 number)
                  (#pt-project
                    eisenstein
                    0
                    (#pt-app (#pt-use eisenstein-of-integer ()) (#pt-project eisenstein 0 number))))
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-project eisenstein 1 number)
                  (#pt-project
                    eisenstein
                    1
                    (#pt-app (#pt-use eisenstein-of-integer ()) (#pt-project eisenstein 0 number))))
                (#pt-app (#pt-use integer-reflexive ()) (#pt-project eisenstein 0 number))
                (#pt-app (#pt-use eisenstein-norm-zero-omega ()) number norm-zero))))
          norm-zero)))))
(#theorem eisenstein-norm-zero-implies-zero
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter norm-zero (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use eisenstein-norm ()) number) (#pt-use integer-zero ()))))
  (#statement (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ())))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project eisenstein 0 number)
        (#pt-project eisenstein 0 (#pt-use eisenstein-zero ())))
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project eisenstein 1 number)
        (#pt-project eisenstein 1 (#pt-use eisenstein-zero ())))
      (#pt-app (#pt-use eisenstein-norm-zero-real ()) number norm-zero)
      (#pt-app (#pt-use eisenstein-norm-zero-omega ()) number norm-zero))))
(#theorem eisenstein-zero-implies-norm-zero
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter number-zero (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ()))))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use eisenstein-norm ()) number)
      (#pt-use integer-zero ())))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app (#pt-use eisenstein-norm ()) number)
      (#pt-app (#pt-use eisenstein-norm ()) (#pt-use eisenstein-zero ()))
      (#pt-use integer-zero ())
      (#pt-app
        (#pt-use eisenstein-norm-congruent ())
        number
        (#pt-use eisenstein-zero ())
        number-zero)
      (#pt-use eisenstein-norm-zero ()))))
(#theorem eisenstein-nonzero-norm
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter number-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ())))) #pt-false)))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-app (#pt-use eisenstein-norm ()) number)
            (#pt-use integer-zero ()))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (norm-zero
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-app (#pt-use eisenstein-norm ()) number)
            (#pt-use integer-zero ()))))
      (#pt-app
        number-nonzero
        (#pt-app (#pt-use eisenstein-norm-zero-implies-zero ()) number norm-zero)))))
