(#alias ring-polynomial-symmetric = ./ring-polynomial-equivalence.lim::ring-polynomial-symmetric)
(#alias ring-polynomial-transitive = ./ring-polynomial-equivalence.lim::ring-polynomial-transitive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#theorem quadratic-division-equation
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter linear-coefficient Carrier)
    (#parameter constant-coefficient Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-equal ())
      Carrier
      coefficient-ring
      polynomial
      (#pt-app
        (#pt-use ring-polynomial-add ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-multiply ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use quadratic-division-divisor ())
            Carrier
            coefficient-ring
            linear-coefficient
            constant-coefficient)
          (#pt-project
            quadratic-division-data
            0
            (#pt-app
              (#pt-use quadratic-division-compute ())
              Carrier
              coefficient-ring
              linear-coefficient
              constant-coefficient
              polynomial)))
        (#pt-construct
          finite-list
          ()
          (Carrier)
          cons
          (
            (#pt-project
              quadratic-division-data
              1
              (#pt-app
                (#pt-use quadratic-division-compute ())
                Carrier
                coefficient-ring
                linear-coefficient
                constant-coefficient
                polynomial))
            (#pt-construct
              finite-list
              ()
              (Carrier)
              cons
              (
                (#pt-project
                  quadratic-division-data
                  2
                  (#pt-app
                    (#pt-use quadratic-division-compute ())
                    Carrier
                    coefficient-ring
                    linear-coefficient
                    constant-coefficient
                    polynomial))
                (#pt-construct finite-list () (Carrier) nil ()))))))))
  (#proof
    (#pt-induct
      finite-list
      ()
      (Carrier)
      (#pt-lambda
        ((division-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
        (#pt-app
          (#pt-use ring-polynomial-equal ())
          Carrier
          coefficient-ring
          division-polynomial
          (#pt-app
            (#pt-use ring-polynomial-add ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-multiply ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use quadratic-division-divisor ())
                Carrier
                coefficient-ring
                linear-coefficient
                constant-coefficient)
              (#pt-project
                quadratic-division-data
                0
                (#pt-app
                  (#pt-use quadratic-division-compute ())
                  Carrier
                  coefficient-ring
                  linear-coefficient
                  constant-coefficient
                  division-polynomial)))
            (#pt-construct
              finite-list
              ()
              (Carrier)
              cons
              (
                (#pt-project
                  quadratic-division-data
                  1
                  (#pt-app
                    (#pt-use quadratic-division-compute ())
                    Carrier
                    coefficient-ring
                    linear-coefficient
                    constant-coefficient
                    division-polynomial))
                (#pt-construct
                  finite-list
                  ()
                  (Carrier)
                  cons
                  (
                    (#pt-project
                      quadratic-division-data
                      2
                      (#pt-app
                        (#pt-use quadratic-division-compute ())
                        Carrier
                        coefficient-ring
                        linear-coefficient
                        constant-coefficient
                        division-polynomial))
                    (#pt-construct finite-list () (Carrier) nil ()))))))))
      (
        (#pt-app
          (#pt-use ring-polynomial-symmetric ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-add ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-multiply ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use quadratic-division-divisor ())
                Carrier
                coefficient-ring
                linear-coefficient
                constant-coefficient)
              (#pt-construct finite-list () (Carrier) nil ()))
            (#pt-construct
              finite-list
              ()
              (Carrier)
              cons
              (
                (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
                (#pt-construct
                  finite-list
                  ()
                  (Carrier)
                  cons
                  (
                    (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
                    (#pt-construct finite-list () (Carrier) nil ()))))))
          (#pt-construct finite-list () (Carrier) nil ())
          (#pt-app
            (#pt-use ring-polynomial-add-congruent ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-multiply ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use quadratic-division-divisor ())
                Carrier
                coefficient-ring
                linear-coefficient
                constant-coefficient)
              (#pt-construct finite-list () (Carrier) nil ()))
            (#pt-construct
              finite-list
              ()
              (Carrier)
              cons
              (
                (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
                (#pt-construct
                  finite-list
                  ()
                  (Carrier)
                  cons
                  (
                    (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
                    (#pt-construct finite-list () (Carrier) nil ())))))
            (#pt-construct finite-list () (Carrier) nil ())
            (#pt-construct finite-list () (Carrier) nil ())
            (#pt-app
              (#pt-use ring-polynomial-multiply-zero ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use quadratic-division-divisor ())
                Carrier
                coefficient-ring
                linear-coefficient
                constant-coefficient))
            (#pt-app
              (#pt-use ring-polynomial-transitive ())
              Carrier
              coefficient-ring
              (#pt-construct
                finite-list
                ()
                (Carrier)
                cons
                (
                  (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
                  (#pt-construct
                    finite-list
                    ()
                    (Carrier)
                    cons
                    (
                      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
                      (#pt-construct finite-list () (Carrier) nil ())))))
              (#pt-app
                (#pt-use ring-polynomial-shift ())
                Carrier
                coefficient-ring
                (#pt-construct finite-list () (Carrier) nil ()))
              (#pt-construct finite-list () (Carrier) nil ())
              (#pt-app
                (#pt-use ring-polynomial-shift-congruent ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-polynomial-shift ())
                  Carrier
                  coefficient-ring
                  (#pt-construct finite-list () (Carrier) nil ()))
                (#pt-construct finite-list () (Carrier) nil ())
                (#pt-app (#pt-use ring-polynomial-shift-nil ()) Carrier coefficient-ring))
              (#pt-app (#pt-use ring-polynomial-shift-nil ()) Carrier coefficient-ring))))
        (#pt-lambda
          (
            (head Carrier)
            (tail (#pt-app (#pt-use finite-list ()) Carrier))
            (tail-result
              (#pt-app
                (#pt-use ring-polynomial-equal ())
                Carrier
                coefficient-ring
                tail
                (#pt-app
                  (#pt-use ring-polynomial-add ())
                  Carrier
                  coefficient-ring
                  (#pt-app
                    (#pt-use ring-polynomial-multiply ())
                    Carrier
                    coefficient-ring
                    (#pt-app
                      (#pt-use quadratic-division-divisor ())
                      Carrier
                      coefficient-ring
                      linear-coefficient
                      constant-coefficient)
                    (#pt-project
                      quadratic-division-data
                      0
                      (#pt-app
                        (#pt-use quadratic-division-compute ())
                        Carrier
                        coefficient-ring
                        linear-coefficient
                        constant-coefficient
                        tail)))
                  (#pt-construct
                    finite-list
                    ()
                    (Carrier)
                    cons
                    (
                      (#pt-project
                        quadratic-division-data
                        1
                        (#pt-app
                          (#pt-use quadratic-division-compute ())
                          Carrier
                          coefficient-ring
                          linear-coefficient
                          constant-coefficient
                          tail))
                      (#pt-construct
                        finite-list
                        ()
                        (Carrier)
                        cons
                        (
                          (#pt-project
                            quadratic-division-data
                            2
                            (#pt-app
                              (#pt-use quadratic-division-compute ())
                              Carrier
                              coefficient-ring
                              linear-coefficient
                              constant-coefficient
                              tail))
                          (#pt-construct finite-list () (Carrier) nil ())))))))))
          (#pt-app
            (#pt-use quadratic-division-step-equation ())
            Carrier
            coefficient-ring
            linear-coefficient
            constant-coefficient
            head
            tail
            (#pt-project
              quadratic-division-data
              0
              (#pt-app
                (#pt-use quadratic-division-compute ())
                Carrier
                coefficient-ring
                linear-coefficient
                constant-coefficient
                tail))
            (#pt-project
              quadratic-division-data
              1
              (#pt-app
                (#pt-use quadratic-division-compute ())
                Carrier
                coefficient-ring
                linear-coefficient
                constant-coefficient
                tail))
            (#pt-project
              quadratic-division-data
              2
              (#pt-app
                (#pt-use quadratic-division-compute ())
                Carrier
                coefficient-ring
                linear-coefficient
                constant-coefficient
                tail))
            tail-result)))
      polynomial)))
