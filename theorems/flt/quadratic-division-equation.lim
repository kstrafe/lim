; For every finite polynomial, compute q,r0,r1 and prove
; p = (Y^2+alpha*Y-beta)*q + (r0+r1*Y). All coefficients are arbitrary.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
