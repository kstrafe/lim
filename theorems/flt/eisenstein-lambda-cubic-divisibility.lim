; Concrete mathematical port of FLT/Three.lean:279-290.
; For nonzero c, lambda^4 dividing c^3 forces lambda^2 dividing c.
; The order of c^3 is3*k; exhaustive0/1/larger natural cases force k>=2.
; The premise lambda^4|c^3 must still be supplied by the solution proof.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-lambda = ./eisenstein-defs.lim::eisenstein-lambda)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-power = ./eisenstein-defs.lim::eisenstein-power)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias eisenstein-unit = ./eisenstein-defs.lim::eisenstein-unit)
(#alias eisenstein-reflexive = ./eisenstein-equality.lim::eisenstein-reflexive)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-congruent = ./eisenstein-equality.lim::eisenstein-multiply-congruent)
(#alias eisenstein-multiply-one = ./eisenstein-ring.lim::eisenstein-multiply-one)
(#alias eisenstein-multiply-zero = ./eisenstein-ring.lim::eisenstein-multiply-zero)
(#alias eisenstein-multiply-commutative = ./eisenstein-ring.lim::eisenstein-multiply-commutative)
(#alias eisenstein-multiply-associative = ./eisenstein-ring.lim::eisenstein-multiply-associative)
(#alias eisenstein-one-multiply = ./eisenstein-cubic-bridge.lim::eisenstein-one-multiply)
(#alias
  eisenstein-lambda-multiply-cancel
  =
  ./eisenstein-lambda-cancellation.lim::eisenstein-lambda-multiply-cancel)
(#alias eisenstein-lambda-order = ./eisenstein-lambda-order.lim::eisenstein-lambda-order)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias exists = ./logic-exists.lim::exists)
(#alias
  eisenstein-lambda-order-power
  =
  ./eisenstein-lambda-order-arithmetic.lim::eisenstein-lambda-order-power)
(#alias
  eisenstein-lambda-order-excludes-higher
  =
  ./eisenstein-lambda-order.lim::eisenstein-lambda-order-excludes-higher)
(#alias
  eisenstein-lambda-order-exists
  =
  ./eisenstein-lambda-order.lim::eisenstein-lambda-order-exists)
(#alias zero-one-or-large = ./natural-small-cases.lim::zero-one-or-large)
(#alias less-than = ./natural-order.lim::less-than)
(#alias
  eisenstein-power-divides-add
  =
  ./eisenstein-power-divisibility.lim::eisenstein-power-divides-add)
(#alias
  eisenstein-divides-transitive
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-transitive)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#alias symmetry = ./equality.lim::symmetry)
(#alias substitution = ./equality.lim::substitution)
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#theorem eisenstein-lambda-order-at-least-two-from-cube
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter order-exponent #pt-nat)
    (#parameter order-certificate (#pt-app (#pt-use eisenstein-lambda-order ()) number order-exponent))
    (#parameter fourth-power-divides-cube (#pt-app (#pt-use eisenstein-divides ()) (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 4)) (#pt-app (#pt-use eisenstein-power ()) number (#pt-numeral 3)))))
  (#statement (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) order-exponent))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-eq #pt-nat order-exponent #pt-zero)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-eq #pt-nat order-exponent (#pt-succ #pt-zero))
        (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) order-exponent))
      (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) order-exponent)
      (#pt-lambda
        ((order-zero (#pt-eq #pt-nat order-exponent #pt-zero)))
        (#pt-app
          (#pt-use false-elimination ())
          (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) order-exponent)
          (#pt-app
            (#pt-app
              (#pt-use eisenstein-lambda-order-excludes-higher ())
              (#pt-app (#pt-use eisenstein-power ()) number (#pt-numeral 3))
              (#pt-numeral 0)
              (#pt-numeral 4)
              (#pt-app
                (#pt-use eisenstein-lambda-order-power ())
                number
                (#pt-numeral 0)
                (#pt-numeral 3)
                (#pt-app
                  (#pt-use substitution (0))
                  #pt-nat
                  (#pt-lambda
                    ((endpoint #pt-nat))
                    (#pt-app (#pt-use eisenstein-lambda-order ()) number endpoint))
                  order-exponent
                  (#pt-numeral 0)
                  order-zero
                  order-certificate))
              (#pt-construct
                exists
                (0)
                (#pt-nat
                  (#pt-lambda
                    ((candidate-gap #pt-nat))
                    (#pt-eq
                      #pt-nat
                      (#pt-numeral 4)
                      (#pt-app (#pt-use add ()) (#pt-succ (#pt-numeral 0)) candidate-gap))))
                introduce
                ((#pt-numeral 3) (#pt-refl #pt-nat (#pt-numeral 4)))))
            fourth-power-divides-cube)))
      (#pt-lambda
        (
          (one-or-larger
            (#pt-app
              (#pt-use disjunction ())
              (#pt-eq #pt-nat order-exponent (#pt-succ #pt-zero))
              (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) order-exponent))))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-eq #pt-nat order-exponent (#pt-succ #pt-zero))
          (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) order-exponent)
          (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) order-exponent)
          (#pt-lambda
            ((order-one (#pt-eq #pt-nat order-exponent (#pt-succ #pt-zero))))
            (#pt-app
              (#pt-use false-elimination ())
              (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) order-exponent)
              (#pt-app
                (#pt-app
                  (#pt-use eisenstein-lambda-order-excludes-higher ())
                  (#pt-app (#pt-use eisenstein-power ()) number (#pt-numeral 3))
                  (#pt-numeral 3)
                  (#pt-numeral 4)
                  (#pt-app
                    (#pt-use eisenstein-lambda-order-power ())
                    number
                    (#pt-numeral 1)
                    (#pt-numeral 3)
                    (#pt-app
                      (#pt-use substitution (0))
                      #pt-nat
                      (#pt-lambda
                        ((endpoint #pt-nat))
                        (#pt-app (#pt-use eisenstein-lambda-order ()) number endpoint))
                      order-exponent
                      (#pt-numeral 1)
                      order-one
                      order-certificate))
                  (#pt-construct
                    exists
                    (0)
                    (#pt-nat
                      (#pt-lambda
                        ((candidate-gap #pt-nat))
                        (#pt-eq
                          #pt-nat
                          (#pt-numeral 4)
                          (#pt-app (#pt-use add ()) (#pt-succ (#pt-numeral 3)) candidate-gap))))
                    introduce
                    ((#pt-numeral 0) (#pt-refl #pt-nat (#pt-numeral 4)))))
                fourth-power-divides-cube)))
          (#pt-lambda
            ((above-one (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) order-exponent)))
            above-one)
          one-or-larger))
      (#pt-app (#pt-use zero-one-or-large ()) order-exponent))))
(#theorem eisenstein-lambda-square-divides-from-cube
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter number-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ())))) #pt-false))
    (#parameter fourth-power-divides-cube (#pt-app (#pt-use eisenstein-divides ()) (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 4)) (#pt-app (#pt-use eisenstein-power ()) number (#pt-numeral 3)))))
  (#statement
    (#pt-app
      (#pt-use eisenstein-divides ())
      (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2))
      number))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-order #pt-nat))
          (#pt-app (#pt-use eisenstein-lambda-order ()) number candidate-order)))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-order #pt-nat))
                (#pt-app (#pt-use eisenstein-lambda-order ()) number candidate-order)))))
        (#pt-app
          (#pt-use eisenstein-divides ())
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2))
          number))
      (
        (#pt-lambda
          (
            (order-exponent #pt-nat)
            (order-certificate (#pt-app (#pt-use eisenstein-lambda-order ()) number order-exponent)))
          (#pt-induct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-gap #pt-nat))
                (#pt-eq
                  #pt-nat
                  order-exponent
                  (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ #pt-zero)) candidate-gap))))
            (#pt-lambda
              (
                (certificate
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((candidate-gap #pt-nat))
                      (#pt-eq
                        #pt-nat
                        order-exponent
                        (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ #pt-zero)) candidate-gap))))))
              (#pt-app
                (#pt-use eisenstein-divides ())
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-numeral 2))
                number))
            (
              (#pt-lambda
                (
                  (gap #pt-nat)
                  (position
                    (#pt-eq #pt-nat order-exponent (#pt-app (#pt-use add ()) (#pt-numeral 2) gap))))
                (#pt-app
                  (#pt-use eisenstein-divides-transitive ())
                  (#pt-app
                    (#pt-use eisenstein-power ())
                    (#pt-use eisenstein-lambda ())
                    (#pt-numeral 2))
                  (#pt-app
                    (#pt-use eisenstein-power ())
                    (#pt-use eisenstein-lambda ())
                    order-exponent)
                  number
                  (#pt-app
                    (#pt-use substitution (0))
                    #pt-nat
                    (#pt-lambda
                      ((endpoint #pt-nat))
                      (#pt-app
                        (#pt-use eisenstein-divides ())
                        (#pt-app
                          (#pt-use eisenstein-power ())
                          (#pt-use eisenstein-lambda ())
                          (#pt-numeral 2))
                        (#pt-app
                          (#pt-use eisenstein-power ())
                          (#pt-use eisenstein-lambda ())
                          endpoint)))
                    (#pt-app (#pt-use add ()) (#pt-numeral 2) gap)
                    order-exponent
                    (#pt-app
                      (#pt-use symmetry (0))
                      #pt-nat
                      order-exponent
                      (#pt-app (#pt-use add ()) (#pt-numeral 2) gap)
                      position)
                    (#pt-app
                      (#pt-use eisenstein-power-divides-add ())
                      (#pt-use eisenstein-lambda ())
                      (#pt-numeral 2)
                      gap))
                  (#pt-project eisenstein-lambda-order 0 order-certificate))))
            (#pt-app
              (#pt-use eisenstein-lambda-order-at-least-two-from-cube ())
              number
              order-exponent
              order-certificate
              fourth-power-divides-cube))))
      (#pt-app (#pt-use eisenstein-lambda-order-exists ()) number number-nonzero))))
