; Euclidean existence and the divisor-universal specification of a Nat gcd.
; No gcd equation or imported number-theoretic result is admitted.
; The induction follows the strictly decreasing certified remainder.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#alias strong-induction = ./natural-order.lim::strong-induction)
(#alias zero-less-successor = ./natural-discrete-order.lim::zero-less-successor)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias divides-reflexive = ./natural-divisibility.lim::divides-reflexive)
(#alias divides-zero = ./natural-divisibility.lim::divides-zero)
(#alias divides-multiple = ./natural-divisibility.lim::divides-multiple)
(#alias divides-transitive = ./natural-divisibility.lim::divides-transitive)
(#alias divides-add = ./natural-divisibility-addition.lim::divides-add)
(#alias divides-add-cancel-left = ./natural-divisibility-addition.lim::divides-add-cancel-left)
(#alias multiply-commutative = ./natural-multiplication-commutative.lim::multiply-commutative)
(#alias division-spec = ./natural-division.lim::division-spec)
(#alias has-division = ./natural-division.lim::has-division)
(#alias division-exists = ./natural-division.lim::division-exists)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias symmetry = ./equality.lim::symmetry)
(#alias substitution = ./equality.lim::substitution)
(#math-definition gcd-spec ()
  (#pt-pi ((first #pt-nat) (second #pt-nat) (greatest-divisor #pt-nat)) #pt-prop)
  (#pt-lambda
    ((first #pt-nat) (second #pt-nat) (greatest-divisor #pt-nat))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app (#pt-use divides ()) greatest-divisor first)
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app (#pt-use divides ()) greatest-divisor second)
        (#pt-pi
          (
            (candidate-common #pt-nat)
            (candidate-first (#pt-app (#pt-use divides ()) candidate-common first))
            (candidate-second (#pt-app (#pt-use divides ()) candidate-common second)))
          (#pt-app (#pt-use divides ()) candidate-common greatest-divisor))))))
(#math-definition has-gcd ()
  (#pt-pi ((first #pt-nat) (second #pt-nat)) #pt-prop)
  (#pt-lambda
    ((first #pt-nat) (second #pt-nat))
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-gcd #pt-nat))
        (#pt-app (#pt-use gcd-spec ()) first second candidate-gcd)))))
(#theorem gcd-zero-right
  (#universes)
  (#parameters
    (#parameter first #pt-nat))
  (#statement (#pt-app (#pt-use gcd-spec ()) first #pt-zero first))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app (#pt-use divides ()) first first)
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app (#pt-use divides ()) first #pt-zero)
        (#pt-pi
          (
            (candidate-common #pt-nat)
            (candidate-first (#pt-app (#pt-use divides ()) candidate-common first))
            (candidate-second (#pt-app (#pt-use divides ()) candidate-common #pt-zero)))
          (#pt-app (#pt-use divides ()) candidate-common first)))
      (#pt-app (#pt-use divides-reflexive ()) first)
      (#pt-app
        (#pt-use conjunction-introduce ())
        (#pt-app (#pt-use divides ()) first #pt-zero)
        (#pt-pi
          (
            (candidate-common #pt-nat)
            (candidate-first (#pt-app (#pt-use divides ()) candidate-common first))
            (candidate-second (#pt-app (#pt-use divides ()) candidate-common #pt-zero)))
          (#pt-app (#pt-use divides ()) candidate-common first))
        (#pt-app (#pt-use divides-zero ()) first)
        (#pt-lambda
          (
            (common-divisor #pt-nat)
            (divides-first (#pt-app (#pt-use divides ()) common-divisor first))
            (divides-second (#pt-app (#pt-use divides ()) common-divisor #pt-zero)))
          divides-first)))))
(#theorem gcd-euclidean-step
  (#universes)
  (#parameters
    (#parameter dividend #pt-nat)
    (#parameter divisor #pt-nat)
    (#parameter quotient #pt-nat)
    (#parameter remainder #pt-nat)
    (#parameter division-proof (#pt-app (#pt-use division-spec ()) dividend divisor quotient remainder))
    (#parameter greatest-divisor #pt-nat)
    (#parameter remainder-gcd (#pt-app (#pt-use gcd-spec ()) divisor remainder greatest-divisor)))
  (#statement (#pt-app (#pt-use gcd-spec ()) dividend divisor greatest-divisor))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app (#pt-use divides ()) greatest-divisor dividend)
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app (#pt-use divides ()) greatest-divisor divisor)
        (#pt-pi
          (
            (candidate-common #pt-nat)
            (candidate-first (#pt-app (#pt-use divides ()) candidate-common dividend))
            (candidate-second (#pt-app (#pt-use divides ()) candidate-common divisor)))
          (#pt-app (#pt-use divides ()) candidate-common greatest-divisor)))
      (#pt-app
        (#pt-use substitution (0))
        #pt-nat
        (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use divides ()) greatest-divisor endpoint))
        (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) quotient divisor) remainder)
        dividend
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          dividend
          (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) quotient divisor) remainder)
          (#pt-app
            (#pt-use conjunction-left ())
            (#pt-eq
              #pt-nat
              dividend
              (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) quotient divisor) remainder))
            (#pt-app (#pt-use less-than ()) remainder divisor)
            division-proof))
        (#pt-app
          (#pt-use divides-add ())
          greatest-divisor
          (#pt-app (#pt-use multiply ()) quotient divisor)
          remainder
          (#pt-app
            (#pt-use divides-transitive ())
            greatest-divisor
            divisor
            (#pt-app (#pt-use multiply ()) quotient divisor)
            (#pt-app
              (#pt-use conjunction-left ())
              (#pt-app (#pt-use divides ()) greatest-divisor divisor)
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use divides ()) greatest-divisor remainder)
                (#pt-pi
                  (
                    (candidate-common #pt-nat)
                    (candidate-first (#pt-app (#pt-use divides ()) candidate-common divisor))
                    (candidate-second (#pt-app (#pt-use divides ()) candidate-common remainder)))
                  (#pt-app (#pt-use divides ()) candidate-common greatest-divisor)))
              remainder-gcd)
            (#pt-app
              (#pt-use substitution (0))
              #pt-nat
              (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use divides ()) divisor endpoint))
              (#pt-app (#pt-use multiply ()) divisor quotient)
              (#pt-app (#pt-use multiply ()) quotient divisor)
              (#pt-app (#pt-use multiply-commutative ()) divisor quotient)
              (#pt-app (#pt-use divides-multiple ()) divisor quotient)))
          (#pt-app
            (#pt-use conjunction-left ())
            (#pt-app (#pt-use divides ()) greatest-divisor remainder)
            (#pt-pi
              (
                (candidate-common #pt-nat)
                (candidate-first (#pt-app (#pt-use divides ()) candidate-common divisor))
                (candidate-second (#pt-app (#pt-use divides ()) candidate-common remainder)))
              (#pt-app (#pt-use divides ()) candidate-common greatest-divisor))
            (#pt-app
              (#pt-use conjunction-right ())
              (#pt-app (#pt-use divides ()) greatest-divisor divisor)
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use divides ()) greatest-divisor remainder)
                (#pt-pi
                  (
                    (candidate-common #pt-nat)
                    (candidate-first (#pt-app (#pt-use divides ()) candidate-common divisor))
                    (candidate-second (#pt-app (#pt-use divides ()) candidate-common remainder)))
                  (#pt-app (#pt-use divides ()) candidate-common greatest-divisor)))
              remainder-gcd))))
      (#pt-app
        (#pt-use conjunction-introduce ())
        (#pt-app (#pt-use divides ()) greatest-divisor divisor)
        (#pt-pi
          (
            (candidate-common #pt-nat)
            (candidate-first (#pt-app (#pt-use divides ()) candidate-common dividend))
            (candidate-second (#pt-app (#pt-use divides ()) candidate-common divisor)))
          (#pt-app (#pt-use divides ()) candidate-common greatest-divisor))
        (#pt-app
          (#pt-use conjunction-left ())
          (#pt-app (#pt-use divides ()) greatest-divisor divisor)
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app (#pt-use divides ()) greatest-divisor remainder)
            (#pt-pi
              (
                (candidate-common #pt-nat)
                (candidate-first (#pt-app (#pt-use divides ()) candidate-common divisor))
                (candidate-second (#pt-app (#pt-use divides ()) candidate-common remainder)))
              (#pt-app (#pt-use divides ()) candidate-common greatest-divisor)))
          remainder-gcd)
        (#pt-lambda
          (
            (common-divisor #pt-nat)
            (divides-first (#pt-app (#pt-use divides ()) common-divisor dividend))
            (divides-second (#pt-app (#pt-use divides ()) common-divisor divisor)))
          (#pt-app
            (#pt-app
              (#pt-use conjunction-right ())
              (#pt-app (#pt-use divides ()) greatest-divisor remainder)
              (#pt-pi
                (
                  (candidate-common #pt-nat)
                  (candidate-first (#pt-app (#pt-use divides ()) candidate-common divisor))
                  (candidate-second (#pt-app (#pt-use divides ()) candidate-common remainder)))
                (#pt-app (#pt-use divides ()) candidate-common greatest-divisor))
              (#pt-app
                (#pt-use conjunction-right ())
                (#pt-app (#pt-use divides ()) greatest-divisor divisor)
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app (#pt-use divides ()) greatest-divisor remainder)
                  (#pt-pi
                    (
                      (candidate-common #pt-nat)
                      (candidate-first (#pt-app (#pt-use divides ()) candidate-common divisor))
                      (candidate-second (#pt-app (#pt-use divides ()) candidate-common remainder)))
                    (#pt-app (#pt-use divides ()) candidate-common greatest-divisor)))
                remainder-gcd))
            common-divisor
            divides-second
            (#pt-app
              (#pt-use divides-add-cancel-left ())
              common-divisor
              (#pt-app (#pt-use multiply ()) quotient divisor)
              remainder
              (#pt-app
                (#pt-use divides-transitive ())
                common-divisor
                divisor
                (#pt-app (#pt-use multiply ()) quotient divisor)
                divides-second
                (#pt-app
                  (#pt-use substitution (0))
                  #pt-nat
                  (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use divides ()) divisor endpoint))
                  (#pt-app (#pt-use multiply ()) divisor quotient)
                  (#pt-app (#pt-use multiply ()) quotient divisor)
                  (#pt-app (#pt-use multiply-commutative ()) divisor quotient)
                  (#pt-app (#pt-use divides-multiple ()) divisor quotient)))
              (#pt-app
                (#pt-use substitution (0))
                #pt-nat
                (#pt-lambda
                  ((endpoint #pt-nat))
                  (#pt-app (#pt-use divides ()) common-divisor endpoint))
                dividend
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) quotient divisor)
                  remainder)
                (#pt-app
                  (#pt-use conjunction-left ())
                  (#pt-eq
                    #pt-nat
                    dividend
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use multiply ()) quotient divisor)
                      remainder))
                  (#pt-app (#pt-use less-than ()) remainder divisor)
                  division-proof)
                divides-first))))))))
(#theorem gcd-induction-step
  (#universes)
  (#parameters
    (#parameter stage #pt-nat)
    (#parameter given-history (#pt-pi ((earlier #pt-nat) (earlier-proof (#pt-app (#pt-use less-than ()) earlier stage))) (#pt-pi ((number #pt-nat)) (#pt-app (#pt-use has-gcd ()) number earlier)))))
  (#statement (#pt-pi ((number #pt-nat)) (#pt-app (#pt-use has-gcd ()) number stage)))
  (#proof
    (#pt-app
      (#pt-nat-induct
        (#pt-lambda
          ((index #pt-nat))
          (#pt-pi
            (
              (stage-history
                (#pt-pi
                  ((earlier #pt-nat) (earlier-proof (#pt-app (#pt-use less-than ()) earlier index)))
                  (#pt-pi ((number #pt-nat)) (#pt-app (#pt-use has-gcd ()) number earlier)))))
            (#pt-pi ((number #pt-nat)) (#pt-app (#pt-use has-gcd ()) number index))))
        (#pt-lambda
          (
            (smaller-cases
              (#pt-pi
                (
                  (earlier #pt-nat)
                  (earlier-proof (#pt-app (#pt-use less-than ()) earlier #pt-zero)))
                (#pt-pi ((number #pt-nat)) (#pt-app (#pt-use has-gcd ()) number earlier))))
            (number #pt-nat))
          (#pt-construct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-gcd #pt-nat))
                (#pt-app (#pt-use gcd-spec ()) number #pt-zero candidate-gcd)))
            introduce
            (number (#pt-app (#pt-use gcd-zero-right ()) number))))
        (#pt-lambda
          (
            (previous #pt-nat)
            (unused-previous
              (#pt-pi
                (
                  (previous-history
                    (#pt-pi
                      (
                        (earlier #pt-nat)
                        (earlier-proof (#pt-app (#pt-use less-than ()) earlier previous)))
                      (#pt-pi ((number #pt-nat)) (#pt-app (#pt-use has-gcd ()) number earlier)))))
                (#pt-pi ((number #pt-nat)) (#pt-app (#pt-use has-gcd ()) number previous))))
            (smaller-cases
              (#pt-pi
                (
                  (earlier #pt-nat)
                  (earlier-proof (#pt-app (#pt-use less-than ()) earlier (#pt-succ previous))))
                (#pt-pi ((number #pt-nat)) (#pt-app (#pt-use has-gcd ()) number earlier))))
            (number #pt-nat))
          (#pt-induct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-quotient #pt-nat))
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((candidate-remainder #pt-nat))
                    (#pt-app
                      (#pt-use division-spec ())
                      number
                      (#pt-succ previous)
                      candidate-quotient
                      candidate-remainder)))))
            (#pt-lambda
              (
                (certificate
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((candidate-quotient #pt-nat))
                      (#pt-app
                        (#pt-use exists (0))
                        #pt-nat
                        (#pt-lambda
                          ((candidate-remainder #pt-nat))
                          (#pt-app
                            (#pt-use division-spec ())
                            number
                            (#pt-succ previous)
                            candidate-quotient
                            candidate-remainder)))))))
              (#pt-app (#pt-use has-gcd ()) number (#pt-succ previous)))
            (
              (#pt-lambda
                (
                  (quotient #pt-nat)
                  (remainder-certificate
                    (#pt-app
                      (#pt-use exists (0))
                      #pt-nat
                      (#pt-lambda
                        ((candidate-remainder #pt-nat))
                        (#pt-app
                          (#pt-use division-spec ())
                          number
                          (#pt-succ previous)
                          quotient
                          candidate-remainder)))))
                (#pt-induct
                  exists
                  (0)
                  (#pt-nat
                    (#pt-lambda
                      ((candidate-remainder #pt-nat))
                      (#pt-app
                        (#pt-use division-spec ())
                        number
                        (#pt-succ previous)
                        quotient
                        candidate-remainder)))
                  (#pt-lambda
                    (
                      (certificate
                        (#pt-app
                          (#pt-use exists (0))
                          #pt-nat
                          (#pt-lambda
                            ((candidate-remainder #pt-nat))
                            (#pt-app
                              (#pt-use division-spec ())
                              number
                              (#pt-succ previous)
                              quotient
                              candidate-remainder)))))
                    (#pt-app (#pt-use has-gcd ()) number (#pt-succ previous)))
                  (
                    (#pt-lambda
                      (
                        (remainder #pt-nat)
                        (division-proof
                          (#pt-app
                            (#pt-use division-spec ())
                            number
                            (#pt-succ previous)
                            quotient
                            remainder)))
                      (#pt-induct
                        exists
                        (0)
                        (#pt-nat
                          (#pt-lambda
                            ((candidate-gcd #pt-nat))
                            (#pt-app
                              (#pt-use gcd-spec ())
                              (#pt-succ previous)
                              remainder
                              candidate-gcd)))
                        (#pt-lambda
                          (
                            (certificate
                              (#pt-app
                                (#pt-use exists (0))
                                #pt-nat
                                (#pt-lambda
                                  ((candidate-gcd #pt-nat))
                                  (#pt-app
                                    (#pt-use gcd-spec ())
                                    (#pt-succ previous)
                                    remainder
                                    candidate-gcd)))))
                          (#pt-app (#pt-use has-gcd ()) number (#pt-succ previous)))
                        (
                          (#pt-lambda
                            (
                              (greatest-divisor #pt-nat)
                              (remainder-gcd
                                (#pt-app
                                  (#pt-use gcd-spec ())
                                  (#pt-succ previous)
                                  remainder
                                  greatest-divisor)))
                            (#pt-construct
                              exists
                              (0)
                              (#pt-nat
                                (#pt-lambda
                                  ((candidate-gcd #pt-nat))
                                  (#pt-app
                                    (#pt-use gcd-spec ())
                                    number
                                    (#pt-succ previous)
                                    candidate-gcd)))
                              introduce
                              (greatest-divisor
                                (#pt-app
                                  (#pt-use gcd-euclidean-step ())
                                  number
                                  (#pt-succ previous)
                                  quotient
                                  remainder
                                  division-proof
                                  greatest-divisor
                                  remainder-gcd)))))
                        (#pt-app
                          smaller-cases
                          remainder
                          (#pt-app
                            (#pt-use conjunction-right ())
                            (#pt-eq
                              #pt-nat
                              number
                              (#pt-app
                                (#pt-use add ())
                                (#pt-app (#pt-use multiply ()) quotient (#pt-succ previous))
                                remainder))
                            (#pt-app (#pt-use less-than ()) remainder (#pt-succ previous))
                            division-proof)
                          (#pt-succ previous)))))
                  remainder-certificate)))
            (#pt-app
              (#pt-use division-exists ())
              number
              (#pt-succ previous)
              (#pt-app (#pt-use zero-less-successor ()) previous))))
        stage)
      given-history)))
(#theorem gcd-exists
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat))
  (#statement (#pt-app (#pt-use has-gcd ()) first second))
  (#proof
    (#pt-app
      (#pt-app
        (#pt-use strong-induction ())
        (#pt-lambda
          ((index #pt-nat))
          (#pt-pi ((number #pt-nat)) (#pt-app (#pt-use has-gcd ()) number index)))
        (#pt-lambda
          (
            (stage #pt-nat)
            (smaller-cases
              (#pt-pi
                ((earlier #pt-nat) (earlier-proof (#pt-app (#pt-use less-than ()) earlier stage)))
                (#pt-pi ((number #pt-nat)) (#pt-app (#pt-use has-gcd ()) number earlier)))))
          (#pt-app (#pt-use gcd-induction-step ()) stage smaller-cases)))
      second
      first)))
