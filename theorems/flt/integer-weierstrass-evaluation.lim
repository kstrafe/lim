(#alias integer-weierstrass-b6 = ./integer-weierstrass-defs.lim::integer-weierstrass-b6)
(#alias integer-weierstrass-b8 = ./integer-weierstrass-defs.lim::integer-weierstrass-b8)
(#alias
  integer-weierstrass-discriminant
  =
  ./integer-weierstrass-defs.lim::integer-weierstrass-discriminant)
(#math-definition integer-weierstrass-discriminant-value ()
  (#pt-pi
    (
      (second-invariant (#pt-use integer ()))
      (fourth-invariant (#pt-use integer ()))
      (sixth-invariant (#pt-use integer ()))
      (eighth-invariant (#pt-use integer ())))
    (#pt-use integer ()))
  (#pt-lambda
    (
      (second-invariant (#pt-use integer ()))
      (fourth-invariant (#pt-use integer ()))
      (sixth-invariant (#pt-use integer ()))
      (eighth-invariant (#pt-use integer ())))
    (#pt-app
      (#pt-use integer-add ())
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app
              (#pt-use integer-negate ())
              (#pt-app (#pt-use integer-power ()) second-invariant (#pt-numeral 2)))
            eighth-invariant)
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 8))
              (#pt-app (#pt-use integer-power ()) fourth-invariant (#pt-numeral 3)))))
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 27))
            (#pt-app (#pt-use integer-power ()) sixth-invariant (#pt-numeral 2)))))
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 9))
            second-invariant)
          fourth-invariant)
        sixth-invariant))))
(#theorem integer-weierstrass-discriminant-evaluate
  (#universes)
  (#parameters
    (#parameter curve (#pt-use integer-weierstrass-curve ()))
    (#parameter second-invariant (#pt-use integer ()))
    (#parameter fourth-invariant (#pt-use integer ()))
    (#parameter sixth-invariant (#pt-use integer ()))
    (#parameter eighth-invariant (#pt-use integer ()))
    (#parameter b2-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-weierstrass-b2 ()) curve) second-invariant))
    (#parameter b4-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-weierstrass-b4 ()) curve) fourth-invariant))
    (#parameter b6-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-weierstrass-b6 ()) curve) sixth-invariant))
    (#parameter b8-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-weierstrass-b8 ()) curve) eighth-invariant)))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-weierstrass-discriminant ()) curve)
