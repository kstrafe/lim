          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 27))
            (#pt-app (#pt-use integer-power ()) sixth-invariant (#pt-numeral 2))))
        (#pt-app
          (#pt-use integer-add-congruent ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app
              (#pt-use integer-negate ())
              (#pt-app
                (#pt-use integer-power ())
                (#pt-app (#pt-use integer-weierstrass-b2 ()) curve)
                (#pt-numeral 2)))
            (#pt-app (#pt-use integer-weierstrass-b8 ()) curve))
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
