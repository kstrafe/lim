              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 8))
              (#pt-app
                (#pt-use integer-power ())
                (#pt-app (#pt-use integer-weierstrass-b4 ()) curve)
                (#pt-numeral 3)))))
        (#pt-app
