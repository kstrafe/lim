; Constructive formal differences of mathematical naturals.
; difference(p,n) denotes p-n. integer-equal is the cross-addition relation,
; not the kernel identity type: representation changes require the proved
; equivalence and operation-congruence lemmas. No quotient axiom is assumed.
; These are concrete prerequisites for the signed exponent-three source port.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias exists = ./logic-exists.lim::exists)
(#math-inductive integer ()
  ()
  (#pt-type 0)
  ((difference ((positive #pt-nat) (negative #pt-nat)))))
(#math-definition integer-of-natural ()
  (#pt-pi ((number #pt-nat)) (#pt-use integer ()))
  (#pt-lambda ((number #pt-nat)) (#pt-construct integer () () difference (number #pt-zero))))
(#math-definition integer-negative-natural ()
  (#pt-pi ((number #pt-nat)) (#pt-use integer ()))
  (#pt-lambda ((number #pt-nat)) (#pt-construct integer () () difference (#pt-zero number))))
(#math-definition integer-zero ()
  (#pt-use integer ())
  (#pt-app (#pt-use integer-of-natural ()) #pt-zero))
(#math-definition integer-one ()
  (#pt-use integer ())
  (#pt-app (#pt-use integer-of-natural ()) (#pt-succ #pt-zero)))
(#math-definition integer-equal ()
  (#pt-pi ((first (#pt-use integer ())) (second (#pt-use integer ()))) #pt-prop)
  (#pt-lambda
    ((first (#pt-use integer ())) (second (#pt-use integer ())))
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 second))
      (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 1 first)))))
(#math-definition integer-negate ()
  (#pt-pi ((number (#pt-use integer ()))) (#pt-use integer ()))
  (#pt-lambda
    ((number (#pt-use integer ())))
    (#pt-construct
      integer
      ()
      ()
      difference
      ((#pt-project integer 1 number) (#pt-project integer 0 number)))))
(#math-definition integer-add ()
  (#pt-pi ((first (#pt-use integer ())) (second (#pt-use integer ()))) (#pt-use integer ()))
  (#pt-lambda
    ((first (#pt-use integer ())) (second (#pt-use integer ())))
    (#pt-construct
      integer
      ()
      ()
      difference
      (
        (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 0 second))
        (#pt-app (#pt-use add ()) (#pt-project integer 1 first) (#pt-project integer 1 second))))))
(#math-definition integer-multiply ()
  (#pt-pi ((first (#pt-use integer ())) (second (#pt-use integer ()))) (#pt-use integer ()))
  (#pt-lambda
    ((first (#pt-use integer ())) (second (#pt-use integer ())))
    (#pt-construct
      integer
      ()
      ()
      difference
      (
        (#pt-app
          (#pt-use add ())
          (#pt-app
            (#pt-use multiply ())
            (#pt-project integer 0 first)
            (#pt-project integer 0 second))
          (#pt-app
            (#pt-use multiply ())
            (#pt-project integer 1 first)
            (#pt-project integer 1 second)))
        (#pt-app
          (#pt-use add ())
          (#pt-app
            (#pt-use multiply ())
            (#pt-project integer 0 first)
            (#pt-project integer 1 second))
          (#pt-app
            (#pt-use multiply ())
            (#pt-project integer 1 first)
            (#pt-project integer 0 second)))))))
(#math-definition integer-cube ()
  (#pt-pi ((number (#pt-use integer ()))) (#pt-use integer ()))
  (#pt-lambda
    ((number (#pt-use integer ())))
    (#pt-app
      (#pt-use integer-multiply ())
      number
      (#pt-app (#pt-use integer-multiply ()) number number))))
(#math-definition integer-power ()
  (#pt-pi ((number (#pt-use integer ())) (exponent #pt-nat)) (#pt-use integer ()))
  (#pt-lambda
    ((number (#pt-use integer ())) (exponent #pt-nat))
    (#pt-nat-induct
      (#pt-lambda ((ordinal #pt-nat)) (#pt-use integer ()))
      (#pt-use integer-one ())
      (#pt-lambda
        ((previous #pt-nat) (product (#pt-use integer ())))
        (#pt-app (#pt-use integer-multiply ()) number product))
      exponent)))
(#math-definition integer-divides ()
  (#pt-pi ((first (#pt-use integer ())) (second (#pt-use integer ()))) #pt-prop)
  (#pt-lambda
    ((first (#pt-use integer ())) (second (#pt-use integer ())))
    (#pt-app
      (#pt-use exists (0))
      (#pt-use integer ())
      (#pt-lambda
        ((factor (#pt-use integer ())))
        (#pt-app
          (#pt-use integer-equal ())
          second
          (#pt-app (#pt-use integer-multiply ()) first factor))))))
