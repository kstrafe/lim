; Adapted source: pinned Mathlib Algebra/Polynomial/Degree/Defs.lean
; and Degree/Operations.lean; Affine/Point.lean.
; Generated by scripts/generate-flt-polynomial-degrees.py; checked native terms.
; Support increases by one and is preserved by actual
; multiplication with a constant polynomial, proved by index transport
; and the constant-head product equation.
(#alias add = ./../fermat_statement.lim::add)
(#alias add-successor-right = ./natural-addition.lim::add-successor-right)
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-polynomial-coefficient = ./ring-polynomial-data.lim::ring-polynomial-coefficient)
(#alias
  ring-polynomial-degree-product-constant-head
  =
  ./ring-polynomial-degree-product-constant-head.lim::ring-polynomial-degree-product-constant-head)
(#alias ring-polynomial-multiply = ./ring-polynomial-data.lim::ring-polynomial-multiply)
(#alias ring-polynomial-reflexive = ./ring-polynomial-equivalence.lim::ring-polynomial-reflexive)
(#alias ring-polynomial-scale = ./ring-polynomial-data.lim::ring-polynomial-scale)
(#alias
  ring-polynomial-support-congruent
  =
  ./ring-polynomial-support-transport.lim::ring-polynomial-support-congruent)
(#alias
  ring-polynomial-support-from
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-support-from)
(#alias
  ring-polynomial-support-scale
  =
  ./ring-polynomial-support-operations.lim::ring-polynomial-support-scale)
(#alias ring-polynomial-symmetric = ./ring-polynomial-equivalence.lim::ring-polynomial-symmetric)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#alias substitution = ./equality.lim::substitution)
(#theorem ring-polynomial-support-successor
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter support-bound #pt-nat)
    (#parameter support (#pt-app (#pt-use ring-polynomial-support-from ()) Carrier coefficient-ring polynomial support-bound)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-support-from ())
      Carrier
      coefficient-ring
      polynomial
      (#pt-succ support-bound)))
  (#proof
    (#pt-lambda
      ((index #pt-nat))
      (#pt-app
        (#pt-use substitution (0))
        #pt-nat
        (#pt-lambda
          ((selected-index #pt-nat))
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-coefficient ())
              Carrier
              coefficient-ring
              polynomial
              selected-index)
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
        (#pt-app (#pt-use add ()) support-bound (#pt-succ index))
        (#pt-app (#pt-use add ()) (#pt-succ support-bound) index)
        (#pt-app (#pt-use add-successor-right ()) support-bound index)
        (#pt-app support (#pt-succ index))))))
(#theorem ring-polynomial-support-constant-product
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter scalar Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter support-bound #pt-nat)
    (#parameter support (#pt-app (#pt-use ring-polynomial-support-from ()) Carrier coefficient-ring polynomial support-bound)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-support-from ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-multiply ())
        Carrier
        coefficient-ring
        (#pt-construct
          finite-list
          ()
          (Carrier)
          cons
          (scalar (#pt-construct finite-list () (Carrier) nil ())))
        polynomial)
      support-bound))
  (#proof
    (#pt-app
      (#pt-use ring-polynomial-support-congruent ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-polynomial-scale ()) Carrier coefficient-ring scalar polynomial)
      (#pt-app
        (#pt-use ring-polynomial-multiply ())
        Carrier
        coefficient-ring
        (#pt-construct
          finite-list
          ()
          (Carrier)
          cons
          (scalar (#pt-construct finite-list () (Carrier) nil ())))
        polynomial)
      support-bound
      (#pt-app
        (#pt-use ring-polynomial-symmetric ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-multiply ())
          Carrier
          coefficient-ring
          (#pt-construct
            finite-list
            ()
            (Carrier)
            cons
            (scalar (#pt-construct finite-list () (Carrier) nil ())))
          polynomial)
        (#pt-app (#pt-use ring-polynomial-scale ()) Carrier coefficient-ring scalar polynomial)
        (#pt-app
          (#pt-use ring-polynomial-degree-product-constant-head ())
          Carrier
          coefficient-ring
          scalar
          (#pt-construct finite-list () (Carrier) nil ())
          polynomial
          (#pt-app
            (#pt-use ring-polynomial-reflexive ())
            Carrier
            coefficient-ring
            (#pt-construct finite-list () (Carrier) nil ()))))
      (#pt-app
        (#pt-use ring-polynomial-support-scale ())
        Carrier
        coefficient-ring
        scalar
        polynomial
        support-bound
        support))))
