; Generated by scripts/generate-flt-polynomial-degrees.py; checked native terms.
; Actual cross-multiplied natural equality decides zero
; for unreduced rational fractions. Existing proved rational one/product
; nonvanishing constructs the domain instance, preserving representatives.
(#alias add = ./../fermat_statement.lim::add)
(#alias decide-equality = ./natural-decision.lim::decide-equality)
(#alias decision = ./logical-decision.lim::decision)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-natural-embedding-nonzero = ./integer-domain.lim::integer-natural-embedding-nonzero)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-one = ./integer-defs.lim::integer-one)
(#alias rational = ./rational-defs.lim::rational)
(#alias rational-equal = ./rational-defs.lim::rational-equal)
(#alias rational-nonzero-integer = ./rational-fractions.lim::rational-nonzero-integer)
(#alias rational-nonzero-product = ./rational-ring.lim::rational-nonzero-product)
(#alias rational-one = ./rational-defs.lim::rational-one)
(#alias rational-ring-structure = ./rational-ring-structure.lim::rational-ring-structure)
(#alias rational-zero = ./rational-defs.lim::rational-zero)
(#alias
  ring-polynomial-domain-data
  =
  ./ring-polynomial-domain-data.lim::ring-polynomial-domain-data)
(#alias
  ring-polynomial-domain-one-nonzero
  =
  ./ring-polynomial-domain-data.lim::ring-polynomial-domain-one-nonzero)
(#alias successor-not-zero = ./natural-nonzero.lim::successor-not-zero)
(#math-definition ring-polynomial-degree-rational-zero-decider ()
  (#pt-pi
    ((coefficient (#pt-use rational ())))
    (#pt-app
      (#pt-use decision ())
      (#pt-app (#pt-use rational-equal ()) coefficient (#pt-use rational-zero ()))))
  (#pt-lambda
    ((coefficient (#pt-use rational ())))
    (#pt-app
      (#pt-use decide-equality ())
      (#pt-app
        (#pt-use add ())
        (#pt-project
          integer
          0
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 coefficient)
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-project rational 1 (#pt-use rational-zero ())))))
        (#pt-project
          integer
          1
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 (#pt-use rational-zero ()))
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 coefficient)))))
      (#pt-app
        (#pt-use add ())
        (#pt-project
          integer
          0
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 (#pt-use rational-zero ()))
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 coefficient))))
        (#pt-project
          integer
          1
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 coefficient)
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-project rational 1 (#pt-use rational-zero ())))))))))
(#math-definition ring-polynomial-domain-rational ()
  (#pt-app
    (#pt-use ring-polynomial-domain-data ())
    (#pt-use rational ())
    (#pt-use rational-ring-structure ()))
  (#pt-construct
    ring-polynomial-domain-data
    ()
    ((#pt-use rational ()) (#pt-use rational-ring-structure ()))
    domain
    (
      (#pt-app
        (#pt-use rational-nonzero-integer ())
        (#pt-use integer-one ())
        (#pt-app
          (#pt-use integer-natural-embedding-nonzero ())
          (#pt-succ #pt-zero)
          (#pt-app (#pt-use successor-not-zero ()) #pt-zero)))
      (#pt-use rational-nonzero-product ()))))
(#theorem ring-polynomial-domain-rational-one
  (#universes)
  (#parameters)
  (#statement
    (#pt-pi
      (
        (denied-evidence
          (#pt-app (#pt-use rational-equal ()) (#pt-use rational-one ()) (#pt-use rational-zero ()))))
      #pt-false))
  (#proof
    (#pt-app
      (#pt-use ring-polynomial-domain-one-nonzero ())
      (#pt-use rational ())
      (#pt-use rational-ring-structure ())
      (#pt-use ring-polynomial-domain-rational ()))))
