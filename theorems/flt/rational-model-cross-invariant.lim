; Authors: Kevin Buzzard, David Kurniadi Angdinata, Jz Pan
; Native rational specialization of pinned Mathlib VariableChange.lean.
; Candidate proof terms are checked by Lim; no algebra oracle is used.
; Cross-invariant identity for two actual admissible changes of a
; common rational curve, then for any coefficient-equivalent images.
; No nonzero discriminant or inverse-action/group theorem is assumed.
(#alias rational = ./rational-defs.lim::rational)
(#alias rational-equal = ./rational-defs.lim::rational-equal)
(#alias rational-multiply = ./rational-defs.lim::rational-multiply)
(#alias rational-power = ./rational-defs.lim::rational-power)
(#alias rational-reflexive = ./rational-equality.lim::rational-reflexive)
(#alias rational-symmetric = ./rational-equality.lim::rational-symmetric)
(#alias rational-transitive = ./rational-equality.lim::rational-transitive)
(#alias rational-multiply-congruent = ./rational-congruence.lim::rational-multiply-congruent)
(#alias rational-weierstrass-curve = ./rational-weierstrass-defs.lim::rational-weierstrass-curve)
(#alias rational-weierstrass-c4 = ./rational-weierstrass-defs.lim::rational-weierstrass-c4)
(#alias
  rational-weierstrass-discriminant
  =
  ./rational-weierstrass-defs.lim::rational-weierstrass-discriminant)
(#alias rational-multiply-commutative = ./rational-ring.lim::rational-multiply-commutative)
(#alias rational-power-congruent = ./rational-fractions.lim::rational-power-congruent)
(#alias
  rational-multiply-four-interchange
  =
  ./rational-power-laws.lim::rational-multiply-four-interchange)
(#alias
  rational-weierstrass-equivalent
  =
  ./weierstrass-model-equivalence.lim::rational-weierstrass-equivalent)
(#alias
  rational-weierstrass-c4-congruent
  =
  ./weierstrass-invariant-congruence.lim::rational-weierstrass-c4-congruent)
(#alias
  rational-weierstrass-discriminant-congruent
  =
  ./weierstrass-invariant-congruence.lim::rational-weierstrass-discriminant-congruent)
(#alias rational-variable-change = ./rational-variable-change-defs.lim::rational-variable-change)
(#alias
  rational-variable-change-act
  =
  ./rational-variable-change-defs.lim::rational-variable-change-act)
(#alias rational-scaled-c4-cube = ./rational-composite-powers.lim::rational-scaled-c4-cube)
(#alias
  rational-variable-change-c4
  =
  ./rational-variable-change-invariants.lim::rational-variable-change-c4)
(#alias
  rational-variable-change-discriminant
  =
  ./rational-variable-change-discriminant.lim::rational-variable-change-discriminant)
(#theorem rational-two-scaled-invariants-cross
  (#universes)
  (#parameters
    (#parameter first-inverse (#pt-use rational ()))
    (#parameter second-inverse (#pt-use rational ()))
    (#parameter c4 (#pt-use rational ()))
    (#parameter discriminant (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 4))
            c4)
          (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12))
          discriminant))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 4))
            c4)
          (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12))
          discriminant))))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 4))
            c4)
          (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12))
          discriminant))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12))
          (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3)))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12))
          discriminant))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 4))
            c4)
          (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12))
          discriminant))
      (#pt-app
        (#pt-use rational-multiply-congruent ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 4))
            c4)
          (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12))
          discriminant)
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12))
          (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3)))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12))
          discriminant)
        (#pt-app (#pt-use rational-scaled-c4-cube ()) first-inverse c4)
        (#pt-app
          (#pt-use rational-reflexive ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12))
            discriminant)))
      (#pt-app
        (#pt-use rational-transitive ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12))
            (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12))
            discriminant))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12))
            (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3))
            discriminant))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 4))
              c4)
            (#pt-numeral 3))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12))
            discriminant))
        (#pt-app
          (#pt-use rational-multiply-four-interchange ())
          (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12))
          (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3))
          (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12))
          discriminant)
        (#pt-app
          (#pt-use rational-transitive ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12))
              (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12)))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3))
              discriminant))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12))
              (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12)))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3))
              discriminant))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 4))
                c4)
              (#pt-numeral 3))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12))
              discriminant))
          (#pt-app
            (#pt-use rational-multiply-congruent ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12))
              (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12)))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3))
              discriminant)
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12))
              (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12)))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3))
              discriminant)
            (#pt-app
              (#pt-use rational-multiply-commutative ())
              (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12))
              (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12)))
            (#pt-app
              (#pt-use rational-reflexive ())
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3))
                discriminant)))
          (#pt-app
            (#pt-use rational-transitive ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12))
                (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12)))
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3))
                discriminant))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12))
                (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3)))
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12))
                discriminant))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 4))
                  c4)
                (#pt-numeral 3))
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12))
                discriminant))
            (#pt-app
              (#pt-use rational-symmetric ())
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12))
                  (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3)))
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12))
                  discriminant))
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12))
                  (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12)))
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3))
                  discriminant))
              (#pt-app
                (#pt-use rational-multiply-four-interchange ())
                (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12))
                (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3))
                (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12))
                discriminant))
            (#pt-app
              (#pt-use rational-multiply-congruent ())
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12))
                (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3)))
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12))
                discriminant)
              (#pt-app
                (#pt-use rational-power ())
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 4))
                  c4)
                (#pt-numeral 3))
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12))
                discriminant)
              (#pt-app
                (#pt-use rational-symmetric ())
                (#pt-app
                  (#pt-use rational-power ())
                  (#pt-app
                    (#pt-use rational-multiply ())
                    (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 4))
                    c4)
                  (#pt-numeral 3))
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app (#pt-use rational-power ()) second-inverse (#pt-numeral 12))
                  (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3)))
                (#pt-app (#pt-use rational-scaled-c4-cube ()) second-inverse c4))
              (#pt-app
                (#pt-use rational-reflexive ())
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app (#pt-use rational-power ()) first-inverse (#pt-numeral 12))
                  discriminant)))))))))
(#theorem rational-variable-changes-cross-invariant
  (#universes)
  (#parameters
    (#parameter first-change (#pt-use rational-variable-change ()))
    (#parameter second-change (#pt-use rational-variable-change ()))
    (#parameter curve (#pt-use rational-weierstrass-curve ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app
            (#pt-use rational-weierstrass-c4 ())
            (#pt-app (#pt-use rational-variable-change-act ()) first-change curve))
          (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-weierstrass-discriminant ())
          (#pt-app (#pt-use rational-variable-change-act ()) second-change curve)))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app
            (#pt-use rational-weierstrass-c4 ())
            (#pt-app (#pt-use rational-variable-change-act ()) second-change curve))
          (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-weierstrass-discriminant ())
          (#pt-app (#pt-use rational-variable-change-act ()) first-change curve)))))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app
            (#pt-use rational-weierstrass-c4 ())
            (#pt-app (#pt-use rational-variable-change-act ()) first-change curve))
          (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-weierstrass-discriminant ())
          (#pt-app (#pt-use rational-variable-change-act ()) second-change curve)))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-project rational-variable-change 1 first-change)
              (#pt-numeral 4))
            (#pt-app (#pt-use rational-weierstrass-c4 ()) curve))
          (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-project rational-variable-change 1 second-change)
            (#pt-numeral 12))
          (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve)))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app
            (#pt-use rational-weierstrass-c4 ())
            (#pt-app (#pt-use rational-variable-change-act ()) second-change curve))
          (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-weierstrass-discriminant ())
          (#pt-app (#pt-use rational-variable-change-act ()) first-change curve)))
      (#pt-app
        (#pt-use rational-multiply-congruent ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app
            (#pt-use rational-weierstrass-c4 ())
            (#pt-app (#pt-use rational-variable-change-act ()) first-change curve))
          (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-weierstrass-discriminant ())
          (#pt-app (#pt-use rational-variable-change-act ()) second-change curve))
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-project rational-variable-change 1 first-change)
              (#pt-numeral 4))
            (#pt-app (#pt-use rational-weierstrass-c4 ()) curve))
          (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-project rational-variable-change 1 second-change)
            (#pt-numeral 12))
          (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve))
        (#pt-app
          (#pt-use rational-power-congruent ())
          (#pt-app
            (#pt-use rational-weierstrass-c4 ())
            (#pt-app (#pt-use rational-variable-change-act ()) first-change curve))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-project rational-variable-change 1 first-change)
              (#pt-numeral 4))
            (#pt-app (#pt-use rational-weierstrass-c4 ()) curve))
          (#pt-numeral 3)
          (#pt-app (#pt-use rational-variable-change-c4 ()) first-change curve))
        (#pt-app (#pt-use rational-variable-change-discriminant ()) second-change curve))
      (#pt-app
        (#pt-use rational-transitive ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-project rational-variable-change 1 first-change)
                (#pt-numeral 4))
              (#pt-app (#pt-use rational-weierstrass-c4 ()) curve))
            (#pt-numeral 3))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-project rational-variable-change 1 second-change)
              (#pt-numeral 12))
            (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve)))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-project rational-variable-change 1 second-change)
                (#pt-numeral 4))
              (#pt-app (#pt-use rational-weierstrass-c4 ()) curve))
            (#pt-numeral 3))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-project rational-variable-change 1 first-change)
              (#pt-numeral 12))
            (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve)))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app
              (#pt-use rational-weierstrass-c4 ())
              (#pt-app (#pt-use rational-variable-change-act ()) second-change curve))
            (#pt-numeral 3))
          (#pt-app
            (#pt-use rational-weierstrass-discriminant ())
            (#pt-app (#pt-use rational-variable-change-act ()) first-change curve)))
        (#pt-app
          (#pt-use rational-two-scaled-invariants-cross ())
          (#pt-project rational-variable-change 1 first-change)
          (#pt-project rational-variable-change 1 second-change)
          (#pt-app (#pt-use rational-weierstrass-c4 ()) curve)
          (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve))
        (#pt-app
          (#pt-use rational-symmetric ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-app
                (#pt-use rational-weierstrass-c4 ())
                (#pt-app (#pt-use rational-variable-change-act ()) second-change curve))
              (#pt-numeral 3))
            (#pt-app
              (#pt-use rational-weierstrass-discriminant ())
              (#pt-app (#pt-use rational-variable-change-act ()) first-change curve)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-power ())
                  (#pt-project rational-variable-change 1 second-change)
                  (#pt-numeral 4))
                (#pt-app (#pt-use rational-weierstrass-c4 ()) curve))
              (#pt-numeral 3))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-project rational-variable-change 1 first-change)
                (#pt-numeral 12))
              (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve)))
          (#pt-app
            (#pt-use rational-multiply-congruent ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-app
                (#pt-use rational-weierstrass-c4 ())
                (#pt-app (#pt-use rational-variable-change-act ()) second-change curve))
              (#pt-numeral 3))
            (#pt-app
              (#pt-use rational-weierstrass-discriminant ())
              (#pt-app (#pt-use rational-variable-change-act ()) first-change curve))
            (#pt-app
              (#pt-use rational-power ())
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-power ())
                  (#pt-project rational-variable-change 1 second-change)
                  (#pt-numeral 4))
                (#pt-app (#pt-use rational-weierstrass-c4 ()) curve))
              (#pt-numeral 3))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-project rational-variable-change 1 first-change)
                (#pt-numeral 12))
              (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve))
            (#pt-app
              (#pt-use rational-power-congruent ())
              (#pt-app
                (#pt-use rational-weierstrass-c4 ())
