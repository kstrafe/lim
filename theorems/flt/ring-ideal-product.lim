(#math-definition ring-ideal-product ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
      (second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
    (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
      (second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
    (#pt-app
      (#pt-use ring-ideal-span ())
      Carrier
      coefficient-ring
      (#pt-lambda
        ((element Carrier))
        (#pt-app
          (#pt-use exists (0))
          Carrier
          (#pt-lambda
            ((left-factor Carrier))
            (#pt-app
              (#pt-use exists (0))
              Carrier
              (#pt-lambda
                ((right-factor Carrier))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use ring-ideal-member ())
                    Carrier
                    coefficient-ring
                    first-ideal
                    left-factor)
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app
                      (#pt-use ring-ideal-member ())
                      Carrier
                      coefficient-ring
                      second-ideal
                      right-factor)
                    (#pt-app
                      (#pt-use ring-equal ())
                      Carrier
                      coefficient-ring
                      element
                      (#pt-app
                        (#pt-use ring-multiply ())
                        Carrier
                        coefficient-ring
                        left-factor
                        right-factor))))))))))))
(#theorem ring-ideal-product-introduce
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter first-element Carrier)
    (#parameter second-element Carrier)
    (#parameter left-member (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring first-ideal first-element))
    (#parameter right-member (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring second-ideal second-element)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-member ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal second-ideal)
      (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element second-element)))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-span-generator ())
      Carrier
      coefficient-ring
      (#pt-lambda
        ((element Carrier))
        (#pt-app
          (#pt-use exists (0))
          Carrier
          (#pt-lambda
            ((left-factor Carrier))
            (#pt-app
              (#pt-use exists (0))
              Carrier
              (#pt-lambda
                ((right-factor Carrier))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use ring-ideal-member ())
                    Carrier
                    coefficient-ring
                    first-ideal
                    left-factor)
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app
                      (#pt-use ring-ideal-member ())
                      Carrier
                      coefficient-ring
                      second-ideal
                      right-factor)
                    (#pt-app
                      (#pt-use ring-equal ())
                      Carrier
                      coefficient-ring
                      element
                      (#pt-app
                        (#pt-use ring-multiply ())
                        Carrier
                        coefficient-ring
                        left-factor
                        right-factor)))))))))
      (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element second-element)
      (#pt-construct
        exists
        (0)
        (Carrier
          (#pt-lambda
            ((left-factor Carrier))
            (#pt-app
              (#pt-use exists (0))
              Carrier
              (#pt-lambda
                ((right-factor Carrier))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use ring-ideal-member ())
                    Carrier
                    coefficient-ring
                    first-ideal
                    left-factor)
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app
                      (#pt-use ring-ideal-member ())
                      Carrier
                      coefficient-ring
                      second-ideal
                      right-factor)
                    (#pt-app
                      (#pt-use ring-equal ())
                      Carrier
                      coefficient-ring
                      (#pt-app
                        (#pt-use ring-multiply ())
                        Carrier
                        coefficient-ring
                        first-element
                        second-element)
                      (#pt-app
                        (#pt-use ring-multiply ())
                        Carrier
                        coefficient-ring
                        left-factor
                        right-factor))))))))
        introduce
        (first-element
          (#pt-construct
            exists
            (0)
            (Carrier
              (#pt-lambda
                ((right-factor Carrier))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use ring-ideal-member ())
                    Carrier
                    coefficient-ring
                    first-ideal
                    first-element)
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app
                      (#pt-use ring-ideal-member ())
                      Carrier
                      coefficient-ring
                      second-ideal
                      right-factor)
                    (#pt-app
                      (#pt-use ring-equal ())
                      Carrier
                      coefficient-ring
                      (#pt-app
                        (#pt-use ring-multiply ())
                        Carrier
                        coefficient-ring
                        first-element
                        second-element)
                      (#pt-app
                        (#pt-use ring-multiply ())
                        Carrier
                        coefficient-ring
                        first-element
                        right-factor))))))
            introduce
            (second-element
              (#pt-app
                (#pt-use conjunction-introduce ())
                (#pt-app
                  (#pt-use ring-ideal-member ())
                  Carrier
                  coefficient-ring
                  first-ideal
                  first-element)
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use ring-ideal-member ())
                    Carrier
                    coefficient-ring
                    second-ideal
                    second-element)
                  (#pt-app
                    (#pt-use ring-equal ())
                    Carrier
                    coefficient-ring
                    (#pt-app
                      (#pt-use ring-multiply ())
                      Carrier
                      coefficient-ring
                      first-element
                      second-element)
                    (#pt-app
                      (#pt-use ring-multiply ())
                      Carrier
                      coefficient-ring
                      first-element
                      second-element)))
                left-member
                (#pt-app
                  (#pt-use conjunction-introduce ())
                  (#pt-app
                    (#pt-use ring-ideal-member ())
                    Carrier
                    coefficient-ring
                    second-ideal
                    second-element)
                  (#pt-app
                    (#pt-use ring-equal ())
                    Carrier
                    coefficient-ring
                    (#pt-app
                      (#pt-use ring-multiply ())
                      Carrier
                      coefficient-ring
                      first-element
                      second-element)
                    (#pt-app
                      (#pt-use ring-multiply ())
                      Carrier
                      coefficient-ring
                      first-element
                      second-element))
                  right-member
                  (#pt-app
                    (#pt-use ring-reflexive ())
                    Carrier
