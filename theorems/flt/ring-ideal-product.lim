(#theorem ring-ideal-product-least
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter third-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter products-contained (#pt-pi ((first-element Carrier) (second-element Carrier) (left-member (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring first-ideal first-element)) (right-member (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring second-ideal second-element))) (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring third-ideal (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element second-element)))))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal second-ideal)
      third-ideal))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-span-least ())
      Carrier
      coefficient-ring
      (#pt-lambda
        ((element Carrier))
        (#pt-app
          (#pt-use exists (0))
          Carrier
          (#pt-lambda
            ((left-factor Carrier))
            (#pt-app
              (#pt-use exists (0))
              Carrier
              (#pt-lambda
                ((right-factor Carrier))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use ring-ideal-member ())
                    Carrier
                    coefficient-ring
                    first-ideal
                    left-factor)
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app
                      (#pt-use ring-ideal-member ())
                      Carrier
                      coefficient-ring
                      second-ideal
                      right-factor)
                    (#pt-app
                      (#pt-use ring-equal ())
                      Carrier
                      coefficient-ring
                      element
                      (#pt-app
                        (#pt-use ring-multiply ())
                        Carrier
                        coefficient-ring
                        left-factor
                        right-factor)))))))))
      third-ideal
      (#pt-lambda
        (
          (element Carrier)
          (generator-proof
            (#pt-app
              (#pt-lambda
                ((element-bound-0000 Carrier))
                (#pt-app
                  (#pt-use exists (0))
                  Carrier
                  (#pt-lambda
                    ((left-factor Carrier))
                    (#pt-app
                      (#pt-use exists (0))
                      Carrier
                      (#pt-lambda
                        ((right-factor Carrier))
                        (#pt-app
                          (#pt-use conjunction ())
                          (#pt-app
                            (#pt-use ring-ideal-member ())
                            Carrier
                            coefficient-ring
                            first-ideal
                            left-factor)
                          (#pt-app
                            (#pt-use conjunction ())
                            (#pt-app
                              (#pt-use ring-ideal-member ())
                              Carrier
                              coefficient-ring
                              second-ideal
                              right-factor)
                            (#pt-app
                              (#pt-use ring-equal ())
                              Carrier
                              coefficient-ring
                              element-bound-0000
                              (#pt-app
                                (#pt-use ring-multiply ())
                                Carrier
                                coefficient-ring
                                left-factor
                                right-factor)))))))))
              element)))
        (#pt-induct
          exists
          (0)
          (Carrier
            (#pt-lambda
              ((left-factor Carrier))
              (#pt-app
                (#pt-use exists (0))
                Carrier
                (#pt-lambda
                  ((right-factor Carrier))
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app
                      (#pt-use ring-ideal-member ())
                      Carrier
                      coefficient-ring
                      first-ideal
                      left-factor)
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app
                        (#pt-use ring-ideal-member ())
                        Carrier
                        coefficient-ring
                        second-ideal
                        right-factor)
                      (#pt-app
                        (#pt-use ring-equal ())
                        Carrier
                        coefficient-ring
                        element
                        (#pt-app
                          (#pt-use ring-multiply ())
                          Carrier
                          coefficient-ring
                          left-factor
                          right-factor))))))))
          (#pt-lambda
            (
              (product-certificate
                (#pt-app
                  (#pt-lambda
                    ((element-bound-0001 Carrier))
                    (#pt-app
                      (#pt-use exists (0))
                      Carrier
                      (#pt-lambda
                        ((left-factor Carrier))
                        (#pt-app
                          (#pt-use exists (0))
                          Carrier
                          (#pt-lambda
                            ((right-factor Carrier))
                            (#pt-app
                              (#pt-use conjunction ())
                              (#pt-app
                                (#pt-use ring-ideal-member ())
                                Carrier
                                coefficient-ring
                                first-ideal
                                left-factor)
                              (#pt-app
                                (#pt-use conjunction ())
                                (#pt-app
                                  (#pt-use ring-ideal-member ())
                                  Carrier
                                  coefficient-ring
                                  second-ideal
                                  right-factor)
                                (#pt-app
                                  (#pt-use ring-equal ())
                                  Carrier
                                  coefficient-ring
                                  element-bound-0001
                                  (#pt-app
                                    (#pt-use ring-multiply ())
                                    Carrier
                                    coefficient-ring
                                    left-factor
                                    right-factor)))))))))
                  element)))
            (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring third-ideal element))
          (
            (#pt-lambda
              (
                (product-left Carrier)
                (left-product-certificate
                  (#pt-app
                    (#pt-use exists (0))
                    Carrier
                    (#pt-lambda
                      ((right-factor Carrier))
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-app
                          (#pt-use ring-ideal-member ())
                          Carrier
                          coefficient-ring
                          first-ideal
                          product-left)
                        (#pt-app
                          (#pt-use conjunction ())
                          (#pt-app
                            (#pt-use ring-ideal-member ())
                            Carrier
                            coefficient-ring
                            second-ideal
                            right-factor)
                          (#pt-app
                            (#pt-use ring-equal ())
                            Carrier
                            coefficient-ring
                            element
                            (#pt-app
                              (#pt-use ring-multiply ())
                              Carrier
                              coefficient-ring
                              product-left
                              right-factor))))))))
              (#pt-induct
                exists
                (0)
                (Carrier
                  (#pt-lambda
                    ((right-factor Carrier))
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app
                        (#pt-use ring-ideal-member ())
                        Carrier
                        coefficient-ring
                        first-ideal
                        product-left)
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-app
                          (#pt-use ring-ideal-member ())
                          Carrier
                          coefficient-ring
                          second-ideal
                          right-factor)
                        (#pt-app
                          (#pt-use ring-equal ())
                          Carrier
                          coefficient-ring
                          element
                          (#pt-app
                            (#pt-use ring-multiply ())
                            Carrier
                            coefficient-ring
                            product-left
                            right-factor))))))
                (#pt-lambda
                  (
                    (right-product-certificate
                      (#pt-app
                        (#pt-use exists (0))
                        Carrier
                        (#pt-lambda
                          ((right-factor Carrier))
                          (#pt-app
                            (#pt-use conjunction ())
                            (#pt-app
                              (#pt-use ring-ideal-member ())
                              Carrier
                              coefficient-ring
                              first-ideal
                              product-left)
                            (#pt-app
                              (#pt-use conjunction ())
                              (#pt-app
                                (#pt-use ring-ideal-member ())
                                Carrier
                                coefficient-ring
                                second-ideal
                                right-factor)
                              (#pt-app
                                (#pt-use ring-equal ())
                                Carrier
                                coefficient-ring
                                element
                                (#pt-app
                                  (#pt-use ring-multiply ())
                                  Carrier
                                  coefficient-ring
                                  product-left
                                  right-factor))))))))
                  (#pt-app
                    (#pt-use ring-ideal-member ())
                    Carrier
                    coefficient-ring
                    third-ideal
                    element))
                (
                  (#pt-lambda
                    (
                      (product-right Carrier)
                      (product-evidence
                        (#pt-app
                          (#pt-use conjunction ())
                          (#pt-app
                            (#pt-use ring-ideal-member ())
                            Carrier
                            coefficient-ring
                            first-ideal
                            product-left)
                          (#pt-app
                            (#pt-use conjunction ())
                            (#pt-app
                              (#pt-use ring-ideal-member ())
                              Carrier
                              coefficient-ring
                              second-ideal
                              product-right)
                            (#pt-app
                              (#pt-use ring-equal ())
                              Carrier
                              coefficient-ring
                              element
                              (#pt-app
                                (#pt-use ring-multiply ())
                                Carrier
                                coefficient-ring
                                product-left
                                product-right))))))
                    (#pt-app
                      (#pt-use ring-ideal-member-congruent ())
                      Carrier
                      coefficient-ring
                      third-ideal
                      (#pt-app
                        (#pt-use ring-multiply ())
                        Carrier
                        coefficient-ring
                        product-left
                        product-right)
                      element
                      (#pt-app
                        (#pt-use ring-symmetric ())
                        Carrier
                        coefficient-ring
                        element
                        (#pt-app
                          (#pt-use ring-multiply ())
                          Carrier
                          coefficient-ring
                          product-left
                          product-right)
                        (#pt-project conjunction 1 (#pt-project conjunction 1 product-evidence)))
                      (#pt-app
                        products-contained
                        product-left
                        product-right
                        (#pt-project conjunction 0 product-evidence)
                        (#pt-project conjunction 0 (#pt-project conjunction 1 product-evidence))))))
                left-product-certificate)))
          generator-proof)))))
