; Adapted source: pinned Mathlib Affine/Point.lean:409-470.
; All polynomial, coefficient-domain and index facts are proved.
; Generated by scripts/generate-flt-norm-degrees.py; checked native terms.
; For every coordinate pair, the actual norm cannot have
; degree1. Both zero inputs, either single zero input and every
; possible natural leading-degree pair are discharged explicitly.
; This theorem needs no coefficient zero decider or new logical axiom.
(#alias add = ./../fermat_statement.lim::add)
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias
  coordinate-norm-degree-both-zero
  =
  ./coordinate-norm-degree-zero-equations.lim::coordinate-norm-degree-both-zero)
(#alias
  coordinate-norm-degree-contradict-leading
  =
  ./coordinate-norm-degree-contradictions.lim::coordinate-norm-degree-contradict-leading)
(#alias
  coordinate-norm-degree-contradict-zero
  =
  ./coordinate-norm-degree-contradictions.lim::coordinate-norm-degree-contradict-zero)
(#alias
  coordinate-norm-degree-cubic-not-one
  =
  ./coordinate-norm-degree-integer-exclusion.lim::coordinate-norm-degree-cubic-not-one)
(#alias
  coordinate-norm-degree-double-not-one
  =
  ./coordinate-norm-degree-integer-exclusion.lim::coordinate-norm-degree-double-not-one)
(#alias
  coordinate-norm-degree-exhaustive-elimination
  =
  ./coordinate-norm-degree-exhaustive.lim::coordinate-norm-degree-exhaustive-elimination)
(#alias
  coordinate-norm-degree-nonzero-inputs-not-one
  =
  ./coordinate-norm-degree-nonzero-exclusion.lim::coordinate-norm-degree-nonzero-inputs-not-one)
(#alias
  coordinate-norm-degree-value
  =
  ./coordinate-norm-degree-formula.lim::coordinate-norm-degree-value)
(#alias
  coordinate-norm-degree-zero-constant
  =
  ./coordinate-norm-degree-zero-cases.lim::coordinate-norm-degree-zero-constant)
(#alias
  coordinate-norm-degree-zero-linear
  =
  ./coordinate-norm-degree-zero-cases.lim::coordinate-norm-degree-zero-linear)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias
  ring-polynomial-degree-witness
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-degree-witness)
(#alias
  ring-polynomial-domain-data
  =
  ./ring-polynomial-domain-data.lim::ring-polynomial-domain-data)
(#alias ring-polynomial-equal = ./ring-polynomial-data.lim::ring-polynomial-equal)
(#theorem coordinate-norm-degree-zero-constant-not-one
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter zero-constant (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring polynomial (#pt-construct finite-list () (Carrier) nil ()))))
  (#statement
    (#pt-pi
      (
        (denied-evidence
          (#pt-app
            (#pt-use ring-polynomial-degree-witness ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use coordinate-norm-degree-value ())
              Carrier
              coefficient-ring
              a1
              a2
              a3
              a4
              a6
              polynomial
              other-polynomial)
            (#pt-numeral 1))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (degree-one-certificate
          (#pt-app
            (#pt-use ring-polynomial-degree-witness ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use coordinate-norm-degree-value ())
              Carrier
              coefficient-ring
              a1
              a2
              a3
              a4
              a6
              polynomial
              other-polynomial)
            (#pt-numeral 1))))
      (#pt-app
        (#pt-use coordinate-norm-degree-exhaustive-elimination ())
        Carrier
        coefficient-ring
        other-polynomial
        (#pt-lambda
          (
            (zero-linear
              (#pt-app
                (#pt-use ring-polynomial-equal ())
                Carrier
                coefficient-ring
                other-polynomial
                (#pt-construct finite-list () (Carrier) nil ()))))
          (#pt-app
            (#pt-use coordinate-norm-degree-contradict-zero ())
            Carrier
            coefficient-ring
            a1
            a2
            a3
            a4
            a6
            polynomial
            other-polynomial
            (#pt-app
              (#pt-use coordinate-norm-degree-both-zero ())
              Carrier
              coefficient-ring
              a1
              a2
              a3
              a4
              a6
              polynomial
              other-polynomial
              zero-constant
              zero-linear)
            degree-one-certificate))
        (#pt-lambda
          (
            (linear-degree #pt-nat)
            (linear-certificate
              (#pt-app
                (#pt-use ring-polynomial-degree-witness ())
                Carrier
                coefficient-ring
                other-polynomial
                linear-degree)))
          (#pt-app
            (#pt-use coordinate-norm-degree-contradict-leading ())
            Carrier
            coefficient-ring
            a1
            a2
            a3
            a4
            a6
            polynomial
            other-polynomial
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use add ()) linear-degree linear-degree)
              (#pt-numeral 3))
            (#pt-app
              (#pt-use coordinate-norm-degree-zero-constant ())
              Carrier
              coefficient-ring
              coefficient-domain
              a1
              a2
              a3
              a4
              a6
              polynomial
              other-polynomial
              linear-degree
              zero-constant
              linear-certificate)
            (#pt-app (#pt-use coordinate-norm-degree-cubic-not-one ()) linear-degree)
            degree-one-certificate))))))
(#theorem coordinate-norm-degree-not-one
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
  (#statement
    (#pt-pi
      (
        (denied-evidence
          (#pt-app
            (#pt-use ring-polynomial-degree-witness ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use coordinate-norm-degree-value ())
              Carrier
              coefficient-ring
              a1
              a2
              a3
              a4
              a6
              polynomial
              other-polynomial)
            (#pt-numeral 1))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (degree-one-certificate
          (#pt-app
            (#pt-use ring-polynomial-degree-witness ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use coordinate-norm-degree-value ())
              Carrier
              coefficient-ring
              a1
              a2
              a3
              a4
              a6
              polynomial
              other-polynomial)
            (#pt-numeral 1))))
      (#pt-app
        (#pt-use coordinate-norm-degree-exhaustive-elimination ())
        Carrier
        coefficient-ring
        polynomial
        (#pt-lambda
          (
            (zero-constant
              (#pt-app
                (#pt-use ring-polynomial-equal ())
                Carrier
                coefficient-ring
                polynomial
                (#pt-construct finite-list () (Carrier) nil ()))))
          (#pt-app
            (#pt-app
              (#pt-use coordinate-norm-degree-zero-constant-not-one ())
              Carrier
              coefficient-ring
              coefficient-domain
              a1
              a2
              a3
              a4
              a6
              polynomial
              other-polynomial
              zero-constant)
            degree-one-certificate))
        (#pt-lambda
          (
            (constant-degree #pt-nat)
            (constant-certificate
              (#pt-app
                (#pt-use ring-polynomial-degree-witness ())
                Carrier
                coefficient-ring
                polynomial
                constant-degree)))
          (#pt-app
            (#pt-use coordinate-norm-degree-exhaustive-elimination ())
            Carrier
            coefficient-ring
            other-polynomial
            (#pt-lambda
              (
                (zero-linear
                  (#pt-app
                    (#pt-use ring-polynomial-equal ())
                    Carrier
                    coefficient-ring
                    other-polynomial
                    (#pt-construct finite-list () (Carrier) nil ()))))
              (#pt-app
                (#pt-use coordinate-norm-degree-contradict-leading ())
                Carrier
                coefficient-ring
                a1
                a2
                a3
                a4
                a6
                polynomial
                other-polynomial
                (#pt-app (#pt-use add ()) constant-degree constant-degree)
                (#pt-app
                  (#pt-use coordinate-norm-degree-zero-linear ())
                  Carrier
                  coefficient-ring
                  coefficient-domain
                  a1
                  a2
                  a3
                  a4
                  a6
                  polynomial
                  other-polynomial
                  constant-degree
                  constant-certificate
                  zero-linear)
                (#pt-app (#pt-use coordinate-norm-degree-double-not-one ()) constant-degree)
                degree-one-certificate))
            (#pt-lambda
              (
                (linear-degree #pt-nat)
                (linear-certificate
                  (#pt-app
                    (#pt-use ring-polynomial-degree-witness ())
                    Carrier
                    coefficient-ring
                    other-polynomial
                    linear-degree)))
              (#pt-app
                (#pt-app
                  (#pt-use coordinate-norm-degree-nonzero-inputs-not-one ())
                  Carrier
                  coefficient-ring
                  coefficient-domain
                  a1
                  a2
                  a3
                  a4
                  a6
                  polynomial
                  other-polynomial
                  constant-degree
                  linear-degree
                  constant-certificate
                  linear-certificate)
                degree-one-certificate))))))))
