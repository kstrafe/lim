      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-coefficient ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-polynomial-shift ()) Carrier coefficient-ring polynomial)
        #pt-zero)
      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
  (#proof
    (#pt-app
      (#pt-use ring-reflexive ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
(#theorem ring-polynomial-shift-successor-coefficient
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter coefficient-index #pt-nat))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-coefficient ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-polynomial-shift ()) Carrier coefficient-ring polynomial)
        (#pt-succ coefficient-index))
      (#pt-app
        (#pt-use ring-polynomial-coefficient ())
        Carrier
        coefficient-ring
        polynomial
        coefficient-index)))
  (#proof
    (#pt-app
      (#pt-use ring-reflexive ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-coefficient ())
        Carrier
        coefficient-ring
