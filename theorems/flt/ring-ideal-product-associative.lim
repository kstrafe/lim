            (#pt-use ring-ideal-product ())
            Carrier
            coefficient-ring
            second-ideal
            third-ideal)
          first-ideal)
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-ideal-product ())
            Carrier
            coefficient-ring
            first-ideal
            second-ideal)
          third-ideal)
        (#pt-project
