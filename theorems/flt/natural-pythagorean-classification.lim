; Positive primitive Pythagorean triples with an odd first leg.
; This is a Nat specialization of the source primitive classification.
; Difference is retained as x+n*n=m*m, avoiding truncated subtraction.
; Signed normalization and the FLT exponent-four descent are separate work.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#alias odd = ./natural-parity.lim::odd)
(#alias even-or-odd = ./natural-parity.lim::even-or-odd)
(#alias odd-nonzero = ./natural-parity-arithmetic.lim::odd-nonzero)
(#alias odd-plus-odd-is-even = ./natural-parity-arithmetic.lim::odd-plus-odd-is-even)
(#alias odd-square-is-odd = ./natural-parity-arithmetic.lim::odd-square-is-odd)
(#alias odd-even-exclusion = ./natural-parity-arithmetic.lim::odd-even-exclusion)
(#alias
  pythagorean-odd-leg-even-other
  =
  ./natural-parity-arithmetic.lim::pythagorean-odd-leg-even-other)
(#alias
  pythagorean-odd-leg-odd-hypotenuse
  =
  ./natural-parity-arithmetic.lim::pythagorean-odd-leg-odd-hypotenuse)
(#alias prime-two = ./natural-prime-two.lim::prime-two)
(#alias prime-not-one = ./natural-prime-divisibility.lim::prime-not-one)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias divides-multiple = ./natural-divisibility.lim::divides-multiple)
(#alias divides-transitive = ./natural-divisibility.lim::divides-transitive)
(#alias coprime = ./natural-coprime.lim::coprime)
(#alias coprime-symmetric = ./natural-coprime.lim::coprime-symmetric)
