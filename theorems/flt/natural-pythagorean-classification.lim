(#alias coprime-product-square = ./natural-square-factors.lim::coprime-product-square)
(#alias square-product = ./natural-square-arithmetic.lim::square-product)
(#alias square-injective = ./natural-square-order.lim::square-injective)
(#alias square-order-reflect = ./natural-square-order.lim::square-order-reflect)
(#alias positive-summand-above = ./natural-square-order.lim::positive-summand-above)
(#alias
  pythagorean-leg-below-hypotenuse
  =
  ./natural-square-order.lim::pythagorean-leg-below-hypotenuse)
(#alias
  pythagorean-coprime-hypotenuse
  =
  ./natural-pythagorean-halves.lim::pythagorean-coprime-hypotenuse)
(#alias odd-increasing-even-gap = ./natural-pythagorean-halves.lim::odd-increasing-even-gap)
(#alias pythagorean-halves-coprime = ./natural-pythagorean-halves.lim::pythagorean-halves-coprime)
(#alias pythagorean-half-product = ./natural-pythagorean-halves.lim::pythagorean-half-product)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-left = ./logical-connectives.lim::disjunction-left)
(#alias disjunction-right = ./logical-connectives.lim::disjunction-right)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias double-as-sum = ./natural-semiring-identities.lim::double-as-sum)
(#alias add-associative = ./natural-addition.lim::add-associative)
(#alias multiply-commutative = ./natural-multiplication-commutative.lim::multiply-commutative)
(#alias multiply-zero-right = ./natural-multiplication-right.lim::multiply-zero-right)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias congruence = ./equality.lim::congruence)
(#alias substitution = ./equality.lim::substitution)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#math-definition opposite-parity ()
  (#pt-pi ((larger #pt-nat) (smaller #pt-nat)) #pt-prop)
  (#pt-lambda
    ((larger #pt-nat) (smaller #pt-nat))
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) larger)
        (#pt-app (#pt-use odd ()) smaller))
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app (#pt-use odd ()) larger)
        (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) smaller)))))
(#math-inductive pythagorean-parameters ()
  ((first #pt-nat) (second #pt-nat) (hypotenuse #pt-nat) (larger #pt-nat) (smaller #pt-nat))
  #pt-prop
  (
    (introduce
      (
        (difference-equation
          (#pt-eq
            #pt-nat
            (#pt-app (#pt-use add ()) first (#pt-app (#pt-use multiply ()) smaller smaller))
            (#pt-app (#pt-use multiply ()) larger larger)))
        (second-equation
          (#pt-eq
            #pt-nat
            second
            (#pt-app
              (#pt-use multiply ())
              (#pt-succ (#pt-succ #pt-zero))
              (#pt-app (#pt-use multiply ()) larger smaller))))
        (hypotenuse-equation
          (#pt-eq
            #pt-nat
            hypotenuse
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use multiply ()) larger larger)
              (#pt-app (#pt-use multiply ()) smaller smaller))))
        (coprime-proof (#pt-app (#pt-use coprime ()) larger smaller))
        (parity-proof (#pt-app (#pt-use opposite-parity ()) larger smaller))
        (increasing-proof (#pt-app (#pt-use less-than ()) smaller larger))
        (smaller-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat smaller #pt-zero))) #pt-false))))))
(#theorem pythagorean-parameter-opposite-parity
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter larger #pt-nat)
    (#parameter smaller #pt-nat)
    (#parameter first-odd (#pt-app (#pt-use odd ()) first))
    (#parameter difference-equation (#pt-eq #pt-nat (#pt-app (#pt-use add ()) first (#pt-app (#pt-use multiply ()) smaller smaller)) (#pt-app (#pt-use multiply ()) larger larger)))
    (#parameter coprime-proof (#pt-app (#pt-use coprime ()) larger smaller)))
  (#statement (#pt-app (#pt-use opposite-parity ()) larger smaller))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) larger)
      (#pt-app (#pt-use odd ()) larger)
      (#pt-app (#pt-use opposite-parity ()) larger smaller)
      (#pt-lambda
        ((larger-even (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) larger)))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) smaller)
          (#pt-app (#pt-use odd ()) smaller)
          (#pt-app (#pt-use opposite-parity ()) larger smaller)
          (#pt-lambda
            ((smaller-even (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) smaller)))
            (#pt-app
              (#pt-use false-elimination ())
              (#pt-app (#pt-use opposite-parity ()) larger smaller)
              (#pt-app
                (#pt-app
                  (#pt-use prime-not-one ())
                  (#pt-succ (#pt-succ #pt-zero))
                  (#pt-use prime-two ()))
                (#pt-app coprime-proof (#pt-succ (#pt-succ #pt-zero)) larger-even smaller-even))))
          (#pt-lambda
            ((smaller-odd (#pt-app (#pt-use odd ()) smaller)))
            (#pt-app
              (#pt-use disjunction-left ())
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) larger)
                (#pt-app (#pt-use odd ()) smaller))
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use odd ()) larger)
                (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) smaller))
              (#pt-app
                (#pt-use conjunction-introduce ())
                (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) larger)
                (#pt-app (#pt-use odd ()) smaller)
                larger-even
                smaller-odd)))
          (#pt-app (#pt-use even-or-odd ()) smaller)))
      (#pt-lambda
        ((larger-odd (#pt-app (#pt-use odd ()) larger)))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) smaller)
          (#pt-app (#pt-use odd ()) smaller)
          (#pt-app (#pt-use opposite-parity ()) larger smaller)
          (#pt-lambda
            ((smaller-even (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) smaller)))
            (#pt-app
              (#pt-use disjunction-right ())
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) larger)
                (#pt-app (#pt-use odd ()) smaller))
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use odd ()) larger)
                (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) smaller))
              (#pt-app
                (#pt-use conjunction-introduce ())
                (#pt-app (#pt-use odd ()) larger)
                (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) smaller)
                larger-odd
                smaller-even)))
          (#pt-lambda
            ((smaller-odd (#pt-app (#pt-use odd ()) smaller)))
            (#pt-app
              (#pt-use false-elimination ())
              (#pt-app (#pt-use opposite-parity ()) larger smaller)
              (#pt-app
                (#pt-use odd-even-exclusion ())
                (#pt-app (#pt-use multiply ()) larger larger)
                (#pt-app (#pt-use odd-square-is-odd ()) larger larger-odd)
                (#pt-app
                  (#pt-use substitution (0))
                  #pt-nat
                  (#pt-lambda
                    ((endpoint #pt-nat))
                    (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) endpoint))
                  (#pt-app (#pt-use add ()) first (#pt-app (#pt-use multiply ()) smaller smaller))
                  (#pt-app (#pt-use multiply ()) larger larger)
                  difference-equation
                  (#pt-app
                    (#pt-use odd-plus-odd-is-even ())
                    first
                    (#pt-app (#pt-use multiply ()) smaller smaller)
                    first-odd
                    (#pt-app (#pt-use odd-square-is-odd ()) smaller smaller-odd))))))
          (#pt-app (#pt-use even-or-odd ()) smaller)))
      (#pt-app (#pt-use even-or-odd ()) larger))))
(#theorem pythagorean-parameters-from-halves
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter hypotenuse #pt-nat)
    (#parameter second-half #pt-nat)
    (#parameter gap-half #pt-nat)
    (#parameter larger #pt-nat)
    (#parameter smaller #pt-nat)
    (#parameter first-odd (#pt-app (#pt-use odd ()) first))
    (#parameter second-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat second #pt-zero))) #pt-false))
    (#parameter second-gap (#pt-eq #pt-nat second (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) second-half)))
    (#parameter hypotenuse-gap (#pt-eq #pt-nat hypotenuse (#pt-app (#pt-use add ()) first (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) gap-half))))
    (#parameter square-equation (#pt-eq #pt-nat (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) first first) (#pt-app (#pt-use multiply ()) second second)) (#pt-app (#pt-use multiply ()) hypotenuse hypotenuse)))
    (#parameter halves-coprime (#pt-app (#pt-use coprime ()) gap-half (#pt-app (#pt-use add ()) first gap-half)))
    (#parameter lower-square (#pt-eq #pt-nat gap-half (#pt-app (#pt-use multiply ()) smaller smaller)))
    (#parameter upper-square (#pt-eq #pt-nat (#pt-app (#pt-use add ()) first gap-half) (#pt-app (#pt-use multiply ()) larger larger))))
  (#statement (#pt-app (#pt-use pythagorean-parameters ()) first second hypotenuse larger smaller))
  (#proof
    (#pt-construct
      pythagorean-parameters
      ()
      (first second hypotenuse larger smaller)
      introduce
      (
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          (#pt-app (#pt-use add ()) first (#pt-app (#pt-use multiply ()) smaller smaller))
          (#pt-app (#pt-use add ()) first gap-half)
          (#pt-app (#pt-use multiply ()) larger larger)
          (#pt-app
            (#pt-use congruence (0 0))
            #pt-nat
            #pt-nat
            (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use add ()) first endpoint))
            (#pt-app (#pt-use multiply ()) smaller smaller)
            gap-half
            (#pt-app
              (#pt-use symmetry (0))
              #pt-nat
              gap-half
              (#pt-app (#pt-use multiply ()) smaller smaller)
              lower-square))
          upper-square)
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          second
          (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) second-half)
          (#pt-app
            (#pt-use multiply ())
            (#pt-succ (#pt-succ #pt-zero))
            (#pt-app (#pt-use multiply ()) larger smaller))
          second-gap
          (#pt-app
            (#pt-use congruence (0 0))
            #pt-nat
            #pt-nat
            (#pt-lambda
              ((endpoint #pt-nat))
              (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) endpoint))
            second-half
            (#pt-app (#pt-use multiply ()) larger smaller)
            (#pt-app
              (#pt-use square-injective ())
              second-half
              (#pt-app (#pt-use multiply ()) larger smaller)
              (#pt-app
                (#pt-use transitivity (0))
                #pt-nat
                (#pt-app (#pt-use multiply ()) second-half second-half)
                (#pt-app (#pt-use multiply ()) gap-half (#pt-app (#pt-use add ()) first gap-half))
                (#pt-app
                  (#pt-use multiply ())
                  (#pt-app (#pt-use multiply ()) larger smaller)
                  (#pt-app (#pt-use multiply ()) larger smaller))
                (#pt-app
                  (#pt-use pythagorean-half-product ())
                  first
                  second
                  hypotenuse
                  second-half
                  gap-half
                  second-gap
                  hypotenuse-gap
                  square-equation)
                (#pt-app
                  (#pt-use transitivity (0))
                  #pt-nat
                  (#pt-app (#pt-use multiply ()) gap-half (#pt-app (#pt-use add ()) first gap-half))
                  (#pt-app
                    (#pt-use multiply ())
                    (#pt-app (#pt-use multiply ()) smaller smaller)
                    (#pt-app (#pt-use add ()) first gap-half))
                  (#pt-app
                    (#pt-use multiply ())
                    (#pt-app (#pt-use multiply ()) larger smaller)
                    (#pt-app (#pt-use multiply ()) larger smaller))
                  (#pt-app
                    (#pt-use congruence (0 0))
                    #pt-nat
                    #pt-nat
                    (#pt-lambda
                      ((endpoint #pt-nat))
                      (#pt-app
                        (#pt-use multiply ())
                        endpoint
                        (#pt-app (#pt-use add ()) first gap-half)))
                    gap-half
                    (#pt-app (#pt-use multiply ()) smaller smaller)
                    lower-square)
                  (#pt-app
                    (#pt-use transitivity (0))
                    #pt-nat
                    (#pt-app
                      (#pt-use multiply ())
                      (#pt-app (#pt-use multiply ()) smaller smaller)
                      (#pt-app (#pt-use add ()) first gap-half))
                    (#pt-app
                      (#pt-use multiply ())
                      (#pt-app (#pt-use multiply ()) smaller smaller)
                      (#pt-app (#pt-use multiply ()) larger larger))
                    (#pt-app
                      (#pt-use multiply ())
                      (#pt-app (#pt-use multiply ()) larger smaller)
                      (#pt-app (#pt-use multiply ()) larger smaller))
                    (#pt-app
                      (#pt-use congruence (0 0))
                      #pt-nat
                      #pt-nat
                      (#pt-lambda
                        ((endpoint #pt-nat))
                        (#pt-app
                          (#pt-use multiply ())
                          (#pt-app (#pt-use multiply ()) smaller smaller)
                          endpoint))
                      (#pt-app (#pt-use add ()) first gap-half)
                      (#pt-app (#pt-use multiply ()) larger larger)
                      upper-square)
                    (#pt-app
                      (#pt-use transitivity (0))
                      #pt-nat
                      (#pt-app
                        (#pt-use multiply ())
                        (#pt-app (#pt-use multiply ()) smaller smaller)
                        (#pt-app (#pt-use multiply ()) larger larger))
                      (#pt-app
                        (#pt-use multiply ())
                        (#pt-app (#pt-use multiply ()) larger larger)
                        (#pt-app (#pt-use multiply ()) smaller smaller))
                      (#pt-app
                        (#pt-use multiply ())
                        (#pt-app (#pt-use multiply ()) larger smaller)
                        (#pt-app (#pt-use multiply ()) larger smaller))
                      (#pt-app
                        (#pt-use multiply-commutative ())
                        (#pt-app (#pt-use multiply ()) smaller smaller)
                        (#pt-app (#pt-use multiply ()) larger larger))
                      (#pt-app
                        (#pt-use symmetry (0))
                        #pt-nat
                        (#pt-app
                          (#pt-use multiply ())
                          (#pt-app (#pt-use multiply ()) larger smaller)
                          (#pt-app (#pt-use multiply ()) larger smaller))
                        (#pt-app
                          (#pt-use multiply ())
                          (#pt-app (#pt-use multiply ()) larger larger)
                          (#pt-app (#pt-use multiply ()) smaller smaller))
                        (#pt-app (#pt-use square-product ()) larger smaller)))))))))
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          hypotenuse
          (#pt-app
            (#pt-use add ())
            first
            (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) gap-half))
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use multiply ()) larger larger)
            (#pt-app (#pt-use multiply ()) smaller smaller))
          hypotenuse-gap
          (#pt-app
            (#pt-use transitivity (0))
            #pt-nat
            (#pt-app
              (#pt-use add ())
              first
              (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) gap-half))
            (#pt-app (#pt-use add ()) first (#pt-app (#pt-use add ()) gap-half gap-half))
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use multiply ()) larger larger)
              (#pt-app (#pt-use multiply ()) smaller smaller))
            (#pt-app
              (#pt-use congruence (0 0))
              #pt-nat
              #pt-nat
              (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use add ()) first endpoint))
              (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) gap-half)
              (#pt-app (#pt-use add ()) gap-half gap-half)
              (#pt-app (#pt-use double-as-sum ()) gap-half))
            (#pt-app
              (#pt-use transitivity (0))
              #pt-nat
              (#pt-app (#pt-use add ()) first (#pt-app (#pt-use add ()) gap-half gap-half))
              (#pt-app (#pt-use add ()) (#pt-app (#pt-use add ()) first gap-half) gap-half)
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) larger larger)
                (#pt-app (#pt-use multiply ()) smaller smaller))
              (#pt-app
                (#pt-use symmetry (0))
                #pt-nat
                (#pt-app (#pt-use add ()) (#pt-app (#pt-use add ()) first gap-half) gap-half)
                (#pt-app (#pt-use add ()) first (#pt-app (#pt-use add ()) gap-half gap-half))
                (#pt-app (#pt-use add-associative ()) first gap-half gap-half))
              (#pt-app
                (#pt-use transitivity (0))
                #pt-nat
                (#pt-app (#pt-use add ()) (#pt-app (#pt-use add ()) first gap-half) gap-half)
                (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) larger larger) gap-half)
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) larger larger)
                  (#pt-app (#pt-use multiply ()) smaller smaller))
                (#pt-app
                  (#pt-use congruence (0 0))
                  #pt-nat
                  #pt-nat
                  (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use add ()) endpoint gap-half))
                  (#pt-app (#pt-use add ()) first gap-half)
                  (#pt-app (#pt-use multiply ()) larger larger)
                  upper-square)
                (#pt-app
                  (#pt-use congruence (0 0))
                  #pt-nat
                  #pt-nat
                  (#pt-lambda
                    ((endpoint #pt-nat))
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use multiply ()) larger larger)
                      endpoint))
                  gap-half
                  (#pt-app (#pt-use multiply ()) smaller smaller)
                  lower-square)))))
        (#pt-lambda
          (
            (common-divisor #pt-nat)
            (larger-divides (#pt-app (#pt-use divides ()) common-divisor larger))
            (smaller-divides (#pt-app (#pt-use divides ()) common-divisor smaller)))
          (#pt-app
            halves-coprime
            common-divisor
            (#pt-app
              (#pt-use substitution (0))
              #pt-nat
              (#pt-lambda
                ((endpoint #pt-nat))
                (#pt-app (#pt-use divides ()) common-divisor endpoint))
              (#pt-app (#pt-use multiply ()) smaller smaller)
              gap-half
              (#pt-app
                (#pt-use symmetry (0))
                #pt-nat
                gap-half
                (#pt-app (#pt-use multiply ()) smaller smaller)
                lower-square)
              (#pt-app
                (#pt-use divides-transitive ())
                common-divisor
                smaller
                (#pt-app (#pt-use multiply ()) smaller smaller)
                smaller-divides
                (#pt-app (#pt-use divides-multiple ()) smaller smaller)))
            (#pt-app
              (#pt-use substitution (0))
              #pt-nat
              (#pt-lambda
                ((endpoint #pt-nat))
                (#pt-app (#pt-use divides ()) common-divisor endpoint))
              (#pt-app (#pt-use multiply ()) larger larger)
              (#pt-app (#pt-use add ()) first gap-half)
              (#pt-app
                (#pt-use symmetry (0))
                #pt-nat
                (#pt-app (#pt-use add ()) first gap-half)
                (#pt-app (#pt-use multiply ()) larger larger)
                upper-square)
              (#pt-app
                (#pt-use divides-transitive ())
                common-divisor
                larger
                (#pt-app (#pt-use multiply ()) larger larger)
                larger-divides
                (#pt-app (#pt-use divides-multiple ()) larger larger)))))
        (#pt-app
          (#pt-use pythagorean-parameter-opposite-parity ())
          first
          larger
          smaller
          first-odd
          (#pt-app
            (#pt-use transitivity (0))
            #pt-nat
            (#pt-app (#pt-use add ()) first (#pt-app (#pt-use multiply ()) smaller smaller))
            (#pt-app (#pt-use add ()) first gap-half)
            (#pt-app (#pt-use multiply ()) larger larger)
            (#pt-app
              (#pt-use congruence (0 0))
              #pt-nat
              #pt-nat
