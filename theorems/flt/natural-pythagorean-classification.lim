              (smaller-divides (#pt-app (#pt-use divides ()) common-divisor smaller)))
            (#pt-app
              halves-coprime
              common-divisor
              (#pt-app
                (#pt-use substitution (0))
                #pt-nat
                (#pt-lambda
                  ((endpoint #pt-nat))
                  (#pt-app (#pt-use divides ()) common-divisor endpoint))
                (#pt-app (#pt-use multiply ()) smaller smaller)
                gap-half
                (#pt-app
                  (#pt-use symmetry (0))
                  #pt-nat
                  gap-half
                  (#pt-app (#pt-use multiply ()) smaller smaller)
                  lower-square)
                (#pt-app
                  (#pt-use divides-transitive ())
                  common-divisor
                  smaller
                  (#pt-app (#pt-use multiply ()) smaller smaller)
                  smaller-divides
                  (#pt-app (#pt-use divides-multiple ()) smaller smaller)))
              (#pt-app
                (#pt-use substitution (0))
                #pt-nat
                (#pt-lambda
                  ((endpoint #pt-nat))
                  (#pt-app (#pt-use divides ()) common-divisor endpoint))
                (#pt-app (#pt-use multiply ()) larger larger)
                (#pt-app (#pt-use add ()) first gap-half)
                (#pt-app
                  (#pt-use symmetry (0))
                  #pt-nat
                  (#pt-app (#pt-use add ()) first gap-half)
                  (#pt-app (#pt-use multiply ()) larger larger)
                  upper-square)
                (#pt-app
                  (#pt-use divides-transitive ())
                  common-divisor
                  larger
                  (#pt-app (#pt-use multiply ()) larger larger)
                  larger-divides
