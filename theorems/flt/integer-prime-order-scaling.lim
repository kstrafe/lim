; A factor not divisible by q has valuation zero. Actual signed
; product/power laws and uniqueness turn x*scale=y^n into the exact
; valuation equality when the scale is a certified q-nondivisor.
(#alias add = ./../fermat_statement.lim::add)
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-power = ./integer-defs.lim::integer-power)
(#alias integer-divides = ./integer-defs.lim::integer-divides)
(#alias add-zero-right = ./natural-addition.lim::add-zero-right)
(#alias prime = ./natural-prime.lim::prime)
(#alias integer-prime-order = ./integer-prime-order-defs.lim::integer-prime-order)
(#alias integer-prime-order-zero = ./integer-prime-order-existence.lim::integer-prime-order-zero)
(#alias
  integer-prime-order-unique
  =
  ./integer-prime-order-uniqueness.lim::integer-prime-order-unique)
(#alias
  integer-prime-order-congruent
  =
  ./integer-prime-order-uniqueness.lim::integer-prime-order-congruent)
(#alias
  integer-prime-order-multiply
  =
  ./integer-prime-order-arithmetic.lim::integer-prime-order-multiply)
(#alias integer-prime-order-power = ./integer-prime-order-arithmetic.lim::integer-prime-order-power)
(#theorem integer-prime-order-nondivisor-factor
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter number (#pt-use integer ()))
    (#parameter scale (#pt-use integer ()))
    (#parameter valuation #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter scale-nondivisor (#pt-pi ((denied-proof (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) scale))) #pt-false))
    (#parameter order-certificate (#pt-app (#pt-use integer-prime-order ()) prime-number valuation number)))
  (#statement
    (#pt-app
      (#pt-use integer-prime-order ())
      prime-number
      valuation
      (#pt-app (#pt-use integer-multiply ()) number scale)))
  (#proof
    (#pt-eq-elim
      #pt-nat
      (#pt-app (#pt-use add ()) valuation #pt-zero)
      (#pt-lambda
        (
          (transport-index #pt-nat)
          (transport-path
            (#pt-eq #pt-nat (#pt-app (#pt-use add ()) valuation #pt-zero) transport-index)))
        (#pt-app
          (#pt-use integer-prime-order ())
          prime-number
          transport-index
          (#pt-app (#pt-use integer-multiply ()) number scale)))
      (#pt-app
        (#pt-use integer-prime-order-multiply ())
        prime-number
        number
        scale
        valuation
        #pt-zero
        prime-proof
        order-certificate
        (#pt-app (#pt-use integer-prime-order-zero ()) prime-number scale scale-nondivisor))
      valuation
      (#pt-app (#pt-use add-zero-right ()) valuation))))
(#theorem integer-prime-order-scaled-power
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter number (#pt-use integer ()))
    (#parameter scale (#pt-use integer ()))
    (#parameter power-base (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter valuation #pt-nat)
    (#parameter base-valuation #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter scale-nondivisor (#pt-pi ((denied-proof (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) scale))) #pt-false))
    (#parameter power-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-multiply ()) number scale) (#pt-app (#pt-use integer-power ()) power-base exponent)))
    (#parameter order-certificate (#pt-app (#pt-use integer-prime-order ()) prime-number valuation number))
    (#parameter base-order (#pt-app (#pt-use integer-prime-order ()) prime-number base-valuation power-base)))
  (#statement (#pt-eq #pt-nat valuation (#pt-app (#pt-use multiply ()) exponent base-valuation)))
  (#proof
    (#pt-app
      (#pt-use integer-prime-order-unique ())
      prime-number
      (#pt-app (#pt-use integer-power ()) power-base exponent)
      valuation
      (#pt-app (#pt-use multiply ()) exponent base-valuation)
      prime-proof
      (#pt-app
        (#pt-use integer-prime-order-congruent ())
        prime-number
        (#pt-app (#pt-use integer-multiply ()) number scale)
        (#pt-app (#pt-use integer-power ()) power-base exponent)
        valuation
        power-equation
        (#pt-app
          (#pt-use integer-prime-order-nondivisor-factor ())
          prime-number
          number
          scale
          valuation
          prime-proof
          scale-nondivisor
          order-certificate))
      (#pt-app
        (#pt-use integer-prime-order-power ())
        prime-number
        power-base
        base-valuation
        exponent
        prime-proof
        base-order))))
