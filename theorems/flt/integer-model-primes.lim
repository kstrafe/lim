; Preserve the source arithmetic model/prime predicates under actual
; coefficient equivalence, using proved invariant maps and faithful
; rational embedding. Coefficient equivalence is not a general
; rational variable change or a geometric reduction theorem.
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
