(#theorem ring-polynomial-shift-congruent
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
