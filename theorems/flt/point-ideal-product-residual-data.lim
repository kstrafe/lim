(#alias ring-polynomial-structure = ./ring-polynomial-structure.lim::ring-polynomial-structure)
(#math-definition point-ideal-product-residual ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (quadratic-linear (#pt-app (#pt-use finite-list ()) Carrier))
      (quadratic-constant (#pt-app (#pt-use finite-list ()) Carrier))
      (ordinate Carrier))
    (#pt-app (#pt-use finite-list ()) Carrier))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (quadratic-linear (#pt-app (#pt-use finite-list ()) Carrier))
      (quadratic-constant (#pt-app (#pt-use finite-list ()) Carrier))
      (ordinate Carrier))
    (#pt-app
      (#pt-use ring-polynomial-add ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-add ())
        Carrier
        coefficient-ring
        quadratic-constant
        (#pt-app
          (#pt-use ring-polynomial-negate ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-multiply ())
            Carrier
            coefficient-ring
            quadratic-linear
            (#pt-construct
              finite-list
              ()
              (Carrier)
              cons
              (ordinate (#pt-construct finite-list () (Carrier) nil ()))))))
      (#pt-app
        (#pt-use ring-polynomial-negate ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-multiply ())
          Carrier
          coefficient-ring
          (#pt-construct
            finite-list
            ()
            (Carrier)
            cons
            (ordinate (#pt-construct finite-list () (Carrier) nil ())))
          (#pt-construct
            finite-list
            ()
            (Carrier)
            cons
            (ordinate (#pt-construct finite-list () (Carrier) nil ()))))))))
(#math-definition point-ideal-product-opposite-factor ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (quadratic-linear (#pt-app (#pt-use finite-list ()) Carrier))
      (ordinate Carrier))
    (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier)))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (quadratic-linear (#pt-app (#pt-use finite-list ()) Carrier))
      (ordinate Carrier))
    (#pt-construct
      quadratic-element
      ()
      ((#pt-app (#pt-use finite-list ()) Carrier))
      coordinates
      (
        (#pt-app
          (#pt-use ring-polynomial-add ())
          Carrier
          coefficient-ring
          quadratic-linear
          (#pt-construct
            finite-list
            ()
            (Carrier)
            cons
            (ordinate (#pt-construct finite-list () (Carrier) nil ()))))
        (#pt-construct
          finite-list
          ()
          (Carrier)
          cons
          (
            (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
            (#pt-construct finite-list () (Carrier) nil ())))))))
(#theorem point-ideal-product-polynomial-opposite-factors
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter quadratic-linear (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter quadratic-constant (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter root Carrier)
    (#parameter ordinate Carrier))
  (#statement
    (#pt-app
      (#pt-use quadratic-equal ())
      (#pt-app (#pt-use finite-list ()) Carrier)
      (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
      (#pt-app
        (#pt-use quadratic-multiply ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        quadratic-linear
        quadratic-constant
        (#pt-app
          (#pt-use point-ideal-product-opposite-factor ())
          Carrier
          coefficient-ring
          quadratic-linear
          ordinate)
        (#pt-app
          (#pt-use coordinate-point-ideal-Y-class ())
          Carrier
          coefficient-ring
          (#pt-construct
            finite-list
            ()
            (Carrier)
            cons
            (ordinate (#pt-construct finite-list () (Carrier) nil ())))))
      (#pt-construct
        quadratic-element
        ()
        ((#pt-app (#pt-use finite-list ()) Carrier))
        coordinates
        (
          (#pt-app
            (#pt-use point-ideal-product-residual ())
            Carrier
            coefficient-ring
            quadratic-linear
            quadratic-constant
            ordinate)
          (#pt-construct finite-list () (Carrier) nil ())))))
  (#proof
    (#pt-app
      (#pt-use point-ideal-product-opposite-linear-factors ())
      (#pt-app (#pt-use finite-list ()) Carrier)
      (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
      quadratic-linear
      quadratic-constant
      (#pt-construct
        finite-list
        ()
        (Carrier)
        cons
        (ordinate (#pt-construct finite-list () (Carrier) nil ()))))))
