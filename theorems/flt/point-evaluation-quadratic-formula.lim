; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean.
; Generated by scripts/generate-flt-point-evaluation.py; checked native terms.
; The constructed coordinate evaluation
; has the actual expected value map(p)+y*map(q). This formula is
; proved from its quotient construction and actual Horner constant
; evaluation; the quadratic root remains an explicit premise.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias
  point-evaluation-quadratic-mapping
  =
  ./point-evaluation-quadratic-morphism.lim::point-evaluation-quadratic-mapping)
(#alias
  point-evaluation-quadratic-morphism
  =
  ./point-evaluation-quadratic-morphism.lim::point-evaluation-quadratic-morphism)
(#alias quadratic-constant = ./quadratic-algebra-data.lim::quadratic-constant)
(#alias quadratic-division-divisor = ./quadratic-division-data.lim::quadratic-division-divisor)
(#alias quadratic-element = ./quadratic-algebra-data.lim::quadratic-element)
(#alias quadratic-quotient-linear = ./quadratic-quotient-evaluation.lim::quadratic-quotient-linear)
(#alias quadratic-ring-structure = ./quadratic-algebra-ring-structure.lim::quadratic-ring-structure)
(#alias ring-add = ./commutative-ring-data.lim::ring-add)
(#alias ring-add-congruent = ./commutative-ring-data.lim::ring-add-congruent)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-evaluation = ./ring-evaluation-data.lim::ring-evaluation)
(#alias ring-evaluation-constant = ./ring-evaluation-data.lim::ring-evaluation-constant)
(#alias ring-evaluation-map = ./ring-evaluation-morphism.lim::ring-evaluation-map)
(#alias ring-evaluation-morphism = ./ring-evaluation-morphism.lim::ring-evaluation-morphism)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-multiply-congruent = ./commutative-ring-data.lim::ring-multiply-congruent)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#alias ring-transitive = ./commutative-ring-data.lim::ring-transitive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#theorem point-evaluation-quadratic-formula
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter Image (#pt-type 0))
    (#parameter image-ring (#pt-app (#pt-use commutative-ring ()) Image))
    (#parameter morphism (#pt-app (#pt-use ring-evaluation-morphism ()) Carrier coefficient-ring Image image-ring))
    (#parameter quadratic-linear Carrier)
    (#parameter quadratic-constant Carrier)
    (#parameter image-root Image)
    (#parameter quadratic-root (#pt-app (#pt-use ring-equal ()) Image image-ring (#pt-app (#pt-use ring-evaluation ()) Carrier coefficient-ring Image image-ring morphism image-root (#pt-app (#pt-use quadratic-division-divisor ()) Carrier coefficient-ring quadratic-linear quadratic-constant)) (#pt-app (#pt-use ring-zero ()) Image image-ring)))
    (#parameter coordinate-element (#pt-app (#pt-use quadratic-element ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Image
      image-ring
      (#pt-app
        (#pt-use ring-evaluation-map ())
        (#pt-app (#pt-use quadratic-element ()) Carrier)
        (#pt-app
          (#pt-use quadratic-ring-structure ())
          Carrier
          coefficient-ring
          quadratic-linear
          quadratic-constant)
        Image
        image-ring
        (#pt-app
          (#pt-use point-evaluation-quadratic-morphism ())
          Carrier
          coefficient-ring
          Image
          image-ring
          morphism
          quadratic-linear
          quadratic-constant
          image-root
          quadratic-root)
        coordinate-element)
      (#pt-app
        (#pt-use ring-add ())
        Image
        image-ring
        (#pt-app
          (#pt-use ring-evaluation-map ())
          Carrier
          coefficient-ring
          Image
          image-ring
          morphism
          (#pt-project quadratic-element 0 coordinate-element))
        (#pt-app
          (#pt-use ring-multiply ())
          Image
          image-ring
          image-root
          (#pt-app
            (#pt-use ring-evaluation-map ())
            Carrier
            coefficient-ring
            Image
            image-ring
            morphism
            (#pt-project quadratic-element 1 coordinate-element))))))
  (#proof
    (#pt-app
      (#pt-use ring-transitive ())
      Image
      image-ring
      (#pt-app
        (#pt-use ring-evaluation-map ())
        (#pt-app (#pt-use quadratic-element ()) Carrier)
        (#pt-app
          (#pt-use quadratic-ring-structure ())
          Carrier
          coefficient-ring
          quadratic-linear
          quadratic-constant)
        Image
        image-ring
        (#pt-app
          (#pt-use point-evaluation-quadratic-morphism ())
          Carrier
          coefficient-ring
          Image
          image-ring
          morphism
          quadratic-linear
          quadratic-constant
          image-root
          quadratic-root)
        coordinate-element)
      (#pt-app
        (#pt-use ring-evaluation ())
        Carrier
        coefficient-ring
        Image
        image-ring
        morphism
        image-root
        (#pt-app (#pt-use quadratic-quotient-linear ()) Carrier coefficient-ring coordinate-element))
      (#pt-app
        (#pt-use ring-add ())
        Image
        image-ring
        (#pt-app
          (#pt-use ring-evaluation-map ())
          Carrier
          coefficient-ring
          Image
          image-ring
          morphism
          (#pt-project quadratic-element 0 coordinate-element))
        (#pt-app
          (#pt-use ring-multiply ())
          Image
          image-ring
          image-root
          (#pt-app
            (#pt-use ring-evaluation-map ())
            Carrier
            coefficient-ring
            Image
            image-ring
            morphism
            (#pt-project quadratic-element 1 coordinate-element))))
      (#pt-app
        (#pt-use point-evaluation-quadratic-mapping ())
        Carrier
        coefficient-ring
        Image
        image-ring
        morphism
        quadratic-linear
        quadratic-constant
        image-root
        quadratic-root
        coordinate-element)
      (#pt-app
        (#pt-use ring-add-congruent ())
        Image
        image-ring
        (#pt-app
          (#pt-use ring-evaluation-map ())
          Carrier
          coefficient-ring
          Image
          image-ring
          morphism
          (#pt-project quadratic-element 0 coordinate-element))
        (#pt-app
          (#pt-use ring-multiply ())
          Image
          image-ring
          image-root
          (#pt-app
            (#pt-use ring-evaluation ())
            Carrier
            coefficient-ring
            Image
            image-ring
            morphism
            image-root
            (#pt-construct
              finite-list
              ()
              (Carrier)
              cons
              (
                (#pt-project quadratic-element 1 coordinate-element)
                (#pt-construct finite-list () (Carrier) nil ())))))
        (#pt-app
          (#pt-use ring-evaluation-map ())
          Carrier
          coefficient-ring
          Image
          image-ring
          morphism
          (#pt-project quadratic-element 0 coordinate-element))
        (#pt-app
          (#pt-use ring-multiply ())
          Image
          image-ring
          image-root
          (#pt-app
            (#pt-use ring-evaluation-map ())
            Carrier
            coefficient-ring
            Image
            image-ring
            morphism
            (#pt-project quadratic-element 1 coordinate-element)))
        (#pt-app
          (#pt-use ring-reflexive ())
          Image
          image-ring
          (#pt-app
            (#pt-use ring-evaluation-map ())
            Carrier
            coefficient-ring
            Image
            image-ring
            morphism
            (#pt-project quadratic-element 0 coordinate-element)))
        (#pt-app
          (#pt-use ring-multiply-congruent ())
          Image
          image-ring
          image-root
          (#pt-app
            (#pt-use ring-evaluation ())
            Carrier
            coefficient-ring
            Image
            image-ring
            morphism
            image-root
            (#pt-construct
              finite-list
              ()
              (Carrier)
              cons
              (
                (#pt-project quadratic-element 1 coordinate-element)
                (#pt-construct finite-list () (Carrier) nil ()))))
          image-root
          (#pt-app
            (#pt-use ring-evaluation-map ())
            Carrier
            coefficient-ring
            Image
            image-ring
            morphism
            (#pt-project quadratic-element 1 coordinate-element))
          (#pt-app (#pt-use ring-reflexive ()) Image image-ring image-root)
          (#pt-app
            (#pt-use ring-evaluation-constant ())
            Carrier
            coefficient-ring
            Image
            image-ring
            morphism
            image-root
            (#pt-project quadratic-element 1 coordinate-element)))))))
