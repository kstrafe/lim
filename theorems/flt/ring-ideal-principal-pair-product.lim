; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Expand a principal ideal times a
; two-generator ideal using distributivity and the proved principal
; product law. Both resulting generators are actual ring products.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias ring-ideal-equal = ./ring-ideal-data.lim::ring-ideal-equal)
(#alias ring-ideal-equal-transitive = ./ring-ideal-equivalence.lim::ring-ideal-equal-transitive)
(#alias ring-ideal-pair = ./ring-ideal-pair.lim::ring-ideal-pair)
(#alias ring-ideal-principal = ./ring-ideal-principal.lim::ring-ideal-principal)
(#alias
  ring-ideal-principal-product
  =
  ./ring-ideal-principal-product.lim::ring-ideal-principal-product)
(#alias ring-ideal-product = ./ring-ideal-product.lim::ring-ideal-product)
(#alias
  ring-ideal-product-distributive
  =
  ./ring-ideal-product-distributive.lim::ring-ideal-product-distributive)
(#alias ring-ideal-sum = ./ring-ideal-sum.lim::ring-ideal-sum)
(#alias ring-ideal-sum-congruent = ./ring-ideal-operation-congruence.lim::ring-ideal-sum-congruent)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#theorem ring-ideal-principal-pair-product
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-element Carrier)
    (#parameter second-element Carrier)
    (#parameter coefficient Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
        (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring second-element coefficient))
      (#pt-app
        (#pt-use ring-ideal-pair ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element second-element)
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element coefficient))))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-equal-transitive ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
        (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring second-element coefficient))
      (#pt-app
        (#pt-use ring-ideal-sum ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element))
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring coefficient)))
      (#pt-app
        (#pt-use ring-ideal-pair ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element second-element)
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element coefficient))
      (#pt-app
        (#pt-use ring-ideal-product-distributive ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
        (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element)
        (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring coefficient))
      (#pt-app
        (#pt-use ring-ideal-sum-congruent ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element))
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring coefficient))
        (#pt-app
          (#pt-use ring-ideal-principal ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element second-element))
        (#pt-app
          (#pt-use ring-ideal-principal ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element coefficient))
        (#pt-app
          (#pt-use ring-ideal-principal-product ())
          Carrier
          coefficient-ring
          first-element
          second-element)
        (#pt-app
          (#pt-use ring-ideal-principal-product ())
          Carrier
          coefficient-ring
          first-element
          coefficient)))))
