; Native Lim port of the exact discriminant formula at
; Def_FreyCurve_Basic.lean:9-16: (a*b*c)^(2*p)/2^8.
; Use actual coordinate equation, integer product/power laws and
; denominator evidence. Nonvanishing requires all three nonzero
; coordinates explicitly; ellipticity/unit discriminant is separate.
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias power = ./../fermat_statement.lim::power)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-zero = ./integer-defs.lim::integer-zero)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-power = ./integer-defs.lim::integer-power)
(#alias integer-reflexive = ./integer-equality.lim::integer-reflexive)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias integer-multiply-congruent = ./integer-multiplication.lim::integer-multiply-congruent)
(#alias rational = ./rational-defs.lim::rational)
(#alias rational-equal = ./rational-defs.lim::rational-equal)
(#alias rational-zero = ./rational-defs.lim::rational-zero)
(#alias multiply-nonzero = ./natural-nonzero.lim::multiply-nonzero)
(#alias successor-not-zero = ./natural-nonzero.lim::successor-not-zero)
(#alias rational-symmetric = ./rational-equality.lim::rational-symmetric)
(#alias rational-transitive = ./rational-equality.lim::rational-transitive)
(#alias rational-fraction-nonzero = ./rational-equality.lim::rational-fraction-nonzero)
(#alias rational-components-congruent = ./rational-congruence.lim::rational-components-congruent)
(#alias
  rational-weierstrass-discriminant
  =
  ./rational-weierstrass-defs.lim::rational-weierstrass-discriminant)
(#alias integer-power-congruent = ./integer-power-laws.lim::integer-power-congruent)
(#alias integer-power-product = ./integer-power-products.lim::integer-power-product)
(#alias integer-power-nonzero = ./integer-power-products.lim::integer-power-nonzero)
(#alias frey-rational-curve = ./frey-rational-curve.lim::frey-rational-curve)
(#alias integer-power-square = ./integer-power-sums.lim::integer-power-square)
(#alias power-nonzero = ./natural-nonzero.lim::power-nonzero)
(#alias integer-nonzero-product = ./integer-domain.lim::integer-nonzero-product)
(#alias
  frey-rational-model-discriminant-with-sum
  =
  ./frey-discriminant-fraction.lim::frey-rational-model-discriminant-with-sum)
(#theorem frey-discriminant-denominator
  (#universes)
  (#parameters)
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use multiply ()) (#pt-numeral 16) (#pt-numeral 16))
      (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-numeral 8))))
  (#proof (#pt-refl #pt-nat (#pt-app (#pt-use multiply ()) (#pt-numeral 16) (#pt-numeral 16)))))
(#theorem frey-rational-curve-discriminant
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter power-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-power ()) first exponent) (#pt-app (#pt-use integer-power ()) second exponent)) (#pt-app (#pt-use integer-power ()) third exponent))))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-weierstrass-discriminant ())
        (#pt-app (#pt-use frey-rational-curve ()) first second exponent))
      (#pt-construct
        rational
        ()
        ()
        fraction
        (
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-multiply ()) first second)
              third)
            (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent))
          (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-numeral 8))
          (#pt-app
            (#pt-use power-nonzero ())
            (#pt-succ (#pt-succ #pt-zero))
            (#pt-numeral 8)
            (#pt-app (#pt-use successor-not-zero ()) (#pt-numeral 1)))))))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app
        (#pt-use rational-weierstrass-discriminant ())
        (#pt-app (#pt-use frey-rational-curve ()) first second exponent))
      (#pt-construct
        rational
        ()
        ()
        fraction
        (
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-power ()) first exponent)
                (#pt-app (#pt-use integer-power ()) second exponent))
              (#pt-app (#pt-use integer-power ()) third exponent))
            (#pt-succ (#pt-succ #pt-zero)))
          (#pt-app (#pt-use multiply ()) (#pt-numeral 16) (#pt-numeral 16))
          (#pt-app
            (#pt-use multiply-nonzero ())
            (#pt-numeral 16)
            (#pt-numeral 16)
            (#pt-app (#pt-use successor-not-zero ()) (#pt-numeral 15))
            (#pt-app (#pt-use successor-not-zero ()) (#pt-numeral 15)))))
      (#pt-construct
        rational
        ()
        ()
        fraction
        (
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-multiply ()) first second)
              third)
            (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent))
          (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-numeral 8))
          (#pt-app
            (#pt-use power-nonzero ())
            (#pt-succ (#pt-succ #pt-zero))
            (#pt-numeral 8)
            (#pt-app (#pt-use successor-not-zero ()) (#pt-numeral 1)))))
      (#pt-app
        (#pt-use frey-rational-model-discriminant-with-sum ())
        (#pt-app (#pt-use integer-power ()) first exponent)
        (#pt-app (#pt-use integer-power ()) second exponent)
        (#pt-app (#pt-use integer-power ()) third exponent)
        power-equation)
      (#pt-app
        (#pt-use rational-components-congruent ())
        (#pt-construct
          rational
          ()
          ()
          fraction
          (
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-power ()) first exponent)
                  (#pt-app (#pt-use integer-power ()) second exponent))
                (#pt-app (#pt-use integer-power ()) third exponent))
              (#pt-succ (#pt-succ #pt-zero)))
            (#pt-app (#pt-use multiply ()) (#pt-numeral 16) (#pt-numeral 16))
            (#pt-app
              (#pt-use multiply-nonzero ())
              (#pt-numeral 16)
              (#pt-numeral 16)
              (#pt-app (#pt-use successor-not-zero ()) (#pt-numeral 15))
              (#pt-app (#pt-use successor-not-zero ()) (#pt-numeral 15)))))
        (#pt-construct
          rational
          ()
          ()
          fraction
          (
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-multiply ()) first second)
                third)
              (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent))
            (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-numeral 8))
            (#pt-app
              (#pt-use power-nonzero ())
              (#pt-succ (#pt-succ #pt-zero))
              (#pt-numeral 8)
              (#pt-app (#pt-use successor-not-zero ()) (#pt-numeral 1)))))
        (#pt-app
          (#pt-use integer-transitive ())
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-power ()) first exponent)
                (#pt-app (#pt-use integer-power ()) second exponent))
              (#pt-app (#pt-use integer-power ()) third exponent))
            (#pt-succ (#pt-succ #pt-zero)))
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-multiply ()) first second)
                third)
              exponent)
            (#pt-succ (#pt-succ #pt-zero)))
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-multiply ()) first second)
              third)
            (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent))
          (#pt-app
            (#pt-use integer-power-congruent ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-power ()) first exponent)
                (#pt-app (#pt-use integer-power ()) second exponent))
              (#pt-app (#pt-use integer-power ()) third exponent))
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-multiply ()) first second)
                third)
              exponent)
            (#pt-succ (#pt-succ #pt-zero))
            (#pt-app
              (#pt-use integer-symmetric ())
              (#pt-app
                (#pt-use integer-power ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-multiply ()) first second)
                  third)
                exponent)
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-power ()) first exponent)
                  (#pt-app (#pt-use integer-power ()) second exponent))
                (#pt-app (#pt-use integer-power ()) third exponent))
              (#pt-app
                (#pt-use integer-transitive ())
                (#pt-app
                  (#pt-use integer-power ())
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-app (#pt-use integer-multiply ()) first second)
                    third)
                  exponent)
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app
                    (#pt-use integer-power ())
                    (#pt-app (#pt-use integer-multiply ()) first second)
                    exponent)
                  (#pt-app (#pt-use integer-power ()) third exponent))
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-app (#pt-use integer-power ()) first exponent)
                    (#pt-app (#pt-use integer-power ()) second exponent))
                  (#pt-app (#pt-use integer-power ()) third exponent))
                (#pt-app
                  (#pt-use integer-power-product ())
                  (#pt-app (#pt-use integer-multiply ()) first second)
                  third
                  exponent)
                (#pt-app
                  (#pt-use integer-multiply-congruent ())
                  (#pt-app
                    (#pt-use integer-power ())
                    (#pt-app (#pt-use integer-multiply ()) first second)
                    exponent)
                  (#pt-app (#pt-use integer-power ()) third exponent)
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-app (#pt-use integer-power ()) first exponent)
                    (#pt-app (#pt-use integer-power ()) second exponent))
                  (#pt-app (#pt-use integer-power ()) third exponent)
                  (#pt-app (#pt-use integer-power-product ()) first second exponent)
                  (#pt-app
                    (#pt-use integer-reflexive ())
                    (#pt-app (#pt-use integer-power ()) third exponent))))))
          (#pt-app
            (#pt-use integer-power-square ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-multiply ()) first second)
              third)
            exponent))
        (#pt-use frey-discriminant-denominator ())))))
(#theorem frey-rational-curve-discriminant-nonzero
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter power-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-power ()) first exponent) (#pt-app (#pt-use integer-power ()) second exponent)) (#pt-app (#pt-use integer-power ()) third exponent)))
    (#parameter first-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use integer-equal ()) first (#pt-use integer-zero ())))) #pt-false))
    (#parameter second-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use integer-equal ()) second (#pt-use integer-zero ())))) #pt-false))
    (#parameter third-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use integer-equal ()) third (#pt-use integer-zero ())))) #pt-false)))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-app
              (#pt-use rational-weierstrass-discriminant ())
              (#pt-app (#pt-use frey-rational-curve ()) first second exponent))
            (#pt-use rational-zero ()))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (zero-equation
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-app
              (#pt-use rational-weierstrass-discriminant ())
              (#pt-app (#pt-use frey-rational-curve ()) first second exponent))
            (#pt-use rational-zero ()))))
      (#pt-app
        (#pt-app
          (#pt-use rational-fraction-nonzero ())
          (#pt-construct
            rational
            ()
            ()
            fraction
            (
              (#pt-app
                (#pt-use integer-power ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-multiply ()) first second)
                  third)
                (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent))
              (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-numeral 8))
              (#pt-app
                (#pt-use power-nonzero ())
                (#pt-succ (#pt-succ #pt-zero))
                (#pt-numeral 8)
                (#pt-app (#pt-use successor-not-zero ()) (#pt-numeral 1)))))
          (#pt-app
            (#pt-use integer-power-nonzero ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-multiply ()) first second)
              third)
            (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent)
            (#pt-app
              (#pt-use integer-nonzero-product ())
              (#pt-app (#pt-use integer-multiply ()) first second)
              third
              (#pt-app
                (#pt-use integer-nonzero-product ())
                first
                second
                first-nonzero
                second-nonzero)
              third-nonzero)))
        (#pt-app
          (#pt-use rational-transitive ())
          (#pt-construct
            rational
            ()
            ()
            fraction
            (
              (#pt-app
                (#pt-use integer-power ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-multiply ()) first second)
                  third)
                (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent))
              (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-numeral 8))
              (#pt-app
                (#pt-use power-nonzero ())
                (#pt-succ (#pt-succ #pt-zero))
                (#pt-numeral 8)
                (#pt-app (#pt-use successor-not-zero ()) (#pt-numeral 1)))))
          (#pt-app
            (#pt-use rational-weierstrass-discriminant ())
            (#pt-app (#pt-use frey-rational-curve ()) first second exponent))
          (#pt-use rational-zero ())
          (#pt-app
            (#pt-use rational-symmetric ())
            (#pt-app
              (#pt-use rational-weierstrass-discriminant ())
              (#pt-app (#pt-use frey-rational-curve ()) first second exponent))
            (#pt-construct
              rational
              ()
              ()
              fraction
              (
                (#pt-app
                  (#pt-use integer-power ())
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-app (#pt-use integer-multiply ()) first second)
                    third)
                  (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent))
                (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-numeral 8))
                (#pt-app
                  (#pt-use power-nonzero ())
                  (#pt-succ (#pt-succ #pt-zero))
                  (#pt-numeral 8)
                  (#pt-app (#pt-use successor-not-zero ()) (#pt-numeral 1)))))
            (#pt-app
              (#pt-use frey-rational-curve-discriminant ())
              first
              second
              third
              exponent
              power-equation))
          zero-equation)))))
