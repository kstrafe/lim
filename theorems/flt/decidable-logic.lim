; Checked decisions compose constructively; no oracle or extra axiom is used.
(#alias decision = ./logical-decision.lim::decision)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias disjunction-left = ./logical-connectives.lim::disjunction-left)
(#alias disjunction-right = ./logical-connectives.lim::disjunction-right)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#math-definition decision-disjunction ()
  (#pt-pi
    (
      (proposition-left #pt-prop)
      (proposition-right #pt-prop)
      (decision-left (#pt-app (#pt-use decision ()) proposition-left))
      (decision-right (#pt-app (#pt-use decision ()) proposition-right)))
    (#pt-app
      (#pt-use decision ())
      (#pt-app (#pt-use disjunction ()) proposition-left proposition-right)))
  (#pt-lambda
    (
      (proposition-left #pt-prop)
      (proposition-right #pt-prop)
      (decision-left (#pt-app (#pt-use decision ()) proposition-left))
      (decision-right (#pt-app (#pt-use decision ()) proposition-right)))
    (#pt-induct
      decision
      ()
      (proposition-left)
      (#pt-lambda
        ((decision-case (#pt-app (#pt-use decision ()) proposition-left)))
        (#pt-app
          (#pt-use decision ())
          (#pt-app (#pt-use disjunction ()) proposition-left proposition-right)))
      (
        (#pt-lambda
          ((left-refutation (#pt-pi ((denied-proof proposition-left)) #pt-false)))
          (#pt-induct
            decision
            ()
            (proposition-right)
            (#pt-lambda
              ((decision-case (#pt-app (#pt-use decision ()) proposition-right)))
              (#pt-app
                (#pt-use decision ())
                (#pt-app (#pt-use disjunction ()) proposition-left proposition-right)))
            (
              (#pt-lambda
                ((right-refutation (#pt-pi ((denied-proof proposition-right)) #pt-false)))
                (#pt-construct
                  decision
                  ()
                  ((#pt-app (#pt-use disjunction ()) proposition-left proposition-right))
                  no
                  (
                    (#pt-lambda
                      (
                        (either-proof
                          (#pt-app (#pt-use disjunction ()) proposition-left proposition-right)))
                      (#pt-app
                        (#pt-use disjunction-eliminate ())
                        proposition-left
                        proposition-right
                        #pt-false
                        left-refutation
                        right-refutation
                        either-proof)))))
              (#pt-lambda
                ((right-evidence proposition-right))
                (#pt-construct
                  decision
                  ()
                  ((#pt-app (#pt-use disjunction ()) proposition-left proposition-right))
                  yes
                  (
                    (#pt-app
                      (#pt-use disjunction-right ())
                      proposition-left
                      proposition-right
                      right-evidence)))))
            decision-right))
        (#pt-lambda
          ((left-evidence proposition-left))
          (#pt-construct
            decision
            ()
            ((#pt-app (#pt-use disjunction ()) proposition-left proposition-right))
            yes
            (
              (#pt-app
                (#pt-use disjunction-left ())
                proposition-left
                proposition-right
                left-evidence)))))
      decision-left)))
(#math-definition decision-conjunction ()
  (#pt-pi
    (
      (proposition-left #pt-prop)
      (proposition-right #pt-prop)
      (decision-left (#pt-app (#pt-use decision ()) proposition-left))
      (decision-right (#pt-app (#pt-use decision ()) proposition-right)))
    (#pt-app
      (#pt-use decision ())
      (#pt-app (#pt-use conjunction ()) proposition-left proposition-right)))
  (#pt-lambda
    (
      (proposition-left #pt-prop)
      (proposition-right #pt-prop)
      (decision-left (#pt-app (#pt-use decision ()) proposition-left))
      (decision-right (#pt-app (#pt-use decision ()) proposition-right)))
    (#pt-induct
      decision
      ()
      (proposition-left)
      (#pt-lambda
        ((decision-case (#pt-app (#pt-use decision ()) proposition-left)))
        (#pt-app
          (#pt-use decision ())
          (#pt-app (#pt-use conjunction ()) proposition-left proposition-right)))
      (
        (#pt-lambda
          ((left-refutation (#pt-pi ((denied-proof proposition-left)) #pt-false)))
          (#pt-construct
            decision
            ()
            ((#pt-app (#pt-use conjunction ()) proposition-left proposition-right))
            no
            (
              (#pt-lambda
                ((both-proof (#pt-app (#pt-use conjunction ()) proposition-left proposition-right)))
                (#pt-app
                  left-refutation
                  (#pt-app
                    (#pt-use conjunction-left ())
                    proposition-left
                    proposition-right
                    both-proof))))))
        (#pt-lambda
          ((left-evidence proposition-left))
          (#pt-induct
            decision
            ()
            (proposition-right)
            (#pt-lambda
              ((decision-case (#pt-app (#pt-use decision ()) proposition-right)))
              (#pt-app
                (#pt-use decision ())
                (#pt-app (#pt-use conjunction ()) proposition-left proposition-right)))
            (
              (#pt-lambda
                ((right-refutation (#pt-pi ((denied-proof proposition-right)) #pt-false)))
                (#pt-construct
                  decision
                  ()
                  ((#pt-app (#pt-use conjunction ()) proposition-left proposition-right))
                  no
                  (
                    (#pt-lambda
                      (
                        (both-proof
                          (#pt-app (#pt-use conjunction ()) proposition-left proposition-right)))
                      (#pt-app
                        right-refutation
                        (#pt-app
                          (#pt-use conjunction-right ())
                          proposition-left
                          proposition-right
                          both-proof))))))
              (#pt-lambda
                ((right-evidence proposition-right))
                (#pt-construct
                  decision
                  ()
                  ((#pt-app (#pt-use conjunction ()) proposition-left proposition-right))
                  yes
                  (
                    (#pt-app
                      (#pt-use conjunction-introduce ())
                      proposition-left
                      proposition-right
                      left-evidence
                      right-evidence)))))
            decision-right)))
      decision-left)))
(#theorem decision-evidence
  (#universes)
  (#parameters
    (#parameter proposition #pt-prop)
    (#parameter value-decision (#pt-app (#pt-use decision ()) proposition)))
  (#statement
    (#pt-app (#pt-use disjunction ()) proposition (#pt-pi ((denied-proof proposition)) #pt-false)))
  (#proof
    (#pt-induct
      decision
      ()
      (proposition)
      (#pt-lambda
        ((decision-case (#pt-app (#pt-use decision ()) proposition)))
        (#pt-app
          (#pt-use disjunction ())
          proposition
          (#pt-pi ((denied-proof proposition)) #pt-false)))
      (
        (#pt-lambda
          ((refutation (#pt-pi ((denied-proof proposition)) #pt-false)))
          (#pt-app
            (#pt-use disjunction-right ())
            proposition
            (#pt-pi ((denied-proof proposition)) #pt-false)
            refutation))
        (#pt-lambda
          ((positive-proof proposition))
          (#pt-app
            (#pt-use disjunction-left ())
            proposition
            (#pt-pi ((denied-proof proposition)) #pt-false)
            positive-proof)))
      value-decision)))
