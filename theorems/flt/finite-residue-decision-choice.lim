; Mathematical source: pinned Mathlib EllipticCurve/Affine/Formula.lean and Point.lean.
; Generated by scripts/generate-flt-affine-points.py; checked native proof terms.
; Type-valued conditional arithmetic over checked decisions.
; Positive and negative branch equations require actual predicate
; evidence, never an unchecked choice or a proof extracted from Prop.
(#alias decision = ./logical-decision.lim::decision)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#alias less-than = ./natural-order.lim::less-than)
(#alias finite-residue = ./finite-residue-defs.lim::finite-residue)
(#math-definition finite-residue-choice ()
  (#pt-pi
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (predicate #pt-prop)
      (condition (#pt-app (#pt-use decision ()) predicate))
      (when-yes (#pt-app (#pt-use finite-residue ()) modulus))
      (when-no (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-app (#pt-use finite-residue ()) modulus))
  (#pt-lambda
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (predicate #pt-prop)
      (condition (#pt-app (#pt-use decision ()) predicate))
      (when-yes (#pt-app (#pt-use finite-residue ()) modulus))
      (when-no (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-induct
      decision
      ()
      (predicate)
      (#pt-lambda
        ((selected-decision (#pt-app (#pt-use decision ()) predicate)))
        (#pt-app (#pt-use finite-residue ()) modulus))
      (
        (#pt-lambda ((rejected-predicate (#pt-pi ((denied-evidence predicate)) #pt-false))) when-no)
        (#pt-lambda ((accepted-predicate predicate)) when-yes))
      condition)))
(#theorem finite-residue-choice-yes
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter predicate #pt-prop)
    (#parameter condition (#pt-app (#pt-use decision ()) predicate))
    (#parameter when-yes (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter when-no (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter predicate-proof predicate))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-residue-choice ())
          modulus
          positive-modulus
          predicate
          condition
          when-yes
          when-no))
      (#pt-project finite-residue 0 when-yes)))
  (#proof
    (#pt-induct
      decision
      ()
      (predicate)
      (#pt-lambda
        ((selected-decision (#pt-app (#pt-use decision ()) predicate)))
        (#pt-eq
          #pt-nat
          (#pt-project
            finite-residue
            0
            (#pt-app
              (#pt-use finite-residue-choice ())
              modulus
              positive-modulus
              predicate
              selected-decision
              when-yes
              when-no))
          (#pt-project finite-residue 0 when-yes)))
      (
        (#pt-lambda
          ((rejected-predicate (#pt-pi ((denied-evidence predicate)) #pt-false)))
          (#pt-app
            (#pt-use false-elimination ())
            (#pt-eq
              #pt-nat
              (#pt-project finite-residue 0 when-no)
              (#pt-project finite-residue 0 when-yes))
            (#pt-app rejected-predicate predicate-proof)))
        (#pt-lambda
          ((accepted-predicate predicate))
          (#pt-refl #pt-nat (#pt-project finite-residue 0 when-yes))))
      condition)))
(#theorem finite-residue-choice-no
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter predicate #pt-prop)
    (#parameter condition (#pt-app (#pt-use decision ()) predicate))
    (#parameter when-yes (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter when-no (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter predicate-refuted (#pt-pi ((denied-evidence predicate)) #pt-false)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-residue-choice ())
          modulus
          positive-modulus
          predicate
          condition
          when-yes
          when-no))
      (#pt-project finite-residue 0 when-no)))
  (#proof
    (#pt-induct
      decision
      ()
      (predicate)
      (#pt-lambda
        ((selected-decision (#pt-app (#pt-use decision ()) predicate)))
        (#pt-eq
          #pt-nat
          (#pt-project
            finite-residue
            0
            (#pt-app
              (#pt-use finite-residue-choice ())
              modulus
              positive-modulus
              predicate
              selected-decision
              when-yes
              when-no))
          (#pt-project finite-residue 0 when-no)))
      (
        (#pt-lambda
          ((rejected-predicate (#pt-pi ((denied-evidence predicate)) #pt-false)))
          (#pt-refl #pt-nat (#pt-project finite-residue 0 when-no)))
        (#pt-lambda
          ((accepted-predicate predicate))
          (#pt-app
            (#pt-use false-elimination ())
            (#pt-eq
              #pt-nat
              (#pt-project finite-residue 0 when-yes)
              (#pt-project finite-residue 0 when-no))
            (#pt-app predicate-refuted accepted-predicate))))
      condition)))
