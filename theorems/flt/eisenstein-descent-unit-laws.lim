; Actual inverse witnesses for the units in FLT/Three.lean:628-637.
; Products, negation, powers and the witnessed inverse remain units,
; with constructed two-sided inverses. No abstract units API is assumed.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-power = ./eisenstein-defs.lim::eisenstein-power)
(#alias eisenstein-unit = ./eisenstein-defs.lim::eisenstein-unit)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-congruent = ./eisenstein-equality.lim::eisenstein-multiply-congruent)
(#alias eisenstein-one-multiply = ./eisenstein-cubic-bridge.lim::eisenstein-one-multiply)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias exists = ./logic-exists.lim::exists)
(#alias eisenstein-negate = ./eisenstein-defs.lim::eisenstein-negate)
(#alias eisenstein-negate-congruent = ./eisenstein-equality.lim::eisenstein-negate-congruent)
(#alias eisenstein-multiply-negative = ./eisenstein-ring.lim::eisenstein-multiply-negative)
(#alias eisenstein-unit-congruent = ./eisenstein-unit-divisibility.lim::eisenstein-unit-congruent)
(#alias
  eisenstein-multiply-four-interchange
  =
  ./eisenstein-norm-multiply.lim::eisenstein-multiply-four-interchange)
(#alias eisenstein-minus-one-unit = ./eisenstein-constants.lim::eisenstein-minus-one-unit)
(#alias eisenstein-one-unit = ./eisenstein-cubic-bridge.lim::eisenstein-one-unit)
(#theorem eisenstein-witnessed-inverse-is-unit
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter first-inverse (#pt-use eisenstein ()))
    (#parameter inverse-certificate (#pt-app (#pt-use conjunction ()) (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-multiply ()) first first-inverse) (#pt-use eisenstein-one ())) (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-multiply ()) first-inverse first) (#pt-use eisenstein-one ())))))
  (#statement (#pt-app (#pt-use eisenstein-unit ()) first-inverse))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-inverse (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app (#pt-use eisenstein-multiply ()) first-inverse candidate-inverse)
              (#pt-use eisenstein-one ()))
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app (#pt-use eisenstein-multiply ()) candidate-inverse first-inverse)
              (#pt-use eisenstein-one ())))))
      introduce
      (first
        (#pt-app
          (#pt-use conjunction-introduce ())
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app (#pt-use eisenstein-multiply ()) first-inverse first)
            (#pt-use eisenstein-one ()))
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app (#pt-use eisenstein-multiply ()) first first-inverse)
            (#pt-use eisenstein-one ()))
          (#pt-app
            (#pt-use conjunction-right ())
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app (#pt-use eisenstein-multiply ()) first first-inverse)
              (#pt-use eisenstein-one ()))
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app (#pt-use eisenstein-multiply ()) first-inverse first)
              (#pt-use eisenstein-one ()))
            inverse-certificate)
          (#pt-app
            (#pt-use conjunction-left ())
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app (#pt-use eisenstein-multiply ()) first first-inverse)
              (#pt-use eisenstein-one ()))
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app (#pt-use eisenstein-multiply ()) first-inverse first)
              (#pt-use eisenstein-one ()))
            inverse-certificate))))))
(#theorem eisenstein-units-multiply
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter first-unit (#pt-app (#pt-use eisenstein-unit ()) first))
    (#parameter second-unit (#pt-app (#pt-use eisenstein-unit ()) second)))
  (#statement
    (#pt-app (#pt-use eisenstein-unit ()) (#pt-app (#pt-use eisenstein-multiply ()) first second)))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-inverse (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app (#pt-use eisenstein-multiply ()) first candidate-inverse)
              (#pt-use eisenstein-one ()))
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app (#pt-use eisenstein-multiply ()) candidate-inverse first)
              (#pt-use eisenstein-one ())))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-inverse (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) first candidate-inverse)
                    (#pt-use eisenstein-one ()))
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) candidate-inverse first)
                    (#pt-use eisenstein-one ())))))))
        (#pt-app
          (#pt-use eisenstein-unit ())
          (#pt-app (#pt-use eisenstein-multiply ()) first second)))
      (
        (#pt-lambda
          (
            (first-inverse (#pt-use eisenstein ()))
            (first-inverse-certificate
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-multiply ()) first first-inverse)
                  (#pt-use eisenstein-one ()))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-multiply ()) first-inverse first)
                  (#pt-use eisenstein-one ())))))
          (#pt-induct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-inverse (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) second candidate-inverse)
                    (#pt-use eisenstein-one ()))
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) candidate-inverse second)
                    (#pt-use eisenstein-one ())))))
            (#pt-lambda
              (
                (eisenstein-certificate
                  (#pt-app
                    (#pt-use exists (0))
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-inverse (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-app
                          (#pt-use eisenstein-equal ())
                          (#pt-app (#pt-use eisenstein-multiply ()) second candidate-inverse)
                          (#pt-use eisenstein-one ()))
                        (#pt-app
                          (#pt-use eisenstein-equal ())
                          (#pt-app (#pt-use eisenstein-multiply ()) candidate-inverse second)
                          (#pt-use eisenstein-one ())))))))
              (#pt-app
                (#pt-use eisenstein-unit ())
                (#pt-app (#pt-use eisenstein-multiply ()) first second)))
            (
              (#pt-lambda
                (
                  (second-inverse (#pt-use eisenstein ()))
                  (second-inverse-certificate
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app
                        (#pt-use eisenstein-equal ())
                        (#pt-app (#pt-use eisenstein-multiply ()) second second-inverse)
                        (#pt-use eisenstein-one ()))
                      (#pt-app
                        (#pt-use eisenstein-equal ())
                        (#pt-app (#pt-use eisenstein-multiply ()) second-inverse second)
                        (#pt-use eisenstein-one ())))))
                (#pt-construct
                  exists
                  (0)
                  (
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-inverse (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-app
                          (#pt-use eisenstein-equal ())
                          (#pt-app
                            (#pt-use eisenstein-multiply ())
                            (#pt-app (#pt-use eisenstein-multiply ()) first second)
                            candidate-inverse)
                          (#pt-use eisenstein-one ()))
                        (#pt-app
                          (#pt-use eisenstein-equal ())
                          (#pt-app
                            (#pt-use eisenstein-multiply ())
                            candidate-inverse
                            (#pt-app (#pt-use eisenstein-multiply ()) first second))
                          (#pt-use eisenstein-one ())))))
                  introduce
                  (
                    (#pt-app (#pt-use eisenstein-multiply ()) first-inverse second-inverse)
                    (#pt-app
                      (#pt-use conjunction-introduce ())
                      (#pt-app
                        (#pt-use eisenstein-equal ())
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          (#pt-app (#pt-use eisenstein-multiply ()) first second)
                          (#pt-app (#pt-use eisenstein-multiply ()) first-inverse second-inverse))
                        (#pt-use eisenstein-one ()))
                      (#pt-app
                        (#pt-use eisenstein-equal ())
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          (#pt-app (#pt-use eisenstein-multiply ()) first-inverse second-inverse)
                          (#pt-app (#pt-use eisenstein-multiply ()) first second))
                        (#pt-use eisenstein-one ()))
                      (#pt-app
                        (#pt-use eisenstein-transitive ())
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          (#pt-app (#pt-use eisenstein-multiply ()) first second)
                          (#pt-app (#pt-use eisenstein-multiply ()) first-inverse second-inverse))
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          (#pt-app (#pt-use eisenstein-multiply ()) first first-inverse)
                          (#pt-app (#pt-use eisenstein-multiply ()) second second-inverse))
                        (#pt-use eisenstein-one ())
                        (#pt-app
                          (#pt-use eisenstein-multiply-four-interchange ())
                          first
                          second
                          first-inverse
                          second-inverse)
                        (#pt-app
                          (#pt-use eisenstein-transitive ())
                          (#pt-app
                            (#pt-use eisenstein-multiply ())
                            (#pt-app (#pt-use eisenstein-multiply ()) first first-inverse)
                            (#pt-app (#pt-use eisenstein-multiply ()) second second-inverse))
                          (#pt-app
                            (#pt-use eisenstein-multiply ())
                            (#pt-use eisenstein-one ())
                            (#pt-use eisenstein-one ()))
                          (#pt-use eisenstein-one ())
                          (#pt-app
                            (#pt-use eisenstein-multiply-congruent ())
                            (#pt-app (#pt-use eisenstein-multiply ()) first first-inverse)
                            (#pt-app (#pt-use eisenstein-multiply ()) second second-inverse)
                            (#pt-use eisenstein-one ())
                            (#pt-use eisenstein-one ())
                            (#pt-app
                              (#pt-use conjunction-left ())
                              (#pt-app
                                (#pt-use eisenstein-equal ())
                                (#pt-app (#pt-use eisenstein-multiply ()) first first-inverse)
                                (#pt-use eisenstein-one ()))
                              (#pt-app
                                (#pt-use eisenstein-equal ())
                                (#pt-app (#pt-use eisenstein-multiply ()) first-inverse first)
                                (#pt-use eisenstein-one ()))
                              first-inverse-certificate)
                            (#pt-app
                              (#pt-use conjunction-left ())
                              (#pt-app
                                (#pt-use eisenstein-equal ())
                                (#pt-app (#pt-use eisenstein-multiply ()) second second-inverse)
                                (#pt-use eisenstein-one ()))
                              (#pt-app
                                (#pt-use eisenstein-equal ())
                                (#pt-app (#pt-use eisenstein-multiply ()) second-inverse second)
                                (#pt-use eisenstein-one ()))
                              second-inverse-certificate))
                          (#pt-app (#pt-use eisenstein-one-multiply ()) (#pt-use eisenstein-one ()))))
                      (#pt-app
                        (#pt-use eisenstein-transitive ())
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          (#pt-app (#pt-use eisenstein-multiply ()) first-inverse second-inverse)
                          (#pt-app (#pt-use eisenstein-multiply ()) first second))
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          (#pt-app (#pt-use eisenstein-multiply ()) first-inverse first)
                          (#pt-app (#pt-use eisenstein-multiply ()) second-inverse second))
                        (#pt-use eisenstein-one ())
                        (#pt-app
                          (#pt-use eisenstein-multiply-four-interchange ())
                          first-inverse
                          second-inverse
                          first
                          second)
                        (#pt-app
                          (#pt-use eisenstein-transitive ())
                          (#pt-app
                            (#pt-use eisenstein-multiply ())
                            (#pt-app (#pt-use eisenstein-multiply ()) first-inverse first)
                            (#pt-app (#pt-use eisenstein-multiply ()) second-inverse second))
                          (#pt-app
                            (#pt-use eisenstein-multiply ())
                            (#pt-use eisenstein-one ())
                            (#pt-use eisenstein-one ()))
                          (#pt-use eisenstein-one ())
                          (#pt-app
                            (#pt-use eisenstein-multiply-congruent ())
                            (#pt-app (#pt-use eisenstein-multiply ()) first-inverse first)
                            (#pt-app (#pt-use eisenstein-multiply ()) second-inverse second)
                            (#pt-use eisenstein-one ())
                            (#pt-use eisenstein-one ())
                            (#pt-app
                              (#pt-use conjunction-right ())
                              (#pt-app
                                (#pt-use eisenstein-equal ())
                                (#pt-app (#pt-use eisenstein-multiply ()) first first-inverse)
                                (#pt-use eisenstein-one ()))
                              (#pt-app
                                (#pt-use eisenstein-equal ())
                                (#pt-app (#pt-use eisenstein-multiply ()) first-inverse first)
                                (#pt-use eisenstein-one ()))
                              first-inverse-certificate)
                            (#pt-app
                              (#pt-use conjunction-right ())
                              (#pt-app
                                (#pt-use eisenstein-equal ())
                                (#pt-app (#pt-use eisenstein-multiply ()) second second-inverse)
                                (#pt-use eisenstein-one ()))
                              (#pt-app
                                (#pt-use eisenstein-equal ())
                                (#pt-app (#pt-use eisenstein-multiply ()) second-inverse second)
                                (#pt-use eisenstein-one ()))
                              second-inverse-certificate))
                          (#pt-app (#pt-use eisenstein-one-multiply ()) (#pt-use eisenstein-one ())))))))))
            second-unit)))
      first-unit)))
(#theorem eisenstein-unit-negate
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter unit-certificate (#pt-app (#pt-use eisenstein-unit ()) first)))
  (#statement (#pt-app (#pt-use eisenstein-unit ()) (#pt-app (#pt-use eisenstein-negate ()) first)))
  (#proof
    (#pt-app
      (#pt-use eisenstein-unit-congruent ())
      (#pt-app
        (#pt-use eisenstein-multiply ())
        (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))
        first)
      (#pt-app (#pt-use eisenstein-negate ()) first)
      (#pt-app
        (#pt-use eisenstein-transitive ())
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))
          first)
        (#pt-app
          (#pt-use eisenstein-negate ())
          (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) first))
        (#pt-app (#pt-use eisenstein-negate ()) first)
        (#pt-app (#pt-use eisenstein-multiply-negative ()) (#pt-use eisenstein-one ()) first)
        (#pt-app
          (#pt-use eisenstein-negate-congruent ())
          (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) first)
          first
          (#pt-app (#pt-use eisenstein-one-multiply ()) first)))
      (#pt-app
        (#pt-use eisenstein-units-multiply ())
        (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))
        first
        (#pt-use eisenstein-minus-one-unit ())
        unit-certificate))))
(#theorem eisenstein-unit-power
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter exponent #pt-nat)
    (#parameter unit-certificate (#pt-app (#pt-use eisenstein-unit ()) first)))
  (#statement
    (#pt-app (#pt-use eisenstein-unit ()) (#pt-app (#pt-use eisenstein-power ()) first exponent)))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((index #pt-nat))
        (#pt-app (#pt-use eisenstein-unit ()) (#pt-app (#pt-use eisenstein-power ()) first index)))
      (#pt-use eisenstein-one-unit ())
      (#pt-lambda
        (
          (previous #pt-nat)
          (previous-unit
            (#pt-app
              (#pt-use eisenstein-unit ())
              (#pt-app (#pt-use eisenstein-power ()) first previous))))
        (#pt-app
          (#pt-use eisenstein-units-multiply ())
          first
          (#pt-app (#pt-use eisenstein-power ()) first previous)
          unit-certificate
          previous-unit))
      exponent)))
