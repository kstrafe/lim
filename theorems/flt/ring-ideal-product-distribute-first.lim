; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Prove (I+J)*K=I*K+J*K for arbitrary
; actual ideals. The forward inclusion uses the colon ideal and
; sum minimality; the reverse uses product monotonicity.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias ring-ideal = ./ring-ideal-data.lim::ring-ideal)
(#alias ring-ideal-equal = ./ring-ideal-data.lim::ring-ideal-equal)
(#alias ring-ideal-product = ./ring-ideal-product.lim::ring-ideal-product)
(#alias
  ring-ideal-product-distribute-first-inclusion
  =
  ./ring-ideal-product-distribute-first-inclusion.lim::ring-ideal-product-distribute-first-inclusion)
(#alias
  ring-ideal-product-monotone
  =
  ./ring-ideal-product-basic-laws.lim::ring-ideal-product-monotone)
(#alias ring-ideal-subset = ./ring-ideal-data.lim::ring-ideal-subset)
(#alias ring-ideal-subset-reflexive = ./ring-ideal-equivalence.lim::ring-ideal-subset-reflexive)
(#alias ring-ideal-sum = ./ring-ideal-sum.lim::ring-ideal-sum)
(#alias ring-ideal-sum-least = ./ring-ideal-sum-universal.lim::ring-ideal-sum-least)
(#alias ring-ideal-sum-left = ./ring-ideal-sum-universal.lim::ring-ideal-sum-left)
(#alias ring-ideal-sum-right = ./ring-ideal-sum-universal.lim::ring-ideal-sum-right)
(#theorem ring-ideal-product-distribute-first
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter third-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)
        third-ideal)
      (#pt-app
        (#pt-use ring-ideal-sum ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal third-ideal)
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring second-ideal third-ideal))))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)
          third-ideal)
        (#pt-app
          (#pt-use ring-ideal-sum ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal third-ideal)
          (#pt-app
            (#pt-use ring-ideal-product ())
            Carrier
            coefficient-ring
            second-ideal
            third-ideal)))
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-sum ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal third-ideal)
          (#pt-app
            (#pt-use ring-ideal-product ())
            Carrier
            coefficient-ring
            second-ideal
            third-ideal))
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)
          third-ideal))
      (#pt-app
        (#pt-use ring-ideal-product-distribute-first-inclusion ())
        Carrier
        coefficient-ring
        first-ideal
        second-ideal
        third-ideal)
      (#pt-app
        (#pt-use ring-ideal-sum-least ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal third-ideal)
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring second-ideal third-ideal)
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)
          third-ideal)
        (#pt-app
          (#pt-use ring-ideal-product-monotone ())
          Carrier
          coefficient-ring
          first-ideal
          third-ideal
          (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)
          third-ideal
          (#pt-app
            (#pt-use ring-ideal-sum-left ())
            Carrier
            coefficient-ring
            first-ideal
            second-ideal)
          (#pt-app (#pt-use ring-ideal-subset-reflexive ()) Carrier coefficient-ring third-ideal))
        (#pt-app
          (#pt-use ring-ideal-product-monotone ())
          Carrier
          coefficient-ring
          second-ideal
          third-ideal
          (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)
          third-ideal
          (#pt-app
            (#pt-use ring-ideal-sum-right ())
            Carrier
            coefficient-ring
            first-ideal
            second-ideal)
          (#pt-app (#pt-use ring-ideal-subset-reflexive ()) Carrier coefficient-ring third-ideal))))))
