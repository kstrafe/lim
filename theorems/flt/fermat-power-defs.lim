; Actual positive-coordinate power solutions for an arbitrary exponent.
; Primitive and smaller witnesses retain the original power equation,
; all three nonzero coordinates, and actual coprimality or strict decrease.
; These definitions assert no counterexample or primitive solution exists.
(#alias add = ./../fermat_statement.lim::add)
(#alias power = ./../fermat_statement.lim::power)
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias coprime = ./natural-coprime.lim::coprime)
(#math-inductive natural-power-solution ()
  ((exponent #pt-nat) (first #pt-nat) (second #pt-nat) (third #pt-nat))
  #pt-prop
  (
    (introduce
      (
        (first-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat first #pt-zero))) #pt-false))
        (second-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat second #pt-zero))) #pt-false))
        (third-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat third #pt-zero))) #pt-false))
        (power-equation
          (#pt-eq
            #pt-nat
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use power ()) first exponent)
              (#pt-app (#pt-use power ()) second exponent))
            (#pt-app (#pt-use power ()) third exponent)))))))
(#math-definition has-natural-primitive-power-solution ()
  (#pt-pi ((exponent #pt-nat)) #pt-prop)
  (#pt-lambda
    ((exponent #pt-nat))
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-first #pt-nat))
        (#pt-app
          (#pt-use exists (0))
          #pt-nat
          (#pt-lambda
            ((candidate-second #pt-nat))
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-third #pt-nat))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use natural-power-solution ())
                    exponent
                    candidate-first
                    candidate-second
                    candidate-third)
                  (#pt-app (#pt-use coprime ()) candidate-first candidate-second))))))))))
(#math-definition has-smaller-natural-power-solution ()
  (#pt-pi ((exponent #pt-nat) (bound #pt-nat)) #pt-prop)
  (#pt-lambda
    ((exponent #pt-nat) (bound #pt-nat))
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-first #pt-nat))
        (#pt-app
          (#pt-use exists (0))
          #pt-nat
          (#pt-lambda
            ((candidate-second #pt-nat))
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-third #pt-nat))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use natural-power-solution ())
                    exponent
                    candidate-first
                    candidate-second
                    candidate-third)
                  (#pt-app (#pt-use less-than ()) candidate-third bound))))))))))
