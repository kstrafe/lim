(#theorem eisenstein-add-cancel-left
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter third (#pt-use eisenstein ()))
    (#parameter sum-equivalence (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-add ()) first second) (#pt-app (#pt-use eisenstein-add ()) first third))))
  (#statement (#pt-app (#pt-use eisenstein-equal ()) second third))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project eisenstein 0 second)
        (#pt-project eisenstein 0 third))
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project eisenstein 1 second)
        (#pt-project eisenstein 1 third))
      (#pt-app
        (#pt-use integer-add-cancel-left ())
        (#pt-project eisenstein 0 first)
        (#pt-project eisenstein 0 second)
        (#pt-project eisenstein 0 third)
        (#pt-app
          (#pt-use conjunction-left ())
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-project eisenstein 0 (#pt-app (#pt-use eisenstein-add ()) first second))
            (#pt-project eisenstein 0 (#pt-app (#pt-use eisenstein-add ()) first third)))
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-project eisenstein 1 (#pt-app (#pt-use eisenstein-add ()) first second))
            (#pt-project eisenstein 1 (#pt-app (#pt-use eisenstein-add ()) first third)))
          sum-equivalence))
      (#pt-app
        (#pt-use integer-add-cancel-left ())
        (#pt-project eisenstein 1 first)
        (#pt-project eisenstein 1 second)
        (#pt-project eisenstein 1 third)
        (#pt-app
          (#pt-use conjunction-right ())
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-project eisenstein 0 (#pt-app (#pt-use eisenstein-add ()) first second))
            (#pt-project eisenstein 0 (#pt-app (#pt-use eisenstein-add ()) first third)))
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-project eisenstein 1 (#pt-app (#pt-use eisenstein-add ()) first second))
            (#pt-project eisenstein 1 (#pt-app (#pt-use eisenstein-add ()) first third)))
          sum-equivalence)))))
(#theorem eisenstein-power-congruent
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter exponent #pt-nat)
    (#parameter equivalent (#pt-app (#pt-use eisenstein-equal ()) first second)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app (#pt-use eisenstein-power ()) first exponent)
      (#pt-app (#pt-use eisenstein-power ()) second exponent)))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((index #pt-nat))
        (#pt-app
          (#pt-use eisenstein-equal ())
          (#pt-app (#pt-use eisenstein-power ()) first index)
          (#pt-app (#pt-use eisenstein-power ()) second index)))
      (#pt-app (#pt-use eisenstein-reflexive ()) (#pt-use eisenstein-one ()))
      (#pt-lambda
        (
          (previous #pt-nat)
          (previous-equivalence
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app (#pt-use eisenstein-power ()) first previous)
              (#pt-app (#pt-use eisenstein-power ()) second previous))))
        (#pt-app
          (#pt-use eisenstein-multiply-congruent ())
          first
          (#pt-app (#pt-use eisenstein-power ()) first previous)
          second
          (#pt-app (#pt-use eisenstein-power ()) second previous)
          equivalent
          previous-equivalence))
      exponent)))
