; Port c4_pow_three_mul_Delta_eq_of_isIntegralModelOf from the pinned
; comparison source. Eliminate both actual variable-change witnesses
; only into Prop, then reflect the rational cross-invariant identity.
(#alias exists = ./logic-exists.lim::exists)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-power = ./integer-defs.lim::integer-power)
(#alias rational-weierstrass-curve = ./rational-weierstrass-defs.lim::rational-weierstrass-curve)
(#alias integer-weierstrass-curve = ./integer-weierstrass-defs.lim::integer-weierstrass-curve)
(#alias
  integer-weierstrass-map-rational
  =
  ./integer-weierstrass-defs.lim::integer-weierstrass-map-rational)
(#alias integer-weierstrass-c4 = ./integer-weierstrass-defs.lim::integer-weierstrass-c4)
(#alias
  integer-weierstrass-discriminant
  =
  ./integer-weierstrass-defs.lim::integer-weierstrass-discriminant)
(#alias
  rational-weierstrass-equivalent
  =
  ./weierstrass-model-equivalence.lim::rational-weierstrass-equivalent)
(#alias rational-variable-change = ./rational-variable-change-defs.lim::rational-variable-change)
(#alias
  rational-variable-change-act
  =
  ./rational-variable-change-defs.lim::rational-variable-change-act)
(#alias
  rational-integral-model-cross-invariant
  =
  ./rational-model-cross-invariant.lim::rational-integral-model-cross-invariant)
(#alias
  integer-is-integral-model-of
  =
  ./integer-integral-model-defs.lim::integer-is-integral-model-of)
(#alias
  integer-cross-invariants-reflect
  =
  ./integer-model-cross-reflection.lim::integer-cross-invariants-reflect)
(#theorem integer-integral-model-cross-invariant
  (#universes)
  (#parameters
    (#parameter first-model (#pt-use integer-weierstrass-curve ()))
    (#parameter second-model (#pt-use integer-weierstrass-curve ()))
    (#parameter rational-curve (#pt-use rational-weierstrass-curve ()))
    (#parameter first-model-certificate (#pt-app (#pt-use integer-is-integral-model-of ()) first-model rational-curve))
    (#parameter second-model-certificate (#pt-app (#pt-use integer-is-integral-model-of ()) second-model rational-curve)))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model)
          (#pt-numeral 3))
        (#pt-app (#pt-use integer-weierstrass-discriminant ()) second-model))
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app (#pt-use integer-weierstrass-c4 ()) second-model)
          (#pt-numeral 3))
        (#pt-app (#pt-use integer-weierstrass-discriminant ()) first-model))))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use rational-variable-change ())
        (#pt-lambda
          ((candidate-change (#pt-use rational-variable-change ())))
          (#pt-app
            (#pt-use rational-weierstrass-equivalent ())
            (#pt-app (#pt-use rational-variable-change-act ()) candidate-change rational-curve)
            (#pt-app (#pt-use integer-weierstrass-map-rational ()) first-model))))
      (#pt-lambda
        (
          (first-model-existence
            (#pt-app (#pt-use integer-is-integral-model-of ()) first-model rational-curve)))
        (#pt-app
          (#pt-use integer-equal ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model)
              (#pt-numeral 3))
            (#pt-app (#pt-use integer-weierstrass-discriminant ()) second-model))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app (#pt-use integer-weierstrass-c4 ()) second-model)
              (#pt-numeral 3))
            (#pt-app (#pt-use integer-weierstrass-discriminant ()) first-model))))
      (
        (#pt-lambda
          (
            (first-change (#pt-use rational-variable-change ()))
            (first-coefficient-certificate
              (#pt-app
                (#pt-use rational-weierstrass-equivalent ())
                (#pt-app (#pt-use rational-variable-change-act ()) first-change rational-curve)
                (#pt-app (#pt-use integer-weierstrass-map-rational ()) first-model))))
          (#pt-induct
            exists
            (0)
            (
              (#pt-use rational-variable-change ())
              (#pt-lambda
                ((candidate-change (#pt-use rational-variable-change ())))
                (#pt-app
                  (#pt-use rational-weierstrass-equivalent ())
                  (#pt-app
                    (#pt-use rational-variable-change-act ())
                    candidate-change
                    rational-curve)
                  (#pt-app (#pt-use integer-weierstrass-map-rational ()) second-model))))
            (#pt-lambda
              (
                (second-model-existence
                  (#pt-app (#pt-use integer-is-integral-model-of ()) second-model rational-curve)))
              (#pt-app
                (#pt-use integer-equal ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app
                    (#pt-use integer-power ())
                    (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model)
                    (#pt-numeral 3))
                  (#pt-app (#pt-use integer-weierstrass-discriminant ()) second-model))
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app
                    (#pt-use integer-power ())
                    (#pt-app (#pt-use integer-weierstrass-c4 ()) second-model)
                    (#pt-numeral 3))
                  (#pt-app (#pt-use integer-weierstrass-discriminant ()) first-model))))
            (
              (#pt-lambda
                (
                  (second-change (#pt-use rational-variable-change ()))
                  (second-coefficient-certificate
                    (#pt-app
                      (#pt-use rational-weierstrass-equivalent ())
                      (#pt-app
                        (#pt-use rational-variable-change-act ())
                        second-change
                        rational-curve)
                      (#pt-app (#pt-use integer-weierstrass-map-rational ()) second-model))))
                (#pt-app
                  (#pt-use integer-cross-invariants-reflect ())
                  first-model
                  second-model
                  (#pt-app
                    (#pt-use rational-integral-model-cross-invariant ())
                    first-change
                    second-change
                    rational-curve
                    (#pt-app (#pt-use integer-weierstrass-map-rational ()) first-model)
                    (#pt-app (#pt-use integer-weierstrass-map-rational ()) second-model)
                    first-coefficient-certificate
                    second-coefficient-certificate))))
            second-model-certificate)))
      first-model-certificate)))
