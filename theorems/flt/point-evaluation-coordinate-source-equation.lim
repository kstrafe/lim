          Y-polynomial)
        root)
      (#pt-app
        (#pt-use ring-evaluation ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        Carrier
        coefficient-ring
        (#pt-app (#pt-use polynomial-root-evaluation-morphism ()) Carrier coefficient-ring root)
        (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring Y-polynomial root)
        (#pt-app
          (#pt-use quadratic-division-divisor ())
          (#pt-app (#pt-use finite-list ()) Carrier)
          (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
          quadratic-linear
          quadratic-constant))))
  (#proof
    (#pt-app
      (#pt-use ring-transitive ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-evaluate ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-evaluate ())
          (#pt-app (#pt-use finite-list ()) Carrier)
          (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
          (#pt-app
            (#pt-use quadratic-division-divisor ())
            (#pt-app (#pt-use finite-list ()) Carrier)
            (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
            quadratic-linear
            quadratic-constant)
          Y-polynomial)
        root)
      (#pt-app
        (#pt-use ring-evaluation-map ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        Carrier
        coefficient-ring
        (#pt-app (#pt-use polynomial-root-evaluation-morphism ()) Carrier coefficient-ring root)
        (#pt-app
          (#pt-use ring-polynomial-evaluate ())
          (#pt-app (#pt-use finite-list ()) Carrier)
          (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
          (#pt-app
            (#pt-use quadratic-division-divisor ())
            (#pt-app (#pt-use finite-list ()) Carrier)
            (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
            quadratic-linear
            quadratic-constant)
          Y-polynomial))
      (#pt-app
        (#pt-use ring-evaluation ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        Carrier
        coefficient-ring
        (#pt-app (#pt-use polynomial-root-evaluation-morphism ()) Carrier coefficient-ring root)
        (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring Y-polynomial root)
        (#pt-app
          (#pt-use quadratic-division-divisor ())
          (#pt-app (#pt-use finite-list ()) Carrier)
          (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
          quadratic-linear
          quadratic-constant))
      (#pt-app
        (#pt-use ring-symmetric ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-evaluation-map ())
          (#pt-app (#pt-use finite-list ()) Carrier)
          (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-evaluation-morphism ()) Carrier coefficient-ring root)
          (#pt-app
            (#pt-use ring-polynomial-evaluate ())
            (#pt-app (#pt-use finite-list ()) Carrier)
            (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
            (#pt-app
              (#pt-use quadratic-division-divisor ())
              (#pt-app (#pt-use finite-list ()) Carrier)
              (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
              quadratic-linear
              quadratic-constant)
            Y-polynomial))
        (#pt-app
          (#pt-use ring-polynomial-evaluate ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-evaluate ())
            (#pt-app (#pt-use finite-list ()) Carrier)
            (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
            (#pt-app
              (#pt-use quadratic-division-divisor ())
              (#pt-app (#pt-use finite-list ()) Carrier)
              (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
              quadratic-linear
              quadratic-constant)
            Y-polynomial)
          root)
        (#pt-app
          (#pt-use polynomial-root-evaluation-mapping ())
          Carrier
          coefficient-ring
          root
          (#pt-app
            (#pt-use ring-polynomial-evaluate ())
            (#pt-app (#pt-use finite-list ()) Carrier)
            (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
            (#pt-app
              (#pt-use quadratic-division-divisor ())
              (#pt-app (#pt-use finite-list ()) Carrier)
              (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
              quadratic-linear
              quadratic-constant)
            Y-polynomial)))
      (#pt-app
        (#pt-use point-evaluation-naturality ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        Carrier
        coefficient-ring
        (#pt-app (#pt-use polynomial-root-evaluation-morphism ()) Carrier coefficient-ring root)
        Y-polynomial
        (#pt-app
          (#pt-use quadratic-division-divisor ())
          (#pt-app (#pt-use finite-list ()) Carrier)
          (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
          quadratic-linear
