; Prove the source nested
; evaluation (definingPolynomial.eval y).eval x equals the actual
; curve premise used by coordinate evaluation. The equality is
; derived from checked evaluation naturality, not assumed.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias
