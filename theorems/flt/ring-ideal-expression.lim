; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Finite, inspectable linear-combination expressions
; contain only zero, admitted generators with their membership evidence,
; sums, negations and scalar multiples. Structural recursion computes
; their actual ring value; there is no abstract span oracle.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias ring-add = ./commutative-ring-data.lim::ring-add)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-negate = ./commutative-ring-data.lim::ring-negate)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#math-inductive ring-ideal-expression ()
  ((Carrier (#pt-type 0)) (generators (#pt-pi ((element Carrier)) #pt-prop)))
  (#pt-type 0)
  (
    (zero ())
    (generator ((value Carrier) (evidence (#pt-app generators value))))
    (addition
      (
        (left (#pt-app (#pt-use ring-ideal-expression ()) Carrier generators))
        (right (#pt-app (#pt-use ring-ideal-expression ()) Carrier generators))))
    (negation ((value (#pt-app (#pt-use ring-ideal-expression ()) Carrier generators))))
    (multiple
      (
        (coefficient Carrier)
        (value (#pt-app (#pt-use ring-ideal-expression ()) Carrier generators))))))
(#math-definition ring-ideal-expression-value ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (generators (#pt-pi ((element Carrier)) #pt-prop))
      (expression (#pt-app (#pt-use ring-ideal-expression ()) Carrier generators)))
    Carrier)
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (generators (#pt-pi ((element Carrier)) #pt-prop))
      (expression (#pt-app (#pt-use ring-ideal-expression ()) Carrier generators)))
    (#pt-induct
      ring-ideal-expression
      ()
      (Carrier generators)
      (#pt-lambda
        ((selected-expression (#pt-app (#pt-use ring-ideal-expression ()) Carrier generators)))
        Carrier)
      (
        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
        (#pt-lambda ((generator Carrier) (evidence (#pt-app generators generator))) generator)
        (#pt-lambda
          (
            (left (#pt-app (#pt-use ring-ideal-expression ()) Carrier generators))
            (left-value Carrier)
            (right (#pt-app (#pt-use ring-ideal-expression ()) Carrier generators))
            (right-value Carrier))
          (#pt-app (#pt-use ring-add ()) Carrier coefficient-ring left-value right-value))
        (#pt-lambda
          (
            (original (#pt-app (#pt-use ring-ideal-expression ()) Carrier generators))
            (original-value Carrier))
          (#pt-app (#pt-use ring-negate ()) Carrier coefficient-ring original-value))
        (#pt-lambda
          (
            (scalar Carrier)
            (original (#pt-app (#pt-use ring-ideal-expression ()) Carrier generators))
            (original-value Carrier))
          (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring scalar original-value)))
      expression)))
(#theorem ring-ideal-expression-zero-value
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter generators (#pt-pi ((element Carrier)) #pt-prop)))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-ideal-expression-value ())
        Carrier
        coefficient-ring
        generators
        (#pt-construct ring-ideal-expression () (Carrier generators) zero ()))
      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
  (#proof
    (#pt-app
      (#pt-use ring-reflexive ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
