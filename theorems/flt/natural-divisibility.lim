; Direct constructive natural divisibility proofs using multiplication witnesses.
(#alias exists = ./logic-exists.lim::exists)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias congruence = ./equality.lim::congruence)
(#alias multiply-zero-right = ./natural-multiplication-right.lim::multiply-zero-right)
(#alias multiply-one-right = ./natural-multiplication-right.lim::multiply-one-right)
(#alias multiply-one-left = ./natural-multiplication.lim::multiply-one-left)
(#alias multiply-associative = ./natural-multiplication.lim::multiply-associative)
(#theorem divides-reflexive
  (#universes)
  (#parameters
    (#parameter number #pt-nat))
  (#statement (#pt-app (#pt-use divides ()) number number))
  (#proof
    (#pt-construct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((divisibility-witness #pt-nat))
          (#pt-eq #pt-nat number (#pt-app (#pt-use multiply ()) number divisibility-witness))))
      introduce
      (
        (#pt-succ #pt-zero)
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          (#pt-app (#pt-use multiply ()) number (#pt-succ #pt-zero))
          number
          (#pt-app (#pt-use multiply-one-right ()) number))))))
(#theorem one-divides
  (#universes)
  (#parameters
    (#parameter number #pt-nat))
  (#statement (#pt-app (#pt-use divides ()) (#pt-succ #pt-zero) number))
  (#proof
    (#pt-construct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((divisibility-witness #pt-nat))
          (#pt-eq
            #pt-nat
            number
            (#pt-app (#pt-use multiply ()) (#pt-succ #pt-zero) divisibility-witness))))
      introduce
      (number
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          (#pt-app (#pt-use multiply ()) (#pt-succ #pt-zero) number)
          number
          (#pt-app (#pt-use multiply-one-left ()) number))))))
(#theorem divides-zero
  (#universes)
  (#parameters
    (#parameter number #pt-nat))
  (#statement (#pt-app (#pt-use divides ()) number #pt-zero))
  (#proof
    (#pt-construct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((divisibility-witness #pt-nat))
          (#pt-eq #pt-nat #pt-zero (#pt-app (#pt-use multiply ()) number divisibility-witness))))
      introduce
      (#pt-zero
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          (#pt-app (#pt-use multiply ()) number #pt-zero)
          #pt-zero
          (#pt-app (#pt-use multiply-zero-right ()) number))))))
(#theorem divides-multiple
  (#universes)
  (#parameters
    (#parameter divisor #pt-nat)
    (#parameter factor #pt-nat))
  (#statement (#pt-app (#pt-use divides ()) divisor (#pt-app (#pt-use multiply ()) divisor factor)))
  (#proof
    (#pt-construct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((divisibility-witness #pt-nat))
          (#pt-eq
            #pt-nat
            (#pt-app (#pt-use multiply ()) divisor factor)
            (#pt-app (#pt-use multiply ()) divisor divisibility-witness))))
      introduce
      (factor (#pt-refl #pt-nat (#pt-app (#pt-use multiply ()) divisor factor))))))
(#theorem divides-transitive
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter third #pt-nat)
    (#parameter first-proof (#pt-app (#pt-use divides ()) first second))
    (#parameter second-proof (#pt-app (#pt-use divides ()) second third)))
  (#statement (#pt-app (#pt-use divides ()) first third))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((divisibility-witness #pt-nat))
          (#pt-eq #pt-nat second (#pt-app (#pt-use multiply ()) first divisibility-witness))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((divisibility-witness #pt-nat))
                (#pt-eq #pt-nat second (#pt-app (#pt-use multiply ()) first divisibility-witness))))))
        (#pt-app (#pt-use divides ()) first third))
      (
        (#pt-lambda
          (
            (first-factor #pt-nat)
            (first-position
              (#pt-eq #pt-nat second (#pt-app (#pt-use multiply ()) first first-factor))))
          (#pt-induct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((divisibility-witness #pt-nat))
                (#pt-eq #pt-nat third (#pt-app (#pt-use multiply ()) second divisibility-witness))))
            (#pt-lambda
              (
                (certificate
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((divisibility-witness #pt-nat))
                      (#pt-eq
                        #pt-nat
                        third
                        (#pt-app (#pt-use multiply ()) second divisibility-witness))))))
              (#pt-app (#pt-use divides ()) first third))
            (
              (#pt-lambda
                (
                  (second-factor #pt-nat)
                  (second-position
                    (#pt-eq #pt-nat third (#pt-app (#pt-use multiply ()) second second-factor))))
                (#pt-construct
                  exists
                  (0)
                  (#pt-nat
                    (#pt-lambda
                      ((divisibility-witness #pt-nat))
                      (#pt-eq
                        #pt-nat
                        third
                        (#pt-app (#pt-use multiply ()) first divisibility-witness))))
                  introduce
                  (
                    (#pt-app (#pt-use multiply ()) first-factor second-factor)
                    (#pt-app
                      (#pt-use transitivity (0))
                      #pt-nat
                      third
                      (#pt-app (#pt-use multiply ()) second second-factor)
                      (#pt-app
                        (#pt-use multiply ())
                        first
                        (#pt-app (#pt-use multiply ()) first-factor second-factor))
                      second-position
                      (#pt-app
                        (#pt-use transitivity (0))
                        #pt-nat
                        (#pt-app (#pt-use multiply ()) second second-factor)
                        (#pt-app
                          (#pt-use multiply ())
                          (#pt-app (#pt-use multiply ()) first first-factor)
                          second-factor)
                        (#pt-app
                          (#pt-use multiply ())
                          first
                          (#pt-app (#pt-use multiply ()) first-factor second-factor))
                        (#pt-app
                          (#pt-use congruence (0 0))
                          #pt-nat
                          #pt-nat
                          (#pt-lambda
                            ((value #pt-nat))
                            (#pt-app (#pt-use multiply ()) value second-factor))
                          second
                          (#pt-app (#pt-use multiply ()) first first-factor)
                          first-position)
                        (#pt-app (#pt-use multiply-associative ()) first first-factor second-factor)))))))
            second-proof)))
      first-proof)))
