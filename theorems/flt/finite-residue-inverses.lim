(#math-definition finite-inverse-natural ()
  (#pt-pi
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (number #pt-nat))
    (#pt-app (#pt-use finite-residue ()) modulus))
  (#pt-lambda
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (number #pt-nat))
    (#pt-nat-induct
      (#pt-lambda ((inverse-index #pt-nat)) (#pt-app (#pt-use finite-residue ()) modulus))
      (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)
      (#pt-lambda
        ((previous-input #pt-nat) (unused-inverse (#pt-app (#pt-use finite-residue ()) modulus)))
        (#pt-app
          (#pt-use finite-residue-of-integer ())
          modulus
          positive-modulus
          (#pt-project
            natural-extended-gcd-data
            1
            (#pt-app (#pt-use compute-natural-extended-gcd ()) (#pt-succ previous-input) modulus))))
      number)))
(#math-definition finite-residue-inverse ()
  (#pt-pi
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (element (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-app (#pt-use finite-residue ()) modulus))
  (#pt-lambda
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (element (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-app
      (#pt-use finite-inverse-natural ())
      modulus
      positive-modulus
      (#pt-project finite-residue 0 element))))
(#theorem finite-residue-inverse-zero
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-residue-inverse ())
          modulus
          positive-modulus
          (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)))
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus))))
  (#proof
    (#pt-refl
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)))))
(#theorem finite-residue-inverse-congruent
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter first-residue (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second-residue (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter value-equation (#pt-eq #pt-nat (#pt-project finite-residue 0 first-residue) (#pt-project finite-residue 0 second-residue))))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-inverse ()) modulus positive-modulus first-residue))
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-inverse ()) modulus positive-modulus second-residue))))
  (#proof
    (#pt-app
      (#pt-use congruence (0 0))
      #pt-nat
      #pt-nat
      (#pt-lambda
        ((inverse-input #pt-nat))
        (#pt-project
          finite-residue
          0
          (#pt-app (#pt-use finite-inverse-natural ()) modulus positive-modulus inverse-input)))
      (#pt-project finite-residue 0 first-residue)
      (#pt-project finite-residue 0 second-residue)
      value-equation)))
