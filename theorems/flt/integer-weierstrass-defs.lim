(#alias rational-weierstrass-curve = ./rational-weierstrass-defs.lim::rational-weierstrass-curve)
(#math-inductive integer-weierstrass-curve ()
  ()
  (#pt-type 0)
  (
    (coefficients
      (
        (a1 (#pt-use integer ()))
        (a2 (#pt-use integer ()))
        (a3 (#pt-use integer ()))
        (a4 (#pt-use integer ()))
        (a6 (#pt-use integer ()))))))
(#math-definition integer-weierstrass-map-rational ()
  (#pt-pi ((curve (#pt-use integer-weierstrass-curve ()))) (#pt-use rational-weierstrass-curve ()))
  (#pt-lambda
    ((curve (#pt-use integer-weierstrass-curve ())))
    (#pt-construct
      rational-weierstrass-curve
      ()
      ()
      coefficients
      (
        (#pt-app (#pt-use rational-of-integer ()) (#pt-project integer-weierstrass-curve 0 curve))
        (#pt-app (#pt-use rational-of-integer ()) (#pt-project integer-weierstrass-curve 1 curve))
        (#pt-app (#pt-use rational-of-integer ()) (#pt-project integer-weierstrass-curve 2 curve))
        (#pt-app (#pt-use rational-of-integer ()) (#pt-project integer-weierstrass-curve 3 curve))
        (#pt-app (#pt-use rational-of-integer ()) (#pt-project integer-weierstrass-curve 4 curve))))))
