; Generated by scripts/generate-flt-point-ideal-basis.py; checked native terms.
; Actual column construction and matrix action
; on coefficient pairs. Prove the action is the actual linear
; combination of its two columns, without a linear-map oracle.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias quadratic-add = ./quadratic-algebra-data.lim::quadratic-add)
(#alias quadratic-element = ./quadratic-algebra-data.lim::quadratic-element)
(#alias quadratic-equal = ./quadratic-algebra-data.lim::quadratic-equal)
(#alias quadratic-scale = ./quadratic-algebra-data.lim::quadratic-scale)
(#alias ring-add = ./commutative-ring-data.lim::ring-add)
(#alias ring-add-congruent = ./commutative-ring-data.lim::ring-add-congruent)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-matrix2 = ./ring-matrix2-data.lim::ring-matrix2)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-multiply-commutative = ./commutative-ring-data.lim::ring-multiply-commutative)
(#math-definition point-ideal-matrix-columns ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (first-vector (#pt-app (#pt-use quadratic-element ()) Carrier))
      (second-vector (#pt-app (#pt-use quadratic-element ()) Carrier)))
    (#pt-app (#pt-use ring-matrix2 ()) Carrier))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (first-vector (#pt-app (#pt-use quadratic-element ()) Carrier))
      (second-vector (#pt-app (#pt-use quadratic-element ()) Carrier)))
    (#pt-construct
      ring-matrix2
      ()
      (Carrier)
      entries
      (
        (#pt-project quadratic-element 0 first-vector)
        (#pt-project quadratic-element 0 second-vector)
        (#pt-project quadratic-element 1 first-vector)
        (#pt-project quadratic-element 1 second-vector)))))
(#math-definition point-ideal-matrix-action ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (first-matrix (#pt-app (#pt-use ring-matrix2 ()) Carrier))
      (first-vector (#pt-app (#pt-use quadratic-element ()) Carrier)))
    (#pt-app (#pt-use quadratic-element ()) Carrier))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (first-matrix (#pt-app (#pt-use ring-matrix2 ()) Carrier))
      (first-vector (#pt-app (#pt-use quadratic-element ()) Carrier)))
    (#pt-construct
      quadratic-element
      ()
      (Carrier)
      coordinates
      (
        (#pt-app
          (#pt-use ring-add ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            (#pt-project ring-matrix2 0 first-matrix)
            (#pt-project quadratic-element 0 first-vector))
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            (#pt-project ring-matrix2 1 first-matrix)
            (#pt-project quadratic-element 1 first-vector)))
        (#pt-app
          (#pt-use ring-add ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            (#pt-project ring-matrix2 2 first-matrix)
            (#pt-project quadratic-element 0 first-vector))
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            (#pt-project ring-matrix2 3 first-matrix)
            (#pt-project quadratic-element 1 first-vector)))))))
(#theorem point-ideal-matrix-columns-action
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-vector (#pt-app (#pt-use quadratic-element ()) Carrier))
    (#parameter second-vector (#pt-app (#pt-use quadratic-element ()) Carrier))
    (#parameter first-coordinates (#pt-app (#pt-use quadratic-element ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use quadratic-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use point-ideal-matrix-action ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use point-ideal-matrix-columns ()) Carrier first-vector second-vector)
        first-coordinates)
      (#pt-app
        (#pt-use quadratic-add ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use quadratic-scale ())
          Carrier
          coefficient-ring
          (#pt-project quadratic-element 0 first-coordinates)
          first-vector)
        (#pt-app
          (#pt-use quadratic-scale ())
          Carrier
          coefficient-ring
          (#pt-project quadratic-element 1 first-coordinates)
          second-vector))))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-equal ())
        Carrier
        coefficient-ring
        (#pt-project
          quadratic-element
          0
          (#pt-app
            (#pt-use point-ideal-matrix-action ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use point-ideal-matrix-columns ()) Carrier first-vector second-vector)
            first-coordinates))
        (#pt-project
          quadratic-element
          0
          (#pt-app
            (#pt-use quadratic-add ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use quadratic-scale ())
              Carrier
              coefficient-ring
              (#pt-project quadratic-element 0 first-coordinates)
              first-vector)
            (#pt-app
              (#pt-use quadratic-scale ())
              Carrier
              coefficient-ring
              (#pt-project quadratic-element 1 first-coordinates)
              second-vector))))
      (#pt-app
        (#pt-use ring-equal ())
        Carrier
        coefficient-ring
        (#pt-project
          quadratic-element
          1
          (#pt-app
            (#pt-use point-ideal-matrix-action ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use point-ideal-matrix-columns ()) Carrier first-vector second-vector)
            first-coordinates))
        (#pt-project
          quadratic-element
          1
          (#pt-app
            (#pt-use quadratic-add ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use quadratic-scale ())
              Carrier
              coefficient-ring
              (#pt-project quadratic-element 0 first-coordinates)
              first-vector)
            (#pt-app
              (#pt-use quadratic-scale ())
              Carrier
              coefficient-ring
              (#pt-project quadratic-element 1 first-coordinates)
              second-vector))))
      (#pt-app
        (#pt-use ring-add-congruent ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          (#pt-project quadratic-element 0 first-vector)
          (#pt-project quadratic-element 0 first-coordinates))
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          (#pt-project quadratic-element 0 second-vector)
          (#pt-project quadratic-element 1 first-coordinates))
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          (#pt-project quadratic-element 0 first-coordinates)
          (#pt-project quadratic-element 0 first-vector))
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          (#pt-project quadratic-element 1 first-coordinates)
          (#pt-project quadratic-element 0 second-vector))
        (#pt-app
          (#pt-use ring-multiply-commutative ())
          Carrier
          coefficient-ring
          (#pt-project quadratic-element 0 first-vector)
          (#pt-project quadratic-element 0 first-coordinates))
        (#pt-app
          (#pt-use ring-multiply-commutative ())
          Carrier
          coefficient-ring
          (#pt-project quadratic-element 0 second-vector)
          (#pt-project quadratic-element 1 first-coordinates)))
      (#pt-app
        (#pt-use ring-add-congruent ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          (#pt-project quadratic-element 1 first-vector)
          (#pt-project quadratic-element 0 first-coordinates))
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          (#pt-project quadratic-element 1 second-vector)
          (#pt-project quadratic-element 1 first-coordinates))
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          (#pt-project quadratic-element 0 first-coordinates)
          (#pt-project quadratic-element 1 first-vector))
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          (#pt-project quadratic-element 1 first-coordinates)
          (#pt-project quadratic-element 1 second-vector))
        (#pt-app
          (#pt-use ring-multiply-commutative ())
          Carrier
          coefficient-ring
          (#pt-project quadratic-element 1 first-vector)
          (#pt-project quadratic-element 0 first-coordinates))
        (#pt-app
          (#pt-use ring-multiply-commutative ())
          Carrier
          coefficient-ring
          (#pt-project quadratic-element 1 second-vector)
          (#pt-project quadratic-element 1 first-coordinates))))))
