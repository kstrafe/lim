; Mathematical source: pinned Mathlib EllipticCurve/Affine/Formula.lean and Point.lean.
; Generated by scripts/generate-flt-affine-points.py; checked native proof terms.
; Exact factorization of two Weierstrass equations on one
; vertical line. It is a ring identity, not a field assumption.
(#alias less-than = ./natural-order.lim::less-than)
(#alias finite-residue = ./finite-residue-defs.lim::finite-residue)
(#alias finite-residue-multiply = ./finite-residue-operations.lim::finite-residue-multiply)
(#alias finite-residue-difference = ./finite-residue-differences.lim::finite-residue-difference)
(#alias finite-weierstrass-curve = ./finite-weierstrass-reduction.lim::finite-weierstrass-curve)
(#alias
  finite-weierstrass-polynomial
  =
  ./finite-weierstrass-points.lim::finite-weierstrass-polynomial)
(#alias
  finite-affine-equal-x-factor-polynomial
  =
  ./finite-affine-equal-x-factor-polynomial.lim::finite-affine-equal-x-factor-polynomial)
(#alias finite-weierstrass-neg-y = ./finite-weierstrass-neg-y.lim::finite-weierstrass-neg-y)
(#theorem finite-weierstrass-equal-x-factor
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
    (#parameter first-x (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter first-y (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second-y (#pt-app (#pt-use finite-residue ()) modulus)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-residue-difference ())
          modulus
          positive-modulus
          (#pt-app
            (#pt-use finite-weierstrass-polynomial ())
            modulus
            positive-modulus
            curve
            first-x
            first-y)
          (#pt-app
            (#pt-use finite-weierstrass-polynomial ())
            modulus
            positive-modulus
            curve
            first-x
            second-y)))
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-residue-multiply ())
          modulus
          positive-modulus
          (#pt-app (#pt-use finite-residue-difference ()) modulus positive-modulus first-y second-y)
          (#pt-app
            (#pt-use finite-residue-difference ())
            modulus
            positive-modulus
            first-y
            (#pt-app
              (#pt-use finite-weierstrass-neg-y ())
              modulus
              positive-modulus
              curve
              first-x
              second-y))))))
  (#proof
    (#pt-app
      (#pt-use finite-affine-equal-x-factor-polynomial ())
      modulus
      positive-modulus
      (#pt-project finite-weierstrass-curve 0 curve)
      (#pt-project finite-weierstrass-curve 1 curve)
      (#pt-project finite-weierstrass-curve 2 curve)
      (#pt-project finite-weierstrass-curve 3 curve)
      (#pt-project finite-weierstrass-curve 4 curve)
      first-y
      second-y
      first-x)))
