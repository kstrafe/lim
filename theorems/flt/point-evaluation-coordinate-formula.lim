(#alias quadratic-element = ./quadratic-algebra-data.lim::quadratic-element)
(#alias quadratic-ring-structure = ./quadratic-algebra-ring-structure.lim::quadratic-ring-structure)
(#alias ring-add = ./commutative-ring-data.lim::ring-add)
