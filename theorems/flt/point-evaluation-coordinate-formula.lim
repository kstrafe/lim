; Prove the actual coordinate value is
; eval_x(p)+eval_x(y)*eval_x(q), using the constructed map and
; the proved coefficient evaluation mapping, for every element.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias
