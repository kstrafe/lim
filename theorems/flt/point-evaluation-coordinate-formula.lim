(#alias ring-polynomial-evaluate = ./ring-polynomial-data.lim::ring-polynomial-evaluate)
(#alias ring-polynomial-structure = ./ring-polynomial-structure.lim::ring-polynomial-structure)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#alias ring-transitive = ./commutative-ring-data.lim::ring-transitive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#theorem point-evaluation-coordinate-formula
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter quadratic-linear (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter quadratic-constant (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter root Carrier)
    (#parameter Y-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter curve-equation (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring (#pt-app (#pt-use ring-evaluation ()) (#pt-app (#pt-use finite-list ()) Carrier) (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring) Carrier coefficient-ring (#pt-app (#pt-use polynomial-root-evaluation-morphism ()) Carrier coefficient-ring root) (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring Y-polynomial root) (#pt-app (#pt-use quadratic-division-divisor ()) (#pt-app (#pt-use finite-list ()) Carrier) (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring) quadratic-linear quadratic-constant)) (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
    (#parameter coordinate-element (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-evaluation-map ())
        (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
        (#pt-app
          (#pt-use quadratic-ring-structure ())
          (#pt-app (#pt-use finite-list ()) Carrier)
          (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
          quadratic-linear
          quadratic-constant)
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use point-evaluation-coordinate-morphism ())
          Carrier
          coefficient-ring
          quadratic-linear
          quadratic-constant
          root
          Y-polynomial
          curve-equation)
        coordinate-element)
      (#pt-app
        (#pt-use ring-add ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-evaluate ())
          Carrier
          coefficient-ring
          (#pt-project quadratic-element 0 coordinate-element)
          root)
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring Y-polynomial root)
          (#pt-app
            (#pt-use ring-polynomial-evaluate ())
            Carrier
            coefficient-ring
            (#pt-project quadratic-element 1 coordinate-element)
            root)))))
  (#proof
    (#pt-app
      (#pt-use ring-transitive ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-evaluation-map ())
        (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
        (#pt-app
          (#pt-use quadratic-ring-structure ())
          (#pt-app (#pt-use finite-list ()) Carrier)
          (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
          quadratic-linear
          quadratic-constant)
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use point-evaluation-coordinate-morphism ())
          Carrier
          coefficient-ring
          quadratic-linear
          quadratic-constant
          root
          Y-polynomial
          curve-equation)
        coordinate-element)
      (#pt-app
        (#pt-use ring-add ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-evaluation-map ())
          (#pt-app (#pt-use finite-list ()) Carrier)
          (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-evaluation-morphism ()) Carrier coefficient-ring root)
          (#pt-project quadratic-element 0 coordinate-element))
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring Y-polynomial root)
          (#pt-app
            (#pt-use ring-evaluation-map ())
            (#pt-app (#pt-use finite-list ()) Carrier)
            (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
            Carrier
            coefficient-ring
            (#pt-app (#pt-use polynomial-root-evaluation-morphism ()) Carrier coefficient-ring root)
            (#pt-project quadratic-element 1 coordinate-element))))
      (#pt-app
        (#pt-use ring-add ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-evaluate ())
          Carrier
          coefficient-ring
          (#pt-project quadratic-element 0 coordinate-element)
          root)
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring Y-polynomial root)
          (#pt-app
            (#pt-use ring-polynomial-evaluate ())
            Carrier
            coefficient-ring
            (#pt-project quadratic-element 1 coordinate-element)
            root)))
      (#pt-app
        (#pt-use point-evaluation-quadratic-formula ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        Carrier
        coefficient-ring
        (#pt-app (#pt-use polynomial-root-evaluation-morphism ()) Carrier coefficient-ring root)
        quadratic-linear
        quadratic-constant
        (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring Y-polynomial root)
        curve-equation
        coordinate-element)
      (#pt-app
        (#pt-use ring-add-congruent ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-evaluation-map ())
          (#pt-app (#pt-use finite-list ()) Carrier)
          (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-evaluation-morphism ()) Carrier coefficient-ring root)
          (#pt-project quadratic-element 0 coordinate-element))
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring Y-polynomial root)
          (#pt-app
            (#pt-use ring-evaluation-map ())
            (#pt-app (#pt-use finite-list ()) Carrier)
            (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
            Carrier
            coefficient-ring
            (#pt-app (#pt-use polynomial-root-evaluation-morphism ()) Carrier coefficient-ring root)
            (#pt-project quadratic-element 1 coordinate-element)))
        (#pt-app
          (#pt-use ring-polynomial-evaluate ())
          Carrier
          coefficient-ring
          (#pt-project quadratic-element 0 coordinate-element)
          root)
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring Y-polynomial root)
          (#pt-app
            (#pt-use ring-polynomial-evaluate ())
            Carrier
            coefficient-ring
            (#pt-project quadratic-element 1 coordinate-element)
            root))
        (#pt-app
          (#pt-use polynomial-root-evaluation-mapping ())
          Carrier
          coefficient-ring
          root
          (#pt-project quadratic-element 0 coordinate-element))
        (#pt-app
          (#pt-use ring-multiply-congruent ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring Y-polynomial root)
          (#pt-app
            (#pt-use ring-evaluation-map ())
            (#pt-app (#pt-use finite-list ()) Carrier)
            (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
            Carrier
            coefficient-ring
            (#pt-app (#pt-use polynomial-root-evaluation-morphism ()) Carrier coefficient-ring root)
            (#pt-project quadratic-element 1 coordinate-element))
          (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring Y-polynomial root)
          (#pt-app
            (#pt-use ring-polynomial-evaluate ())
            Carrier
            coefficient-ring
            (#pt-project quadratic-element 1 coordinate-element)
            root)
          (#pt-app
            (#pt-use ring-reflexive ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-evaluate ())
              Carrier
              coefficient-ring
              Y-polynomial
              root))
          (#pt-app
            (#pt-use polynomial-root-evaluation-mapping ())
            Carrier
            coefficient-ring
            root
            (#pt-project quadratic-element 1 coordinate-element)))))))
