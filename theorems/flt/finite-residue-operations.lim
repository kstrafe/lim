(#alias add = ./../fermat_statement.lim::add)
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias less-than = ./natural-order.lim::less-than)
(#alias division-spec = ./natural-division.lim::division-spec)
(#alias natural-division-data = ./natural-division-data.lim::natural-division-data)
(#alias compute-natural-division = ./natural-division-data.lim::compute-natural-division)
(#alias finite-residue = ./finite-residue-defs.lim::finite-residue)
(#alias finite-residue-of-natural = ./finite-residue-defs.lim::finite-residue-of-natural)
(#alias finite-residue-value-in-range = ./finite-residue-defs.lim::finite-residue-value-in-range)
(#alias finite-reduction-certificate = ./finite-residue-defs.lim::finite-reduction-certificate)
(#math-definition finite-residue-add ()
  (#pt-pi
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (first (#pt-app (#pt-use finite-residue ()) modulus))
      (second (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-app (#pt-use finite-residue ()) modulus))
  (#pt-lambda
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (first (#pt-app (#pt-use finite-residue ()) modulus))
      (second (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-app
      (#pt-use finite-residue-of-natural ())
      modulus
      positive-modulus
      (#pt-app
        (#pt-use add ())
        (#pt-project finite-residue 0 first)
        (#pt-project finite-residue 0 second)))))
(#theorem finite-residue-add-in-range
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter first (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second (#pt-app (#pt-use finite-residue ()) modulus)))
  (#statement
    (#pt-app
      (#pt-use less-than ())
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-add ()) modulus positive-modulus first second))
      modulus))
  (#proof
    (#pt-app
      (#pt-use finite-residue-value-in-range ())
      modulus
      (#pt-app (#pt-use finite-residue-add ()) modulus positive-modulus first second))))
(#theorem finite-residue-add-certificate
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter first (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second (#pt-app (#pt-use finite-residue ()) modulus)))
  (#statement
    (#pt-app
      (#pt-use division-spec ())
      (#pt-app
        (#pt-use add ())
        (#pt-project finite-residue 0 first)
        (#pt-project finite-residue 0 second))
      modulus
      (#pt-project
        natural-division-data
        0
        (#pt-app
          (#pt-use compute-natural-division ())
          modulus
          positive-modulus
          (#pt-app
            (#pt-use add ())
            (#pt-project finite-residue 0 first)
            (#pt-project finite-residue 0 second))))
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-add ()) modulus positive-modulus first second))))
  (#proof
    (#pt-app
      (#pt-use finite-reduction-certificate ())
      modulus
      positive-modulus
      (#pt-app
        (#pt-use add ())
        (#pt-project finite-residue 0 first)
        (#pt-project finite-residue 0 second)))))
