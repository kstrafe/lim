; Actual prime-cube factors strictly decrease the quotient norm.
; The inverse witness rules out a unit prime cube; norm multiplicativity
; supplies the strict bound. A quotient associated cube reconstructs an
; associated cube of the original value, retaining its root and unit.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-power = ./eisenstein-defs.lim::eisenstein-power)
(#alias eisenstein-unit = ./eisenstein-defs.lim::eisenstein-unit)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-commutative = ./eisenstein-ring.lim::eisenstein-multiply-commutative)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias exists = ./logic-exists.lim::exists)
(#alias
  eisenstein-divisor-of-unit-is-unit
  =
  ./eisenstein-unit-divisibility.lim::eisenstein-divisor-of-unit-is-unit)
(#alias eisenstein-coprime = ./eisenstein-defs.lim::eisenstein-coprime)
(#alias eisenstein-associated-cube = ./eisenstein-associated-cube.lim::eisenstein-associated-cube)
(#alias eisenstein-natural-norm = ./eisenstein-norm-defs.lim::eisenstein-natural-norm)
(#alias eisenstein-prime-nonunit = ./eisenstein-prime-cube-laws.lim::eisenstein-prime-nonunit)
(#alias
  eisenstein-natural-norm-exists
  =
  ./eisenstein-norm-nonnegative.lim::eisenstein-natural-norm-exists)
(#alias eisenstein-power-divisor = ./eisenstein-power-divisibility.lim::eisenstein-power-divisor)
(#alias
  eisenstein-nonunit-factor-norm-decreases
  =
  ./eisenstein-nonunit-factor-norm.lim::eisenstein-nonunit-factor-norm-decreases)
(#alias eisenstein-prime = ./eisenstein-lambda-prime.lim::eisenstein-prime)
(#alias
  eisenstein-cube-associate-rebuild
  =
  ./eisenstein-cube-factor-algebra.lim::eisenstein-cube-associate-rebuild)
(#alias less-than = ./natural-order.lim::less-than)
(#math-definition eisenstein-coprime-cube-at-norm ()
  (#pt-pi ((natural-norm #pt-nat)) #pt-prop)
  (#pt-lambda
    ((natural-norm #pt-nat))
    (#pt-pi
      (
        (input-first (#pt-use eisenstein ()))
        (input-second (#pt-use eisenstein ()))
        (input-unit (#pt-use eisenstein ()))
        (input-root (#pt-use eisenstein ()))
        (input-norm (#pt-app (#pt-use eisenstein-natural-norm ()) input-first natural-norm))
        (input-coprime (#pt-app (#pt-use eisenstein-coprime ()) input-first input-second))
        (input-unit-proof (#pt-app (#pt-use eisenstein-unit ()) input-unit))
        (input-equation
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app (#pt-use eisenstein-multiply ()) input-first input-second)
            (#pt-app
              (#pt-use eisenstein-multiply ())
              input-unit
              (#pt-app (#pt-use eisenstein-power ()) input-root (#pt-numeral 3))))))
      (#pt-app (#pt-use eisenstein-associated-cube ()) input-first))))
(#theorem eisenstein-prime-cube-quotient-norm-decreases
  (#universes)
  (#parameters
    (#parameter prime (#pt-use eisenstein ()))
    (#parameter number (#pt-use eisenstein ()))
    (#parameter quotient (#pt-use eisenstein ()))
    (#parameter natural-norm #pt-nat)
    (#parameter quotient-norm #pt-nat)
    (#parameter prime-certificate (#pt-app (#pt-use eisenstein-prime ()) prime))
    (#parameter number-norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) number natural-norm))
    (#parameter quotient-norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) quotient quotient-norm))
    (#parameter number-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ())))) #pt-false))
    (#parameter factor-equation (#pt-app (#pt-use eisenstein-equal ()) number (#pt-app (#pt-use eisenstein-multiply ()) (#pt-app (#pt-use eisenstein-power ()) prime (#pt-numeral 3)) quotient))))
  (#statement (#pt-app (#pt-use less-than ()) quotient-norm natural-norm))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-prime-cube-norm #pt-nat))
          (#pt-app
            (#pt-use eisenstein-natural-norm ())
            (#pt-app (#pt-use eisenstein-power ()) prime (#pt-numeral 3))
            candidate-prime-cube-norm)))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-prime-cube-norm #pt-nat))
                (#pt-app
                  (#pt-use eisenstein-natural-norm ())
                  (#pt-app (#pt-use eisenstein-power ()) prime (#pt-numeral 3))
                  candidate-prime-cube-norm)))))
        (#pt-app (#pt-use less-than ()) quotient-norm natural-norm))
      (
        (#pt-lambda
          (
            (prime-cube-norm #pt-nat)
            (prime-cube-norm-certificate
              (#pt-app
                (#pt-use eisenstein-natural-norm ())
                (#pt-app (#pt-use eisenstein-power ()) prime (#pt-numeral 3))
                prime-cube-norm)))
          (#pt-app
            (#pt-use eisenstein-nonunit-factor-norm-decreases ())
            number
            quotient
            (#pt-app (#pt-use eisenstein-power ()) prime (#pt-numeral 3))
            natural-norm
            quotient-norm
            prime-cube-norm
            number-norm-certificate
            quotient-norm-certificate
            prime-cube-norm-certificate
            number-nonzero
            (#pt-app
              (#pt-use eisenstein-transitive ())
              number
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app (#pt-use eisenstein-power ()) prime (#pt-numeral 3))
                quotient)
              (#pt-app
                (#pt-use eisenstein-multiply ())
                quotient
                (#pt-app (#pt-use eisenstein-power ()) prime (#pt-numeral 3)))
              factor-equation
              (#pt-app
                (#pt-use eisenstein-multiply-commutative ())
                (#pt-app (#pt-use eisenstein-power ()) prime (#pt-numeral 3))
                quotient))
            (#pt-lambda
              (
                (prime-cube-unit
                  (#pt-app
                    (#pt-use eisenstein-unit ())
                    (#pt-app (#pt-use eisenstein-power ()) prime (#pt-numeral 3)))))
              (#pt-app
                (#pt-app (#pt-use eisenstein-prime-nonunit ()) prime prime-certificate)
                (#pt-app
                  (#pt-use eisenstein-divisor-of-unit-is-unit ())
                  prime
                  (#pt-app (#pt-use eisenstein-power ()) prime (#pt-numeral 3))
                  prime-cube-unit
                  (#pt-app (#pt-use eisenstein-power-divisor ()) prime (#pt-numeral 2))))))))
      (#pt-app
        (#pt-use eisenstein-natural-norm-exists ())
        (#pt-app (#pt-use eisenstein-power ()) prime (#pt-numeral 3))))))
(#theorem eisenstein-associated-cube-of-cube-factor
  (#universes)
  (#parameters
    (#parameter prime (#pt-use eisenstein ()))
    (#parameter number (#pt-use eisenstein ()))
    (#parameter quotient (#pt-use eisenstein ()))
    (#parameter factor-equation (#pt-app (#pt-use eisenstein-equal ()) number (#pt-app (#pt-use eisenstein-multiply ()) (#pt-app (#pt-use eisenstein-power ()) prime (#pt-numeral 3)) quotient)))
    (#parameter quotient-associated (#pt-app (#pt-use eisenstein-associated-cube ()) quotient)))
  (#statement (#pt-app (#pt-use eisenstein-associated-cube ()) number))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-cube-root (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use exists (0))
            (#pt-use eisenstein ())
            (#pt-lambda
              ((candidate-unit (#pt-use eisenstein ())))
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use eisenstein-unit ()) candidate-unit)
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  quotient
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    candidate-unit
                    (#pt-app (#pt-use eisenstein-power ()) candidate-cube-root (#pt-numeral 3)))))))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-cube-root (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use exists (0))
                  (#pt-use eisenstein ())
                  (#pt-lambda
                    ((candidate-unit (#pt-use eisenstein ())))
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app (#pt-use eisenstein-unit ()) candidate-unit)
                      (#pt-app
                        (#pt-use eisenstein-equal ())
                        quotient
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          candidate-unit
                          (#pt-app
                            (#pt-use eisenstein-power ())
                            candidate-cube-root
                            (#pt-numeral 3)))))))))))
        (#pt-app (#pt-use eisenstein-associated-cube ()) number))
      (
        (#pt-lambda
          (
            (cube-root (#pt-use eisenstein ()))
            (unit-existence
              (#pt-app
                (#pt-use exists (0))
                (#pt-use eisenstein ())
                (#pt-lambda
                  ((candidate-unit (#pt-use eisenstein ())))
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app (#pt-use eisenstein-unit ()) candidate-unit)
                    (#pt-app
                      (#pt-use eisenstein-equal ())
                      quotient
                      (#pt-app
                        (#pt-use eisenstein-multiply ())
                        candidate-unit
                        (#pt-app (#pt-use eisenstein-power ()) cube-root (#pt-numeral 3)))))))))
          (#pt-induct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-unit (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app (#pt-use eisenstein-unit ()) candidate-unit)
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    quotient
                    (#pt-app
                      (#pt-use eisenstein-multiply ())
                      candidate-unit
                      (#pt-app (#pt-use eisenstein-power ()) cube-root (#pt-numeral 3)))))))
            (#pt-lambda
              (
                (eisenstein-certificate
                  (#pt-app
                    (#pt-use exists (0))
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-unit (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-app (#pt-use eisenstein-unit ()) candidate-unit)
                        (#pt-app
                          (#pt-use eisenstein-equal ())
                          quotient
                          (#pt-app
                            (#pt-use eisenstein-multiply ())
                            candidate-unit
                            (#pt-app (#pt-use eisenstein-power ()) cube-root (#pt-numeral 3)))))))))
              (#pt-app (#pt-use eisenstein-associated-cube ()) number))
            (
              (#pt-lambda
                (
                  (cube-unit (#pt-use eisenstein ()))
                  (cube-certificate
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app (#pt-use eisenstein-unit ()) cube-unit)
                      (#pt-app
                        (#pt-use eisenstein-equal ())
                        quotient
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          cube-unit
                          (#pt-app (#pt-use eisenstein-power ()) cube-root (#pt-numeral 3)))))))
                (#pt-construct
                  exists
                  (0)
                  (
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-cube-root (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use exists (0))
                        (#pt-use eisenstein ())
                        (#pt-lambda
                          ((candidate-unit (#pt-use eisenstein ())))
                          (#pt-app
                            (#pt-use conjunction ())
                            (#pt-app (#pt-use eisenstein-unit ()) candidate-unit)
                            (#pt-app
                              (#pt-use eisenstein-equal ())
                              number
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                candidate-unit
                                (#pt-app
                                  (#pt-use eisenstein-power ())
                                  candidate-cube-root
                                  (#pt-numeral 3)))))))))
                  introduce
                  (
                    (#pt-app (#pt-use eisenstein-multiply ()) prime cube-root)
                    (#pt-construct
                      exists
                      (0)
                      (
                        (#pt-use eisenstein ())
                        (#pt-lambda
                          ((candidate-unit (#pt-use eisenstein ())))
                          (#pt-app
                            (#pt-use conjunction ())
                            (#pt-app (#pt-use eisenstein-unit ()) candidate-unit)
                            (#pt-app
                              (#pt-use eisenstein-equal ())
                              number
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                candidate-unit
                                (#pt-app
                                  (#pt-use eisenstein-power ())
                                  (#pt-app (#pt-use eisenstein-multiply ()) prime cube-root)
                                  (#pt-numeral 3)))))))
                      introduce
                      (cube-unit
                        (#pt-app
                          (#pt-use conjunction-introduce ())
                          (#pt-app (#pt-use eisenstein-unit ()) cube-unit)
                          (#pt-app
                            (#pt-use eisenstein-equal ())
                            number
                            (#pt-app
                              (#pt-use eisenstein-multiply ())
                              cube-unit
                              (#pt-app
                                (#pt-use eisenstein-power ())
                                (#pt-app (#pt-use eisenstein-multiply ()) prime cube-root)
                                (#pt-numeral 3))))
                          (#pt-app
                            (#pt-use conjunction-left ())
                            (#pt-app (#pt-use eisenstein-unit ()) cube-unit)
                            (#pt-app
                              (#pt-use eisenstein-equal ())
                              quotient
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                cube-unit
                                (#pt-app (#pt-use eisenstein-power ()) cube-root (#pt-numeral 3))))
                            cube-certificate)
                          (#pt-app
                            (#pt-use eisenstein-cube-associate-rebuild ())
                            prime
                            cube-unit
                            cube-root
                            number
                            quotient
                            factor-equation
                            (#pt-app
                              (#pt-use conjunction-right ())
                              (#pt-app (#pt-use eisenstein-unit ()) cube-unit)
                              (#pt-app
                                (#pt-use eisenstein-equal ())
                                quotient
                                (#pt-app
                                  (#pt-use eisenstein-multiply ())
                                  cube-unit
                                  (#pt-app (#pt-use eisenstein-power ()) cube-root (#pt-numeral 3))))
                              cube-certificate)))))))))
            unit-existence)))
      quotient-associated)))
