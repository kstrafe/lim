; Authors: Kevin Buzzard, David Kurniadi Angdinata
; Native Lim adaptation of the pinned Mathlib coefficient/invariant definitions.
; Rational specialization of pinned Mathlib WeierstrassCurve:64-119.
; Store the actual five coefficients and compute the standard b2,b4,
; b6,b8,c4,c6 and discriminant polynomials using the proved rational
; arithmetic. No nonsingularity or ellipticity assertion is introduced.
(#alias add = ./../fermat_statement.lim::add)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias rational = ./rational-defs.lim::rational)
(#alias rational-of-integer = ./rational-defs.lim::rational-of-integer)
(#alias rational-add = ./rational-defs.lim::rational-add)
(#alias rational-multiply = ./rational-defs.lim::rational-multiply)
(#alias rational-negate = ./rational-defs.lim::rational-negate)
(#alias rational-power = ./rational-defs.lim::rational-power)
(#math-inductive rational-weierstrass-curve ()
  ()
  (#pt-type 0)
  (
    (coefficients
      (
        (a1 (#pt-use rational ()))
        (a2 (#pt-use rational ()))
        (a3 (#pt-use rational ()))
        (a4 (#pt-use rational ()))
        (a6 (#pt-use rational ()))))))
(#math-definition rational-weierstrass-b2 ()
  (#pt-pi ((curve (#pt-use rational-weierstrass-curve ()))) (#pt-use rational ()))
  (#pt-lambda
    ((curve (#pt-use rational-weierstrass-curve ())))
    (#pt-app
      (#pt-use rational-add ())
      (#pt-app
        (#pt-use rational-power ())
        (#pt-project rational-weierstrass-curve 0 curve)
        (#pt-succ (#pt-succ #pt-zero)))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
        (#pt-project rational-weierstrass-curve 1 curve)))))
(#math-definition rational-weierstrass-b4 ()
  (#pt-pi ((curve (#pt-use rational-weierstrass-curve ()))) (#pt-use rational ()))
  (#pt-lambda
    ((curve (#pt-use rational-weierstrass-curve ())))
    (#pt-app
      (#pt-use rational-add ())
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
        (#pt-project rational-weierstrass-curve 3 curve))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-project rational-weierstrass-curve 0 curve)
        (#pt-project rational-weierstrass-curve 2 curve)))))
(#math-definition rational-weierstrass-b6 ()
  (#pt-pi ((curve (#pt-use rational-weierstrass-curve ()))) (#pt-use rational ()))
  (#pt-lambda
    ((curve (#pt-use rational-weierstrass-curve ())))
    (#pt-app
      (#pt-use rational-add ())
      (#pt-app
        (#pt-use rational-power ())
        (#pt-project rational-weierstrass-curve 2 curve)
        (#pt-succ (#pt-succ #pt-zero)))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
        (#pt-project rational-weierstrass-curve 4 curve)))))
(#math-definition rational-weierstrass-b8 ()
  (#pt-pi ((curve (#pt-use rational-weierstrass-curve ()))) (#pt-use rational ()))
  (#pt-lambda
    ((curve (#pt-use rational-weierstrass-curve ())))
    (#pt-app
      (#pt-use rational-add ())
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-add ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-project rational-weierstrass-curve 0 curve)
                (#pt-succ (#pt-succ #pt-zero)))
              (#pt-project rational-weierstrass-curve 4 curve))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-of-integer ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
                (#pt-project rational-weierstrass-curve 1 curve))
              (#pt-project rational-weierstrass-curve 4 curve)))
          (#pt-app
            (#pt-use rational-negate ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-project rational-weierstrass-curve 0 curve)
                (#pt-project rational-weierstrass-curve 2 curve))
              (#pt-project rational-weierstrass-curve 3 curve))))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-project rational-weierstrass-curve 1 curve)
          (#pt-app
            (#pt-use rational-power ())
            (#pt-project rational-weierstrass-curve 2 curve)
            (#pt-succ (#pt-succ #pt-zero)))))
      (#pt-app
        (#pt-use rational-negate ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project rational-weierstrass-curve 3 curve)
          (#pt-succ (#pt-succ #pt-zero)))))))
(#math-definition rational-weierstrass-c4 ()
  (#pt-pi ((curve (#pt-use rational-weierstrass-curve ()))) (#pt-use rational ()))
  (#pt-lambda
    ((curve (#pt-use rational-weierstrass-curve ())))
    (#pt-app
      (#pt-use rational-add ())
      (#pt-app
        (#pt-use rational-power ())
        (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)
        (#pt-succ (#pt-succ #pt-zero)))
      (#pt-app
        (#pt-use rational-negate ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 24)))
          (#pt-app (#pt-use rational-weierstrass-b4 ()) curve))))))
(#math-definition rational-weierstrass-c6 ()
  (#pt-pi ((curve (#pt-use rational-weierstrass-curve ()))) (#pt-use rational ()))
  (#pt-lambda
    ((curve (#pt-use rational-weierstrass-curve ())))
    (#pt-app
      (#pt-use rational-add ())
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app
          (#pt-use rational-negate ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)
            (#pt-numeral 3)))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 36)))
            (#pt-app (#pt-use rational-weierstrass-b2 ()) curve))
          (#pt-app (#pt-use rational-weierstrass-b4 ()) curve)))
      (#pt-app
        (#pt-use rational-negate ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app (#pt-use add ()) (#pt-numeral 128) (#pt-numeral 88))))
          (#pt-app (#pt-use rational-weierstrass-b6 ()) curve))))))
(#math-definition rational-weierstrass-discriminant ()
  (#pt-pi ((curve (#pt-use rational-weierstrass-curve ()))) (#pt-use rational ()))
  (#pt-lambda
    ((curve (#pt-use rational-weierstrass-curve ())))
    (#pt-app
      (#pt-use rational-add ())
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-negate ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)
                (#pt-succ (#pt-succ #pt-zero))))
            (#pt-app (#pt-use rational-weierstrass-b8 ()) curve))
          (#pt-app
            (#pt-use rational-negate ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 8)))
              (#pt-app
                (#pt-use rational-power ())
                (#pt-app (#pt-use rational-weierstrass-b4 ()) curve)
                (#pt-numeral 3)))))
        (#pt-app
          (#pt-use rational-negate ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 27)))
            (#pt-app
              (#pt-use rational-power ())
              (#pt-app (#pt-use rational-weierstrass-b6 ()) curve)
              (#pt-succ (#pt-succ #pt-zero))))))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 9)))
            (#pt-app (#pt-use rational-weierstrass-b2 ()) curve))
          (#pt-app (#pt-use rational-weierstrass-b4 ()) curve))
        (#pt-app (#pt-use rational-weierstrass-b6 ()) curve)))))
