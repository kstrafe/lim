; Checked signed linear identities for the lambda-divisibility bridge.
; Small integer coefficients are expanded using the proved ring operations.
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-zero = ./integer-defs.lim::integer-zero)
(#alias integer-one = ./integer-defs.lim::integer-one)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-reflexive = ./integer-equality.lim::integer-reflexive)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias integer-negate-congruent = ./integer-equality.lim::integer-negate-congruent)
(#alias integer-add-congruent = ./integer-equality.lim::integer-add-congruent)
(#alias integer-add-inverse = ./integer-addition.lim::integer-add-inverse)
(#alias integer-add-commutative = ./integer-addition.lim::integer-add-commutative)
(#alias integer-add-cancel-left = ./integer-addition.lim::integer-add-cancel-left)
(#alias integer-negate-involution = ./integer-addition.lim::integer-negate-involution)
(#alias integer-negate-add = ./integer-addition.lim::integer-negate-add)
(#alias integer-multiply-negative = ./integer-multiplication.lim::integer-multiply-negative)
(#alias integer-multiply-congruent-first = ./integer-equality.lim::integer-multiply-congruent-first)
(#alias integer-multiply-distributive = ./integer-multiplication.lim::integer-multiply-distributive)
(#alias integer-one-multiply = ./integer-bezout-algebra.lim::integer-one-multiply)
(#theorem integer-minus-one-multiply
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))
        number)
      (#pt-app (#pt-use integer-negate ()) number)))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))
        number)
      (#pt-app
        (#pt-use integer-negate ())
        (#pt-app (#pt-use integer-multiply ()) (#pt-use integer-one ()) number))
      (#pt-app (#pt-use integer-negate ()) number)
      (#pt-app (#pt-use integer-multiply-negative ()) (#pt-use integer-one ()) number)
      (#pt-app
        (#pt-use integer-negate-congruent ())
        (#pt-app (#pt-use integer-multiply ()) (#pt-use integer-one ()) number)
        number
        (#pt-app (#pt-use integer-one-multiply ()) number)))))
(#theorem integer-two-multiply-sum
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))
        number)
      (#pt-app (#pt-use integer-add ()) number number)))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))
        number)
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app (#pt-use integer-add ()) (#pt-use integer-one ()) (#pt-use integer-one ()))
        number)
      (#pt-app (#pt-use integer-add ()) number number)
      (#pt-app
        (#pt-use integer-multiply-congruent-first ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))
        (#pt-app (#pt-use integer-add ()) (#pt-use integer-one ()) (#pt-use integer-one ()))
        number
        (#pt-app
          (#pt-use integer-reflexive ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app (#pt-use integer-add ()) (#pt-use integer-one ()) (#pt-use integer-one ()))
          number)
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app (#pt-use integer-multiply ()) (#pt-use integer-one ()) number)
          (#pt-app (#pt-use integer-multiply ()) (#pt-use integer-one ()) number))
        (#pt-app (#pt-use integer-add ()) number number)
        (#pt-app
          (#pt-use integer-multiply-distributive ())
          (#pt-use integer-one ())
          (#pt-use integer-one ())
          number)
        (#pt-app
          (#pt-use integer-add-congruent ())
          (#pt-app (#pt-use integer-multiply ()) (#pt-use integer-one ()) number)
          (#pt-app (#pt-use integer-multiply ()) (#pt-use integer-one ()) number)
          number
          number
          (#pt-app (#pt-use integer-one-multiply ()) number)
          (#pt-app (#pt-use integer-one-multiply ()) number))))))
(#theorem integer-three-multiply-sum
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
        number)
      (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-add ()) number number) number)))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
        number)
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))
          (#pt-use integer-one ()))
        number)
      (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-add ()) number number) number)
      (#pt-app
        (#pt-use integer-multiply-congruent-first ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))
          (#pt-use integer-one ()))
        number
        (#pt-app
          (#pt-use integer-reflexive ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))
            (#pt-use integer-one ()))
          number)
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))
            number)
          (#pt-app (#pt-use integer-multiply ()) (#pt-use integer-one ()) number))
        (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-add ()) number number) number)
        (#pt-app
          (#pt-use integer-multiply-distributive ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))
          (#pt-use integer-one ())
          number)
        (#pt-app
          (#pt-use integer-add-congruent ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))
            number)
          (#pt-app (#pt-use integer-multiply ()) (#pt-use integer-one ()) number)
          (#pt-app (#pt-use integer-add ()) number number)
          number
          (#pt-app (#pt-use integer-two-multiply-sum ()) number)
          (#pt-app (#pt-use integer-one-multiply ()) number))))))
(#theorem integer-zero-sum-negative
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter sum-zero (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) first second) (#pt-use integer-zero ()))))
  (#statement
    (#pt-app (#pt-use integer-equal ()) first (#pt-app (#pt-use integer-negate ()) second)))
  (#proof
    (#pt-app
      (#pt-use integer-add-cancel-left ())
      second
      first
      (#pt-app (#pt-use integer-negate ()) second)
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app (#pt-use integer-add ()) second first)
        (#pt-app (#pt-use integer-add ()) first second)
        (#pt-app (#pt-use integer-add ()) second (#pt-app (#pt-use integer-negate ()) second))
        (#pt-app (#pt-use integer-add-commutative ()) second first)
        (#pt-app
          (#pt-use integer-transitive ())
          (#pt-app (#pt-use integer-add ()) first second)
          (#pt-use integer-zero ())
          (#pt-app (#pt-use integer-add ()) second (#pt-app (#pt-use integer-negate ()) second))
          sum-zero
          (#pt-app
            (#pt-use integer-symmetric ())
            (#pt-app (#pt-use integer-add ()) second (#pt-app (#pt-use integer-negate ()) second))
            (#pt-use integer-zero ())
            (#pt-app (#pt-use integer-add-inverse ()) second)))))))
(#theorem integer-zero-difference
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter difference-zero (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) first (#pt-app (#pt-use integer-negate ()) second)) (#pt-use integer-zero ()))))
  (#statement (#pt-app (#pt-use integer-equal ()) first second))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      first
      (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-negate ()) second))
      second
      (#pt-app
        (#pt-use integer-zero-sum-negative ())
        first
        (#pt-app (#pt-use integer-negate ()) second)
        difference-zero)
      (#pt-app (#pt-use integer-negate-involution ()) second))))
(#theorem integer-negate-three-sum
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app
        (#pt-use integer-negate ())
        (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-add ()) number number) number))
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
        (#pt-app (#pt-use integer-negate ()) number))))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app
        (#pt-use integer-negate ())
        (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-add ()) number number) number))
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-add ()) number number))
        (#pt-app (#pt-use integer-negate ()) number))
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
        (#pt-app (#pt-use integer-negate ()) number))
      (#pt-app
        (#pt-use integer-negate-add ())
        (#pt-app (#pt-use integer-add ()) number number)
        number)
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-add ()) number number))
          (#pt-app (#pt-use integer-negate ()) number))
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app (#pt-use integer-negate ()) number)
            (#pt-app (#pt-use integer-negate ()) number))
          (#pt-app (#pt-use integer-negate ()) number))
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
          (#pt-app (#pt-use integer-negate ()) number))
        (#pt-app
          (#pt-use integer-add-congruent ())
          (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-add ()) number number))
          (#pt-app (#pt-use integer-negate ()) number)
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app (#pt-use integer-negate ()) number)
            (#pt-app (#pt-use integer-negate ()) number))
          (#pt-app (#pt-use integer-negate ()) number)
          (#pt-app (#pt-use integer-negate-add ()) number number)
          (#pt-app (#pt-use integer-reflexive ()) (#pt-app (#pt-use integer-negate ()) number)))
        (#pt-app
          (#pt-use integer-symmetric ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
            (#pt-app (#pt-use integer-negate ()) number))
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app (#pt-use integer-negate ()) number)
              (#pt-app (#pt-use integer-negate ()) number))
            (#pt-app (#pt-use integer-negate ()) number))
          (#pt-app
            (#pt-use integer-three-multiply-sum ())
            (#pt-app (#pt-use integer-negate ()) number)))))))
