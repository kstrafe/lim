                            candidate-remainder)))))
                  introduce
                  (quotient
                    (#pt-construct
                      exists
                      (0)
                      (#pt-nat
                        (#pt-lambda
                          ((candidate-remainder #pt-nat))
                          (#pt-app
                            (#pt-use integer-division-spec ())
                            other-dividend
                            divisor
                            quotient
