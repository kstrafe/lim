                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((candidate-remainder #pt-nat))
                  (#pt-app
                    (#pt-use integer-division-spec ())
                    dividend
                    divisor
                    quotient
                    candidate-remainder)))))
          (#pt-induct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-remainder #pt-nat))
