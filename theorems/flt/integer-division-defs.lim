          (#pt-app (#pt-use integer-of-natural ()) remainder))
        (#pt-app (#pt-use integer-symmetric ()) dividend other-dividend equivalent-dividends)
        (#pt-app
          (#pt-use conjunction-left ())
          (#pt-app
            (#pt-use integer-equal ())
            dividend
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-multiply ())
                quotient
                (#pt-app (#pt-use integer-of-natural ()) divisor))
              (#pt-app (#pt-use integer-of-natural ()) remainder)))
          (#pt-app (#pt-use less-than ()) remainder divisor)
          division-certificate))
      (#pt-app
        (#pt-use conjunction-right ())
        (#pt-app
          (#pt-use integer-equal ())
          dividend
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app
              (#pt-use integer-multiply ())
              quotient
              (#pt-app (#pt-use integer-of-natural ()) divisor))
            (#pt-app (#pt-use integer-of-natural ()) remainder)))
