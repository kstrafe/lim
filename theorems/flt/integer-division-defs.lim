    (#parameter division-certificate (#pt-app (#pt-use integer-division-spec ()) dividend divisor quotient remainder)))
  (#statement
    (#pt-app (#pt-use integer-division-spec ()) other-dividend divisor quotient remainder))
  (#proof
    (#pt-app
