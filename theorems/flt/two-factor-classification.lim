; Positive-Nat factor classification by strong induction and peeling factors two.
; This is a source-level prerequisite for Nat.eq_two_pow_or_exists_odd_prime_and_dvd.
; Here the prime branch records p != 2; oddness is proved separately.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias power = ../fermat_statement.lim::power)
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#alias strong-induction = ./natural-order.lim::strong-induction)
(#alias successor-below-double = ./natural-small-cases.lim::successor-below-double)
(#alias zero-one-or-large = ./natural-small-cases.lim::zero-one-or-large)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias divides-transitive = ./natural-divisibility.lim::divides-transitive)
(#alias multiply-commutative = ./natural-multiplication-commutative.lim::multiply-commutative)
(#alias prime = ./natural-prime.lim::prime)
(#alias exists-prime-divisor = ./natural-prime.lim::exists-prime-divisor)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-left = ./logical-connectives.lim::disjunction-left)
(#alias disjunction-right = ./logical-connectives.lim::disjunction-right)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias decision = ./logical-decision.lim::decision)
(#alias decide-equality = ./natural-decision.lim::decide-equality)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias congruence = ./equality.lim::congruence)
(#alias substitution = ./equality.lim::substitution)
(#alias successor-not-zero = ./natural-nonzero.lim::successor-not-zero)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#math-definition power-of-two ()
  (#pt-pi ((number #pt-nat)) #pt-prop)
  (#pt-lambda
    ((number #pt-nat))
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((power-exponent #pt-nat))
        (#pt-eq
          #pt-nat
          number
          (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) power-exponent))))))
(#math-definition non-two-prime-divisor ()
  (#pt-pi ((number #pt-nat)) #pt-prop)
  (#pt-lambda
    ((number #pt-nat))
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((prime-candidate #pt-nat))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app (#pt-use prime ()) prime-candidate)
          (#pt-app
            (#pt-use conjunction ())
            (#pt-pi
              ((denied-proof (#pt-eq #pt-nat prime-candidate (#pt-succ (#pt-succ #pt-zero)))))
              #pt-false)
            (#pt-app (#pt-use divides ()) prime-candidate number)))))))
(#math-definition two-power-or-prime ()
  (#pt-pi ((number #pt-nat)) #pt-prop)
  (#pt-lambda
    ((number #pt-nat))
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app (#pt-use power-of-two ()) number)
      (#pt-app (#pt-use non-two-prime-divisor ()) number))))
(#theorem factor-two-divides-multiple
  (#universes)
  (#parameters
    (#parameter factor #pt-nat)
    (#parameter multiple #pt-nat)
    (#parameter factor-equation (#pt-eq #pt-nat multiple (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) factor))))
  (#statement (#pt-app (#pt-use divides ()) factor multiple))
  (#proof
    (#pt-construct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-factor #pt-nat))
          (#pt-eq #pt-nat multiple (#pt-app (#pt-use multiply ()) factor candidate-factor))))
      introduce
      (
        (#pt-succ (#pt-succ #pt-zero))
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          multiple
          (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) factor)
          (#pt-app (#pt-use multiply ()) factor (#pt-succ (#pt-succ #pt-zero)))
          factor-equation
          (#pt-app (#pt-use multiply-commutative ()) (#pt-succ (#pt-succ #pt-zero)) factor))))))
(#theorem two-power-or-prime-double
  (#universes)
  (#parameters
    (#parameter factor #pt-nat)
    (#parameter multiple #pt-nat)
    (#parameter factor-equation (#pt-eq #pt-nat multiple (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) factor)))
    (#parameter factor-classification (#pt-app (#pt-use two-power-or-prime ()) factor)))
  (#statement (#pt-app (#pt-use two-power-or-prime ()) multiple))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use power-of-two ()) factor)
      (#pt-app (#pt-use non-two-prime-divisor ()) factor)
      (#pt-app (#pt-use two-power-or-prime ()) multiple)
      (#pt-lambda
        ((power-certificate (#pt-app (#pt-use power-of-two ()) factor)))
        (#pt-induct
          exists
          (0)
          (#pt-nat
            (#pt-lambda
              ((power-exponent #pt-nat))
              (#pt-eq
                #pt-nat
                factor
                (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) power-exponent))))
          (#pt-lambda
            (
              (certificate
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((power-exponent #pt-nat))
                    (#pt-eq
                      #pt-nat
                      factor
                      (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) power-exponent))))))
            (#pt-app (#pt-use two-power-or-prime ()) multiple))
          (
            (#pt-lambda
              (
                (exponent #pt-nat)
                (power-equation
                  (#pt-eq
                    #pt-nat
                    factor
                    (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) exponent))))
              (#pt-app
                (#pt-use disjunction-left ())
                (#pt-app (#pt-use power-of-two ()) multiple)
                (#pt-app (#pt-use non-two-prime-divisor ()) multiple)
                (#pt-construct
                  exists
                  (0)
                  (#pt-nat
                    (#pt-lambda
                      ((power-exponent #pt-nat))
                      (#pt-eq
                        #pt-nat
                        multiple
                        (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) power-exponent))))
                  introduce
                  (
                    (#pt-succ exponent)
                    (#pt-app
                      (#pt-use transitivity (0))
                      #pt-nat
                      multiple
                      (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) factor)
                      (#pt-app
                        (#pt-use power ())
                        (#pt-succ (#pt-succ #pt-zero))
                        (#pt-succ exponent))
                      factor-equation
                      (#pt-app
                        (#pt-use congruence (0 0))
                        #pt-nat
                        #pt-nat
                        (#pt-lambda
                          ((product-factor #pt-nat))
                          (#pt-app
                            (#pt-use multiply ())
                            (#pt-succ (#pt-succ #pt-zero))
                            product-factor))
                        factor
                        (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) exponent)
                        power-equation)))))))
          power-certificate))
      (#pt-lambda
        ((divisor-certificate (#pt-app (#pt-use non-two-prime-divisor ()) factor)))
        (#pt-induct
          exists
          (0)
          (#pt-nat
            (#pt-lambda
              ((prime-candidate #pt-nat))
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use prime ()) prime-candidate)
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-pi
                    ((denied-proof (#pt-eq #pt-nat prime-candidate (#pt-succ (#pt-succ #pt-zero)))))
                    #pt-false)
                  (#pt-app (#pt-use divides ()) prime-candidate factor)))))
          (#pt-lambda
            (
              (certificate
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((prime-candidate #pt-nat))
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app (#pt-use prime ()) prime-candidate)
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-pi
                          (
                            (denied-proof
                              (#pt-eq #pt-nat prime-candidate (#pt-succ (#pt-succ #pt-zero)))))
                          #pt-false)
                        (#pt-app (#pt-use divides ()) prime-candidate factor)))))))
            (#pt-app (#pt-use two-power-or-prime ()) multiple))
          (
            (#pt-lambda
              (
                (prime-factor #pt-nat)
                (prime-certificate
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app (#pt-use prime ()) prime-factor)
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-pi
                        (
                          (denied-proof
                            (#pt-eq #pt-nat prime-factor (#pt-succ (#pt-succ #pt-zero)))))
                        #pt-false)
                      (#pt-app (#pt-use divides ()) prime-factor factor)))))
              (#pt-app
                (#pt-use disjunction-right ())
                (#pt-app (#pt-use power-of-two ()) multiple)
                (#pt-app (#pt-use non-two-prime-divisor ()) multiple)
                (#pt-construct
                  exists
                  (0)
                  (#pt-nat
                    (#pt-lambda
                      ((prime-candidate #pt-nat))
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-app (#pt-use prime ()) prime-candidate)
                        (#pt-app
                          (#pt-use conjunction ())
                          (#pt-pi
                            (
                              (denied-proof
                                (#pt-eq #pt-nat prime-candidate (#pt-succ (#pt-succ #pt-zero)))))
                            #pt-false)
                          (#pt-app (#pt-use divides ()) prime-candidate multiple)))))
                  introduce
                  (prime-factor
                    (#pt-app
                      (#pt-use conjunction-introduce ())
                      (#pt-app (#pt-use prime ()) prime-factor)
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-pi
                          (
                            (denied-proof
                              (#pt-eq #pt-nat prime-factor (#pt-succ (#pt-succ #pt-zero)))))
                          #pt-false)
                        (#pt-app (#pt-use divides ()) prime-factor multiple))
                      (#pt-app
                        (#pt-use conjunction-left ())
                        (#pt-app (#pt-use prime ()) prime-factor)
                        (#pt-app
                          (#pt-use conjunction ())
                          (#pt-pi
                            (
                              (denied-proof
                                (#pt-eq #pt-nat prime-factor (#pt-succ (#pt-succ #pt-zero)))))
                            #pt-false)
                          (#pt-app (#pt-use divides ()) prime-factor factor))
                        prime-certificate)
                      (#pt-app
                        (#pt-use conjunction-introduce ())
                        (#pt-pi
                          (
                            (denied-proof
                              (#pt-eq #pt-nat prime-factor (#pt-succ (#pt-succ #pt-zero)))))
                          #pt-false)
                        (#pt-app (#pt-use divides ()) prime-factor multiple)
                        (#pt-app
                          (#pt-use conjunction-left ())
                          (#pt-pi
                            (
                              (denied-proof
                                (#pt-eq #pt-nat prime-factor (#pt-succ (#pt-succ #pt-zero)))))
                            #pt-false)
                          (#pt-app (#pt-use divides ()) prime-factor factor)
                          (#pt-app
                            (#pt-use conjunction-right ())
                            (#pt-app (#pt-use prime ()) prime-factor)
                            (#pt-app
                              (#pt-use conjunction ())
                              (#pt-pi
                                (
                                  (denied-proof
                                    (#pt-eq #pt-nat prime-factor (#pt-succ (#pt-succ #pt-zero)))))
                                #pt-false)
                              (#pt-app (#pt-use divides ()) prime-factor factor))
                            prime-certificate))
                        (#pt-app
                          (#pt-use divides-transitive ())
                          prime-factor
                          factor
                          multiple
                          (#pt-app
                            (#pt-use conjunction-right ())
                            (#pt-pi
                              (
                                (denied-proof
                                  (#pt-eq #pt-nat prime-factor (#pt-succ (#pt-succ #pt-zero)))))
                              #pt-false)
                            (#pt-app (#pt-use divides ()) prime-factor factor)
                            (#pt-app
                              (#pt-use conjunction-right ())
                              (#pt-app (#pt-use prime ()) prime-factor)
                              (#pt-app
                                (#pt-use conjunction ())
                                (#pt-pi
                                  (
                                    (denied-proof
                                      (#pt-eq #pt-nat prime-factor (#pt-succ (#pt-succ #pt-zero)))))
                                  #pt-false)
                                (#pt-app (#pt-use divides ()) prime-factor factor))
                              prime-certificate))
                          (#pt-app
                            (#pt-use factor-two-divides-multiple ())
                            factor
                            multiple
                            factor-equation)))))))))
          divisor-certificate))
      factor-classification)))
(#theorem classify-two-multiple
  (#universes)
  (#parameters
    (#parameter multiple #pt-nat)
    (#parameter smaller-cases (#pt-pi ((earlier #pt-nat) (earlier-proof (#pt-app (#pt-use less-than ()) earlier multiple))) (#pt-pi ((nonzero-proof (#pt-pi ((denied-proof (#pt-eq #pt-nat earlier #pt-zero))) #pt-false))) (#pt-app (#pt-use two-power-or-prime ()) earlier))))
    (#parameter multiple-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat multiple #pt-zero))) #pt-false))
    (#parameter two-divides (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) multiple)))
  (#statement (#pt-app (#pt-use two-power-or-prime ()) multiple))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-factor #pt-nat))
          (#pt-eq
            #pt-nat
            multiple
            (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) candidate-factor))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-factor #pt-nat))
                (#pt-eq
                  #pt-nat
                  multiple
                  (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) candidate-factor))))))
        (#pt-app (#pt-use two-power-or-prime ()) multiple))
      (
        (#pt-lambda
          (
            (factor-witness #pt-nat)
            (witness-equation
              (#pt-eq
                #pt-nat
                multiple
                (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) factor-witness))))
          (#pt-app
            (#pt-nat-induct
              (#pt-lambda
                ((index #pt-nat))
                (#pt-pi
                  (
                    (factor-evidence
                      (#pt-eq
                        #pt-nat
                        multiple
                        (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) index))))
                  (#pt-app (#pt-use two-power-or-prime ()) multiple)))
              (#pt-lambda
                (
                  (zero-factor-equation
                    (#pt-eq
                      #pt-nat
                      multiple
                      (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) #pt-zero))))
                (#pt-app
                  (#pt-use false-elimination ())
                  (#pt-app (#pt-use two-power-or-prime ()) multiple)
                  (#pt-app multiple-nonzero zero-factor-equation)))
              (#pt-lambda
                (
                  (predecessor #pt-nat)
                  (unused-previous
                    (#pt-pi
                      (
                        (prior-equation
                          (#pt-eq
                            #pt-nat
                            multiple
                            (#pt-app
                              (#pt-use multiply ())
                              (#pt-succ (#pt-succ #pt-zero))
                              predecessor))))
                      (#pt-app (#pt-use two-power-or-prime ()) multiple)))
                  (factor-equation
                    (#pt-eq
                      #pt-nat
                      multiple
                      (#pt-app
                        (#pt-use multiply ())
                        (#pt-succ (#pt-succ #pt-zero))
                        (#pt-succ predecessor)))))
                (#pt-app
                  (#pt-use two-power-or-prime-double ())
                  (#pt-succ predecessor)
                  multiple
                  factor-equation
                  (#pt-app
                    smaller-cases
                    (#pt-succ predecessor)
                    (#pt-app
                      (#pt-use substitution (0))
                      #pt-nat
                      (#pt-lambda
                        ((endpoint #pt-nat))
                        (#pt-app (#pt-use less-than ()) (#pt-succ predecessor) endpoint))
                      (#pt-app
                        (#pt-use multiply ())
                        (#pt-succ (#pt-succ #pt-zero))
                        (#pt-succ predecessor))
                      multiple
                      (#pt-app
                        (#pt-use symmetry (0))
                        #pt-nat
                        multiple
                        (#pt-app
                          (#pt-use multiply ())
                          (#pt-succ (#pt-succ #pt-zero))
                          (#pt-succ predecessor))
                        factor-equation)
                      (#pt-app (#pt-use successor-below-double ()) predecessor))
                    (#pt-app (#pt-use successor-not-zero ()) predecessor))))
              factor-witness)
            witness-equation)))
      two-divides)))
(#theorem classify-large-number
  (#universes)
  (#parameters
    (#parameter multiple #pt-nat)
    (#parameter smaller-cases (#pt-pi ((earlier #pt-nat) (earlier-proof (#pt-app (#pt-use less-than ()) earlier multiple))) (#pt-pi ((nonzero-proof (#pt-pi ((denied-proof (#pt-eq #pt-nat earlier #pt-zero))) #pt-false))) (#pt-app (#pt-use two-power-or-prime ()) earlier))))
    (#parameter multiple-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat multiple #pt-zero))) #pt-false))
    (#parameter larger-than-one (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) multiple)))
  (#statement (#pt-app (#pt-use two-power-or-prime ()) multiple))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((prime-candidate #pt-nat))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app (#pt-use prime ()) prime-candidate)
            (#pt-app (#pt-use divides ()) prime-candidate multiple))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((prime-candidate #pt-nat))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app (#pt-use prime ()) prime-candidate)
                  (#pt-app (#pt-use divides ()) prime-candidate multiple))))))
        (#pt-app (#pt-use two-power-or-prime ()) multiple))
      (
        (#pt-lambda
          (
            (prime-factor #pt-nat)
            (prime-proof
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use prime ()) prime-factor)
                (#pt-app (#pt-use divides ()) prime-factor multiple))))
          (#pt-induct
            decision
            ()
            ((#pt-eq #pt-nat prime-factor (#pt-succ (#pt-succ #pt-zero))))
            (#pt-lambda
              (
                (equality-decision
                  (#pt-app
                    (#pt-use decision ())
                    (#pt-eq #pt-nat prime-factor (#pt-succ (#pt-succ #pt-zero))))))
              (#pt-app (#pt-use two-power-or-prime ()) multiple))
            (
              (#pt-lambda
                (
                  (not-two
                    (#pt-pi
                      ((denied-proof (#pt-eq #pt-nat prime-factor (#pt-succ (#pt-succ #pt-zero)))))
                      #pt-false)))
                (#pt-app
                  (#pt-use disjunction-right ())
                  (#pt-app (#pt-use power-of-two ()) multiple)
                  (#pt-app (#pt-use non-two-prime-divisor ()) multiple)
                  (#pt-construct
                    exists
                    (0)
                    (#pt-nat
                      (#pt-lambda
                        ((prime-candidate #pt-nat))
                        (#pt-app
                          (#pt-use conjunction ())
                          (#pt-app (#pt-use prime ()) prime-candidate)
                          (#pt-app
                            (#pt-use conjunction ())
                            (#pt-pi
                              (
                                (denied-proof
                                  (#pt-eq #pt-nat prime-candidate (#pt-succ (#pt-succ #pt-zero)))))
                              #pt-false)
                            (#pt-app (#pt-use divides ()) prime-candidate multiple)))))
                    introduce
                    (prime-factor
                      (#pt-app
                        (#pt-use conjunction-introduce ())
                        (#pt-app (#pt-use prime ()) prime-factor)
                        (#pt-app
                          (#pt-use conjunction ())
                          (#pt-pi
                            (
                              (denied-proof
                                (#pt-eq #pt-nat prime-factor (#pt-succ (#pt-succ #pt-zero)))))
                            #pt-false)
                          (#pt-app (#pt-use divides ()) prime-factor multiple))
                        (#pt-app
                          (#pt-use conjunction-left ())
                          (#pt-app (#pt-use prime ()) prime-factor)
                          (#pt-app (#pt-use divides ()) prime-factor multiple)
                          prime-proof)
                        (#pt-app
                          (#pt-use conjunction-introduce ())
                          (#pt-pi
                            (
                              (denied-proof
                                (#pt-eq #pt-nat prime-factor (#pt-succ (#pt-succ #pt-zero)))))
                            #pt-false)
                          (#pt-app (#pt-use divides ()) prime-factor multiple)
                          not-two
                          (#pt-app
                            (#pt-use conjunction-right ())
                            (#pt-app (#pt-use prime ()) prime-factor)
                            (#pt-app (#pt-use divides ()) prime-factor multiple)
                            prime-proof)))))))
              (#pt-lambda
                ((equal-two (#pt-eq #pt-nat prime-factor (#pt-succ (#pt-succ #pt-zero)))))
                (#pt-app
                  (#pt-use classify-two-multiple ())
                  multiple
                  smaller-cases
                  multiple-nonzero
                  (#pt-app
                    (#pt-use substitution (0))
                    #pt-nat
                    (#pt-lambda
                      ((divisor-name #pt-nat))
                      (#pt-app (#pt-use divides ()) divisor-name multiple))
                    prime-factor
                    (#pt-succ (#pt-succ #pt-zero))
                    equal-two
                    (#pt-app
                      (#pt-use conjunction-right ())
                      (#pt-app (#pt-use prime ()) prime-factor)
                      (#pt-app (#pt-use divides ()) prime-factor multiple)
                      prime-proof)))))
            (#pt-app (#pt-use decide-equality ()) prime-factor (#pt-succ (#pt-succ #pt-zero))))))
      (#pt-app (#pt-use exists-prime-divisor ()) multiple larger-than-one))))
(#theorem classify-one-step
  (#universes)
  (#parameters
    (#parameter multiple #pt-nat)
    (#parameter smaller-cases (#pt-pi ((earlier #pt-nat) (earlier-proof (#pt-app (#pt-use less-than ()) earlier multiple))) (#pt-pi ((nonzero-proof (#pt-pi ((denied-proof (#pt-eq #pt-nat earlier #pt-zero))) #pt-false))) (#pt-app (#pt-use two-power-or-prime ()) earlier))))
    (#parameter multiple-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat multiple #pt-zero))) #pt-false)))
  (#statement (#pt-app (#pt-use two-power-or-prime ()) multiple))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-eq #pt-nat multiple #pt-zero)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-eq #pt-nat multiple (#pt-succ #pt-zero))
        (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) multiple))
      (#pt-app (#pt-use two-power-or-prime ()) multiple)
      (#pt-lambda
        ((zero-equation (#pt-eq #pt-nat multiple #pt-zero)))
        (#pt-app
          (#pt-use false-elimination ())
          (#pt-app (#pt-use two-power-or-prime ()) multiple)
          (#pt-app multiple-nonzero zero-equation)))
      (#pt-lambda
        (
          (nonzero-case
            (#pt-app
              (#pt-use disjunction ())
              (#pt-eq #pt-nat multiple (#pt-succ #pt-zero))
              (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) multiple))))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-eq #pt-nat multiple (#pt-succ #pt-zero))
          (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) multiple)
          (#pt-app (#pt-use two-power-or-prime ()) multiple)
          (#pt-lambda
            ((one-equation (#pt-eq #pt-nat multiple (#pt-succ #pt-zero))))
            (#pt-app
              (#pt-use disjunction-left ())
              (#pt-app (#pt-use power-of-two ()) multiple)
              (#pt-app (#pt-use non-two-prime-divisor ()) multiple)
              (#pt-construct
                exists
                (0)
                (#pt-nat
                  (#pt-lambda
                    ((power-exponent #pt-nat))
                    (#pt-eq
                      #pt-nat
                      multiple
                      (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) power-exponent))))
                introduce
                (#pt-zero one-equation))))
          (#pt-lambda
            ((larger-than-one (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) multiple)))
            (#pt-app
              (#pt-use classify-large-number ())
              multiple
              smaller-cases
              multiple-nonzero
              larger-than-one))
          nonzero-case))
      (#pt-app (#pt-use zero-one-or-large ()) multiple))))
(#theorem classify-positive-number
  (#universes)
  (#parameters
    (#parameter multiple #pt-nat)
    (#parameter multiple-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat multiple #pt-zero))) #pt-false)))
  (#statement (#pt-app (#pt-use two-power-or-prime ()) multiple))
  (#proof
    (#pt-app
      (#pt-app
        (#pt-use strong-induction ())
        (#pt-lambda
          ((index #pt-nat))
          (#pt-pi
            ((nonzero-proof (#pt-pi ((denied-proof (#pt-eq #pt-nat index #pt-zero))) #pt-false)))
            (#pt-app (#pt-use two-power-or-prime ()) index)))
        (#pt-lambda
          (
            (stage #pt-nat)
            (earlier-cases
              (#pt-pi
                ((earlier #pt-nat) (earlier-proof (#pt-app (#pt-use less-than ()) earlier stage)))
                (#pt-pi
                  (
                    (nonzero-proof
                      (#pt-pi ((denied-proof (#pt-eq #pt-nat earlier #pt-zero))) #pt-false)))
                  (#pt-app (#pt-use two-power-or-prime ()) earlier))))
            (stage-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat stage #pt-zero))) #pt-false)))
          (#pt-app (#pt-use classify-one-step ()) stage earlier-cases stage-nonzero)))
      multiple
      multiple-nonzero)))
