                          exponent
                          candidate-first
                          candidate-second
                          candidate-third)))))))))
        (#pt-app (#pt-use has-normalized-integer-power-packet ()) exponent))
      (
        (#pt-lambda
          (
            (signed-first (#pt-use integer ()))
            (second-signed-exists
              (#pt-app
                (#pt-use exists (0))
                (#pt-use integer ())
                (#pt-lambda
                  ((candidate-second (#pt-use integer ())))
