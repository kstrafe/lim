                    (#pt-use exists (0))
                    (#pt-use integer ())
                    (#pt-lambda
                      ((candidate-third (#pt-use integer ())))
                      (#pt-app
                        (#pt-use normalized-integer-power-packet ())
                        exponent
                        candidate-first
                        candidate-second
                        candidate-third)))))))
          introduce
