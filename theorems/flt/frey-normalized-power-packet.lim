(#theorem integer-even-power-packet-has-normalized-sign
  (#universes)
  (#parameters
    (#parameter exponent #pt-nat)
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter odd-exponent (#pt-app (#pt-use odd ()) exponent))
    (#parameter even-packet (#pt-app (#pt-use integer-even-power-packet ()) exponent first second third)))
