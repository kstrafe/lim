      (#pt-lambda
        ((candidate-first (#pt-use integer ())))
        (#pt-app
          (#pt-use exists (0))
          (#pt-use integer ())
          (#pt-lambda
            ((candidate-second (#pt-use integer ())))
            (#pt-app
              (#pt-use exists (0))
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-third (#pt-use integer ())))
