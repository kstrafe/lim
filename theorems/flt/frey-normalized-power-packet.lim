    (
      (exponent #pt-nat)
      (first (#pt-use integer ()))
      (second (#pt-use integer ()))
      (third (#pt-use integer ())))
    #pt-prop)
  (#pt-lambda
    (
      (exponent #pt-nat)
      (first (#pt-use integer ()))
      (second (#pt-use integer ()))
      (third (#pt-use integer ())))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app (#pt-use integer-even-power-packet ()) exponent first second third)
      (#pt-app (#pt-use integer-three-mod-four ()) first))))
(#math-definition has-normalized-integer-power-packet ()
  (#pt-pi ((exponent #pt-nat)) #pt-prop)
