              (
                (#pt-use integer ())
                (#pt-lambda
                  ((candidate-second (#pt-use integer ())))
                  (#pt-app
                    (#pt-use exists (0))
                    (#pt-use integer ())
                    (#pt-lambda
                      ((candidate-third (#pt-use integer ())))
                      (#pt-app
                        (#pt-use normalized-integer-power-packet ())
                        exponent
                        first
                        candidate-second
                        candidate-third)))))
              introduce
              (second
                (#pt-construct
                  exists
                  (0)
                  (
                    (#pt-use integer ())
                    (#pt-lambda
                      ((candidate-third (#pt-use integer ())))
                      (#pt-app
                        (#pt-use normalized-integer-power-packet ())
                        exponent
                        first
                        second
                        candidate-third)))
                  introduce
                  (third
                    (#pt-app
                      (#pt-use conjunction-introduce ())
                      (#pt-app (#pt-use integer-even-power-packet ()) exponent first second third)
                      (#pt-app (#pt-use integer-three-mod-four ()) first)
                      even-packet
                      positive-residue))))))))
      (#pt-lambda
        (
          (negative-residue
            (#pt-app
              (#pt-use integer-three-mod-four ())
              (#pt-app (#pt-use integer-negate ()) first))))
        (#pt-construct
