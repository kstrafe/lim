          (#pt-app
            (#pt-use disjunction ())
            (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) candidate-first)
            (#pt-app
              (#pt-use eisenstein-divides ())
              (#pt-use eisenstein-lambda ())
              candidate-second))))
      (#pt-use eisenstein-lambda-nonzero ())
      (#pt-app
        (#pt-use conjunction-introduce ())
        (#pt-pi
          ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) (#pt-use eisenstein-lambda ()))))
          #pt-false)
        (#pt-pi
          (
            (candidate-first (#pt-use eisenstein ()))
            (candidate-second (#pt-use eisenstein ()))
            (product-evidence
              (#pt-app
                (#pt-use eisenstein-divides ())
                (#pt-use eisenstein-lambda ())
                (#pt-app (#pt-use eisenstein-multiply ()) candidate-first candidate-second))))
          (#pt-app
            (#pt-use disjunction ())
