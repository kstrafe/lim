              (#pt-use eisenstein-zero ()))))
        #pt-false)
      (#pt-app
        (#pt-use conjunction ())
        (#pt-pi
          ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) (#pt-use eisenstein-lambda ()))))
          #pt-false)
