            (#pt-app
              (#pt-use eisenstein-divides ())
              (#pt-use eisenstein-lambda ())
              candidate-second)))
        (#pt-use eisenstein-lambda-not-unit ())
        (#pt-lambda
          (
            (first (#pt-use eisenstein ()))
            (second (#pt-use eisenstein ()))
            (product-divides
