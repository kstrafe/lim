(#theorem eisenstein-lambda-divides-product
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter product-divides (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) (#pt-app (#pt-use eisenstein-multiply ()) first second))))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) first)
      (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) second)))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app
        (#pt-use integer-divides ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
        (#pt-app (#pt-use eisenstein-coordinate-sum ()) first))
      (#pt-app
        (#pt-use integer-divides ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
        (#pt-app (#pt-use eisenstein-coordinate-sum ()) second))
      (#pt-app
        (#pt-use disjunction ())
        (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) first)
        (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) second))
      (#pt-lambda
        (
          (first-coordinate-divides
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
              (#pt-app (#pt-use eisenstein-coordinate-sum ()) first))))
        (#pt-app
