          (#pt-app (#pt-use eisenstein-lambda-divides-product ()) first second product-divides))))))
(#theorem eisenstein-lambda-divides-power
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter exponent #pt-nat)
    (#parameter power-divides (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) (#pt-app (#pt-use eisenstein-power ()) number exponent))))
  (#statement (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number))
  (#proof
    (#pt-app
      (#pt-nat-induct
        (#pt-lambda
          ((index #pt-nat))
          (#pt-pi
            (
              (power-evidence
                (#pt-app
                  (#pt-use eisenstein-divides ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-app (#pt-use eisenstein-power ()) number index))))
            (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number)))
        (#pt-lambda
          (
            (zero-power-divides
              (#pt-app
                (#pt-use eisenstein-divides ())
                (#pt-use eisenstein-lambda ())
                (#pt-app (#pt-use eisenstein-power ()) number #pt-zero))))
          (#pt-app
            (#pt-use false-elimination ())
            (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number)
            (#pt-app (#pt-use eisenstein-lambda-not-divides-one ()) zero-power-divides)))
        (#pt-lambda
          (
            (previous #pt-nat)
            (previous-case
              (#pt-pi
                (
                  (power-evidence
                    (#pt-app
                      (#pt-use eisenstein-divides ())
                      (#pt-use eisenstein-lambda ())
                      (#pt-app (#pt-use eisenstein-power ()) number previous))))
                (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number)))
            (successor-divides
              (#pt-app
                (#pt-use eisenstein-divides ())
                (#pt-use eisenstein-lambda ())
                (#pt-app (#pt-use eisenstein-power ()) number (#pt-succ previous)))))
          (#pt-app
            (#pt-use disjunction-eliminate ())
            (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number)
            (#pt-app
              (#pt-use eisenstein-divides ())
              (#pt-use eisenstein-lambda ())
              (#pt-app (#pt-use eisenstein-power ()) number previous))
            (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number)
            (#pt-lambda
              (
                (base-divides
                  (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number)))
              base-divides)
            (#pt-lambda
              (
                (smaller-power-divides
                  (#pt-app
                    (#pt-use eisenstein-divides ())
                    (#pt-use eisenstein-lambda ())
                    (#pt-app (#pt-use eisenstein-power ()) number previous))))
              (#pt-app previous-case smaller-power-divides))
            (#pt-app
              (#pt-use eisenstein-lambda-divides-product ())
              number
              (#pt-app (#pt-use eisenstein-power ()) number previous)
              successor-divides)))
        exponent)
      power-divides)))
