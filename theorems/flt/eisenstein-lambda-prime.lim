(#math-definition eisenstein-coordinate-sum ()
  (#pt-pi ((number (#pt-use eisenstein ()))) (#pt-use integer ()))
  (#pt-lambda
    ((number (#pt-use eisenstein ())))
    (#pt-app
      (#pt-use integer-add ())
      (#pt-project eisenstein 0 number)
      (#pt-project eisenstein 1 number))))
(#theorem eisenstein-coordinate-sum-congruent
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter equivalent (#pt-app (#pt-use eisenstein-equal ()) first second)))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use eisenstein-coordinate-sum ()) first)
      (#pt-app (#pt-use eisenstein-coordinate-sum ()) second)))
  (#proof
    (#pt-app
      (#pt-use integer-add-congruent ())
      (#pt-project eisenstein 0 first)
      (#pt-project eisenstein 1 first)
      (#pt-project eisenstein 0 second)
      (#pt-project eisenstein 1 second)
      (#pt-app
        (#pt-use conjunction-left ())
        (#pt-app
          (#pt-use integer-equal ())
          (#pt-project eisenstein 0 first)
          (#pt-project eisenstein 0 second))
        (#pt-app
          (#pt-use integer-equal ())
          (#pt-project eisenstein 1 first)
          (#pt-project eisenstein 1 second))
        equivalent)
      (#pt-app
        (#pt-use conjunction-right ())
        (#pt-app
          (#pt-use integer-equal ())
          (#pt-project eisenstein 0 first)
          (#pt-project eisenstein 0 second))
        (#pt-app
          (#pt-use integer-equal ())
          (#pt-project eisenstein 1 first)
          (#pt-project eisenstein 1 second))
        equivalent))))
(#theorem integer-three-divides-coordinate-sum
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter lambda-divides-proof (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number)))
  (#statement
    (#pt-app
      (#pt-use integer-divides ())
      (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
      (#pt-app (#pt-use eisenstein-coordinate-sum ()) number)))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            number
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-use eisenstein-lambda ())
              candidate-factor))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  number
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-use eisenstein-lambda ())
                    candidate-factor))))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
          (#pt-app (#pt-use eisenstein-coordinate-sum ()) number)))
      (
        (#pt-lambda
          (
            (factor (#pt-use eisenstein ()))
            (factor-equation
              (#pt-app
                (#pt-use eisenstein-equal ())
                number
                (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) factor))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use integer ())
              (#pt-lambda
                ((integer-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-app (#pt-use eisenstein-coordinate-sum ()) number)
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                    integer-factor))))
            introduce
            (
              (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor))
              (#pt-app
                (#pt-use integer-transitive ())
                (#pt-app (#pt-use eisenstein-coordinate-sum ()) number)
                (#pt-app
                  (#pt-use eisenstein-coordinate-sum ())
                  (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) factor))
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor)))
                (#pt-app
                  (#pt-use eisenstein-coordinate-sum-congruent ())
                  number
                  (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) factor)
                  factor-equation)
                (#pt-app
                  (#pt-use eisenstein-scalar-lambda-product-coordinate-sum ())
                  (#pt-project eisenstein 0 factor)
                  (#pt-project eisenstein 1 factor)))))))
      lambda-divides-proof)))
(#theorem eisenstein-lambda-divides-of-coordinate-sum
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter three-divides-proof (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)) (#pt-app (#pt-use eisenstein-coordinate-sum ()) number))))
  (#statement (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) number))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use integer ())
        (#pt-lambda
          ((integer-factor (#pt-use integer ())))
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-app (#pt-use eisenstein-coordinate-sum ()) number)
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
              integer-factor))))
      (#pt-lambda
        (
          (integer-certificate
            (#pt-app
              (#pt-use exists (0))
