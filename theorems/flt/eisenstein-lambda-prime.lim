      three-divides-proof)))
(#theorem eisenstein-lambda-not-divides-one
  (#universes)
  (#parameters)
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use eisenstein-divides ())
            (#pt-use eisenstein-lambda ())
            (#pt-use eisenstein-one ()))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (unit-divides
          (#pt-app
            (#pt-use eisenstein-divides ())
            (#pt-use eisenstein-lambda ())
            (#pt-use eisenstein-one ()))))
      (#pt-app
        (#pt-use three-not-divides-one ())
        (#pt-app
          (#pt-use integer-natural-divisibility-reflects ())
          (#pt-numeral 3)
          (#pt-succ #pt-zero)
          (#pt-app
            (#pt-use integer-three-divides-coordinate-sum ())
            (#pt-use eisenstein-one ())
            unit-divides))))))
(#theorem eisenstein-lambda-not-unit
  (#universes)
  (#parameters)
  (#statement
    (#pt-pi
      ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) (#pt-use eisenstein-lambda ()))))
