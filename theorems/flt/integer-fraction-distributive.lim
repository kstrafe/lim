; The explicit integer identity behind rational distributivity.
; Actual common-denominator products and both weighted summands are
; regrouped using proved ring laws, with no field or polynomial oracle.
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
