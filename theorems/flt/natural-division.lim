; Constructive quotient/remainder existence on arbitrary mathematical naturals.
; A division certificate gives n = q*d+r and r < d, so a zero divisor is excluded.
; Existence is proved by Nat induction, with a discrete carry at r+1=d.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#alias less-than-discrete-step = ./natural-discrete-order.lim::less-than-discrete-step)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias add-zero-right = ./natural-addition.lim::add-zero-right)
(#alias add-commutative = ./natural-addition.lim::add-commutative)
(#alias add-successor-right = ./natural-addition.lim::add-successor-right)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias congruence = ./equality.lim::congruence)
(#math-definition division-spec ()
  (#pt-pi ((dividend #pt-nat) (divisor #pt-nat) (quotient #pt-nat) (remainder #pt-nat)) #pt-prop)
  (#pt-lambda
    ((dividend #pt-nat) (divisor #pt-nat) (quotient #pt-nat) (remainder #pt-nat))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-eq
        #pt-nat
        dividend
        (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) quotient divisor) remainder))
      (#pt-app (#pt-use less-than ()) remainder divisor))))
(#math-definition has-division ()
  (#pt-pi ((dividend #pt-nat) (divisor #pt-nat)) #pt-prop)
  (#pt-lambda
    ((dividend #pt-nat) (divisor #pt-nat))
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-quotient #pt-nat))
        (#pt-app
          (#pt-use exists (0))
          #pt-nat
          (#pt-lambda
            ((candidate-remainder #pt-nat))
            (#pt-app
              (#pt-use division-spec ())
              dividend
              divisor
              candidate-quotient
              candidate-remainder)))))))
(#theorem division-exists
  (#universes)
  (#parameters
    (#parameter dividend #pt-nat)
    (#parameter divisor #pt-nat)
    (#parameter positive-divisor (#pt-app (#pt-use less-than ()) #pt-zero divisor)))
  (#statement (#pt-app (#pt-use has-division ()) dividend divisor))
  (#proof
    (#pt-nat-induct
      (#pt-lambda ((index #pt-nat)) (#pt-app (#pt-use has-division ()) index divisor))
      (#pt-construct
        exists
        (0)
        (#pt-nat
          (#pt-lambda
            ((candidate-quotient #pt-nat))
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-remainder #pt-nat))
                (#pt-app
                  (#pt-use division-spec ())
                  #pt-zero
                  divisor
                  candidate-quotient
                  candidate-remainder)))))
        introduce
        (#pt-zero
          (#pt-construct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-remainder #pt-nat))
                (#pt-app (#pt-use division-spec ()) #pt-zero divisor #pt-zero candidate-remainder)))
            introduce
            (#pt-zero
              (#pt-app
                (#pt-use conjunction-introduce ())
                (#pt-eq
                  #pt-nat
                  #pt-zero
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use multiply ()) #pt-zero divisor)
                    #pt-zero))
                (#pt-app (#pt-use less-than ()) #pt-zero divisor)
                (#pt-refl #pt-nat #pt-zero)
                positive-divisor)))))
      (#pt-lambda
        (
          (previous #pt-nat)
          (previous-division (#pt-app (#pt-use has-division ()) previous divisor)))
        (#pt-induct
          exists
          (0)
          (#pt-nat
            (#pt-lambda
              ((candidate-quotient #pt-nat))
              (#pt-app
                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((candidate-remainder #pt-nat))
                  (#pt-app
                    (#pt-use division-spec ())
                    previous
                    divisor
                    candidate-quotient
                    candidate-remainder)))))
          (#pt-lambda
            (
              (certificate
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((candidate-quotient #pt-nat))
                    (#pt-app
                      (#pt-use exists (0))
                      #pt-nat
                      (#pt-lambda
                        ((candidate-remainder #pt-nat))
                        (#pt-app
                          (#pt-use division-spec ())
                          previous
                          divisor
                          candidate-quotient
                          candidate-remainder)))))))
            (#pt-app (#pt-use has-division ()) (#pt-succ previous) divisor))
          (
            (#pt-lambda
              (
                (quotient #pt-nat)
                (remainder-certificate
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((candidate-remainder #pt-nat))
                      (#pt-app
                        (#pt-use division-spec ())
                        previous
                        divisor
                        quotient
                        candidate-remainder)))))
              (#pt-induct
                exists
                (0)
                (#pt-nat
                  (#pt-lambda
                    ((candidate-remainder #pt-nat))
                    (#pt-app
                      (#pt-use division-spec ())
                      previous
                      divisor
                      quotient
                      candidate-remainder)))
                (#pt-lambda
                  (
                    (certificate
                      (#pt-app
                        (#pt-use exists (0))
                        #pt-nat
                        (#pt-lambda
                          ((candidate-remainder #pt-nat))
                          (#pt-app
                            (#pt-use division-spec ())
                            previous
                            divisor
                            quotient
                            candidate-remainder)))))
                  (#pt-app (#pt-use has-division ()) (#pt-succ previous) divisor))
                (
                  (#pt-lambda
                    (
                      (remainder #pt-nat)
                      (division-proof
                        (#pt-app (#pt-use division-spec ()) previous divisor quotient remainder)))
                    (#pt-app
                      (#pt-use disjunction-eliminate ())
                      (#pt-eq #pt-nat (#pt-succ remainder) divisor)
                      (#pt-app (#pt-use less-than ()) (#pt-succ remainder) divisor)
                      (#pt-app (#pt-use has-division ()) (#pt-succ previous) divisor)
                      (#pt-lambda
                        ((carry-equation (#pt-eq #pt-nat (#pt-succ remainder) divisor)))
                        (#pt-construct
                          exists
                          (0)
                          (#pt-nat
                            (#pt-lambda
                              ((candidate-quotient #pt-nat))
                              (#pt-app
                                (#pt-use exists (0))
                                #pt-nat
                                (#pt-lambda
                                  ((candidate-remainder #pt-nat))
                                  (#pt-app
                                    (#pt-use division-spec ())
                                    (#pt-succ previous)
                                    divisor
                                    candidate-quotient
                                    candidate-remainder)))))
                          introduce
                          (
                            (#pt-succ quotient)
                            (#pt-construct
                              exists
                              (0)
                              (#pt-nat
                                (#pt-lambda
                                  ((candidate-remainder #pt-nat))
                                  (#pt-app
                                    (#pt-use division-spec ())
                                    (#pt-succ previous)
                                    divisor
                                    (#pt-succ quotient)
                                    candidate-remainder)))
                              introduce
                              (#pt-zero
                                (#pt-app
                                  (#pt-use conjunction-introduce ())
                                  (#pt-eq
                                    #pt-nat
                                    (#pt-succ previous)
                                    (#pt-app
                                      (#pt-use add ())
                                      (#pt-app (#pt-use multiply ()) (#pt-succ quotient) divisor)
                                      #pt-zero))
                                  (#pt-app (#pt-use less-than ()) #pt-zero divisor)
                                  (#pt-app
                                    (#pt-use transitivity (0))
                                    #pt-nat
                                    (#pt-succ previous)
                                    (#pt-succ
                                      (#pt-app
                                        (#pt-use add ())
                                        (#pt-app (#pt-use multiply ()) quotient divisor)
                                        remainder))
                                    (#pt-app
                                      (#pt-use add ())
                                      (#pt-app (#pt-use multiply ()) (#pt-succ quotient) divisor)
                                      #pt-zero)
                                    (#pt-app
                                      (#pt-use congruence (0 0))
                                      #pt-nat
                                      #pt-nat
                                      (#pt-lambda ((endpoint #pt-nat)) (#pt-succ endpoint))
                                      previous
                                      (#pt-app
                                        (#pt-use add ())
                                        (#pt-app (#pt-use multiply ()) quotient divisor)
                                        remainder)
                                      (#pt-app
                                        (#pt-use conjunction-left ())
                                        (#pt-eq
                                          #pt-nat
                                          previous
                                          (#pt-app
                                            (#pt-use add ())
                                            (#pt-app (#pt-use multiply ()) quotient divisor)
                                            remainder))
                                        (#pt-app (#pt-use less-than ()) remainder divisor)
                                        division-proof))
                                    (#pt-app
                                      (#pt-use transitivity (0))
                                      #pt-nat
                                      (#pt-succ
                                        (#pt-app
                                          (#pt-use add ())
                                          (#pt-app (#pt-use multiply ()) quotient divisor)
                                          remainder))
                                      (#pt-app
                                        (#pt-use add ())
                                        (#pt-app (#pt-use multiply ()) quotient divisor)
                                        (#pt-succ remainder))
                                      (#pt-app
                                        (#pt-use add ())
                                        (#pt-app (#pt-use multiply ()) (#pt-succ quotient) divisor)
                                        #pt-zero)
                                      (#pt-app
                                        (#pt-use symmetry (0))
                                        #pt-nat
                                        (#pt-app
                                          (#pt-use add ())
                                          (#pt-app (#pt-use multiply ()) quotient divisor)
                                          (#pt-succ remainder))
                                        (#pt-succ
                                          (#pt-app
                                            (#pt-use add ())
                                            (#pt-app (#pt-use multiply ()) quotient divisor)
                                            remainder))
                                        (#pt-app
                                          (#pt-use add-successor-right ())
                                          (#pt-app (#pt-use multiply ()) quotient divisor)
                                          remainder))
                                      (#pt-app
                                        (#pt-use transitivity (0))
                                        #pt-nat
                                        (#pt-app
                                          (#pt-use add ())
                                          (#pt-app (#pt-use multiply ()) quotient divisor)
                                          (#pt-succ remainder))
                                        (#pt-app
                                          (#pt-use add ())
                                          (#pt-app (#pt-use multiply ()) quotient divisor)
                                          divisor)
                                        (#pt-app
                                          (#pt-use add ())
                                          (#pt-app
                                            (#pt-use multiply ())
                                            (#pt-succ quotient)
                                            divisor)
                                          #pt-zero)
                                        (#pt-app
                                          (#pt-use congruence (0 0))
                                          #pt-nat
                                          #pt-nat
                                          (#pt-lambda
                                            ((summand #pt-nat))
                                            (#pt-app
                                              (#pt-use add ())
                                              (#pt-app (#pt-use multiply ()) quotient divisor)
                                              summand))
                                          (#pt-succ remainder)
                                          divisor
                                          carry-equation)
                                        (#pt-app
                                          (#pt-use transitivity (0))
                                          #pt-nat
                                          (#pt-app
                                            (#pt-use add ())
                                            (#pt-app (#pt-use multiply ()) quotient divisor)
                                            divisor)
                                          (#pt-app
                                            (#pt-use multiply ())
                                            (#pt-succ quotient)
                                            divisor)
                                          (#pt-app
                                            (#pt-use add ())
                                            (#pt-app
                                              (#pt-use multiply ())
                                              (#pt-succ quotient)
                                              divisor)
                                            #pt-zero)
                                          (#pt-app
                                            (#pt-use add-commutative ())
                                            (#pt-app (#pt-use multiply ()) quotient divisor)
                                            divisor)
                                          (#pt-app
                                            (#pt-use symmetry (0))
                                            #pt-nat
                                            (#pt-app
                                              (#pt-use add ())
                                              (#pt-app
                                                (#pt-use multiply ())
                                                (#pt-succ quotient)
                                                divisor)
                                              #pt-zero)
                                            (#pt-app
                                              (#pt-use multiply ())
                                              (#pt-succ quotient)
                                              divisor)
                                            (#pt-app
                                              (#pt-use add-zero-right ())
                                              (#pt-app
                                                (#pt-use multiply ())
                                                (#pt-succ quotient)
                                                divisor)))))))
                                  positive-divisor))))))
                      (#pt-lambda
                        (
                          (next-remainder-less
                            (#pt-app (#pt-use less-than ()) (#pt-succ remainder) divisor)))
                        (#pt-construct
                          exists
                          (0)
                          (#pt-nat
                            (#pt-lambda
                              ((candidate-quotient #pt-nat))
                              (#pt-app
                                (#pt-use exists (0))
                                #pt-nat
                                (#pt-lambda
                                  ((candidate-remainder #pt-nat))
                                  (#pt-app
                                    (#pt-use division-spec ())
                                    (#pt-succ previous)
                                    divisor
                                    candidate-quotient
                                    candidate-remainder)))))
                          introduce
                          (quotient
                            (#pt-construct
                              exists
                              (0)
                              (#pt-nat
                                (#pt-lambda
                                  ((candidate-remainder #pt-nat))
                                  (#pt-app
                                    (#pt-use division-spec ())
                                    (#pt-succ previous)
                                    divisor
                                    quotient
                                    candidate-remainder)))
                              introduce
                              (
                                (#pt-succ remainder)
                                (#pt-app
                                  (#pt-use conjunction-introduce ())
                                  (#pt-eq
                                    #pt-nat
                                    (#pt-succ previous)
                                    (#pt-app
                                      (#pt-use add ())
                                      (#pt-app (#pt-use multiply ()) quotient divisor)
                                      (#pt-succ remainder)))
                                  (#pt-app (#pt-use less-than ()) (#pt-succ remainder) divisor)
                                  (#pt-app
                                    (#pt-use transitivity (0))
                                    #pt-nat
                                    (#pt-succ previous)
                                    (#pt-succ
                                      (#pt-app
                                        (#pt-use add ())
                                        (#pt-app (#pt-use multiply ()) quotient divisor)
                                        remainder))
                                    (#pt-app
                                      (#pt-use add ())
                                      (#pt-app (#pt-use multiply ()) quotient divisor)
                                      (#pt-succ remainder))
                                    (#pt-app
                                      (#pt-use congruence (0 0))
                                      #pt-nat
                                      #pt-nat
                                      (#pt-lambda ((endpoint #pt-nat)) (#pt-succ endpoint))
                                      previous
                                      (#pt-app
                                        (#pt-use add ())
                                        (#pt-app (#pt-use multiply ()) quotient divisor)
                                        remainder)
                                      (#pt-app
                                        (#pt-use conjunction-left ())
                                        (#pt-eq
                                          #pt-nat
                                          previous
                                          (#pt-app
                                            (#pt-use add ())
                                            (#pt-app (#pt-use multiply ()) quotient divisor)
                                            remainder))
                                        (#pt-app (#pt-use less-than ()) remainder divisor)
                                        division-proof))
                                    (#pt-app
                                      (#pt-use symmetry (0))
                                      #pt-nat
                                      (#pt-app
                                        (#pt-use add ())
                                        (#pt-app (#pt-use multiply ()) quotient divisor)
                                        (#pt-succ remainder))
                                      (#pt-succ
                                        (#pt-app
                                          (#pt-use add ())
                                          (#pt-app (#pt-use multiply ()) quotient divisor)
                                          remainder))
                                      (#pt-app
                                        (#pt-use add-successor-right ())
                                        (#pt-app (#pt-use multiply ()) quotient divisor)
                                        remainder)))
                                  next-remainder-less))))))
                      (#pt-app
                        (#pt-use less-than-discrete-step ())
                        remainder
                        divisor
                        (#pt-app
                          (#pt-use conjunction-right ())
                          (#pt-eq
                            #pt-nat
                            previous
                            (#pt-app
                              (#pt-use add ())
                              (#pt-app (#pt-use multiply ()) quotient divisor)
                              remainder))
                          (#pt-app (#pt-use less-than ()) remainder divisor)
                          division-proof)))))
                remainder-certificate)))
          previous-division))
      dividend)))
