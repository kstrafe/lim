      (#pt-app
        (#pt-use disjunction ())
        (#pt-app (#pt-use eisenstein-unit ()) number)
        (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) number))) #pt-false))
      (#pt-lambda
        ((number-zero (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ()))))
        (#pt-app
          (#pt-use disjunction-right ())
          (#pt-app (#pt-use eisenstein-unit ()) number)
