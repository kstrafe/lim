(#theorem eisenstein-euclidean-zero-remainder-divides
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter divisor-norm #pt-nat)
    (#parameter quotient (#pt-use eisenstein ()))
    (#parameter remainder (#pt-use eisenstein ()))
    (#parameter remainder-norm #pt-nat)
    (#parameter division-certificate (#pt-app (#pt-use eisenstein-euclidean-division-spec ()) number divisor divisor-norm quotient remainder remainder-norm))
    (#parameter remainder-zero (#pt-app (#pt-use eisenstein-equal ()) remainder (#pt-use eisenstein-zero ()))))
  (#statement (#pt-app (#pt-use eisenstein-divides ()) divisor number))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            number
            (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))
      introduce
      (quotient
        (#pt-app
          (#pt-use eisenstein-transitive ())
          number
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-multiply ()) divisor quotient)
            remainder)
          (#pt-app (#pt-use eisenstein-multiply ()) divisor quotient)
          (#pt-app
            (#pt-use conjunction-left ())
            (#pt-app
              (#pt-use eisenstein-equal ())
              number
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-app (#pt-use eisenstein-multiply ()) divisor quotient)
                remainder))
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app (#pt-use eisenstein-natural-norm ()) remainder remainder-norm)
              (#pt-app (#pt-use less-than ()) remainder-norm divisor-norm))
            division-certificate)
          (#pt-app
            (#pt-use eisenstein-transitive ())
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-multiply ()) divisor quotient)
              remainder)
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-multiply ()) divisor quotient)
              (#pt-use eisenstein-zero ()))
            (#pt-app (#pt-use eisenstein-multiply ()) divisor quotient)
            (#pt-app
              (#pt-use eisenstein-add-congruent ())
              (#pt-app (#pt-use eisenstein-multiply ()) divisor quotient)
              remainder
              (#pt-app (#pt-use eisenstein-multiply ()) divisor quotient)
              (#pt-use eisenstein-zero ())
              (#pt-app
                (#pt-use eisenstein-reflexive ())
                (#pt-app (#pt-use eisenstein-multiply ()) divisor quotient))
              remainder-zero)
            (#pt-app
              (#pt-use eisenstein-add-zero ())
              (#pt-app (#pt-use eisenstein-multiply ()) divisor quotient))))))))
(#theorem eisenstein-euclidean-nonzero-remainder-not-divides
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter divisor-norm #pt-nat)
    (#parameter quotient (#pt-use eisenstein ()))
    (#parameter remainder (#pt-use eisenstein ()))
    (#parameter remainder-norm #pt-nat)
    (#parameter division-certificate (#pt-app (#pt-use eisenstein-euclidean-division-spec ()) number divisor divisor-norm quotient remainder remainder-norm))
    (#parameter divisor-norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) divisor divisor-norm))
    (#parameter remainder-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) remainder (#pt-use eisenstein-zero ())))) #pt-false)))
  (#statement
    (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) divisor number))) #pt-false))
  (#proof
    (#pt-lambda
      ((number-divides (#pt-app (#pt-use eisenstein-divides ()) divisor number)))
      (#pt-app
        (#pt-app
          (#pt-use divisor-not-above ())
          divisor-norm
          remainder-norm
          (#pt-app
            (#pt-use eisenstein-natural-norm-nonzero ())
            remainder
            remainder-norm
            (#pt-app
              (#pt-use conjunction-left ())
              (#pt-app (#pt-use eisenstein-natural-norm ()) remainder remainder-norm)
              (#pt-app (#pt-use less-than ()) remainder-norm divisor-norm)
              (#pt-app
                (#pt-use conjunction-right ())
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  number
                  (#pt-app
                    (#pt-use eisenstein-add ())
                    (#pt-app (#pt-use eisenstein-multiply ()) divisor quotient)
                    remainder))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app (#pt-use eisenstein-natural-norm ()) remainder remainder-norm)
                  (#pt-app (#pt-use less-than ()) remainder-norm divisor-norm))
                division-certificate))
            remainder-nonzero)
          (#pt-app
            (#pt-use eisenstein-natural-norm-divides ())
            divisor
            remainder
            divisor-norm
            remainder-norm
            divisor-norm-certificate
            (#pt-app
              (#pt-use conjunction-left ())
              (#pt-app (#pt-use eisenstein-natural-norm ()) remainder remainder-norm)
              (#pt-app (#pt-use less-than ()) remainder-norm divisor-norm)
              (#pt-app
                (#pt-use conjunction-right ())
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  number
                  (#pt-app
                    (#pt-use eisenstein-add ())
                    (#pt-app (#pt-use eisenstein-multiply ()) divisor quotient)
                    remainder))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app (#pt-use eisenstein-natural-norm ()) remainder remainder-norm)
                  (#pt-app (#pt-use less-than ()) remainder-norm divisor-norm))
                division-certificate))
            (#pt-app
              (#pt-use eisenstein-divides-add-cancel-left ())
              divisor
              (#pt-app (#pt-use eisenstein-multiply ()) divisor quotient)
              remainder
              (#pt-app
                (#pt-use eisenstein-divides-product-left ())
                divisor
                divisor
                quotient
                (#pt-app (#pt-use eisenstein-divides-reflexive ()) divisor))
              (#pt-app
                (#pt-use eisenstein-divides-congruent-target ())
                divisor
                number
                (#pt-app
                  (#pt-use eisenstein-add ())
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor quotient)
                  remainder)
                (#pt-app
                  (#pt-use conjunction-left ())
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    number
                    (#pt-app
                      (#pt-use eisenstein-add ())
                      (#pt-app (#pt-use eisenstein-multiply ()) divisor quotient)
                      remainder))
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app (#pt-use eisenstein-natural-norm ()) remainder remainder-norm)
                    (#pt-app (#pt-use less-than ()) remainder-norm divisor-norm))
                  division-certificate)
                number-divides))))
        (#pt-app
          (#pt-use conjunction-right ())
          (#pt-app (#pt-use eisenstein-natural-norm ()) remainder remainder-norm)
          (#pt-app (#pt-use less-than ()) remainder-norm divisor-norm)
          (#pt-app
            (#pt-use conjunction-right ())
            (#pt-app
              (#pt-use eisenstein-equal ())
              number
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-app (#pt-use eisenstein-multiply ()) divisor quotient)
                remainder))
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app (#pt-use eisenstein-natural-norm ()) remainder remainder-norm)
              (#pt-app (#pt-use less-than ()) remainder-norm divisor-norm))
            division-certificate))))))
(#theorem eisenstein-euclidean-divisibility-cases
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter divisor-norm #pt-nat)
    (#parameter quotient (#pt-use eisenstein ()))
    (#parameter remainder (#pt-use eisenstein ()))
    (#parameter remainder-norm #pt-nat)
    (#parameter division-certificate (#pt-app (#pt-use eisenstein-euclidean-division-spec ()) number divisor divisor-norm quotient remainder remainder-norm))
    (#parameter divisor-norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) divisor divisor-norm)))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app (#pt-use eisenstein-divides ()) divisor number)
      (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) divisor number))) #pt-false)))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use eisenstein-equal ()) remainder (#pt-use eisenstein-zero ()))
      (#pt-pi
        (
          (denied-proof
            (#pt-app (#pt-use eisenstein-equal ()) remainder (#pt-use eisenstein-zero ()))))
        #pt-false)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-app (#pt-use eisenstein-divides ()) divisor number)
        (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) divisor number))) #pt-false))
      (#pt-lambda
        (
          (remainder-zero
            (#pt-app (#pt-use eisenstein-equal ()) remainder (#pt-use eisenstein-zero ()))))
        (#pt-app
          (#pt-use disjunction-left ())
          (#pt-app (#pt-use eisenstein-divides ()) divisor number)
          (#pt-pi
            ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) divisor number)))
            #pt-false)
          (#pt-app
            (#pt-use eisenstein-euclidean-zero-remainder-divides ())
            number
            divisor
            divisor-norm
            quotient
            remainder
            remainder-norm
            division-certificate
            remainder-zero)))
      (#pt-lambda
        (
          (remainder-nonzero
            (#pt-pi
              (
                (denied-proof
                  (#pt-app (#pt-use eisenstein-equal ()) remainder (#pt-use eisenstein-zero ()))))
              #pt-false)))
        (#pt-app
          (#pt-use disjunction-right ())
          (#pt-app (#pt-use eisenstein-divides ()) divisor number)
          (#pt-pi
            ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) divisor number)))
            #pt-false)
          (#pt-app
            (#pt-use eisenstein-euclidean-nonzero-remainder-not-divides ())
            number
            divisor
            divisor-norm
            quotient
            remainder
            remainder-norm
            division-certificate
            divisor-norm-certificate
            remainder-nonzero)))
      (#pt-app (#pt-use eisenstein-equality-decided ()) remainder (#pt-use eisenstein-zero ())))))
