(#theorem eisenstein-unit-cases
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app (#pt-use eisenstein-unit ()) number)
      (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) number))) #pt-false)))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ()))
      (#pt-pi
        ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ()))))
