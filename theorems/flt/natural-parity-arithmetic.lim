            (#pt-app
              (#pt-use multiply ())
              (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
              candidate-residue)
            (#pt-succ (#pt-succ #pt-zero)))))))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-residue #pt-nat))
          (#pt-eq
            #pt-nat
            (#pt-app (#pt-use multiply ()) first first)
            (#pt-succ
