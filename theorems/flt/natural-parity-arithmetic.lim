        (#pt-app
          (#pt-use substitution (0))
          #pt-nat
          (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use odd ()) endpoint))
          number
          #pt-zero
          zero-equation
          odd-proof)
        (#pt-app (#pt-use divides-zero ()) (#pt-succ (#pt-succ #pt-zero)))))))
(#theorem four-divides-even-square
