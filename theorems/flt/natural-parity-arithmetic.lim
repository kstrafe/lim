            (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) candidate-half)))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-half #pt-nat))
