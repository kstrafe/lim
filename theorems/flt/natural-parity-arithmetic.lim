                          (#pt-use multiply ())
                          (#pt-succ (#pt-succ #pt-zero))
                          candidate-factor))))
                  introduce
                  (
                    (#pt-succ (#pt-app (#pt-use add ()) first-half second-half))
                    (#pt-app
                      (#pt-use transitivity (0))
                      #pt-nat
                      (#pt-app (#pt-use add ()) first second)
                      (#pt-app
                        (#pt-use add ())
                        (#pt-succ
                          (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) first-half))
                        second)
                      (#pt-app
                        (#pt-use multiply ())
                        (#pt-succ (#pt-succ #pt-zero))
                        (#pt-succ (#pt-app (#pt-use add ()) first-half second-half)))
                      (#pt-app
                        (#pt-use congruence (0 0))
                        #pt-nat
                        #pt-nat
                        (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use add ()) endpoint second))
                        first
                        (#pt-succ
                          (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) first-half))
                        first-equation)
                      (#pt-app
                        (#pt-use transitivity (0))
                        #pt-nat
                        (#pt-app
                          (#pt-use add ())
                          (#pt-succ
                            (#pt-app
                              (#pt-use multiply ())
                              (#pt-succ (#pt-succ #pt-zero))
                              first-half))
                          second)
                        (#pt-app
                          (#pt-use add ())
                          (#pt-succ
                            (#pt-app
                              (#pt-use multiply ())
                              (#pt-succ (#pt-succ #pt-zero))
                              first-half))
                          (#pt-succ
