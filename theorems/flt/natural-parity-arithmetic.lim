      (#pt-app (#pt-use odd-square-sum-residue ()) first second first-odd second-odd))))
(#theorem pythagorean-odd-leg-even-other
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter hypotenuse #pt-nat)
    (#parameter first-odd (#pt-app (#pt-use odd ()) first))
    (#parameter square-equation (#pt-eq #pt-nat (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) first first) (#pt-app (#pt-use multiply ()) second second)) (#pt-app (#pt-use multiply ()) hypotenuse hypotenuse))))
  (#statement (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) second))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) second)
      (#pt-app (#pt-use odd ()) second)
      (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) second)
      (#pt-lambda
        ((second-even (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) second)))
        second-even)
      (#pt-lambda
        ((second-odd (#pt-app (#pt-use odd ()) second)))
        (#pt-app
          (#pt-use false-elimination ())
          (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) second)
          (#pt-app
            (#pt-use odd-squares-not-square ())
            first
            second
            hypotenuse
            first-odd
            second-odd
            square-equation)))
      (#pt-app (#pt-use even-or-odd ()) second))))
(#theorem pythagorean-odd-leg-odd-hypotenuse
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter hypotenuse #pt-nat)
    (#parameter first-odd (#pt-app (#pt-use odd ()) first))
    (#parameter square-equation (#pt-eq #pt-nat (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) first first) (#pt-app (#pt-use multiply ()) second second)) (#pt-app (#pt-use multiply ()) hypotenuse hypotenuse))))
  (#statement (#pt-app (#pt-use odd ()) hypotenuse))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) hypotenuse)
      (#pt-app (#pt-use odd ()) hypotenuse)
      (#pt-app (#pt-use odd ()) hypotenuse)
      (#pt-lambda
        ((hypotenuse-even (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) hypotenuse)))
        (#pt-app
          (#pt-use false-elimination ())
          (#pt-app (#pt-use odd ()) hypotenuse)
          (#pt-app
            (#pt-use odd-even-exclusion ())
            first
            first-odd
            (#pt-app
              (#pt-use prime-divides-square ())
              (#pt-succ (#pt-succ #pt-zero))
              first
              (#pt-use prime-two ())
              (#pt-app
                (#pt-use divides-add-cancel-left ())
                (#pt-succ (#pt-succ #pt-zero))
                (#pt-app (#pt-use multiply ()) second second)
                (#pt-app (#pt-use multiply ()) first first)
                (#pt-app
                  (#pt-use divides-transitive ())
                  (#pt-succ (#pt-succ #pt-zero))
                  second
                  (#pt-app (#pt-use multiply ()) second second)
                  (#pt-app
                    (#pt-use pythagorean-odd-leg-even-other ())
                    first
                    second
                    hypotenuse
                    first-odd
                    square-equation)
                  (#pt-app (#pt-use divides-multiple ()) second second))
                (#pt-app
                  (#pt-use substitution (0))
                  #pt-nat
                  (#pt-lambda
                    ((endpoint #pt-nat))
                    (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) endpoint))
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use multiply ()) first first)
                    (#pt-app (#pt-use multiply ()) second second))
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use multiply ()) second second)
                    (#pt-app (#pt-use multiply ()) first first))
                  (#pt-app
                    (#pt-use add-commutative ())
                    (#pt-app (#pt-use multiply ()) first first)
                    (#pt-app (#pt-use multiply ()) second second))
                  (#pt-app
                    (#pt-use substitution (0))
                    #pt-nat
                    (#pt-lambda
                      ((endpoint #pt-nat))
                      (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) endpoint))
                    (#pt-app (#pt-use multiply ()) hypotenuse hypotenuse)
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use multiply ()) first first)
                      (#pt-app (#pt-use multiply ()) second second))
                    (#pt-app
                      (#pt-use symmetry (0))
                      #pt-nat
                      (#pt-app
                        (#pt-use add ())
                        (#pt-app (#pt-use multiply ()) first first)
                        (#pt-app (#pt-use multiply ()) second second))
                      (#pt-app (#pt-use multiply ()) hypotenuse hypotenuse)
                      square-equation)
                    (#pt-app
                      (#pt-use divides-transitive ())
                      (#pt-succ (#pt-succ #pt-zero))
                      hypotenuse
                      (#pt-app (#pt-use multiply ()) hypotenuse hypotenuse)
                      hypotenuse-even
                      (#pt-app (#pt-use divides-multiple ()) hypotenuse hypotenuse)))))))))
      (#pt-lambda ((hypotenuse-odd (#pt-app (#pt-use odd ()) hypotenuse))) hypotenuse-odd)
      (#pt-app (#pt-use even-or-odd ()) hypotenuse))))
