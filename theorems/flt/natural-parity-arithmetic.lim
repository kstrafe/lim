                            (#pt-app
                              (#pt-use multiply ())
                              (#pt-succ (#pt-succ #pt-zero))
                              second-half))
                          second-equation)
                        (#pt-app (#pt-use two-odd-values-add ()) first-half second-half)))))))
            second-odd)))
      first-odd)))
(#theorem odd-square-sum-residue
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter first-odd (#pt-app (#pt-use odd ()) first))
    (#parameter second-odd (#pt-app (#pt-use odd ()) second)))
  (#statement
    (#pt-app
      (#pt-use exists (0))
