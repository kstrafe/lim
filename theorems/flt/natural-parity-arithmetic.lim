                  #pt-nat
                  second
                  (#pt-succ
                    (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) candidate-half)))))
            (#pt-lambda
              (
                (certificate
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((candidate-half #pt-nat))
                      (#pt-eq
                        #pt-nat
                        second
                        (#pt-succ
                          (#pt-app
                            (#pt-use multiply ())
                            (#pt-succ (#pt-succ #pt-zero))
                            candidate-half)))))))
              (#pt-app
                (#pt-use divides ())
                (#pt-succ (#pt-succ #pt-zero))
                (#pt-app (#pt-use add ()) first second)))
            (
              (#pt-lambda
                (
                  (second-half #pt-nat)
