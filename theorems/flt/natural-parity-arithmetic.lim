(#theorem two-divides-four
  (#universes)
  (#parameters)
  (#statement
    (#pt-app
      (#pt-use divides ())
      (#pt-succ (#pt-succ #pt-zero))
      (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))))
  (#proof
    (#pt-construct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-factor #pt-nat))
          (#pt-eq
            #pt-nat
            (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
            (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) candidate-factor))))
      introduce
      (
        (#pt-succ (#pt-succ #pt-zero))
        (#pt-refl #pt-nat (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero)))))))))
(#theorem four-not-divides-two
  (#universes)
  (#parameters)
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
