                              (#pt-use multiply ())
                              (#pt-succ (#pt-succ #pt-zero))
                              second-half)))
                        (#pt-app
                          (#pt-use multiply ())
                          (#pt-succ (#pt-succ #pt-zero))
                          (#pt-succ (#pt-app (#pt-use add ()) first-half second-half)))
                        (#pt-app
