(#theorem odd-even-exclusion
  (#universes)
  (#parameters
    (#parameter number #pt-nat)
    (#parameter odd-proof (#pt-app (#pt-use odd ()) number))
    (#parameter even-proof (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) number)))
  (#statement #pt-false)
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-half #pt-nat))
          (#pt-eq
            #pt-nat
            number
            (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) candidate-half)))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-half #pt-nat))
                (#pt-eq
                  #pt-nat
                  number
                  (#pt-succ
                    (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) candidate-half)))))))
        #pt-false)
      (
        (#pt-lambda
          (
            (half #pt-nat)
            (half-equation
              (#pt-eq
                #pt-nat
                number
                (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half)))))
          (#pt-app
            (#pt-use two-not-divides-one ())
            (#pt-app
              (#pt-use divides-add-cancel-left ())
              (#pt-succ (#pt-succ #pt-zero))
              (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half)
              (#pt-succ #pt-zero)
              (#pt-app (#pt-use divides-multiple ()) (#pt-succ (#pt-succ #pt-zero)) half)
              (#pt-app
                (#pt-use substitution (0))
                #pt-nat
                (#pt-lambda
                  ((endpoint #pt-nat))
                  (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) endpoint))
                number
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half)
                  (#pt-succ #pt-zero))
                (#pt-app
                  (#pt-use transitivity (0))
                  #pt-nat
                  number
                  (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half))
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half)
                    (#pt-succ #pt-zero))
                  half-equation
                  (#pt-app
                    (#pt-use symmetry (0))
                    #pt-nat
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half)
                      (#pt-succ #pt-zero))
                    (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half))
                    (#pt-app
                      (#pt-use add-one-is-successor ())
                      (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half))))
                even-proof)))))
      odd-proof)))
(#theorem odd-nonzero
  (#universes)
  (#parameters
    (#parameter number #pt-nat)
    (#parameter odd-proof (#pt-app (#pt-use odd ()) number)))
  (#statement (#pt-pi ((denied-proof (#pt-eq #pt-nat number #pt-zero))) #pt-false))
