    (#parameter first-equation (#pt-app (#pt-use finite-weierstrass-equation ()) modulus positive-modulus curve first-x first-y))
    (#parameter second-equation (#pt-app (#pt-use finite-weierstrass-equation ()) modulus positive-modulus curve second-x second-y))
    (#parameter nonvertical (#pt-pi ((denied-evidence (#pt-app (#pt-use conjunction ()) (#pt-eq #pt-nat (#pt-project finite-residue 0 first-x) (#pt-project finite-residue 0 second-x)) (#pt-eq #pt-nat (#pt-project finite-residue 0 first-y) (#pt-project finite-residue 0 (#pt-app (#pt-use finite-weierstrass-neg-y ()) modulus positive-modulus curve second-x second-y)))))) #pt-false))
    (#parameter third-not-first (#pt-pi ((denied-evidence (#pt-eq #pt-nat (#pt-project finite-residue 0 (#pt-app (#pt-use finite-weierstrass-add-x ()) modulus positive-modulus curve first-x second-x (#pt-app (#pt-use finite-weierstrass-slope ()) modulus positive-modulus curve first-x second-x first-y second-y))) (#pt-project finite-residue 0 first-x)))) #pt-false))
    (#parameter third-not-second (#pt-pi ((denied-evidence (#pt-eq #pt-nat (#pt-project finite-residue 0 (#pt-app (#pt-use finite-weierstrass-add-x ()) modulus positive-modulus curve first-x second-x (#pt-app (#pt-use finite-weierstrass-slope ()) modulus positive-modulus curve first-x second-x first-y second-y))) (#pt-project finite-residue 0 second-x)))) #pt-false)))
  (#statement
