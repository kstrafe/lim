; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Right distributivity follows by checked
; product commutativity, left distributivity and sum congruence.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias ring-ideal = ./ring-ideal-data.lim::ring-ideal)
(#alias ring-ideal-equal = ./ring-ideal-data.lim::ring-ideal-equal)
(#alias ring-ideal-equal-transitive = ./ring-ideal-equivalence.lim::ring-ideal-equal-transitive)
(#alias ring-ideal-product = ./ring-ideal-product.lim::ring-ideal-product)
(#alias
  ring-ideal-product-commutative
  =
  ./ring-ideal-product-basic-laws.lim::ring-ideal-product-commutative)
(#alias
  ring-ideal-product-distribute-first
  =
  ./ring-ideal-product-distribute-first.lim::ring-ideal-product-distribute-first)
(#alias ring-ideal-sum = ./ring-ideal-sum.lim::ring-ideal-sum)
(#alias ring-ideal-sum-congruent = ./ring-ideal-operation-congruence.lim::ring-ideal-sum-congruent)
(#theorem ring-ideal-product-distributive
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter third-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        first-ideal
        (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring second-ideal third-ideal))
      (#pt-app
        (#pt-use ring-ideal-sum ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal second-ideal)
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal third-ideal))))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-equal-transitive ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        first-ideal
        (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring second-ideal third-ideal))
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring second-ideal third-ideal)
        first-ideal)
      (#pt-app
        (#pt-use ring-ideal-sum ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal second-ideal)
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal third-ideal))
      (#pt-app
        (#pt-use ring-ideal-product-commutative ())
        Carrier
        coefficient-ring
        first-ideal
        (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring second-ideal third-ideal))
      (#pt-app
        (#pt-use ring-ideal-equal-transitive ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring second-ideal third-ideal)
          first-ideal)
        (#pt-app
          (#pt-use ring-ideal-sum ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-ideal-product ())
            Carrier
            coefficient-ring
            second-ideal
            first-ideal)
          (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring third-ideal first-ideal))
        (#pt-app
          (#pt-use ring-ideal-sum ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-ideal-product ())
            Carrier
            coefficient-ring
            first-ideal
            second-ideal)
          (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal third-ideal))
        (#pt-app
          (#pt-use ring-ideal-product-distribute-first ())
          Carrier
          coefficient-ring
          second-ideal
          third-ideal
          first-ideal)
        (#pt-app
          (#pt-use ring-ideal-sum-congruent ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-ideal-product ())
            Carrier
            coefficient-ring
            second-ideal
            first-ideal)
          (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring third-ideal first-ideal)
          (#pt-app
            (#pt-use ring-ideal-product ())
            Carrier
            coefficient-ring
            first-ideal
            second-ideal)
          (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal third-ideal)
          (#pt-app
            (#pt-use ring-ideal-product-commutative ())
            Carrier
            coefficient-ring
            second-ideal
            first-ideal)
          (#pt-app
            (#pt-use ring-ideal-product-commutative ())
            Carrier
            coefficient-ring
            third-ideal
            first-ideal))))))
