            #pt-nat
            number
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use multiply ()) (#pt-numeral 9) candidate-ninth-quotient)
              remainder))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-ninth-quotient #pt-nat))
                (#pt-eq
                  #pt-nat
                  number
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use multiply ()) (#pt-numeral 9) candidate-ninth-quotient)
                    remainder))))))
        (#pt-eq #pt-nat remainder other-remainder))
      (
        (#pt-lambda
          (
            (quotient #pt-nat)
            (first-equation
              (#pt-eq
                #pt-nat
                number
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 9) quotient)
                  remainder))))
          (#pt-induct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-ninth-quotient #pt-nat))
                (#pt-eq
                  #pt-nat
                  number
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use multiply ()) (#pt-numeral 9) candidate-ninth-quotient)
                    other-remainder))))
            (#pt-lambda
              (
                (certificate
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((candidate-ninth-quotient #pt-nat))
                      (#pt-eq
                        #pt-nat
                        number
                        (#pt-app
                          (#pt-use add ())
                          (#pt-app (#pt-use multiply ()) (#pt-numeral 9) candidate-ninth-quotient)
                          other-remainder))))))
              (#pt-eq #pt-nat remainder other-remainder))
            (
              (#pt-lambda
                (
                  (other-quotient #pt-nat)
                  (second-equation
                    (#pt-eq
                      #pt-nat
                      number
                      (#pt-app
                        (#pt-use add ())
                        (#pt-app (#pt-use multiply ()) (#pt-numeral 9) other-quotient)
                        other-remainder))))
                (#pt-app
                  (#pt-use conjunction-right ())
                  (#pt-eq #pt-nat quotient other-quotient)
                  (#pt-eq #pt-nat remainder other-remainder)
                  (#pt-app
                    (#pt-use division-unique ())
                    number
                    (#pt-numeral 9)
                    quotient
                    remainder
                    other-quotient
                    other-remainder
                    (#pt-app
                      (#pt-use ninth-residue-certificate ())
                      number
                      remainder
                      quotient
                      first-equation
                      first-bound)
                    (#pt-app
                      (#pt-use ninth-residue-certificate ())
                      number
                      other-remainder
                      other-quotient
                      second-equation
                      second-bound)))))
            second-residue)))
      first-residue)))
