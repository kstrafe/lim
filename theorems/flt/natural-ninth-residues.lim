(#theorem ninth-residue-unique
  (#universes)
  (#parameters
    (#parameter number #pt-nat)
    (#parameter remainder #pt-nat)
    (#parameter other-remainder #pt-nat)
    (#parameter first-bound (#pt-app (#pt-use less-than ()) remainder (#pt-numeral 9)))
    (#parameter second-bound (#pt-app (#pt-use less-than ()) other-remainder (#pt-numeral 9)))
