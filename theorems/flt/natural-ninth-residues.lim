(#math-definition ninth-residue ()
  (#pt-pi ((number #pt-nat) (remainder #pt-nat)) #pt-prop)
  (#pt-lambda
    ((number #pt-nat) (remainder #pt-nat))
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-ninth-quotient #pt-nat))
        (#pt-eq
          #pt-nat
          number
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use multiply ()) (#pt-numeral 9) candidate-ninth-quotient)
            remainder))))))
(#math-definition cube ()
  (#pt-pi ((number #pt-nat)) #pt-nat)
  (#pt-lambda
    ((number #pt-nat))
    (#pt-app (#pt-use multiply ()) number (#pt-app (#pt-use multiply ()) number number))))
