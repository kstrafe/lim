    (#parameter second-residue (#pt-app (#pt-use ninth-residue ()) number other-remainder)))
  (#statement (#pt-eq #pt-nat remainder other-remainder))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-ninth-quotient #pt-nat))
