            (#pt-app (#pt-use multiply ()) quotient (#pt-numeral 3))
            remainder))
        (#pt-app (#pt-use less-than ()) remainder (#pt-numeral 3))
        division-proof)
      (#pt-app
        (#pt-use congruence (0 0))
