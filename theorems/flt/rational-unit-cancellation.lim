; Explicit cancellation with an actual inverse, specialized to4 using
; the fraction1/4. No field inverse function or cancellation axiom.
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias rational = ./rational-defs.lim::rational)
(#alias rational-equal = ./rational-defs.lim::rational-equal)
(#alias rational-one = ./rational-defs.lim::rational-one)
(#alias rational-of-integer = ./rational-defs.lim::rational-of-integer)
(#alias rational-multiply = ./rational-defs.lim::rational-multiply)
(#alias successor-not-zero = ./natural-nonzero.lim::successor-not-zero)
(#alias rational-reflexive = ./rational-equality.lim::rational-reflexive)
(#alias rational-symmetric = ./rational-equality.lim::rational-symmetric)
(#alias rational-transitive = ./rational-equality.lim::rational-transitive)
(#alias rational-multiply-congruent = ./rational-congruence.lim::rational-multiply-congruent)
(#alias rational-multiply-associative = ./rational-ring.lim::rational-multiply-associative)
(#alias rational-one-multiply = ./rational-sign-laws.lim::rational-one-multiply)
(#theorem rational-cancel-unit-left
  (#universes)
  (#parameters
    (#parameter unit (#pt-use rational ()))
    (#parameter inverse (#pt-use rational ()))
    (#parameter first (#pt-use rational ()))
    (#parameter second (#pt-use rational ()))
    (#parameter inverse-law (#pt-app (#pt-use rational-equal ()) (#pt-app (#pt-use rational-multiply ()) inverse unit) (#pt-use rational-one ())))
    (#parameter scaled-equation (#pt-app (#pt-use rational-equal ()) (#pt-app (#pt-use rational-multiply ()) unit first) (#pt-app (#pt-use rational-multiply ()) unit second))))
  (#statement (#pt-app (#pt-use rational-equal ()) first second))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      first
      (#pt-app (#pt-use rational-multiply ()) (#pt-use rational-one ()) first)
      second
      (#pt-app
        (#pt-use rational-symmetric ())
        (#pt-app (#pt-use rational-multiply ()) (#pt-use rational-one ()) first)
        first
        (#pt-app (#pt-use rational-one-multiply ()) first))
      (#pt-app
        (#pt-use rational-transitive ())
        (#pt-app (#pt-use rational-multiply ()) (#pt-use rational-one ()) first)
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app (#pt-use rational-multiply ()) inverse unit)
          first)
        second
        (#pt-app
          (#pt-use rational-multiply-congruent ())
          (#pt-use rational-one ())
          first
          (#pt-app (#pt-use rational-multiply ()) inverse unit)
          first
          (#pt-app
            (#pt-use rational-symmetric ())
            (#pt-app (#pt-use rational-multiply ()) inverse unit)
            (#pt-use rational-one ())
            inverse-law)
          (#pt-app (#pt-use rational-reflexive ()) first))
        (#pt-app
          (#pt-use rational-transitive ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app (#pt-use rational-multiply ()) inverse unit)
            first)
          (#pt-app
            (#pt-use rational-multiply ())
            inverse
            (#pt-app (#pt-use rational-multiply ()) unit first))
          second
          (#pt-app (#pt-use rational-multiply-associative ()) inverse unit first)
          (#pt-app
            (#pt-use rational-transitive ())
            (#pt-app
              (#pt-use rational-multiply ())
              inverse
              (#pt-app (#pt-use rational-multiply ()) unit first))
            (#pt-app
              (#pt-use rational-multiply ())
              inverse
              (#pt-app (#pt-use rational-multiply ()) unit second))
            second
            (#pt-app
              (#pt-use rational-multiply-congruent ())
              inverse
              (#pt-app (#pt-use rational-multiply ()) unit first)
              inverse
              (#pt-app (#pt-use rational-multiply ()) unit second)
              (#pt-app (#pt-use rational-reflexive ()) inverse)
              scaled-equation)
            (#pt-app
              (#pt-use rational-transitive ())
              (#pt-app
                (#pt-use rational-multiply ())
                inverse
                (#pt-app (#pt-use rational-multiply ()) unit second))
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app (#pt-use rational-multiply ()) inverse unit)
                second)
              second
              (#pt-app
                (#pt-use rational-symmetric ())
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app (#pt-use rational-multiply ()) inverse unit)
                  second)
                (#pt-app
                  (#pt-use rational-multiply ())
                  inverse
                  (#pt-app (#pt-use rational-multiply ()) unit second))
                (#pt-app (#pt-use rational-multiply-associative ()) inverse unit second))
              (#pt-app
                (#pt-use rational-transitive ())
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app (#pt-use rational-multiply ()) inverse unit)
                  second)
                (#pt-app (#pt-use rational-multiply ()) (#pt-use rational-one ()) second)
                second
                (#pt-app
                  (#pt-use rational-multiply-congruent ())
                  (#pt-app (#pt-use rational-multiply ()) inverse unit)
                  second
                  (#pt-use rational-one ())
                  second
                  inverse-law
                  (#pt-app (#pt-use rational-reflexive ()) second))
                (#pt-app (#pt-use rational-one-multiply ()) second)))))))))
(#theorem rational-cancel-four
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter second (#pt-use rational ()))
    (#parameter scaled-equation (#pt-app (#pt-use rational-equal ()) (#pt-app (#pt-use rational-multiply ()) (#pt-app (#pt-use rational-of-integer ()) (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))) first) (#pt-app (#pt-use rational-multiply ()) (#pt-app (#pt-use rational-of-integer ()) (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))) second))))
  (#statement (#pt-app (#pt-use rational-equal ()) first second))
  (#proof
    (#pt-app
      (#pt-use rational-cancel-unit-left ())
      (#pt-app
        (#pt-use rational-of-integer ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
      (#pt-construct
        rational
        ()
        ()
        fraction
        (
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 1))
          (#pt-numeral 4)
          (#pt-app (#pt-use successor-not-zero ()) (#pt-numeral 3))))
      first
      second
      (#pt-refl #pt-nat (#pt-numeral 4))
      scaled-equation)))
