; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Each input ideal maps into the colon of
; I*K+J*K by a fixed member of K. These checked cuts keep later
; product distributivity within the unchanged per-theorem budget.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias ring-ideal = ./ring-ideal-data.lim::ring-ideal)
(#alias ring-ideal-colon-element = ./ring-ideal-colon-element.lim::ring-ideal-colon-element)
(#alias ring-ideal-member = ./ring-ideal-data.lim::ring-ideal-member)
(#alias ring-ideal-product = ./ring-ideal-product.lim::ring-ideal-product)
(#alias
  ring-ideal-product-to-colon
  =
  ./ring-ideal-colon-factorization.lim::ring-ideal-product-to-colon)
(#alias ring-ideal-subset = ./ring-ideal-data.lim::ring-ideal-subset)
(#alias ring-ideal-sum = ./ring-ideal-sum.lim::ring-ideal-sum)
(#alias ring-ideal-sum-left = ./ring-ideal-sum-universal.lim::ring-ideal-sum-left)
(#alias ring-ideal-sum-right = ./ring-ideal-sum-universal.lim::ring-ideal-sum-right)
(#theorem ring-ideal-product-sum-colon-left
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter third-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter last-factor Carrier)
    (#parameter last-member (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring third-ideal last-factor)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      first-ideal
      (#pt-app
        (#pt-use ring-ideal-colon-element ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-sum ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal third-ideal)
          (#pt-app
            (#pt-use ring-ideal-product ())
            Carrier
            coefficient-ring
            second-ideal
            third-ideal))
        last-factor)))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-product-to-colon ())
      Carrier
      coefficient-ring
      first-ideal
      third-ideal
      (#pt-app
        (#pt-use ring-ideal-sum ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal third-ideal)
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring second-ideal third-ideal))
      (#pt-app
        (#pt-use ring-ideal-sum-left ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal third-ideal)
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring second-ideal third-ideal))
      last-factor
      last-member)))
(#theorem ring-ideal-product-sum-colon-right
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter third-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter last-factor Carrier)
    (#parameter last-member (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring third-ideal last-factor)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      second-ideal
      (#pt-app
        (#pt-use ring-ideal-colon-element ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-sum ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal third-ideal)
          (#pt-app
            (#pt-use ring-ideal-product ())
            Carrier
            coefficient-ring
            second-ideal
            third-ideal))
        last-factor)))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-product-to-colon ())
      Carrier
      coefficient-ring
      second-ideal
      third-ideal
      (#pt-app
        (#pt-use ring-ideal-sum ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal third-ideal)
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring second-ideal third-ideal))
      (#pt-app
        (#pt-use ring-ideal-sum-right ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal third-ideal)
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring second-ideal third-ideal))
      last-factor
      last-member)))
