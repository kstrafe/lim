; Exact square and integer-product formulas for certified fractions.
; Nonzero denominator evidence is retained, with no rational inverse
; or unchecked division operation.
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias congruence = ./equality.lim::congruence)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-power = ./integer-defs.lim::integer-power)
(#alias integer-reflexive = ./integer-equality.lim::integer-reflexive)
(#alias rational = ./rational-defs.lim::rational)
(#alias rational-equal = ./rational-defs.lim::rational-equal)
(#alias rational-of-integer = ./rational-defs.lim::rational-of-integer)
(#alias rational-multiply = ./rational-defs.lim::rational-multiply)
(#alias rational-power = ./rational-defs.lim::rational-power)
(#alias multiply-nonzero = ./natural-nonzero.lim::multiply-nonzero)
(#alias rational-components-congruent = ./rational-congruence.lim::rational-components-congruent)
(#alias multiply-one-right = ./natural-multiplication-right.lim::multiply-one-right)
(#theorem rational-fraction-square
  (#universes)
  (#parameters
    (#parameter numerator (#pt-use integer ()))
    (#parameter denominator #pt-nat)
    (#parameter denominator-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat denominator #pt-zero))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-power ())
        (#pt-construct rational () () fraction (numerator denominator denominator-nonzero))
        (#pt-succ (#pt-succ #pt-zero)))
      (#pt-construct
        rational
        ()
        ()
        fraction
        (
          (#pt-app (#pt-use integer-power ()) numerator (#pt-succ (#pt-succ #pt-zero)))
          (#pt-app (#pt-use multiply ()) denominator denominator)
          (#pt-app
            (#pt-use multiply-nonzero ())
            denominator
            denominator
            denominator-nonzero
            denominator-nonzero)))))
  (#proof
    (#pt-app
      (#pt-use rational-components-congruent ())
      (#pt-app
        (#pt-use rational-power ())
        (#pt-construct rational () () fraction (numerator denominator denominator-nonzero))
        (#pt-succ (#pt-succ #pt-zero)))
      (#pt-construct
        rational
        ()
        ()
        fraction
        (
          (#pt-app (#pt-use integer-power ()) numerator (#pt-succ (#pt-succ #pt-zero)))
          (#pt-app (#pt-use multiply ()) denominator denominator)
          (#pt-app
            (#pt-use multiply-nonzero ())
            denominator
            denominator
            denominator-nonzero
            denominator-nonzero)))
      (#pt-app
        (#pt-use integer-reflexive ())
        (#pt-app (#pt-use integer-power ()) numerator (#pt-succ (#pt-succ #pt-zero))))
      (#pt-app
        (#pt-use congruence (0 0))
        #pt-nat
        #pt-nat
        (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use multiply ()) denominator endpoint))
        (#pt-app (#pt-use multiply ()) denominator (#pt-succ #pt-zero))
        denominator
        (#pt-app (#pt-use multiply-one-right ()) denominator)))))
(#theorem rational-fraction-times-integer
  (#universes)
  (#parameters
    (#parameter numerator (#pt-use integer ()))
    (#parameter denominator #pt-nat)
    (#parameter integer-factor (#pt-use integer ()))
    (#parameter denominator-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat denominator #pt-zero))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-construct rational () () fraction (numerator denominator denominator-nonzero))
        (#pt-app (#pt-use rational-of-integer ()) integer-factor))
      (#pt-construct
        rational
        ()
        ()
        fraction
        (
          (#pt-app (#pt-use integer-multiply ()) numerator integer-factor)
          denominator
          denominator-nonzero))))
  (#proof
    (#pt-app
      (#pt-use rational-components-congruent ())
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-construct rational () () fraction (numerator denominator denominator-nonzero))
        (#pt-app (#pt-use rational-of-integer ()) integer-factor))
      (#pt-construct
        rational
        ()
        ()
        fraction
        (
          (#pt-app (#pt-use integer-multiply ()) numerator integer-factor)
          denominator
          denominator-nonzero))
      (#pt-app
        (#pt-use integer-reflexive ())
        (#pt-app (#pt-use integer-multiply ()) numerator integer-factor))
      (#pt-app (#pt-use multiply-one-right ()) denominator))))
