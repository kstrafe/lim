; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; The whole-ring and zero ideals are the
; actual product identity and zero. An ideal containing one equals
; the whole ring; principal(1) and principal(0) follow without
; invertibility or integral-domain assumptions.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias ring-ideal = ./ring-ideal-data.lim::ring-ideal)
(#alias ring-ideal-bottom = ./ring-ideal-zero-unit.lim::ring-ideal-bottom)
(#alias ring-ideal-bottom-least = ./ring-ideal-zero-unit.lim::ring-ideal-bottom-least)
(#alias ring-ideal-equal = ./ring-ideal-data.lim::ring-ideal-equal)
(#alias ring-ideal-member = ./ring-ideal-data.lim::ring-ideal-member)
(#alias ring-ideal-member-congruent = ./ring-ideal-data.lim::ring-ideal-member-congruent)
(#alias ring-ideal-multiply-left = ./ring-ideal-data.lim::ring-ideal-multiply-left)
(#alias ring-ideal-principal = ./ring-ideal-principal.lim::ring-ideal-principal)
(#alias ring-ideal-principal-generator = ./ring-ideal-principal.lim::ring-ideal-principal-generator)
(#alias
  ring-ideal-principal-least
  =
  ./ring-ideal-principal-universal.lim::ring-ideal-principal-least)
(#alias ring-ideal-product = ./ring-ideal-product.lim::ring-ideal-product)
(#alias ring-ideal-product-introduce = ./ring-ideal-product.lim::ring-ideal-product-introduce)
(#alias
  ring-ideal-product-left-contained
  =
  ./ring-ideal-product-basic-laws.lim::ring-ideal-product-left-contained)
(#alias
  ring-ideal-product-right-contained
  =
  ./ring-ideal-product-basic-laws.lim::ring-ideal-product-right-contained)
(#alias ring-ideal-subset = ./ring-ideal-data.lim::ring-ideal-subset)
(#alias ring-ideal-top = ./ring-ideal-zero-unit.lim::ring-ideal-top)
(#alias ring-ideal-top-greatest = ./ring-ideal-zero-unit.lim::ring-ideal-top-greatest)
(#alias ring-ideal-top-member = ./ring-ideal-zero-unit.lim::ring-ideal-top-member)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-multiply-one = ./commutative-ring-data.lim::ring-multiply-one)
(#alias ring-one = ./commutative-ring-data.lim::ring-one)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#theorem ring-ideal-product-top
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        first-ideal
        (#pt-app (#pt-use ring-ideal-top ()) Carrier coefficient-ring))
      first-ideal))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          first-ideal
          (#pt-app (#pt-use ring-ideal-top ()) Carrier coefficient-ring))
        first-ideal)
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        first-ideal
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          first-ideal
          (#pt-app (#pt-use ring-ideal-top ()) Carrier coefficient-ring)))
      (#pt-app
        (#pt-use ring-ideal-product-left-contained ())
        Carrier
        coefficient-ring
        first-ideal
        (#pt-app (#pt-use ring-ideal-top ()) Carrier coefficient-ring))
      (#pt-lambda
        (
          (first-element Carrier)
          (member
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              first-ideal
              first-element)))
        (#pt-app
          (#pt-use ring-ideal-member-congruent ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-ideal-product ())
            Carrier
            coefficient-ring
            first-ideal
            (#pt-app (#pt-use ring-ideal-top ()) Carrier coefficient-ring))
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            first-element
            (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring))
          first-element
          (#pt-app (#pt-use ring-multiply-one ()) Carrier coefficient-ring first-element)
          (#pt-app
            (#pt-use ring-ideal-product-introduce ())
            Carrier
            coefficient-ring
            first-ideal
            (#pt-app (#pt-use ring-ideal-top ()) Carrier coefficient-ring)
            first-element
            (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
            member
            (#pt-app
              (#pt-use ring-ideal-top-member ())
              Carrier
              coefficient-ring
              (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring))))))))
(#theorem ring-ideal-product-bottom
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        first-ideal
        (#pt-app (#pt-use ring-ideal-bottom ()) Carrier coefficient-ring))
      (#pt-app (#pt-use ring-ideal-bottom ()) Carrier coefficient-ring)))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          first-ideal
          (#pt-app (#pt-use ring-ideal-bottom ()) Carrier coefficient-ring))
        (#pt-app (#pt-use ring-ideal-bottom ()) Carrier coefficient-ring))
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-bottom ()) Carrier coefficient-ring)
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          first-ideal
          (#pt-app (#pt-use ring-ideal-bottom ()) Carrier coefficient-ring)))
      (#pt-app
        (#pt-use ring-ideal-product-right-contained ())
        Carrier
        coefficient-ring
        first-ideal
        (#pt-app (#pt-use ring-ideal-bottom ()) Carrier coefficient-ring))
      (#pt-app
        (#pt-use ring-ideal-bottom-least ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          first-ideal
          (#pt-app (#pt-use ring-ideal-bottom ()) Carrier coefficient-ring))))))
(#theorem ring-ideal-containing-one
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter one-member (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring first-ideal (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring))))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      first-ideal
      (#pt-app (#pt-use ring-ideal-top ()) Carrier coefficient-ring)))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        first-ideal
        (#pt-app (#pt-use ring-ideal-top ()) Carrier coefficient-ring))
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-top ()) Carrier coefficient-ring)
        first-ideal)
      (#pt-app (#pt-use ring-ideal-top-greatest ()) Carrier coefficient-ring first-ideal)
      (#pt-lambda
        (
          (first-element Carrier)
          (whole-member
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              (#pt-app (#pt-use ring-ideal-top ()) Carrier coefficient-ring)
              first-element)))
        (#pt-app
          (#pt-use ring-ideal-member-congruent ())
          Carrier
          coefficient-ring
          first-ideal
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            first-element
            (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring))
          first-element
          (#pt-app (#pt-use ring-multiply-one ()) Carrier coefficient-ring first-element)
          (#pt-app
            (#pt-use ring-ideal-multiply-left ())
            Carrier
            coefficient-ring
            first-ideal
            first-element
            (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
            one-member))))))
(#theorem ring-ideal-principal-one
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-ideal-principal ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring))
      (#pt-app (#pt-use ring-ideal-top ()) Carrier coefficient-ring)))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-containing-one ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-ideal-principal ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring))
      (#pt-app
        (#pt-use ring-ideal-principal-generator ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)))))
(#theorem ring-ideal-principal-zero
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-ideal-principal ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
      (#pt-app (#pt-use ring-ideal-bottom ()) Carrier coefficient-ring)))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-principal ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
        (#pt-app (#pt-use ring-ideal-bottom ()) Carrier coefficient-ring))
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-bottom ()) Carrier coefficient-ring)
        (#pt-app
          (#pt-use ring-ideal-principal ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
      (#pt-app
        (#pt-use ring-ideal-principal-least ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
        (#pt-app (#pt-use ring-ideal-bottom ()) Carrier coefficient-ring)
        (#pt-app
          (#pt-use ring-reflexive ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
      (#pt-app
        (#pt-use ring-ideal-bottom-least ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-principal ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))))
