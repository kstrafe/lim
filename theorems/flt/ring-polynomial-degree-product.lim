; and Degree/Operations.lean; Affine/Point.lean.
; Generated by scripts/generate-flt-polynomial-degrees.py; checked native terms.
; The checked highest-coefficient identity and actual
; coefficient-domain nonzero-product proof establish degree(p*q)=dp+dq.
; Both degrees may be0; no characteristic restriction is added.
(#alias add = ./../fermat_statement.lim::add)
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-polynomial-coefficient = ./ring-polynomial-data.lim::ring-polynomial-coefficient)
(#alias
  ring-polynomial-degree-witness
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-degree-witness)
(#alias
  ring-polynomial-domain-data
  =
  ./ring-polynomial-domain-data.lim::ring-polynomial-domain-data)
(#alias
  ring-polynomial-domain-product-nonzero
  =
  ./ring-polynomial-domain-data.lim::ring-polynomial-domain-product-nonzero)
(#alias ring-polynomial-multiply = ./ring-polynomial-data.lim::ring-polynomial-multiply)
(#alias
  ring-polynomial-product-top
  =
  ./ring-polynomial-product-top.lim::ring-polynomial-product-top)
(#alias
  ring-polynomial-support-from
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-support-from)
(#alias ring-symmetric = ./commutative-ring-data.lim::ring-symmetric)
(#alias ring-transitive = ./commutative-ring-data.lim::ring-transitive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#theorem ring-polynomial-degree-product
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter first-degree #pt-nat)
    (#parameter second-degree #pt-nat)
    (#parameter first-degree-certificate (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring polynomial first-degree))
    (#parameter second-degree-certificate (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring other-polynomial second-degree)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-degree-witness ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-multiply ())
        Carrier
        coefficient-ring
        polynomial
        other-polynomial)
      (#pt-app (#pt-use add ()) first-degree second-degree)))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-pi
        (
          (denied-evidence
            (#pt-app
              (#pt-use ring-equal ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-coefficient ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-polynomial-multiply ())
                  Carrier
                  coefficient-ring
                  polynomial
                  other-polynomial)
                (#pt-app (#pt-use add ()) first-degree second-degree))
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
        #pt-false)
      (#pt-app
        (#pt-use ring-polynomial-support-from ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-multiply ())
          Carrier
          coefficient-ring
          polynomial
          other-polynomial)
        (#pt-succ (#pt-app (#pt-use add ()) first-degree second-degree)))
      (#pt-lambda
        (
          (zero-leading-product
            (#pt-app
              (#pt-use ring-equal ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-coefficient ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-polynomial-multiply ())
                  Carrier
                  coefficient-ring
                  polynomial
                  other-polynomial)
                (#pt-app (#pt-use add ()) first-degree second-degree))
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
        (#pt-app
          (#pt-app
            (#pt-use ring-polynomial-domain-product-nonzero ())
            Carrier
            coefficient-ring
            coefficient-domain
            (#pt-app
              (#pt-use ring-polynomial-coefficient ())
              Carrier
              coefficient-ring
              polynomial
              first-degree)
            (#pt-app
              (#pt-use ring-polynomial-coefficient ())
              Carrier
              coefficient-ring
              other-polynomial
              second-degree)
            (#pt-project conjunction 0 first-degree-certificate)
            (#pt-project conjunction 0 second-degree-certificate))
          (#pt-app
            (#pt-use ring-transitive ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-coefficient ())
                Carrier
                coefficient-ring
                polynomial
                first-degree)
              (#pt-app
                (#pt-use ring-polynomial-coefficient ())
                Carrier
                coefficient-ring
                other-polynomial
                second-degree))
            (#pt-app
              (#pt-use ring-polynomial-coefficient ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-multiply ())
                Carrier
                coefficient-ring
                polynomial
                other-polynomial)
              (#pt-app (#pt-use add ()) first-degree second-degree))
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
            (#pt-app
              (#pt-use ring-symmetric ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-coefficient ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-polynomial-multiply ())
                  Carrier
                  coefficient-ring
                  polynomial
                  other-polynomial)
                (#pt-app (#pt-use add ()) first-degree second-degree))
              (#pt-app
                (#pt-use ring-multiply ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-polynomial-coefficient ())
                  Carrier
                  coefficient-ring
                  polynomial
                  first-degree)
                (#pt-app
                  (#pt-use ring-polynomial-coefficient ())
                  Carrier
                  coefficient-ring
                  other-polynomial
                  second-degree))
              (#pt-project
                conjunction
                1
                (#pt-app
                  (#pt-use ring-polynomial-product-top ())
                  Carrier
                  coefficient-ring
                  polynomial
                  other-polynomial
                  first-degree
                  second-degree
                  (#pt-project conjunction 1 first-degree-certificate)
                  (#pt-project conjunction 1 second-degree-certificate))))
            zero-leading-product)))
      (#pt-project
        conjunction
        0
        (#pt-app
          (#pt-use ring-polynomial-product-top ())
          Carrier
          coefficient-ring
          polynomial
          other-polynomial
          first-degree
          second-degree
          (#pt-project conjunction 1 first-degree-certificate)
          (#pt-project conjunction 1 second-degree-certificate))))))
