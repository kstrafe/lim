                          (#pt-use integer-transitive ())
                          value
                          (#pt-app
                            (#pt-use integer-add ())
                            (#pt-app (#pt-use integer-multiply ()) left-coefficient first)
                            (#pt-app (#pt-use integer-multiply ()) right-coefficient second))
                          (#pt-app
                            (#pt-use integer-add ())
                            (#pt-app
                              (#pt-use integer-multiply ())
                              (#pt-app (#pt-use integer-negate ()) left-coefficient)
