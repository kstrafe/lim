                  (
                    (#pt-use integer ())
                    (#pt-lambda
                      ((candidate-left (#pt-use integer ())))
                      (#pt-app
                        (#pt-use exists (0))
                        (#pt-use integer ())
                        (#pt-lambda
                          ((candidate-right (#pt-use integer ())))
                          (#pt-app
                            (#pt-use integer-bezout-equation ())
                            (#pt-app (#pt-use integer-negate ()) first)
                            second
                            value
                            candidate-left
                            candidate-right)))))
                  introduce
                  (
                    (#pt-app (#pt-use integer-negate ()) left-coefficient)
                    (#pt-construct
                      exists
                      (0)
                      (
                        (#pt-use integer ())
                        (#pt-lambda
                          ((candidate-right (#pt-use integer ())))
                          (#pt-app
                            (#pt-use integer-bezout-equation ())
                            (#pt-app (#pt-use integer-negate ()) first)
                            second
                            value
