                                (#pt-app (#pt-use integer-negate ()) second))
                              (#pt-app (#pt-use integer-multiply ()) left-coefficient first)
                              (#pt-app (#pt-use integer-multiply ()) right-coefficient second)
                              (#pt-app
                                (#pt-use integer-reflexive ())
                                (#pt-app (#pt-use integer-multiply ()) left-coefficient first))
                              (#pt-app
                                (#pt-use integer-multiply-two-negatives ())
                                right-coefficient
                                second))))))))))
