  (#statement
    (#pt-app
      (#pt-use finite-weierstrass-nonsingular ())
      modulus
      positive-modulus
      curve
      target-x
      target-y))
  (#proof
    (#pt-app
      (#pt-use substitution (0))
      (#pt-app (#pt-use finite-residue ()) modulus)
      (#pt-lambda
        ((transport-y (#pt-app (#pt-use finite-residue ()) modulus)))
        (#pt-app
          (#pt-use finite-weierstrass-nonsingular ())
          modulus
          positive-modulus
          curve
          target-x
          transport-y))
      source-y
      target-y
      (#pt-app
        (#pt-use finite-residue-extensional ())
        modulus
        positive-modulus
        source-y
        target-y
        y-equation)
      (#pt-app
        (#pt-use substitution (0))
        (#pt-app (#pt-use finite-residue ()) modulus)
        (#pt-lambda
          ((transport-x (#pt-app (#pt-use finite-residue ()) modulus)))
          (#pt-app
            (#pt-use finite-weierstrass-nonsingular ())
            modulus
            positive-modulus
            curve
            transport-x
            source-y))
        source-x
        target-x
        (#pt-app
          (#pt-use finite-residue-extensional ())
          modulus
          positive-modulus
          source-x
          target-x
          x-equation)
        source-nonsingular))))
