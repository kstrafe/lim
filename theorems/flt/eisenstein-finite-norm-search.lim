      (#pt-app (#pt-use eisenstein-norm-property-exists ()) property natural-norm)
      (#pt-pi
        (
          (denied-proof
            (#pt-app (#pt-use eisenstein-norm-property-exists ()) property natural-norm)))
        #pt-false)))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use eisenstein-coordinate-property-search ()) property natural-norm)
      (#pt-pi
