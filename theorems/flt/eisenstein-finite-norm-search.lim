                  (#pt-use eisenstein-norm-property ())
                  property
                  candidate-value
                  natural-norm)))))
        (#pt-app (#pt-use eisenstein-coordinate-property-search ()) property natural-norm))
      (
        (#pt-lambda
          (
            (number (#pt-use eisenstein ()))
            (property-certificate
              (#pt-app (#pt-use eisenstein-norm-property ()) property number natural-norm)))
          (#pt-induct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-real-magnitude #pt-nat))
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((candidate-omega-magnitude #pt-nat))
                    (#pt-app
                      (#pt-use eisenstein-coordinate-box-witness ())
                      number
                      natural-norm
                      candidate-real-magnitude
                      candidate-omega-magnitude)))))
            (#pt-lambda
              (
                (certificate
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((candidate-real-magnitude #pt-nat))
                      (#pt-app
                        (#pt-use exists (0))
                        #pt-nat
                        (#pt-lambda
                          ((candidate-omega-magnitude #pt-nat))
                          (#pt-app
                            (#pt-use eisenstein-coordinate-box-witness ())
                            number
                            natural-norm
                            candidate-real-magnitude
                            candidate-omega-magnitude)))))))
              (#pt-app (#pt-use eisenstein-coordinate-property-search ()) property natural-norm))
            (
              (#pt-lambda
                (
                  (real-magnitude #pt-nat)
                  (omega-existence
                    (#pt-app
                      (#pt-use exists (0))
                      #pt-nat
                      (#pt-lambda
                        ((candidate-omega-magnitude #pt-nat))
                        (#pt-app
                          (#pt-use eisenstein-coordinate-box-witness ())
                          number
                          natural-norm
