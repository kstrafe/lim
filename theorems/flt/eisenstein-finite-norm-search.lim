        (
          (denied-proof
            (#pt-app (#pt-use eisenstein-norm-property ()) property number natural-norm)))
        #pt-false)))
  (#proof
    (#pt-app
      (#pt-use proposition-conjunction-cases ())
      (#pt-app property number)
      (#pt-app (#pt-use eisenstein-natural-norm ()) number natural-norm)
