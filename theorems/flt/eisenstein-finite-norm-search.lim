(#theorem eisenstein-box-property-search
  (#universes)
  (#parameters
    (#parameter property (#pt-pi ((predicate-value (#pt-use eisenstein ()))) #pt-prop))
    (#parameter natural-norm #pt-nat)
    (#parameter number (#pt-use eisenstein ()))
    (#parameter real-magnitude #pt-nat)
    (#parameter omega-magnitude #pt-nat)
    (#parameter equivalence-preserves-property (#pt-pi ((source-value (#pt-use eisenstein ())) (target-value (#pt-use eisenstein ())) (value-equivalence (#pt-app (#pt-use eisenstein-equal ()) source-value target-value)) (source-evidence (#pt-app property source-value))) (#pt-app property target-value)))
    (#parameter property-certificate (#pt-app (#pt-use eisenstein-norm-property ()) property number natural-norm))
    (#parameter box-certificate (#pt-app (#pt-use eisenstein-coordinate-box-witness ()) number natural-norm real-magnitude omega-magnitude)))
  (#statement (#pt-app (#pt-use eisenstein-coordinate-property-search ()) property natural-norm))
  (#proof
    (#pt-app
      (#pt-use any-up-to-from-less-successor ())
      (#pt-lambda
        ((candidate-real-magnitude #pt-nat))
        (#pt-app
          (#pt-use any-up-to ())
          (#pt-lambda
            ((candidate-omega-magnitude #pt-nat))
            (#pt-app
              (#pt-use eisenstein-signed-property-choices ())
              property
              natural-norm
              candidate-real-magnitude
              candidate-omega-magnitude))
          (#pt-app (#pt-use multiply ()) (#pt-numeral 4) natural-norm)))
      real-magnitude
      (#pt-app (#pt-use multiply ()) (#pt-numeral 4) natural-norm)
      (#pt-app
        (#pt-use conjunction-left ())
        (#pt-app
          (#pt-use less-than ())
          real-magnitude
          (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 4) natural-norm)))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app
            (#pt-use less-than ())
            omega-magnitude
            (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 4) natural-norm)))
          (#pt-app
            (#pt-use eisenstein-coordinate-representatives ())
            number
            real-magnitude
            omega-magnitude))
        box-certificate)
      (#pt-app
        (#pt-use any-up-to-from-less-successor ())
        (#pt-lambda
          ((candidate-omega-magnitude #pt-nat))
          (#pt-app
            (#pt-use eisenstein-signed-property-choices ())
            property
            natural-norm
            real-magnitude
            candidate-omega-magnitude))
        omega-magnitude
        (#pt-app (#pt-use multiply ()) (#pt-numeral 4) natural-norm)
        (#pt-app
          (#pt-use conjunction-left ())
          (#pt-app
            (#pt-use less-than ())
            omega-magnitude
            (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 4) natural-norm)))
          (#pt-app
            (#pt-use eisenstein-coordinate-representatives ())
            number
            real-magnitude
            omega-magnitude)
          (#pt-app
            (#pt-use conjunction-right ())
            (#pt-app
              (#pt-use less-than ())
              real-magnitude
              (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 4) natural-norm)))
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app
                (#pt-use less-than ())
                omega-magnitude
                (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 4) natural-norm)))
              (#pt-app
                (#pt-use eisenstein-coordinate-representatives ())
                number
                real-magnitude
                omega-magnitude))
            box-certificate))
        (#pt-app
          (#pt-use eisenstein-representative-property-choices ())
          property
          natural-norm
          number
          real-magnitude
          omega-magnitude
          equivalence-preserves-property
          property-certificate
          (#pt-app
            (#pt-use conjunction-right ())
            (#pt-app
              (#pt-use less-than ())
              omega-magnitude
              (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 4) natural-norm)))
            (#pt-app
              (#pt-use eisenstein-coordinate-representatives ())
              number
              real-magnitude
              omega-magnitude)
            (#pt-app
              (#pt-use conjunction-right ())
              (#pt-app
                (#pt-use less-than ())
                real-magnitude
                (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 4) natural-norm)))
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app
                  (#pt-use less-than ())
                  omega-magnitude
                  (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 4) natural-norm)))
                (#pt-app
                  (#pt-use eisenstein-coordinate-representatives ())
                  number
                  real-magnitude
                  omega-magnitude))
              box-certificate)))))))
(#theorem eisenstein-norm-existence-to-search
  (#universes)
  (#parameters
    (#parameter property (#pt-pi ((predicate-value (#pt-use eisenstein ()))) #pt-prop))
    (#parameter natural-norm #pt-nat)
    (#parameter equivalence-preserves-property (#pt-pi ((source-value (#pt-use eisenstein ())) (target-value (#pt-use eisenstein ())) (value-equivalence (#pt-app (#pt-use eisenstein-equal ()) source-value target-value)) (source-evidence (#pt-app property source-value))) (#pt-app property target-value)))
    (#parameter property-existence (#pt-app (#pt-use eisenstein-norm-property-exists ()) property natural-norm)))
  (#statement (#pt-app (#pt-use eisenstein-coordinate-property-search ()) property natural-norm))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-value (#pt-use eisenstein ())))
          (#pt-app (#pt-use eisenstein-norm-property ()) property candidate-value natural-norm)))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-value (#pt-use eisenstein ())))
