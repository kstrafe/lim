(#math-definition eisenstein-norm-property ()
  (#pt-pi
    (
      (property (#pt-pi ((predicate-value (#pt-use eisenstein ()))) #pt-prop))
      (number (#pt-use eisenstein ()))
      (natural-norm #pt-nat))
    #pt-prop)
  (#pt-lambda
    (
      (property (#pt-pi ((predicate-value (#pt-use eisenstein ()))) #pt-prop))
      (number (#pt-use eisenstein ()))
      (natural-norm #pt-nat))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app property number)
      (#pt-app (#pt-use eisenstein-natural-norm ()) number natural-norm))))
