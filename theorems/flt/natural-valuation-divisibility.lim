; Native arithmetic behind the next two FLT source solutions.
; Retain the explicit double-coordinate divisor witness. A prime
; other than two cannot divide eight, so it cannot divide k when
; k+8=2*p*l. The actual above-four bound proves the required p!=2.
(#alias add = ./../fermat_statement.lim::add)
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias less-than-transitive = ./natural-order.lim::less-than-transitive)
(#alias prime = ./natural-prime.lim::prime)
(#alias prime-not-one = ./natural-prime-divisibility.lim::prime-not-one)
(#alias multiply-associative = ./natural-multiplication.lim::multiply-associative)
(#alias multiply-left-commutative = ./natural-square-arithmetic.lim::multiply-left-commutative)
(#alias prime-divisor-one-or-self = ./natural-prime-divisibility.lim::prime-divisor-one-or-self)
(#alias prime-divides-power = ./natural-prime-divisibility.lim::prime-divides-power)
(#alias prime-two = ./natural-prime-two.lim::prime-two)
(#alias divides-add-cancel-left = ./natural-divisibility-addition.lim::divides-add-cancel-left)
(#alias not-less-than-self = ./natural-order.lim::not-less-than-self)
(#theorem natural-exponent-divides-doubled-value
  (#universes)
  (#parameters
    (#parameter exponent #pt-nat)
    (#parameter coordinate-valuation #pt-nat))
  (#statement
    (#pt-app
      (#pt-use divides ())
      exponent
      (#pt-app
        (#pt-use multiply ())
        (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent)
        coordinate-valuation)))
  (#proof
    (#pt-construct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-factor #pt-nat))
          (#pt-eq
            #pt-nat
            (#pt-app
              (#pt-use multiply ())
              (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent)
              coordinate-valuation)
            (#pt-app (#pt-use multiply ()) exponent candidate-factor))))
      introduce
      (
        (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) coordinate-valuation)
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          (#pt-app
            (#pt-use multiply ())
            (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent)
            coordinate-valuation)
          (#pt-app
            (#pt-use multiply ())
            (#pt-succ (#pt-succ #pt-zero))
            (#pt-app (#pt-use multiply ()) exponent coordinate-valuation))
          (#pt-app
            (#pt-use multiply ())
            exponent
            (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) coordinate-valuation))
          (#pt-app
            (#pt-use multiply-associative ())
            (#pt-succ (#pt-succ #pt-zero))
            exponent
            coordinate-valuation)
          (#pt-app
            (#pt-use multiply-left-commutative ())
            (#pt-succ (#pt-succ #pt-zero))
            exponent
            coordinate-valuation))))))
(#theorem natural-above-four-not-two
  (#universes)
  (#parameters
    (#parameter exponent #pt-nat)
    (#parameter above-four (#pt-app (#pt-use less-than ()) (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero)))) exponent)))
  (#statement
    (#pt-pi ((denied-proof (#pt-eq #pt-nat exponent (#pt-succ (#pt-succ #pt-zero))))) #pt-false))
  (#proof
    (#pt-lambda
      ((two-equation (#pt-eq #pt-nat exponent (#pt-succ (#pt-succ #pt-zero)))))
      (#pt-app
        (#pt-app (#pt-use not-less-than-self ()) (#pt-succ (#pt-succ #pt-zero)))
        (#pt-eq-elim
          #pt-nat
          exponent
          (#pt-lambda
            ((transport-index #pt-nat) (transport-path (#pt-eq #pt-nat exponent transport-index)))
            (#pt-app (#pt-use less-than ()) (#pt-succ (#pt-succ #pt-zero)) transport-index))
          (#pt-app
            (#pt-use less-than-transitive ())
            (#pt-succ (#pt-succ #pt-zero))
            (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
            exponent
            (#pt-construct
              exists
              (0)
              (#pt-nat
                (#pt-lambda
                  ((candidate-gap #pt-nat))
                  (#pt-eq
                    #pt-nat
                    (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
                    (#pt-app
                      (#pt-use add ())
                      (#pt-succ (#pt-succ (#pt-succ #pt-zero)))
                      candidate-gap))))
              introduce
              (
                (#pt-succ #pt-zero)
                (#pt-refl #pt-nat (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero)))))))
            above-four)
          (#pt-succ (#pt-succ #pt-zero))
          two-equation)))))
(#theorem natural-prime-divides-two-only-two
  (#universes)
  (#parameters
    (#parameter exponent #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) exponent))
    (#parameter two-divides (#pt-app (#pt-use divides ()) exponent (#pt-succ (#pt-succ #pt-zero)))))
  (#statement (#pt-eq #pt-nat exponent (#pt-succ (#pt-succ #pt-zero))))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-eq #pt-nat exponent (#pt-succ #pt-zero))
      (#pt-eq #pt-nat exponent (#pt-succ (#pt-succ #pt-zero)))
      (#pt-eq #pt-nat exponent (#pt-succ (#pt-succ #pt-zero)))
      (#pt-lambda
        ((one-equation (#pt-eq #pt-nat exponent (#pt-succ #pt-zero))))
        (#pt-app
          (#pt-use false-elimination ())
          (#pt-eq #pt-nat exponent (#pt-succ (#pt-succ #pt-zero)))
          (#pt-app (#pt-app (#pt-use prime-not-one ()) exponent prime-proof) one-equation)))
      (#pt-lambda
        ((two-equation (#pt-eq #pt-nat exponent (#pt-succ (#pt-succ #pt-zero)))))
        two-equation)
      (#pt-app
        (#pt-use prime-divisor-one-or-self ())
        (#pt-succ (#pt-succ #pt-zero))
        exponent
        (#pt-use prime-two ())
        two-divides))))
(#theorem natural-prime-away-two-not-divides-eight
  (#universes)
  (#parameters
    (#parameter exponent #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) exponent))
    (#parameter not-two (#pt-pi ((denied-proof (#pt-eq #pt-nat exponent (#pt-succ (#pt-succ #pt-zero))))) #pt-false)))
  (#statement
    (#pt-pi ((denied-proof (#pt-app (#pt-use divides ()) exponent (#pt-numeral 8)))) #pt-false))
  (#proof
    (#pt-lambda
      ((eight-divides (#pt-app (#pt-use divides ()) exponent (#pt-numeral 8))))
      (#pt-app
        not-two
        (#pt-app
          (#pt-use natural-prime-divides-two-only-two ())
          exponent
          prime-proof
          (#pt-app
            (#pt-use prime-divides-power ())
            exponent
            (#pt-succ (#pt-succ #pt-zero))
            (#pt-numeral 3)
            prime-proof
            eight-divides))))))
(#theorem natural-shifted-valuation-nondivisible
  (#universes)
  (#parameters
    (#parameter exponent #pt-nat)
    (#parameter discriminant-valuation #pt-nat)
    (#parameter coordinate-valuation #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) exponent))
    (#parameter not-two (#pt-pi ((denied-proof (#pt-eq #pt-nat exponent (#pt-succ (#pt-succ #pt-zero))))) #pt-false))
    (#parameter valuation-equation (#pt-eq #pt-nat (#pt-app (#pt-use add ()) discriminant-valuation (#pt-numeral 8)) (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent) coordinate-valuation))))
  (#statement
    (#pt-pi
      ((denied-proof (#pt-app (#pt-use divides ()) exponent discriminant-valuation)))
      #pt-false))
  (#proof
    (#pt-lambda
      ((valuation-divides (#pt-app (#pt-use divides ()) exponent discriminant-valuation)))
      (#pt-app
        (#pt-app (#pt-use natural-prime-away-two-not-divides-eight ()) exponent prime-proof not-two)
        (#pt-app
          (#pt-use divides-add-cancel-left ())
          exponent
          discriminant-valuation
          (#pt-numeral 8)
          valuation-divides
          (#pt-eq-elim
            #pt-nat
            (#pt-app
              (#pt-use multiply ())
              (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent)
              coordinate-valuation)
            (#pt-lambda
              (
                (transport-index #pt-nat)
                (transport-path
                  (#pt-eq
                    #pt-nat
                    (#pt-app
                      (#pt-use multiply ())
                      (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent)
                      coordinate-valuation)
                    transport-index)))
              (#pt-app (#pt-use divides ()) exponent transport-index))
            (#pt-app
              (#pt-use natural-exponent-divides-doubled-value ())
              exponent
              coordinate-valuation)
            (#pt-app (#pt-use add ()) discriminant-valuation (#pt-numeral 8))
            (#pt-app
              (#pt-use symmetry (0))
              #pt-nat
              (#pt-app (#pt-use add ()) discriminant-valuation (#pt-numeral 8))
              (#pt-app
                (#pt-use multiply ())
                (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent)
                coordinate-valuation)
              valuation-equation)))))))
(#theorem natural-shifted-valuation-nondivisible-above-four
  (#universes)
  (#parameters
    (#parameter exponent #pt-nat)
    (#parameter discriminant-valuation #pt-nat)
    (#parameter coordinate-valuation #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) exponent))
    (#parameter above-four (#pt-app (#pt-use less-than ()) (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero)))) exponent))
    (#parameter valuation-equation (#pt-eq #pt-nat (#pt-app (#pt-use add ()) discriminant-valuation (#pt-numeral 8)) (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent) coordinate-valuation))))
  (#statement
    (#pt-pi
      ((denied-proof (#pt-app (#pt-use divides ()) exponent discriminant-valuation)))
      #pt-false))
  (#proof
    (#pt-app
      (#pt-use natural-shifted-valuation-nondivisible ())
      exponent
      discriminant-valuation
      coordinate-valuation
      prime-proof
      (#pt-app (#pt-use natural-above-four-not-two ()) exponent above-four)
      valuation-equation)))
