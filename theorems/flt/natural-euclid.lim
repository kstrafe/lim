; Euclid cancellation and closure of natural coprimality under products/powers.
; Gcd scaling supplies cancellation constructively, without assuming unique factorization.
; The square-sum results are natural-number counterparts of the two Int lemmas
; in Mathlib/NumberTheory/FLT/Four.lean:141-148.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias power = ../fermat_statement.lim::power)
(#alias exists = ./logic-exists.lim::exists)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias divides-reflexive = ./natural-divisibility.lim::divides-reflexive)
(#alias divides-multiple = ./natural-divisibility.lim::divides-multiple)
(#alias divides-transitive = ./natural-divisibility.lim::divides-transitive)
(#alias divides-add-cancel-left = ./natural-divisibility-addition.lim::divides-add-cancel-left)
(#alias multiply-one-left = ./natural-multiplication.lim::multiply-one-left)
(#alias add-commutative = ./natural-addition.lim::add-commutative)
(#alias gcd-spec = ./natural-gcd.lim::gcd-spec)
(#alias has-gcd = ./natural-gcd.lim::has-gcd)
(#alias gcd-exists = ./natural-gcd.lim::gcd-exists)
(#alias gcd-scale-right = ./natural-gcd-scaling.lim::gcd-scale-right)
(#alias gcd-one-of-coprime = ./natural-coprime.lim::gcd-one-of-coprime)
(#alias coprime = ./natural-coprime.lim::coprime)
(#alias coprime-symmetric = ./natural-coprime.lim::coprime-symmetric)
(#alias coprime-one-left = ./natural-coprime.lim::coprime-one-left)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias substitution = ./equality.lim::substitution)
(#theorem coprime-gcd-one
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter coprime-proof (#pt-app (#pt-use coprime ()) first second)))
  (#statement (#pt-app (#pt-use gcd-spec ()) first second (#pt-succ #pt-zero)))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-gcd #pt-nat))
          (#pt-app (#pt-use gcd-spec ()) first second candidate-gcd)))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-gcd #pt-nat))
                (#pt-app (#pt-use gcd-spec ()) first second candidate-gcd)))))
        (#pt-app (#pt-use gcd-spec ()) first second (#pt-succ #pt-zero)))
      (
        (#pt-lambda
          (
            (greatest-divisor #pt-nat)
            (gcd-proof (#pt-app (#pt-use gcd-spec ()) first second greatest-divisor)))
          (#pt-app
            (#pt-use substitution (0))
            #pt-nat
            (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use gcd-spec ()) first second endpoint))
            greatest-divisor
            (#pt-succ #pt-zero)
            (#pt-app
              (#pt-use gcd-one-of-coprime ())
              first
              second
              greatest-divisor
              gcd-proof
              coprime-proof)
            gcd-proof)))
      (#pt-app (#pt-use gcd-exists ()) first second))))
(#theorem coprime-divides-product-left
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter factor #pt-nat)
    (#parameter coprime-proof (#pt-app (#pt-use coprime ()) first second))
    (#parameter product-divides (#pt-app (#pt-use divides ()) first (#pt-app (#pt-use multiply ()) second factor))))
  (#statement (#pt-app (#pt-use divides ()) first factor))
  (#proof
    (#pt-app
      (#pt-use substitution (0))
      #pt-nat
      (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use divides ()) first endpoint))
      (#pt-app (#pt-use multiply ()) (#pt-succ #pt-zero) factor)
      factor
      (#pt-app (#pt-use multiply-one-left ()) factor)
      (#pt-app
        (#pt-app
          (#pt-use conjunction-right ())
          (#pt-app
            (#pt-use divides ())
            (#pt-app (#pt-use multiply ()) (#pt-succ #pt-zero) factor)
            (#pt-app (#pt-use multiply ()) second factor))
          (#pt-pi
            (
              (candidate-common #pt-nat)
              (candidate-first
                (#pt-app
                  (#pt-use divides ())
                  candidate-common
                  (#pt-app (#pt-use multiply ()) first factor)))
              (candidate-second
                (#pt-app
                  (#pt-use divides ())
                  candidate-common
                  (#pt-app (#pt-use multiply ()) second factor))))
            (#pt-app
              (#pt-use divides ())
              candidate-common
              (#pt-app (#pt-use multiply ()) (#pt-succ #pt-zero) factor)))
          (#pt-app
            (#pt-use conjunction-right ())
            (#pt-app
              (#pt-use divides ())
              (#pt-app (#pt-use multiply ()) (#pt-succ #pt-zero) factor)
              (#pt-app (#pt-use multiply ()) first factor))
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app
                (#pt-use divides ())
                (#pt-app (#pt-use multiply ()) (#pt-succ #pt-zero) factor)
                (#pt-app (#pt-use multiply ()) second factor))
              (#pt-pi
                (
                  (candidate-common #pt-nat)
                  (candidate-first
                    (#pt-app
                      (#pt-use divides ())
                      candidate-common
                      (#pt-app (#pt-use multiply ()) first factor)))
                  (candidate-second
                    (#pt-app
                      (#pt-use divides ())
                      candidate-common
                      (#pt-app (#pt-use multiply ()) second factor))))
                (#pt-app
                  (#pt-use divides ())
                  candidate-common
                  (#pt-app (#pt-use multiply ()) (#pt-succ #pt-zero) factor))))
            (#pt-app
              (#pt-use gcd-scale-right ())
              first
              second
              (#pt-succ #pt-zero)
              factor
              (#pt-app (#pt-use coprime-gcd-one ()) first second coprime-proof))))
        first
        (#pt-app (#pt-use divides-multiple ()) first factor)
        product-divides))))
(#theorem coprime-divisor-right
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter divisor #pt-nat)
    (#parameter coprime-proof (#pt-app (#pt-use coprime ()) first second))
    (#parameter divisor-proof (#pt-app (#pt-use divides ()) divisor second)))
  (#statement (#pt-app (#pt-use coprime ()) first divisor))
  (#proof
    (#pt-lambda
      (
        (common-divisor #pt-nat)
        (first-divides (#pt-app (#pt-use divides ()) common-divisor first))
        (divisor-divides (#pt-app (#pt-use divides ()) common-divisor divisor)))
      (#pt-app
        coprime-proof
        common-divisor
        first-divides
        (#pt-app
          (#pt-use divides-transitive ())
          common-divisor
          divisor
          second
          divisor-divides
          divisor-proof)))))
(#theorem coprime-multiply-left
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter other #pt-nat)
    (#parameter first-coprime (#pt-app (#pt-use coprime ()) first other))
    (#parameter second-coprime (#pt-app (#pt-use coprime ()) second other)))
  (#statement (#pt-app (#pt-use coprime ()) (#pt-app (#pt-use multiply ()) first second) other))
  (#proof
    (#pt-lambda
      (
        (common-divisor #pt-nat)
        (product-divides
          (#pt-app (#pt-use divides ()) common-divisor (#pt-app (#pt-use multiply ()) first second)))
        (other-divides (#pt-app (#pt-use divides ()) common-divisor other)))
      (#pt-app
        second-coprime
        common-divisor
        (#pt-app
          (#pt-use coprime-divides-product-left ())
          common-divisor
          first
          second
          (#pt-app
            (#pt-use coprime-symmetric ())
            first
            common-divisor
            (#pt-app
              (#pt-use coprime-divisor-right ())
              first
              other
              common-divisor
              first-coprime
              other-divides))
          product-divides)
        other-divides))))
(#theorem coprime-multiply-right
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter other #pt-nat)
    (#parameter first-coprime (#pt-app (#pt-use coprime ()) first second))
    (#parameter second-coprime (#pt-app (#pt-use coprime ()) first other)))
  (#statement (#pt-app (#pt-use coprime ()) first (#pt-app (#pt-use multiply ()) second other)))
  (#proof
    (#pt-app
      (#pt-use coprime-symmetric ())
      (#pt-app (#pt-use multiply ()) second other)
      first
      (#pt-app
        (#pt-use coprime-multiply-left ())
        second
        other
        first
        (#pt-app (#pt-use coprime-symmetric ()) first second first-coprime)
        (#pt-app (#pt-use coprime-symmetric ()) first other second-coprime)))))
(#theorem coprime-power-left
  (#universes)
  (#parameters
    (#parameter base #pt-nat)
    (#parameter other #pt-nat)
    (#parameter exponent #pt-nat)
    (#parameter coprime-proof (#pt-app (#pt-use coprime ()) base other)))
  (#statement (#pt-app (#pt-use coprime ()) (#pt-app (#pt-use power ()) base exponent) other))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((index #pt-nat))
        (#pt-app (#pt-use coprime ()) (#pt-app (#pt-use power ()) base index) other))
      (#pt-app (#pt-use coprime-one-left ()) other)
      (#pt-lambda
        (
          (previous #pt-nat)
          (previous-coprime
            (#pt-app (#pt-use coprime ()) (#pt-app (#pt-use power ()) base previous) other)))
        (#pt-app
          (#pt-use coprime-multiply-left ())
          base
          (#pt-app (#pt-use power ()) base previous)
          other
          coprime-proof
          previous-coprime))
      exponent)))
(#theorem coprime-power-right
  (#universes)
  (#parameters
    (#parameter base #pt-nat)
    (#parameter other #pt-nat)
    (#parameter exponent #pt-nat)
    (#parameter coprime-proof (#pt-app (#pt-use coprime ()) base other)))
  (#statement (#pt-app (#pt-use coprime ()) base (#pt-app (#pt-use power ()) other exponent)))
  (#proof
    (#pt-app
      (#pt-use coprime-symmetric ())
      (#pt-app (#pt-use power ()) other exponent)
      base
      (#pt-app
        (#pt-use coprime-power-left ())
        other
        base
        exponent
        (#pt-app (#pt-use coprime-symmetric ()) base other coprime-proof)))))
(#theorem coprime-square-sum
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter coprime-proof (#pt-app (#pt-use coprime ()) second first)))
  (#statement
    (#pt-app
      (#pt-use coprime ())
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use multiply ()) first first)
        (#pt-app (#pt-use multiply ()) second second))
      first))
  (#proof
    (#pt-lambda
      (
        (common-divisor #pt-nat)
        (sum-divides
          (#pt-app
            (#pt-use divides ())
            common-divisor
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use multiply ()) first first)
              (#pt-app (#pt-use multiply ()) second second))))
        (first-divides (#pt-app (#pt-use divides ()) common-divisor first)))
      (#pt-app
        (#pt-app (#pt-use coprime-multiply-left ()) second second first coprime-proof coprime-proof)
        common-divisor
        (#pt-app
          (#pt-use divides-add-cancel-left ())
          common-divisor
          (#pt-app (#pt-use multiply ()) first first)
          (#pt-app (#pt-use multiply ()) second second)
          (#pt-app
            (#pt-use divides-transitive ())
            common-divisor
            first
            (#pt-app (#pt-use multiply ()) first first)
            first-divides
            (#pt-app (#pt-use divides-multiple ()) first first))
          sum-divides)
        first-divides))))
(#theorem coprime-square-sum-product
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter coprime-proof (#pt-app (#pt-use coprime ()) first second)))
  (#statement
    (#pt-app
      (#pt-use coprime ())
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use multiply ()) first first)
        (#pt-app (#pt-use multiply ()) second second))
      (#pt-app (#pt-use multiply ()) first second)))
  (#proof
    (#pt-app
      (#pt-use coprime-multiply-right ())
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use multiply ()) first first)
        (#pt-app (#pt-use multiply ()) second second))
      first
      second
      (#pt-app
        (#pt-use coprime-square-sum ())
        first
        second
        (#pt-app (#pt-use coprime-symmetric ()) first second coprime-proof))
      (#pt-app
        (#pt-use substitution (0))
        #pt-nat
        (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use coprime ()) endpoint second))
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use multiply ()) second second)
          (#pt-app (#pt-use multiply ()) first first))
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use multiply ()) first first)
          (#pt-app (#pt-use multiply ()) second second))
        (#pt-app
          (#pt-use add-commutative ())
          (#pt-app (#pt-use multiply ()) second second)
          (#pt-app (#pt-use multiply ()) first first))
        (#pt-app (#pt-use coprime-square-sum ()) second first coprime-proof)))))
