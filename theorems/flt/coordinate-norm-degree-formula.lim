(#math-definition coordinate-norm-degree-value ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (a1 Carrier)
      (a2 Carrier)
      (a3 Carrier)
      (a4 Carrier)
      (a6 Carrier)
      (polynomial (#pt-app (#pt-use finite-list ()) Carrier))
      (other-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
    (#pt-app (#pt-use finite-list ()) Carrier))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (a1 Carrier)
      (a2 Carrier)
      (a3 Carrier)
      (a4 Carrier)
      (a6 Carrier)
      (polynomial (#pt-app (#pt-use finite-list ()) Carrier))
      (other-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
    (#pt-app
      (#pt-use weierstrass-coordinate-norm ())
      Carrier
      coefficient-ring
      a1
      a2
      a3
      a4
      a6
      (#pt-construct
        quadratic-element
        ()
        ((#pt-app (#pt-use finite-list ()) Carrier))
        coordinates
        (polynomial other-polynomial)))))
