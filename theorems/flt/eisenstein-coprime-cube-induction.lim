(#theorem eisenstein-coprime-cube-induction-step
  (#universes)
  (#parameters
    (#parameter natural-norm #pt-nat)
    (#parameter given-history (#pt-pi ((earlier-norm #pt-nat) (earlier-position (#pt-app (#pt-use less-than ()) earlier-norm natural-norm))) (#pt-app (#pt-use eisenstein-coprime-cube-at-norm ()) earlier-norm))))
