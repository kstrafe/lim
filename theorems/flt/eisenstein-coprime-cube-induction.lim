        (#pt-lambda
          (
            (number-nonzero
              (#pt-pi
                (
                  (denied-proof
                    (#pt-app (#pt-use eisenstein-equal ()) first (#pt-use eisenstein-zero ()))))
                #pt-false)))
          (#pt-app
            (#pt-use disjunction-eliminate ())
