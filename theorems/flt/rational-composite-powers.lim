; Unbounded rational exponent addition and composition from Nat induction.
; Explicit exponent commutation uses the proved Nat multiplication law;
; specialize the generic product/composition laws for scaled c4 cubing.
(#alias add = ./../fermat_statement.lim::add)
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias congruence = ./equality.lim::congruence)
(#alias substitution = ./equality.lim::substitution)
(#alias rational = ./rational-defs.lim::rational)
(#alias rational-equal = ./rational-defs.lim::rational-equal)
(#alias rational-one = ./rational-defs.lim::rational-one)
(#alias rational-multiply = ./rational-defs.lim::rational-multiply)
(#alias rational-power = ./rational-defs.lim::rational-power)
(#alias rational-reflexive = ./rational-equality.lim::rational-reflexive)
(#alias rational-symmetric = ./rational-equality.lim::rational-symmetric)
(#alias rational-transitive = ./rational-equality.lim::rational-transitive)
(#alias rational-multiply-congruent = ./rational-congruence.lim::rational-multiply-congruent)
(#alias rational-multiply-associative = ./rational-ring.lim::rational-multiply-associative)
(#alias rational-one-multiply = ./rational-sign-laws.lim::rational-one-multiply)
(#alias rational-power-product = ./rational-power-laws.lim::rational-power-product)
(#alias multiply-commutative = ./natural-multiplication-commutative.lim::multiply-commutative)
(#theorem rational-power-add
  (#universes)
  (#parameters
    (#parameter base (#pt-use rational ()))
    (#parameter first-exponent #pt-nat)
    (#parameter second-exponent #pt-nat))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-power ())
        base
        (#pt-app (#pt-use add ()) first-exponent second-exponent))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app (#pt-use rational-power ()) base first-exponent)
        (#pt-app (#pt-use rational-power ()) base second-exponent))))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((induction-index #pt-nat))
        (#pt-app
          (#pt-use rational-equal ())
          (#pt-app
            (#pt-use rational-power ())
            base
            (#pt-app (#pt-use add ()) induction-index second-exponent))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app (#pt-use rational-power ()) base induction-index)
            (#pt-app (#pt-use rational-power ()) base second-exponent))))
      (#pt-app
        (#pt-use rational-symmetric ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-use rational-one ())
          (#pt-app (#pt-use rational-power ()) base second-exponent))
        (#pt-app (#pt-use rational-power ()) base second-exponent)
        (#pt-app
          (#pt-use rational-one-multiply ())
          (#pt-app (#pt-use rational-power ()) base second-exponent)))
      (#pt-lambda
        (
          (previous-exponent #pt-nat)
          (previous-addition
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-app
                (#pt-use rational-power ())
                base
                (#pt-app (#pt-use add ()) previous-exponent second-exponent))
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app (#pt-use rational-power ()) base previous-exponent)
                (#pt-app (#pt-use rational-power ()) base second-exponent)))))
        (#pt-app
          (#pt-use rational-transitive ())
          (#pt-app
            (#pt-use rational-multiply ())
            base
            (#pt-app
              (#pt-use rational-power ())
              base
              (#pt-app (#pt-use add ()) previous-exponent second-exponent)))
          (#pt-app
            (#pt-use rational-multiply ())
            base
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app (#pt-use rational-power ()) base previous-exponent)
              (#pt-app (#pt-use rational-power ()) base second-exponent)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-multiply ())
              base
              (#pt-app (#pt-use rational-power ()) base previous-exponent))
            (#pt-app (#pt-use rational-power ()) base second-exponent))
          (#pt-app
            (#pt-use rational-multiply-congruent ())
            base
            (#pt-app
              (#pt-use rational-power ())
              base
              (#pt-app (#pt-use add ()) previous-exponent second-exponent))
            base
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app (#pt-use rational-power ()) base previous-exponent)
              (#pt-app (#pt-use rational-power ()) base second-exponent))
            (#pt-app (#pt-use rational-reflexive ()) base)
            previous-addition)
          (#pt-app
            (#pt-use rational-symmetric ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-multiply ())
                base
                (#pt-app (#pt-use rational-power ()) base previous-exponent))
              (#pt-app (#pt-use rational-power ()) base second-exponent))
            (#pt-app
              (#pt-use rational-multiply ())
              base
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app (#pt-use rational-power ()) base previous-exponent)
                (#pt-app (#pt-use rational-power ()) base second-exponent)))
            (#pt-app
              (#pt-use rational-multiply-associative ())
              base
              (#pt-app (#pt-use rational-power ()) base previous-exponent)
              (#pt-app (#pt-use rational-power ()) base second-exponent)))))
      first-exponent)))
(#theorem rational-power-iterate
  (#universes)
  (#parameters
    (#parameter base (#pt-use rational ()))
    (#parameter first-exponent #pt-nat)
    (#parameter second-exponent #pt-nat))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-power ())
        (#pt-app (#pt-use rational-power ()) base first-exponent)
        second-exponent)
      (#pt-app
        (#pt-use rational-power ())
        base
        (#pt-app (#pt-use multiply ()) second-exponent first-exponent))))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((induction-index #pt-nat))
        (#pt-app
          (#pt-use rational-equal ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app (#pt-use rational-power ()) base first-exponent)
            induction-index)
          (#pt-app
            (#pt-use rational-power ())
            base
            (#pt-app (#pt-use multiply ()) induction-index first-exponent))))
      (#pt-app (#pt-use rational-reflexive ()) (#pt-use rational-one ()))
      (#pt-lambda
        (
          (previous-exponent #pt-nat)
          (previous-product
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-app (#pt-use rational-power ()) base first-exponent)
                previous-exponent)
              (#pt-app
                (#pt-use rational-power ())
                base
                (#pt-app (#pt-use multiply ()) previous-exponent first-exponent)))))
        (#pt-app
          (#pt-use rational-transitive ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app (#pt-use rational-power ()) base first-exponent)
            (#pt-app
              (#pt-use rational-power ())
              (#pt-app (#pt-use rational-power ()) base first-exponent)
              previous-exponent))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app (#pt-use rational-power ()) base first-exponent)
            (#pt-app
              (#pt-use rational-power ())
              base
              (#pt-app (#pt-use multiply ()) previous-exponent first-exponent)))
          (#pt-app
            (#pt-use rational-power ())
            base
            (#pt-app
              (#pt-use add ())
              first-exponent
              (#pt-app (#pt-use multiply ()) previous-exponent first-exponent)))
          (#pt-app
            (#pt-use rational-multiply-congruent ())
            (#pt-app (#pt-use rational-power ()) base first-exponent)
            (#pt-app
              (#pt-use rational-power ())
              (#pt-app (#pt-use rational-power ()) base first-exponent)
              previous-exponent)
            (#pt-app (#pt-use rational-power ()) base first-exponent)
            (#pt-app
              (#pt-use rational-power ())
              base
              (#pt-app (#pt-use multiply ()) previous-exponent first-exponent))
            (#pt-app
              (#pt-use rational-reflexive ())
              (#pt-app (#pt-use rational-power ()) base first-exponent))
            previous-product)
          (#pt-app
            (#pt-use rational-symmetric ())
            (#pt-app
              (#pt-use rational-power ())
              base
              (#pt-app
                (#pt-use add ())
                first-exponent
                (#pt-app (#pt-use multiply ()) previous-exponent first-exponent)))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app (#pt-use rational-power ()) base first-exponent)
              (#pt-app
                (#pt-use rational-power ())
                base
                (#pt-app (#pt-use multiply ()) previous-exponent first-exponent)))
            (#pt-app
              (#pt-use rational-power-add ())
              base
              first-exponent
              (#pt-app (#pt-use multiply ()) previous-exponent first-exponent)))))
      second-exponent)))
(#theorem rational-power-compose
  (#universes)
  (#parameters
    (#parameter base (#pt-use rational ()))
    (#parameter first-exponent #pt-nat)
    (#parameter second-exponent #pt-nat))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-power ())
        (#pt-app (#pt-use rational-power ()) base first-exponent)
        second-exponent)
      (#pt-app
        (#pt-use rational-power ())
        base
        (#pt-app (#pt-use multiply ()) first-exponent second-exponent))))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app
        (#pt-use rational-power ())
        (#pt-app (#pt-use rational-power ()) base first-exponent)
        second-exponent)
      (#pt-app
        (#pt-use rational-power ())
        base
        (#pt-app (#pt-use multiply ()) second-exponent first-exponent))
      (#pt-app
        (#pt-use rational-power ())
        base
        (#pt-app (#pt-use multiply ()) first-exponent second-exponent))
      (#pt-app (#pt-use rational-power-iterate ()) base first-exponent second-exponent)
      (#pt-app
        (#pt-use substitution (0))
        (#pt-use rational ())
        (#pt-lambda
          ((power-value (#pt-use rational ())))
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-app
              (#pt-use rational-power ())
              base
              (#pt-app (#pt-use multiply ()) second-exponent first-exponent))
            power-value))
        (#pt-app
          (#pt-use rational-power ())
          base
          (#pt-app (#pt-use multiply ()) second-exponent first-exponent))
        (#pt-app
          (#pt-use rational-power ())
          base
          (#pt-app (#pt-use multiply ()) first-exponent second-exponent))
        (#pt-app
          (#pt-use congruence (0 0))
          #pt-nat
          (#pt-use rational ())
          (#pt-lambda
            ((power-index #pt-nat))
            (#pt-app (#pt-use rational-power ()) base power-index))
          (#pt-app (#pt-use multiply ()) second-exponent first-exponent)
          (#pt-app (#pt-use multiply ()) first-exponent second-exponent)
          (#pt-app (#pt-use multiply-commutative ()) second-exponent first-exponent))
        (#pt-app
          (#pt-use rational-reflexive ())
          (#pt-app
            (#pt-use rational-power ())
            base
            (#pt-app (#pt-use multiply ()) second-exponent first-exponent)))))))
(#theorem rational-scaled-c4-cube
  (#universes)
  (#parameters
    (#parameter scale (#pt-use rational ()))
    (#parameter c4 (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-power ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app (#pt-use rational-power ()) scale (#pt-numeral 4))
          c4)
        (#pt-numeral 3))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app (#pt-use rational-power ()) scale (#pt-numeral 12))
        (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3)))))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app
        (#pt-use rational-power ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app (#pt-use rational-power ()) scale (#pt-numeral 4))
          c4)
        (#pt-numeral 3))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app (#pt-use rational-power ()) scale (#pt-numeral 4))
          (#pt-numeral 3))
        (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3)))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app (#pt-use rational-power ()) scale (#pt-numeral 12))
        (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3)))
      (#pt-app
        (#pt-use rational-power-product ())
        (#pt-app (#pt-use rational-power ()) scale (#pt-numeral 4))
        c4
        (#pt-numeral 3))
      (#pt-app
        (#pt-use rational-multiply-congruent ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app (#pt-use rational-power ()) scale (#pt-numeral 4))
          (#pt-numeral 3))
        (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3))
        (#pt-app (#pt-use rational-power ()) scale (#pt-numeral 12))
        (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3))
        (#pt-app (#pt-use rational-power-compose ()) scale (#pt-numeral 4) (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-reflexive ())
          (#pt-app (#pt-use rational-power ()) c4 (#pt-numeral 3)))))))
