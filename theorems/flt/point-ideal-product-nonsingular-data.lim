; Adapted mathematical source: pinned Mathlib RingTheory/Ideal/Operations.lean
; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean.
; Generated by scripts/generate-flt-point-ideal-products.py; checked native terms.
; A nonsingular-point certificate
; contains the actual defining curve equation and one actual
; nonzero Jacobian partial. This data never contains an
; ideal inverse, product identity or desired group law.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias
  point-ideal-product-partial-x
  =
  ./point-ideal-product-model-partials.lim::point-ideal-product-partial-x)
(#alias
  point-ideal-product-partial-y
  =
  ./point-ideal-product-model-partials.lim::point-ideal-product-partial-y)
(#alias
  polynomial-root-evaluation-morphism
  =
  ./polynomial-root-evaluation-morphism.lim::polynomial-root-evaluation-morphism)
(#alias quadratic-division-divisor = ./quadratic-division-data.lim::quadratic-division-divisor)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-evaluation = ./ring-evaluation-data.lim::ring-evaluation)
(#alias ring-polynomial-evaluate = ./ring-polynomial-data.lim::ring-polynomial-evaluate)
(#alias ring-polynomial-structure = ./ring-polynomial-structure.lim::ring-polynomial-structure)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#alias
  weierstrass-coordinate-cubic
  =
  ./weierstrass-coordinate-normal-form.lim::weierstrass-coordinate-cubic)
(#alias
  weierstrass-coordinate-linear
  =
  ./weierstrass-coordinate-normal-form.lim::weierstrass-coordinate-linear)
(#math-definition point-ideal-product-nonsingular ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (a1 Carrier)
      (a2 Carrier)
      (a3 Carrier)
      (a4 Carrier)
      (a6 Carrier)
      (root Carrier)
      (ordinate Carrier))
    #pt-prop)
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (a1 Carrier)
      (a2 Carrier)
      (a3 Carrier)
      (a4 Carrier)
      (a6 Carrier)
      (root Carrier)
      (ordinate Carrier))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app
        (#pt-use ring-equal ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-evaluation ())
          (#pt-app (#pt-use finite-list ()) Carrier)
          (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-evaluation-morphism ()) Carrier coefficient-ring root)
          (#pt-app
            (#pt-use ring-polynomial-evaluate ())
            Carrier
            coefficient-ring
            (#pt-construct
              finite-list
              ()
              (Carrier)
              cons
              (ordinate (#pt-construct finite-list () (Carrier) nil ())))
            root)
          (#pt-app
            (#pt-use quadratic-division-divisor ())
            (#pt-app (#pt-use finite-list ()) Carrier)
            (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
            (#pt-app
              (#pt-use weierstrass-coordinate-linear ())
              Carrier
              coefficient-ring
              a1
              a2
              a3
              a4
              a6)
            (#pt-app
              (#pt-use weierstrass-coordinate-cubic ())
              Carrier
              coefficient-ring
              a1
              a2
              a3
              a4
              a6)))
        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
      (#pt-app
        (#pt-use disjunction ())
        (#pt-pi
          (
            (denied-evidence
              (#pt-app
                (#pt-use ring-equal ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use point-ideal-product-partial-x ())
                  Carrier
                  coefficient-ring
                  a1
                  a2
                  a3
                  a4
                  a6
                  root
                  ordinate)
                (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
          #pt-false)
        (#pt-pi
          (
            (denied-evidence
              (#pt-app
                (#pt-use ring-equal ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use point-ideal-product-partial-y ())
                  Carrier
                  coefficient-ring
                  a1
                  a2
                  a3
                  a4
                  a6
                  root
                  ordinate)
                (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
          #pt-false)))))
(#theorem point-ideal-product-nonsingular-equation
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter root Carrier)
    (#parameter ordinate Carrier)
    (#parameter nonsingular-point (#pt-app (#pt-use point-ideal-product-nonsingular ()) Carrier coefficient-ring a1 a2 a3 a4 a6 root ordinate)))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-evaluation ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        Carrier
        coefficient-ring
        (#pt-app (#pt-use polynomial-root-evaluation-morphism ()) Carrier coefficient-ring root)
        (#pt-app
          (#pt-use ring-polynomial-evaluate ())
          Carrier
          coefficient-ring
          (#pt-construct
            finite-list
            ()
            (Carrier)
            cons
            (ordinate (#pt-construct finite-list () (Carrier) nil ())))
          root)
        (#pt-app
          (#pt-use quadratic-division-divisor ())
          (#pt-app (#pt-use finite-list ()) Carrier)
          (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
          (#pt-app
            (#pt-use weierstrass-coordinate-linear ())
            Carrier
            coefficient-ring
            a1
            a2
            a3
            a4
            a6)
          (#pt-app
            (#pt-use weierstrass-coordinate-cubic ())
            Carrier
            coefficient-ring
            a1
            a2
            a3
            a4
            a6)))
      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
  (#proof (#pt-project conjunction 0 nonsingular-point)))
(#theorem point-ideal-product-nonsingular-jacobian
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter root Carrier)
    (#parameter ordinate Carrier)
    (#parameter nonsingular-point (#pt-app (#pt-use point-ideal-product-nonsingular ()) Carrier coefficient-ring a1 a2 a3 a4 a6 root ordinate)))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-pi
        (
          (denied-evidence
            (#pt-app
              (#pt-use ring-equal ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use point-ideal-product-partial-x ())
                Carrier
                coefficient-ring
                a1
                a2
                a3
                a4
                a6
                root
                ordinate)
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
        #pt-false)
      (#pt-pi
        (
          (denied-evidence
            (#pt-app
              (#pt-use ring-equal ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use point-ideal-product-partial-y ())
                Carrier
                coefficient-ring
                a1
                a2
                a3
                a4
                a6
                root
                ordinate)
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
        #pt-false)))
  (#proof (#pt-project conjunction 1 nonsingular-point)))
