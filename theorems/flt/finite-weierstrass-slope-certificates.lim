(#theorem finite-weierstrass-tangent-denominator-nonzero
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) modulus))
    (#parameter curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
    (#parameter first-x (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second-x (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter first-y (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second-y (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter first-equation (#pt-app (#pt-use finite-weierstrass-equation ()) modulus positive-modulus curve first-x first-y))
    (#parameter second-equation (#pt-app (#pt-use finite-weierstrass-equation ()) modulus positive-modulus curve second-x second-y))
    (#parameter x-equation (#pt-eq #pt-nat (#pt-project finite-residue 0 first-x) (#pt-project finite-residue 0 second-x)))
    (#parameter not-inverse-y (#pt-pi ((denied-evidence (#pt-eq #pt-nat (#pt-project finite-residue 0 first-y) (#pt-project finite-residue 0 (#pt-app (#pt-use finite-weierstrass-neg-y ()) modulus positive-modulus curve second-x second-y))))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use finite-residue-nonzero ())
      modulus
      (#pt-app
        (#pt-use finite-weierstrass-derivative-y ())
        modulus
        positive-modulus
        curve
        first-x
        first-y)))
  (#proof
    (#pt-app
      (#pt-use finite-residue-value-nonzero ())
      modulus
      positive-modulus
      (#pt-app
        (#pt-use finite-weierstrass-derivative-y ())
        modulus
        positive-modulus
        curve
        first-x
        first-y)
      (#pt-lambda
        (
          (derivative-zero
            (#pt-eq
              #pt-nat
              (#pt-project
                finite-residue
                0
                (#pt-app
                  (#pt-use finite-weierstrass-derivative-y ())
                  modulus
                  positive-modulus
                  curve
                  first-x
                  first-y))
              (#pt-project
                finite-residue
                0
                (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)))))
        (#pt-app
          (#pt-lambda
            (
              (self-inverse-y
                (#pt-eq
                  #pt-nat
                  (#pt-project finite-residue 0 first-y)
                  (#pt-project
                    finite-residue
                    0
                    (#pt-app
                      (#pt-use finite-weierstrass-neg-y ())
                      modulus
                      positive-modulus
                      curve
                      first-x
                      first-y)))))
            (#pt-app
              not-inverse-y
              (#pt-app
                (#pt-use transitivity (0))
                #pt-nat
                (#pt-project finite-residue 0 first-y)
                (#pt-project
                  finite-residue
                  0
                  (#pt-app
                    (#pt-use finite-weierstrass-neg-y ())
                    modulus
                    positive-modulus
                    curve
                    first-x
                    first-y))
                (#pt-project
                  finite-residue
                  0
                  (#pt-app
                    (#pt-use finite-weierstrass-neg-y ())
                    modulus
                    positive-modulus
                    curve
                    second-x
                    second-y))
                self-inverse-y
                (#pt-app
                  (#pt-use finite-weierstrass-neg-y-congruent ())
                  modulus
                  positive-modulus
                  curve
                  first-x
                  first-y
                  second-x
                  second-y
                  x-equation
                  (#pt-app
                    (#pt-use finite-weierstrass-equal-x-not-neg-equal-y ())
                    modulus
                    positive-modulus
                    prime-proof
                    curve
                    first-x
                    second-x
                    first-y
                    second-y
                    first-equation
                    second-equation
                    x-equation
                    not-inverse-y)))))
          (#pt-app
            (#pt-use finite-residue-difference-zero-implies-equal ())
            modulus
            positive-modulus
            first-y
            (#pt-app
              (#pt-use finite-weierstrass-neg-y ())
              modulus
              positive-modulus
              curve
              first-x
              first-y)
            (#pt-app
              (#pt-use transitivity (0))
              #pt-nat
              (#pt-project
                finite-residue
                0
                (#pt-app
                  (#pt-use finite-residue-difference ())
                  modulus
                  positive-modulus
                  first-y
                  (#pt-app
                    (#pt-use finite-weierstrass-neg-y ())
                    modulus
                    positive-modulus
                    curve
                    first-x
                    first-y)))
              (#pt-project
                finite-residue
                0
                (#pt-app
                  (#pt-use finite-weierstrass-derivative-y ())
                  modulus
                  positive-modulus
                  curve
                  first-x
                  first-y))
              (#pt-project
                finite-residue
                0
                (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus))
              (#pt-app
                (#pt-use symmetry (0))
                #pt-nat
                (#pt-project
                  finite-residue
                  0
                  (#pt-app
                    (#pt-use finite-weierstrass-derivative-y ())
                    modulus
                    positive-modulus
                    curve
                    first-x
                    first-y))
                (#pt-project
                  finite-residue
                  0
                  (#pt-app
                    (#pt-use finite-residue-difference ())
                    modulus
                    positive-modulus
                    first-y
                    (#pt-app
                      (#pt-use finite-weierstrass-neg-y ())
                      modulus
                      positive-modulus
                      curve
                      first-x
                      first-y)))
                (#pt-app
                  (#pt-use finite-weierstrass-derivative-y-difference ())
                  modulus
                  positive-modulus
                  curve
                  first-x
                  first-y))
              derivative-zero)))))))
