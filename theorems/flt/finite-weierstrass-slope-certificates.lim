(#theorem finite-weierstrass-secant-product
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) modulus))
    (#parameter curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
    (#parameter first-x (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second-x (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter first-y (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second-y (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter x-unequal (#pt-pi ((denied-evidence (#pt-eq #pt-nat (#pt-project finite-residue 0 first-x) (#pt-project finite-residue 0 second-x)))) #pt-false)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-residue-multiply ())
          modulus
          positive-modulus
          (#pt-app
            (#pt-use finite-weierstrass-slope ())
            modulus
            positive-modulus
            curve
            first-x
            second-x
            first-y
            second-y)
          (#pt-app (#pt-use finite-residue-difference ()) modulus positive-modulus first-x second-x)))
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-difference ()) modulus positive-modulus first-y second-y))))
  (#proof
    (#pt-app
      (#pt-use transitivity (0))
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-residue-multiply ())
          modulus
          positive-modulus
          (#pt-app
            (#pt-use finite-weierstrass-slope ())
            modulus
            positive-modulus
            curve
            first-x
            second-x
            first-y
            second-y)
          (#pt-app (#pt-use finite-residue-difference ()) modulus positive-modulus first-x second-x)))
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-residue-multiply ())
          modulus
          positive-modulus
          (#pt-app
            (#pt-use finite-residue-divide ())
            modulus
            positive-modulus
            (#pt-app
              (#pt-use finite-residue-difference ())
              modulus
              positive-modulus
              first-y
              second-y)
            (#pt-app
              (#pt-use finite-residue-difference ())
              modulus
              positive-modulus
              first-x
              second-x))
          (#pt-app (#pt-use finite-residue-difference ()) modulus positive-modulus first-x second-x)))
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-difference ()) modulus positive-modulus first-y second-y))
      (#pt-app
        (#pt-use finite-residue-multiply-congruent ())
        modulus
        positive-modulus
        (#pt-app
          (#pt-use finite-weierstrass-slope ())
          modulus
          positive-modulus
          curve
          first-x
          second-x
          first-y
          second-y)
        (#pt-app (#pt-use finite-residue-difference ()) modulus positive-modulus first-x second-x)
        (#pt-app
          (#pt-use finite-residue-divide ())
          modulus
          positive-modulus
          (#pt-app (#pt-use finite-residue-difference ()) modulus positive-modulus first-y second-y)
          (#pt-app (#pt-use finite-residue-difference ()) modulus positive-modulus first-x second-x))
        (#pt-app (#pt-use finite-residue-difference ()) modulus positive-modulus first-x second-x)
        (#pt-app
          (#pt-use finite-weierstrass-slope-secant ())
          modulus
          positive-modulus
          curve
          first-x
          second-x
          first-y
          second-y
          x-unequal)
        (#pt-refl
          #pt-nat
          (#pt-project
            finite-residue
            0
            (#pt-app
              (#pt-use finite-residue-difference ())
              modulus
              positive-modulus
              first-x
              second-x))))
      (#pt-app
        (#pt-use finite-prime-divide-multiply ())
        modulus
        positive-modulus
        prime-proof
        (#pt-app (#pt-use finite-residue-difference ()) modulus positive-modulus first-y second-y)
        (#pt-app (#pt-use finite-residue-difference ()) modulus positive-modulus first-x second-x)
        (#pt-app
          (#pt-use finite-residue-value-nonzero ())
          modulus
          positive-modulus
          (#pt-app (#pt-use finite-residue-difference ()) modulus positive-modulus first-x second-x)
          (#pt-app
            (#pt-use finite-residue-difference-of-unequal-nonzero ())
            modulus
            positive-modulus
            first-x
            second-x
            x-unequal))))))
