; Constructive cases and equivalence transport for actual nonunit
; divisors of a nonzero value. Zero candidates are explicitly refuted;
; factor witnesses and unit refutations remain actual proof data.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias eisenstein-unit = ./eisenstein-defs.lim::eisenstein-unit)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias eisenstein-unit-congruent = ./eisenstein-unit-divisibility.lim::eisenstein-unit-congruent)
(#alias eisenstein-unit-cases = ./eisenstein-divisibility-cases.lim::eisenstein-unit-cases)
(#alias
  eisenstein-divisibility-cases-nonzero
  =
  ./eisenstein-divisibility-cases.lim::eisenstein-divisibility-cases-nonzero)
(#alias eisenstein-equality-decided = ./eisenstein-domain.lim::eisenstein-equality-decided)
(#alias eisenstein-divisor-nonzero = ./eisenstein-divisibility.lim::eisenstein-divisor-nonzero)
(#alias
  eisenstein-divides-congruent-divisor
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-congruent-divisor)
(#alias disjunction-left = ./logical-connectives.lim::disjunction-left)
(#alias disjunction-right = ./logical-connectives.lim::disjunction-right)
(#theorem eisenstein-divisibility-cases-nonzero-number
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter number (#pt-use eisenstein ()))
    (#parameter number-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ())))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app (#pt-use eisenstein-divides ()) divisor number)
      (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) divisor number))) #pt-false)))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use eisenstein-equal ()) divisor (#pt-use eisenstein-zero ()))
      (#pt-pi
        (
          (denied-proof
            (#pt-app (#pt-use eisenstein-equal ()) divisor (#pt-use eisenstein-zero ()))))
        #pt-false)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-app (#pt-use eisenstein-divides ()) divisor number)
        (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) divisor number))) #pt-false))
      (#pt-lambda
        (
          (divisor-zero
            (#pt-app (#pt-use eisenstein-equal ()) divisor (#pt-use eisenstein-zero ()))))
        (#pt-app
          (#pt-use disjunction-right ())
          (#pt-app (#pt-use eisenstein-divides ()) divisor number)
          (#pt-pi
            ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) divisor number)))
            #pt-false)
          (#pt-lambda
            ((divides-number (#pt-app (#pt-use eisenstein-divides ()) divisor number)))
            (#pt-app
              (#pt-app
                (#pt-use eisenstein-divisor-nonzero ())
                divisor
                number
                number-nonzero
                divides-number)
              divisor-zero))))
      (#pt-lambda
        (
          (divisor-nonzero
            (#pt-pi
              (
                (denied-proof
                  (#pt-app (#pt-use eisenstein-equal ()) divisor (#pt-use eisenstein-zero ()))))
              #pt-false)))
        (#pt-app (#pt-use eisenstein-divisibility-cases-nonzero ()) divisor number divisor-nonzero))
      (#pt-app (#pt-use eisenstein-equality-decided ()) divisor (#pt-use eisenstein-zero ())))))
(#math-definition eisenstein-nonunit-divisor ()
  (#pt-pi ((number (#pt-use eisenstein ())) (divisor (#pt-use eisenstein ()))) #pt-prop)
  (#pt-lambda
    ((number (#pt-use eisenstein ())) (divisor (#pt-use eisenstein ())))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) divisor))) #pt-false)
      (#pt-app (#pt-use eisenstein-divides ()) divisor number))))
(#theorem eisenstein-nonunit-divisor-congruent
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter other-divisor (#pt-use eisenstein ()))
    (#parameter equivalent (#pt-app (#pt-use eisenstein-equal ()) divisor other-divisor))
    (#parameter divisor-certificate (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number divisor)))
  (#statement (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number other-divisor))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) other-divisor))) #pt-false)
      (#pt-app (#pt-use eisenstein-divides ()) other-divisor number)
      (#pt-lambda
        ((other-unit (#pt-app (#pt-use eisenstein-unit ()) other-divisor)))
        (#pt-app
          (#pt-app
            (#pt-use conjunction-left ())
            (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) divisor))) #pt-false)
            (#pt-app (#pt-use eisenstein-divides ()) divisor number)
            divisor-certificate)
          (#pt-app
            (#pt-use eisenstein-unit-congruent ())
            other-divisor
            divisor
            (#pt-app (#pt-use eisenstein-symmetric ()) divisor other-divisor equivalent)
            other-unit)))
      (#pt-app
        (#pt-use eisenstein-divides-congruent-divisor ())
        divisor
        other-divisor
        number
        equivalent
        (#pt-app
          (#pt-use conjunction-right ())
          (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) divisor))) #pt-false)
          (#pt-app (#pt-use eisenstein-divides ()) divisor number)
          divisor-certificate)))))
(#theorem eisenstein-nonunit-divisor-cases
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter number-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ())))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number divisor)
      (#pt-pi
        ((denied-proof (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number divisor)))
        #pt-false)))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use eisenstein-unit ()) divisor)
      (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) divisor))) #pt-false)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number divisor)
        (#pt-pi
          ((denied-proof (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number divisor)))
          #pt-false))
      (#pt-lambda
        ((divisor-unit (#pt-app (#pt-use eisenstein-unit ()) divisor)))
        (#pt-app
          (#pt-use disjunction-right ())
          (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number divisor)
          (#pt-pi
            ((denied-proof (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number divisor)))
            #pt-false)
          (#pt-lambda
            ((divisor-evidence (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number divisor)))
            (#pt-app
              (#pt-app
                (#pt-use conjunction-left ())
                (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) divisor))) #pt-false)
                (#pt-app (#pt-use eisenstein-divides ()) divisor number)
                divisor-evidence)
              divisor-unit))))
      (#pt-lambda
        (
          (divisor-nonunit
            (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) divisor))) #pt-false)))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-app (#pt-use eisenstein-divides ()) divisor number)
          (#pt-pi
            ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) divisor number)))
            #pt-false)
          (#pt-app
            (#pt-use disjunction ())
            (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number divisor)
            (#pt-pi
              ((denied-proof (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number divisor)))
              #pt-false))
          (#pt-lambda
            ((divides-number (#pt-app (#pt-use eisenstein-divides ()) divisor number)))
            (#pt-app
              (#pt-use disjunction-left ())
              (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number divisor)
              (#pt-pi
                ((denied-proof (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number divisor)))
                #pt-false)
              (#pt-app
                (#pt-use conjunction-introduce ())
                (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) divisor))) #pt-false)
                (#pt-app (#pt-use eisenstein-divides ()) divisor number)
                divisor-nonunit
                divides-number)))
          (#pt-lambda
            (
              (not-divides-number
                (#pt-pi
                  ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) divisor number)))
                  #pt-false)))
            (#pt-app
              (#pt-use disjunction-right ())
              (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number divisor)
              (#pt-pi
                ((denied-proof (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number divisor)))
                #pt-false)
              (#pt-lambda
                (
                  (divisor-evidence
                    (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number divisor)))
                (#pt-app
                  not-divides-number
                  (#pt-app
                    (#pt-use conjunction-right ())
                    (#pt-pi
                      ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) divisor)))
                      #pt-false)
                    (#pt-app (#pt-use eisenstein-divides ()) divisor number)
                    divisor-evidence)))))
          (#pt-app
            (#pt-use eisenstein-divisibility-cases-nonzero-number ())
            divisor
            number
            number-nonzero)))
      (#pt-app (#pt-use eisenstein-unit-cases ()) divisor))))
