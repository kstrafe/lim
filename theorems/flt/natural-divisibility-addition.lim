; Addition and additive cancellation of natural divisibility.
; Cancellation is proved from multiplication order and witness trichotomy,
; with divisor zero handled separately rather than silently discarded.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias exists = ./logic-exists.lim::exists)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias less-than = ./natural-order.lim::less-than)
(#alias not-less-than-addition = ./natural-discrete-order.lim::not-less-than-addition)
(#alias natural-trichotomy = ./natural-discrete-order.lim::natural-trichotomy)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias multiply-add-right = ./natural-multiplication-order.lim::multiply-add-right)
(#alias
  multiply-less-left-successor
  =
  ./natural-multiplication-order.lim::multiply-less-left-successor)
(#alias multiply-zero-right = ./natural-multiplication-right.lim::multiply-zero-right)
(#alias zero-divisor-equation = ./decidable-divisibility.lim::zero-divisor-equation)
(#alias zero-divisor-witness = ./decidable-divisibility.lim::zero-divisor-witness)
(#alias add-zero-right = ./natural-addition.lim::add-zero-right)
(#alias add-successor-right = ./natural-addition.lim::add-successor-right)
(#alias add-cancel-left = ./natural-cancellation.lim::add-cancel-left)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias congruence = ./equality.lim::congruence)
(#alias substitution = ./equality.lim::substitution)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#theorem divides-add
  (#universes)
  (#parameters
    (#parameter divisor #pt-nat)
    (#parameter left #pt-nat)
    (#parameter right #pt-nat)
    (#parameter left-divides (#pt-app (#pt-use divides ()) divisor left))
    (#parameter right-divides (#pt-app (#pt-use divides ()) divisor right)))
  (#statement (#pt-app (#pt-use divides ()) divisor (#pt-app (#pt-use add ()) left right)))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-factor #pt-nat))
          (#pt-eq #pt-nat left (#pt-app (#pt-use multiply ()) divisor candidate-factor))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-factor #pt-nat))
                (#pt-eq #pt-nat left (#pt-app (#pt-use multiply ()) divisor candidate-factor))))))
        (#pt-app (#pt-use divides ()) divisor (#pt-app (#pt-use add ()) left right)))
      (
        (#pt-lambda
          (
            (left-factor #pt-nat)
            (left-equation
              (#pt-eq #pt-nat left (#pt-app (#pt-use multiply ()) divisor left-factor))))
          (#pt-induct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-factor #pt-nat))
                (#pt-eq #pt-nat right (#pt-app (#pt-use multiply ()) divisor candidate-factor))))
            (#pt-lambda
              (
                (certificate
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((candidate-factor #pt-nat))
                      (#pt-eq
                        #pt-nat
                        right
                        (#pt-app (#pt-use multiply ()) divisor candidate-factor))))))
              (#pt-app (#pt-use divides ()) divisor (#pt-app (#pt-use add ()) left right)))
            (
              (#pt-lambda
                (
                  (right-factor #pt-nat)
                  (right-equation
                    (#pt-eq #pt-nat right (#pt-app (#pt-use multiply ()) divisor right-factor))))
                (#pt-construct
                  exists
                  (0)
                  (#pt-nat
                    (#pt-lambda
                      ((candidate-factor #pt-nat))
                      (#pt-eq
                        #pt-nat
                        (#pt-app (#pt-use add ()) left right)
                        (#pt-app (#pt-use multiply ()) divisor candidate-factor))))
                  introduce
                  (
                    (#pt-app (#pt-use add ()) left-factor right-factor)
                    (#pt-app
                      (#pt-use transitivity (0))
                      #pt-nat
                      (#pt-app (#pt-use add ()) left right)
                      (#pt-app
                        (#pt-use add ())
                        (#pt-app (#pt-use multiply ()) divisor left-factor)
                        right)
                      (#pt-app
                        (#pt-use multiply ())
                        divisor
                        (#pt-app (#pt-use add ()) left-factor right-factor))
                      (#pt-app
                        (#pt-use congruence (0 0))
                        #pt-nat
                        #pt-nat
                        (#pt-lambda ((summand #pt-nat)) (#pt-app (#pt-use add ()) summand right))
                        left
                        (#pt-app (#pt-use multiply ()) divisor left-factor)
                        left-equation)
                      (#pt-app
                        (#pt-use transitivity (0))
                        #pt-nat
                        (#pt-app
                          (#pt-use add ())
                          (#pt-app (#pt-use multiply ()) divisor left-factor)
                          right)
                        (#pt-app
                          (#pt-use add ())
                          (#pt-app (#pt-use multiply ()) divisor left-factor)
                          (#pt-app (#pt-use multiply ()) divisor right-factor))
                        (#pt-app
                          (#pt-use multiply ())
                          divisor
                          (#pt-app (#pt-use add ()) left-factor right-factor))
                        (#pt-app
                          (#pt-use congruence (0 0))
                          #pt-nat
                          #pt-nat
                          (#pt-lambda
                            ((summand #pt-nat))
                            (#pt-app
                              (#pt-use add ())
                              (#pt-app (#pt-use multiply ()) divisor left-factor)
                              summand))
                          right
                          (#pt-app (#pt-use multiply ()) divisor right-factor)
                          right-equation)
                        (#pt-app
                          (#pt-use symmetry (0))
                          #pt-nat
                          (#pt-app
                            (#pt-use multiply ())
                            divisor
                            (#pt-app (#pt-use add ()) left-factor right-factor))
                          (#pt-app
                            (#pt-use add ())
                            (#pt-app (#pt-use multiply ()) divisor left-factor)
                            (#pt-app (#pt-use multiply ()) divisor right-factor))
                          (#pt-app (#pt-use multiply-add-right ()) divisor left-factor right-factor))))))))
            right-divides)))
      left-divides)))
(#theorem divides-add-cancel-successor
  (#universes)
  (#parameters
    (#parameter divisor-predecessor #pt-nat)
    (#parameter left #pt-nat)
    (#parameter right #pt-nat)
    (#parameter left-divides (#pt-app (#pt-use divides ()) (#pt-succ divisor-predecessor) left))
    (#parameter sum-divides (#pt-app (#pt-use divides ()) (#pt-succ divisor-predecessor) (#pt-app (#pt-use add ()) left right))))
  (#statement (#pt-app (#pt-use divides ()) (#pt-succ divisor-predecessor) right))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-factor #pt-nat))
          (#pt-eq
            #pt-nat
            left
            (#pt-app (#pt-use multiply ()) (#pt-succ divisor-predecessor) candidate-factor))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-factor #pt-nat))
                (#pt-eq
                  #pt-nat
                  left
                  (#pt-app (#pt-use multiply ()) (#pt-succ divisor-predecessor) candidate-factor))))))
        (#pt-app (#pt-use divides ()) (#pt-succ divisor-predecessor) right))
      (
        (#pt-lambda
          (
            (left-factor #pt-nat)
            (left-equation
              (#pt-eq
                #pt-nat
                left
                (#pt-app (#pt-use multiply ()) (#pt-succ divisor-predecessor) left-factor))))
          (#pt-induct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-factor #pt-nat))
                (#pt-eq
                  #pt-nat
                  (#pt-app (#pt-use add ()) left right)
                  (#pt-app (#pt-use multiply ()) (#pt-succ divisor-predecessor) candidate-factor))))
            (#pt-lambda
              (
                (certificate
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((candidate-factor #pt-nat))
                      (#pt-eq
                        #pt-nat
                        (#pt-app (#pt-use add ()) left right)
                        (#pt-app
                          (#pt-use multiply ())
                          (#pt-succ divisor-predecessor)
                          candidate-factor))))))
              (#pt-app (#pt-use divides ()) (#pt-succ divisor-predecessor) right))
            (
              (#pt-lambda
                (
                  (sum-factor #pt-nat)
                  (sum-equation
                    (#pt-eq
                      #pt-nat
                      (#pt-app (#pt-use add ()) left right)
                      (#pt-app (#pt-use multiply ()) (#pt-succ divisor-predecessor) sum-factor))))
                (#pt-app
                  (#pt-use disjunction-eliminate ())
                  (#pt-app (#pt-use less-than ()) left-factor sum-factor)
                  (#pt-app
                    (#pt-use disjunction ())
                    (#pt-eq #pt-nat left-factor sum-factor)
                    (#pt-app (#pt-use less-than ()) sum-factor left-factor))
                  (#pt-app (#pt-use divides ()) (#pt-succ divisor-predecessor) right)
                  (#pt-lambda
                    ((left-factor-less (#pt-app (#pt-use less-than ()) left-factor sum-factor)))
                    (#pt-induct
                      exists
                      (0)
                      (#pt-nat
                        (#pt-lambda
                          ((candidate-gap #pt-nat))
                          (#pt-eq
                            #pt-nat
                            sum-factor
                            (#pt-app (#pt-use add ()) (#pt-succ left-factor) candidate-gap))))
                      (#pt-lambda
                        (
                          (certificate
                            (#pt-app
                              (#pt-use exists (0))
                              #pt-nat
                              (#pt-lambda
                                ((candidate-gap #pt-nat))
                                (#pt-eq
                                  #pt-nat
                                  sum-factor
                                  (#pt-app (#pt-use add ()) (#pt-succ left-factor) candidate-gap))))))
                        (#pt-app (#pt-use divides ()) (#pt-succ divisor-predecessor) right))
                      (
                        (#pt-lambda
                          (
                            (difference #pt-nat)
                            (gap-equation
                              (#pt-eq
                                #pt-nat
                                sum-factor
                                (#pt-app (#pt-use add ()) (#pt-succ left-factor) difference))))
                          (#pt-construct
                            exists
                            (0)
                            (#pt-nat
                              (#pt-lambda
                                ((candidate-factor #pt-nat))
                                (#pt-eq
                                  #pt-nat
                                  right
                                  (#pt-app
                                    (#pt-use multiply ())
                                    (#pt-succ divisor-predecessor)
                                    candidate-factor))))
                            introduce
                            (
                              (#pt-succ difference)
                              (#pt-app
                                (#pt-use add-cancel-left ())
                                left
                                right
                                (#pt-app
                                  (#pt-use multiply ())
                                  (#pt-succ divisor-predecessor)
                                  (#pt-succ difference))
                                (#pt-app
                                  (#pt-use transitivity (0))
                                  #pt-nat
                                  (#pt-app (#pt-use add ()) left right)
                                  (#pt-app
                                    (#pt-use multiply ())
                                    (#pt-succ divisor-predecessor)
                                    sum-factor)
                                  (#pt-app
                                    (#pt-use add ())
                                    left
                                    (#pt-app
                                      (#pt-use multiply ())
                                      (#pt-succ divisor-predecessor)
                                      (#pt-succ difference)))
                                  sum-equation
                                  (#pt-app
                                    (#pt-use transitivity (0))
                                    #pt-nat
                                    (#pt-app
                                      (#pt-use multiply ())
                                      (#pt-succ divisor-predecessor)
                                      sum-factor)
                                    (#pt-app
                                      (#pt-use multiply ())
                                      (#pt-succ divisor-predecessor)
                                      (#pt-app (#pt-use add ()) left-factor (#pt-succ difference)))
                                    (#pt-app
                                      (#pt-use add ())
                                      left
                                      (#pt-app
                                        (#pt-use multiply ())
                                        (#pt-succ divisor-predecessor)
                                        (#pt-succ difference)))
                                    (#pt-app
                                      (#pt-use congruence (0 0))
                                      #pt-nat
                                      #pt-nat
                                      (#pt-lambda
                                        ((factor #pt-nat))
                                        (#pt-app
                                          (#pt-use multiply ())
                                          (#pt-succ divisor-predecessor)
                                          factor))
                                      sum-factor
                                      (#pt-app (#pt-use add ()) left-factor (#pt-succ difference))
                                      (#pt-app
                                        (#pt-use transitivity (0))
                                        #pt-nat
                                        sum-factor
                                        (#pt-app (#pt-use add ()) (#pt-succ left-factor) difference)
                                        (#pt-app (#pt-use add ()) left-factor (#pt-succ difference))
                                        gap-equation
                                        (#pt-app
                                          (#pt-use symmetry (0))
                                          #pt-nat
                                          (#pt-app
                                            (#pt-use add ())
                                            left-factor
                                            (#pt-succ difference))
                                          (#pt-app
                                            (#pt-use add ())
                                            (#pt-succ left-factor)
                                            difference)
                                          (#pt-app
                                            (#pt-use add-successor-right ())
                                            left-factor
                                            difference))))
                                    (#pt-app
                                      (#pt-use transitivity (0))
                                      #pt-nat
                                      (#pt-app
                                        (#pt-use multiply ())
                                        (#pt-succ divisor-predecessor)
                                        (#pt-app (#pt-use add ()) left-factor (#pt-succ difference)))
                                      (#pt-app
                                        (#pt-use add ())
                                        (#pt-app
                                          (#pt-use multiply ())
                                          (#pt-succ divisor-predecessor)
                                          left-factor)
                                        (#pt-app
                                          (#pt-use multiply ())
                                          (#pt-succ divisor-predecessor)
                                          (#pt-succ difference)))
                                      (#pt-app
                                        (#pt-use add ())
                                        left
                                        (#pt-app
                                          (#pt-use multiply ())
                                          (#pt-succ divisor-predecessor)
                                          (#pt-succ difference)))
                                      (#pt-app
                                        (#pt-use multiply-add-right ())
                                        (#pt-succ divisor-predecessor)
                                        left-factor
                                        (#pt-succ difference))
                                      (#pt-app
                                        (#pt-use congruence (0 0))
                                        #pt-nat
                                        #pt-nat
                                        (#pt-lambda
                                          ((summand #pt-nat))
                                          (#pt-app
                                            (#pt-use add ())
                                            summand
                                            (#pt-app
                                              (#pt-use multiply ())
                                              (#pt-succ divisor-predecessor)
                                              (#pt-succ difference))))
                                        (#pt-app
                                          (#pt-use multiply ())
                                          (#pt-succ divisor-predecessor)
                                          left-factor)
                                        left
                                        (#pt-app
                                          (#pt-use symmetry (0))
                                          #pt-nat
                                          left
                                          (#pt-app
                                            (#pt-use multiply ())
                                            (#pt-succ divisor-predecessor)
                                            left-factor)
                                          left-equation))))))))))
                      left-factor-less))
                  (#pt-lambda
                    (
                      (remaining-case
                        (#pt-app
                          (#pt-use disjunction ())
                          (#pt-eq #pt-nat left-factor sum-factor)
                          (#pt-app (#pt-use less-than ()) sum-factor left-factor))))
                    (#pt-app
                      (#pt-use disjunction-eliminate ())
                      (#pt-eq #pt-nat left-factor sum-factor)
                      (#pt-app (#pt-use less-than ()) sum-factor left-factor)
                      (#pt-app (#pt-use divides ()) (#pt-succ divisor-predecessor) right)
                      (#pt-lambda
                        ((equal-factors (#pt-eq #pt-nat left-factor sum-factor)))
                        (#pt-construct
                          exists
                          (0)
                          (#pt-nat
                            (#pt-lambda
                              ((candidate-factor #pt-nat))
                              (#pt-eq
                                #pt-nat
                                right
                                (#pt-app
                                  (#pt-use multiply ())
                                  (#pt-succ divisor-predecessor)
                                  candidate-factor))))
                          introduce
                          (#pt-zero
                            (#pt-app
                              (#pt-use transitivity (0))
                              #pt-nat
                              right
                              #pt-zero
                              (#pt-app
                                (#pt-use multiply ())
                                (#pt-succ divisor-predecessor)
                                #pt-zero)
                              (#pt-app
                                (#pt-use add-cancel-left ())
                                left
                                right
                                #pt-zero
                                (#pt-app
                                  (#pt-use transitivity (0))
                                  #pt-nat
                                  (#pt-app (#pt-use add ()) left right)
                                  (#pt-app
                                    (#pt-use multiply ())
                                    (#pt-succ divisor-predecessor)
                                    sum-factor)
                                  (#pt-app (#pt-use add ()) left #pt-zero)
                                  sum-equation
                                  (#pt-app
                                    (#pt-use transitivity (0))
                                    #pt-nat
                                    (#pt-app
                                      (#pt-use multiply ())
                                      (#pt-succ divisor-predecessor)
                                      sum-factor)
                                    (#pt-app
                                      (#pt-use multiply ())
                                      (#pt-succ divisor-predecessor)
                                      left-factor)
                                    (#pt-app (#pt-use add ()) left #pt-zero)
                                    (#pt-app
                                      (#pt-use congruence (0 0))
                                      #pt-nat
                                      #pt-nat
                                      (#pt-lambda
                                        ((factor #pt-nat))
                                        (#pt-app
                                          (#pt-use multiply ())
                                          (#pt-succ divisor-predecessor)
                                          factor))
                                      sum-factor
                                      left-factor
                                      (#pt-app
                                        (#pt-use symmetry (0))
                                        #pt-nat
                                        left-factor
                                        sum-factor
                                        equal-factors))
                                    (#pt-app
                                      (#pt-use transitivity (0))
                                      #pt-nat
                                      (#pt-app
                                        (#pt-use multiply ())
                                        (#pt-succ divisor-predecessor)
                                        left-factor)
                                      left
                                      (#pt-app (#pt-use add ()) left #pt-zero)
                                      (#pt-app
                                        (#pt-use symmetry (0))
                                        #pt-nat
                                        left
                                        (#pt-app
                                          (#pt-use multiply ())
                                          (#pt-succ divisor-predecessor)
                                          left-factor)
                                        left-equation)
                                      (#pt-app
                                        (#pt-use symmetry (0))
                                        #pt-nat
                                        (#pt-app (#pt-use add ()) left #pt-zero)
                                        left
                                        (#pt-app (#pt-use add-zero-right ()) left))))))
                              (#pt-app
                                (#pt-use symmetry (0))
                                #pt-nat
                                (#pt-app
                                  (#pt-use multiply ())
                                  (#pt-succ divisor-predecessor)
                                  #pt-zero)
                                #pt-zero
                                (#pt-app
                                  (#pt-use multiply-zero-right ())
                                  (#pt-succ divisor-predecessor)))))))
                      (#pt-lambda
                        ((sum-factor-less (#pt-app (#pt-use less-than ()) sum-factor left-factor)))
                        (#pt-app
                          (#pt-use false-elimination ())
                          (#pt-app (#pt-use divides ()) (#pt-succ divisor-predecessor) right)
                          (#pt-app
                            (#pt-app (#pt-use not-less-than-addition ()) left right)
                            (#pt-app
                              (#pt-use substitution (0))
                              #pt-nat
                              (#pt-lambda
                                ((endpoint #pt-nat))
                                (#pt-app (#pt-use less-than ()) endpoint left))
                              (#pt-app
                                (#pt-use multiply ())
                                (#pt-succ divisor-predecessor)
                                sum-factor)
                              (#pt-app (#pt-use add ()) left right)
                              (#pt-app
                                (#pt-use symmetry (0))
                                #pt-nat
                                (#pt-app (#pt-use add ()) left right)
                                (#pt-app
                                  (#pt-use multiply ())
                                  (#pt-succ divisor-predecessor)
                                  sum-factor)
                                sum-equation)
                              (#pt-app
                                (#pt-use substitution (0))
                                #pt-nat
                                (#pt-lambda
                                  ((endpoint #pt-nat))
                                  (#pt-app
                                    (#pt-use less-than ())
                                    (#pt-app
                                      (#pt-use multiply ())
                                      (#pt-succ divisor-predecessor)
                                      sum-factor)
                                    endpoint))
                                (#pt-app
                                  (#pt-use multiply ())
                                  (#pt-succ divisor-predecessor)
                                  left-factor)
                                left
                                (#pt-app
                                  (#pt-use symmetry (0))
                                  #pt-nat
                                  left
                                  (#pt-app
                                    (#pt-use multiply ())
                                    (#pt-succ divisor-predecessor)
                                    left-factor)
                                  left-equation)
                                (#pt-app
                                  (#pt-use multiply-less-left-successor ())
                                  divisor-predecessor
                                  sum-factor
                                  left-factor
                                  sum-factor-less))))))
                      remaining-case))
                  (#pt-app (#pt-use natural-trichotomy ()) left-factor sum-factor))))
            sum-divides)))
      left-divides)))
(#theorem divides-add-cancel-left
  (#universes)
  (#parameters
    (#parameter divisor #pt-nat)
    (#parameter left #pt-nat)
    (#parameter right #pt-nat)
    (#parameter left-divides (#pt-app (#pt-use divides ()) divisor left))
    (#parameter sum-divides (#pt-app (#pt-use divides ()) divisor (#pt-app (#pt-use add ()) left right))))
  (#statement (#pt-app (#pt-use divides ()) divisor right))
  (#proof
    (#pt-app
      (#pt-nat-induct
        (#pt-lambda
          ((index #pt-nat))
          (#pt-pi
            (
              (left-proof (#pt-app (#pt-use divides ()) index left))
              (sum-proof (#pt-app (#pt-use divides ()) index (#pt-app (#pt-use add ()) left right))))
            (#pt-app (#pt-use divides ()) index right)))
        (#pt-lambda
          (
            (left-proof (#pt-app (#pt-use divides ()) #pt-zero left))
            (sum-proof
              (#pt-app (#pt-use divides ()) #pt-zero (#pt-app (#pt-use add ()) left right))))
          (#pt-app
            (#pt-use zero-divisor-witness ())
            right
            (#pt-app
              (#pt-use substitution (0))
              #pt-nat
              (#pt-lambda
                ((endpoint #pt-nat))
                (#pt-eq #pt-nat (#pt-app (#pt-use add ()) endpoint right) #pt-zero))
              left
              #pt-zero
              (#pt-app (#pt-use zero-divisor-equation ()) left left-proof)
              (#pt-app
                (#pt-use zero-divisor-equation ())
                (#pt-app (#pt-use add ()) left right)
                sum-proof))))
        (#pt-lambda
          (
            (divisor-predecessor #pt-nat)
            (unused-previous
              (#pt-pi
                (
                  (left-proof (#pt-app (#pt-use divides ()) divisor-predecessor left))
                  (sum-proof
                    (#pt-app
                      (#pt-use divides ())
                      divisor-predecessor
                      (#pt-app (#pt-use add ()) left right))))
                (#pt-app (#pt-use divides ()) divisor-predecessor right)))
            (left-proof (#pt-app (#pt-use divides ()) (#pt-succ divisor-predecessor) left))
            (sum-proof
              (#pt-app
                (#pt-use divides ())
                (#pt-succ divisor-predecessor)
                (#pt-app (#pt-use add ()) left right))))
          (#pt-app
            (#pt-use divides-add-cancel-successor ())
            divisor-predecessor
            left
            right
            left-proof
            sum-proof))
        divisor)
      left-divides
      sum-divides)))
