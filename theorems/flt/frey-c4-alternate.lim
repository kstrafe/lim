; Direct native port of Def_FreyCurve_Basic.lean:37-42 and the
; c4Int_eq_sub helper in S_FreyPackage_not_dvd_freyCurveInt_c4.
; Retain the actual coordinate equation and product/squared-power
; certificates; both rational and actual integral forms are derived.
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-power = ./integer-defs.lim::integer-power)
(#alias integer-reflexive = ./integer-equality.lim::integer-reflexive)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias integer-add-congruent = ./integer-equality.lim::integer-add-congruent)
(#alias integer-negate-congruent = ./integer-equality.lim::integer-negate-congruent)
(#alias rational-equal = ./rational-defs.lim::rational-equal)
(#alias rational-of-integer = ./rational-defs.lim::rational-of-integer)
(#alias rational-transitive = ./rational-equality.lim::rational-transitive)
(#alias rational-of-integer-congruent = ./rational-congruence.lim::rational-of-integer-congruent)
(#alias rational-weierstrass-c4 = ./rational-weierstrass-defs.lim::rational-weierstrass-c4)
(#alias integer-power-congruent = ./integer-power-laws.lim::integer-power-congruent)
(#alias integer-power-product = ./integer-power-products.lim::integer-power-product)
(#alias integer-weierstrass-curve = ./integer-weierstrass-defs.lim::integer-weierstrass-curve)
(#alias integer-weierstrass-c4 = ./integer-weierstrass-defs.lim::integer-weierstrass-c4)
(#alias integer-frey-model-certificate = ./integer-frey-model.lim::integer-frey-model-certificate)
(#alias frey-rational-curve = ./frey-rational-curve.lim::frey-rational-curve)
(#alias frey-rational-curve-c4 = ./frey-rational-c4.lim::frey-rational-curve-c4)
(#alias integer-power-square = ./integer-power-sums.lim::integer-power-square)
(#alias integer-c4-alternate-cross = ./frey-c4-alternate-cross.lim::integer-c4-alternate-cross)
(#alias integer-frey-c4 = ./integer-frey-invariants.lim::integer-frey-c4)
(#theorem integer-c4-alternate-polynomial
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app (#pt-use integer-power ()) first (#pt-succ (#pt-succ #pt-zero)))
          (#pt-app (#pt-use integer-multiply ()) first second))
        (#pt-app (#pt-use integer-power ()) second (#pt-succ (#pt-succ #pt-zero))))
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app (#pt-use integer-add ()) first second)
          (#pt-succ (#pt-succ #pt-zero)))
        (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-multiply ()) first second)))))
  (#proof
    (#pt-app
      (#pt-use integer-c4-alternate-cross ())
      (#pt-project integer 0 first)
      (#pt-project integer 1 first)
      (#pt-project integer 0 second)
      (#pt-project integer 1 second))))
(#math-definition frey-integer-c4-value ()
  (#pt-pi
    ((first (#pt-use integer ())) (second (#pt-use integer ())) (exponent #pt-nat))
    (#pt-use integer ()))
  (#pt-lambda
    ((first (#pt-use integer ())) (second (#pt-use integer ())) (exponent #pt-nat))
    (#pt-app
      (#pt-use integer-add ())
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app (#pt-use integer-power ()) first exponent)
          (#pt-succ (#pt-succ #pt-zero)))
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app (#pt-use integer-power ()) first exponent)
          (#pt-app (#pt-use integer-power ()) second exponent)))
      (#pt-app
        (#pt-use integer-power ())
        (#pt-app (#pt-use integer-power ()) second exponent)
        (#pt-succ (#pt-succ #pt-zero))))))
(#theorem frey-c4-power-equation-alternate
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter power-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-power ()) first exponent) (#pt-app (#pt-use integer-power ()) second exponent)) (#pt-app (#pt-use integer-power ()) third exponent))))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use frey-integer-c4-value ()) first second exponent)
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app (#pt-use integer-power ()) third exponent)
          (#pt-succ (#pt-succ #pt-zero)))
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            exponent)))))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app (#pt-use frey-integer-c4-value ()) first second exponent)
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app (#pt-use integer-power ()) first exponent)
            (#pt-app (#pt-use integer-power ()) second exponent))
          (#pt-succ (#pt-succ #pt-zero)))
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-power ()) first exponent)
            (#pt-app (#pt-use integer-power ()) second exponent))))
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app (#pt-use integer-power ()) third exponent)
          (#pt-succ (#pt-succ #pt-zero)))
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            exponent)))
      (#pt-app
        (#pt-use integer-c4-alternate-polynomial ())
        (#pt-app (#pt-use integer-power ()) first exponent)
        (#pt-app (#pt-use integer-power ()) second exponent))
      (#pt-app
        (#pt-use integer-add-congruent ())
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app (#pt-use integer-power ()) first exponent)
            (#pt-app (#pt-use integer-power ()) second exponent))
          (#pt-succ (#pt-succ #pt-zero)))
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-power ()) first exponent)
            (#pt-app (#pt-use integer-power ()) second exponent)))
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app (#pt-use integer-power ()) third exponent)
          (#pt-succ (#pt-succ #pt-zero)))
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            exponent))
        (#pt-app
          (#pt-use integer-power-congruent ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app (#pt-use integer-power ()) first exponent)
            (#pt-app (#pt-use integer-power ()) second exponent))
          (#pt-app (#pt-use integer-power ()) third exponent)
          (#pt-succ (#pt-succ #pt-zero))
          power-equation)
        (#pt-app
          (#pt-use integer-negate-congruent ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-power ()) first exponent)
            (#pt-app (#pt-use integer-power ()) second exponent))
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            exponent)
          (#pt-app
            (#pt-use integer-symmetric ())
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app (#pt-use integer-multiply ()) first second)
              exponent)
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-power ()) first exponent)
              (#pt-app (#pt-use integer-power ()) second exponent))
            (#pt-app (#pt-use integer-power-product ()) first second exponent)))))))
(#theorem frey-c4-power-equation-doubled
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter power-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-power ()) first exponent) (#pt-app (#pt-use integer-power ()) second exponent)) (#pt-app (#pt-use integer-power ()) third exponent))))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use frey-integer-c4-value ()) first second exponent)
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app
          (#pt-use integer-power ())
          third
          (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent))
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            exponent)))))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app (#pt-use frey-integer-c4-value ()) first second exponent)
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app (#pt-use integer-power ()) third exponent)
          (#pt-succ (#pt-succ #pt-zero)))
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            exponent)))
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app
          (#pt-use integer-power ())
          third
          (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent))
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            exponent)))
      (#pt-app
        (#pt-use frey-c4-power-equation-alternate ())
        first
        second
        third
        exponent
        power-equation)
      (#pt-app
        (#pt-use integer-add-congruent ())
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app (#pt-use integer-power ()) third exponent)
          (#pt-succ (#pt-succ #pt-zero)))
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            exponent))
        (#pt-app
          (#pt-use integer-power ())
          third
          (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent))
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            exponent))
        (#pt-app (#pt-use integer-power-square ()) third exponent)
        (#pt-app
          (#pt-use integer-reflexive ())
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app (#pt-use integer-multiply ()) first second)
              exponent)))))))
(#theorem frey-rational-curve-c4-alternate
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter power-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-power ()) first exponent) (#pt-app (#pt-use integer-power ()) second exponent)) (#pt-app (#pt-use integer-power ()) third exponent))))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-weierstrass-c4 ())
        (#pt-app (#pt-use frey-rational-curve ()) first second exponent))
      (#pt-app
        (#pt-use rational-of-integer ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-power ())
            third
            (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent))
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app (#pt-use integer-multiply ()) first second)
              exponent))))))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app
        (#pt-use rational-weierstrass-c4 ())
        (#pt-app (#pt-use frey-rational-curve ()) first second exponent))
      (#pt-app
        (#pt-use rational-of-integer ())
        (#pt-app (#pt-use frey-integer-c4-value ()) first second exponent))
      (#pt-app
        (#pt-use rational-of-integer ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-power ())
            third
            (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent))
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app (#pt-use integer-multiply ()) first second)
              exponent))))
      (#pt-app (#pt-use frey-rational-curve-c4 ()) first second exponent)
      (#pt-app
        (#pt-use rational-of-integer-congruent ())
        (#pt-app (#pt-use frey-integer-c4-value ()) first second exponent)
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-power ())
            third
            (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent))
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app (#pt-use integer-multiply ()) first second)
              exponent)))
        (#pt-app
          (#pt-use frey-c4-power-equation-doubled ())
          first
          second
          third
          exponent
          power-equation)))))
(#theorem integer-frey-c4-alternate
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter integral-model (#pt-use integer-weierstrass-curve ()))
    (#parameter model-certificate (#pt-app (#pt-use integer-frey-model-certificate ()) first second exponent integral-model))
    (#parameter power-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-power ()) first exponent) (#pt-app (#pt-use integer-power ()) second exponent)) (#pt-app (#pt-use integer-power ()) third exponent))))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-weierstrass-c4 ()) integral-model)
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app (#pt-use integer-power ()) third exponent)
          (#pt-succ (#pt-succ #pt-zero)))
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            exponent)))))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app (#pt-use integer-weierstrass-c4 ()) integral-model)
      (#pt-app (#pt-use frey-integer-c4-value ()) first second exponent)
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app (#pt-use integer-power ()) third exponent)
          (#pt-succ (#pt-succ #pt-zero)))
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            exponent)))
      (#pt-app (#pt-use integer-frey-c4 ()) first second exponent integral-model model-certificate)
      (#pt-app
        (#pt-use frey-c4-power-equation-alternate ())
        first
        second
        third
        exponent
        power-equation))))
