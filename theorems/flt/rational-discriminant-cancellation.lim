; Cancel1728 using an explicit fraction1/1728 and both checked products.
; No inverse function, field axiom or division rule is assumed.
(#alias add = ./../fermat_statement.lim::add)
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias rational = ./rational-defs.lim::rational)
(#alias rational-equal = ./rational-defs.lim::rational-equal)
(#alias rational-of-integer = ./rational-defs.lim::rational-of-integer)
(#alias rational-multiply = ./rational-defs.lim::rational-multiply)
(#alias successor-not-zero = ./natural-nonzero.lim::successor-not-zero)
(#alias rational-cancel-unit-left = ./rational-unit-cancellation.lim::rational-cancel-unit-left)
(#theorem rational-cancel-1728
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter second (#pt-use rational ()))
    (#parameter scaled-equation (#pt-app (#pt-use rational-equal ()) (#pt-app (#pt-use rational-multiply ()) (#pt-app (#pt-use rational-of-integer ()) (#pt-app (#pt-use integer-of-natural ()) (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 13)) (#pt-numeral 64)))) first) (#pt-app (#pt-use rational-multiply ()) (#pt-app (#pt-use rational-of-integer ()) (#pt-app (#pt-use integer-of-natural ()) (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 13)) (#pt-numeral 64)))) second))))
  (#statement (#pt-app (#pt-use rational-equal ()) first second))
  (#proof
    (#pt-app
      (#pt-use rational-cancel-unit-left ())
      (#pt-app
        (#pt-use rational-of-integer ())
        (#pt-app
          (#pt-use integer-of-natural ())
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 13))
            (#pt-numeral 64))))
      (#pt-construct
        rational
        ()
        ()
        fraction
        (
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 1))
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 13))
            (#pt-numeral 64))
          (#pt-app
            (#pt-use successor-not-zero ())
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 13))
              (#pt-numeral 63)))))
      first
      second
      (#pt-refl
        #pt-nat
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 13))
          (#pt-numeral 64)))
      scaled-equation)))
