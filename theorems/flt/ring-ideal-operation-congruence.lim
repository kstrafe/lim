; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Ideal equality is respected by the actual
; product and sum constructions. Every direction is an explicit
; inclusion, obtained from the proved universal properties.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias ring-ideal = ./ring-ideal-data.lim::ring-ideal)
(#alias ring-ideal-equal = ./ring-ideal-data.lim::ring-ideal-equal)
(#alias ring-ideal-product = ./ring-ideal-product.lim::ring-ideal-product)
(#alias
  ring-ideal-product-monotone
  =
  ./ring-ideal-product-basic-laws.lim::ring-ideal-product-monotone)
(#alias ring-ideal-subset = ./ring-ideal-data.lim::ring-ideal-subset)
(#alias ring-ideal-subset-transitive = ./ring-ideal-equivalence.lim::ring-ideal-subset-transitive)
(#alias ring-ideal-sum = ./ring-ideal-sum.lim::ring-ideal-sum)
(#alias ring-ideal-sum-least = ./ring-ideal-sum-universal.lim::ring-ideal-sum-least)
(#alias ring-ideal-sum-left = ./ring-ideal-sum-universal.lim::ring-ideal-sum-left)
(#alias ring-ideal-sum-right = ./ring-ideal-sum-universal.lim::ring-ideal-sum-right)
(#theorem ring-ideal-product-congruent
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter larger-first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter larger-second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter first-equation (#pt-app (#pt-use ring-ideal-equal ()) Carrier coefficient-ring first-ideal larger-first-ideal))
    (#parameter second-equation (#pt-app (#pt-use ring-ideal-equal ()) Carrier coefficient-ring second-ideal larger-second-ideal)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal second-ideal)
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        larger-first-ideal
        larger-second-ideal)))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal second-ideal)
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          larger-first-ideal
          larger-second-ideal))
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          larger-first-ideal
          larger-second-ideal)
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal second-ideal))
      (#pt-app
        (#pt-use ring-ideal-product-monotone ())
        Carrier
        coefficient-ring
        first-ideal
        second-ideal
        larger-first-ideal
        larger-second-ideal
        (#pt-project conjunction 0 first-equation)
        (#pt-project conjunction 0 second-equation))
      (#pt-app
        (#pt-use ring-ideal-product-monotone ())
        Carrier
        coefficient-ring
        larger-first-ideal
        larger-second-ideal
        first-ideal
        second-ideal
        (#pt-project conjunction 1 first-equation)
        (#pt-project conjunction 1 second-equation)))))
(#theorem ring-ideal-sum-monotone
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter larger-first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter larger-second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter first-inclusion (#pt-app (#pt-use ring-ideal-subset ()) Carrier coefficient-ring first-ideal larger-first-ideal))
    (#parameter second-inclusion (#pt-app (#pt-use ring-ideal-subset ()) Carrier coefficient-ring second-ideal larger-second-ideal)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)
      (#pt-app
        (#pt-use ring-ideal-sum ())
        Carrier
        coefficient-ring
        larger-first-ideal
        larger-second-ideal)))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-sum-least ())
      Carrier
      coefficient-ring
      first-ideal
      second-ideal
      (#pt-app
        (#pt-use ring-ideal-sum ())
        Carrier
        coefficient-ring
        larger-first-ideal
        larger-second-ideal)
      (#pt-app
        (#pt-use ring-ideal-subset-transitive ())
        Carrier
        coefficient-ring
        first-ideal
        larger-first-ideal
        (#pt-app
          (#pt-use ring-ideal-sum ())
          Carrier
          coefficient-ring
          larger-first-ideal
          larger-second-ideal)
        first-inclusion
        (#pt-app
          (#pt-use ring-ideal-sum-left ())
          Carrier
          coefficient-ring
          larger-first-ideal
          larger-second-ideal))
      (#pt-app
        (#pt-use ring-ideal-subset-transitive ())
        Carrier
        coefficient-ring
        second-ideal
        larger-second-ideal
        (#pt-app
          (#pt-use ring-ideal-sum ())
          Carrier
          coefficient-ring
          larger-first-ideal
          larger-second-ideal)
        second-inclusion
        (#pt-app
          (#pt-use ring-ideal-sum-right ())
          Carrier
          coefficient-ring
          larger-first-ideal
          larger-second-ideal)))))
(#theorem ring-ideal-sum-congruent
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter larger-first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter larger-second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter first-equation (#pt-app (#pt-use ring-ideal-equal ()) Carrier coefficient-ring first-ideal larger-first-ideal))
    (#parameter second-equation (#pt-app (#pt-use ring-ideal-equal ()) Carrier coefficient-ring second-ideal larger-second-ideal)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)
      (#pt-app
        (#pt-use ring-ideal-sum ())
        Carrier
        coefficient-ring
        larger-first-ideal
        larger-second-ideal)))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)
        (#pt-app
          (#pt-use ring-ideal-sum ())
          Carrier
          coefficient-ring
          larger-first-ideal
          larger-second-ideal))
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-sum ())
          Carrier
          coefficient-ring
          larger-first-ideal
          larger-second-ideal)
        (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal))
      (#pt-app
        (#pt-use ring-ideal-sum-least ())
        Carrier
        coefficient-ring
        first-ideal
        second-ideal
        (#pt-app
          (#pt-use ring-ideal-sum ())
          Carrier
          coefficient-ring
          larger-first-ideal
          larger-second-ideal)
        (#pt-app
          (#pt-use ring-ideal-subset-transitive ())
          Carrier
          coefficient-ring
          first-ideal
          larger-first-ideal
          (#pt-app
            (#pt-use ring-ideal-sum ())
            Carrier
            coefficient-ring
            larger-first-ideal
            larger-second-ideal)
          (#pt-project conjunction 0 first-equation)
          (#pt-app
            (#pt-use ring-ideal-sum-left ())
            Carrier
            coefficient-ring
            larger-first-ideal
            larger-second-ideal))
        (#pt-app
          (#pt-use ring-ideal-subset-transitive ())
          Carrier
          coefficient-ring
          second-ideal
          larger-second-ideal
          (#pt-app
            (#pt-use ring-ideal-sum ())
            Carrier
            coefficient-ring
            larger-first-ideal
            larger-second-ideal)
          (#pt-project conjunction 0 second-equation)
          (#pt-app
            (#pt-use ring-ideal-sum-right ())
            Carrier
            coefficient-ring
            larger-first-ideal
            larger-second-ideal)))
      (#pt-app
        (#pt-use ring-ideal-sum-least ())
        Carrier
        coefficient-ring
        larger-first-ideal
        larger-second-ideal
        (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)
        (#pt-app
          (#pt-use ring-ideal-subset-transitive ())
          Carrier
          coefficient-ring
          larger-first-ideal
          first-ideal
          (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)
          (#pt-project conjunction 1 first-equation)
          (#pt-app
            (#pt-use ring-ideal-sum-left ())
            Carrier
            coefficient-ring
            first-ideal
            second-ideal))
        (#pt-app
          (#pt-use ring-ideal-subset-transitive ())
          Carrier
          coefficient-ring
          larger-second-ideal
          second-ideal
          (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)
          (#pt-project conjunction 1 second-equation)
          (#pt-app
            (#pt-use ring-ideal-sum-right ())
            Carrier
            coefficient-ring
            first-ideal
            second-ideal))))))
