          (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))
          (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second))
          (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first-other))
          (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second-other))
          first-equivalence
          second-equivalence)
        (#pt-app
          (#pt-use integer-multiply-congruent ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project rational 0 first-other)
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second-other)))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project rational 0 second-other)
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first-other))))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second)))
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project rational 0 first-other)
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second-other)))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project rational 0 second-other)
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first-other))))
          (#pt-app
            (#pt-use integer-of-natural ())
            (#pt-app
              (#pt-use multiply ())
              (#pt-project rational 1 first)
              (#pt-project rational 1 second)))
          (#pt-app
            (#pt-use integer-reflexive ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project rational 0 first-other)
                (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second-other)))
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project rational 0 second-other)
                (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first-other)))))
          (#pt-app
            (#pt-use integer-multiply-of-natural ())
            (#pt-project rational 1 first)
            (#pt-project rational 1 second)))))))
(#theorem rational-of-integer-congruent
  (#universes)
  (#parameters
    (#parameter first-integer (#pt-use integer ()))
    (#parameter second-integer (#pt-use integer ()))
    (#parameter integer-equivalence (#pt-app (#pt-use integer-equal ()) first-integer second-integer)))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app (#pt-use rational-of-integer ()) first-integer)
      (#pt-app (#pt-use rational-of-integer ()) second-integer)))
  (#proof
    (#pt-app
      (#pt-use rational-components-congruent ())
      (#pt-app (#pt-use rational-of-integer ()) first-integer)
      (#pt-app (#pt-use rational-of-integer ()) second-integer)
      integer-equivalence
      (#pt-refl #pt-nat (#pt-succ #pt-zero)))))
