(#theorem rational-add-congruent
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter second (#pt-use rational ()))
    (#parameter first-other (#pt-use rational ()))
    (#parameter second-other (#pt-use rational ()))
    (#parameter first-equivalence (#pt-app (#pt-use rational-equal ()) first first-other))
    (#parameter second-equivalence (#pt-app (#pt-use rational-equal ()) second second-other)))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
