; Rational operations and integer embedding respect the actual
; cross-product equality. Different valid denominators are reconciled
; by proved integer cross identities, never by identifying raw records.
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias symmetry = ./equality.lim::symmetry)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
