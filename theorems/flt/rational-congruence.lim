(#alias integer-of-natural-congruent = ./integer-bezout-algebra.lim::integer-of-natural-congruent)
(#theorem rational-components-congruent
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter second (#pt-use rational ()))
    (#parameter numerators-equivalent (#pt-app (#pt-use integer-equal ()) (#pt-project rational 0 first) (#pt-project rational 0 second)))
    (#parameter denominators-equal (#pt-eq #pt-nat (#pt-project rational 1 first) (#pt-project rational 1 second))))
  (#statement (#pt-app (#pt-use rational-equal ()) first second))
  (#proof
    (#pt-app
      (#pt-use integer-multiply-congruent ())
      (#pt-project rational 0 first)
      (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second))
      (#pt-project rational 0 second)
      (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))
      numerators-equivalent
      (#pt-app
        (#pt-use integer-of-natural-congruent ())
        (#pt-project rational 1 second)
        (#pt-project rational 1 first)
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          (#pt-project rational 1 first)
          (#pt-project rational 1 second)
          denominators-equal)))))
(#theorem rational-negate-congruent
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter second (#pt-use rational ()))
    (#parameter cross-equivalence (#pt-app (#pt-use rational-equal ()) first second)))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app (#pt-use rational-negate ()) first)
      (#pt-app (#pt-use rational-negate ()) second)))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app (#pt-use integer-negate ()) (#pt-project rational 0 first))
        (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second)))
      (#pt-app
        (#pt-use integer-negate ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-project rational 0 first)
          (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second))))
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app (#pt-use integer-negate ()) (#pt-project rational 0 second))
        (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))
      (#pt-app
        (#pt-use integer-multiply-negative ())
        (#pt-project rational 0 first)
        (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second)))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 first)
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second))))
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 second)
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))))
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app (#pt-use integer-negate ()) (#pt-project rational 0 second))
          (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))
        (#pt-app
          (#pt-use integer-negate-congruent ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 first)
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second)))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 second)
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))
          cross-equivalence)
        (#pt-app
          (#pt-use integer-symmetric ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-negate ()) (#pt-project rational 0 second))
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project rational 0 second)
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))))
          (#pt-app
            (#pt-use integer-multiply-negative ())
            (#pt-project rational 0 second)
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))))))))
