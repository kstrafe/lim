            (#pt-use eisenstein-multiply ())
            (#pt-app
              (#pt-use eisenstein-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) divisor))
            quotient)
          (#pt-construct
            eisenstein
            ()
            ()
            pair
