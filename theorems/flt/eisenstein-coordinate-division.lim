    (
      (dividend (#pt-use eisenstein ()))
      (divisor #pt-nat)
      (quotient (#pt-use eisenstein ()))
      (real-remainder #pt-nat)
      (omega-remainder #pt-nat))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app
        (#pt-use eisenstein-equal ())
        dividend
        (#pt-app
          (#pt-use eisenstein-add ())
