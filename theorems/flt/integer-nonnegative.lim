(#theorem integer-nonnegative-zero-sum-second
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter first-nonnegative (#pt-app (#pt-use integer-nonnegative ()) first))
    (#parameter second-nonnegative (#pt-app (#pt-use integer-nonnegative ()) second))
    (#parameter sum-zero (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) first second) (#pt-use integer-zero ()))))
  (#statement (#pt-app (#pt-use integer-equal ()) second (#pt-use integer-zero ())))
  (#proof
    (#pt-app
      (#pt-use integer-nonnegative-zero-sum-first ())
      second
      first
      second-nonnegative
      first-nonnegative
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app (#pt-use integer-add ()) second first)
        (#pt-app (#pt-use integer-add ()) first second)
        (#pt-use integer-zero ())
        (#pt-app (#pt-use integer-add-commutative ()) second first)
