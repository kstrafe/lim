(#math-definition integer-nonnegative ()
  (#pt-pi ((number (#pt-use integer ()))) #pt-prop)
  (#pt-lambda
    ((number (#pt-use integer ())))
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-natural #pt-nat))
        (#pt-app
          (#pt-use integer-equal ())
          number
          (#pt-app (#pt-use integer-of-natural ()) candidate-natural))))))
(#theorem integer-natural-nonnegative
  (#universes)
  (#parameters
    (#parameter number #pt-nat))
  (#statement
    (#pt-app (#pt-use integer-nonnegative ()) (#pt-app (#pt-use integer-of-natural ()) number)))
  (#proof
    (#pt-construct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-natural #pt-nat))
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-app (#pt-use integer-of-natural ()) number)
            (#pt-app (#pt-use integer-of-natural ()) candidate-natural))))
      introduce
      (number
        (#pt-app (#pt-use integer-reflexive ()) (#pt-app (#pt-use integer-of-natural ()) number))))))
(#theorem integer-nonnegative-congruent
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter other (#pt-use integer ()))
    (#parameter equivalent (#pt-app (#pt-use integer-equal ()) number other))
