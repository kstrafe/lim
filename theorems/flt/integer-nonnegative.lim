            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app (#pt-use multiply ()) magnitude magnitude))
            (#pt-app
              (#pt-use integer-multiply-two-negatives ())
              (#pt-app (#pt-use integer-of-natural ()) magnitude)
