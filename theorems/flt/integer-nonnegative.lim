                  (#pt-use integer-equal ())
                  number
                  (#pt-app (#pt-use integer-of-natural ()) candidate-natural))))))
        (#pt-app (#pt-use integer-nonnegative ()) other))
      (
        (#pt-lambda
          (
            (first-natural #pt-nat)
            (natural-equivalence
              (#pt-app
                (#pt-use integer-equal ())
                number
                (#pt-app (#pt-use integer-of-natural ()) first-natural))))
          (#pt-construct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-natural #pt-nat))
                (#pt-app
                  (#pt-use integer-equal ())
                  other
                  (#pt-app (#pt-use integer-of-natural ()) candidate-natural))))
            introduce
            (first-natural
              (#pt-app
                (#pt-use integer-transitive ())
                other
                number
                (#pt-app (#pt-use integer-of-natural ()) first-natural)
                (#pt-app (#pt-use integer-symmetric ()) number other equivalent)
                natural-equivalence)))))
      nonnegative-proof)))
