(#theorem integer-negative-natural-nonnegative-zero
  (#universes)
  (#parameters
    (#parameter natural #pt-nat)
    (#parameter negative-nonnegative (#pt-app (#pt-use integer-nonnegative ()) (#pt-app (#pt-use integer-negative-natural ()) natural))))
  (#statement (#pt-eq #pt-nat natural #pt-zero))
