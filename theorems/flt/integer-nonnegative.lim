            number
            number
            (#pt-app (#pt-use integer-of-natural ()) magnitude)
            (#pt-app (#pt-use integer-of-natural ()) magnitude)
            square-sign-positive
            square-sign-positive)
          (#pt-app (#pt-use integer-multiply-of-natural ()) magnitude magnitude)))
      (#pt-lambda
