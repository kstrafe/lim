(#alias ring-polynomial-equal = ./ring-polynomial-data.lim::ring-polynomial-equal)
(#alias ring-polynomial-evaluate = ./ring-polynomial-data.lim::ring-polynomial-evaluate)
(#alias ring-polynomial-multiply = ./ring-polynomial-data.lim::ring-polynomial-multiply)
(#alias ring-polynomial-reflexive = ./ring-polynomial-equivalence.lim::ring-polynomial-reflexive)
(#alias ring-polynomial-transitive = ./ring-polynomial-equivalence.lim::ring-polynomial-transitive)
(#theorem polynomial-root-division-evaluation
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter root Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-equal ())
      Carrier
      coefficient-ring
      polynomial
      (#pt-app
        (#pt-use ring-polynomial-add ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-multiply ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
          (#pt-app (#pt-use polynomial-root-quotient ()) Carrier coefficient-ring root polynomial))
        (#pt-construct
          finite-list
          ()
          (Carrier)
          cons
          (
            (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring polynomial root)
            (#pt-construct finite-list () (Carrier) nil ()))))))
  (#proof
    (#pt-app
      (#pt-use ring-polynomial-transitive ())
      Carrier
      coefficient-ring
      polynomial
      (#pt-app
        (#pt-use ring-polynomial-add ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-multiply ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
          (#pt-app (#pt-use polynomial-root-quotient ()) Carrier coefficient-ring root polynomial))
        (#pt-construct
          finite-list
          ()
          (Carrier)
          cons
          (
            (#pt-app
              (#pt-use polynomial-root-remainder ())
              Carrier
              coefficient-ring
              root
              polynomial)
            (#pt-construct finite-list () (Carrier) nil ()))))
      (#pt-app
        (#pt-use ring-polynomial-add ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-multiply ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
          (#pt-app (#pt-use polynomial-root-quotient ()) Carrier coefficient-ring root polynomial))
        (#pt-construct
          finite-list
          ()
          (Carrier)
          cons
          (
            (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring polynomial root)
            (#pt-construct finite-list () (Carrier) nil ()))))
      (#pt-app
        (#pt-use polynomial-root-division-equation ())
        Carrier
        coefficient-ring
        root
        polynomial)
      (#pt-app
        (#pt-use ring-polynomial-add-congruent ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-multiply ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
          (#pt-app (#pt-use polynomial-root-quotient ()) Carrier coefficient-ring root polynomial))
        (#pt-construct
          finite-list
          ()
          (Carrier)
          cons
          (
            (#pt-app
              (#pt-use polynomial-root-remainder ())
              Carrier
              coefficient-ring
              root
              polynomial)
            (#pt-construct finite-list () (Carrier) nil ())))
        (#pt-app
          (#pt-use ring-polynomial-multiply ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
          (#pt-app (#pt-use polynomial-root-quotient ()) Carrier coefficient-ring root polynomial))
        (#pt-construct
          finite-list
          ()
          (Carrier)
          cons
          (
            (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring polynomial root)
            (#pt-construct finite-list () (Carrier) nil ())))
        (#pt-app
          (#pt-use ring-polynomial-reflexive ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-multiply ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
            (#pt-app (#pt-use polynomial-root-quotient ()) Carrier coefficient-ring root polynomial)))
        (#pt-app
          (#pt-use ring-polynomial-cons-congruent ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-remainder ()) Carrier coefficient-ring root polynomial)
          (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring polynomial root)
          (#pt-construct finite-list () (Carrier) nil ())
          (#pt-construct finite-list () (Carrier) nil ())
          (#pt-app
            (#pt-use polynomial-root-remainder-evaluation ())
            Carrier
            coefficient-ring
            root
            polynomial)
          (#pt-app
            (#pt-use ring-polynomial-reflexive ())
            Carrier
            coefficient-ring
            (#pt-construct finite-list () (Carrier) nil ())))))))
