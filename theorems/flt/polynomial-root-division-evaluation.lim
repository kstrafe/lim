; Replace the proved computed remainder
; with actual evaluation in the division equation. This is the
; root-factor identity with its scalar remainder retained.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias
