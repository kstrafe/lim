(#theorem cubic-solution-remove-prime
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter third #pt-nat)
    (#parameter prime-number #pt-nat)
    (#parameter reduced-first #pt-nat)
    (#parameter reduced-second #pt-nat)
    (#parameter reduced-third #pt-nat)
    (#parameter solution (#pt-app (#pt-use natural-cubic-solution ()) first second third))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter first-equation (#pt-eq #pt-nat first (#pt-app (#pt-use multiply ()) prime-number reduced-first)))
    (#parameter second-equation (#pt-eq #pt-nat second (#pt-app (#pt-use multiply ()) prime-number reduced-second)))
    (#parameter third-equation (#pt-eq #pt-nat third (#pt-app (#pt-use multiply ()) prime-number reduced-third))))
  (#statement
    (#pt-app (#pt-use natural-cubic-solution ()) reduced-first reduced-second reduced-third))
  (#proof
    (#pt-construct
      natural-cubic-solution
      ()
      (reduced-first reduced-second reduced-third)
      introduce
      (
        (#pt-app
          (#pt-use natural-factor-nonzero ())
          first
          prime-number
          reduced-first
          (#pt-project natural-cubic-solution 0 solution)
          first-equation)
        (#pt-app
          (#pt-use natural-factor-nonzero ())
          second
          prime-number
          reduced-second
          (#pt-project natural-cubic-solution 1 solution)
          second-equation)
        (#pt-app
          (#pt-use natural-factor-nonzero ())
          third
          prime-number
          reduced-third
          (#pt-project natural-cubic-solution 2 solution)
          third-equation)
        (#pt-app
          (#pt-use cubic-remove-common-factor ())
          first
          second
          third
          prime-number
          reduced-first
          reduced-second
          reduced-third
          (#pt-app
            (#pt-use less-than-upper-nonzero ())
            (#pt-succ #pt-zero)
            prime-number
            (#pt-app (#pt-use prime-larger-than-one ()) prime-number prime-proof))
          (#pt-project natural-cubic-solution 3 solution)
          first-equation
          second-equation
          third-equation)))))
(#theorem cubic-common-prime-descends
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter third #pt-nat)
    (#parameter solution (#pt-app (#pt-use natural-cubic-solution ()) first second third))
    (#parameter prime-number #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter first-divides (#pt-app (#pt-use divides ()) prime-number first))
    (#parameter second-divides (#pt-app (#pt-use divides ()) prime-number second)))
  (#statement (#pt-app (#pt-use has-smaller-natural-cubic ()) third))
  (#proof
    (#pt-induct
      exists
      (0)
