(#theorem natural-factor-nonzero
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter factor #pt-nat)
    (#parameter reduced-value #pt-nat)
    (#parameter original-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat first #pt-zero))) #pt-false))
    (#parameter factor-equation (#pt-eq #pt-nat first (#pt-app (#pt-use multiply ()) factor reduced-value))))
  (#statement (#pt-pi ((denied-proof (#pt-eq #pt-nat reduced-value #pt-zero))) #pt-false))
  (#proof
    (#pt-lambda
      ((reduced-zero (#pt-eq #pt-nat reduced-value #pt-zero)))
      (#pt-app
        original-nonzero
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          first
          (#pt-app (#pt-use multiply ()) factor #pt-zero)
          #pt-zero
          (#pt-app
            (#pt-use transitivity (0))
            #pt-nat
            first
            (#pt-app (#pt-use multiply ()) factor reduced-value)
            (#pt-app (#pt-use multiply ()) factor #pt-zero)
            factor-equation
            (#pt-app
              (#pt-use congruence (0 0))
              #pt-nat
              #pt-nat
              (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use multiply ()) factor endpoint))
              reduced-value
              #pt-zero
              reduced-zero))
          (#pt-app (#pt-use multiply-zero-right ()) factor))))))
(#theorem cubic-common-prime-divides-third
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter third #pt-nat)
    (#parameter prime-number #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter cubic-equation (#pt-eq #pt-nat (#pt-app (#pt-use add ()) (#pt-app (#pt-use cube ()) first) (#pt-app (#pt-use cube ()) second)) (#pt-app (#pt-use cube ()) third)))
    (#parameter first-divides (#pt-app (#pt-use divides ()) prime-number first))
    (#parameter second-divides (#pt-app (#pt-use divides ()) prime-number second)))
  (#statement (#pt-app (#pt-use divides ()) prime-number third))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use divides ()) prime-number third)
      (#pt-app (#pt-use divides ()) prime-number (#pt-app (#pt-use multiply ()) third third))
      (#pt-app (#pt-use divides ()) prime-number third)
      (#pt-lambda ((third-factor (#pt-app (#pt-use divides ()) prime-number third))) third-factor)
      (#pt-lambda
        (
          (square-factor
            (#pt-app (#pt-use divides ()) prime-number (#pt-app (#pt-use multiply ()) third third))))
        (#pt-app (#pt-use prime-divides-square ()) prime-number third prime-proof square-factor))
      (#pt-app
        (#pt-use prime-divides-product ())
        prime-number
        third
        (#pt-app (#pt-use multiply ()) third third)
        prime-proof
        (#pt-app
          (#pt-use substitution (0))
          #pt-nat
          (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use divides ()) prime-number endpoint))
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use cube ()) first)
            (#pt-app (#pt-use cube ()) second))
          (#pt-app (#pt-use cube ()) third)
          cubic-equation
          (#pt-app
            (#pt-use divides-add ())
            prime-number
            (#pt-app (#pt-use cube ()) first)
            (#pt-app (#pt-use cube ()) second)
            (#pt-app
              (#pt-use divides-transitive ())
              prime-number
              first
              (#pt-app (#pt-use cube ()) first)
              first-divides
              (#pt-app
                (#pt-use divides-multiple ())
                first
                (#pt-app (#pt-use multiply ()) first first)))
            (#pt-app
              (#pt-use divides-transitive ())
              prime-number
              second
              (#pt-app (#pt-use cube ()) second)
              second-divides
              (#pt-app
                (#pt-use divides-multiple ())
                second
                (#pt-app (#pt-use multiply ()) second second)))))))))
