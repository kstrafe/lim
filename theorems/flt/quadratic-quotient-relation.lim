(#math-definition quadratic-quotient-equal ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (linear-coefficient Carrier)
      (constant-coefficient Carrier)
      (polynomial (#pt-app (#pt-use finite-list ()) Carrier))
      (other-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
    #pt-prop)
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (linear-coefficient Carrier)
      (constant-coefficient Carrier)
      (polynomial (#pt-app (#pt-use finite-list ()) Carrier))
      (other-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
    (#pt-app
      (#pt-use quadratic-quotient-divides ())
      Carrier
      coefficient-ring
      linear-coefficient
      constant-coefficient
      (#pt-app
        (#pt-use ring-polynomial-add ())
        Carrier
        coefficient-ring
        polynomial
        (#pt-app (#pt-use ring-polynomial-negate ()) Carrier coefficient-ring other-polynomial)))))
(#theorem quadratic-quotient-difference-evaluation
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter linear-coefficient Carrier)
