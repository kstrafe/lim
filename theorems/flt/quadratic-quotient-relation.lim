          (#pt-use ring-polynomial-add ())
          Carrier
          coefficient-ring
          polynomial
          (#pt-app (#pt-use ring-polynomial-negate ()) Carrier coefficient-ring other-polynomial)))
      (#pt-app
        (#pt-use ring-add ())
