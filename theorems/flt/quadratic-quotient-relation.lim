      (#pt-app
        (#pt-use ring-add ())
        (#pt-app (#pt-use quadratic-element ()) Carrier)
        (#pt-app
          (#pt-use quadratic-ring-structure ())
          Carrier
          coefficient-ring
          linear-coefficient
          constant-coefficient)
        (#pt-app
          (#pt-use quadratic-quotient-evaluate ())
          Carrier
          coefficient-ring
          linear-coefficient
          constant-coefficient
          polynomial)
        (#pt-app
