(#theorem eisenstein-lambda-multiply-normal
  (#universes)
  (#parameters
    (#parameter factor (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) factor)
      (#pt-construct
        eisenstein
        ()
        ()
        pair
        (
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-project eisenstein 0 factor)
              (#pt-project eisenstein 1 factor)))
          (#pt-app
            (#pt-use integer-add ())
            (#pt-project eisenstein 0 factor)
            (#pt-app
              (#pt-use integer-negate ())
              (#pt-app
                (#pt-use integer-add ())
                (#pt-project eisenstein 1 factor)
                (#pt-project eisenstein 1 factor))))))))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project
          eisenstein
          0
          (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) factor))
        (#pt-project
          eisenstein
          0
          (#pt-construct
            eisenstein
