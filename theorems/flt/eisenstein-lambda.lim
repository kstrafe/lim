                    (#pt-use integer-add ())
                    (#pt-project eisenstein 1 factor)
                    (#pt-project eisenstein 1 factor))))))))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-project
          eisenstein
          0
          (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) factor))
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 0 factor))
          (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor)))
        (#pt-project
          eisenstein
          0
          (#pt-construct
            eisenstein
            ()
            ()
            pair
            (
              (#pt-app
                (#pt-use integer-negate ())
                (#pt-app
                  (#pt-use integer-add ())
                  (#pt-project eisenstein 0 factor)
                  (#pt-project eisenstein 1 factor)))
              (#pt-app
                (#pt-use integer-add ())
                (#pt-project eisenstein 0 factor)
                (#pt-app
                  (#pt-use integer-negate ())
                  (#pt-app
                    (#pt-use integer-add ())
                    (#pt-project eisenstein 1 factor)
                    (#pt-project eisenstein 1 factor)))))))
        (#pt-app
          (#pt-use integer-add-congruent ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))
            (#pt-project eisenstein 0 factor))
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-use integer-one ())
              (#pt-project eisenstein 1 factor)))
          (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 0 factor))
          (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor))
          (#pt-app (#pt-use integer-minus-one-multiply ()) (#pt-project eisenstein 0 factor))
          (#pt-app
            (#pt-use integer-negate-congruent ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-use integer-one ())
              (#pt-project eisenstein 1 factor))
            (#pt-project eisenstein 1 factor)
            (#pt-app (#pt-use integer-one-multiply ()) (#pt-project eisenstein 1 factor))))
        (#pt-app
          (#pt-use integer-symmetric ())
          (#pt-project
            eisenstein
            0
            (#pt-construct
              eisenstein
              ()
              ()
              pair
              (
                (#pt-app
                  (#pt-use integer-negate ())
                  (#pt-app
                    (#pt-use integer-add ())
                    (#pt-project eisenstein 0 factor)
                    (#pt-project eisenstein 1 factor)))
                (#pt-app
                  (#pt-use integer-add ())
                  (#pt-project eisenstein 0 factor)
                  (#pt-app
                    (#pt-use integer-negate ())
                    (#pt-app
                      (#pt-use integer-add ())
                      (#pt-project eisenstein 1 factor)
                      (#pt-project eisenstein 1 factor)))))))
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 0 factor))
            (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor)))
          (#pt-app
            (#pt-use integer-negate-add ())
            (#pt-project eisenstein 0 factor)
            (#pt-project eisenstein 1 factor))))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-project
          eisenstein
          1
          (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) factor))
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor))
            (#pt-project eisenstein 0 factor))
          (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor)))
        (#pt-project
          eisenstein
          1
          (#pt-construct
            eisenstein
            ()
            ()
            pair
            (
              (#pt-app
                (#pt-use integer-negate ())
                (#pt-app
                  (#pt-use integer-add ())
                  (#pt-project eisenstein 0 factor)
                  (#pt-project eisenstein 1 factor)))
              (#pt-app
                (#pt-use integer-add ())
                (#pt-project eisenstein 0 factor)
                (#pt-app
                  (#pt-use integer-negate ())
                  (#pt-app
                    (#pt-use integer-add ())
                    (#pt-project eisenstein 1 factor)
                    (#pt-project eisenstein 1 factor)))))))
        (#pt-app
          (#pt-use integer-add-congruent ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))
              (#pt-project eisenstein 1 factor))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-use integer-one ())
              (#pt-project eisenstein 0 factor)))
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-use integer-one ())
              (#pt-project eisenstein 1 factor)))
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor))
            (#pt-project eisenstein 0 factor))
          (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor))
          (#pt-app
            (#pt-use integer-add-congruent ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))
              (#pt-project eisenstein 1 factor))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-use integer-one ())
              (#pt-project eisenstein 0 factor))
            (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor))
            (#pt-project eisenstein 0 factor)
            (#pt-app (#pt-use integer-minus-one-multiply ()) (#pt-project eisenstein 1 factor))
            (#pt-app (#pt-use integer-one-multiply ()) (#pt-project eisenstein 0 factor)))
          (#pt-app
            (#pt-use integer-negate-congruent ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-use integer-one ())
              (#pt-project eisenstein 1 factor))
            (#pt-project eisenstein 1 factor)
            (#pt-app (#pt-use integer-one-multiply ()) (#pt-project eisenstein 1 factor))))
        (#pt-app
          (#pt-use integer-transitive ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor))
              (#pt-project eisenstein 0 factor))
            (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor)))
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-project eisenstein 0 factor)
              (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor)))
            (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor)))
          (#pt-project
            eisenstein
            1
            (#pt-construct
              eisenstein
              ()
              ()
              pair
              (
                (#pt-app
                  (#pt-use integer-negate ())
                  (#pt-app
                    (#pt-use integer-add ())
                    (#pt-project eisenstein 0 factor)
                    (#pt-project eisenstein 1 factor)))
                (#pt-app
                  (#pt-use integer-add ())
                  (#pt-project eisenstein 0 factor)
                  (#pt-app
                    (#pt-use integer-negate ())
                    (#pt-app
                      (#pt-use integer-add ())
                      (#pt-project eisenstein 1 factor)
                      (#pt-project eisenstein 1 factor)))))))
          (#pt-app
            (#pt-use integer-add-congruent ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor))
              (#pt-project eisenstein 0 factor))
            (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor))
            (#pt-app
              (#pt-use integer-add ())
              (#pt-project eisenstein 0 factor)
              (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor)))
            (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor))
            (#pt-app
              (#pt-use integer-add-commutative ())
              (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor))
              (#pt-project eisenstein 0 factor))
            (#pt-app
              (#pt-use integer-reflexive ())
              (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor))))
          (#pt-app
            (#pt-use integer-transitive ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-add ())
                (#pt-project eisenstein 0 factor)
                (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor)))
              (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor)))
            (#pt-app
              (#pt-use integer-add ())
              (#pt-project eisenstein 0 factor)
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor))
                (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor))))
            (#pt-project
              eisenstein
              1
              (#pt-construct
                eisenstein
                ()
                ()
                pair
                (
                  (#pt-app
                    (#pt-use integer-negate ())
                    (#pt-app
                      (#pt-use integer-add ())
                      (#pt-project eisenstein 0 factor)
                      (#pt-project eisenstein 1 factor)))
                  (#pt-app
                    (#pt-use integer-add ())
                    (#pt-project eisenstein 0 factor)
                    (#pt-app
                      (#pt-use integer-negate ())
                      (#pt-app
                        (#pt-use integer-add ())
                        (#pt-project eisenstein 1 factor)
                        (#pt-project eisenstein 1 factor)))))))
            (#pt-app
              (#pt-use integer-add-associative ())
              (#pt-project eisenstein 0 factor)
              (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor))
              (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor)))
            (#pt-app
              (#pt-use integer-add-congruent ())
              (#pt-project eisenstein 0 factor)
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor))
                (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor)))
              (#pt-project eisenstein 0 factor)
              (#pt-app
                (#pt-use integer-negate ())
                (#pt-app
                  (#pt-use integer-add ())
                  (#pt-project eisenstein 1 factor)
                  (#pt-project eisenstein 1 factor)))
              (#pt-app (#pt-use integer-reflexive ()) (#pt-project eisenstein 0 factor))
              (#pt-app
                (#pt-use integer-symmetric ())
                (#pt-app
                  (#pt-use integer-negate ())
                  (#pt-app
                    (#pt-use integer-add ())
                    (#pt-project eisenstein 1 factor)
                    (#pt-project eisenstein 1 factor)))
                (#pt-app
                  (#pt-use integer-add ())
                  (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor))
                  (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor)))
                (#pt-app
                  (#pt-use integer-negate-add ())
                  (#pt-project eisenstein 1 factor)
                  (#pt-project eisenstein 1 factor))))))))))
(#theorem integer-three-divides-of-lambda
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter lambda-divides-proof (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) (#pt-app (#pt-use eisenstein-of-integer ()) number))))
  (#statement
    (#pt-app
      (#pt-use integer-divides ())
      (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
      number))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app (#pt-use eisenstein-of-integer ()) number)
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-use eisenstein-lambda ())
              candidate-factor))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-of-integer ()) number)
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-use eisenstein-lambda ())
                    candidate-factor))))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
          number))
      (
        (#pt-lambda
          (
            (factor (#pt-use eisenstein ()))
            (factor-equation
              (#pt-app
                (#pt-use eisenstein-equal ())
                (#pt-app (#pt-use eisenstein-of-integer ()) number)
                (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) factor))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use integer ())
              (#pt-lambda
                ((integer-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  number
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                    integer-factor))))
            introduce
            (
              (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor))
              (#pt-app
                (#pt-use integer-transitive ())
                number
                (#pt-app
                  (#pt-use integer-negate ())
                  (#pt-app
                    (#pt-use integer-add ())
                    (#pt-project eisenstein 0 factor)
                    (#pt-project eisenstein 1 factor)))
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor)))
                (#pt-app
                  (#pt-use conjunction-left ())
                  (#pt-app
                    (#pt-use integer-equal ())
                    (#pt-project eisenstein 0 (#pt-app (#pt-use eisenstein-of-integer ()) number))
                    (#pt-project
                      eisenstein
                      0
                      (#pt-construct
                        eisenstein
                        ()
                        ()
                        pair
                        (
                          (#pt-app
                            (#pt-use integer-negate ())
                            (#pt-app
                              (#pt-use integer-add ())
                              (#pt-project eisenstein 0 factor)
                              (#pt-project eisenstein 1 factor)))
                          (#pt-app
                            (#pt-use integer-add ())
                            (#pt-project eisenstein 0 factor)
                            (#pt-app
                              (#pt-use integer-negate ())
                              (#pt-app
                                (#pt-use integer-add ())
                                (#pt-project eisenstein 1 factor)
                                (#pt-project eisenstein 1 factor))))))))
                  (#pt-app
                    (#pt-use integer-equal ())
                    (#pt-project eisenstein 1 (#pt-app (#pt-use eisenstein-of-integer ()) number))
                    (#pt-project
                      eisenstein
                      1
                      (#pt-construct
                        eisenstein
                        ()
                        ()
                        pair
                        (
                          (#pt-app
                            (#pt-use integer-negate ())
                            (#pt-app
                              (#pt-use integer-add ())
                              (#pt-project eisenstein 0 factor)
                              (#pt-project eisenstein 1 factor)))
                          (#pt-app
                            (#pt-use integer-add ())
                            (#pt-project eisenstein 0 factor)
                            (#pt-app
                              (#pt-use integer-negate ())
                              (#pt-app
                                (#pt-use integer-add ())
                                (#pt-project eisenstein 1 factor)
                                (#pt-project eisenstein 1 factor))))))))
                  (#pt-app
                    (#pt-use eisenstein-transitive ())
                    (#pt-app (#pt-use eisenstein-of-integer ()) number)
                    (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) factor)
                    (#pt-construct
                      eisenstein
                      ()
                      ()
                      pair
                      (
                        (#pt-app
                          (#pt-use integer-negate ())
                          (#pt-app
                            (#pt-use integer-add ())
                            (#pt-project eisenstein 0 factor)
                            (#pt-project eisenstein 1 factor)))
                        (#pt-app
                          (#pt-use integer-add ())
                          (#pt-project eisenstein 0 factor)
                          (#pt-app
                            (#pt-use integer-negate ())
                            (#pt-app
                              (#pt-use integer-add ())
                              (#pt-project eisenstein 1 factor)
                              (#pt-project eisenstein 1 factor))))))
                    factor-equation
                    (#pt-app (#pt-use eisenstein-lambda-multiply-normal ()) factor)))
                (#pt-app
                  (#pt-use integer-transitive ())
                  (#pt-app
                    (#pt-use integer-negate ())
                    (#pt-app
                      (#pt-use integer-add ())
                      (#pt-project eisenstein 0 factor)
                      (#pt-project eisenstein 1 factor)))
                  (#pt-app
                    (#pt-use integer-negate ())
                    (#pt-app
                      (#pt-use integer-add ())
                      (#pt-app
                        (#pt-use integer-add ())
                        (#pt-project eisenstein 1 factor)
                        (#pt-project eisenstein 1 factor))
                      (#pt-project eisenstein 1 factor)))
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                    (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 factor)))
                  (#pt-app
                    (#pt-use integer-negate-congruent ())
                    (#pt-app
                      (#pt-use integer-add ())
                      (#pt-project eisenstein 0 factor)
                      (#pt-project eisenstein 1 factor))
                    (#pt-app
                      (#pt-use integer-add ())
                      (#pt-app
                        (#pt-use integer-add ())
                        (#pt-project eisenstein 1 factor)
                        (#pt-project eisenstein 1 factor))
                      (#pt-project eisenstein 1 factor))
                    (#pt-app
                      (#pt-use integer-add-congruent ())
                      (#pt-project eisenstein 0 factor)
                      (#pt-project eisenstein 1 factor)
                      (#pt-app
                        (#pt-use integer-add ())
                        (#pt-project eisenstein 1 factor)
                        (#pt-project eisenstein 1 factor))
                      (#pt-project eisenstein 1 factor)
                      (#pt-app
                        (#pt-use integer-zero-difference ())
                        (#pt-project eisenstein 0 factor)
                        (#pt-app
                          (#pt-use integer-add ())
                          (#pt-project eisenstein 1 factor)
                          (#pt-project eisenstein 1 factor))
                        (#pt-app
                          (#pt-use integer-symmetric ())
                          (#pt-use integer-zero ())
                          (#pt-app
                            (#pt-use integer-add ())
                            (#pt-project eisenstein 0 factor)
                            (#pt-app
