      (#pt-app (#pt-use rational-weierstrass-b4 ()) first-curve)
      (#pt-app (#pt-use rational-weierstrass-b4 ()) second-curve)))
  (#proof
    (#pt-app
      (#pt-use rational-add-congruent ())
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
        (#pt-project rational-weierstrass-curve 3 first-curve))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-project rational-weierstrass-curve 0 first-curve)
        (#pt-project rational-weierstrass-curve 2 first-curve))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
        (#pt-project rational-weierstrass-curve 3 second-curve))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-project rational-weierstrass-curve 0 second-curve)
        (#pt-project rational-weierstrass-curve 2 second-curve))
      (#pt-app
        (#pt-use rational-multiply-congruent ())
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
        (#pt-project rational-weierstrass-curve 3 first-curve)
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
        (#pt-project rational-weierstrass-curve 3 second-curve)
        (#pt-app
          (#pt-use rational-reflexive ())
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))))
        (#pt-project
          conjunction
          0
          (#pt-project
            conjunction
            1
            (#pt-project conjunction 1 (#pt-project conjunction 1 coefficient-agreement)))))
      (#pt-app
        (#pt-use rational-multiply-congruent ())
        (#pt-project rational-weierstrass-curve 0 first-curve)
        (#pt-project rational-weierstrass-curve 2 first-curve)
        (#pt-project rational-weierstrass-curve 0 second-curve)
        (#pt-project rational-weierstrass-curve 2 second-curve)
        (#pt-project conjunction 0 coefficient-agreement)
        (#pt-project
          conjunction
          0
          (#pt-project conjunction 1 (#pt-project conjunction 1 coefficient-agreement)))))))
