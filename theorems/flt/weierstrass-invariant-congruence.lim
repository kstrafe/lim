; Every actual Weierstrass invariant respects coefficientwise rational
; equivalence. Explicit sign/add/product/power congruence certificates
; prove all seven polynomials; no field or curve-identity axiom.
(#alias add = ./../fermat_statement.lim::add)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias rational-equal = ./rational-defs.lim::rational-equal)
(#alias rational-of-integer = ./rational-defs.lim::rational-of-integer)
(#alias rational-add = ./rational-defs.lim::rational-add)
(#alias rational-multiply = ./rational-defs.lim::rational-multiply)
(#alias rational-negate = ./rational-defs.lim::rational-negate)
(#alias rational-power = ./rational-defs.lim::rational-power)
(#alias rational-reflexive = ./rational-equality.lim::rational-reflexive)
(#alias rational-add-congruent = ./rational-congruence.lim::rational-add-congruent)
(#alias rational-multiply-congruent = ./rational-congruence.lim::rational-multiply-congruent)
(#alias rational-weierstrass-curve = ./rational-weierstrass-defs.lim::rational-weierstrass-curve)
(#alias rational-weierstrass-b2 = ./rational-weierstrass-defs.lim::rational-weierstrass-b2)
(#alias rational-weierstrass-b4 = ./rational-weierstrass-defs.lim::rational-weierstrass-b4)
(#alias rational-weierstrass-b6 = ./rational-weierstrass-defs.lim::rational-weierstrass-b6)
(#alias rational-weierstrass-b8 = ./rational-weierstrass-defs.lim::rational-weierstrass-b8)
(#alias rational-weierstrass-c4 = ./rational-weierstrass-defs.lim::rational-weierstrass-c4)
(#alias rational-weierstrass-c6 = ./rational-weierstrass-defs.lim::rational-weierstrass-c6)
(#alias
  rational-weierstrass-discriminant
  =
  ./rational-weierstrass-defs.lim::rational-weierstrass-discriminant)
(#alias rational-negate-congruent = ./rational-congruence.lim::rational-negate-congruent)
(#alias rational-power-congruent = ./rational-fractions.lim::rational-power-congruent)
(#alias
  rational-weierstrass-equivalent
  =
  ./weierstrass-model-equivalence.lim::rational-weierstrass-equivalent)
(#theorem rational-weierstrass-b2-congruent
  (#universes)
  (#parameters
    (#parameter first-curve (#pt-use rational-weierstrass-curve ()))
    (#parameter second-curve (#pt-use rational-weierstrass-curve ()))
    (#parameter coefficient-agreement (#pt-app (#pt-use rational-weierstrass-equivalent ()) first-curve second-curve)))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app (#pt-use rational-weierstrass-b2 ()) first-curve)
      (#pt-app (#pt-use rational-weierstrass-b2 ()) second-curve)))
  (#proof
    (#pt-app
      (#pt-use rational-add-congruent ())
      (#pt-app
        (#pt-use rational-power ())
        (#pt-project rational-weierstrass-curve 0 first-curve)
        (#pt-numeral 2))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
        (#pt-project rational-weierstrass-curve 1 first-curve))
      (#pt-app
        (#pt-use rational-power ())
        (#pt-project rational-weierstrass-curve 0 second-curve)
        (#pt-numeral 2))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
        (#pt-project rational-weierstrass-curve 1 second-curve))
      (#pt-app
        (#pt-use rational-power-congruent ())
        (#pt-project rational-weierstrass-curve 0 first-curve)
        (#pt-project rational-weierstrass-curve 0 second-curve)
        (#pt-numeral 2)
        (#pt-project conjunction 0 coefficient-agreement))
      (#pt-app
        (#pt-use rational-multiply-congruent ())
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
        (#pt-project rational-weierstrass-curve 1 first-curve)
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
        (#pt-project rational-weierstrass-curve 1 second-curve)
        (#pt-app
          (#pt-use rational-reflexive ())
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))))
        (#pt-project conjunction 0 (#pt-project conjunction 1 coefficient-agreement))))))
(#theorem rational-weierstrass-b4-congruent
  (#universes)
  (#parameters
    (#parameter first-curve (#pt-use rational-weierstrass-curve ()))
    (#parameter second-curve (#pt-use rational-weierstrass-curve ()))
