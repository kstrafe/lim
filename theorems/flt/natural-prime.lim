; Constructive prime-factor existence from the least nontrivial divisor.
; Prime uses the no-proper-nonunit-divisor characterization in
; Mathlib/Data/Nat/Prime/Defs.lean:114-122 (Nat.prime_def_lt').
; This directly ports its minimal-divisor argument rather than Lean's sqrt search.
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias divides-transitive = ./natural-divisibility.lim::divides-transitive)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias nontrivial-divisor = ./least-divisor.lim::nontrivial-divisor)
(#alias least-nontrivial-divisor = ./least-divisor.lim::least-nontrivial-divisor)
(#alias minimum = ./least-witness.lim::minimum)
(#alias has-minimum = ./least-witness.lim::has-minimum)
(#alias minimum-holds = ./least-witness.lim::minimum-holds)
(#alias minimum-excludes-earlier = ./least-witness.lim::minimum-excludes-earlier)
(#math-definition prime ()
  (#pt-pi ((number #pt-nat)) #pt-prop)
  (#pt-lambda
    ((number #pt-nat))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) number)
      (#pt-pi
        (
          (test-divisor #pt-nat)
          (nonunit-proof (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) test-divisor))
          (proper-proof (#pt-app (#pt-use less-than ()) test-divisor number))
          (divisor-proof (#pt-app (#pt-use divides ()) test-divisor number)))
        #pt-false))))
(#theorem least-divisor-is-prime
  (#universes)
  (#parameters
    (#parameter multiple #pt-nat)
    (#parameter least-divisor #pt-nat)
    (#parameter minimum-proof (#pt-app (#pt-use minimum ()) (#pt-lambda ((candidate #pt-nat)) (#pt-app (#pt-use nontrivial-divisor ()) multiple candidate)) least-divisor)))
  (#statement (#pt-app (#pt-use prime ()) least-divisor))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) least-divisor)
      (#pt-pi
        (
          (test-divisor #pt-nat)
          (nonunit-proof (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) test-divisor))
          (proper-proof (#pt-app (#pt-use less-than ()) test-divisor least-divisor))
          (divisor-proof (#pt-app (#pt-use divides ()) test-divisor least-divisor)))
        #pt-false)
      (#pt-app
        (#pt-use conjunction-left ())
        (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) least-divisor)
        (#pt-app (#pt-use divides ()) least-divisor multiple)
        (#pt-app
          (#pt-use minimum-holds ())
          (#pt-lambda
            ((candidate #pt-nat))
            (#pt-app (#pt-use nontrivial-divisor ()) multiple candidate))
          least-divisor
          minimum-proof))
      (#pt-lambda
        (
          (smaller-divisor #pt-nat)
          (smaller-nonunit (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) smaller-divisor))
          (smaller-proof (#pt-app (#pt-use less-than ()) smaller-divisor least-divisor))
          (smaller-divides (#pt-app (#pt-use divides ()) smaller-divisor least-divisor)))
        (#pt-app
          (#pt-app
            (#pt-use minimum-excludes-earlier ())
            (#pt-lambda
              ((candidate #pt-nat))
              (#pt-app (#pt-use nontrivial-divisor ()) multiple candidate))
            least-divisor
            minimum-proof
            smaller-divisor
            smaller-proof)
          (#pt-app
            (#pt-use conjunction-introduce ())
            (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) smaller-divisor)
            (#pt-app (#pt-use divides ()) smaller-divisor multiple)
            smaller-nonunit
            (#pt-app
              (#pt-use divides-transitive ())
              smaller-divisor
              least-divisor
              multiple
              smaller-divides
              (#pt-app
                (#pt-use conjunction-right ())
                (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) least-divisor)
                (#pt-app (#pt-use divides ()) least-divisor multiple)
                (#pt-app
                  (#pt-use minimum-holds ())
                  (#pt-lambda
                    ((candidate #pt-nat))
                    (#pt-app (#pt-use nontrivial-divisor ()) multiple candidate))
                  least-divisor
                  minimum-proof)))))))))
(#theorem exists-prime-divisor
  (#universes)
  (#parameters
    (#parameter multiple #pt-nat)
    (#parameter larger-than-one (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) multiple)))
  (#statement
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((prime-candidate #pt-nat))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app (#pt-use prime ()) prime-candidate)
          (#pt-app (#pt-use divides ()) prime-candidate multiple)))))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((minimum-candidate #pt-nat))
          (#pt-app
            (#pt-use minimum ())
            (#pt-lambda
              ((candidate #pt-nat))
              (#pt-app (#pt-use nontrivial-divisor ()) multiple candidate))
            minimum-candidate)))
      (#pt-lambda
        (
          (minimum-certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((minimum-candidate #pt-nat))
                (#pt-app
                  (#pt-use minimum ())
                  (#pt-lambda
                    ((candidate #pt-nat))
                    (#pt-app (#pt-use nontrivial-divisor ()) multiple candidate))
                  minimum-candidate)))))
        (#pt-app
          (#pt-use exists (0))
          #pt-nat
          (#pt-lambda
            ((prime-candidate #pt-nat))
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app (#pt-use prime ()) prime-candidate)
              (#pt-app (#pt-use divides ()) prime-candidate multiple)))))
      (
        (#pt-lambda
          (
            (least-divisor #pt-nat)
            (minimum-proof
              (#pt-app
                (#pt-use minimum ())
                (#pt-lambda
                  ((candidate #pt-nat))
                  (#pt-app (#pt-use nontrivial-divisor ()) multiple candidate))
                least-divisor)))
          (#pt-construct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((prime-candidate #pt-nat))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app (#pt-use prime ()) prime-candidate)
                  (#pt-app (#pt-use divides ()) prime-candidate multiple))))
            introduce
            (least-divisor
              (#pt-app
                (#pt-use conjunction-introduce ())
                (#pt-app (#pt-use prime ()) least-divisor)
                (#pt-app (#pt-use divides ()) least-divisor multiple)
                (#pt-app (#pt-use least-divisor-is-prime ()) multiple least-divisor minimum-proof)
                (#pt-app
                  (#pt-use conjunction-right ())
                  (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) least-divisor)
                  (#pt-app (#pt-use divides ()) least-divisor multiple)
                  (#pt-app
                    (#pt-use minimum-holds ())
                    (#pt-lambda
                      ((candidate #pt-nat))
                      (#pt-app (#pt-use nontrivial-divisor ()) multiple candidate))
                    least-divisor
                    minimum-proof)))))))
      (#pt-app (#pt-use least-nontrivial-divisor ()) multiple larger-than-one))))
(#theorem prime-larger-than-one
  (#universes)
  (#parameters
    (#parameter number #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) number)))
  (#statement (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) number))
  (#proof
    (#pt-app
      (#pt-use conjunction-left ())
      (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) number)
      (#pt-pi
        (
          (test-divisor #pt-nat)
          (nonunit-proof (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) test-divisor))
          (proper-proof (#pt-app (#pt-use less-than ()) test-divisor number))
          (divisor-proof (#pt-app (#pt-use divides ()) test-divisor number)))
        #pt-false)
      prime-proof)))
(#theorem prime-excludes-proper-divisor
  (#universes)
  (#parameters
    (#parameter number #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) number)))
  (#statement
    (#pt-pi
      (
        (test-divisor #pt-nat)
        (nonunit-proof (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) test-divisor))
        (proper-proof (#pt-app (#pt-use less-than ()) test-divisor number))
        (divisor-proof (#pt-app (#pt-use divides ()) test-divisor number)))
      #pt-false))
  (#proof
    (#pt-app
      (#pt-use conjunction-right ())
      (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) number)
      (#pt-pi
        (
          (test-divisor #pt-nat)
          (nonunit-proof (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) test-divisor))
          (proper-proof (#pt-app (#pt-use less-than ()) test-divisor number))
          (divisor-proof (#pt-app (#pt-use divides ()) test-divisor number)))
        #pt-false)
      prime-proof)))
