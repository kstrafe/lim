(#theorem rational-variable-change-identity-conversion-3
  (#universes)
  (#parameters
    (#parameter change (#pt-use rational-variable-change ()))
    (#parameter curve (#pt-use rational-weierstrass-curve ())))
  (#statement
    (#pt-eq
      (#pt-use rational ())
      (#pt-app
