  rational-variable-change-identity-coefficient-0
  =
  ./rational-variable-change-identity-polynomials.lim::rational-variable-change-identity-coefficient-0)
(#alias
  rational-variable-change-identity-coefficient-1
  =
  ./rational-variable-change-identity-polynomials.lim::rational-variable-change-identity-coefficient-1)
(#alias
  rational-variable-change-identity-coefficient-2
