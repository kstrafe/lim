(#theorem rational-variable-change-scale-unit
  (#universes)
  (#parameters
    (#parameter change (#pt-use rational-variable-change ())))
  (#statement
    (#pt-app (#pt-use rational-is-unit ()) (#pt-project rational-variable-change 0 change)))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use rational ())
        (#pt-lambda
          ((candidate-inverse (#pt-use rational ())))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-project rational-variable-change 0 change)
                candidate-inverse)
              (#pt-use rational-one ()))
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-app
                (#pt-use rational-multiply ())
                candidate-inverse
                (#pt-project rational-variable-change 0 change))
              (#pt-use rational-one ())))))
      introduce
      (
        (#pt-project rational-variable-change 1 change)
        (#pt-app
          (#pt-use conjunction-introduce ())
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-project rational-variable-change 0 change)
              (#pt-project rational-variable-change 1 change))
            (#pt-use rational-one ()))
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-project rational-variable-change 1 change)
              (#pt-project rational-variable-change 0 change))
            (#pt-use rational-one ()))
          (#pt-project rational-variable-change 5 change)
          (#pt-project rational-variable-change 6 change))))))
(#theorem rational-variable-change-inverse-scale-unit
  (#universes)
  (#parameters
    (#parameter change (#pt-use rational-variable-change ())))
  (#statement
    (#pt-app (#pt-use rational-is-unit ()) (#pt-project rational-variable-change 1 change)))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use rational ())
        (#pt-lambda
          ((candidate-inverse (#pt-use rational ())))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-project rational-variable-change 1 change)
                candidate-inverse)
              (#pt-use rational-one ()))
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-app
                (#pt-use rational-multiply ())
                candidate-inverse
                (#pt-project rational-variable-change 1 change))
              (#pt-use rational-one ())))))
      introduce
      (
        (#pt-project rational-variable-change 0 change)
        (#pt-app
          (#pt-use conjunction-introduce ())
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-project rational-variable-change 1 change)
              (#pt-project rational-variable-change 0 change))
            (#pt-use rational-one ()))
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-project rational-variable-change 0 change)
              (#pt-project rational-variable-change 1 change))
            (#pt-use rational-one ()))
          (#pt-project rational-variable-change 6 change)
          (#pt-project rational-variable-change 5 change))))))
(#theorem rational-variable-change-scale-nonzero
  (#universes)
  (#parameters
    (#parameter change (#pt-use rational-variable-change ())))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-project rational-variable-change 0 change)
            (#pt-use rational-zero ()))))
      #pt-false))
  (#proof
    (#pt-app
      (#pt-use rational-unit-is-nonzero ())
      (#pt-project rational-variable-change 0 change)
      (#pt-app (#pt-use rational-variable-change-scale-unit ()) change))))
(#theorem rational-variable-change-inverse-scale-nonzero
  (#universes)
  (#parameters
    (#parameter change (#pt-use rational-variable-change ())))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-project rational-variable-change 1 change)
            (#pt-use rational-zero ()))))
      #pt-false))
  (#proof
    (#pt-app
      (#pt-use rational-unit-is-nonzero ())
      (#pt-project rational-variable-change 1 change)
      (#pt-app (#pt-use rational-variable-change-inverse-scale-unit ()) change))))
(#math-definition rational-variable-change-inverse ()
  (#pt-pi ((change (#pt-use rational-variable-change ()))) (#pt-use rational-variable-change ()))
  (#pt-lambda
    ((change (#pt-use rational-variable-change ())))
    (#pt-construct
      rational-variable-change
      ()
      ()
      coordinates
      (
        (#pt-project rational-variable-change 1 change)
        (#pt-project rational-variable-change 0 change)
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app (#pt-use rational-negate ()) (#pt-project rational-variable-change 2 change))
          (#pt-app
            (#pt-use rational-power ())
            (#pt-project rational-variable-change 1 change)
            (#pt-numeral 2)))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app (#pt-use rational-negate ()) (#pt-project rational-variable-change 3 change))
          (#pt-project rational-variable-change 1 change))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-add ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-project rational-variable-change 2 change)
              (#pt-project rational-variable-change 3 change))
            (#pt-app (#pt-use rational-negate ()) (#pt-project rational-variable-change 4 change)))
          (#pt-app
            (#pt-use rational-power ())
            (#pt-project rational-variable-change 1 change)
            (#pt-numeral 3)))
        (#pt-project rational-variable-change 6 change)
        (#pt-project rational-variable-change 5 change)))))
(#theorem rational-variable-change-identity-conversion-0
  (#universes)
  (#parameters
    (#parameter change (#pt-use rational-variable-change ()))
    (#parameter curve (#pt-use rational-weierstrass-curve ())))
  (#statement
    (#pt-eq
      (#pt-use rational ())
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-project rational-variable-change 1 change)
        (#pt-app
          (#pt-use rational-add ())
          (#pt-project rational-weierstrass-curve 0 curve)
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
            (#pt-project rational-variable-change 3 change))))
      (#pt-project
        rational-weierstrass-curve
        0
        (#pt-app (#pt-use rational-variable-change-act ()) change curve))))
  (#proof
    (#pt-refl
      (#pt-use rational ())
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-project rational-variable-change 1 change)
        (#pt-app
          (#pt-use rational-add ())
          (#pt-project rational-weierstrass-curve 0 curve)
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
            (#pt-project rational-variable-change 3 change)))))))
(#theorem rational-variable-change-identity-projection-0
