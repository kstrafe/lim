        0
        (#pt-app
          (#pt-use rational-variable-change-act ())
          (#pt-use rational-variable-change-identity ())
          curve))
      (#pt-project rational-weierstrass-curve 0 curve)))
  (#proof
    (#pt-app
      (#pt-use substitution (0))
      (#pt-use rational ())
      (#pt-lambda
        ((coefficient-value (#pt-use rational ())))
        (#pt-app
          (#pt-use rational-equal ())
          coefficient-value
          (#pt-project rational-weierstrass-curve 0 curve)))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-project rational-variable-change 1 (#pt-use rational-variable-change-identity ()))
        (#pt-app
          (#pt-use rational-add ())
          (#pt-project rational-weierstrass-curve 0 curve)
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
            (#pt-project rational-variable-change 3 (#pt-use rational-variable-change-identity ())))))
      (#pt-project
        rational-weierstrass-curve
        0
        (#pt-app
          (#pt-use rational-variable-change-act ())
          (#pt-use rational-variable-change-identity ())
          curve))
      (#pt-app
        (#pt-use rational-variable-change-identity-conversion-0 ())
        (#pt-use rational-variable-change-identity ())
        curve)
      (#pt-app
        (#pt-use rational-variable-change-identity-coefficient-0 ())
        (#pt-project rational-weierstrass-curve 0 curve)
        (#pt-project rational-weierstrass-curve 1 curve)
        (#pt-project rational-weierstrass-curve 2 curve)
        (#pt-project rational-weierstrass-curve 3 curve)
        (#pt-project rational-weierstrass-curve 4 curve)))))
(#theorem rational-variable-change-identity-conversion-1
