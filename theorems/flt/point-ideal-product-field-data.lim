; Generated by scripts/generate-flt-point-ideal-products.py; checked native terms.
; A checked commutative field supplies
; one nonzero and an actual inverse witness for every nonzero
; element. These are data fields to be proved by each concrete
; instance, not global axioms or a desired ideal theorem.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias exists = ./logic-exists.lim::exists)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-one = ./commutative-ring-data.lim::ring-one)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#math-inductive point-ideal-product-field-data ()
  ((Carrier (#pt-type 0)) (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier)))
  (#pt-type 0)
  (
    (field
      (
        (one-nonzero
          (#pt-pi
            (
              (denied-evidence
                (#pt-app
                  (#pt-use ring-equal ())
                  Carrier
                  coefficient-ring
                  (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
                  (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
            #pt-false))
        (inverses
          (#pt-pi
            (
              (first Carrier)
              (nonzero
                (#pt-pi
                  (
                    (denied-evidence
                      (#pt-app
                        (#pt-use ring-equal ())
                        Carrier
                        coefficient-ring
                        first
                        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
                  #pt-false)))
            (#pt-app
              (#pt-use exists (0))
              Carrier
              (#pt-lambda
                ((inverse Carrier))
                (#pt-app
                  (#pt-use ring-equal ())
                  Carrier
                  coefficient-ring
                  (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first inverse)
                  (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring))))))))))
(#theorem point-ideal-product-field-one-nonzero
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter field-data (#pt-app (#pt-use point-ideal-product-field-data ()) Carrier coefficient-ring)))
  (#statement
    (#pt-pi
      (
        (denied-evidence
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
      #pt-false))
  (#proof (#pt-project point-ideal-product-field-data 0 field-data)))
(#theorem point-ideal-product-field-inverse
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter field-data (#pt-app (#pt-use point-ideal-product-field-data ()) Carrier coefficient-ring))
    (#parameter first Carrier)
    (#parameter nonzero (#pt-pi ((denied-evidence (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring first (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use exists (0))
      Carrier
      (#pt-lambda
        ((inverse Carrier))
        (#pt-app
          (#pt-use ring-equal ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first inverse)
          (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)))))
  (#proof (#pt-app (#pt-project point-ideal-product-field-data 1 field-data) first nonzero)))
