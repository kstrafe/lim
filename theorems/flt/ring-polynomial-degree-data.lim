(#theorem ring-polynomial-degree-data-zero
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter zero-equation (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring polynomial (#pt-construct finite-list () (Carrier) nil ()))))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app
        (#pt-use ring-polynomial-degree-data-natural ())
        Carrier
        coefficient-ring
        polynomial
        (#pt-construct
          ring-polynomial-degree-data
          ()
          (Carrier coefficient-ring polynomial)
          zero
          (zero-equation)))
      #pt-zero))
  (#proof (#pt-refl #pt-nat #pt-zero)))
