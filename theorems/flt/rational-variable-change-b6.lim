; Authors: Kevin Buzzard, David Kurniadi Angdinata, Jz Pan
; Native rational specialization of pinned Mathlib VariableChange.lean.
; Candidate proof terms are checked by Lim; no algebra oracle is used.
; Actual b6 transformation, proved from independent scale and
; translation certificates. No transformation law is a premise.
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias rational-equal = ./rational-defs.lim::rational-equal)
(#alias rational-of-integer = ./rational-defs.lim::rational-of-integer)
(#alias rational-add = ./rational-defs.lim::rational-add)
(#alias rational-multiply = ./rational-defs.lim::rational-multiply)
(#alias rational-negate = ./rational-defs.lim::rational-negate)
(#alias rational-power = ./rational-defs.lim::rational-power)
(#alias rational-reflexive = ./rational-equality.lim::rational-reflexive)
(#alias rational-transitive = ./rational-equality.lim::rational-transitive)
(#alias rational-multiply-congruent = ./rational-congruence.lim::rational-multiply-congruent)
(#alias rational-weierstrass-curve = ./rational-weierstrass-defs.lim::rational-weierstrass-curve)
(#alias rational-weierstrass-b2 = ./rational-weierstrass-defs.lim::rational-weierstrass-b2)
(#alias rational-weierstrass-b4 = ./rational-weierstrass-defs.lim::rational-weierstrass-b4)
(#alias rational-weierstrass-b6 = ./rational-weierstrass-defs.lim::rational-weierstrass-b6)
(#alias rational-variable-change = ./rational-variable-change-defs.lim::rational-variable-change)
(#alias
  rational-variable-change-act
  =
  ./rational-variable-change-defs.lim::rational-variable-change-act)
(#alias
  rational-variable-change-b6-scale-polynomial
  =
  ./rational-variable-change-b6-scale.lim::rational-variable-change-b6-scale-polynomial)
(#alias
  rational-variable-change-b6-translation-polynomial
  =
  ./rational-variable-change-b6-translation.lim::rational-variable-change-b6-translation-polynomial)
(#theorem rational-variable-change-b6
  (#universes)
  (#parameters
    (#parameter change (#pt-use rational-variable-change ()))
    (#parameter curve (#pt-use rational-weierstrass-curve ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-weierstrass-b6 ())
        (#pt-app (#pt-use rational-variable-change-act ()) change curve))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project rational-variable-change 1 change)
          (#pt-numeral 6))
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-add ())
            (#pt-app
              (#pt-use rational-add ())
              (#pt-app (#pt-use rational-weierstrass-b6 ()) curve)
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app
                    (#pt-use rational-of-integer ())
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
                  (#pt-project rational-variable-change 2 change))
                (#pt-app (#pt-use rational-weierstrass-b4 ()) curve)))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-project rational-variable-change 2 change)
                (#pt-numeral 2))
              (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
            (#pt-app
              (#pt-use rational-power ())
              (#pt-project rational-variable-change 2 change)
              (#pt-numeral 3)))))))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app
        (#pt-use rational-weierstrass-b6 ())
        (#pt-app (#pt-use rational-variable-change-act ()) change curve))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project rational-variable-change 1 change)
          (#pt-numeral 6))
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app
              (#pt-use rational-add ())
              (#pt-app
                (#pt-use rational-add ())
                (#pt-project rational-weierstrass-curve 2 curve)
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-project rational-variable-change 2 change)
                  (#pt-project rational-weierstrass-curve 0 curve)))
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-of-integer ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
                (#pt-project rational-variable-change 4 change)))
            (#pt-numeral 2))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
            (#pt-app
              (#pt-use rational-add ())
              (#pt-app
                (#pt-use rational-add ())
                (#pt-app
                  (#pt-use rational-add ())
                  (#pt-app
                    (#pt-use rational-add ())
                    (#pt-app
                      (#pt-use rational-add ())
                      (#pt-app
                        (#pt-use rational-add ())
                        (#pt-project rational-weierstrass-curve 4 curve)
                        (#pt-app
                          (#pt-use rational-multiply ())
                          (#pt-project rational-variable-change 2 change)
                          (#pt-project rational-weierstrass-curve 3 curve)))
                      (#pt-app
                        (#pt-use rational-multiply ())
                        (#pt-app
                          (#pt-use rational-power ())
                          (#pt-project rational-variable-change 2 change)
                          (#pt-numeral 2))
                        (#pt-project rational-weierstrass-curve 1 curve)))
                    (#pt-app
                      (#pt-use rational-power ())
                      (#pt-project rational-variable-change 2 change)
                      (#pt-numeral 3)))
                  (#pt-app
                    (#pt-use rational-negate ())
                    (#pt-app
                      (#pt-use rational-multiply ())
                      (#pt-project rational-variable-change 4 change)
                      (#pt-project rational-weierstrass-curve 2 curve))))
                (#pt-app
                  (#pt-use rational-negate ())
                  (#pt-app
                    (#pt-use rational-power ())
                    (#pt-project rational-variable-change 4 change)
                    (#pt-numeral 2))))
              (#pt-app
                (#pt-use rational-negate ())
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app
                    (#pt-use rational-multiply ())
                    (#pt-project rational-variable-change 2 change)
                    (#pt-project rational-variable-change 4 change))
                  (#pt-project rational-weierstrass-curve 0 curve)))))))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project rational-variable-change 1 change)
          (#pt-numeral 6))
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-add ())
            (#pt-app
              (#pt-use rational-add ())
              (#pt-app (#pt-use rational-weierstrass-b6 ()) curve)
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app
                    (#pt-use rational-of-integer ())
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
                  (#pt-project rational-variable-change 2 change))
                (#pt-app (#pt-use rational-weierstrass-b4 ()) curve)))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-project rational-variable-change 2 change)
                (#pt-numeral 2))
              (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
            (#pt-app
              (#pt-use rational-power ())
              (#pt-project rational-variable-change 2 change)
              (#pt-numeral 3)))))
      (#pt-app
        (#pt-use rational-variable-change-b6-scale-polynomial ())
        (#pt-project rational-variable-change 1 change)
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-add ())
            (#pt-project rational-weierstrass-curve 2 curve)
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-project rational-variable-change 2 change)
              (#pt-project rational-weierstrass-curve 0 curve)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
            (#pt-project rational-variable-change 4 change)))
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-add ())
            (#pt-app
              (#pt-use rational-add ())
              (#pt-app
                (#pt-use rational-add ())
                (#pt-app
                  (#pt-use rational-add ())
                  (#pt-app
                    (#pt-use rational-add ())
                    (#pt-project rational-weierstrass-curve 4 curve)
                    (#pt-app
                      (#pt-use rational-multiply ())
                      (#pt-project rational-variable-change 2 change)
                      (#pt-project rational-weierstrass-curve 3 curve)))
                  (#pt-app
                    (#pt-use rational-multiply ())
                    (#pt-app
                      (#pt-use rational-power ())
                      (#pt-project rational-variable-change 2 change)
                      (#pt-numeral 2))
                    (#pt-project rational-weierstrass-curve 1 curve)))
                (#pt-app
                  (#pt-use rational-power ())
                  (#pt-project rational-variable-change 2 change)
                  (#pt-numeral 3)))
              (#pt-app
                (#pt-use rational-negate ())
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-project rational-variable-change 4 change)
                  (#pt-project rational-weierstrass-curve 2 curve))))
            (#pt-app
              (#pt-use rational-negate ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-project rational-variable-change 4 change)
                (#pt-numeral 2))))
          (#pt-app
            (#pt-use rational-negate ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-project rational-variable-change 2 change)
                (#pt-project rational-variable-change 4 change))
              (#pt-project rational-weierstrass-curve 0 curve)))))
      (#pt-app
        (#pt-use rational-multiply-congruent ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project rational-variable-change 1 change)
          (#pt-numeral 6))
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app
              (#pt-use rational-add ())
              (#pt-app
                (#pt-use rational-add ())
                (#pt-project rational-weierstrass-curve 2 curve)
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-project rational-variable-change 2 change)
                  (#pt-project rational-weierstrass-curve 0 curve)))
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-of-integer ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
                (#pt-project rational-variable-change 4 change)))
            (#pt-numeral 2))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
            (#pt-app
              (#pt-use rational-add ())
              (#pt-app
                (#pt-use rational-add ())
                (#pt-app
                  (#pt-use rational-add ())
                  (#pt-app
                    (#pt-use rational-add ())
                    (#pt-app
                      (#pt-use rational-add ())
                      (#pt-app
                        (#pt-use rational-add ())
                        (#pt-project rational-weierstrass-curve 4 curve)
                        (#pt-app
                          (#pt-use rational-multiply ())
                          (#pt-project rational-variable-change 2 change)
                          (#pt-project rational-weierstrass-curve 3 curve)))
                      (#pt-app
                        (#pt-use rational-multiply ())
                        (#pt-app
                          (#pt-use rational-power ())
                          (#pt-project rational-variable-change 2 change)
                          (#pt-numeral 2))
                        (#pt-project rational-weierstrass-curve 1 curve)))
                    (#pt-app
                      (#pt-use rational-power ())
                      (#pt-project rational-variable-change 2 change)
                      (#pt-numeral 3)))
                  (#pt-app
                    (#pt-use rational-negate ())
                    (#pt-app
                      (#pt-use rational-multiply ())
                      (#pt-project rational-variable-change 4 change)
                      (#pt-project rational-weierstrass-curve 2 curve))))
                (#pt-app
                  (#pt-use rational-negate ())
                  (#pt-app
                    (#pt-use rational-power ())
                    (#pt-project rational-variable-change 4 change)
                    (#pt-numeral 2))))
              (#pt-app
                (#pt-use rational-negate ())
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app
                    (#pt-use rational-multiply ())
                    (#pt-project rational-variable-change 2 change)
                    (#pt-project rational-variable-change 4 change))
                  (#pt-project rational-weierstrass-curve 0 curve))))))
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project rational-variable-change 1 change)
          (#pt-numeral 6))
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-add ())
            (#pt-app
              (#pt-use rational-add ())
              (#pt-app (#pt-use rational-weierstrass-b6 ()) curve)
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app
                    (#pt-use rational-of-integer ())
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
                  (#pt-project rational-variable-change 2 change))
                (#pt-app (#pt-use rational-weierstrass-b4 ()) curve)))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-project rational-variable-change 2 change)
                (#pt-numeral 2))
              (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
            (#pt-app
              (#pt-use rational-power ())
              (#pt-project rational-variable-change 2 change)
              (#pt-numeral 3))))
        (#pt-app
          (#pt-use rational-reflexive ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-project rational-variable-change 1 change)
            (#pt-numeral 6)))
        (#pt-app
          (#pt-use rational-variable-change-b6-translation-polynomial ())
          (#pt-project rational-variable-change 2 change)
          (#pt-project rational-variable-change 4 change)
          (#pt-project rational-weierstrass-curve 0 curve)
          (#pt-project rational-weierstrass-curve 1 curve)
          (#pt-project rational-weierstrass-curve 2 curve)
          (#pt-project rational-weierstrass-curve 3 curve)
          (#pt-project rational-weierstrass-curve 4 curve))))))
