            finite-list
            ()
            (Carrier)
            cons
            (scalar (#pt-construct finite-list () (Carrier) nil ())))
          (#pt-app (#pt-use ring-polynomial-shift ()) Carrier coefficient-ring other-polynomial)))
      (#pt-app
