(#theorem ring-polynomial-multiply-right-congruent
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter second-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter fourth-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter equation (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring second-polynomial fourth-polynomial)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-multiply ())
        Carrier
        coefficient-ring
        polynomial
        second-polynomial)
      (#pt-app
        (#pt-use ring-polynomial-multiply ())
        Carrier
        coefficient-ring
        polynomial
        fourth-polynomial)))
  (#proof
    (#pt-induct
      finite-list
      ()
      (Carrier)
      (#pt-lambda
        ((selected-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
        (#pt-app
          (#pt-use ring-polynomial-equal ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-multiply ())
            Carrier
            coefficient-ring
            selected-polynomial
            second-polynomial)
          (#pt-app
            (#pt-use ring-polynomial-multiply ())
            Carrier
            coefficient-ring
            selected-polynomial
            fourth-polynomial)))
      (
        (#pt-app
          (#pt-use ring-polynomial-reflexive ())
          Carrier
          coefficient-ring
          (#pt-construct finite-list () (Carrier) nil ()))
        (#pt-lambda
          (
            (multiplication-head Carrier)
            (multiplication-tail (#pt-app (#pt-use finite-list ()) Carrier))
            (multiplication-result
              (#pt-app
                (#pt-use ring-polynomial-equal ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-polynomial-multiply ())
                  Carrier
                  coefficient-ring
                  multiplication-tail
                  second-polynomial)
                (#pt-app
                  (#pt-use ring-polynomial-multiply ())
                  Carrier
                  coefficient-ring
                  multiplication-tail
                  fourth-polynomial))))
          (#pt-app
            (#pt-use ring-polynomial-add-congruent ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-scale ())
              Carrier
              coefficient-ring
              multiplication-head
              second-polynomial)
            (#pt-app
              (#pt-use ring-polynomial-shift ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-multiply ())
                Carrier
                coefficient-ring
                multiplication-tail
                second-polynomial))
            (#pt-app
              (#pt-use ring-polynomial-scale ())
              Carrier
              coefficient-ring
              multiplication-head
              fourth-polynomial)
            (#pt-app
              (#pt-use ring-polynomial-shift ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-multiply ())
                Carrier
                coefficient-ring
                multiplication-tail
                fourth-polynomial))
            (#pt-app
              (#pt-use ring-polynomial-scale-congruent ())
              Carrier
              coefficient-ring
              multiplication-head
              multiplication-head
              second-polynomial
              fourth-polynomial
              (#pt-app (#pt-use ring-reflexive ()) Carrier coefficient-ring multiplication-head)
              equation)
            (#pt-app
              (#pt-use ring-polynomial-shift-congruent ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-multiply ())
                Carrier
                coefficient-ring
                multiplication-tail
                second-polynomial)
              (#pt-app
                (#pt-use ring-polynomial-multiply ())
                Carrier
                coefficient-ring
                multiplication-tail
                fourth-polynomial)
              multiplication-result))))
      polynomial)))
(#theorem ring-polynomial-multiply-constant
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter scalar Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-multiply ())
        Carrier
        coefficient-ring
        polynomial
        (#pt-construct
          finite-list
          ()
          (Carrier)
          cons
          (scalar (#pt-construct finite-list () (Carrier) nil ()))))
      (#pt-app (#pt-use ring-polynomial-scale ()) Carrier coefficient-ring scalar polynomial)))
  (#proof
    (#pt-induct
      finite-list
      ()
      (Carrier)
      (#pt-lambda
        ((selected-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
        (#pt-app
          (#pt-use ring-polynomial-equal ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-multiply ())
            Carrier
            coefficient-ring
            selected-polynomial
            (#pt-construct
              finite-list
              ()
              (Carrier)
              cons
              (scalar (#pt-construct finite-list () (Carrier) nil ()))))
          (#pt-app
            (#pt-use ring-polynomial-scale ())
            Carrier
            coefficient-ring
            scalar
            selected-polynomial)))
      (
        (#pt-app
          (#pt-use ring-polynomial-reflexive ())
          Carrier
          coefficient-ring
          (#pt-construct finite-list () (Carrier) nil ()))
        (#pt-lambda
          (
            (multiplication-head Carrier)
            (multiplication-tail (#pt-app (#pt-use finite-list ()) Carrier))
            (multiplication-result
              (#pt-app
                (#pt-use ring-polynomial-equal ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-polynomial-multiply ())
                  Carrier
                  coefficient-ring
                  multiplication-tail
                  (#pt-construct
                    finite-list
                    ()
                    (Carrier)
                    cons
                    (scalar (#pt-construct finite-list () (Carrier) nil ()))))
                (#pt-app
                  (#pt-use ring-polynomial-scale ())
                  Carrier
                  coefficient-ring
                  scalar
                  multiplication-tail))))
          (#pt-app
            (#pt-use ring-polynomial-cons-congruent ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-add ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-multiply ())
                Carrier
                coefficient-ring
                multiplication-head
                scalar)
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
            (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring scalar multiplication-head)
            (#pt-app
              (#pt-use ring-polynomial-multiply ())
              Carrier
              coefficient-ring
              multiplication-tail
              (#pt-construct
                finite-list
                ()
                (Carrier)
                cons
                (scalar (#pt-construct finite-list () (Carrier) nil ()))))
            (#pt-app
              (#pt-use ring-polynomial-scale ())
              Carrier
              coefficient-ring
              scalar
              multiplication-tail)
            (#pt-app
              (#pt-use ring-transitive ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-add ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-multiply ())
                  Carrier
                  coefficient-ring
                  multiplication-head
                  scalar)
                (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
              (#pt-app
                (#pt-use ring-multiply ())
                Carrier
                coefficient-ring
                multiplication-head
                scalar)
              (#pt-app
                (#pt-use ring-multiply ())
                Carrier
                coefficient-ring
                scalar
                multiplication-head)
              (#pt-app
                (#pt-use ring-add-zero ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-multiply ())
                  Carrier
                  coefficient-ring
                  multiplication-head
                  scalar))
              (#pt-app
                (#pt-use ring-multiply-commutative ())
                Carrier
                coefficient-ring
                multiplication-head
                scalar))
            multiplication-result)))
      polynomial)))
(#theorem ring-polynomial-cons-decomposition
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter scalar Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-equal ())
      Carrier
      coefficient-ring
      (#pt-construct finite-list () (Carrier) cons (scalar polynomial))
      (#pt-app
        (#pt-use ring-polynomial-add ())
        Carrier
        coefficient-ring
        (#pt-construct
          finite-list
          ()
          (Carrier)
          cons
          (scalar (#pt-construct finite-list () (Carrier) nil ())))
        (#pt-app (#pt-use ring-polynomial-shift ()) Carrier coefficient-ring polynomial))))
  (#proof
    (#pt-app
      (#pt-use ring-polynomial-cons-congruent ())
      Carrier
      coefficient-ring
      scalar
      (#pt-app
        (#pt-use ring-add ())
        Carrier
        coefficient-ring
        scalar
        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
      polynomial
      polynomial
      (#pt-app
        (#pt-use ring-symmetric ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-add ())
          Carrier
          coefficient-ring
          scalar
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
        scalar
        (#pt-app (#pt-use ring-add-zero ()) Carrier coefficient-ring scalar))
      (#pt-app (#pt-use ring-polynomial-reflexive ()) Carrier coefficient-ring polynomial))))
(#theorem ring-polynomial-multiply-cons
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter scalar Carrier)
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
  (#statement
