; Actual factors pass to signed product powers; explicit exponent
; gaps give prefix divisibility. Every quotient is constructed and
; zero divisors/exponents are retained. No factorization oracle.
(#alias add = ./../fermat_statement.lim::add)
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-one = ./integer-defs.lim::integer-one)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-power = ./integer-defs.lim::integer-power)
(#alias integer-divides = ./integer-defs.lim::integer-divides)
(#alias integer-reflexive = ./integer-equality.lim::integer-reflexive)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias add-successor-right = ./natural-addition.lim::add-successor-right)
(#alias integer-multiply-commutative = ./integer-multiplication.lim::integer-multiply-commutative)
(#alias integer-one-multiply = ./integer-bezout-algebra.lim::integer-one-multiply)
(#alias integer-divides-multiple = ./integer-divisibility.lim::integer-divides-multiple)
(#alias integer-divides-transitive = ./integer-divisibility.lim::integer-divides-transitive)
(#alias
  integer-divides-congruent-target
  =
  ./integer-divisibility.lim::integer-divides-congruent-target)
(#alias integer-power-congruent = ./integer-power-laws.lim::integer-power-congruent)
(#alias integer-power-product = ./integer-power-products.lim::integer-power-product)
(#alias integer-power-add = ./integer-power-sums.lim::integer-power-add)
(#theorem integer-divides-product-left
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use integer ()))
    (#parameter number (#pt-use integer ()))
    (#parameter factor (#pt-use integer ()))
    (#parameter divides-number (#pt-app (#pt-use integer-divides ()) divisor number)))
  (#statement
    (#pt-app
      (#pt-use integer-divides ())
      divisor
      (#pt-app (#pt-use integer-multiply ()) number factor)))
  (#proof
    (#pt-app
      (#pt-use integer-divides-transitive ())
      divisor
      number
      (#pt-app (#pt-use integer-multiply ()) number factor)
      divides-number
      (#pt-app (#pt-use integer-divides-multiple ()) number factor))))
(#theorem integer-divides-product-right
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use integer ()))
    (#parameter number (#pt-use integer ()))
    (#parameter factor (#pt-use integer ()))
    (#parameter divides-number (#pt-app (#pt-use integer-divides ()) divisor number)))
  (#statement
    (#pt-app
      (#pt-use integer-divides ())
      divisor
      (#pt-app (#pt-use integer-multiply ()) factor number)))
  (#proof
    (#pt-app
      (#pt-use integer-divides-congruent-target ())
      divisor
      (#pt-app (#pt-use integer-multiply ()) number factor)
      (#pt-app (#pt-use integer-multiply ()) factor number)
      (#pt-app (#pt-use integer-multiply-commutative ()) number factor)
      (#pt-app (#pt-use integer-divides-product-left ()) divisor number factor divides-number))))
(#theorem integer-divides-product-powers
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use integer ()))
    (#parameter number (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter divides-number (#pt-app (#pt-use integer-divides ()) divisor number)))
  (#statement
    (#pt-app
      (#pt-use integer-divides ())
      (#pt-app (#pt-use integer-power ()) divisor exponent)
      (#pt-app (#pt-use integer-power ()) number exponent)))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use integer ())
        (#pt-lambda
          ((candidate-factor (#pt-use integer ())))
          (#pt-app
            (#pt-use integer-equal ())
            number
            (#pt-app (#pt-use integer-multiply ()) divisor candidate-factor))))
      (#pt-lambda
        (
          (integer-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  number
                  (#pt-app (#pt-use integer-multiply ()) divisor candidate-factor))))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-power ()) divisor exponent)
          (#pt-app (#pt-use integer-power ()) number exponent)))
      (
        (#pt-lambda
          (
            (quotient (#pt-use integer ()))
            (quotient-equation
              (#pt-app
                (#pt-use integer-equal ())
                number
                (#pt-app (#pt-use integer-multiply ()) divisor quotient))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-app (#pt-use integer-power ()) number exponent)
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-app (#pt-use integer-power ()) divisor exponent)
                    candidate-factor))))
            introduce
            (
              (#pt-app (#pt-use integer-power ()) quotient exponent)
              (#pt-app
                (#pt-use integer-transitive ())
                (#pt-app (#pt-use integer-power ()) number exponent)
                (#pt-app
                  (#pt-use integer-power ())
                  (#pt-app (#pt-use integer-multiply ()) divisor quotient)
                  exponent)
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-power ()) divisor exponent)
                  (#pt-app (#pt-use integer-power ()) quotient exponent))
                (#pt-app
                  (#pt-use integer-power-congruent ())
                  number
                  (#pt-app (#pt-use integer-multiply ()) divisor quotient)
                  exponent
                  quotient-equation)
                (#pt-app (#pt-use integer-power-product ()) divisor quotient exponent))))))
      divides-number)))
(#theorem integer-power-prefix-divides
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter prefix-exponent #pt-nat)
    (#parameter remaining-exponent #pt-nat))
  (#statement
    (#pt-app
      (#pt-use integer-divides ())
      (#pt-app (#pt-use integer-power ()) number prefix-exponent)
      (#pt-app
        (#pt-use integer-power ())
        number
        (#pt-app (#pt-use add ()) prefix-exponent remaining-exponent))))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use integer ())
        (#pt-lambda
          ((candidate-factor (#pt-use integer ())))
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-app
              (#pt-use integer-power ())
              number
              (#pt-app (#pt-use add ()) prefix-exponent remaining-exponent))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-power ()) number prefix-exponent)
              candidate-factor))))
      introduce
      (
        (#pt-app (#pt-use integer-power ()) number remaining-exponent)
        (#pt-app (#pt-use integer-power-add ()) number prefix-exponent remaining-exponent)))))
(#theorem integer-power-strict-prefix-divides
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter prefix-exponent #pt-nat)
    (#parameter upper-exponent #pt-nat)
    (#parameter strict-bound (#pt-app (#pt-use less-than ()) prefix-exponent upper-exponent)))
  (#statement
    (#pt-app
      (#pt-use integer-divides ())
      (#pt-app (#pt-use integer-power ()) number prefix-exponent)
      (#pt-app (#pt-use integer-power ()) number upper-exponent)))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-gap #pt-nat))
          (#pt-eq
            #pt-nat
            upper-exponent
            (#pt-app (#pt-use add ()) (#pt-succ prefix-exponent) candidate-gap))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-gap #pt-nat))
                (#pt-eq
                  #pt-nat
                  upper-exponent
                  (#pt-app (#pt-use add ()) (#pt-succ prefix-exponent) candidate-gap))))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-power ()) number prefix-exponent)
          (#pt-app (#pt-use integer-power ()) number upper-exponent)))
      (
        (#pt-lambda
          (
            (gap #pt-nat)
            (gap-equation
              (#pt-eq
                #pt-nat
                upper-exponent
                (#pt-app (#pt-use add ()) (#pt-succ prefix-exponent) gap))))
          (#pt-eq-elim
            #pt-nat
            (#pt-app (#pt-use add ()) prefix-exponent (#pt-succ gap))
            (#pt-lambda
              (
                (transport-index #pt-nat)
                (transport-path
                  (#pt-eq
                    #pt-nat
                    (#pt-app (#pt-use add ()) prefix-exponent (#pt-succ gap))
                    transport-index)))
              (#pt-app
                (#pt-use integer-divides ())
                (#pt-app (#pt-use integer-power ()) number prefix-exponent)
                (#pt-app (#pt-use integer-power ()) number transport-index)))
            (#pt-app
              (#pt-use integer-power-prefix-divides ())
              number
              prefix-exponent
              (#pt-succ gap))
            upper-exponent
            (#pt-app
              (#pt-use transitivity (0))
              #pt-nat
              (#pt-app (#pt-use add ()) prefix-exponent (#pt-succ gap))
              (#pt-app (#pt-use add ()) (#pt-succ prefix-exponent) gap)
              upper-exponent
              (#pt-app (#pt-use add-successor-right ()) prefix-exponent gap)
              (#pt-app
                (#pt-use symmetry (0))
                #pt-nat
                upper-exponent
                (#pt-app (#pt-use add ()) (#pt-succ prefix-exponent) gap)
                gap-equation)))))
      strict-bound)))
(#theorem integer-one-power
  (#universes)
  (#parameters
    (#parameter exponent #pt-nat))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-power ()) (#pt-use integer-one ()) exponent)
      (#pt-use integer-one ())))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((index #pt-nat))
        (#pt-app
          (#pt-use integer-equal ())
          (#pt-app (#pt-use integer-power ()) (#pt-use integer-one ()) index)
          (#pt-use integer-one ())))
      (#pt-app (#pt-use integer-reflexive ()) (#pt-use integer-one ()))
      (#pt-lambda
        (
          (previous-exponent #pt-nat)
          (previous-one
            (#pt-app
              (#pt-use integer-equal ())
              (#pt-app (#pt-use integer-power ()) (#pt-use integer-one ()) previous-exponent)
              (#pt-use integer-one ()))))
        (#pt-app
          (#pt-use integer-transitive ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-use integer-one ())
            (#pt-app (#pt-use integer-power ()) (#pt-use integer-one ()) previous-exponent))
          (#pt-app (#pt-use integer-power ()) (#pt-use integer-one ()) previous-exponent)
          (#pt-use integer-one ())
          (#pt-app
            (#pt-use integer-one-multiply ())
            (#pt-app (#pt-use integer-power ()) (#pt-use integer-one ()) previous-exponent))
          previous-one))
      exponent)))
