; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Actual ideals are saturated membership predicates with
; checked zero/additive/negation/multiplication closures. Equality is
; mutual inclusion, so no function-extensionality or set equality axiom
; is introduced. Right multiplication follows from commutativity.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias ring-add = ./commutative-ring-data.lim::ring-add)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-multiply-commutative = ./commutative-ring-data.lim::ring-multiply-commutative)
(#alias ring-negate = ./commutative-ring-data.lim::ring-negate)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#math-inductive ring-ideal ()
  ((Carrier (#pt-type 0)) (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier)))
  (#pt-type 0)
  (
    (ideal
      (
        (membership (#pt-pi ((element Carrier)) #pt-prop))
        (saturated
          (#pt-pi
            (
              (first-element Carrier)
              (second-element Carrier)
              (equation
                (#pt-app
                  (#pt-use ring-equal ())
                  Carrier
                  coefficient-ring
                  first-element
                  second-element))
              (member (#pt-app membership first-element)))
            (#pt-app membership second-element)))
        (zero-member (#pt-app membership (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
        (add-members
          (#pt-pi
            (
              (first-element Carrier)
              (second-element Carrier)
              (first-member (#pt-app membership first-element))
              (second-member (#pt-app membership second-element)))
            (#pt-app
              membership
              (#pt-app (#pt-use ring-add ()) Carrier coefficient-ring first-element second-element))))
        (negate-member
          (#pt-pi
            ((first-element Carrier) (member (#pt-app membership first-element)))
            (#pt-app
              membership
              (#pt-app (#pt-use ring-negate ()) Carrier coefficient-ring first-element))))
        (multiply-member
          (#pt-pi
            (
              (coefficient Carrier)
              (first-element Carrier)
              (member (#pt-app membership first-element)))
            (#pt-app
              membership
              (#pt-app
                (#pt-use ring-multiply ())
                Carrier
                coefficient-ring
                coefficient
                first-element))))))))
(#math-definition ring-ideal-member ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
      (first-element Carrier))
    #pt-prop)
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
      (first-element Carrier))
    (#pt-app (#pt-project ring-ideal 0 first-ideal) first-element)))
(#math-definition ring-ideal-subset ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
      (second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
    #pt-prop)
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
      (second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
    (#pt-pi
      (
        (first-element Carrier)
        (member
          (#pt-app
            (#pt-use ring-ideal-member ())
            Carrier
            coefficient-ring
            first-ideal
            first-element)))
      (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring second-ideal first-element))))
(#math-definition ring-ideal-equal ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
      (second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
    #pt-prop)
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
      (second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app (#pt-use ring-ideal-subset ()) Carrier coefficient-ring first-ideal second-ideal)
      (#pt-app (#pt-use ring-ideal-subset ()) Carrier coefficient-ring second-ideal first-ideal))))
(#theorem ring-ideal-member-congruent
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter first-element Carrier)
    (#parameter second-element Carrier)
    (#parameter equation (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring first-element second-element))
    (#parameter member (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring first-ideal first-element)))
  (#statement
    (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring first-ideal second-element))
  (#proof
    (#pt-app (#pt-project ring-ideal 1 first-ideal) first-element second-element equation member)))
(#theorem ring-ideal-zero
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-member ())
      Carrier
      coefficient-ring
      first-ideal
      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
  (#proof (#pt-project ring-ideal 2 first-ideal)))
(#theorem ring-ideal-add
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter first-element Carrier)
    (#parameter second-element Carrier)
    (#parameter first-member (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring first-ideal first-element))
    (#parameter second-member (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring first-ideal second-element)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-member ())
      Carrier
      coefficient-ring
      first-ideal
      (#pt-app (#pt-use ring-add ()) Carrier coefficient-ring first-element second-element)))
  (#proof
    (#pt-app
      (#pt-project ring-ideal 3 first-ideal)
      first-element
      second-element
      first-member
      second-member)))
(#theorem ring-ideal-negate
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter first-element Carrier)
    (#parameter member (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring first-ideal first-element)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-member ())
      Carrier
      coefficient-ring
      first-ideal
      (#pt-app (#pt-use ring-negate ()) Carrier coefficient-ring first-element)))
  (#proof (#pt-app (#pt-project ring-ideal 4 first-ideal) first-element member)))
(#theorem ring-ideal-multiply-left
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter coefficient Carrier)
    (#parameter first-element Carrier)
    (#parameter member (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring first-ideal first-element)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-member ())
      Carrier
      coefficient-ring
      first-ideal
      (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring coefficient first-element)))
  (#proof (#pt-app (#pt-project ring-ideal 5 first-ideal) coefficient first-element member)))
(#theorem ring-ideal-multiply-right
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter first-element Carrier)
    (#parameter second-element Carrier)
    (#parameter member (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring first-ideal first-element)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-member ())
      Carrier
      coefficient-ring
      first-ideal
      (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element second-element)))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-member-congruent ())
      Carrier
      coefficient-ring
      first-ideal
      (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring second-element first-element)
      (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element second-element)
      (#pt-app
        (#pt-use ring-multiply-commutative ())
        Carrier
        coefficient-ring
        second-element
        first-element)
      (#pt-app
        (#pt-use ring-ideal-multiply-left ())
        Carrier
        coefficient-ring
        first-ideal
        second-element
        first-element
        member))))
