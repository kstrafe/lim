; Adapted mathematical source: pinned Mathlib RingTheory/AdjoinRoot.lean
; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean.
; Generated by scripts/generate-flt-quadratic-quotients.py; checked native terms.
; Actual evaluation sends Y to the computed quadratic generator.
; Every coordinate pair has its linear polynomial as a right inverse,
; and the defining monic quadratic evaluates to zero by checked ring laws.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias quadratic-Y = ./quadratic-algebra-data.lim::quadratic-Y)
(#alias quadratic-division-divisor = ./quadratic-division-data.lim::quadratic-division-divisor)
(#alias quadratic-element = ./quadratic-algebra-data.lim::quadratic-element)
(#alias quadratic-equal = ./quadratic-algebra-data.lim::quadratic-equal)
(#alias
  quadratic-quotient-coefficient-map
  =
  ./quadratic-quotient-coefficient-map.lim::quadratic-quotient-coefficient-map)
(#alias
  quadratic-quotient-divisor-zero-constant-identity
  =
  ./quadratic-quotient-divisor-zero-constant-identity.lim::quadratic-quotient-divisor-zero-constant-identity)
(#alias
  quadratic-quotient-divisor-zero-linear-identity
  =
  ./quadratic-quotient-divisor-zero-linear-identity.lim::quadratic-quotient-divisor-zero-linear-identity)
(#alias
  quadratic-quotient-linear-evaluation-constant-identity
  =
  ./quadratic-quotient-linear-evaluation-constant-identity.lim::quadratic-quotient-linear-evaluation-constant-identity)
(#alias
  quadratic-quotient-linear-evaluation-linear-identity
  =
  ./quadratic-quotient-linear-evaluation-linear-identity.lim::quadratic-quotient-linear-evaluation-linear-identity)
(#alias quadratic-ring-structure = ./quadratic-algebra-ring-structure.lim::quadratic-ring-structure)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-evaluation = ./ring-evaluation-data.lim::ring-evaluation)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#math-definition quadratic-quotient-evaluate ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (linear-coefficient Carrier)
      (constant-coefficient Carrier)
      (polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
    (#pt-app (#pt-use quadratic-element ()) Carrier))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (linear-coefficient Carrier)
      (constant-coefficient Carrier)
      (polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
    (#pt-app
      (#pt-use ring-evaluation ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use quadratic-element ()) Carrier)
      (#pt-app
        (#pt-use quadratic-ring-structure ())
        Carrier
        coefficient-ring
        linear-coefficient
        constant-coefficient)
      (#pt-app
        (#pt-use quadratic-quotient-coefficient-map ())
        Carrier
        coefficient-ring
        linear-coefficient
        constant-coefficient)
      (#pt-app (#pt-use quadratic-Y ()) Carrier coefficient-ring)
      polynomial)))
(#math-definition quadratic-quotient-linear ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (first-element (#pt-app (#pt-use quadratic-element ()) Carrier)))
    (#pt-app (#pt-use finite-list ()) Carrier))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (first-element (#pt-app (#pt-use quadratic-element ()) Carrier)))
    (#pt-construct
      finite-list
      ()
      (Carrier)
      cons
      (
        (#pt-project quadratic-element 0 first-element)
        (#pt-construct
          finite-list
          ()
          (Carrier)
          cons
          (
            (#pt-project quadratic-element 1 first-element)
            (#pt-construct finite-list () (Carrier) nil ())))))))
(#theorem quadratic-quotient-linear-evaluates
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter linear-coefficient Carrier)
    (#parameter constant-coefficient Carrier)
    (#parameter first-element (#pt-app (#pt-use quadratic-element ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use quadratic-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use quadratic-quotient-evaluate ())
        Carrier
        coefficient-ring
        linear-coefficient
        constant-coefficient
        (#pt-construct
          finite-list
          ()
          (Carrier)
          cons
          (
            (#pt-project quadratic-element 0 first-element)
            (#pt-construct
              finite-list
              ()
              (Carrier)
              cons
              (
                (#pt-project quadratic-element 1 first-element)
                (#pt-construct finite-list () (Carrier) nil ()))))))
      first-element))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-equal ())
        Carrier
        coefficient-ring
        (#pt-project
          quadratic-element
          0
          (#pt-app
            (#pt-use quadratic-quotient-evaluate ())
            Carrier
            coefficient-ring
            linear-coefficient
            constant-coefficient
            (#pt-construct
              finite-list
              ()
              (Carrier)
              cons
              (
                (#pt-project quadratic-element 0 first-element)
                (#pt-construct
                  finite-list
                  ()
                  (Carrier)
                  cons
                  (
                    (#pt-project quadratic-element 1 first-element)
                    (#pt-construct finite-list () (Carrier) nil ())))))))
        (#pt-project quadratic-element 0 first-element))
      (#pt-app
        (#pt-use ring-equal ())
        Carrier
        coefficient-ring
        (#pt-project
          quadratic-element
          1
          (#pt-app
            (#pt-use quadratic-quotient-evaluate ())
            Carrier
            coefficient-ring
            linear-coefficient
            constant-coefficient
            (#pt-construct
              finite-list
              ()
              (Carrier)
              cons
              (
                (#pt-project quadratic-element 0 first-element)
                (#pt-construct
                  finite-list
                  ()
                  (Carrier)
                  cons
                  (
                    (#pt-project quadratic-element 1 first-element)
                    (#pt-construct finite-list () (Carrier) nil ())))))))
        (#pt-project quadratic-element 1 first-element))
      (#pt-app
        (#pt-use quadratic-quotient-linear-evaluation-constant-identity ())
        Carrier
        coefficient-ring
        constant-coefficient
        (#pt-project quadratic-element 0 first-element)
        linear-coefficient
        (#pt-project quadratic-element 1 first-element))
      (#pt-app
        (#pt-use quadratic-quotient-linear-evaluation-linear-identity ())
        Carrier
        coefficient-ring
        constant-coefficient
        linear-coefficient
        (#pt-project quadratic-element 1 first-element)))))
(#theorem quadratic-quotient-divisor-evaluates-zero
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter linear-coefficient Carrier)
    (#parameter constant-coefficient Carrier))
  (#statement
    (#pt-app
      (#pt-use quadratic-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use quadratic-quotient-evaluate ())
        Carrier
        coefficient-ring
        linear-coefficient
        constant-coefficient
        (#pt-app
          (#pt-use quadratic-division-divisor ())
          Carrier
          coefficient-ring
          linear-coefficient
          constant-coefficient))
      (#pt-app
        (#pt-use ring-zero ())
        (#pt-app (#pt-use quadratic-element ()) Carrier)
        (#pt-app
          (#pt-use quadratic-ring-structure ())
          Carrier
          coefficient-ring
          linear-coefficient
          constant-coefficient))))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-equal ())
        Carrier
        coefficient-ring
        (#pt-project
          quadratic-element
          0
          (#pt-app
            (#pt-use quadratic-quotient-evaluate ())
            Carrier
            coefficient-ring
            linear-coefficient
            constant-coefficient
            (#pt-app
              (#pt-use quadratic-division-divisor ())
              Carrier
              coefficient-ring
              linear-coefficient
              constant-coefficient)))
        (#pt-project
          quadratic-element
          0
          (#pt-app
            (#pt-use ring-zero ())
            (#pt-app (#pt-use quadratic-element ()) Carrier)
            (#pt-app
              (#pt-use quadratic-ring-structure ())
              Carrier
              coefficient-ring
              linear-coefficient
              constant-coefficient))))
      (#pt-app
        (#pt-use ring-equal ())
        Carrier
        coefficient-ring
        (#pt-project
          quadratic-element
          1
          (#pt-app
            (#pt-use quadratic-quotient-evaluate ())
            Carrier
            coefficient-ring
            linear-coefficient
            constant-coefficient
            (#pt-app
              (#pt-use quadratic-division-divisor ())
              Carrier
              coefficient-ring
              linear-coefficient
              constant-coefficient)))
        (#pt-project
          quadratic-element
          1
          (#pt-app
            (#pt-use ring-zero ())
            (#pt-app (#pt-use quadratic-element ()) Carrier)
            (#pt-app
              (#pt-use quadratic-ring-structure ())
              Carrier
              coefficient-ring
              linear-coefficient
              constant-coefficient))))
      (#pt-app
        (#pt-use quadratic-quotient-divisor-zero-constant-identity ())
        Carrier
        coefficient-ring
        constant-coefficient
        linear-coefficient)
      (#pt-app
        (#pt-use quadratic-quotient-divisor-zero-linear-identity ())
        Carrier
        coefficient-ring
        constant-coefficient
        linear-coefficient))))
