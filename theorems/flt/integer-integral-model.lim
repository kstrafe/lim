; Identity variable change supplies actual IsIntegralModelOf witnesses
; for exact integral maps, including every certified Frey model.
; General model comparison and discriminant transport remain open.
(#alias exists = ./logic-exists.lim::exists)
(#alias integer = ./integer-defs.lim::integer)
(#alias rational-weierstrass-curve = ./rational-weierstrass-defs.lim::rational-weierstrass-curve)
(#alias integer-weierstrass-curve = ./integer-weierstrass-defs.lim::integer-weierstrass-curve)
(#alias
  integer-weierstrass-map-rational
  =
  ./integer-weierstrass-defs.lim::integer-weierstrass-map-rational)
(#alias
  rational-weierstrass-equivalent
  =
  ./weierstrass-model-equivalence.lim::rational-weierstrass-equivalent)
(#alias
  rational-weierstrass-reflexive
  =
  ./weierstrass-model-equivalence.lim::rational-weierstrass-reflexive)
(#alias
  rational-weierstrass-symmetric
  =
  ./weierstrass-model-equivalence.lim::rational-weierstrass-symmetric)
(#alias
  rational-weierstrass-transitive
  =
  ./weierstrass-model-equivalence.lim::rational-weierstrass-transitive)
(#alias integer-frey-model-certificate = ./integer-frey-model.lim::integer-frey-model-certificate)
(#alias frey-rational-curve = ./frey-rational-curve.lim::frey-rational-curve)
(#alias rational-variable-change = ./rational-variable-change-defs.lim::rational-variable-change)
(#alias
  rational-variable-change-identity
  =
  ./rational-variable-change-defs.lim::rational-variable-change-identity)
(#alias
  rational-variable-change-act
  =
  ./rational-variable-change-defs.lim::rational-variable-change-act)
(#alias
  rational-variable-change-identity-acts
  =
  ./rational-variable-change.lim::rational-variable-change-identity-acts)
(#alias
  integer-is-integral-model-of
  =
  ./integer-integral-model-defs.lim::integer-is-integral-model-of)
(#theorem integer-exact-map-is-integral-model
  (#universes)
  (#parameters
    (#parameter model (#pt-use integer-weierstrass-curve ()))
    (#parameter rational-curve (#pt-use rational-weierstrass-curve ()))
    (#parameter map-certificate (#pt-app (#pt-use rational-weierstrass-equivalent ()) rational-curve (#pt-app (#pt-use integer-weierstrass-map-rational ()) model))))
  (#statement (#pt-app (#pt-use integer-is-integral-model-of ()) model rational-curve))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use rational-variable-change ())
        (#pt-lambda
          ((candidate-change (#pt-use rational-variable-change ())))
          (#pt-app
            (#pt-use rational-weierstrass-equivalent ())
            (#pt-app (#pt-use rational-variable-change-act ()) candidate-change rational-curve)
            (#pt-app (#pt-use integer-weierstrass-map-rational ()) model))))
      introduce
      (
        (#pt-use rational-variable-change-identity ())
        (#pt-app
          (#pt-use rational-weierstrass-transitive ())
          (#pt-app
            (#pt-use rational-variable-change-act ())
            (#pt-use rational-variable-change-identity ())
            rational-curve)
          rational-curve
          (#pt-app (#pt-use integer-weierstrass-map-rational ()) model)
          (#pt-app (#pt-use rational-variable-change-identity-acts ()) rational-curve)
          map-certificate)))))
(#theorem integer-model-is-integral-model-of-map
  (#universes)
  (#parameters
    (#parameter model (#pt-use integer-weierstrass-curve ())))
  (#statement
    (#pt-app
      (#pt-use integer-is-integral-model-of ())
      model
      (#pt-app (#pt-use integer-weierstrass-map-rational ()) model)))
  (#proof
    (#pt-app
      (#pt-use integer-exact-map-is-integral-model ())
      model
      (#pt-app (#pt-use integer-weierstrass-map-rational ()) model)
      (#pt-app
        (#pt-use rational-weierstrass-reflexive ())
        (#pt-app (#pt-use integer-weierstrass-map-rational ()) model)))))
(#theorem frey-exact-model-is-integral-model
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter model (#pt-use integer-weierstrass-curve ()))
    (#parameter model-certificate (#pt-app (#pt-use integer-frey-model-certificate ()) first second exponent model)))
  (#statement
    (#pt-app
      (#pt-use integer-is-integral-model-of ())
      model
      (#pt-app (#pt-use frey-rational-curve ()) first second exponent)))
  (#proof
    (#pt-app
      (#pt-use integer-exact-map-is-integral-model ())
      model
      (#pt-app (#pt-use frey-rational-curve ()) first second exponent)
      (#pt-app
        (#pt-use rational-weierstrass-symmetric ())
        (#pt-app (#pt-use integer-weierstrass-map-rational ()) model)
        (#pt-app (#pt-use frey-rational-curve ()) first second exponent)
        model-certificate))))
