; Generated by scripts/generate-flt-point-ideal-addition.py; checked native terms.
; Polynomial
; evaluation preserves a proved equivalence of evaluation
; points. Induct over the actual coefficient list; no
; reflection or extra map law is added.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias ring-add-congruent = ./commutative-ring-data.lim::ring-add-congruent)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-evaluation = ./ring-evaluation-data.lim::ring-evaluation)
(#alias ring-evaluation-map = ./ring-evaluation-morphism.lim::ring-evaluation-map)
(#alias ring-evaluation-morphism = ./ring-evaluation-morphism.lim::ring-evaluation-morphism)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-multiply-congruent = ./commutative-ring-data.lim::ring-multiply-congruent)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#theorem point-ideal-addition-evaluation-root-congruent
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter Source (#pt-type 0))
    (#parameter source-ring (#pt-app (#pt-use commutative-ring ()) Source))
    (#parameter coefficient-map (#pt-app (#pt-use ring-evaluation-morphism ()) Source source-ring Carrier coefficient-ring))
    (#parameter first-value Carrier)
    (#parameter second-value Carrier)
    (#parameter value-equation (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring first-value second-value))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Source)))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-evaluation ())
        Source
        source-ring
        Carrier
        coefficient-ring
        coefficient-map
        first-value
        polynomial)
      (#pt-app
        (#pt-use ring-evaluation ())
        Source
        source-ring
        Carrier
        coefficient-ring
        coefficient-map
        second-value
        polynomial)))
  (#proof
    (#pt-induct
      finite-list
      ()
      (Source)
      (#pt-lambda
        ((coefficients (#pt-app (#pt-use finite-list ()) Source)))
        (#pt-app
          (#pt-use ring-equal ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-evaluation ())
            Source
            source-ring
            Carrier
            coefficient-ring
            coefficient-map
            first-value
            coefficients)
          (#pt-app
            (#pt-use ring-evaluation ())
            Source
            source-ring
            Carrier
            coefficient-ring
            coefficient-map
            second-value
            coefficients)))
      (
        (#pt-app
          (#pt-use ring-reflexive ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
        (#pt-lambda
          (
            (head Source)
            (tail (#pt-app (#pt-use finite-list ()) Source))
            (tail-equation
              (#pt-app
                (#pt-use ring-equal ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-evaluation ())
                  Source
                  source-ring
                  Carrier
                  coefficient-ring
                  coefficient-map
                  first-value
                  tail)
                (#pt-app
                  (#pt-use ring-evaluation ())
                  Source
                  source-ring
                  Carrier
                  coefficient-ring
                  coefficient-map
                  second-value
                  tail))))
          (#pt-app
            (#pt-use ring-add-congruent ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-evaluation-map ())
              Source
              source-ring
              Carrier
              coefficient-ring
              coefficient-map
              head)
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              first-value
              (#pt-app
                (#pt-use ring-evaluation ())
                Source
                source-ring
                Carrier
                coefficient-ring
                coefficient-map
                first-value
                tail))
            (#pt-app
              (#pt-use ring-evaluation-map ())
              Source
              source-ring
              Carrier
              coefficient-ring
              coefficient-map
              head)
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              second-value
              (#pt-app
                (#pt-use ring-evaluation ())
                Source
                source-ring
                Carrier
                coefficient-ring
                coefficient-map
                second-value
                tail))
            (#pt-app
              (#pt-use ring-reflexive ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-evaluation-map ())
                Source
                source-ring
                Carrier
                coefficient-ring
                coefficient-map
                head))
            (#pt-app
              (#pt-use ring-multiply-congruent ())
              Carrier
              coefficient-ring
              first-value
              (#pt-app
                (#pt-use ring-evaluation ())
                Source
                source-ring
                Carrier
                coefficient-ring
                coefficient-map
                first-value
                tail)
              second-value
              (#pt-app
                (#pt-use ring-evaluation ())
                Source
                source-ring
                Carrier
                coefficient-ring
                coefficient-map
                second-value
                tail)
              value-equation
              tail-equation))))
      polynomial)))
