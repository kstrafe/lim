; Every nonzero nonunit has an actual prime divisor.
; A proved sufficient finite search yields a least-norm nonunit divisor.
; Unit cases and strict factor-norm decrease prove it irreducible,
; then the checked prime theorem supplies actual prime/divisor witnesses.
; No prime-existence, factorization or classical-choice axiom is assumed.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias eisenstein-unit = ./eisenstein-defs.lim::eisenstein-unit)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias exists = ./logic-exists.lim::exists)
(#alias eisenstein-natural-norm = ./eisenstein-norm-defs.lim::eisenstein-natural-norm)
(#alias eisenstein-unit-cases = ./eisenstein-divisibility-cases.lim::eisenstein-unit-cases)
(#alias eisenstein-divisor-nonzero = ./eisenstein-divisibility.lim::eisenstein-divisor-nonzero)
(#alias
  eisenstein-divides-transitive
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-transitive)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#alias disjunction-left = ./logical-connectives.lim::disjunction-left)
(#alias disjunction-right = ./logical-connectives.lim::disjunction-right)
(#alias eisenstein-nonunit-divisor = ./eisenstein-nonunit-divisors.lim::eisenstein-nonunit-divisor)
(#alias
  eisenstein-nonunit-divisor-at-norm
  =
  ./eisenstein-least-nonunit-divisor.lim::eisenstein-nonunit-divisor-at-norm)
(#alias
  eisenstein-minimum-nonunit-divisor-norm
  =
  ./eisenstein-least-nonunit-divisor.lim::eisenstein-minimum-nonunit-divisor-norm)
(#alias eisenstein-norm-property = ./eisenstein-finite-norm-search.lim::eisenstein-norm-property)
(#alias
  eisenstein-natural-norm-exists
  =
  ./eisenstein-norm-nonnegative.lim::eisenstein-natural-norm-exists)
(#alias
  eisenstein-nonunit-factor-norm-decreases
  =
  ./eisenstein-nonunit-factor-norm.lim::eisenstein-nonunit-factor-norm-decreases)
(#alias minimum = ./least-witness.lim::minimum)
(#alias minimum-holds = ./least-witness.lim::minimum-holds)
(#alias minimum-excludes-earlier = ./least-witness.lim::minimum-excludes-earlier)
(#alias eisenstein-irreducible = ./eisenstein-irreducible-prime.lim::eisenstein-irreducible)
(#alias
  eisenstein-irreducible-prime
  =
  ./eisenstein-irreducible-prime.lim::eisenstein-irreducible-prime)
(#alias eisenstein-prime = ./eisenstein-lambda-prime.lim::eisenstein-prime)
(#theorem eisenstein-minimal-nonunit-divisor-irreducible
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter minimal-divisor (#pt-use eisenstein ()))
    (#parameter minimal-norm #pt-nat)
    (#parameter number-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ())))) #pt-false))
    (#parameter minimum-certificate (#pt-app (#pt-use minimum ()) (#pt-lambda ((candidate-norm #pt-nat)) (#pt-app (#pt-use eisenstein-nonunit-divisor-at-norm ()) number candidate-norm)) minimal-norm))
    (#parameter divisor-certificate (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number minimal-divisor))
    (#parameter divisor-norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) minimal-divisor minimal-norm)))
  (#statement (#pt-app (#pt-use eisenstein-irreducible ()) minimal-divisor))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-pi
        (
          (denied-proof
            (#pt-app (#pt-use eisenstein-equal ()) minimal-divisor (#pt-use eisenstein-zero ()))))
        #pt-false)
      (#pt-app
        (#pt-use conjunction ())
        (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) minimal-divisor))) #pt-false)
        (#pt-pi
          (
            (candidate-first (#pt-use eisenstein ()))
            (candidate-second (#pt-use eisenstein ()))
            (factorization
              (#pt-app
                (#pt-use eisenstein-equal ())
                minimal-divisor
                (#pt-app (#pt-use eisenstein-multiply ()) candidate-first candidate-second))))
          (#pt-app
            (#pt-use disjunction ())
            (#pt-app (#pt-use eisenstein-unit ()) candidate-first)
            (#pt-app (#pt-use eisenstein-unit ()) candidate-second))))
      (#pt-app
        (#pt-use eisenstein-divisor-nonzero ())
        minimal-divisor
        number
        number-nonzero
        (#pt-app
          (#pt-use conjunction-right ())
          (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) minimal-divisor))) #pt-false)
          (#pt-app (#pt-use eisenstein-divides ()) minimal-divisor number)
          divisor-certificate))
      (#pt-app
        (#pt-use conjunction-introduce ())
        (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) minimal-divisor))) #pt-false)
        (#pt-pi
          (
            (candidate-first (#pt-use eisenstein ()))
            (candidate-second (#pt-use eisenstein ()))
            (factorization
              (#pt-app
                (#pt-use eisenstein-equal ())
                minimal-divisor
                (#pt-app (#pt-use eisenstein-multiply ()) candidate-first candidate-second))))
          (#pt-app
            (#pt-use disjunction ())
            (#pt-app (#pt-use eisenstein-unit ()) candidate-first)
            (#pt-app (#pt-use eisenstein-unit ()) candidate-second)))
        (#pt-app
          (#pt-use conjunction-left ())
          (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) minimal-divisor))) #pt-false)
          (#pt-app (#pt-use eisenstein-divides ()) minimal-divisor number)
          divisor-certificate)
        (#pt-lambda
          (
            (first-factor (#pt-use eisenstein ()))
            (second-factor (#pt-use eisenstein ()))
            (factorization
              (#pt-app
                (#pt-use eisenstein-equal ())
                minimal-divisor
                (#pt-app (#pt-use eisenstein-multiply ()) first-factor second-factor))))
          (#pt-app
            (#pt-use disjunction-eliminate ())
            (#pt-app (#pt-use eisenstein-unit ()) first-factor)
            (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) first-factor))) #pt-false)
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app (#pt-use eisenstein-unit ()) first-factor)
              (#pt-app (#pt-use eisenstein-unit ()) second-factor))
            (#pt-lambda
              ((first-unit (#pt-app (#pt-use eisenstein-unit ()) first-factor)))
              (#pt-app
                (#pt-use disjunction-left ())
                (#pt-app (#pt-use eisenstein-unit ()) first-factor)
                (#pt-app (#pt-use eisenstein-unit ()) second-factor)
                first-unit))
            (#pt-lambda
              (
                (first-nonunit
                  (#pt-pi
                    ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) first-factor)))
                    #pt-false)))
              (#pt-app
                (#pt-use disjunction-eliminate ())
                (#pt-app (#pt-use eisenstein-unit ()) second-factor)
                (#pt-pi
                  ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) second-factor)))
                  #pt-false)
                (#pt-app
                  (#pt-use disjunction ())
                  (#pt-app (#pt-use eisenstein-unit ()) first-factor)
                  (#pt-app (#pt-use eisenstein-unit ()) second-factor))
                (#pt-lambda
                  ((second-unit (#pt-app (#pt-use eisenstein-unit ()) second-factor)))
                  (#pt-app
                    (#pt-use disjunction-right ())
                    (#pt-app (#pt-use eisenstein-unit ()) first-factor)
                    (#pt-app (#pt-use eisenstein-unit ()) second-factor)
                    second-unit))
                (#pt-lambda
                  (
                    (second-nonunit
                      (#pt-pi
                        ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) second-factor)))
                        #pt-false)))
                  (#pt-induct
                    exists
                    (0)
                    (#pt-nat
                      (#pt-lambda
                        ((candidate-first-norm #pt-nat))
                        (#pt-app
                          (#pt-use eisenstein-natural-norm ())
                          first-factor
                          candidate-first-norm)))
                    (#pt-lambda
                      (
                        (certificate
                          (#pt-app
                            (#pt-use exists (0))
                            #pt-nat
                            (#pt-lambda
                              ((candidate-first-norm #pt-nat))
                              (#pt-app
                                (#pt-use eisenstein-natural-norm ())
                                first-factor
                                candidate-first-norm)))))
                      (#pt-app
                        (#pt-use disjunction ())
                        (#pt-app (#pt-use eisenstein-unit ()) first-factor)
                        (#pt-app (#pt-use eisenstein-unit ()) second-factor)))
                    (
                      (#pt-lambda
                        (
                          (first-norm #pt-nat)
                          (first-norm-certificate
                            (#pt-app (#pt-use eisenstein-natural-norm ()) first-factor first-norm)))
                        (#pt-induct
                          exists
                          (0)
                          (#pt-nat
                            (#pt-lambda
                              ((candidate-second-norm #pt-nat))
                              (#pt-app
                                (#pt-use eisenstein-natural-norm ())
                                second-factor
                                candidate-second-norm)))
                          (#pt-lambda
                            (
                              (certificate
                                (#pt-app
                                  (#pt-use exists (0))
                                  #pt-nat
                                  (#pt-lambda
                                    ((candidate-second-norm #pt-nat))
                                    (#pt-app
                                      (#pt-use eisenstein-natural-norm ())
                                      second-factor
                                      candidate-second-norm)))))
                            (#pt-app
                              (#pt-use disjunction ())
                              (#pt-app (#pt-use eisenstein-unit ()) first-factor)
                              (#pt-app (#pt-use eisenstein-unit ()) second-factor)))
                          (
                            (#pt-lambda
                              (
                                (second-norm #pt-nat)
                                (second-norm-certificate
                                  (#pt-app
                                    (#pt-use eisenstein-natural-norm ())
                                    second-factor
                                    second-norm)))
                              (#pt-app
                                (#pt-use false-elimination ())
                                (#pt-app
                                  (#pt-use disjunction ())
                                  (#pt-app (#pt-use eisenstein-unit ()) first-factor)
                                  (#pt-app (#pt-use eisenstein-unit ()) second-factor))
                                (#pt-app
                                  (#pt-app
                                    (#pt-use minimum-excludes-earlier ())
                                    (#pt-lambda
                                      ((candidate-norm #pt-nat))
                                      (#pt-app
                                        (#pt-use eisenstein-nonunit-divisor-at-norm ())
                                        number
                                        candidate-norm))
                                    minimal-norm
                                    minimum-certificate
                                    first-norm
                                    (#pt-app
                                      (#pt-use eisenstein-nonunit-factor-norm-decreases ())
                                      minimal-divisor
                                      first-factor
                                      second-factor
                                      minimal-norm
                                      first-norm
                                      second-norm
                                      divisor-norm-certificate
                                      first-norm-certificate
                                      second-norm-certificate
                                      (#pt-app
                                        (#pt-use eisenstein-divisor-nonzero ())
                                        minimal-divisor
                                        number
                                        number-nonzero
                                        (#pt-app
                                          (#pt-use conjunction-right ())
                                          (#pt-pi
                                            (
                                              (denied-proof
                                                (#pt-app
                                                  (#pt-use eisenstein-unit ())
                                                  minimal-divisor)))
                                            #pt-false)
                                          (#pt-app
                                            (#pt-use eisenstein-divides ())
                                            minimal-divisor
                                            number)
                                          divisor-certificate))
                                      factorization
                                      second-nonunit))
                                  (#pt-construct
                                    exists
                                    (0)
                                    (
                                      (#pt-use eisenstein ())
                                      (#pt-lambda
                                        ((candidate-value (#pt-use eisenstein ())))
                                        (#pt-app
                                          (#pt-use eisenstein-norm-property ())
                                          (#pt-lambda
                                            ((candidate-divisor (#pt-use eisenstein ())))
                                            (#pt-app
                                              (#pt-use eisenstein-nonunit-divisor ())
                                              number
                                              candidate-divisor))
                                          candidate-value
                                          first-norm)))
                                    introduce
                                    (first-factor
                                      (#pt-app
                                        (#pt-use conjunction-introduce ())
                                        (#pt-app
                                          (#pt-use eisenstein-nonunit-divisor ())
                                          number
                                          first-factor)
                                        (#pt-app
                                          (#pt-use eisenstein-natural-norm ())
                                          first-factor
                                          first-norm)
                                        (#pt-app
                                          (#pt-use conjunction-introduce ())
                                          (#pt-pi
                                            (
                                              (denied-proof
                                                (#pt-app (#pt-use eisenstein-unit ()) first-factor)))
                                            #pt-false)
                                          (#pt-app
                                            (#pt-use eisenstein-divides ())
                                            first-factor
                                            number)
                                          first-nonunit
                                          (#pt-app
                                            (#pt-use eisenstein-divides-transitive ())
                                            first-factor
                                            minimal-divisor
                                            number
                                            (#pt-construct
                                              exists
                                              (0)
                                              (
                                                (#pt-use eisenstein ())
                                                (#pt-lambda
                                                  ((candidate-factor (#pt-use eisenstein ())))
                                                  (#pt-app
                                                    (#pt-use eisenstein-equal ())
                                                    minimal-divisor
                                                    (#pt-app
                                                      (#pt-use eisenstein-multiply ())
                                                      first-factor
                                                      candidate-factor))))
                                              introduce
                                              (second-factor factorization))
                                            (#pt-app
                                              (#pt-use conjunction-right ())
                                              (#pt-pi
                                                (
                                                  (denied-proof
                                                    (#pt-app
                                                      (#pt-use eisenstein-unit ())
                                                      minimal-divisor)))
                                                #pt-false)
                                              (#pt-app
                                                (#pt-use eisenstein-divides ())
                                                minimal-divisor
                                                number)
                                              divisor-certificate)))
                                        first-norm-certificate)))))))
                          (#pt-app (#pt-use eisenstein-natural-norm-exists ()) second-factor))))
                    (#pt-app (#pt-use eisenstein-natural-norm-exists ()) first-factor)))
                (#pt-app (#pt-use eisenstein-unit-cases ()) second-factor)))
            (#pt-app (#pt-use eisenstein-unit-cases ()) first-factor)))))))
(#theorem eisenstein-prime-divisor-exists
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter number-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ())))) #pt-false))
    (#parameter number-nonunit (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) number))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use exists (0))
      (#pt-use eisenstein ())
      (#pt-lambda
        ((candidate-prime (#pt-use eisenstein ())))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app (#pt-use eisenstein-prime ()) candidate-prime)
          (#pt-app (#pt-use eisenstein-divides ()) candidate-prime number)))))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-minimum #pt-nat))
          (#pt-app
            (#pt-use minimum ())
            (#pt-lambda
              ((candidate-norm #pt-nat))
              (#pt-app (#pt-use eisenstein-nonunit-divisor-at-norm ()) number candidate-norm))
            candidate-minimum)))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-minimum #pt-nat))
                (#pt-app
                  (#pt-use minimum ())
                  (#pt-lambda
                    ((candidate-norm #pt-nat))
                    (#pt-app (#pt-use eisenstein-nonunit-divisor-at-norm ()) number candidate-norm))
                  candidate-minimum)))))
        (#pt-app
          (#pt-use exists (0))
          (#pt-use eisenstein ())
          (#pt-lambda
            ((candidate-prime (#pt-use eisenstein ())))
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app (#pt-use eisenstein-prime ()) candidate-prime)
              (#pt-app (#pt-use eisenstein-divides ()) candidate-prime number)))))
      (
        (#pt-lambda
          (
            (minimal-norm #pt-nat)
            (minimum-certificate
              (#pt-app
                (#pt-use minimum ())
                (#pt-lambda
                  ((candidate-norm #pt-nat))
                  (#pt-app (#pt-use eisenstein-nonunit-divisor-at-norm ()) number candidate-norm))
                minimal-norm)))
          (#pt-induct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-value (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-norm-property ())
                  (#pt-lambda
                    ((candidate-divisor (#pt-use eisenstein ())))
                    (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number candidate-divisor))
                  candidate-value
                  minimal-norm)))
            (#pt-lambda
              (
                (eisenstein-certificate
                  (#pt-app
                    (#pt-use exists (0))
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-value (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use eisenstein-norm-property ())
                        (#pt-lambda
                          ((candidate-divisor (#pt-use eisenstein ())))
                          (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number candidate-divisor))
                        candidate-value
                        minimal-norm)))))
              (#pt-app
                (#pt-use exists (0))
                (#pt-use eisenstein ())
                (#pt-lambda
                  ((candidate-prime (#pt-use eisenstein ())))
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app (#pt-use eisenstein-prime ()) candidate-prime)
                    (#pt-app (#pt-use eisenstein-divides ()) candidate-prime number)))))
            (
              (#pt-lambda
                (
                  (minimal-divisor (#pt-use eisenstein ()))
                  (minimal-divisor-certificate
                    (#pt-app
                      (#pt-use eisenstein-norm-property ())
                      (#pt-lambda
                        ((candidate-divisor (#pt-use eisenstein ())))
                        (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number candidate-divisor))
                      minimal-divisor
                      minimal-norm)))
                (#pt-construct
                  exists
                  (0)
                  (
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-prime (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-app (#pt-use eisenstein-prime ()) candidate-prime)
                        (#pt-app (#pt-use eisenstein-divides ()) candidate-prime number))))
                  introduce
                  (minimal-divisor
                    (#pt-app
                      (#pt-use conjunction-introduce ())
                      (#pt-app (#pt-use eisenstein-prime ()) minimal-divisor)
                      (#pt-app (#pt-use eisenstein-divides ()) minimal-divisor number)
                      (#pt-app
                        (#pt-use eisenstein-irreducible-prime ())
                        minimal-divisor
                        (#pt-app
                          (#pt-use eisenstein-minimal-nonunit-divisor-irreducible ())
                          number
                          minimal-divisor
                          minimal-norm
                          number-nonzero
                          minimum-certificate
                          (#pt-app
                            (#pt-use conjunction-left ())
                            (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number minimal-divisor)
                            (#pt-app
                              (#pt-use eisenstein-natural-norm ())
                              minimal-divisor
                              minimal-norm)
                            minimal-divisor-certificate)
                          (#pt-app
                            (#pt-use conjunction-right ())
                            (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number minimal-divisor)
                            (#pt-app
                              (#pt-use eisenstein-natural-norm ())
                              minimal-divisor
                              minimal-norm)
                            minimal-divisor-certificate)))
                      (#pt-app
                        (#pt-use conjunction-right ())
                        (#pt-pi
                          ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) minimal-divisor)))
                          #pt-false)
                        (#pt-app (#pt-use eisenstein-divides ()) minimal-divisor number)
                        (#pt-app
                          (#pt-use conjunction-left ())
                          (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number minimal-divisor)
                          (#pt-app
                            (#pt-use eisenstein-natural-norm ())
                            minimal-divisor
                            minimal-norm)
                          minimal-divisor-certificate)))))))
            (#pt-app
              (#pt-use minimum-holds ())
              (#pt-lambda
                ((candidate-norm #pt-nat))
                (#pt-app (#pt-use eisenstein-nonunit-divisor-at-norm ()) number candidate-norm))
              minimal-norm
              minimum-certificate))))
      (#pt-app
        (#pt-use eisenstein-minimum-nonunit-divisor-norm ())
        number
        number-nonzero
        number-nonunit))))
