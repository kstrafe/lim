; Adapted source: pinned Mathlib Algebra/Polynomial/Degree/Defs.lean
; and Degree/Operations.lean; Affine/Point.lean.
; Generated by scripts/generate-flt-polynomial-degrees.py; checked native terms.
; Two leading-degree witnesses for one polynomial have
; the same natural degree. A higher nonzero leading coefficient would
; contradict the other witness support bound; trichotomy closes all cases.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias less-than = ./natural-order.lim::less-than)
(#alias natural-trichotomy = ./natural-discrete-order.lim::natural-trichotomy)
(#alias
  ring-polynomial-degree-witness
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-degree-witness)
(#alias
  ring-polynomial-support-after-degree
  =
  ./ring-polynomial-support-strict-index.lim::ring-polynomial-support-after-degree)
(#theorem ring-polynomial-degree-not-below
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter degree #pt-nat)
    (#parameter other-degree #pt-nat)
    (#parameter first-degree (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring polynomial degree))
    (#parameter second-degree (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring polynomial other-degree)))
  (#statement
    (#pt-pi ((denied-evidence (#pt-app (#pt-use less-than ()) degree other-degree))) #pt-false))
  (#proof
    (#pt-lambda
      ((strict-order (#pt-app (#pt-use less-than ()) degree other-degree)))
      (#pt-app
        (#pt-project conjunction 0 second-degree)
        (#pt-app
          (#pt-use ring-polynomial-support-after-degree ())
          Carrier
          coefficient-ring
          polynomial
          degree
          other-degree
          (#pt-project conjunction 1 first-degree)
          strict-order)))))
(#theorem ring-polynomial-degree-unique
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter degree #pt-nat)
    (#parameter other-degree #pt-nat)
    (#parameter first-degree (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring polynomial degree))
    (#parameter second-degree (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring polynomial other-degree)))
  (#statement (#pt-eq #pt-nat degree other-degree))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use less-than ()) degree other-degree)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-eq #pt-nat degree other-degree)
        (#pt-app (#pt-use less-than ()) other-degree degree))
      (#pt-eq #pt-nat degree other-degree)
      (#pt-lambda
        ((strict-order (#pt-app (#pt-use less-than ()) degree other-degree)))
        (#pt-app
          (#pt-use false-elimination ())
          (#pt-eq #pt-nat degree other-degree)
          (#pt-app
            (#pt-app
              (#pt-use ring-polynomial-degree-not-below ())
              Carrier
              coefficient-ring
              polynomial
              degree
              other-degree
              first-degree
              second-degree)
            strict-order)))
      (#pt-lambda
        (
          (other-order
            (#pt-app
              (#pt-use disjunction ())
              (#pt-eq #pt-nat degree other-degree)
              (#pt-app (#pt-use less-than ()) other-degree degree))))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-eq #pt-nat degree other-degree)
          (#pt-app (#pt-use less-than ()) other-degree degree)
          (#pt-eq #pt-nat degree other-degree)
          (#pt-lambda ((equal-degrees (#pt-eq #pt-nat degree other-degree))) equal-degrees)
          (#pt-lambda
            ((strict-order (#pt-app (#pt-use less-than ()) other-degree degree)))
            (#pt-app
              (#pt-use false-elimination ())
              (#pt-eq #pt-nat degree other-degree)
              (#pt-app
                (#pt-app
                  (#pt-use ring-polynomial-degree-not-below ())
                  Carrier
                  coefficient-ring
                  polynomial
                  other-degree
                  degree
                  second-degree
                  first-degree)
                strict-order)))
          other-order))
      (#pt-app (#pt-use natural-trichotomy ()) degree other-degree))))
