                  coefficient-ring
                  Image
                  image-ring
                  morphism
                  image-root
                  quotient-witness))
              (#pt-app (#pt-use ring-zero ()) Image image-ring)
              (#pt-app
                (#pt-use ring-evaluation-multiply ())
                Carrier
                coefficient-ring
                Image
                image-ring
                morphism
                image-root
                (#pt-app
                  (#pt-use quadratic-division-divisor ())
                  Carrier
                  coefficient-ring
                  quadratic-linear
                  quadratic-constant)
                quotient-witness)
              (#pt-app
                (#pt-use ring-transitive ())
                Image
                image-ring
                (#pt-app
                  (#pt-use ring-multiply ())
                  Image
                  image-ring
