              coefficient-ring
              Image
              image-ring
              morphism
              image-root
              polynomial)
            (#pt-app
              (#pt-use ring-evaluation ())
              Carrier
              coefficient-ring
              Image
              image-ring
              morphism
              image-root
              (#pt-app
                (#pt-use ring-polynomial-multiply ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use quadratic-division-divisor ())
                  Carrier
                  coefficient-ring
                  quadratic-linear
                  quadratic-constant)
                quotient-witness))
            (#pt-app (#pt-use ring-zero ()) Image image-ring)
            (#pt-app
              (#pt-use ring-evaluation-congruent ())
