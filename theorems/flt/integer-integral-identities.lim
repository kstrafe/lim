; Explicit signed ring identities used by the exact integral Frey
; coefficient witnesses. Natural cross certificates have no unchecked
; polynomial authority.
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-one = ./integer-defs.lim::integer-one)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-reflexive = ./integer-equality.lim::integer-reflexive)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias integer-add-congruent = ./integer-equality.lim::integer-add-congruent)
(#alias integer-add-commutative = ./integer-addition.lim::integer-add-commutative)
(#alias integer-add-associative = ./integer-addition.lim::integer-add-associative)
(#alias
  integer-power-difference-step-cross
  =
  ./integer-power-difference-step-cross.lim::integer-power-difference-step-cross)
(#alias
  integer-frey-a2-rearrange-cross
  =
  ./integer-frey-a2-rearrange-cross.lim::integer-frey-a2-rearrange-cross)
(#theorem integer-power-difference-step
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter fourth (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use integer-multiply ()) first third)
        (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-multiply ()) second fourth)))
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app (#pt-use integer-add ()) first (#pt-app (#pt-use integer-negate ()) second))
          third)
        (#pt-app
          (#pt-use integer-multiply ())
          second
          (#pt-app (#pt-use integer-add ()) third (#pt-app (#pt-use integer-negate ()) fourth))))))
  (#proof
    (#pt-app
      (#pt-use integer-power-difference-step-cross ())
      (#pt-project integer 0 first)
      (#pt-project integer 1 first)
      (#pt-project integer 0 second)
      (#pt-project integer 1 second)
      (#pt-project integer 0 third)
      (#pt-project integer 1 third)
      (#pt-project integer 0 fourth)
      (#pt-project integer 1 fourth))))
(#theorem integer-frey-a2-rearrange
  (#universes)
  (#parameters
    (#parameter first-power (#pt-use integer ()))
    (#parameter second-power (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app
          (#pt-use integer-add ())
          second-power
          (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ())))
        (#pt-app (#pt-use integer-negate ()) first-power))
      (#pt-app
        (#pt-use integer-add ())
        second-power
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app (#pt-use integer-add ()) first-power (#pt-use integer-one ()))))))
  (#proof
    (#pt-app
      (#pt-use integer-frey-a2-rearrange-cross ())
      (#pt-project integer 0 first-power)
      (#pt-project integer 1 first-power)
      (#pt-project integer 0 second-power)
      (#pt-project integer 1 second-power))))
(#theorem integer-add-swap-last
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-add ()) first second) third)
      (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-add ()) first third) second)))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-add ()) first second) third)
      (#pt-app (#pt-use integer-add ()) first (#pt-app (#pt-use integer-add ()) second third))
      (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-add ()) first third) second)
      (#pt-app (#pt-use integer-add-associative ()) first second third)
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app (#pt-use integer-add ()) first (#pt-app (#pt-use integer-add ()) second third))
        (#pt-app (#pt-use integer-add ()) first (#pt-app (#pt-use integer-add ()) third second))
        (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-add ()) first third) second)
        (#pt-app
          (#pt-use integer-add-congruent ())
          first
          (#pt-app (#pt-use integer-add ()) second third)
          first
          (#pt-app (#pt-use integer-add ()) third second)
          (#pt-app (#pt-use integer-reflexive ()) first)
          (#pt-app (#pt-use integer-add-commutative ()) second third))
        (#pt-app
          (#pt-use integer-symmetric ())
          (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-add ()) first third) second)
          (#pt-app (#pt-use integer-add ()) first (#pt-app (#pt-use integer-add ()) third second))
          (#pt-app (#pt-use integer-add-associative ()) first third second))))))
