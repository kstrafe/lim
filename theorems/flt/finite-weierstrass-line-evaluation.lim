(#math-definition finite-weierstrass-line-evaluate ()
  (#pt-pi
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (origin-x (#pt-app (#pt-use finite-residue ()) modulus))
      (origin-y (#pt-app (#pt-use finite-residue ()) modulus))
      (line-slope (#pt-app (#pt-use finite-residue ()) modulus))
      (at-x (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-app (#pt-use finite-residue ()) modulus))
  (#pt-lambda
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (origin-x (#pt-app (#pt-use finite-residue ()) modulus))
      (origin-y (#pt-app (#pt-use finite-residue ()) modulus))
      (line-slope (#pt-app (#pt-use finite-residue ()) modulus))
      (at-x (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-app
      (#pt-use finite-residue-add ())
      modulus
      positive-modulus
      (#pt-app
        (#pt-use finite-residue-multiply ())
        modulus
        positive-modulus
        line-slope
        (#pt-app (#pt-use finite-residue-difference ()) modulus positive-modulus at-x origin-x))
      origin-y)))
(#theorem finite-weierstrass-line-at-origin
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter origin-x (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter origin-y (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter line-slope (#pt-app (#pt-use finite-residue ()) modulus)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-weierstrass-line-evaluate ())
          modulus
          positive-modulus
          origin-x
          origin-y
          line-slope
          origin-x))
      (#pt-project finite-residue 0 origin-y)))
  (#proof
    (#pt-app
      (#pt-use transitivity (0))
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-weierstrass-line-evaluate ())
          modulus
          positive-modulus
          origin-x
          origin-y
          line-slope
          origin-x))
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-residue-add ())
          modulus
          positive-modulus
          (#pt-app
            (#pt-use finite-residue-multiply ())
            modulus
            positive-modulus
            line-slope
            (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus))
          origin-y))
      (#pt-project finite-residue 0 origin-y)
      (#pt-app
        (#pt-use finite-residue-add-congruent ())
        modulus
        positive-modulus
        (#pt-app
          (#pt-use finite-residue-multiply ())
          modulus
          positive-modulus
          line-slope
          (#pt-app
            (#pt-use finite-residue-difference ())
            modulus
            positive-modulus
            origin-x
            origin-x))
        origin-y
        (#pt-app
          (#pt-use finite-residue-multiply ())
          modulus
          positive-modulus
          line-slope
          (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus))
        origin-y
        (#pt-app
          (#pt-use finite-residue-multiply-congruent ())
          modulus
          positive-modulus
          line-slope
          (#pt-app
            (#pt-use finite-residue-difference ())
            modulus
            positive-modulus
            origin-x
            origin-x)
          line-slope
          (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)
          (#pt-refl #pt-nat (#pt-project finite-residue 0 line-slope))
          (#pt-app (#pt-use finite-residue-difference-self ()) modulus positive-modulus origin-x))
        (#pt-refl #pt-nat (#pt-project finite-residue 0 origin-y)))
      (#pt-app
        (#pt-use transitivity (0))
        #pt-nat
        (#pt-project
          finite-residue
          0
          (#pt-app
            (#pt-use finite-residue-add ())
            modulus
            positive-modulus
            (#pt-app
              (#pt-use finite-residue-multiply ())
              modulus
              positive-modulus
              line-slope
              (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus))
            origin-y))
        (#pt-project
          finite-residue
          0
          (#pt-app
            (#pt-use finite-residue-add ())
            modulus
            positive-modulus
            (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)
            origin-y))
        (#pt-project finite-residue 0 origin-y)
        (#pt-app
          (#pt-use finite-residue-add-congruent ())
          modulus
          positive-modulus
          (#pt-app
            (#pt-use finite-residue-multiply ())
            modulus
            positive-modulus
            line-slope
            (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus))
          origin-y
          (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)
          origin-y
          (#pt-app
            (#pt-use finite-residue-multiply-zero-right ())
            modulus
            positive-modulus
            line-slope)
          (#pt-refl #pt-nat (#pt-project finite-residue 0 origin-y)))
        (#pt-app (#pt-use finite-residue-add-zero-left ()) modulus positive-modulus origin-y)))))
(#theorem finite-weierstrass-secant-line-at-other
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) modulus))
    (#parameter curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
    (#parameter first-x (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second-x (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter first-y (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second-y (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter x-unequal (#pt-pi ((denied-evidence (#pt-eq #pt-nat (#pt-project finite-residue 0 first-x) (#pt-project finite-residue 0 second-x)))) #pt-false)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-weierstrass-line-evaluate ())
          modulus
          positive-modulus
          first-x
          first-y
          (#pt-app
            (#pt-use finite-weierstrass-slope ())
            modulus
            positive-modulus
            curve
            first-x
            second-x
            first-y
            second-y)
          second-x))
      (#pt-project finite-residue 0 second-y)))
  (#proof
    (#pt-app
      (#pt-use transitivity (0))
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-weierstrass-line-evaluate ())
          modulus
          positive-modulus
          first-x
          first-y
          (#pt-app
            (#pt-use finite-weierstrass-slope ())
            modulus
            positive-modulus
            curve
            first-x
            second-x
            first-y
            second-y)
          second-x))
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-residue-add ())
          modulus
          positive-modulus
          (#pt-app (#pt-use finite-residue-difference ()) modulus positive-modulus second-y first-y)
          first-y))
      (#pt-project finite-residue 0 second-y)
      (#pt-app
        (#pt-use finite-residue-add-congruent ())
        modulus
        positive-modulus
        (#pt-app
          (#pt-use finite-residue-multiply ())
          modulus
          positive-modulus
          (#pt-app
            (#pt-use finite-weierstrass-slope ())
            modulus
            positive-modulus
            curve
            first-x
            second-x
            first-y
            second-y)
          (#pt-app (#pt-use finite-residue-difference ()) modulus positive-modulus second-x first-x))
        first-y
        (#pt-app (#pt-use finite-residue-difference ()) modulus positive-modulus second-y first-y)
        first-y
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          (#pt-project
            finite-residue
            0
            (#pt-app
              (#pt-use finite-residue-multiply ())
              modulus
              positive-modulus
              (#pt-app
                (#pt-use finite-weierstrass-slope ())
                modulus
                positive-modulus
                curve
                first-x
                second-x
                first-y
                second-y)
              (#pt-app
                (#pt-use finite-residue-difference ())
                modulus
                positive-modulus
                second-x
                first-x)))
          (#pt-project
            finite-residue
            0
            (#pt-app
              (#pt-use finite-residue-multiply ())
              modulus
              positive-modulus
              (#pt-app
                (#pt-use finite-weierstrass-slope ())
                modulus
                positive-modulus
                curve
                first-x
                second-x
                first-y
                second-y)
              (#pt-app
                (#pt-use finite-residue-negate ())
                modulus
                positive-modulus
                (#pt-app
                  (#pt-use finite-residue-difference ())
                  modulus
                  positive-modulus
                  first-x
                  second-x))))
          (#pt-project
            finite-residue
            0
            (#pt-app
              (#pt-use finite-residue-difference ())
              modulus
              positive-modulus
              second-y
              first-y))
          (#pt-app
            (#pt-use finite-residue-multiply-congruent ())
            modulus
            positive-modulus
            (#pt-app
              (#pt-use finite-weierstrass-slope ())
              modulus
              positive-modulus
              curve
              first-x
              second-x
              first-y
              second-y)
            (#pt-app
              (#pt-use finite-residue-difference ())
              modulus
              positive-modulus
              second-x
              first-x)
            (#pt-app
              (#pt-use finite-weierstrass-slope ())
              modulus
              positive-modulus
              curve
              first-x
              second-x
              first-y
              second-y)
            (#pt-app
              (#pt-use finite-residue-negate ())
              modulus
              positive-modulus
              (#pt-app
                (#pt-use finite-residue-difference ())
                modulus
                positive-modulus
                first-x
                second-x))
            (#pt-refl
              #pt-nat
              (#pt-project
                finite-residue
                0
                (#pt-app
                  (#pt-use finite-weierstrass-slope ())
                  modulus
                  positive-modulus
                  curve
                  first-x
                  second-x
                  first-y
                  second-y)))
            (#pt-app
              (#pt-use symmetry (0))
              #pt-nat
              (#pt-project
                finite-residue
                0
                (#pt-app
                  (#pt-use finite-residue-negate ())
                  modulus
                  positive-modulus
                  (#pt-app
                    (#pt-use finite-residue-difference ())
                    modulus
                    positive-modulus
                    first-x
                    second-x)))
              (#pt-project
                finite-residue
                0
                (#pt-app
                  (#pt-use finite-residue-difference ())
                  modulus
                  positive-modulus
                  second-x
                  first-x))
              (#pt-app
                (#pt-use finite-residue-difference-negate ())
                modulus
                positive-modulus
                first-x
                second-x)))
          (#pt-app
            (#pt-use transitivity (0))
            #pt-nat
            (#pt-project
              finite-residue
              0
              (#pt-app
                (#pt-use finite-residue-multiply ())
                modulus
                positive-modulus
                (#pt-app
                  (#pt-use finite-weierstrass-slope ())
                  modulus
                  positive-modulus
                  curve
                  first-x
                  second-x
                  first-y
                  second-y)
                (#pt-app
                  (#pt-use finite-residue-negate ())
                  modulus
                  positive-modulus
                  (#pt-app
                    (#pt-use finite-residue-difference ())
                    modulus
                    positive-modulus
                    first-x
                    second-x))))
            (#pt-project
              finite-residue
              0
              (#pt-app
                (#pt-use finite-residue-negate ())
                modulus
                positive-modulus
                (#pt-app
                  (#pt-use finite-residue-multiply ())
                  modulus
                  positive-modulus
                  (#pt-app
                    (#pt-use finite-weierstrass-slope ())
                    modulus
                    positive-modulus
                    curve
                    first-x
                    second-x
                    first-y
                    second-y)
                  (#pt-app
                    (#pt-use finite-residue-difference ())
                    modulus
                    positive-modulus
                    first-x
                    second-x))))
            (#pt-project
              finite-residue
              0
              (#pt-app
                (#pt-use finite-residue-difference ())
                modulus
                positive-modulus
                second-y
                first-y))
            (#pt-app
              (#pt-use finite-residue-multiply-negate-second ())
              modulus
              positive-modulus
              (#pt-app
                (#pt-use finite-weierstrass-slope ())
                modulus
                positive-modulus
                curve
                first-x
                second-x
                first-y
                second-y)
              (#pt-app
                (#pt-use finite-residue-difference ())
                modulus
                positive-modulus
                first-x
                second-x))
            (#pt-app
              (#pt-use transitivity (0))
              #pt-nat
              (#pt-project
                finite-residue
                0
                (#pt-app
                  (#pt-use finite-residue-negate ())
                  modulus
                  positive-modulus
                  (#pt-app
                    (#pt-use finite-residue-multiply ())
                    modulus
                    positive-modulus
                    (#pt-app
                      (#pt-use finite-weierstrass-slope ())
                      modulus
                      positive-modulus
                      curve
                      first-x
                      second-x
                      first-y
                      second-y)
                    (#pt-app
                      (#pt-use finite-residue-difference ())
                      modulus
                      positive-modulus
                      first-x
                      second-x))))
              (#pt-project
                finite-residue
                0
                (#pt-app
                  (#pt-use finite-residue-negate ())
                  modulus
                  positive-modulus
                  (#pt-app
                    (#pt-use finite-residue-difference ())
                    modulus
                    positive-modulus
                    first-y
                    second-y)))
              (#pt-project
                finite-residue
                0
                (#pt-app
                  (#pt-use finite-residue-difference ())
                  modulus
                  positive-modulus
                  second-y
                  first-y))
              (#pt-app
                (#pt-use finite-residue-negate-congruent ())
                modulus
                positive-modulus
                (#pt-app
                  (#pt-use finite-residue-multiply ())
                  modulus
                  positive-modulus
                  (#pt-app
                    (#pt-use finite-weierstrass-slope ())
                    modulus
                    positive-modulus
                    curve
                    first-x
                    second-x
                    first-y
                    second-y)
                  (#pt-app
                    (#pt-use finite-residue-difference ())
                    modulus
                    positive-modulus
