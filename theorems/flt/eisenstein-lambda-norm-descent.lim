; Strict norm decrease of an actual quotient by lambda.
; The scalar identity N(lambda*x)=3*N(x) is checked directly, avoiding
; the full conjugation/product norm library in the order construction.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-lambda = ./eisenstein-defs.lim::eisenstein-lambda)
(#alias eisenstein-of-integer = ./eisenstein-defs.lim::eisenstein-of-integer)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-add = ./eisenstein-defs.lim::eisenstein-add)
(#alias eisenstein-negate = ./eisenstein-defs.lim::eisenstein-negate)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-zero = ./integer-defs.lim::integer-zero)
(#alias integer-one = ./integer-defs.lim::integer-one)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias eisenstein-reflexive = ./eisenstein-equality.lim::eisenstein-reflexive)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-congruent = ./eisenstein-equality.lim::eisenstein-multiply-congruent)
(#alias eisenstein-add-congruent = ./eisenstein-equality.lim::eisenstein-add-congruent)
(#alias
  eisenstein-of-integer-injective
  =
  ./eisenstein-equality.lim::eisenstein-of-integer-injective)
(#alias integer-reflexive = ./integer-equality.lim::integer-reflexive)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias integer-add-congruent = ./integer-equality.lim::integer-add-congruent)
(#alias integer-negate-congruent = ./integer-equality.lim::integer-negate-congruent)
(#alias integer-multiply-congruent = ./integer-multiplication.lim::integer-multiply-congruent)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias eisenstein-conjugate = ./eisenstein-norm-defs.lim::eisenstein-conjugate)
(#alias eisenstein-norm = ./eisenstein-norm-defs.lim::eisenstein-norm)
(#alias eisenstein-natural-norm = ./eisenstein-norm-defs.lim::eisenstein-natural-norm)
(#alias
  eisenstein-norm-scalar-lambda-multiply
  =
  ./eisenstein-norm-scalar-lambda-multiply.lim::eisenstein-norm-scalar-lambda-multiply)
(#alias eisenstein-norm-congruent = ./eisenstein-norm-basic.lim::eisenstein-norm-congruent)
(#alias
  eisenstein-natural-norm-unique
  =
  ./eisenstein-norm-nonnegative.lim::eisenstein-natural-norm-unique)
(#alias
  eisenstein-natural-norm-exists
  =
  ./eisenstein-norm-nonnegative.lim::eisenstein-natural-norm-exists)
(#alias eisenstein-nonzero-norm = ./eisenstein-norm-nondegenerate.lim::eisenstein-nonzero-norm)
(#alias integer-multiply-of-natural = ./integer-multiplication.lim::integer-multiply-of-natural)
(#alias eisenstein-multiply-zero = ./eisenstein-ring.lim::eisenstein-multiply-zero)
(#alias nonunit-multiple-above = ./natural-square-arithmetic.lim::nonunit-multiple-above)
(#alias less-than = ./natural-order.lim::less-than)
(#alias exists = ./logic-exists.lim::exists)
(#alias symmetry = ./equality.lim::symmetry)
(#alias substitution = ./equality.lim::substitution)
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#theorem eisenstein-lambda-norm-multiply
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app
        (#pt-use eisenstein-norm ())
        (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) number))
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
        (#pt-app (#pt-use eisenstein-norm ()) number))))
  (#proof
    (#pt-app
      (#pt-use eisenstein-norm-scalar-lambda-multiply ())
      (#pt-project eisenstein 0 number)
      (#pt-project eisenstein 1 number))))
(#theorem eisenstein-nonzero-natural-norm
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter number-norm #pt-nat)
    (#parameter norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) number number-norm))
    (#parameter number-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ())))) #pt-false)))
  (#statement (#pt-pi ((denied-proof (#pt-eq #pt-nat number-norm #pt-zero))) #pt-false))
  (#proof
    (#pt-lambda
      ((norm-zero (#pt-eq #pt-nat number-norm #pt-zero)))
      (#pt-app
        (#pt-app (#pt-use eisenstein-nonzero-norm ()) number number-nonzero)
        (#pt-app
          (#pt-use substitution (0))
          #pt-nat
          (#pt-lambda
            ((endpoint #pt-nat))
            (#pt-app (#pt-use eisenstein-natural-norm ()) number endpoint))
          number-norm
          #pt-zero
          norm-zero
          norm-certificate)))))
(#theorem eisenstein-lambda-quotient-nonzero
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter quotient (#pt-use eisenstein ()))
    (#parameter factor-equivalence (#pt-app (#pt-use eisenstein-equal ()) number (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) quotient)))
    (#parameter number-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ())))) #pt-false)))
  (#statement
    (#pt-pi
      ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) quotient (#pt-use eisenstein-zero ()))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (quotient-zero
          (#pt-app (#pt-use eisenstein-equal ()) quotient (#pt-use eisenstein-zero ()))))
      (#pt-app
        number-nonzero
        (#pt-app
          (#pt-use eisenstein-transitive ())
          number
          (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) quotient)
          (#pt-use eisenstein-zero ())
          factor-equivalence
          (#pt-app
            (#pt-use eisenstein-transitive ())
            (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) quotient)
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-use eisenstein-lambda ())
              (#pt-use eisenstein-zero ()))
            (#pt-use eisenstein-zero ())
            (#pt-app
              (#pt-use eisenstein-multiply-congruent ())
              (#pt-use eisenstein-lambda ())
              quotient
              (#pt-use eisenstein-lambda ())
              (#pt-use eisenstein-zero ())
              (#pt-app (#pt-use eisenstein-reflexive ()) (#pt-use eisenstein-lambda ()))
              quotient-zero)
            (#pt-app (#pt-use eisenstein-multiply-zero ()) (#pt-use eisenstein-lambda ()))))))))
(#theorem eisenstein-lambda-quotient-norm-equation
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter quotient (#pt-use eisenstein ()))
    (#parameter number-norm #pt-nat)
    (#parameter quotient-norm #pt-nat)
    (#parameter number-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) number number-norm))
    (#parameter quotient-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) quotient quotient-norm))
    (#parameter factor-equivalence (#pt-app (#pt-use eisenstein-equal ()) number (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) quotient))))
  (#statement
    (#pt-eq #pt-nat number-norm (#pt-app (#pt-use multiply ()) (#pt-numeral 3) quotient-norm)))
  (#proof
    (#pt-app
      (#pt-use eisenstein-natural-norm-unique ())
      number
      number-norm
      (#pt-app (#pt-use multiply ()) (#pt-numeral 3) quotient-norm)
      number-certificate
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app (#pt-use eisenstein-norm ()) number)
        (#pt-app
          (#pt-use eisenstein-norm ())
          (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) quotient))
        (#pt-app
          (#pt-use integer-of-natural ())
          (#pt-app (#pt-use multiply ()) (#pt-numeral 3) quotient-norm))
        (#pt-app
          (#pt-use eisenstein-norm-congruent ())
          number
          (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) quotient)
          factor-equivalence)
        (#pt-app
          (#pt-use integer-transitive ())
          (#pt-app
            (#pt-use eisenstein-norm ())
            (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) quotient))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
            (#pt-app (#pt-use eisenstein-norm ()) quotient))
          (#pt-app
            (#pt-use integer-of-natural ())
            (#pt-app (#pt-use multiply ()) (#pt-numeral 3) quotient-norm))
          (#pt-app (#pt-use eisenstein-lambda-norm-multiply ()) quotient)
          (#pt-app
            (#pt-use integer-transitive ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
              (#pt-app (#pt-use eisenstein-norm ()) quotient))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
              (#pt-app (#pt-use integer-of-natural ()) quotient-norm))
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app (#pt-use multiply ()) (#pt-numeral 3) quotient-norm))
            (#pt-app
              (#pt-use integer-multiply-congruent ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
              (#pt-app (#pt-use eisenstein-norm ()) quotient)
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
              (#pt-app (#pt-use integer-of-natural ()) quotient-norm)
              (#pt-app
                (#pt-use integer-reflexive ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)))
              quotient-certificate)
            (#pt-app (#pt-use integer-multiply-of-natural ()) (#pt-numeral 3) quotient-norm)))))))
(#theorem eisenstein-lambda-quotient-norm-less
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter quotient (#pt-use eisenstein ()))
    (#parameter number-norm #pt-nat)
    (#parameter quotient-norm #pt-nat)
    (#parameter number-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) number number-norm))
    (#parameter quotient-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) quotient quotient-norm))
    (#parameter factor-equivalence (#pt-app (#pt-use eisenstein-equal ()) number (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) quotient)))
    (#parameter number-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ())))) #pt-false)))
  (#statement (#pt-app (#pt-use less-than ()) quotient-norm number-norm))
  (#proof
    (#pt-app
      (#pt-use substitution (0))
      #pt-nat
      (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use less-than ()) quotient-norm endpoint))
      (#pt-app (#pt-use multiply ()) (#pt-numeral 3) quotient-norm)
      number-norm
      (#pt-app
        (#pt-use symmetry (0))
        #pt-nat
        number-norm
        (#pt-app (#pt-use multiply ()) (#pt-numeral 3) quotient-norm)
        (#pt-app
          (#pt-use eisenstein-lambda-quotient-norm-equation ())
          number
          quotient
          number-norm
          quotient-norm
          number-certificate
          quotient-certificate
          factor-equivalence))
      (#pt-app
        (#pt-use nonunit-multiple-above ())
        quotient-norm
        (#pt-numeral 3)
        (#pt-app
          (#pt-use eisenstein-nonzero-natural-norm ())
          quotient
          quotient-norm
          quotient-certificate
          (#pt-app
            (#pt-use eisenstein-lambda-quotient-nonzero ())
            number
            quotient
            factor-equivalence
            number-nonzero))
        (#pt-construct
          exists
          (0)
          (#pt-nat
            (#pt-lambda
              ((candidate-gap #pt-nat))
              (#pt-eq
                #pt-nat
                (#pt-numeral 3)
                (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ #pt-zero)) candidate-gap))))
          introduce
          ((#pt-succ #pt-zero) (#pt-refl #pt-nat (#pt-numeral 3))))))))
