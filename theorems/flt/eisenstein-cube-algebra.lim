(#theorem eisenstein-cube-factor-product-real
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-project
        eisenstein
        0
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app
            (#pt-use eisenstein-multiply ())
            number
            (#pt-app (#pt-use eisenstein-multiply ()) number number))
          (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))))
      (#pt-project
        eisenstein
        0
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app
              (#pt-use eisenstein-add ())
              number
              (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ())))
            (#pt-app
              (#pt-use eisenstein-add ())
              number
              (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ()))))
          (#pt-app
            (#pt-use eisenstein-add ())
            number
            (#pt-app
              (#pt-use eisenstein-negate ())
              (#pt-app
                (#pt-use eisenstein-negate ())
                (#pt-app
                  (#pt-use eisenstein-add ())
                  (#pt-use eisenstein-omega ())
                  (#pt-use eisenstein-one ())))))))))
  (#proof
    (#pt-app
      (#pt-use eisenstein-cube-scalar-factor-real ())
      (#pt-project eisenstein 0 number)
      (#pt-project eisenstein 1 number))))
