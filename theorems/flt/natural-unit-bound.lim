; Constructive coordinate bound for the six Eisenstein units.
; A natural budget 4=3*n*n+q forces n=0 or n=1. The large case
; uses a checked polynomial gap of at least 12, not a bounded search.
(#alias add = ./../fermat_statement.lim::add)
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#alias not-less-than-self = ./natural-order.lim::not-less-than-self)
(#alias zero-one-or-large = ./natural-small-cases.lim::zero-one-or-large)
(#alias
  natural-large-square-triple
  =
  ./natural-unit-bound-polynomial.lim::natural-large-square-triple)
(#alias add-associative = ./natural-addition.lim::add-associative)
(#alias congruence = ./equality.lim::congruence)
(#alias transitivity = ./equality.lim::transitivity)
(#alias substitution = ./equality.lim::substitution)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-left = ./logical-connectives.lim::disjunction-left)
(#alias disjunction-right = ./logical-connectives.lim::disjunction-right)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#theorem natural-large-three-square-budget-impossible
  (#universes)
  (#parameters
    (#parameter offset #pt-nat)
    (#parameter remainder #pt-nat)
    (#parameter budget-equation (#pt-eq #pt-nat (#pt-numeral 4) (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) (#pt-numeral 3) (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use add ()) (#pt-numeral 2) offset) (#pt-app (#pt-use add ()) (#pt-numeral 2) offset))) remainder))))
  (#statement #pt-false)
  (#proof
    (#pt-app
      (#pt-app (#pt-use not-less-than-self ()) (#pt-numeral 4))
      (#pt-construct
        exists
        (0)
        (#pt-nat
          (#pt-lambda
            ((candidate-gap #pt-nat))
            (#pt-eq
              #pt-nat
              (#pt-numeral 4)
              (#pt-app (#pt-use add ()) (#pt-succ (#pt-numeral 4)) candidate-gap))))
        introduce
        (
          (#pt-app
            (#pt-use add ())
            (#pt-numeral 7)
            (#pt-app
              (#pt-use add ())
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) (#pt-numeral 12) offset)
                (#pt-app
                  (#pt-use multiply ())
                  (#pt-numeral 3)
                  (#pt-app (#pt-use multiply ()) offset offset)))
              remainder))
          (#pt-app
            (#pt-use transitivity (0))
            #pt-nat
            (#pt-numeral 4)
            (#pt-app
              (#pt-use add ())
              (#pt-app
                (#pt-use multiply ())
                (#pt-numeral 3)
                (#pt-app
                  (#pt-use multiply ())
                  (#pt-app (#pt-use add ()) (#pt-numeral 2) offset)
                  (#pt-app (#pt-use add ()) (#pt-numeral 2) offset)))
              remainder)
            (#pt-app
              (#pt-use add ())
              (#pt-numeral 12)
              (#pt-app
                (#pt-use add ())
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 12) offset)
                  (#pt-app
                    (#pt-use multiply ())
                    (#pt-numeral 3)
                    (#pt-app (#pt-use multiply ()) offset offset)))
                remainder))
            budget-equation
            (#pt-app
              (#pt-use transitivity (0))
              #pt-nat
              (#pt-app
                (#pt-use add ())
                (#pt-app
                  (#pt-use multiply ())
                  (#pt-numeral 3)
                  (#pt-app
                    (#pt-use multiply ())
                    (#pt-app (#pt-use add ()) (#pt-numeral 2) offset)
                    (#pt-app (#pt-use add ()) (#pt-numeral 2) offset)))
                remainder)
              (#pt-app
                (#pt-use add ())
                (#pt-app
                  (#pt-use add ())
                  (#pt-numeral 12)
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use multiply ()) (#pt-numeral 12) offset)
                    (#pt-app
                      (#pt-use multiply ())
                      (#pt-numeral 3)
                      (#pt-app (#pt-use multiply ()) offset offset))))
                remainder)
              (#pt-app
                (#pt-use add ())
                (#pt-numeral 12)
                (#pt-app
                  (#pt-use add ())
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use multiply ()) (#pt-numeral 12) offset)
                    (#pt-app
                      (#pt-use multiply ())
                      (#pt-numeral 3)
                      (#pt-app (#pt-use multiply ()) offset offset)))
                  remainder))
              (#pt-app
                (#pt-use congruence (0 0))
                #pt-nat
                #pt-nat
                (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use add ()) endpoint remainder))
                (#pt-app
                  (#pt-use multiply ())
                  (#pt-numeral 3)
                  (#pt-app
                    (#pt-use multiply ())
                    (#pt-app (#pt-use add ()) (#pt-numeral 2) offset)
                    (#pt-app (#pt-use add ()) (#pt-numeral 2) offset)))
                (#pt-app
                  (#pt-use add ())
                  (#pt-numeral 12)
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use multiply ()) (#pt-numeral 12) offset)
                    (#pt-app
                      (#pt-use multiply ())
                      (#pt-numeral 3)
                      (#pt-app (#pt-use multiply ()) offset offset))))
                (#pt-app (#pt-use natural-large-square-triple ()) offset))
              (#pt-app
                (#pt-use add-associative ())
                (#pt-numeral 12)
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 12) offset)
                  (#pt-app
                    (#pt-use multiply ())
                    (#pt-numeral 3)
                    (#pt-app (#pt-use multiply ()) offset offset)))
                remainder))))))))
(#theorem natural-three-square-budget-small
  (#universes)
  (#parameters
    (#parameter magnitude #pt-nat)
    (#parameter remainder #pt-nat)
    (#parameter budget-equation (#pt-eq #pt-nat (#pt-numeral 4) (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) (#pt-numeral 3) (#pt-app (#pt-use multiply ()) magnitude magnitude)) remainder))))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-eq #pt-nat magnitude #pt-zero)
      (#pt-eq #pt-nat magnitude (#pt-succ #pt-zero))))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-eq #pt-nat magnitude #pt-zero)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-eq #pt-nat magnitude (#pt-succ #pt-zero))
        (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) magnitude))
      (#pt-app
        (#pt-use disjunction ())
        (#pt-eq #pt-nat magnitude #pt-zero)
        (#pt-eq #pt-nat magnitude (#pt-succ #pt-zero)))
      (#pt-lambda
        ((is-zero (#pt-eq #pt-nat magnitude #pt-zero)))
        (#pt-app
          (#pt-use disjunction-left ())
          (#pt-eq #pt-nat magnitude #pt-zero)
          (#pt-eq #pt-nat magnitude (#pt-succ #pt-zero))
          is-zero))
      (#pt-lambda
        (
          (one-or-large
            (#pt-app
              (#pt-use disjunction ())
              (#pt-eq #pt-nat magnitude (#pt-succ #pt-zero))
              (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) magnitude))))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-eq #pt-nat magnitude (#pt-succ #pt-zero))
          (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) magnitude)
          (#pt-app
            (#pt-use disjunction ())
            (#pt-eq #pt-nat magnitude #pt-zero)
            (#pt-eq #pt-nat magnitude (#pt-succ #pt-zero)))
          (#pt-lambda
            ((is-one (#pt-eq #pt-nat magnitude (#pt-succ #pt-zero))))
            (#pt-app
              (#pt-use disjunction-right ())
              (#pt-eq #pt-nat magnitude #pt-zero)
              (#pt-eq #pt-nat magnitude (#pt-succ #pt-zero))
              is-one))
          (#pt-lambda
            ((is-large (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) magnitude)))
            (#pt-induct
              exists
              (0)
              (#pt-nat
                (#pt-lambda
                  ((candidate-offset #pt-nat))
                  (#pt-eq
                    #pt-nat
                    magnitude
                    (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ #pt-zero)) candidate-offset))))
              (#pt-lambda
                (
                  (certificate
                    (#pt-app
                      (#pt-use exists (0))
                      #pt-nat
                      (#pt-lambda
                        ((candidate-offset #pt-nat))
                        (#pt-eq
                          #pt-nat
                          magnitude
                          (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ #pt-zero)) candidate-offset))))))
                (#pt-app
                  (#pt-use disjunction ())
                  (#pt-eq #pt-nat magnitude #pt-zero)
                  (#pt-eq #pt-nat magnitude (#pt-succ #pt-zero))))
              (
                (#pt-lambda
                  (
                    (offset #pt-nat)
                    (position
                      (#pt-eq #pt-nat magnitude (#pt-app (#pt-use add ()) (#pt-numeral 2) offset))))
                  (#pt-app
                    (#pt-use false-elimination ())
                    (#pt-app
                      (#pt-use disjunction ())
                      (#pt-eq #pt-nat magnitude #pt-zero)
                      (#pt-eq #pt-nat magnitude (#pt-succ #pt-zero)))
                    (#pt-app
                      (#pt-use natural-large-three-square-budget-impossible ())
                      offset
                      remainder
                      (#pt-app
                        (#pt-use substitution (0))
                        #pt-nat
                        (#pt-lambda
                          ((endpoint #pt-nat))
                          (#pt-eq
                            #pt-nat
                            (#pt-numeral 4)
                            (#pt-app
                              (#pt-use add ())
                              (#pt-app
                                (#pt-use multiply ())
                                (#pt-numeral 3)
                                (#pt-app (#pt-use multiply ()) endpoint endpoint))
                              remainder)))
                        magnitude
                        (#pt-app (#pt-use add ()) (#pt-numeral 2) offset)
                        position
                        budget-equation)))))
              is-large))
          one-or-large))
      (#pt-app (#pt-use zero-one-or-large ()) magnitude))))
