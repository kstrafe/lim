(#math-definition rational-is-unit ()
  (#pt-pi ((value (#pt-use rational ()))) #pt-prop)
  (#pt-lambda
    ((value (#pt-use rational ())))
    (#pt-app
      (#pt-use exists (0))
      (#pt-use rational ())
      (#pt-lambda
        ((candidate-inverse (#pt-use rational ())))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-app (#pt-use rational-multiply ()) value candidate-inverse)
            (#pt-use rational-one ()))
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-app (#pt-use rational-multiply ()) candidate-inverse value)
            (#pt-use rational-one ())))))))
(#theorem rational-positive-magnitude-reciprocal
  (#universes)
  (#parameters
    (#parameter value (#pt-use rational ()))
    (#parameter magnitude #pt-nat)
    (#parameter numerator-magnitude (#pt-app (#pt-use integer-equal ()) (#pt-project rational 0 value) (#pt-app (#pt-use integer-of-natural ()) magnitude)))
    (#parameter magnitude-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat magnitude #pt-zero))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-multiply ())
        value
        (#pt-construct
          rational
          ()
          ()
          fraction
          (
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 value))
            magnitude
            magnitude-nonzero)))
      (#pt-use rational-one ())))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-project rational 0 value)
          (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 value)))
        (#pt-use integer-one ()))
      (#pt-app
        (#pt-use integer-of-natural ())
        (#pt-app (#pt-use multiply ()) (#pt-project rational 1 value) magnitude))
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-use integer-one ())
        (#pt-app
          (#pt-use integer-of-natural ())
          (#pt-app (#pt-use multiply ()) (#pt-project rational 1 value) magnitude)))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 value)
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 value)))
          (#pt-use integer-one ()))
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-project rational 0 value)
          (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 value)))
        (#pt-app
          (#pt-use integer-of-natural ())
          (#pt-app (#pt-use multiply ()) (#pt-project rational 1 value) magnitude))
        (#pt-app
          (#pt-use integer-multiply-one ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 value)
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 value))))
        (#pt-app
          (#pt-use integer-transitive ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 value)
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 value)))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-of-natural ()) magnitude)
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 value)))
          (#pt-app
            (#pt-use integer-of-natural ())
            (#pt-app (#pt-use multiply ()) (#pt-project rational 1 value) magnitude))
          (#pt-app
            (#pt-use integer-multiply-congruent ())
            (#pt-project rational 0 value)
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 value))
            (#pt-app (#pt-use integer-of-natural ()) magnitude)
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 value))
            numerator-magnitude
            (#pt-app
              (#pt-use integer-reflexive ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 value))))
          (#pt-app
            (#pt-use integer-transitive ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-of-natural ()) magnitude)
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 value)))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 value))
              (#pt-app (#pt-use integer-of-natural ()) magnitude))
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app (#pt-use multiply ()) (#pt-project rational 1 value) magnitude))
            (#pt-app
              (#pt-use integer-multiply-commutative ())
              (#pt-app (#pt-use integer-of-natural ()) magnitude)
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 value)))
            (#pt-app
              (#pt-use integer-multiply-of-natural ())
              (#pt-project rational 1 value)
              magnitude))))
      (#pt-app
        (#pt-use integer-symmetric ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-use integer-one ())
          (#pt-app
            (#pt-use integer-of-natural ())
            (#pt-app (#pt-use multiply ()) (#pt-project rational 1 value) magnitude)))
        (#pt-app
          (#pt-use integer-of-natural ())
          (#pt-app (#pt-use multiply ()) (#pt-project rational 1 value) magnitude))
        (#pt-app
          (#pt-use integer-one-multiply ())
          (#pt-app
            (#pt-use integer-of-natural ())
            (#pt-app (#pt-use multiply ()) (#pt-project rational 1 value) magnitude)))))))
