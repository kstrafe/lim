(#alias integer-multiply-one = ./integer-multiplication.lim::integer-multiply-one)
(#alias integer-one-multiply = ./integer-bezout-algebra.lim::integer-one-multiply)
(#alias integer-natural-embedding-nonzero = ./integer-domain.lim::integer-natural-embedding-nonzero)
(#alias successor-not-zero = ./natural-nonzero.lim::successor-not-zero)
(#alias rational-reflexive = ./rational-equality.lim::rational-reflexive)
(#alias rational-symmetric = ./rational-equality.lim::rational-symmetric)
(#alias rational-transitive = ./rational-equality.lim::rational-transitive)
(#alias rational-fraction-nonzero = ./rational-equality.lim::rational-fraction-nonzero)
(#alias rational-multiply-congruent = ./rational-congruence.lim::rational-multiply-congruent)
