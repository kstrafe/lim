; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Both actual coordinate classes belong
; to XYIdeal. Prove its least-ideal property for every actual
; containing coordinate ideal through the generic checked pair API.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias
  coordinate-point-ideal-X-class
  =
  ./coordinate-point-ideal-data.lim::coordinate-point-ideal-X-class)
(#alias coordinate-point-ideal-XY = ./coordinate-point-ideal-data.lim::coordinate-point-ideal-XY)
(#alias
  coordinate-point-ideal-Y-class
  =
  ./coordinate-point-ideal-data.lim::coordinate-point-ideal-Y-class)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias quadratic-constant = ./quadratic-algebra-data.lim::quadratic-constant)
(#alias quadratic-element = ./quadratic-algebra-data.lim::quadratic-element)
(#alias quadratic-ring-structure = ./quadratic-algebra-ring-structure.lim::quadratic-ring-structure)
(#alias ring-ideal = ./ring-ideal-data.lim::ring-ideal)
(#alias ring-ideal-member = ./ring-ideal-data.lim::ring-ideal-member)
(#alias ring-ideal-pair-first = ./ring-ideal-pair.lim::ring-ideal-pair-first)
(#alias ring-ideal-pair-least = ./ring-ideal-pair.lim::ring-ideal-pair-least)
(#alias ring-ideal-pair-second = ./ring-ideal-pair.lim::ring-ideal-pair-second)
(#alias ring-ideal-subset = ./ring-ideal-data.lim::ring-ideal-subset)
(#alias ring-polynomial-structure = ./ring-polynomial-structure.lim::ring-polynomial-structure)
(#theorem coordinate-point-ideal-contains-X
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter quadratic-linear (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter quadratic-constant (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter root Carrier)
    (#parameter Y-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-member ())
      (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
      (#pt-app
        (#pt-use quadratic-ring-structure ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        quadratic-linear
        quadratic-constant)
      (#pt-app
        (#pt-use coordinate-point-ideal-XY ())
        Carrier
        coefficient-ring
        quadratic-linear
        quadratic-constant
        root
        Y-polynomial)
      (#pt-app (#pt-use coordinate-point-ideal-X-class ()) Carrier coefficient-ring root)))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-pair-first ())
      (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
      (#pt-app
        (#pt-use quadratic-ring-structure ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        quadratic-linear
        quadratic-constant)
      (#pt-app (#pt-use coordinate-point-ideal-X-class ()) Carrier coefficient-ring root)
      (#pt-app (#pt-use coordinate-point-ideal-Y-class ()) Carrier coefficient-ring Y-polynomial))))
(#theorem coordinate-point-ideal-contains-Y
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter quadratic-linear (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter quadratic-constant (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter root Carrier)
    (#parameter Y-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-member ())
      (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
      (#pt-app
        (#pt-use quadratic-ring-structure ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        quadratic-linear
        quadratic-constant)
      (#pt-app
        (#pt-use coordinate-point-ideal-XY ())
        Carrier
        coefficient-ring
        quadratic-linear
        quadratic-constant
        root
        Y-polynomial)
      (#pt-app (#pt-use coordinate-point-ideal-Y-class ()) Carrier coefficient-ring Y-polynomial)))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-pair-second ())
      (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
      (#pt-app
        (#pt-use quadratic-ring-structure ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        quadratic-linear
        quadratic-constant)
      (#pt-app (#pt-use coordinate-point-ideal-X-class ()) Carrier coefficient-ring root)
      (#pt-app (#pt-use coordinate-point-ideal-Y-class ()) Carrier coefficient-ring Y-polynomial))))
(#theorem coordinate-point-ideal-least
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter quadratic-linear (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter quadratic-constant (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter root Carrier)
    (#parameter Y-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter containing-coordinate-ideal (#pt-app (#pt-use ring-ideal ()) (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier)) (#pt-app (#pt-use quadratic-ring-structure ()) (#pt-app (#pt-use finite-list ()) Carrier) (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring) quadratic-linear quadratic-constant)))
    (#parameter X-member (#pt-app (#pt-use ring-ideal-member ()) (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier)) (#pt-app (#pt-use quadratic-ring-structure ()) (#pt-app (#pt-use finite-list ()) Carrier) (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring) quadratic-linear quadratic-constant) containing-coordinate-ideal (#pt-app (#pt-use coordinate-point-ideal-X-class ()) Carrier coefficient-ring root)))
    (#parameter Y-member (#pt-app (#pt-use ring-ideal-member ()) (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier)) (#pt-app (#pt-use quadratic-ring-structure ()) (#pt-app (#pt-use finite-list ()) Carrier) (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring) quadratic-linear quadratic-constant) containing-coordinate-ideal (#pt-app (#pt-use coordinate-point-ideal-Y-class ()) Carrier coefficient-ring Y-polynomial))))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
      (#pt-app
        (#pt-use quadratic-ring-structure ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        quadratic-linear
        quadratic-constant)
      (#pt-app
        (#pt-use coordinate-point-ideal-XY ())
        Carrier
        coefficient-ring
        quadratic-linear
        quadratic-constant
        root
        Y-polynomial)
      containing-coordinate-ideal))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-pair-least ())
      (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
      (#pt-app
        (#pt-use quadratic-ring-structure ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        quadratic-linear
        quadratic-constant)
      (#pt-app (#pt-use coordinate-point-ideal-X-class ()) Carrier coefficient-ring root)
      (#pt-app (#pt-use coordinate-point-ideal-Y-class ()) Carrier coefficient-ring Y-polynomial)
      containing-coordinate-ideal
      X-member
      Y-member)))
