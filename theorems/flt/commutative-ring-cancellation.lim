    (#parameter sum-equation (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring (#pt-app (#pt-use ring-add ()) Carrier coefficient-ring first third) (#pt-app (#pt-use ring-add ()) Carrier coefficient-ring second third))))
  (#statement (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring first second))
  (#proof
