; If a signed divisor divides x-y, it divides x^n-y^n for every
; natural n. Nat induction retains actual product factors and signed
; rearrangement certificates, including zero and negative inputs.
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-zero = ./integer-defs.lim::integer-zero)
(#alias integer-one = ./integer-defs.lim::integer-one)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-power = ./integer-defs.lim::integer-power)
(#alias integer-divides = ./integer-defs.lim::integer-divides)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias integer-add-inverse = ./integer-addition.lim::integer-add-inverse)
(#alias integer-divides-zero = ./integer-divisibility.lim::integer-divides-zero)
(#alias
  integer-divides-congruent-target
  =
  ./integer-divisibility.lim::integer-divides-congruent-target)
(#alias integer-divides-add = ./integer-divisibility-addition.lim::integer-divides-add)
(#alias
  integer-divides-product-left
  =
  ./integer-power-divisibility.lim::integer-divides-product-left)
(#alias
  integer-divides-product-right
  =
  ./integer-power-divisibility.lim::integer-divides-product-right)
(#alias
  integer-power-difference-step
  =
  ./integer-integral-identities.lim::integer-power-difference-step)
(#theorem integer-power-difference-divides
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use integer ()))
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter difference-divides (#pt-app (#pt-use integer-divides ()) divisor (#pt-app (#pt-use integer-add ()) first (#pt-app (#pt-use integer-negate ()) second)))))
  (#statement
    (#pt-app
      (#pt-use integer-divides ())
      divisor
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use integer-power ()) first exponent)
        (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-power ()) second exponent)))))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((index #pt-nat))
        (#pt-app
          (#pt-use integer-divides ())
          divisor
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app (#pt-use integer-power ()) first index)
            (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-power ()) second index)))))
      (#pt-app
        (#pt-use integer-divides-congruent-target ())
        divisor
        (#pt-use integer-zero ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-use integer-one ())
          (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ())))
        (#pt-app
          (#pt-use integer-symmetric ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-use integer-one ())
            (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ())))
          (#pt-use integer-zero ())
          (#pt-app (#pt-use integer-add-inverse ()) (#pt-use integer-one ())))
        (#pt-app (#pt-use integer-divides-zero ()) divisor))
      (#pt-lambda
        (
          (previous-exponent #pt-nat)
          (previous-difference
            (#pt-app
              (#pt-use integer-divides ())
              divisor
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app (#pt-use integer-power ()) first previous-exponent)
                (#pt-app
                  (#pt-use integer-negate ())
                  (#pt-app (#pt-use integer-power ()) second previous-exponent))))))
        (#pt-app
          (#pt-use integer-divides-congruent-target ())
          divisor
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-add ()) first (#pt-app (#pt-use integer-negate ()) second))
              (#pt-app (#pt-use integer-power ()) first previous-exponent))
            (#pt-app
              (#pt-use integer-multiply ())
              second
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app (#pt-use integer-power ()) first previous-exponent)
                (#pt-app
                  (#pt-use integer-negate ())
                  (#pt-app (#pt-use integer-power ()) second previous-exponent)))))
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app
              (#pt-use integer-multiply ())
              first
              (#pt-app (#pt-use integer-power ()) first previous-exponent))
            (#pt-app
              (#pt-use integer-negate ())
              (#pt-app
                (#pt-use integer-multiply ())
                second
                (#pt-app (#pt-use integer-power ()) second previous-exponent))))
          (#pt-app
            (#pt-use integer-symmetric ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-multiply ())
                first
                (#pt-app (#pt-use integer-power ()) first previous-exponent))
              (#pt-app
                (#pt-use integer-negate ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  second
                  (#pt-app (#pt-use integer-power ()) second previous-exponent))))
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app
                  (#pt-use integer-add ())
                  first
                  (#pt-app (#pt-use integer-negate ()) second))
                (#pt-app (#pt-use integer-power ()) first previous-exponent))
              (#pt-app
                (#pt-use integer-multiply ())
                second
                (#pt-app
                  (#pt-use integer-add ())
                  (#pt-app (#pt-use integer-power ()) first previous-exponent)
                  (#pt-app
                    (#pt-use integer-negate ())
                    (#pt-app (#pt-use integer-power ()) second previous-exponent)))))
            (#pt-app
              (#pt-use integer-power-difference-step ())
              first
              second
              (#pt-app (#pt-use integer-power ()) first previous-exponent)
              (#pt-app (#pt-use integer-power ()) second previous-exponent)))
          (#pt-app
            (#pt-use integer-divides-add ())
            divisor
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-add ()) first (#pt-app (#pt-use integer-negate ()) second))
              (#pt-app (#pt-use integer-power ()) first previous-exponent))
            (#pt-app
              (#pt-use integer-multiply ())
              second
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app (#pt-use integer-power ()) first previous-exponent)
                (#pt-app
                  (#pt-use integer-negate ())
                  (#pt-app (#pt-use integer-power ()) second previous-exponent))))
            (#pt-app
              (#pt-use integer-divides-product-left ())
              divisor
              (#pt-app (#pt-use integer-add ()) first (#pt-app (#pt-use integer-negate ()) second))
              (#pt-app (#pt-use integer-power ()) first previous-exponent)
              difference-divides)
            (#pt-app
              (#pt-use integer-divides-product-right ())
              divisor
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app (#pt-use integer-power ()) first previous-exponent)
                (#pt-app
                  (#pt-use integer-negate ())
                  (#pt-app (#pt-use integer-power ()) second previous-exponent)))
              second
              previous-difference))))
      exponent)))
