(#theorem integer-nonmultiple-positive-magnitude
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter magnitude #pt-nat)
    (#parameter not-three-divides (#pt-pi ((denied-proof (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)) number))) #pt-false))
    (#parameter normal-equivalence (#pt-app (#pt-use integer-equal ()) number (#pt-app (#pt-use integer-of-natural ()) magnitude))))
  (#statement
    (#pt-pi ((denied-proof (#pt-app (#pt-use divides ()) (#pt-numeral 3) magnitude))) #pt-false))
  (#proof
    (#pt-lambda
      ((natural-divides (#pt-app (#pt-use divides ()) (#pt-numeral 3) magnitude)))
      (#pt-app
        not-three-divides
        (#pt-app
          (#pt-use integer-divides-congruent-target ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
          (#pt-app (#pt-use integer-of-natural ()) magnitude)
          number
          (#pt-app
            (#pt-use integer-symmetric ())
            number
            (#pt-app (#pt-use integer-of-natural ()) magnitude)
            normal-equivalence)
          (#pt-app
            (#pt-use integer-divides-of-natural ())
            (#pt-numeral 3)
            magnitude
            natural-divides))))))
(#theorem integer-nonmultiple-negative-magnitude
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter magnitude #pt-nat)
    (#parameter not-three-divides (#pt-pi ((denied-proof (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)) number))) #pt-false))
