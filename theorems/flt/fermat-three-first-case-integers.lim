            (#pt-app (#pt-use integer-of-natural ()) magnitude)
            (#pt-app
              (#pt-use integer-divides-of-natural ())
              (#pt-numeral 3)
              magnitude
              natural-divides)))))))
(#theorem fermat-three-first-case-integer-coordinates
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter first-not-divisible (#pt-pi ((denied-proof (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)) first))) #pt-false))
    (#parameter second-not-divisible (#pt-pi ((denied-proof (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)) second))) #pt-false))
    (#parameter third-not-divisible (#pt-pi ((denied-proof (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)) third))) #pt-false)))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app (#pt-use integer-cube ()) first)
              (#pt-app (#pt-use integer-cube ()) second))
            (#pt-app (#pt-use integer-cube ()) third))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (cube-equation
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app (#pt-use integer-cube ()) first)
              (#pt-app (#pt-use integer-cube ()) second))
            (#pt-app (#pt-use integer-cube ()) third))))
      (#pt-app
        (#pt-use disjunction-eliminate ())
        (#pt-app
          (#pt-use exists (0))
          #pt-nat
          (#pt-lambda
            ((candidate-magnitude #pt-nat))
            (#pt-app
              (#pt-use integer-equal ())
              first
              (#pt-app (#pt-use integer-of-natural ()) candidate-magnitude))))
        (#pt-app
          (#pt-use exists (0))
          #pt-nat
          (#pt-lambda
            ((candidate-magnitude #pt-nat))
            (#pt-app
              (#pt-use integer-equal ())
              first
              (#pt-app (#pt-use integer-negative-natural ()) candidate-magnitude))))
        #pt-false
        (#pt-lambda
          (
            (first-positive-form
              (#pt-app
                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((candidate-magnitude #pt-nat))
