(#theorem integer-nondivisor-product-left
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use integer ()))
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter product-not-divisible (#pt-pi ((denied-proof (#pt-app (#pt-use integer-divides ()) divisor (#pt-app (#pt-use integer-multiply ()) first second)))) #pt-false)))
  (#statement
    (#pt-pi ((denied-proof (#pt-app (#pt-use integer-divides ()) divisor first))) #pt-false))
  (#proof
    (#pt-lambda
      ((factor-divides (#pt-app (#pt-use integer-divides ()) divisor first)))
      (#pt-app
        product-not-divisible
        (#pt-app
          (#pt-use integer-divides-transitive ())
          divisor
          first
          (#pt-app (#pt-use integer-multiply ()) first second)
          factor-divides
          (#pt-app (#pt-use integer-divides-multiple ()) first second))))))
(#theorem integer-nondivisor-product-right
