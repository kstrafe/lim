  (#proof
    (#pt-lambda
      ((factor-divides (#pt-app (#pt-use integer-divides ()) divisor second)))
      (#pt-app
        product-not-divisible
        (#pt-app
          (#pt-use integer-divides-congruent-target ())
          divisor
          (#pt-app (#pt-use integer-multiply ()) second first)
          (#pt-app (#pt-use integer-multiply ()) first second)
          (#pt-app (#pt-use integer-multiply-commutative ()) second first)
          (#pt-app
            (#pt-use integer-divides-transitive ())
            divisor
            second
            (#pt-app (#pt-use integer-multiply ()) second first)
            factor-divides
            (#pt-app (#pt-use integer-divides-multiple ()) second first)))))))
