                (certificate
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((candidate-magnitude #pt-nat))
                      (#pt-app
                        (#pt-use integer-equal ())
                        first
                        (#pt-app (#pt-use integer-of-natural ()) candidate-magnitude))))))
              #pt-false)
            (
              (#pt-lambda
                (
                  (first-magnitude #pt-nat)
                  (first-normal-equivalence
                    (#pt-app
                      (#pt-use integer-equal ())
                      first
                      (#pt-app (#pt-use integer-of-natural ()) first-magnitude))))
                (#pt-app
