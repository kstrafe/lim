; Integer coprimality has an actual Bezout witness after Eisenstein embedding.
; The target coefficients are the images of the checked integer coefficients.
; No coprimality annotation or unproved cast interface supplies the result.
(#alias exists = ./logic-exists.lim::exists)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-one = ./integer-defs.lim::integer-one)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-bezout-equation = ./integer-bezout-defs.lim::integer-bezout-equation)
(#alias integer-has-bezout = ./integer-bezout-defs.lim::integer-has-bezout)
(#alias integer-coprime = ./integer-gcd-bezout.lim::integer-coprime)
(#alias integer-gcd-spec = ./integer-gcd.lim::integer-gcd-spec)
(#alias integer-coprime-of-gcd-one = ./integer-gcd-bezout.lim::integer-coprime-of-gcd-one)
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-of-integer = ./eisenstein-defs.lim::eisenstein-of-integer)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-add = ./eisenstein-defs.lim::eisenstein-add)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-coprime = ./eisenstein-defs.lim::eisenstein-coprime)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-add-congruent = ./eisenstein-equality.lim::eisenstein-add-congruent)
(#alias
  eisenstein-of-integer-congruent
  =
  ./eisenstein-equality.lim::eisenstein-of-integer-congruent)
(#alias eisenstein-of-integer-add = ./eisenstein-embedding.lim::eisenstein-of-integer-add)
(#alias eisenstein-of-integer-multiply = ./eisenstein-embedding.lim::eisenstein-of-integer-multiply)
(#theorem eisenstein-coprime-of-integer
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter integer-coprime-proof (#pt-app (#pt-use integer-coprime ()) first second)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-coprime ())
      (#pt-app (#pt-use eisenstein-of-integer ()) first)
      (#pt-app (#pt-use eisenstein-of-integer ()) second)))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use integer ())
        (#pt-lambda
          ((candidate-left (#pt-use integer ())))
          (#pt-app
            (#pt-use exists (0))
            (#pt-use integer ())
            (#pt-lambda
              ((candidate-right (#pt-use integer ())))
              (#pt-app
                (#pt-use integer-bezout-equation ())
                first
                second
                (#pt-use integer-one ())
                candidate-left
                candidate-right)))))
      (#pt-lambda
        (
          (integer-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-left (#pt-use integer ())))
                (#pt-app
                  (#pt-use exists (0))
                  (#pt-use integer ())
                  (#pt-lambda
                    ((candidate-right (#pt-use integer ())))
                    (#pt-app
                      (#pt-use integer-bezout-equation ())
                      first
                      second
                      (#pt-use integer-one ())
                      candidate-left
                      candidate-right)))))))
        (#pt-app
          (#pt-use eisenstein-coprime ())
          (#pt-app (#pt-use eisenstein-of-integer ()) first)
          (#pt-app (#pt-use eisenstein-of-integer ()) second)))
      (
        (#pt-lambda
          (
            (left-coefficient (#pt-use integer ()))
            (right-certificate
              (#pt-app
                (#pt-use exists (0))
                (#pt-use integer ())
                (#pt-lambda
                  ((candidate-right (#pt-use integer ())))
                  (#pt-app
                    (#pt-use integer-bezout-equation ())
                    first
                    second
                    (#pt-use integer-one ())
                    left-coefficient
                    candidate-right)))))
          (#pt-induct
            exists
            (0)
            (
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-right (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-bezout-equation ())
                  first
                  second
                  (#pt-use integer-one ())
                  left-coefficient
                  candidate-right)))
            (#pt-lambda
              (
                (integer-certificate
                  (#pt-app
                    (#pt-use exists (0))
                    (#pt-use integer ())
                    (#pt-lambda
                      ((candidate-right (#pt-use integer ())))
                      (#pt-app
                        (#pt-use integer-bezout-equation ())
                        first
                        second
                        (#pt-use integer-one ())
                        left-coefficient
                        candidate-right)))))
              (#pt-app
                (#pt-use eisenstein-coprime ())
                (#pt-app (#pt-use eisenstein-of-integer ()) first)
                (#pt-app (#pt-use eisenstein-of-integer ()) second)))
            (
              (#pt-lambda
                (
                  (right-coefficient (#pt-use integer ()))
                  (coefficient-equation
                    (#pt-app
                      (#pt-use integer-bezout-equation ())
                      first
                      second
                      (#pt-use integer-one ())
                      left-coefficient
                      right-coefficient)))
                (#pt-construct
                  exists
                  (0)
                  (
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-left (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use exists (0))
                        (#pt-use eisenstein ())
                        (#pt-lambda
                          ((candidate-right (#pt-use eisenstein ())))
                          (#pt-app
                            (#pt-use eisenstein-equal ())
                            (#pt-use eisenstein-one ())
                            (#pt-app
                              (#pt-use eisenstein-add ())
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                candidate-left
                                (#pt-app (#pt-use eisenstein-of-integer ()) first))
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                candidate-right
                                (#pt-app (#pt-use eisenstein-of-integer ()) second))))))))
                  introduce
                  (
                    (#pt-app (#pt-use eisenstein-of-integer ()) left-coefficient)
                    (#pt-construct
                      exists
                      (0)
                      (
                        (#pt-use eisenstein ())
                        (#pt-lambda
                          ((candidate-right (#pt-use eisenstein ())))
                          (#pt-app
                            (#pt-use eisenstein-equal ())
                            (#pt-use eisenstein-one ())
                            (#pt-app
                              (#pt-use eisenstein-add ())
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                (#pt-app (#pt-use eisenstein-of-integer ()) left-coefficient)
                                (#pt-app (#pt-use eisenstein-of-integer ()) first))
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                candidate-right
                                (#pt-app (#pt-use eisenstein-of-integer ()) second))))))
                      introduce
                      (
                        (#pt-app (#pt-use eisenstein-of-integer ()) right-coefficient)
                        (#pt-app
                          (#pt-use eisenstein-transitive ())
                          (#pt-use eisenstein-one ())
                          (#pt-app
                            (#pt-use eisenstein-of-integer ())
                            (#pt-app
                              (#pt-use integer-add ())
                              (#pt-app (#pt-use integer-multiply ()) left-coefficient first)
                              (#pt-app (#pt-use integer-multiply ()) right-coefficient second)))
                          (#pt-app
                            (#pt-use eisenstein-add ())
                            (#pt-app
                              (#pt-use eisenstein-multiply ())
                              (#pt-app (#pt-use eisenstein-of-integer ()) left-coefficient)
                              (#pt-app (#pt-use eisenstein-of-integer ()) first))
                            (#pt-app
                              (#pt-use eisenstein-multiply ())
                              (#pt-app (#pt-use eisenstein-of-integer ()) right-coefficient)
                              (#pt-app (#pt-use eisenstein-of-integer ()) second)))
                          (#pt-app
                            (#pt-use eisenstein-of-integer-congruent ())
                            (#pt-use integer-one ())
                            (#pt-app
                              (#pt-use integer-add ())
                              (#pt-app (#pt-use integer-multiply ()) left-coefficient first)
                              (#pt-app (#pt-use integer-multiply ()) right-coefficient second))
                            coefficient-equation)
                          (#pt-app
                            (#pt-use eisenstein-transitive ())
                            (#pt-app
                              (#pt-use eisenstein-of-integer ())
                              (#pt-app
                                (#pt-use integer-add ())
                                (#pt-app (#pt-use integer-multiply ()) left-coefficient first)
                                (#pt-app (#pt-use integer-multiply ()) right-coefficient second)))
                            (#pt-app
                              (#pt-use eisenstein-add ())
                              (#pt-app
                                (#pt-use eisenstein-of-integer ())
                                (#pt-app (#pt-use integer-multiply ()) left-coefficient first))
                              (#pt-app
                                (#pt-use eisenstein-of-integer ())
                                (#pt-app (#pt-use integer-multiply ()) right-coefficient second)))
                            (#pt-app
                              (#pt-use eisenstein-add ())
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                (#pt-app (#pt-use eisenstein-of-integer ()) left-coefficient)
                                (#pt-app (#pt-use eisenstein-of-integer ()) first))
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                (#pt-app (#pt-use eisenstein-of-integer ()) right-coefficient)
                                (#pt-app (#pt-use eisenstein-of-integer ()) second)))
                            (#pt-app
                              (#pt-use eisenstein-of-integer-add ())
                              (#pt-app (#pt-use integer-multiply ()) left-coefficient first)
                              (#pt-app (#pt-use integer-multiply ()) right-coefficient second))
                            (#pt-app
                              (#pt-use eisenstein-add-congruent ())
                              (#pt-app
                                (#pt-use eisenstein-of-integer ())
                                (#pt-app (#pt-use integer-multiply ()) left-coefficient first))
                              (#pt-app
                                (#pt-use eisenstein-of-integer ())
                                (#pt-app (#pt-use integer-multiply ()) right-coefficient second))
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                (#pt-app (#pt-use eisenstein-of-integer ()) left-coefficient)
                                (#pt-app (#pt-use eisenstein-of-integer ()) first))
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                (#pt-app (#pt-use eisenstein-of-integer ()) right-coefficient)
                                (#pt-app (#pt-use eisenstein-of-integer ()) second))
                              (#pt-app
                                (#pt-use eisenstein-of-integer-multiply ())
                                left-coefficient
                                first)
                              (#pt-app
                                (#pt-use eisenstein-of-integer-multiply ())
                                right-coefficient
                                second))))))))))
            right-certificate)))
      integer-coprime-proof)))
(#theorem eisenstein-coprime-of-integer-gcd-one
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter gcd-one-proof (#pt-app (#pt-use integer-gcd-spec ()) first second (#pt-succ #pt-zero))))
  (#statement
    (#pt-app
      (#pt-use eisenstein-coprime ())
      (#pt-app (#pt-use eisenstein-of-integer ()) first)
      (#pt-app (#pt-use eisenstein-of-integer ()) second)))
  (#proof
    (#pt-app
      (#pt-use eisenstein-coprime-of-integer ())
      first
      second
      (#pt-app (#pt-use integer-coprime-of-gcd-one ()) first second gcd-one-proof))))
