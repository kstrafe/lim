(#theorem ring-polynomial-degree-X
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-degree-witness ())
      Carrier
      coefficient-ring
      (#pt-construct
        finite-list
        ()
        (Carrier)
        cons
        (
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
          (#pt-construct
            finite-list
            ()
            (Carrier)
            cons
            (
              (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
              (#pt-construct finite-list () (Carrier) nil ())))))
      (#pt-numeral 1)))
  (#proof
    (#pt-app
      (#pt-use ring-polynomial-degree-cons-successor ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
      (#pt-construct
        finite-list
        ()
        (Carrier)
        cons
        (
          (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
          (#pt-construct finite-list () (Carrier) nil ())))
      #pt-zero
      (#pt-app (#pt-use ring-polynomial-degree-one ()) Carrier coefficient-ring coefficient-domain))))
