; Faithful scalar embedding into the concrete Eisenstein operations.
; Every preservation claim is a componentwise checked integer equation.
(#alias exists = ./logic-exists.lim::exists)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-zero = ./integer-defs.lim::integer-zero)
(#alias integer-one = ./integer-defs.lim::integer-one)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-power = ./integer-defs.lim::integer-power)
(#alias integer-divides = ./integer-defs.lim::integer-divides)
(#alias integer-reflexive = ./integer-equality.lim::integer-reflexive)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias integer-negate-congruent = ./integer-equality.lim::integer-negate-congruent)
(#alias integer-add-congruent = ./integer-equality.lim::integer-add-congruent)
(#alias integer-add-zero = ./integer-addition.lim::integer-add-zero)
(#alias integer-multiply-zero = ./integer-multiplication.lim::integer-multiply-zero)
(#alias integer-zero-multiply = ./integer-bezout-algebra.lim::integer-zero-multiply)
(#alias integer-of-natural-injective = ./integer-equality.lim::integer-of-natural-injective)
(#alias successor-not-zero = ./natural-nonzero.lim::successor-not-zero)
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-of-integer = ./eisenstein-defs.lim::eisenstein-of-integer)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-add = ./eisenstein-defs.lim::eisenstein-add)
(#alias eisenstein-negate = ./eisenstein-defs.lim::eisenstein-negate)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-power = ./eisenstein-defs.lim::eisenstein-power)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias eisenstein-reflexive = ./eisenstein-equality.lim::eisenstein-reflexive)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-congruent = ./eisenstein-equality.lim::eisenstein-multiply-congruent)
(#alias
  eisenstein-of-integer-congruent
  =
  ./eisenstein-equality.lim::eisenstein-of-integer-congruent)
(#alias
  eisenstein-of-integer-injective
  =
  ./eisenstein-equality.lim::eisenstein-of-integer-injective)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#theorem eisenstein-of-integer-add
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app (#pt-use eisenstein-of-integer ()) (#pt-app (#pt-use integer-add ()) first second))
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app (#pt-use eisenstein-of-integer ()) first)
        (#pt-app (#pt-use eisenstein-of-integer ()) second))))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project
          eisenstein
          0
          (#pt-app
            (#pt-use eisenstein-of-integer ())
            (#pt-app (#pt-use integer-add ()) first second)))
        (#pt-project
          eisenstein
          0
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-of-integer ()) first)
            (#pt-app (#pt-use eisenstein-of-integer ()) second))))
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project
          eisenstein
          1
          (#pt-app
            (#pt-use eisenstein-of-integer ())
            (#pt-app (#pt-use integer-add ()) first second)))
        (#pt-project
          eisenstein
          1
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-of-integer ()) first)
            (#pt-app (#pt-use eisenstein-of-integer ()) second))))
      (#pt-app (#pt-use integer-reflexive ()) (#pt-app (#pt-use integer-add ()) first second))
      (#pt-app
        (#pt-use integer-symmetric ())
        (#pt-app (#pt-use integer-add ()) (#pt-use integer-zero ()) (#pt-use integer-zero ()))
        (#pt-use integer-zero ())
        (#pt-app (#pt-use integer-add-zero ()) (#pt-use integer-zero ()))))))
(#theorem eisenstein-of-integer-negate
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app (#pt-use eisenstein-of-integer ()) (#pt-app (#pt-use integer-negate ()) first))
      (#pt-app (#pt-use eisenstein-negate ()) (#pt-app (#pt-use eisenstein-of-integer ()) first))))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project
          eisenstein
          0
          (#pt-app (#pt-use eisenstein-of-integer ()) (#pt-app (#pt-use integer-negate ()) first)))
        (#pt-project
          eisenstein
          0
          (#pt-app
            (#pt-use eisenstein-negate ())
            (#pt-app (#pt-use eisenstein-of-integer ()) first))))
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project
          eisenstein
          1
          (#pt-app (#pt-use eisenstein-of-integer ()) (#pt-app (#pt-use integer-negate ()) first)))
        (#pt-project
          eisenstein
          1
          (#pt-app
            (#pt-use eisenstein-negate ())
            (#pt-app (#pt-use eisenstein-of-integer ()) first))))
      (#pt-app (#pt-use integer-reflexive ()) (#pt-app (#pt-use integer-negate ()) first))
      (#pt-app (#pt-use integer-reflexive ()) (#pt-use integer-zero ())))))
(#theorem eisenstein-of-integer-multiply
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app
        (#pt-use eisenstein-of-integer ())
        (#pt-app (#pt-use integer-multiply ()) first second))
      (#pt-app
        (#pt-use eisenstein-multiply ())
        (#pt-app (#pt-use eisenstein-of-integer ()) first)
        (#pt-app (#pt-use eisenstein-of-integer ()) second))))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project
          eisenstein
          0
          (#pt-app
            (#pt-use eisenstein-of-integer ())
            (#pt-app (#pt-use integer-multiply ()) first second)))
        (#pt-project
          eisenstein
          0
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-of-integer ()) first)
            (#pt-app (#pt-use eisenstein-of-integer ()) second))))
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project
          eisenstein
          1
          (#pt-app
            (#pt-use eisenstein-of-integer ())
            (#pt-app (#pt-use integer-multiply ()) first second)))
        (#pt-project
          eisenstein
          1
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-of-integer ()) first)
            (#pt-app (#pt-use eisenstein-of-integer ()) second))))
      (#pt-app
        (#pt-use integer-symmetric ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app (#pt-use integer-multiply ()) first second)
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-use integer-zero ())
              (#pt-use integer-zero ()))))
        (#pt-app (#pt-use integer-multiply ()) first second)
        (#pt-app
          (#pt-use integer-transitive ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            (#pt-app
              (#pt-use integer-negate ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-use integer-zero ())
                (#pt-use integer-zero ()))))
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            (#pt-use integer-zero ()))
          (#pt-app (#pt-use integer-multiply ()) first second)
          (#pt-app
            (#pt-use integer-add-congruent ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            (#pt-app
              (#pt-use integer-negate ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-use integer-zero ())
                (#pt-use integer-zero ())))
            (#pt-app (#pt-use integer-multiply ()) first second)
            (#pt-use integer-zero ())
            (#pt-app
              (#pt-use integer-reflexive ())
              (#pt-app (#pt-use integer-multiply ()) first second))
            (#pt-app
              (#pt-use integer-negate-congruent ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-use integer-zero ())
                (#pt-use integer-zero ()))
              (#pt-use integer-zero ())
              (#pt-app (#pt-use integer-multiply-zero ()) (#pt-use integer-zero ()))))
          (#pt-app
            (#pt-use integer-add-zero ())
            (#pt-app (#pt-use integer-multiply ()) first second))))
      (#pt-app
        (#pt-use integer-symmetric ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app (#pt-use integer-multiply ()) first (#pt-use integer-zero ()))
            (#pt-app (#pt-use integer-multiply ()) (#pt-use integer-zero ()) second))
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-use integer-zero ())
              (#pt-use integer-zero ()))))
        (#pt-use integer-zero ())
        (#pt-app
          (#pt-use integer-transitive ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app (#pt-use integer-multiply ()) first (#pt-use integer-zero ()))
              (#pt-app (#pt-use integer-multiply ()) (#pt-use integer-zero ()) second))
            (#pt-app
              (#pt-use integer-negate ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-use integer-zero ())
                (#pt-use integer-zero ()))))
          (#pt-app (#pt-use integer-add ()) (#pt-use integer-zero ()) (#pt-use integer-zero ()))
          (#pt-use integer-zero ())
          (#pt-app
            (#pt-use integer-add-congruent ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app (#pt-use integer-multiply ()) first (#pt-use integer-zero ()))
              (#pt-app (#pt-use integer-multiply ()) (#pt-use integer-zero ()) second))
            (#pt-app
              (#pt-use integer-negate ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-use integer-zero ())
                (#pt-use integer-zero ())))
            (#pt-use integer-zero ())
            (#pt-use integer-zero ())
            (#pt-app
              (#pt-use integer-transitive ())
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app (#pt-use integer-multiply ()) first (#pt-use integer-zero ()))
                (#pt-app (#pt-use integer-multiply ()) (#pt-use integer-zero ()) second))
              (#pt-app (#pt-use integer-add ()) (#pt-use integer-zero ()) (#pt-use integer-zero ()))
              (#pt-use integer-zero ())
              (#pt-app
                (#pt-use integer-add-congruent ())
                (#pt-app (#pt-use integer-multiply ()) first (#pt-use integer-zero ()))
                (#pt-app (#pt-use integer-multiply ()) (#pt-use integer-zero ()) second)
                (#pt-use integer-zero ())
                (#pt-use integer-zero ())
                (#pt-app (#pt-use integer-multiply-zero ()) first)
                (#pt-app (#pt-use integer-zero-multiply ()) second))
              (#pt-app (#pt-use integer-add-zero ()) (#pt-use integer-zero ())))
            (#pt-app
              (#pt-use integer-negate-congruent ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-use integer-zero ())
                (#pt-use integer-zero ()))
              (#pt-use integer-zero ())
              (#pt-app (#pt-use integer-multiply-zero ()) (#pt-use integer-zero ()))))
          (#pt-app (#pt-use integer-add-zero ()) (#pt-use integer-zero ())))))))
(#theorem eisenstein-of-integer-power
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter exponent #pt-nat))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app
        (#pt-use eisenstein-of-integer ())
        (#pt-app (#pt-use integer-power ()) number exponent))
      (#pt-app
        (#pt-use eisenstein-power ())
        (#pt-app (#pt-use eisenstein-of-integer ()) number)
        exponent)))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((ordinal #pt-nat))
        (#pt-app
          (#pt-use eisenstein-equal ())
          (#pt-app
            (#pt-use eisenstein-of-integer ())
            (#pt-app (#pt-use integer-power ()) number ordinal))
          (#pt-app
            (#pt-use eisenstein-power ())
            (#pt-app (#pt-use eisenstein-of-integer ()) number)
            ordinal)))
      (#pt-app (#pt-use eisenstein-reflexive ()) (#pt-use eisenstein-one ()))
      (#pt-lambda
        (
          (previous #pt-nat)
          (previous-preservation
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app
                (#pt-use eisenstein-of-integer ())
                (#pt-app (#pt-use integer-power ()) number previous))
              (#pt-app
                (#pt-use eisenstein-power ())
                (#pt-app (#pt-use eisenstein-of-integer ()) number)
                previous))))
        (#pt-app
          (#pt-use eisenstein-transitive ())
          (#pt-app
            (#pt-use eisenstein-of-integer ())
            (#pt-app
              (#pt-use integer-multiply ())
              number
              (#pt-app (#pt-use integer-power ()) number previous)))
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-of-integer ()) number)
            (#pt-app
              (#pt-use eisenstein-of-integer ())
              (#pt-app (#pt-use integer-power ()) number previous)))
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-of-integer ()) number)
            (#pt-app
              (#pt-use eisenstein-power ())
              (#pt-app (#pt-use eisenstein-of-integer ()) number)
              previous))
          (#pt-app
            (#pt-use eisenstein-of-integer-multiply ())
            number
            (#pt-app (#pt-use integer-power ()) number previous))
          (#pt-app
            (#pt-use eisenstein-multiply-congruent ())
            (#pt-app (#pt-use eisenstein-of-integer ()) number)
            (#pt-app
              (#pt-use eisenstein-of-integer ())
              (#pt-app (#pt-use integer-power ()) number previous))
            (#pt-app (#pt-use eisenstein-of-integer ()) number)
            (#pt-app
              (#pt-use eisenstein-power ())
              (#pt-app (#pt-use eisenstein-of-integer ()) number)
              previous)
            (#pt-app
              (#pt-use eisenstein-reflexive ())
              (#pt-app (#pt-use eisenstein-of-integer ()) number))
            previous-preservation)))
      exponent)))
(#theorem eisenstein-of-natural-injective
  (#universes)
  (#parameters
    (#parameter first-natural #pt-nat)
    (#parameter second-natural #pt-nat)
    (#parameter embedded-equivalence (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-of-integer ()) (#pt-app (#pt-use integer-of-natural ()) first-natural)) (#pt-app (#pt-use eisenstein-of-integer ()) (#pt-app (#pt-use integer-of-natural ()) second-natural)))))
  (#statement (#pt-eq #pt-nat first-natural second-natural))
  (#proof
    (#pt-app
      (#pt-use integer-of-natural-injective ())
      first-natural
      second-natural
      (#pt-app
        (#pt-use eisenstein-of-integer-injective ())
        (#pt-app (#pt-use integer-of-natural ()) first-natural)
        (#pt-app (#pt-use integer-of-natural ()) second-natural)
        embedded-equivalence))))
(#theorem eisenstein-embedded-nonzero
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter integer-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use integer-equal ()) number (#pt-use integer-zero ())))) #pt-false)))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app (#pt-use eisenstein-of-integer ()) number)
            (#pt-use eisenstein-zero ()))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (embedded-zero
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app (#pt-use eisenstein-of-integer ()) number)
            (#pt-use eisenstein-zero ()))))
      (#pt-app
        integer-nonzero
        (#pt-app
          (#pt-use eisenstein-of-integer-injective ())
          number
          (#pt-use integer-zero ())
          embedded-zero)))))
(#theorem eisenstein-one-nonzero
  (#universes)
  (#parameters)
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-use eisenstein-one ())
            (#pt-use eisenstein-zero ()))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (one-zero
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-use eisenstein-one ())
            (#pt-use eisenstein-zero ()))))
      (#pt-app
        (#pt-app (#pt-use successor-not-zero ()) #pt-zero)
        (#pt-app (#pt-use eisenstein-of-natural-injective ()) (#pt-succ #pt-zero) #pt-zero one-zero)))))
(#theorem eisenstein-divides-of-integer
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use integer ()))
    (#parameter number (#pt-use integer ()))
    (#parameter integer-divides-proof (#pt-app (#pt-use integer-divides ()) divisor number)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-divides ())
      (#pt-app (#pt-use eisenstein-of-integer ()) divisor)
      (#pt-app (#pt-use eisenstein-of-integer ()) number)))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use integer ())
        (#pt-lambda
          ((candidate-factor (#pt-use integer ())))
          (#pt-app
            (#pt-use integer-equal ())
            number
            (#pt-app (#pt-use integer-multiply ()) divisor candidate-factor))))
      (#pt-lambda
        (
          (integer-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  number
                  (#pt-app (#pt-use integer-multiply ()) divisor candidate-factor))))))
        (#pt-app
          (#pt-use eisenstein-divides ())
          (#pt-app (#pt-use eisenstein-of-integer ()) divisor)
          (#pt-app (#pt-use eisenstein-of-integer ()) number)))
      (
        (#pt-lambda
          (
            (factor (#pt-use integer ()))
            (factor-equivalence
              (#pt-app
                (#pt-use integer-equal ())
                number
                (#pt-app (#pt-use integer-multiply ()) divisor factor))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-eisenstein-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-of-integer ()) number)
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app (#pt-use eisenstein-of-integer ()) divisor)
                    candidate-eisenstein-factor))))
            introduce
            (
              (#pt-app (#pt-use eisenstein-of-integer ()) factor)
              (#pt-app
                (#pt-use eisenstein-transitive ())
                (#pt-app (#pt-use eisenstein-of-integer ()) number)
                (#pt-app
                  (#pt-use eisenstein-of-integer ())
                  (#pt-app (#pt-use integer-multiply ()) divisor factor))
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app (#pt-use eisenstein-of-integer ()) divisor)
                  (#pt-app (#pt-use eisenstein-of-integer ()) factor))
                (#pt-app
                  (#pt-use eisenstein-of-integer-congruent ())
                  number
                  (#pt-app (#pt-use integer-multiply ()) divisor factor)
                  factor-equivalence)
                (#pt-app (#pt-use eisenstein-of-integer-multiply ()) divisor factor))))))
      integer-divides-proof)))
