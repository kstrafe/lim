(#alias
  rational-variable-change-act
  =
  ./rational-variable-change-defs.lim::rational-variable-change-act)
(#alias
  rational-variable-change-b4-scale-polynomial
  =
  ./rational-variable-change-b4-scale.lim::rational-variable-change-b4-scale-polynomial)
(#alias
  rational-variable-change-b4-translation-polynomial
  =
  ./rational-variable-change-b4-translation.lim::rational-variable-change-b4-translation-polynomial)
(#alias rational-variable-change-b2 = ./rational-variable-change.lim::rational-variable-change-b2)
(#alias
  rational-variable-change-c4-polynomial
  =
  ./rational-variable-change-c4-polynomial.lim::rational-variable-change-c4-polynomial)
(#theorem rational-variable-change-b4
  (#universes)
  (#parameters
    (#parameter change (#pt-use rational-variable-change ()))
    (#parameter curve (#pt-use rational-weierstrass-curve ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-weierstrass-b4 ())
        (#pt-app (#pt-use rational-variable-change-act ()) change curve))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project rational-variable-change 1 change)
          (#pt-numeral 4))
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-add ())
            (#pt-app (#pt-use rational-weierstrass-b4 ()) curve)
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-project rational-variable-change 2 change)
              (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 6)))
            (#pt-app
              (#pt-use rational-power ())
              (#pt-project rational-variable-change 2 change)
              (#pt-numeral 2)))))))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app
        (#pt-use rational-weierstrass-b4 ())
        (#pt-app (#pt-use rational-variable-change-act ()) change curve))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project rational-variable-change 1 change)
          (#pt-numeral 4))
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
            (#pt-app
              (#pt-use rational-add ())
              (#pt-app
                (#pt-use rational-add ())
                (#pt-app
                  (#pt-use rational-add ())
                  (#pt-app
                    (#pt-use rational-add ())
                    (#pt-app
                      (#pt-use rational-add ())
                      (#pt-project rational-weierstrass-curve 3 curve)
                      (#pt-app
                        (#pt-use rational-negate ())
                        (#pt-app
                          (#pt-use rational-multiply ())
                          (#pt-project rational-variable-change 3 change)
                          (#pt-project rational-weierstrass-curve 2 curve))))
                    (#pt-app
                      (#pt-use rational-multiply ())
                      (#pt-app
                        (#pt-use rational-multiply ())
                        (#pt-app
                          (#pt-use rational-of-integer ())
                          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
                        (#pt-project rational-variable-change 2 change))
                      (#pt-project rational-weierstrass-curve 1 curve)))
                  (#pt-app
                    (#pt-use rational-negate ())
                    (#pt-app
                      (#pt-use rational-multiply ())
                      (#pt-app
                        (#pt-use rational-add ())
                        (#pt-project rational-variable-change 4 change)
                        (#pt-app
                          (#pt-use rational-multiply ())
                          (#pt-project rational-variable-change 2 change)
                          (#pt-project rational-variable-change 3 change)))
                      (#pt-project rational-weierstrass-curve 0 curve))))
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app
                    (#pt-use rational-of-integer ())
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)))
                  (#pt-app
                    (#pt-use rational-power ())
                    (#pt-project rational-variable-change 2 change)
                    (#pt-numeral 2))))
              (#pt-app
                (#pt-use rational-negate ())
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app
                    (#pt-use rational-multiply ())
                    (#pt-app
                      (#pt-use rational-of-integer ())
                      (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
                    (#pt-project rational-variable-change 3 change))
                  (#pt-project rational-variable-change 4 change)))))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-add ())
              (#pt-project rational-weierstrass-curve 0 curve)
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-of-integer ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
                (#pt-project rational-variable-change 3 change)))
            (#pt-app
              (#pt-use rational-add ())
              (#pt-app
                (#pt-use rational-add ())
                (#pt-project rational-weierstrass-curve 2 curve)
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-project rational-variable-change 2 change)
                  (#pt-project rational-weierstrass-curve 0 curve)))
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-of-integer ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
                (#pt-project rational-variable-change 4 change))))))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project rational-variable-change 1 change)
          (#pt-numeral 4))
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-add ())
            (#pt-app (#pt-use rational-weierstrass-b4 ()) curve)
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-project rational-variable-change 2 change)
              (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 6)))
            (#pt-app
              (#pt-use rational-power ())
              (#pt-project rational-variable-change 2 change)
              (#pt-numeral 2)))))
      (#pt-app
        (#pt-use rational-variable-change-b4-scale-polynomial ())
        (#pt-project rational-variable-change 1 change)
        (#pt-app
          (#pt-use rational-add ())
          (#pt-project rational-weierstrass-curve 0 curve)
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
            (#pt-project rational-variable-change 3 change)))
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-add ())
            (#pt-project rational-weierstrass-curve 2 curve)
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-project rational-variable-change 2 change)
              (#pt-project rational-weierstrass-curve 0 curve)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
            (#pt-project rational-variable-change 4 change)))
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-add ())
            (#pt-app
              (#pt-use rational-add ())
              (#pt-app
                (#pt-use rational-add ())
                (#pt-app
                  (#pt-use rational-add ())
                  (#pt-project rational-weierstrass-curve 3 curve)
                  (#pt-app
                    (#pt-use rational-negate ())
                    (#pt-app
                      (#pt-use rational-multiply ())
                      (#pt-project rational-variable-change 3 change)
                      (#pt-project rational-weierstrass-curve 2 curve))))
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app
                    (#pt-use rational-multiply ())
                    (#pt-app
                      (#pt-use rational-of-integer ())
                      (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
                    (#pt-project rational-variable-change 2 change))
                  (#pt-project rational-weierstrass-curve 1 curve)))
              (#pt-app
                (#pt-use rational-negate ())
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app
                    (#pt-use rational-add ())
                    (#pt-project rational-variable-change 4 change)
                    (#pt-app
                      (#pt-use rational-multiply ())
                      (#pt-project rational-variable-change 2 change)
                      (#pt-project rational-variable-change 3 change)))
                  (#pt-project rational-weierstrass-curve 0 curve))))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)))
              (#pt-app
                (#pt-use rational-power ())
                (#pt-project rational-variable-change 2 change)
                (#pt-numeral 2))))
          (#pt-app
            (#pt-use rational-negate ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-of-integer ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
                (#pt-project rational-variable-change 3 change))
              (#pt-project rational-variable-change 4 change)))))
      (#pt-app
        (#pt-use rational-multiply-congruent ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project rational-variable-change 1 change)
          (#pt-numeral 4))
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
            (#pt-app
              (#pt-use rational-add ())
              (#pt-app
                (#pt-use rational-add ())
                (#pt-app
                  (#pt-use rational-add ())
                  (#pt-app
                    (#pt-use rational-add ())
                    (#pt-app
                      (#pt-use rational-add ())
                      (#pt-project rational-weierstrass-curve 3 curve)
                      (#pt-app
                        (#pt-use rational-negate ())
                        (#pt-app
                          (#pt-use rational-multiply ())
                          (#pt-project rational-variable-change 3 change)
                          (#pt-project rational-weierstrass-curve 2 curve))))
                    (#pt-app
                      (#pt-use rational-multiply ())
                      (#pt-app
                        (#pt-use rational-multiply ())
                        (#pt-app
                          (#pt-use rational-of-integer ())
                          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
                        (#pt-project rational-variable-change 2 change))
                      (#pt-project rational-weierstrass-curve 1 curve)))
                  (#pt-app
                    (#pt-use rational-negate ())
                    (#pt-app
                      (#pt-use rational-multiply ())
                      (#pt-app
                        (#pt-use rational-add ())
                        (#pt-project rational-variable-change 4 change)
                        (#pt-app
                          (#pt-use rational-multiply ())
                          (#pt-project rational-variable-change 2 change)
                          (#pt-project rational-variable-change 3 change)))
                      (#pt-project rational-weierstrass-curve 0 curve))))
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app
                    (#pt-use rational-of-integer ())
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)))
                  (#pt-app
                    (#pt-use rational-power ())
                    (#pt-project rational-variable-change 2 change)
                    (#pt-numeral 2))))
              (#pt-app
                (#pt-use rational-negate ())
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app
                    (#pt-use rational-multiply ())
                    (#pt-app
                      (#pt-use rational-of-integer ())
                      (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
                    (#pt-project rational-variable-change 3 change))
                  (#pt-project rational-variable-change 4 change)))))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-add ())
              (#pt-project rational-weierstrass-curve 0 curve)
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-of-integer ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
                (#pt-project rational-variable-change 3 change)))
            (#pt-app
              (#pt-use rational-add ())
              (#pt-app
                (#pt-use rational-add ())
                (#pt-project rational-weierstrass-curve 2 curve)
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-project rational-variable-change 2 change)
                  (#pt-project rational-weierstrass-curve 0 curve)))
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-of-integer ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
                (#pt-project rational-variable-change 4 change)))))
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project rational-variable-change 1 change)
          (#pt-numeral 4))
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-add ())
            (#pt-app (#pt-use rational-weierstrass-b4 ()) curve)
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-project rational-variable-change 2 change)
              (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 6)))
            (#pt-app
              (#pt-use rational-power ())
              (#pt-project rational-variable-change 2 change)
              (#pt-numeral 2))))
        (#pt-app
          (#pt-use rational-reflexive ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-project rational-variable-change 1 change)
            (#pt-numeral 4)))
        (#pt-app
          (#pt-use rational-variable-change-b4-translation-polynomial ())
          (#pt-project rational-variable-change 2 change)
          (#pt-project rational-variable-change 3 change)
          (#pt-project rational-variable-change 4 change)
          (#pt-project rational-weierstrass-curve 0 curve)
          (#pt-project rational-weierstrass-curve 1 curve)
          (#pt-project rational-weierstrass-curve 2 curve)
          (#pt-project rational-weierstrass-curve 3 curve))))))
(#theorem rational-variable-change-c4
  (#universes)
  (#parameters
    (#parameter change (#pt-use rational-variable-change ()))
    (#parameter curve (#pt-use rational-weierstrass-curve ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-weierstrass-c4 ())
        (#pt-app (#pt-use rational-variable-change-act ()) change curve))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project rational-variable-change 1 change)
          (#pt-numeral 4))
        (#pt-app (#pt-use rational-weierstrass-c4 ()) curve))))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app
        (#pt-use rational-weierstrass-c4 ())
        (#pt-app (#pt-use rational-variable-change-act ()) change curve))
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-project rational-variable-change 1 change)
              (#pt-numeral 2))
            (#pt-app
              (#pt-use rational-add ())
              (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-of-integer ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 12)))
                (#pt-project rational-variable-change 2 change))))
          (#pt-numeral 2))
        (#pt-app
          (#pt-use rational-negate ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 24)))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-project rational-variable-change 1 change)
                (#pt-numeral 4))
              (#pt-app
                (#pt-use rational-add ())
                (#pt-app
                  (#pt-use rational-add ())
                  (#pt-app (#pt-use rational-weierstrass-b4 ()) curve)
                  (#pt-app
                    (#pt-use rational-multiply ())
                    (#pt-project rational-variable-change 2 change)
                    (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)))
                (#pt-app
                  (#pt-use rational-multiply ())
                  (#pt-app
                    (#pt-use rational-of-integer ())
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 6)))
                  (#pt-app
                    (#pt-use rational-power ())
                    (#pt-project rational-variable-change 2 change)
                    (#pt-numeral 2))))))))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-project rational-variable-change 1 change)
          (#pt-numeral 4))
        (#pt-app (#pt-use rational-weierstrass-c4 ()) curve))
      (#pt-app
        (#pt-use rational-add-congruent ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app
            (#pt-use rational-weierstrass-b2 ())
            (#pt-app (#pt-use rational-variable-change-act ()) change curve))
          (#pt-numeral 2))
        (#pt-app
          (#pt-use rational-negate ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 24)))
            (#pt-app
              (#pt-use rational-weierstrass-b4 ())
              (#pt-app (#pt-use rational-variable-change-act ()) change curve))))
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-project rational-variable-change 1 change)
