; Native rational specialization of pinned Mathlib VariableChange.lean.
; Candidate proof terms are checked by Lim; no algebra oracle is used.
; b4 from checked translation/scaling polynomials; c4 from b2 and b4.
; No transformation law is assumed as a hypothesis.
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias rational-equal = ./rational-defs.lim::rational-equal)
(#alias rational-of-integer = ./rational-defs.lim::rational-of-integer)
(#alias rational-add = ./rational-defs.lim::rational-add)
(#alias rational-multiply = ./rational-defs.lim::rational-multiply)
(#alias rational-negate = ./rational-defs.lim::rational-negate)
(#alias rational-power = ./rational-defs.lim::rational-power)
(#alias rational-reflexive = ./rational-equality.lim::rational-reflexive)
(#alias rational-transitive = ./rational-equality.lim::rational-transitive)
(#alias rational-add-congruent = ./rational-congruence.lim::rational-add-congruent)
(#alias rational-multiply-congruent = ./rational-congruence.lim::rational-multiply-congruent)
(#alias rational-weierstrass-curve = ./rational-weierstrass-defs.lim::rational-weierstrass-curve)
(#alias rational-weierstrass-b2 = ./rational-weierstrass-defs.lim::rational-weierstrass-b2)
(#alias rational-weierstrass-b4 = ./rational-weierstrass-defs.lim::rational-weierstrass-b4)
(#alias rational-weierstrass-c4 = ./rational-weierstrass-defs.lim::rational-weierstrass-c4)
(#alias rational-negate-congruent = ./rational-congruence.lim::rational-negate-congruent)
