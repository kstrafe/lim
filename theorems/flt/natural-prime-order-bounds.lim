; The retained factorization gives its dividing power and excludes the
; successor and every higher power. Cancel only a proved nonzero prime
; power. A zero number cannot carry a valuation certificate at a prime.
(#alias add = ./../fermat_statement.lim::add)
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias power = ./../fermat_statement.lim::power)
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias congruence = ./equality.lim::congruence)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias power-nonzero = ./natural-nonzero.lim::power-nonzero)
(#alias prime = ./natural-prime.lim::prime)
(#alias multiply-associative = ./natural-multiplication.lim::multiply-associative)
(#alias multiply-commutative = ./natural-multiplication-commutative.lim::multiply-commutative)
(#alias
  multiply-cancel-left-nonzero
  =
  ./natural-square-arithmetic.lim::multiply-cancel-left-nonzero)
(#alias power-add = ./natural-powers.lim::power-add)
(#alias prime-larger-than-one = ./natural-prime.lim::prime-larger-than-one)
(#alias less-than-upper-nonzero = ./natural-small-cases.lim::less-than-upper-nonzero)
(#alias divides-zero = ./natural-divisibility.lim::divides-zero)
(#alias divides-transitive = ./natural-divisibility.lim::divides-transitive)
(#alias natural-prime-order = ./natural-prime-order-defs.lim::natural-prime-order)
(#theorem natural-prime-order-power-divides
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter number #pt-nat)
    (#parameter valuation #pt-nat)
    (#parameter order-certificate (#pt-app (#pt-use natural-prime-order ()) prime-number number valuation)))
  (#statement
    (#pt-app (#pt-use divides ()) (#pt-app (#pt-use power ()) prime-number valuation) number))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-cofactor #pt-nat))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-eq
              #pt-nat
              number
              (#pt-app
                (#pt-use multiply ())
                (#pt-app (#pt-use power ()) prime-number valuation)
                candidate-cofactor))
            (#pt-pi
              ((denied-proof (#pt-app (#pt-use divides ()) prime-number candidate-cofactor)))
              #pt-false))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-cofactor #pt-nat))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-eq
                    #pt-nat
                    number
                    (#pt-app
                      (#pt-use multiply ())
                      (#pt-app (#pt-use power ()) prime-number valuation)
                      candidate-cofactor))
                  (#pt-pi
                    ((denied-proof (#pt-app (#pt-use divides ()) prime-number candidate-cofactor)))
                    #pt-false))))))
        (#pt-app (#pt-use divides ()) (#pt-app (#pt-use power ()) prime-number valuation) number))
      (
        (#pt-lambda
          (
            (cofactor #pt-nat)
            (cofactor-certificate
              (#pt-app
                (#pt-use conjunction ())
                (#pt-eq
                  #pt-nat
                  number
                  (#pt-app
                    (#pt-use multiply ())
                    (#pt-app (#pt-use power ()) prime-number valuation)
                    cofactor))
                (#pt-pi
                  ((denied-proof (#pt-app (#pt-use divides ()) prime-number cofactor)))
                  #pt-false))))
          (#pt-construct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-factor #pt-nat))
                (#pt-eq
                  #pt-nat
                  number
                  (#pt-app
                    (#pt-use multiply ())
                    (#pt-app (#pt-use power ()) prime-number valuation)
                    candidate-factor))))
            introduce
            (cofactor (#pt-project conjunction 0 cofactor-certificate)))))
      order-certificate)))
(#theorem natural-prime-order-next-nondivisor
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter number #pt-nat)
    (#parameter valuation #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter order-certificate (#pt-app (#pt-use natural-prime-order ()) prime-number number valuation)))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use divides ())
            (#pt-app (#pt-use power ()) prime-number (#pt-succ valuation))
            number)))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (next-divides
          (#pt-app
            (#pt-use divides ())
            (#pt-app (#pt-use power ()) prime-number (#pt-succ valuation))
            number)))
      (#pt-induct
        exists
        (0)
        (#pt-nat
          (#pt-lambda
            ((candidate-cofactor #pt-nat))
            (#pt-app
              (#pt-use conjunction ())
              (#pt-eq
                #pt-nat
                number
                (#pt-app
                  (#pt-use multiply ())
                  (#pt-app (#pt-use power ()) prime-number valuation)
                  candidate-cofactor))
              (#pt-pi
                ((denied-proof (#pt-app (#pt-use divides ()) prime-number candidate-cofactor)))
                #pt-false))))
        (#pt-lambda
          (
            (certificate
              (#pt-app
                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((candidate-cofactor #pt-nat))
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-eq
                      #pt-nat
                      number
                      (#pt-app
                        (#pt-use multiply ())
                        (#pt-app (#pt-use power ()) prime-number valuation)
                        candidate-cofactor))
                    (#pt-pi
                      (
                        (denied-proof
                          (#pt-app (#pt-use divides ()) prime-number candidate-cofactor)))
                      #pt-false))))))
          #pt-false)
        (
          (#pt-lambda
            (
              (cofactor #pt-nat)
              (cofactor-certificate
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-eq
                    #pt-nat
                    number
                    (#pt-app
                      (#pt-use multiply ())
                      (#pt-app (#pt-use power ()) prime-number valuation)
                      cofactor))
                  (#pt-pi
                    ((denied-proof (#pt-app (#pt-use divides ()) prime-number cofactor)))
                    #pt-false))))
            (#pt-induct
              exists
              (0)
              (#pt-nat
                (#pt-lambda
                  ((candidate-factor #pt-nat))
                  (#pt-eq
                    #pt-nat
                    number
                    (#pt-app
                      (#pt-use multiply ())
                      (#pt-app (#pt-use power ()) prime-number (#pt-succ valuation))
                      candidate-factor))))
              (#pt-lambda
                (
                  (certificate
                    (#pt-app
                      (#pt-use exists (0))
                      #pt-nat
                      (#pt-lambda
                        ((candidate-factor #pt-nat))
                        (#pt-eq
                          #pt-nat
                          number
                          (#pt-app
                            (#pt-use multiply ())
                            (#pt-app (#pt-use power ()) prime-number (#pt-succ valuation))
                            candidate-factor))))))
                #pt-false)
              (
                (#pt-lambda
                  (
                    (other-cofactor #pt-nat)
                    (next-factor-equation
                      (#pt-eq
                        #pt-nat
                        number
                        (#pt-app
                          (#pt-use multiply ())
                          (#pt-app (#pt-use power ()) prime-number (#pt-succ valuation))
                          other-cofactor))))
                  (#pt-app
                    (#pt-project conjunction 1 cofactor-certificate)
                    (#pt-construct
                      exists
                      (0)
                      (#pt-nat
                        (#pt-lambda
                          ((candidate-factor #pt-nat))
                          (#pt-eq
                            #pt-nat
                            cofactor
                            (#pt-app (#pt-use multiply ()) prime-number candidate-factor))))
                      introduce
                      (other-cofactor
                        (#pt-app
                          (#pt-use multiply-cancel-left-nonzero ())
                          (#pt-app (#pt-use power ()) prime-number valuation)
                          cofactor
                          (#pt-app (#pt-use multiply ()) prime-number other-cofactor)
                          (#pt-app
                            (#pt-use power-nonzero ())
                            prime-number
                            valuation
                            (#pt-app
                              (#pt-use less-than-upper-nonzero ())
                              (#pt-succ #pt-zero)
                              prime-number
                              (#pt-app (#pt-use prime-larger-than-one ()) prime-number prime-proof)))
                          (#pt-app
                            (#pt-use transitivity (0))
                            #pt-nat
                            (#pt-app
                              (#pt-use multiply ())
                              (#pt-app (#pt-use power ()) prime-number valuation)
                              cofactor)
                            number
                            (#pt-app
                              (#pt-use multiply ())
                              (#pt-app (#pt-use power ()) prime-number valuation)
                              (#pt-app (#pt-use multiply ()) prime-number other-cofactor))
                            (#pt-app
                              (#pt-use symmetry (0))
                              #pt-nat
                              number
                              (#pt-app
                                (#pt-use multiply ())
                                (#pt-app (#pt-use power ()) prime-number valuation)
                                cofactor)
                              (#pt-project conjunction 0 cofactor-certificate))
                            (#pt-app
                              (#pt-use transitivity (0))
                              #pt-nat
                              number
                              (#pt-app
                                (#pt-use multiply ())
                                (#pt-app (#pt-use power ()) prime-number (#pt-succ valuation))
                                other-cofactor)
                              (#pt-app
                                (#pt-use multiply ())
                                (#pt-app (#pt-use power ()) prime-number valuation)
                                (#pt-app (#pt-use multiply ()) prime-number other-cofactor))
                              next-factor-equation
                              (#pt-app
                                (#pt-use transitivity (0))
                                #pt-nat
                                (#pt-app
                                  (#pt-use multiply ())
                                  (#pt-app (#pt-use power ()) prime-number (#pt-succ valuation))
                                  other-cofactor)
                                (#pt-app
                                  (#pt-use multiply ())
                                  (#pt-app
                                    (#pt-use multiply ())
                                    (#pt-app (#pt-use power ()) prime-number valuation)
                                    prime-number)
                                  other-cofactor)
                                (#pt-app
                                  (#pt-use multiply ())
                                  (#pt-app (#pt-use power ()) prime-number valuation)
                                  (#pt-app (#pt-use multiply ()) prime-number other-cofactor))
                                (#pt-app
                                  (#pt-use congruence (0 0))
                                  #pt-nat
                                  #pt-nat
                                  (#pt-lambda
                                    ((power-factor #pt-nat))
                                    (#pt-app (#pt-use multiply ()) power-factor other-cofactor))
                                  (#pt-app
                                    (#pt-use multiply ())
                                    prime-number
                                    (#pt-app (#pt-use power ()) prime-number valuation))
                                  (#pt-app
                                    (#pt-use multiply ())
                                    (#pt-app (#pt-use power ()) prime-number valuation)
                                    prime-number)
                                  (#pt-app
                                    (#pt-use multiply-commutative ())
                                    prime-number
                                    (#pt-app (#pt-use power ()) prime-number valuation)))
                                (#pt-app
                                  (#pt-use multiply-associative ())
                                  (#pt-app (#pt-use power ()) prime-number valuation)
                                  prime-number
                                  other-cofactor))))))))))
              next-divides)))
        order-certificate))))
(#theorem natural-prime-order-excludes-higher
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter number #pt-nat)
    (#parameter valuation #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter order-certificate (#pt-app (#pt-use natural-prime-order ()) prime-number number valuation))
    (#parameter other-valuation #pt-nat)
    (#parameter higher-exponent (#pt-app (#pt-use less-than ()) valuation other-valuation)))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use divides ())
            (#pt-app (#pt-use power ()) prime-number other-valuation)
            number)))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (higher-divides
          (#pt-app
            (#pt-use divides ())
            (#pt-app (#pt-use power ()) prime-number other-valuation)
            number)))
      (#pt-induct
        exists
        (0)
        (#pt-nat
          (#pt-lambda
            ((candidate-gap #pt-nat))
            (#pt-eq
              #pt-nat
              other-valuation
              (#pt-app (#pt-use add ()) (#pt-succ valuation) candidate-gap))))
        (#pt-lambda
          (
            (certificate
              (#pt-app
                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((candidate-gap #pt-nat))
                  (#pt-eq
                    #pt-nat
                    other-valuation
                    (#pt-app (#pt-use add ()) (#pt-succ valuation) candidate-gap))))))
          #pt-false)
        (
          (#pt-lambda
            (
              (exponent-gap #pt-nat)
              (exponent-equation
                (#pt-eq
                  #pt-nat
                  other-valuation
                  (#pt-app (#pt-use add ()) (#pt-succ valuation) exponent-gap))))
            (#pt-app
              (#pt-app
                (#pt-use natural-prime-order-next-nondivisor ())
                prime-number
                number
                valuation
                prime-proof
                order-certificate)
              (#pt-app
                (#pt-use divides-transitive ())
                (#pt-app (#pt-use power ()) prime-number (#pt-succ valuation))
                (#pt-app (#pt-use power ()) prime-number other-valuation)
                number
                (#pt-construct
                  exists
                  (0)
                  (#pt-nat
                    (#pt-lambda
                      ((candidate-factor #pt-nat))
                      (#pt-eq
                        #pt-nat
                        (#pt-app (#pt-use power ()) prime-number other-valuation)
                        (#pt-app
                          (#pt-use multiply ())
                          (#pt-app (#pt-use power ()) prime-number (#pt-succ valuation))
                          candidate-factor))))
                  introduce
                  (
                    (#pt-app (#pt-use power ()) prime-number exponent-gap)
                    (#pt-app
                      (#pt-use transitivity (0))
                      #pt-nat
                      (#pt-app (#pt-use power ()) prime-number other-valuation)
                      (#pt-app
                        (#pt-use power ())
                        prime-number
                        (#pt-app (#pt-use add ()) (#pt-succ valuation) exponent-gap))
                      (#pt-app
                        (#pt-use multiply ())
                        (#pt-app (#pt-use power ()) prime-number (#pt-succ valuation))
                        (#pt-app (#pt-use power ()) prime-number exponent-gap))
                      (#pt-app
                        (#pt-use congruence (0 0))
                        #pt-nat
                        #pt-nat
                        (#pt-lambda
                          ((power-index #pt-nat))
                          (#pt-app (#pt-use power ()) prime-number power-index))
                        other-valuation
                        (#pt-app (#pt-use add ()) (#pt-succ valuation) exponent-gap)
                        exponent-equation)
                      (#pt-app
                        (#pt-use power-add ())
                        prime-number
                        (#pt-succ valuation)
                        exponent-gap))))
                higher-divides))))
        higher-exponent))))
(#theorem natural-prime-order-nonzero
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter number #pt-nat)
    (#parameter valuation #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter order-certificate (#pt-app (#pt-use natural-prime-order ()) prime-number number valuation)))
  (#statement (#pt-pi ((denied-proof (#pt-eq #pt-nat number #pt-zero))) #pt-false))
  (#proof
    (#pt-lambda
      ((zero-equation (#pt-eq #pt-nat number #pt-zero)))
      (#pt-app
        (#pt-app
          (#pt-use natural-prime-order-next-nondivisor ())
          prime-number
          number
          valuation
          prime-proof
          order-certificate)
        (#pt-eq-elim
          #pt-nat
          #pt-zero
          (#pt-lambda
            ((transport-index #pt-nat) (transport-path (#pt-eq #pt-nat #pt-zero transport-index)))
            (#pt-app
              (#pt-use divides ())
              (#pt-app (#pt-use power ()) prime-number (#pt-succ valuation))
              transport-index))
          (#pt-app
            (#pt-use divides-zero ())
            (#pt-app (#pt-use power ()) prime-number (#pt-succ valuation)))
          number
          (#pt-app (#pt-use symmetry (0)) #pt-nat number #pt-zero zero-equation))))))
