; Transport actual gcd divisors and Bezout coefficients from (y,r)
; to (x,y) under x=y*q+r. Every existential coefficient is retained;
; this step does not assume gcd existence or factorization.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias exists = ./logic-exists.lim::exists)
(#alias eisenstein-add = ./eisenstein-defs.lim::eisenstein-add)
(#alias eisenstein-negate = ./eisenstein-defs.lim::eisenstein-negate)
(#alias
  eisenstein-divides-congruent-target
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-congruent-target)
(#alias
  eisenstein-divides-product-left
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-product-left)
(#alias eisenstein-divides-add = ./eisenstein-additive-divisibility.lim::eisenstein-divides-add)
(#alias eisenstein-bezout-gcd-spec = ./eisenstein-bezout-gcd-defs.lim::eisenstein-bezout-gcd-spec)
(#alias eisenstein-has-bezout-gcd = ./eisenstein-bezout-gcd-defs.lim::eisenstein-has-bezout-gcd)
(#alias
  eisenstein-bezout-quotient-row
  =
  ./eisenstein-bezout-gcd-algebra.lim::eisenstein-bezout-quotient-row)
(#theorem eisenstein-bezout-gcd-euclidean-step
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter quotient (#pt-use eisenstein ()))
    (#parameter remainder (#pt-use eisenstein ()))
    (#parameter gcd (#pt-use eisenstein ()))
    (#parameter left-coefficient (#pt-use eisenstein ()))
    (#parameter right-coefficient (#pt-use eisenstein ()))
    (#parameter division-equation (#pt-app (#pt-use eisenstein-equal ()) first (#pt-app (#pt-use eisenstein-add ()) (#pt-app (#pt-use eisenstein-multiply ()) second quotient) remainder)))
    (#parameter gcd-certificate (#pt-app (#pt-use eisenstein-bezout-gcd-spec ()) second remainder gcd left-coefficient right-coefficient)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-bezout-gcd-spec ())
      first
      second
      gcd
      right-coefficient
      (#pt-app
        (#pt-use eisenstein-add ())
        left-coefficient
        (#pt-app
          (#pt-use eisenstein-negate ())
          (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient quotient)))))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app (#pt-use eisenstein-divides ()) gcd first)
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app (#pt-use eisenstein-divides ()) gcd second)
        (#pt-app
          (#pt-use eisenstein-equal ())
          gcd
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient first)
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app
                (#pt-use eisenstein-add ())
                left-coefficient
                (#pt-app
                  (#pt-use eisenstein-negate ())
                  (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient quotient)))
              second))))
      (#pt-app
        (#pt-use eisenstein-divides-congruent-target ())
        gcd
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app (#pt-use eisenstein-multiply ()) second quotient)
          remainder)
        first
        (#pt-app
          (#pt-use eisenstein-symmetric ())
          first
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-multiply ()) second quotient)
            remainder)
          division-equation)
        (#pt-app
          (#pt-use eisenstein-divides-add ())
          gcd
          (#pt-app (#pt-use eisenstein-multiply ()) second quotient)
          remainder
          (#pt-app
            (#pt-use eisenstein-divides-product-left ())
            gcd
            second
            quotient
            (#pt-app
              (#pt-use conjunction-left ())
              (#pt-app (#pt-use eisenstein-divides ()) gcd second)
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use eisenstein-divides ()) gcd remainder)
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  gcd
                  (#pt-app
                    (#pt-use eisenstein-add ())
                    (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient second)
                    (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient remainder))))
              gcd-certificate))
          (#pt-app
            (#pt-use conjunction-left ())
            (#pt-app (#pt-use eisenstein-divides ()) gcd remainder)
            (#pt-app
              (#pt-use eisenstein-equal ())
              gcd
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient second)
                (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient remainder)))
            (#pt-app
              (#pt-use conjunction-right ())
              (#pt-app (#pt-use eisenstein-divides ()) gcd second)
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use eisenstein-divides ()) gcd remainder)
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  gcd
                  (#pt-app
                    (#pt-use eisenstein-add ())
                    (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient second)
                    (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient remainder))))
              gcd-certificate))))
      (#pt-app
        (#pt-use conjunction-introduce ())
        (#pt-app (#pt-use eisenstein-divides ()) gcd second)
        (#pt-app
          (#pt-use eisenstein-equal ())
          gcd
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient first)
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app
                (#pt-use eisenstein-add ())
                left-coefficient
                (#pt-app
                  (#pt-use eisenstein-negate ())
                  (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient quotient)))
              second)))
        (#pt-app
          (#pt-use conjunction-left ())
          (#pt-app (#pt-use eisenstein-divides ()) gcd second)
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app (#pt-use eisenstein-divides ()) gcd remainder)
            (#pt-app
              (#pt-use eisenstein-equal ())
              gcd
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient second)
                (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient remainder))))
          gcd-certificate)
        (#pt-app
          (#pt-use eisenstein-transitive ())
          gcd
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient second)
            (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient remainder))
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient first)
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app
                (#pt-use eisenstein-add ())
                left-coefficient
                (#pt-app
                  (#pt-use eisenstein-negate ())
                  (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient quotient)))
              second))
          (#pt-app
            (#pt-use conjunction-right ())
            (#pt-app (#pt-use eisenstein-divides ()) gcd remainder)
            (#pt-app
              (#pt-use eisenstein-equal ())
              gcd
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient second)
                (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient remainder)))
            (#pt-app
              (#pt-use conjunction-right ())
              (#pt-app (#pt-use eisenstein-divides ()) gcd second)
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use eisenstein-divides ()) gcd remainder)
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  gcd
                  (#pt-app
                    (#pt-use eisenstein-add ())
                    (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient second)
                    (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient remainder))))
              gcd-certificate))
          (#pt-app
            (#pt-use eisenstein-symmetric ())
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient first)
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app
                  (#pt-use eisenstein-add ())
                  left-coefficient
                  (#pt-app
                    (#pt-use eisenstein-negate ())
                    (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient quotient)))
                second))
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient second)
              (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient remainder))
            (#pt-app
              (#pt-use eisenstein-bezout-quotient-row ())
              first
              second
              quotient
              remainder
              left-coefficient
              right-coefficient
              division-equation)))))))
(#theorem eisenstein-bezout-gcd-euclidean-backward
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter quotient (#pt-use eisenstein ()))
    (#parameter remainder (#pt-use eisenstein ()))
    (#parameter division-equation (#pt-app (#pt-use eisenstein-equal ()) first (#pt-app (#pt-use eisenstein-add ()) (#pt-app (#pt-use eisenstein-multiply ()) second quotient) remainder)))
    (#parameter remainder-gcd (#pt-app (#pt-use eisenstein-has-bezout-gcd ()) second remainder)))
  (#statement (#pt-app (#pt-use eisenstein-has-bezout-gcd ()) first second))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-gcd (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use exists (0))
            (#pt-use eisenstein ())
            (#pt-lambda
              ((candidate-left-coefficient (#pt-use eisenstein ())))
              (#pt-app
                (#pt-use exists (0))
                (#pt-use eisenstein ())
                (#pt-lambda
                  ((candidate-right-coefficient (#pt-use eisenstein ())))
                  (#pt-app
                    (#pt-use eisenstein-bezout-gcd-spec ())
                    second
                    remainder
                    candidate-gcd
                    candidate-left-coefficient
                    candidate-right-coefficient)))))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-gcd (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use exists (0))
                  (#pt-use eisenstein ())
                  (#pt-lambda
                    ((candidate-left-coefficient (#pt-use eisenstein ())))
                    (#pt-app
                      (#pt-use exists (0))
                      (#pt-use eisenstein ())
                      (#pt-lambda
                        ((candidate-right-coefficient (#pt-use eisenstein ())))
                        (#pt-app
                          (#pt-use eisenstein-bezout-gcd-spec ())
                          second
                          remainder
                          candidate-gcd
                          candidate-left-coefficient
                          candidate-right-coefficient)))))))))
        (#pt-app (#pt-use eisenstein-has-bezout-gcd ()) first second))
      (
        (#pt-lambda
          (
            (gcd (#pt-use eisenstein ()))
            (left-existence
              (#pt-app
                (#pt-use exists (0))
                (#pt-use eisenstein ())
                (#pt-lambda
                  ((candidate-left-coefficient (#pt-use eisenstein ())))
                  (#pt-app
                    (#pt-use exists (0))
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-right-coefficient (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use eisenstein-bezout-gcd-spec ())
                        second
                        remainder
                        gcd
                        candidate-left-coefficient
                        candidate-right-coefficient)))))))
          (#pt-induct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-left-coefficient (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use exists (0))
                  (#pt-use eisenstein ())
                  (#pt-lambda
                    ((candidate-right-coefficient (#pt-use eisenstein ())))
                    (#pt-app
                      (#pt-use eisenstein-bezout-gcd-spec ())
                      second
                      remainder
                      gcd
                      candidate-left-coefficient
                      candidate-right-coefficient)))))
            (#pt-lambda
              (
                (eisenstein-certificate
                  (#pt-app
                    (#pt-use exists (0))
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-left-coefficient (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use exists (0))
                        (#pt-use eisenstein ())
                        (#pt-lambda
                          ((candidate-right-coefficient (#pt-use eisenstein ())))
                          (#pt-app
                            (#pt-use eisenstein-bezout-gcd-spec ())
                            second
                            remainder
                            gcd
                            candidate-left-coefficient
                            candidate-right-coefficient)))))))
              (#pt-app (#pt-use eisenstein-has-bezout-gcd ()) first second))
            (
              (#pt-lambda
                (
                  (left-coefficient (#pt-use eisenstein ()))
                  (right-existence
                    (#pt-app
                      (#pt-use exists (0))
                      (#pt-use eisenstein ())
                      (#pt-lambda
                        ((candidate-right-coefficient (#pt-use eisenstein ())))
                        (#pt-app
                          (#pt-use eisenstein-bezout-gcd-spec ())
                          second
                          remainder
                          gcd
                          left-coefficient
                          candidate-right-coefficient)))))
                (#pt-induct
                  exists
                  (0)
                  (
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-right-coefficient (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use eisenstein-bezout-gcd-spec ())
                        second
                        remainder
                        gcd
                        left-coefficient
                        candidate-right-coefficient)))
                  (#pt-lambda
                    (
                      (eisenstein-certificate
                        (#pt-app
                          (#pt-use exists (0))
                          (#pt-use eisenstein ())
                          (#pt-lambda
                            ((candidate-right-coefficient (#pt-use eisenstein ())))
                            (#pt-app
                              (#pt-use eisenstein-bezout-gcd-spec ())
                              second
                              remainder
                              gcd
                              left-coefficient
                              candidate-right-coefficient)))))
                    (#pt-app (#pt-use eisenstein-has-bezout-gcd ()) first second))
                  (
                    (#pt-lambda
                      (
                        (right-coefficient (#pt-use eisenstein ()))
                        (gcd-certificate
                          (#pt-app
                            (#pt-use eisenstein-bezout-gcd-spec ())
                            second
                            remainder
                            gcd
                            left-coefficient
                            right-coefficient)))
                      (#pt-construct
                        exists
                        (0)
                        (
                          (#pt-use eisenstein ())
                          (#pt-lambda
                            ((candidate-gcd (#pt-use eisenstein ())))
                            (#pt-app
                              (#pt-use exists (0))
                              (#pt-use eisenstein ())
                              (#pt-lambda
                                ((candidate-left-coefficient (#pt-use eisenstein ())))
                                (#pt-app
                                  (#pt-use exists (0))
                                  (#pt-use eisenstein ())
                                  (#pt-lambda
                                    ((candidate-right-coefficient (#pt-use eisenstein ())))
                                    (#pt-app
                                      (#pt-use eisenstein-bezout-gcd-spec ())
                                      first
                                      second
                                      candidate-gcd
                                      candidate-left-coefficient
                                      candidate-right-coefficient)))))))
                        introduce
                        (gcd
                          (#pt-construct
                            exists
                            (0)
                            (
                              (#pt-use eisenstein ())
                              (#pt-lambda
                                ((candidate-left-coefficient (#pt-use eisenstein ())))
                                (#pt-app
                                  (#pt-use exists (0))
                                  (#pt-use eisenstein ())
                                  (#pt-lambda
                                    ((candidate-right-coefficient (#pt-use eisenstein ())))
                                    (#pt-app
                                      (#pt-use eisenstein-bezout-gcd-spec ())
                                      first
                                      second
                                      gcd
                                      candidate-left-coefficient
                                      candidate-right-coefficient)))))
                            introduce
                            (right-coefficient
                              (#pt-construct
                                exists
                                (0)
                                (
                                  (#pt-use eisenstein ())
                                  (#pt-lambda
                                    ((candidate-right-coefficient (#pt-use eisenstein ())))
                                    (#pt-app
                                      (#pt-use eisenstein-bezout-gcd-spec ())
                                      first
                                      second
                                      gcd
                                      right-coefficient
                                      candidate-right-coefficient)))
                                introduce
                                (
                                  (#pt-app
                                    (#pt-use eisenstein-add ())
                                    left-coefficient
                                    (#pt-app
                                      (#pt-use eisenstein-negate ())
                                      (#pt-app
                                        (#pt-use eisenstein-multiply ())
                                        right-coefficient
                                        quotient)))
                                  (#pt-app
                                    (#pt-use eisenstein-bezout-gcd-euclidean-step ())
                                    first
                                    second
                                    quotient
                                    remainder
                                    gcd
                                    left-coefficient
                                    right-coefficient
                                    division-equation
                                    gcd-certificate)))))))))
                  right-existence)))
            left-existence)))
      remainder-gcd)))
