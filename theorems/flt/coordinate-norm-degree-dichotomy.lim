          #pt-nat
          (#pt-lambda
            ((gap #pt-nat))
            (#pt-eq
              #pt-nat
              constant-degree
              (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ linear-degree)) gap)))))
      (#pt-lambda
        (
          (less-comparison
            (#pt-app (#pt-use less-than ()) constant-degree (#pt-succ linear-degree))))
        (#pt-induct
          exists
          (0)
          (#pt-nat
            (#pt-lambda
              ((gap #pt-nat))
              (#pt-eq
                #pt-nat
                (#pt-succ linear-degree)
                (#pt-app (#pt-use add ()) (#pt-succ constant-degree) gap))))
