      (#pt-app
        (#pt-use disjunction ())
        (#pt-app
          (#pt-use exists (0))
          #pt-nat
          (#pt-lambda
            ((gap #pt-nat))
            (#pt-eq #pt-nat (#pt-succ linear-degree) (#pt-app (#pt-use add ()) constant-degree gap))))
        (#pt-app
