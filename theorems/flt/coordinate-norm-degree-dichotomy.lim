                    (#pt-succ linear-degree)
                    (#pt-app (#pt-use add ()) constant-degree gap))))
              (#pt-app
                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((gap #pt-nat))
                  (#pt-eq
                    #pt-nat
                    constant-degree
                    (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ linear-degree)) gap))))
              more-comparison))
          other-comparison))
      (#pt-app (#pt-use natural-trichotomy ()) constant-degree (#pt-succ linear-degree)))))
