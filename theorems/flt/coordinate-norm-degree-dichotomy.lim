                      (#pt-succ linear-degree)
                      (#pt-app (#pt-use add ()) constant-degree gap))))
                introduce
                (#pt-zero
                  (#pt-app
                    (#pt-use transitivity (0))
                    #pt-nat
                    (#pt-succ linear-degree)
                    constant-degree
                    (#pt-app (#pt-use add ()) constant-degree #pt-zero)
                    (#pt-app
                      (#pt-use symmetry (0))
                      #pt-nat
                      constant-degree
                      (#pt-succ linear-degree)
                      equal-comparison)
                    (#pt-app
                      (#pt-use symmetry (0))
                      #pt-nat
                      (#pt-app (#pt-use add ()) constant-degree #pt-zero)
                      constant-degree
                      (#pt-app (#pt-use add-zero-right ()) constant-degree)))))))
          (#pt-lambda
            (
              (more-comparison
                (#pt-app (#pt-use less-than ()) (#pt-succ linear-degree) constant-degree)))
            (#pt-app
              (#pt-use disjunction-right ())
              (#pt-app
                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((gap #pt-nat))
                  (#pt-eq
