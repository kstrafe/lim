                    (#pt-succ linear-degree)
                    (#pt-app (#pt-use add ()) constant-degree gap))))
              (#pt-app
                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((gap #pt-nat))
                  (#pt-eq
                    #pt-nat
                    constant-degree
                    (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ linear-degree)) gap))))))
          (
            (#pt-lambda
              (
                (gap #pt-nat)
                (less-position
                  (#pt-eq
                    #pt-nat
                    (#pt-succ linear-degree)
                    (#pt-app (#pt-use add ()) (#pt-succ constant-degree) gap))))
              (#pt-app
                (#pt-use disjunction-left ())
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((gap-bound-0000 #pt-nat))
                    (#pt-eq
                      #pt-nat
                      (#pt-succ linear-degree)
                      (#pt-app (#pt-use add ()) constant-degree gap-bound-0000))))
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((gap-bound-0001 #pt-nat))
                    (#pt-eq
                      #pt-nat
                      constant-degree
                      (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ linear-degree)) gap-bound-0001))))
                (#pt-construct
