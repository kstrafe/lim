                  (0)
                  (#pt-nat
                    (#pt-lambda
                      ((gap-bound-0002 #pt-nat))
                      (#pt-eq
                        #pt-nat
                        (#pt-succ linear-degree)
                        (#pt-app (#pt-use add ()) constant-degree gap-bound-0002))))
                  introduce
                  (
                    (#pt-succ gap)
                    (#pt-app
                      (#pt-use transitivity (0))
                      #pt-nat
                      (#pt-succ linear-degree)
                      (#pt-app (#pt-use add ()) (#pt-succ constant-degree) gap)
                      (#pt-app (#pt-use add ()) constant-degree (#pt-succ gap))
                      less-position
                      (#pt-app
                        (#pt-use symmetry (0))
                        #pt-nat
                        (#pt-app (#pt-use add ()) constant-degree (#pt-succ gap))
                        (#pt-app (#pt-use add ()) (#pt-succ constant-degree) gap)
                        (#pt-app (#pt-use add-successor-right ()) constant-degree gap))))))))
          less-comparison))
      (#pt-lambda
        (
          (other-comparison
            (#pt-app
              (#pt-use disjunction ())
              (#pt-eq #pt-nat constant-degree (#pt-succ linear-degree))
              (#pt-app (#pt-use less-than ()) (#pt-succ linear-degree) constant-degree))))
        (#pt-app
