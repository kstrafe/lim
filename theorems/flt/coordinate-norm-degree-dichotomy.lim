; Construct actual gap witnesses for both exhaustive
; degree-order branches, using proved Nat trichotomy and its gap
; definition. The dp=dq+1 and dp=dq+2 boundaries remain explicit.
(#alias add = ./../fermat_statement.lim::add)
(#alias add-successor-right = ./natural-addition.lim::add-successor-right)
