                        (#pt-use eisenstein-divides ())
                        (#pt-app
                          (#pt-use eisenstein-power ())
                          (#pt-use eisenstein-lambda ())
                          (#pt-numeral 4))
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          (#pt-app (#pt-use eisenstein-multiply ()) first second)
                          third))))
                  (#pt-app
                    (#pt-app
                      (#pt-use eisenstein-lambda-order-excludes-higher ())
                      (#pt-app
                        (#pt-use eisenstein-multiply ())
                        (#pt-app (#pt-use eisenstein-multiply ()) first second)
                        third)
                      (#pt-numeral 1)
                      (#pt-numeral 4)
                      (#pt-app
                        (#pt-use eisenstein-lambda-order-multiply ())
                        (#pt-app (#pt-use eisenstein-multiply ()) first second)
                        third
                        (#pt-app (#pt-use add ()) (#pt-numeral 0) (#pt-numeral 1))
                        (#pt-numeral 0)
                        (#pt-app
                          (#pt-use eisenstein-lambda-order-multiply ())
                          first
                          second
                          (#pt-numeral 0)
                          (#pt-numeral 1)
                          first-order-zero
                          second-order-one)
                        third-order-zero)
                      (#pt-construct
                        exists
                        (0)
                        (#pt-nat
