(#theorem eisenstein-lambda-square-divides-of-large-order
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter order-exponent #pt-nat)
    (#parameter order-certificate (#pt-app (#pt-use eisenstein-lambda-order ()) number order-exponent))
    (#parameter large-order (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) order-exponent)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-divides ())
      (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2))
      number))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-gap #pt-nat))
          (#pt-eq
            #pt-nat
            order-exponent
            (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ #pt-zero)) candidate-gap))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-gap #pt-nat))
                (#pt-eq
                  #pt-nat
                  order-exponent
                  (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ #pt-zero)) candidate-gap))))))
        (#pt-app
          (#pt-use eisenstein-divides ())
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2))
          number))
      (
        (#pt-lambda
          (
            (gap #pt-nat)
            (position
              (#pt-eq
                #pt-nat
                order-exponent
                (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ #pt-zero)) gap))))
          (#pt-app
            (#pt-use eisenstein-divides-transitive ())
            (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2))
            (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) order-exponent)
            number
            (#pt-app
              (#pt-use substitution (0))
              #pt-nat
              (#pt-lambda
                ((endpoint #pt-nat))
                (#pt-app
                  (#pt-use eisenstein-divides ())
                  (#pt-app
                    (#pt-use eisenstein-power ())
                    (#pt-use eisenstein-lambda ())
                    (#pt-numeral 2))
                  (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) endpoint)))
              (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ #pt-zero)) gap)
              order-exponent
              (#pt-app
                (#pt-use symmetry (0))
                #pt-nat
                order-exponent
                (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ #pt-zero)) gap)
                position)
              (#pt-app
                (#pt-use eisenstein-power-divides-add ())
                (#pt-use eisenstein-lambda ())
                (#pt-numeral 2)
                gap))
            (#pt-project eisenstein-lambda-order 0 order-certificate))))
      large-order)))
(#theorem eisenstein-lambda-small-order-of-not-square
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter square-not-divides (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2)) number))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app (#pt-use eisenstein-lambda-order ()) number #pt-zero)
      (#pt-app (#pt-use eisenstein-lambda-order ()) number (#pt-succ #pt-zero))))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-order #pt-nat))
          (#pt-app (#pt-use eisenstein-lambda-order ()) number candidate-order)))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-order #pt-nat))
                (#pt-app (#pt-use eisenstein-lambda-order ()) number candidate-order)))))
        (#pt-app
          (#pt-use disjunction ())
          (#pt-app (#pt-use eisenstein-lambda-order ()) number #pt-zero)
          (#pt-app (#pt-use eisenstein-lambda-order ()) number (#pt-succ #pt-zero))))
      (
        (#pt-lambda
          (
            (order-value #pt-nat)
            (order-certificate (#pt-app (#pt-use eisenstein-lambda-order ()) number order-value)))
          (#pt-app
            (#pt-use disjunction-eliminate ())
            (#pt-eq #pt-nat order-value #pt-zero)
            (#pt-app
              (#pt-use disjunction ())
              (#pt-eq #pt-nat order-value (#pt-succ #pt-zero))
              (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) order-value))
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app (#pt-use eisenstein-lambda-order ()) number #pt-zero)
              (#pt-app (#pt-use eisenstein-lambda-order ()) number (#pt-succ #pt-zero)))
            (#pt-lambda
              ((zero-order (#pt-eq #pt-nat order-value #pt-zero)))
              (#pt-app
                (#pt-use disjunction-left ())
                (#pt-app (#pt-use eisenstein-lambda-order ()) number #pt-zero)
                (#pt-app (#pt-use eisenstein-lambda-order ()) number (#pt-succ #pt-zero))
                (#pt-app
                  (#pt-use substitution (0))
                  #pt-nat
                  (#pt-lambda
                    ((endpoint #pt-nat))
                    (#pt-app (#pt-use eisenstein-lambda-order ()) number endpoint))
                  order-value
                  #pt-zero
                  zero-order
                  order-certificate)))
            (#pt-lambda
              (
                (one-or-large
                  (#pt-app
                    (#pt-use disjunction ())
                    (#pt-eq #pt-nat order-value (#pt-succ #pt-zero))
                    (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) order-value))))
              (#pt-app
                (#pt-use disjunction-eliminate ())
                (#pt-eq #pt-nat order-value (#pt-succ #pt-zero))
                (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) order-value)
                (#pt-app
                  (#pt-use disjunction ())
                  (#pt-app (#pt-use eisenstein-lambda-order ()) number #pt-zero)
                  (#pt-app (#pt-use eisenstein-lambda-order ()) number (#pt-succ #pt-zero)))
                (#pt-lambda
                  ((one-order (#pt-eq #pt-nat order-value (#pt-succ #pt-zero))))
                  (#pt-app
                    (#pt-use disjunction-right ())
                    (#pt-app (#pt-use eisenstein-lambda-order ()) number #pt-zero)
                    (#pt-app (#pt-use eisenstein-lambda-order ()) number (#pt-succ #pt-zero))
                    (#pt-app
                      (#pt-use substitution (0))
                      #pt-nat
                      (#pt-lambda
                        ((endpoint #pt-nat))
                        (#pt-app (#pt-use eisenstein-lambda-order ()) number endpoint))
                      order-value
                      (#pt-succ #pt-zero)
                      one-order
                      order-certificate)))
                (#pt-lambda
                  ((large-order (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) order-value)))
                  (#pt-app
                    (#pt-use false-elimination ())
                    (#pt-app
                      (#pt-use disjunction ())
                      (#pt-app (#pt-use eisenstein-lambda-order ()) number #pt-zero)
                      (#pt-app (#pt-use eisenstein-lambda-order ()) number (#pt-succ #pt-zero)))
                    (#pt-app
                      square-not-divides
                      (#pt-app
                        (#pt-use eisenstein-lambda-square-divides-of-large-order ())
                        number
                        order-value
                        order-certificate
                        large-order))))
                one-or-large))
            (#pt-app (#pt-use zero-one-or-large ()) order-value))))
      (#pt-app
        (#pt-use eisenstein-lambda-order-exists ())
        number
        (#pt-lambda
          (
            (zero-equivalence
              (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ()))))
          (#pt-app
            square-not-divides
            (#pt-app
              (#pt-use eisenstein-divides-congruent-target ())
              (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2))
              (#pt-use eisenstein-zero ())
              number
              (#pt-app
                (#pt-use eisenstein-symmetric ())
                number
                (#pt-use eisenstein-zero ())
                zero-equivalence)
              (#pt-app
                (#pt-use eisenstein-divides-zero ())
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-numeral 2))))))))))
(#theorem eisenstein-lambda-four-not-divides-three-small-factors
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter third (#pt-use eisenstein ()))
    (#parameter first-not-square (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2)) first))) #pt-false))
    (#parameter second-not-square (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2)) second))) #pt-false))
    (#parameter third-not-square (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2)) third))) #pt-false)))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use eisenstein-divides ())
            (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 4))
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-multiply ()) first second)
              third))))
      #pt-false))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use eisenstein-lambda-order ()) first #pt-zero)
      (#pt-app (#pt-use eisenstein-lambda-order ()) first (#pt-succ #pt-zero))
      (#pt-pi
        (
          (denied-proof
            (#pt-app
              (#pt-use eisenstein-divides ())
              (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 4))
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app (#pt-use eisenstein-multiply ()) first second)
                third))))
        #pt-false)
      (#pt-lambda
        ((first-order-zero (#pt-app (#pt-use eisenstein-lambda-order ()) first #pt-zero)))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-app (#pt-use eisenstein-lambda-order ()) second #pt-zero)
          (#pt-app (#pt-use eisenstein-lambda-order ()) second (#pt-succ #pt-zero))
          (#pt-pi
            (
              (denied-proof
                (#pt-app
                  (#pt-use eisenstein-divides ())
                  (#pt-app
                    (#pt-use eisenstein-power ())
                    (#pt-use eisenstein-lambda ())
                    (#pt-numeral 4))
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app (#pt-use eisenstein-multiply ()) first second)
                    third))))
            #pt-false)
          (#pt-lambda
            ((second-order-zero (#pt-app (#pt-use eisenstein-lambda-order ()) second #pt-zero)))
            (#pt-app
              (#pt-use disjunction-eliminate ())
              (#pt-app (#pt-use eisenstein-lambda-order ()) third #pt-zero)
              (#pt-app (#pt-use eisenstein-lambda-order ()) third (#pt-succ #pt-zero))
              (#pt-pi
                (
                  (denied-proof
                    (#pt-app
                      (#pt-use eisenstein-divides ())
                      (#pt-app
                        (#pt-use eisenstein-power ())
                        (#pt-use eisenstein-lambda ())
                        (#pt-numeral 4))
                      (#pt-app
                        (#pt-use eisenstein-multiply ())
                        (#pt-app (#pt-use eisenstein-multiply ()) first second)
                        third))))
                #pt-false)
              (#pt-lambda
                ((third-order-zero (#pt-app (#pt-use eisenstein-lambda-order ()) third #pt-zero)))
                (#pt-lambda
                  (
                    (fourth-power-divides
                      (#pt-app
                        (#pt-use eisenstein-divides ())
                        (#pt-app
                          (#pt-use eisenstein-power ())
                          (#pt-use eisenstein-lambda ())
                          (#pt-numeral 4))
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          (#pt-app (#pt-use eisenstein-multiply ()) first second)
                          third))))
                  (#pt-app
                    (#pt-app
                      (#pt-use eisenstein-lambda-order-excludes-higher ())
                      (#pt-app
                        (#pt-use eisenstein-multiply ())
                        (#pt-app (#pt-use eisenstein-multiply ()) first second)
                        third)
                      (#pt-numeral 0)
                      (#pt-numeral 4)
                      (#pt-app
                        (#pt-use eisenstein-lambda-order-multiply ())
                        (#pt-app (#pt-use eisenstein-multiply ()) first second)
                        third
                        (#pt-app (#pt-use add ()) (#pt-numeral 0) (#pt-numeral 0))
                        (#pt-numeral 0)
                        (#pt-app
                          (#pt-use eisenstein-lambda-order-multiply ())
                          first
                          second
                          (#pt-numeral 0)
                          (#pt-numeral 0)
                          first-order-zero
                          second-order-zero)
                        third-order-zero)
                      (#pt-construct
                        exists
                        (0)
                        (#pt-nat
                          (#pt-lambda
                            ((candidate-gap #pt-nat))
                            (#pt-eq
                              #pt-nat
                              (#pt-numeral 4)
                              (#pt-app (#pt-use add ()) (#pt-succ (#pt-numeral 0)) candidate-gap))))
                        introduce
                        ((#pt-numeral 3) (#pt-refl #pt-nat (#pt-numeral 4)))))
                    fourth-power-divides)))
              (#pt-lambda
                (
                  (third-order-one
                    (#pt-app (#pt-use eisenstein-lambda-order ()) third (#pt-succ #pt-zero))))
                (#pt-lambda
                  (
                    (fourth-power-divides
                      (#pt-app
                        (#pt-use eisenstein-divides ())
                        (#pt-app
                          (#pt-use eisenstein-power ())
                          (#pt-use eisenstein-lambda ())
                          (#pt-numeral 4))
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          (#pt-app (#pt-use eisenstein-multiply ()) first second)
