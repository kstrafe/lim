                    fourth-power-divides)))
              (#pt-lambda
                (
                  (third-order-one
                    (#pt-app (#pt-use eisenstein-lambda-order ()) third (#pt-succ #pt-zero))))
                (#pt-lambda
                  (
                    (fourth-power-divides
                      (#pt-app
                        (#pt-use eisenstein-divides ())
                        (#pt-app
                          (#pt-use eisenstein-power ())
                          (#pt-use eisenstein-lambda ())
                          (#pt-numeral 4))
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          (#pt-app (#pt-use eisenstein-multiply ()) first second)
                          third))))
                  (#pt-app
                    (#pt-app
                      (#pt-use eisenstein-lambda-order-excludes-higher ())
                      (#pt-app
                        (#pt-use eisenstein-multiply ())
                        (#pt-app (#pt-use eisenstein-multiply ()) first second)
                        third)
                      (#pt-numeral 2)
                      (#pt-numeral 4)
                      (#pt-app
                        (#pt-use eisenstein-lambda-order-multiply ())
                        (#pt-app (#pt-use eisenstein-multiply ()) first second)
                        third
                        (#pt-app (#pt-use add ()) (#pt-numeral 0) (#pt-numeral 1))
                        (#pt-numeral 1)
                        (#pt-app
                          (#pt-use eisenstein-lambda-order-multiply ())
                          first
                          second
                          (#pt-numeral 0)
                          (#pt-numeral 1)
                          first-order-zero
                          second-order-one)
                        third-order-one)
                      (#pt-construct
                        exists
                        (0)
                        (#pt-nat
                          (#pt-lambda
                            ((candidate-gap #pt-nat))
                            (#pt-eq
                              #pt-nat
                              (#pt-numeral 4)
                              (#pt-app (#pt-use add ()) (#pt-succ (#pt-numeral 2)) candidate-gap))))
                        introduce
                        ((#pt-numeral 1) (#pt-refl #pt-nat (#pt-numeral 4)))))
                    fourth-power-divides)))
              (#pt-app
                (#pt-use eisenstein-lambda-small-order-of-not-square ())
                third
                third-not-square)))
          (#pt-app
            (#pt-use eisenstein-lambda-small-order-of-not-square ())
            second
            second-not-square)))
      (#pt-lambda
        ((first-order-one (#pt-app (#pt-use eisenstein-lambda-order ()) first (#pt-succ #pt-zero))))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-app (#pt-use eisenstein-lambda-order ()) second #pt-zero)
          (#pt-app (#pt-use eisenstein-lambda-order ()) second (#pt-succ #pt-zero))
          (#pt-pi
