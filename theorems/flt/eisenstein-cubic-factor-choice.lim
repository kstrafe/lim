                          first
                          second
                          (#pt-numeral 0)
                          (#pt-numeral 0)
                          first-order-zero
                          second-order-zero)
                        third-order-one)
                      (#pt-construct
                        exists
                        (0)
                        (#pt-nat
                          (#pt-lambda
                            ((candidate-gap #pt-nat))
                            (#pt-eq
                              #pt-nat
                              (#pt-numeral 4)
                              (#pt-app (#pt-use add ()) (#pt-succ (#pt-numeral 1)) candidate-gap))))
                        introduce
                        ((#pt-numeral 2) (#pt-refl #pt-nat (#pt-numeral 4)))))
                    fourth-power-divides)))
              (#pt-app
                (#pt-use eisenstein-lambda-small-order-of-not-square ())
                third
                third-not-square)))
          (#pt-lambda
            (
              (second-order-one
                (#pt-app (#pt-use eisenstein-lambda-order ()) second (#pt-succ #pt-zero))))
            (#pt-app
              (#pt-use disjunction-eliminate ())
              (#pt-app (#pt-use eisenstein-lambda-order ()) third #pt-zero)
              (#pt-app (#pt-use eisenstein-lambda-order ()) third (#pt-succ #pt-zero))
              (#pt-pi
