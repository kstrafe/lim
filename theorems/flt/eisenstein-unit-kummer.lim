(#theorem eisenstein-three-divides-lambda-square
  (#universes)
  (#parameters)
  (#statement
    (#pt-app
      (#pt-use eisenstein-divides ())
      (#pt-app
        (#pt-use eisenstein-of-integer ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)))
      (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2))))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2))
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app
                (#pt-use eisenstein-of-integer ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)))
              candidate-factor))))
      introduce
      (
        (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ()))
        (#pt-app
          (#pt-use conjunction-introduce ())
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-project
              eisenstein
              0
              (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2)))
            (#pt-project
              eisenstein
              0
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app
                  (#pt-use eisenstein-of-integer ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)))
                (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ())))))
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-project
              eisenstein
              1
              (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2)))
            (#pt-project
              eisenstein
              1
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app
                  (#pt-use eisenstein-of-integer ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)))
                (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-omega ())))))
          (#pt-refl #pt-nat (#pt-succ #pt-zero))
          (#pt-refl #pt-nat (#pt-numeral 3)))))))
(#theorem integer-three-divides-eisenstein-omega
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter three-divides (#pt-app (#pt-use eisenstein-divides ()) (#pt-app (#pt-use eisenstein-of-integer ()) (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))) number)))
  (#statement
    (#pt-app
      (#pt-use integer-divides ())
      (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
      (#pt-project eisenstein 1 number)))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            number
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app
                (#pt-use eisenstein-of-integer ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)))
              candidate-factor))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  number
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app
                      (#pt-use eisenstein-of-integer ())
                      (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)))
                    candidate-factor))))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
          (#pt-project eisenstein 1 number)))
      (
        (#pt-lambda
          (
            (factor (#pt-use eisenstein ()))
            (factor-equivalence
              (#pt-app
                (#pt-use eisenstein-equal ())
                number
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app
                    (#pt-use eisenstein-of-integer ())
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)))
                  factor))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-project eisenstein 1 number)
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                    candidate-factor))))
            introduce
            (
              (#pt-project eisenstein 1 factor)
              (#pt-app
                (#pt-use integer-transitive ())
                (#pt-project eisenstein 1 number)
                (#pt-project
                  eisenstein
                  1
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app
                      (#pt-use eisenstein-of-integer ())
                      (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)))
                    factor))
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  (#pt-project eisenstein 1 factor))
                (#pt-app
                  (#pt-use conjunction-right ())
                  (#pt-app
                    (#pt-use integer-equal ())
                    (#pt-project eisenstein 0 number)
                    (#pt-project
                      eisenstein
                      0
                      (#pt-app
                        (#pt-use eisenstein-multiply ())
                        (#pt-app
                          (#pt-use eisenstein-of-integer ())
                          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)))
                        factor)))
                  (#pt-app
                    (#pt-use integer-equal ())
                    (#pt-project eisenstein 1 number)
                    (#pt-project
                      eisenstein
                      1
                      (#pt-app
                        (#pt-use eisenstein-multiply ())
                        (#pt-app
                          (#pt-use eisenstein-of-integer ())
                          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)))
                        factor)))
                  factor-equivalence)
                (#pt-app
                  (#pt-use eisenstein-scalar-multiply-omega ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                  factor))))))
      three-divides)))
(#theorem integer-three-divides-omega-from-square-congruence
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter integer-value (#pt-use integer ()))
    (#parameter integer-congruence (#pt-app (#pt-use eisenstein-divides ()) (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2)) (#pt-app (#pt-use eisenstein-add ()) number (#pt-app (#pt-use eisenstein-negate ()) (#pt-app (#pt-use eisenstein-of-integer ()) integer-value))))))
  (#statement
    (#pt-app
      (#pt-use integer-divides ())
      (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
      (#pt-project eisenstein 1 number)))
  (#proof
    (#pt-app
      (#pt-use integer-divides-congruent-target ())
      (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
      (#pt-project
        eisenstein
        1
        (#pt-app
          (#pt-use eisenstein-add ())
          number
          (#pt-app
            (#pt-use eisenstein-negate ())
            (#pt-app (#pt-use eisenstein-of-integer ()) integer-value))))
      (#pt-project eisenstein 1 number)
      (#pt-app (#pt-use integer-add-zero ()) (#pt-project eisenstein 1 number))
      (#pt-app
        (#pt-use integer-three-divides-eisenstein-omega ())
        (#pt-app
          (#pt-use eisenstein-add ())
          number
          (#pt-app
            (#pt-use eisenstein-negate ())
            (#pt-app (#pt-use eisenstein-of-integer ()) integer-value)))
        (#pt-app
          (#pt-use eisenstein-divides-transitive ())
          (#pt-app
            (#pt-use eisenstein-of-integer ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)))
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2))
          (#pt-app
            (#pt-use eisenstein-add ())
            number
            (#pt-app
              (#pt-use eisenstein-negate ())
              (#pt-app (#pt-use eisenstein-of-integer ()) integer-value)))
          (#pt-use eisenstein-three-divides-lambda-square ())
          integer-congruence)))))
