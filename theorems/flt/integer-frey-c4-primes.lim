; Source repository: Copyright 2026 Anthropic, PBC; see NOTICE.FLT.
; Reflect actual integral c4 and discriminant identities. A prime
; divisor of the integral discriminant divides a*b*c, and no such
; prime divides integral c4. This is arithmetic prime-disjointness;
; geometric reduction/semistability is not asserted here.
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias power = ./../fermat_statement.lim::power)
(#alias less-than = ./natural-order.lim::less-than)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-power = ./integer-defs.lim::integer-power)
(#alias integer-divides = ./integer-defs.lim::integer-divides)
(#alias
  integer-divides-congruent-target
  =
  ./integer-divisibility.lim::integer-divides-congruent-target)
(#alias integer-weierstrass-curve = ./integer-weierstrass-defs.lim::integer-weierstrass-curve)
(#alias integer-weierstrass-c4 = ./integer-weierstrass-defs.lim::integer-weierstrass-c4)
(#alias
  integer-weierstrass-discriminant
  =
  ./integer-weierstrass-defs.lim::integer-weierstrass-discriminant)
(#alias integer-frey-model-certificate = ./integer-frey-model.lim::integer-frey-model-certificate)
(#alias
  integer-divides-product-left
  =
  ./integer-power-divisibility.lim::integer-divides-product-left)
(#alias integer-prime-divides-power = ./integer-prime-divisibility.lim::integer-prime-divides-power)
(#alias integer-gcd-spec = ./integer-gcd.lim::integer-gcd-spec)
(#alias prime = ./natural-prime.lim::prime)
(#alias frey-integer-c4-value = ./frey-c4-alternate.lim::frey-integer-c4-value)
(#alias
  frey-c4-prime-nondivisibility
  =
  ./frey-c4-prime-divisibility.lim::frey-c4-prime-nondivisibility)
(#alias integer-frey-c4 = ./integer-frey-invariants.lim::integer-frey-c4)
(#alias
  integer-frey-discriminant-multiplied
  =
  ./integer-frey-invariants.lim::integer-frey-discriminant-multiplied)
(#theorem integer-frey-c4-prime-nondivisibility
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter positive-exponent (#pt-app (#pt-use less-than ()) #pt-zero exponent))
    (#parameter gcd-one (#pt-app (#pt-use integer-gcd-spec ()) first second (#pt-succ #pt-zero)))
    (#parameter power-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-power ()) first exponent) (#pt-app (#pt-use integer-power ()) second exponent)) (#pt-app (#pt-use integer-power ()) third exponent)))
    (#parameter integral-model (#pt-use integer-weierstrass-curve ()))
    (#parameter model-certificate (#pt-app (#pt-use integer-frey-model-certificate ()) first second exponent integral-model))
    (#parameter product-divides (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) (#pt-app (#pt-use integer-multiply ()) (#pt-app (#pt-use integer-multiply ()) first second) third))))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use integer-divides ())
            (#pt-app (#pt-use integer-of-natural ()) prime-number)
            (#pt-app (#pt-use integer-weierstrass-c4 ()) integral-model))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (integral-c4-divides
          (#pt-app
            (#pt-use integer-divides ())
            (#pt-app (#pt-use integer-of-natural ()) prime-number)
            (#pt-app (#pt-use integer-weierstrass-c4 ()) integral-model))))
      (#pt-app
        (#pt-app
          (#pt-use frey-c4-prime-nondivisibility ())
          prime-number
          first
          second
          third
          exponent
          prime-proof
          positive-exponent
          gcd-one
          power-equation
          product-divides)
        (#pt-app
          (#pt-use integer-divides-congruent-target ())
          (#pt-app (#pt-use integer-of-natural ()) prime-number)
          (#pt-app (#pt-use integer-weierstrass-c4 ()) integral-model)
          (#pt-app (#pt-use frey-integer-c4-value ()) first second exponent)
          (#pt-app
            (#pt-use integer-frey-c4 ())
            first
            second
            exponent
            integral-model
            model-certificate)
          integral-c4-divides)))))
(#theorem integer-frey-discriminant-prime-divisor
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter integral-model (#pt-use integer-weierstrass-curve ()))
    (#parameter model-certificate (#pt-app (#pt-use integer-frey-model-certificate ()) first second exponent integral-model))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter power-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-power ()) first exponent) (#pt-app (#pt-use integer-power ()) second exponent)) (#pt-app (#pt-use integer-power ()) third exponent)))
    (#parameter discriminant-divides (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model))))
  (#statement
    (#pt-app
      (#pt-use integer-divides ())
      (#pt-app (#pt-use integer-of-natural ()) prime-number)
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app (#pt-use integer-multiply ()) first second)
        third)))
  (#proof
    (#pt-app
      (#pt-use integer-prime-divides-power ())
      prime-number
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app (#pt-use integer-multiply ()) first second)
        third)
      (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent)
      prime-proof
      (#pt-app
        (#pt-use integer-divides-congruent-target ())
        (#pt-app (#pt-use integer-of-natural ()) prime-number)
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)
          (#pt-app
            (#pt-use integer-of-natural ())
            (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-numeral 8))))
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            third)
          (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) exponent))
        (#pt-app
          (#pt-use integer-frey-discriminant-multiplied ())
          first
          second
          third
          exponent
          integral-model
          model-certificate
          power-equation)
        (#pt-app
          (#pt-use integer-divides-product-left ())
          (#pt-app (#pt-use integer-of-natural ()) prime-number)
          (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model)
          (#pt-app
            (#pt-use integer-of-natural ())
            (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-numeral 8)))
          discriminant-divides)))))
(#theorem integer-frey-discriminant-c4-prime-disjoint
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter positive-exponent (#pt-app (#pt-use less-than ()) #pt-zero exponent))
    (#parameter gcd-one (#pt-app (#pt-use integer-gcd-spec ()) first second (#pt-succ #pt-zero)))
    (#parameter power-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-power ()) first exponent) (#pt-app (#pt-use integer-power ()) second exponent)) (#pt-app (#pt-use integer-power ()) third exponent)))
    (#parameter integral-model (#pt-use integer-weierstrass-curve ()))
    (#parameter model-certificate (#pt-app (#pt-use integer-frey-model-certificate ()) first second exponent integral-model))
    (#parameter discriminant-divides (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) (#pt-app (#pt-use integer-weierstrass-discriminant ()) integral-model))))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use integer-divides ())
            (#pt-app (#pt-use integer-of-natural ()) prime-number)
            (#pt-app (#pt-use integer-weierstrass-c4 ()) integral-model))))
      #pt-false))
  (#proof
    (#pt-app
      (#pt-use integer-frey-c4-prime-nondivisibility ())
      prime-number
      first
      second
      third
      exponent
      prime-proof
      positive-exponent
      gcd-one
      power-equation
      integral-model
      model-certificate
      (#pt-app
        (#pt-use integer-frey-discriminant-prime-divisor ())
        prime-number
        first
        second
        third
        exponent
        integral-model
        model-certificate
        prime-proof
        power-equation
        discriminant-divides))))
