(#math-definition finite-weierstrass-nonsingular ()
  (#pt-pi
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
      (x-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
      (y-coordinate (#pt-app (#pt-use finite-residue ()) modulus)))
    #pt-prop)
  (#pt-lambda
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
      (x-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
      (y-coordinate (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app
        (#pt-use finite-weierstrass-equation ())
        modulus
        positive-modulus
        curve
        x-coordinate
        y-coordinate)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-pi
          (
            (denied-evidence
              (#pt-eq
                #pt-nat
                (#pt-project
                  finite-residue
                  0
                  (#pt-app
                    (#pt-use finite-weierstrass-derivative-x ())
                    modulus
                    positive-modulus
                    curve
                    x-coordinate
                    y-coordinate))
                (#pt-project
                  finite-residue
                  0
                  (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)))))
          #pt-false)
        (#pt-pi
          (
            (denied-evidence
              (#pt-eq
                #pt-nat
                (#pt-project
                  finite-residue
                  0
                  (#pt-app
                    (#pt-use finite-weierstrass-derivative-y ())
                    modulus
                    positive-modulus
                    curve
                    x-coordinate
                    y-coordinate))
                (#pt-project
                  finite-residue
                  0
                  (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)))))
          #pt-false)))))
(#math-inductive finite-affine-point ()
  (
    (size #pt-nat)
    (positive-size (#pt-app (#pt-use less-than ()) #pt-zero size))
    (model (#pt-app (#pt-use finite-weierstrass-curve ()) size)))
  (#pt-type 0)
  (
    (infinity ())
    (coordinate
      (
        (x-value (#pt-app (#pt-use finite-residue ()) size))
        (y-value (#pt-app (#pt-use finite-residue ()) size))
        (nonsingular
          (#pt-app
            (#pt-use finite-weierstrass-nonsingular ())
            size
            positive-size
            model
            x-value
            y-value))))))
(#theorem finite-weierstrass-equation-of-nonsingular
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
    (#parameter x-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter y-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter nonsingular-proof (#pt-app (#pt-use finite-weierstrass-nonsingular ()) modulus positive-modulus curve x-coordinate y-coordinate)))
  (#statement
    (#pt-app
      (#pt-use finite-weierstrass-equation ())
      modulus
      positive-modulus
      curve
      x-coordinate
      y-coordinate))
  (#proof (#pt-project conjunction 0 nonsingular-proof)))
(#theorem finite-weierstrass-derivative-of-nonsingular
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
    (#parameter x-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter y-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter nonsingular-proof (#pt-app (#pt-use finite-weierstrass-nonsingular ()) modulus positive-modulus curve x-coordinate y-coordinate)))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-pi
        (
          (denied-evidence
            (#pt-eq
              #pt-nat
              (#pt-project
                finite-residue
                0
                (#pt-app
                  (#pt-use finite-weierstrass-derivative-x ())
                  modulus
                  positive-modulus
                  curve
                  x-coordinate
                  y-coordinate))
              (#pt-project
                finite-residue
                0
                (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)))))
        #pt-false)
      (#pt-pi
        (
          (denied-evidence
            (#pt-eq
              #pt-nat
              (#pt-project
                finite-residue
                0
                (#pt-app
                  (#pt-use finite-weierstrass-derivative-y ())
                  modulus
                  positive-modulus
                  curve
                  x-coordinate
                  y-coordinate))
              (#pt-project
                finite-residue
                0
                (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)))))
        #pt-false)))
  (#proof (#pt-project conjunction 1 nonsingular-proof)))
