(#math-definition finite-weierstrass-equation ()
  (#pt-pi
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
      (x-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
      (y-coordinate (#pt-app (#pt-use finite-residue ()) modulus)))
    #pt-prop)
  (#pt-lambda
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
      (x-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
      (y-coordinate (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-weierstrass-polynomial ())
          modulus
          positive-modulus
          curve
          x-coordinate
          y-coordinate))
