(#math-definition finite-weierstrass-polynomial ()
  (#pt-pi
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
      (x-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
      (y-coordinate (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-app (#pt-use finite-residue ()) modulus))
  (#pt-lambda
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
      (x-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
      (y-coordinate (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-app
      (#pt-use finite-residue-difference ())
      modulus
      positive-modulus
      (#pt-app
        (#pt-use finite-residue-add ())
        modulus
        positive-modulus
        (#pt-app
          (#pt-use finite-residue-add ())
          modulus
          positive-modulus
          (#pt-app
            (#pt-use finite-residue-power ())
            modulus
            positive-modulus
            y-coordinate
            (#pt-numeral 2))
          (#pt-app
            (#pt-use finite-residue-multiply ())
            modulus
            positive-modulus
            (#pt-app
              (#pt-use finite-residue-multiply ())
              modulus
              positive-modulus
              (#pt-project finite-weierstrass-curve 0 curve)
              x-coordinate)
            y-coordinate))
        (#pt-app
          (#pt-use finite-residue-multiply ())
          modulus
          positive-modulus
          (#pt-project finite-weierstrass-curve 2 curve)
          y-coordinate))
      (#pt-app
        (#pt-use finite-residue-add ())
        modulus
        positive-modulus
        (#pt-app
          (#pt-use finite-residue-add ())
          modulus
          positive-modulus
          (#pt-app
            (#pt-use finite-residue-add ())
            modulus
            positive-modulus
            (#pt-app
              (#pt-use finite-residue-power ())
              modulus
              positive-modulus
              x-coordinate
              (#pt-numeral 3))
            (#pt-app
              (#pt-use finite-residue-multiply ())
              modulus
              positive-modulus
              (#pt-project finite-weierstrass-curve 1 curve)
              (#pt-app
                (#pt-use finite-residue-power ())
                modulus
                positive-modulus
                x-coordinate
                (#pt-numeral 2))))
          (#pt-app
            (#pt-use finite-residue-multiply ())
            modulus
            positive-modulus
            (#pt-project finite-weierstrass-curve 3 curve)
            x-coordinate))
        (#pt-project finite-weierstrass-curve 4 curve)))))
