  =
  ./finite-weierstrass-negation-nonsingular.lim::finite-weierstrass-nonsingular-negate)
(#math-definition finite-affine-point-negate ()
  (#pt-pi
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
      (point (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)))
    (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve))
  (#pt-lambda
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
      (point (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)))
    (#pt-induct
      finite-affine-point
      ()
      (modulus positive-modulus curve)
      (#pt-lambda
        ((point-subject (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)))
        (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve))
      (
        (#pt-construct finite-affine-point () (modulus positive-modulus curve) infinity ())
        (#pt-lambda
          (
            (x-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
            (y-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
            (affine-evidence
              (#pt-app
                (#pt-use finite-weierstrass-nonsingular ())
                modulus
                positive-modulus
                curve
                x-coordinate
                y-coordinate)))
          (#pt-construct
            finite-affine-point
            ()
            (modulus positive-modulus curve)
            coordinate
            (x-coordinate
              (#pt-app
                (#pt-use finite-weierstrass-neg-y ())
                modulus
                positive-modulus
                curve
                x-coordinate
                y-coordinate)
              (#pt-app
                (#pt-use finite-weierstrass-nonsingular-negate ())
                modulus
                positive-modulus
                curve
                x-coordinate
                y-coordinate
                affine-evidence)))))
      point)))
(#theorem finite-affine-point-negate-infinity
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus)))
  (#statement
    (#pt-eq
      (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
      (#pt-app
        (#pt-use finite-affine-point-negate ())
        modulus
        positive-modulus
        curve
        (#pt-construct finite-affine-point () (modulus positive-modulus curve) infinity ()))
      (#pt-construct finite-affine-point () (modulus positive-modulus curve) infinity ())))
  (#proof
    (#pt-refl
      (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
      (#pt-construct finite-affine-point () (modulus positive-modulus curve) infinity ()))))
(#theorem finite-affine-point-negate-coordinate
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
    (#parameter x-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter y-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter affine-evidence (#pt-app (#pt-use finite-weierstrass-nonsingular ()) modulus positive-modulus curve x-coordinate y-coordinate)))
  (#statement
    (#pt-eq
      (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
      (#pt-app
        (#pt-use finite-affine-point-negate ())
        modulus
        positive-modulus
        curve
        (#pt-construct
          finite-affine-point
          ()
          (modulus positive-modulus curve)
          coordinate
          (x-coordinate y-coordinate affine-evidence)))
      (#pt-construct
        finite-affine-point
        ()
        (modulus positive-modulus curve)
        coordinate
        (x-coordinate
          (#pt-app
            (#pt-use finite-weierstrass-neg-y ())
            modulus
            positive-modulus
            curve
            x-coordinate
            y-coordinate)
          (#pt-app
            (#pt-use finite-weierstrass-nonsingular-negate ())
            modulus
            positive-modulus
            curve
            x-coordinate
            y-coordinate
            affine-evidence)))))
  (#proof
    (#pt-refl
      (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
      (#pt-construct
        finite-affine-point
