            (#pt-use finite-weierstrass-neg-y ())
            modulus
            positive-modulus
            curve
            x-coordinate
            y-coordinate)
          (#pt-app
            (#pt-use finite-weierstrass-nonsingular-negate ())
            modulus
            positive-modulus
            curve
            x-coordinate
            y-coordinate
            affine-evidence))))))
(#theorem finite-affine-coordinate-y-congruent
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
    (#parameter x-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter first-y (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second-y (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter first-nonsingular (#pt-app (#pt-use finite-weierstrass-nonsingular ()) modulus positive-modulus curve x-coordinate first-y))
    (#parameter second-nonsingular (#pt-app (#pt-use finite-weierstrass-nonsingular ()) modulus positive-modulus curve x-coordinate second-y))
    (#parameter y-equation (#pt-eq #pt-nat (#pt-project finite-residue 0 first-y) (#pt-project finite-residue 0 second-y))))
  (#statement
    (#pt-eq
      (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
      (#pt-construct
        finite-affine-point
        ()
        (modulus positive-modulus curve)
        coordinate
        (x-coordinate first-y first-nonsingular))
      (#pt-construct
        finite-affine-point
        ()
        (modulus positive-modulus curve)
        coordinate
        (x-coordinate second-y second-nonsingular))))
  (#proof
    (#pt-app
      (#pt-eq-elim
        (#pt-app (#pt-use finite-residue ()) modulus)
        first-y
        (#pt-lambda
          (
            (endpoint-y (#pt-app (#pt-use finite-residue ()) modulus))
            (path (#pt-eq (#pt-app (#pt-use finite-residue ()) modulus) first-y endpoint-y)))
          (#pt-pi
            (
              (endpoint-nonsingular
                (#pt-app
                  (#pt-use finite-weierstrass-nonsingular ())
                  modulus
                  positive-modulus
                  curve
                  x-coordinate
                  endpoint-y)))
            (#pt-eq
              (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
              (#pt-construct
                finite-affine-point
                ()
                (modulus positive-modulus curve)
                coordinate
                (x-coordinate first-y first-nonsingular))
              (#pt-construct
                finite-affine-point
                ()
                (modulus positive-modulus curve)
                coordinate
                (x-coordinate endpoint-y endpoint-nonsingular)))))
        (#pt-lambda
          (
            (endpoint-nonsingular
              (#pt-app
                (#pt-use finite-weierstrass-nonsingular ())
                modulus
                positive-modulus
                curve
                x-coordinate
                first-y)))
          (#pt-refl
            (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
            (#pt-construct
              finite-affine-point
              ()
              (modulus positive-modulus curve)
              coordinate
              (x-coordinate first-y first-nonsingular))))
        second-y
        (#pt-app
          (#pt-use finite-residue-extensional ())
          modulus
          positive-modulus
          first-y
          second-y
          y-equation))
      second-nonsingular)))
(#theorem finite-affine-point-negate-involutive
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
    (#parameter point (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)))
  (#statement
    (#pt-eq
      (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
      (#pt-app
        (#pt-use finite-affine-point-negate ())
        modulus
        positive-modulus
        curve
        (#pt-app (#pt-use finite-affine-point-negate ()) modulus positive-modulus curve point))
      point))
  (#proof
    (#pt-induct
      finite-affine-point
      ()
      (modulus positive-modulus curve)
      (#pt-lambda
        ((point-subject (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)))
        (#pt-eq
          (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
          (#pt-app
            (#pt-use finite-affine-point-negate ())
            modulus
            positive-modulus
            curve
            (#pt-app
              (#pt-use finite-affine-point-negate ())
              modulus
              positive-modulus
              curve
              point-subject))
          point-subject))
      (
        (#pt-refl
          (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
          (#pt-construct finite-affine-point () (modulus positive-modulus curve) infinity ()))
        (#pt-lambda
          (
            (x-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
            (y-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
            (affine-evidence
              (#pt-app
                (#pt-use finite-weierstrass-nonsingular ())
                modulus
                positive-modulus
                curve
                x-coordinate
                y-coordinate)))
          (#pt-app
            (#pt-use finite-affine-coordinate-y-congruent ())
            modulus
            positive-modulus
            curve
            x-coordinate
            (#pt-app
              (#pt-use finite-weierstrass-neg-y ())
              modulus
              positive-modulus
              curve
              x-coordinate
              (#pt-app
                (#pt-use finite-weierstrass-neg-y ())
                modulus
                positive-modulus
                curve
                x-coordinate
                y-coordinate))
            y-coordinate
            (#pt-app
              (#pt-use finite-weierstrass-nonsingular-negate ())
              modulus
              positive-modulus
              curve
              x-coordinate
              (#pt-app
                (#pt-use finite-weierstrass-neg-y ())
                modulus
                positive-modulus
                curve
                x-coordinate
                y-coordinate)
              (#pt-app
                (#pt-use finite-weierstrass-nonsingular-negate ())
                modulus
                positive-modulus
                curve
                x-coordinate
                y-coordinate
                affine-evidence))
            affine-evidence
            (#pt-app
              (#pt-use finite-weierstrass-neg-y-involution ())
              modulus
              positive-modulus
              curve
              x-coordinate
              y-coordinate))))
      point)))
(#theorem finite-affine-point-negate-injective
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
    (#parameter first-point (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve))
    (#parameter second-point (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve))
    (#parameter negated-equation (#pt-eq (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve) (#pt-app (#pt-use finite-affine-point-negate ()) modulus positive-modulus curve first-point) (#pt-app (#pt-use finite-affine-point-negate ()) modulus positive-modulus curve second-point))))
  (#statement
    (#pt-eq
      (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
      first-point
      second-point))
  (#proof
    (#pt-app
      (#pt-use transitivity (0))
      (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
      first-point
      (#pt-app
        (#pt-use finite-affine-point-negate ())
        modulus
        positive-modulus
        curve
        (#pt-app (#pt-use finite-affine-point-negate ()) modulus positive-modulus curve first-point))
      second-point
      (#pt-app
        (#pt-use symmetry (0))
        (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
        (#pt-app
          (#pt-use finite-affine-point-negate ())
          modulus
          positive-modulus
          curve
          (#pt-app
            (#pt-use finite-affine-point-negate ())
            modulus
            positive-modulus
            curve
            first-point))
        first-point
        (#pt-app
          (#pt-use finite-affine-point-negate-involutive ())
          modulus
          positive-modulus
          curve
          first-point))
      (#pt-app
        (#pt-use transitivity (0))
        (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
        (#pt-app
          (#pt-use finite-affine-point-negate ())
          modulus
          positive-modulus
          curve
          (#pt-app
            (#pt-use finite-affine-point-negate ())
            modulus
            positive-modulus
            curve
            first-point))
        (#pt-app
          (#pt-use finite-affine-point-negate ())
          modulus
          positive-modulus
          curve
          (#pt-app
            (#pt-use finite-affine-point-negate ())
            modulus
            positive-modulus
            curve
            second-point))
        second-point
        (#pt-app
          (#pt-use congruence (0 0))
          (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
          (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
          (#pt-lambda
            (
              (mapped-point
                (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)))
            (#pt-app
              (#pt-use finite-affine-point-negate ())
              modulus
              positive-modulus
              curve
              mapped-point))
          (#pt-app
            (#pt-use finite-affine-point-negate ())
            modulus
            positive-modulus
            curve
            first-point)
          (#pt-app
            (#pt-use finite-affine-point-negate ())
            modulus
            positive-modulus
            curve
            second-point)
          negated-equation)
        (#pt-app
          (#pt-use finite-affine-point-negate-involutive ())
          modulus
          positive-modulus
          curve
          second-point)))))
(#theorem finite-affine-point-negate-tag
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
    (#parameter point (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app
        (#pt-use finite-affine-point-tag ())
        modulus
        positive-modulus
        curve
        (#pt-app (#pt-use finite-affine-point-negate ()) modulus positive-modulus curve point))
      (#pt-app (#pt-use finite-affine-point-tag ()) modulus positive-modulus curve point)))
  (#proof
    (#pt-induct
      finite-affine-point
      ()
      (modulus positive-modulus curve)
      (#pt-lambda
        ((point-subject (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)))
        (#pt-eq
          #pt-nat
          (#pt-app
            (#pt-use finite-affine-point-tag ())
            modulus
            positive-modulus
            curve
            (#pt-app
              (#pt-use finite-affine-point-negate ())
              modulus
              positive-modulus
              curve
              point-subject))
          (#pt-app
            (#pt-use finite-affine-point-tag ())
            modulus
            positive-modulus
            curve
            point-subject)))
      (
        (#pt-refl
          #pt-nat
          (#pt-app
            (#pt-use finite-affine-point-tag ())
            modulus
            positive-modulus
            curve
            (#pt-construct finite-affine-point () (modulus positive-modulus curve) infinity ())))
        (#pt-lambda
          (
            (x-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
            (y-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
            (affine-evidence
              (#pt-app
                (#pt-use finite-weierstrass-nonsingular ())
                modulus
                positive-modulus
                curve
                x-coordinate
                y-coordinate)))
          (#pt-refl
            #pt-nat
            (#pt-app
              (#pt-use finite-affine-point-tag ())
              modulus
              positive-modulus
              curve
              (#pt-construct
                finite-affine-point
                ()
                (modulus positive-modulus curve)
                coordinate
                (x-coordinate y-coordinate affine-evidence))))))
      point)))
