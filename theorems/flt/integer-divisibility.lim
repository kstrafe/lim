; Constructive divisibility on formal-difference integers.
; Every divisibility claim carries an integer factor and a checked equivalence.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias exists = ./logic-exists.lim::exists)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-negative-natural = ./integer-defs.lim::integer-negative-natural)
(#alias integer-zero = ./integer-defs.lim::integer-zero)
(#alias integer-one = ./integer-defs.lim::integer-one)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-divides = ./integer-defs.lim::integer-divides)
(#alias integer-reflexive = ./integer-equality.lim::integer-reflexive)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias integer-negate-congruent = ./integer-equality.lim::integer-negate-congruent)
(#alias integer-of-natural-injective = ./integer-equality.lim::integer-of-natural-injective)
(#alias integer-multiply-congruent-first = ./integer-equality.lim::integer-multiply-congruent-first)
(#alias
  integer-multiply-congruent-second
  =
  ./integer-multiplication.lim::integer-multiply-congruent-second)
(#alias integer-multiply-commutative = ./integer-multiplication.lim::integer-multiply-commutative)
(#alias integer-multiply-associative = ./integer-multiplication.lim::integer-multiply-associative)
(#alias integer-multiply-negative = ./integer-multiplication.lim::integer-multiply-negative)
(#alias integer-multiply-one = ./integer-multiplication.lim::integer-multiply-one)
(#alias integer-multiply-zero = ./integer-multiplication.lim::integer-multiply-zero)
(#alias integer-multiply-of-natural = ./integer-multiplication.lim::integer-multiply-of-natural)
(#alias integer-negate-involution = ./integer-addition.lim::integer-negate-involution)
(#alias symmetry = ./equality.lim::symmetry)
(#alias congruence = ./equality.lim::congruence)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#theorem integer-multiply-negative-second
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-multiply ()) first (#pt-app (#pt-use integer-negate ()) second))
      (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-multiply ()) first second))))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app (#pt-use integer-multiply ()) first (#pt-app (#pt-use integer-negate ()) second))
      (#pt-app (#pt-use integer-multiply ()) (#pt-app (#pt-use integer-negate ()) second) first)
      (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-multiply ()) first second))
      (#pt-app
        (#pt-use integer-multiply-commutative ())
        first
        (#pt-app (#pt-use integer-negate ()) second))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app (#pt-use integer-multiply ()) (#pt-app (#pt-use integer-negate ()) second) first)
        (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-multiply ()) second first))
        (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-multiply ()) first second))
        (#pt-app (#pt-use integer-multiply-negative ()) second first)
        (#pt-app
          (#pt-use integer-negate-congruent ())
          (#pt-app (#pt-use integer-multiply ()) second first)
          (#pt-app (#pt-use integer-multiply ()) first second)
          (#pt-app (#pt-use integer-multiply-commutative ()) second first))))))
(#theorem integer-multiply-two-negatives
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app (#pt-use integer-negate ()) first)
        (#pt-app (#pt-use integer-negate ()) second))
      (#pt-app (#pt-use integer-multiply ()) first second)))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app (#pt-use integer-negate ()) first)
        (#pt-app (#pt-use integer-negate ()) second))
      (#pt-app
        (#pt-use integer-negate ())
        (#pt-app (#pt-use integer-multiply ()) first (#pt-app (#pt-use integer-negate ()) second)))
      (#pt-app (#pt-use integer-multiply ()) first second)
      (#pt-app
        (#pt-use integer-multiply-negative ())
        first
        (#pt-app (#pt-use integer-negate ()) second))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app (#pt-use integer-multiply ()) first (#pt-app (#pt-use integer-negate ()) second)))
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-multiply ()) first second)))
        (#pt-app (#pt-use integer-multiply ()) first second)
        (#pt-app
          (#pt-use integer-negate-congruent ())
          (#pt-app (#pt-use integer-multiply ()) first (#pt-app (#pt-use integer-negate ()) second))
          (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-multiply ()) first second))
          (#pt-app (#pt-use integer-multiply-negative-second ()) first second))
        (#pt-app
          (#pt-use integer-negate-involution ())
          (#pt-app (#pt-use integer-multiply ()) first second))))))
(#theorem integer-divides-zero
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use integer ())))
  (#statement (#pt-app (#pt-use integer-divides ()) divisor (#pt-use integer-zero ())))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use integer ())
        (#pt-lambda
          ((candidate-factor (#pt-use integer ())))
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-use integer-zero ())
            (#pt-app (#pt-use integer-multiply ()) divisor candidate-factor))))
      introduce
      (
        (#pt-use integer-zero ())
        (#pt-app
          (#pt-use integer-symmetric ())
          (#pt-app (#pt-use integer-multiply ()) divisor (#pt-use integer-zero ()))
          (#pt-use integer-zero ())
          (#pt-app (#pt-use integer-multiply-zero ()) divisor))))))
(#theorem integer-divides-reflexive
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ())))
  (#statement (#pt-app (#pt-use integer-divides ()) number number))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use integer ())
        (#pt-lambda
          ((candidate-factor (#pt-use integer ())))
          (#pt-app
            (#pt-use integer-equal ())
            number
            (#pt-app (#pt-use integer-multiply ()) number candidate-factor))))
      introduce
      (
        (#pt-use integer-one ())
        (#pt-app
          (#pt-use integer-symmetric ())
          (#pt-app (#pt-use integer-multiply ()) number (#pt-use integer-one ()))
          number
          (#pt-app (#pt-use integer-multiply-one ()) number))))))
(#theorem integer-divides-multiple
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-divides ())
      first
      (#pt-app (#pt-use integer-multiply ()) first second)))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use integer ())
        (#pt-lambda
          ((candidate-factor (#pt-use integer ())))
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-app (#pt-use integer-multiply ()) first second)
            (#pt-app (#pt-use integer-multiply ()) first candidate-factor))))
      introduce
      (second
        (#pt-app
          (#pt-use integer-reflexive ())
          (#pt-app (#pt-use integer-multiply ()) first second))))))
(#theorem integer-divides-congruent-target
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use integer ()))
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter target-equivalence (#pt-app (#pt-use integer-equal ()) first second))
    (#parameter divides-proof (#pt-app (#pt-use integer-divides ()) divisor first)))
  (#statement (#pt-app (#pt-use integer-divides ()) divisor second))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use integer ())
        (#pt-lambda
          ((candidate-factor (#pt-use integer ())))
          (#pt-app
            (#pt-use integer-equal ())
            first
            (#pt-app (#pt-use integer-multiply ()) divisor candidate-factor))))
      (#pt-lambda
        (
          (integer-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  first
                  (#pt-app (#pt-use integer-multiply ()) divisor candidate-factor))))))
        (#pt-app (#pt-use integer-divides ()) divisor second))
      (
        (#pt-lambda
          (
            (factor (#pt-use integer ()))
            (factor-equivalence
              (#pt-app
                (#pt-use integer-equal ())
                first
                (#pt-app (#pt-use integer-multiply ()) divisor factor))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  second
                  (#pt-app (#pt-use integer-multiply ()) divisor candidate-factor))))
            introduce
            (factor
              (#pt-app
                (#pt-use integer-transitive ())
                second
                first
                (#pt-app (#pt-use integer-multiply ()) divisor factor)
                (#pt-app (#pt-use integer-symmetric ()) first second target-equivalence)
                factor-equivalence)))))
      divides-proof)))
(#theorem integer-divides-congruent-divisor
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter number (#pt-use integer ()))
    (#parameter divisor-equivalence (#pt-app (#pt-use integer-equal ()) first second))
    (#parameter divides-proof (#pt-app (#pt-use integer-divides ()) first number)))
  (#statement (#pt-app (#pt-use integer-divides ()) second number))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use integer ())
        (#pt-lambda
          ((candidate-factor (#pt-use integer ())))
          (#pt-app
            (#pt-use integer-equal ())
            number
            (#pt-app (#pt-use integer-multiply ()) first candidate-factor))))
      (#pt-lambda
        (
          (integer-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  number
                  (#pt-app (#pt-use integer-multiply ()) first candidate-factor))))))
        (#pt-app (#pt-use integer-divides ()) second number))
      (
        (#pt-lambda
          (
            (factor (#pt-use integer ()))
            (factor-equivalence
              (#pt-app
                (#pt-use integer-equal ())
                number
                (#pt-app (#pt-use integer-multiply ()) first factor))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  number
                  (#pt-app (#pt-use integer-multiply ()) second candidate-factor))))
            introduce
            (factor
              (#pt-app
                (#pt-use integer-transitive ())
                number
                (#pt-app (#pt-use integer-multiply ()) first factor)
                (#pt-app (#pt-use integer-multiply ()) second factor)
                factor-equivalence
                (#pt-app
                  (#pt-use integer-multiply-congruent-first ())
                  first
                  second
                  factor
                  divisor-equivalence))))))
      divides-proof)))
(#theorem integer-divides-transitive
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter first-divides (#pt-app (#pt-use integer-divides ()) first second))
    (#parameter second-divides (#pt-app (#pt-use integer-divides ()) second third)))
  (#statement (#pt-app (#pt-use integer-divides ()) first third))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use integer ())
        (#pt-lambda
          ((candidate-factor (#pt-use integer ())))
          (#pt-app
            (#pt-use integer-equal ())
            second
            (#pt-app (#pt-use integer-multiply ()) first candidate-factor))))
      (#pt-lambda
        (
          (integer-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  second
                  (#pt-app (#pt-use integer-multiply ()) first candidate-factor))))))
        (#pt-app (#pt-use integer-divides ()) first third))
      (
        (#pt-lambda
          (
            (factor (#pt-use integer ()))
            (first-equivalence
              (#pt-app
                (#pt-use integer-equal ())
                second
                (#pt-app (#pt-use integer-multiply ()) first factor))))
          (#pt-induct
            exists
            (0)
            (
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  third
                  (#pt-app (#pt-use integer-multiply ()) second candidate-factor))))
            (#pt-lambda
              (
                (integer-certificate
                  (#pt-app
                    (#pt-use exists (0))
                    (#pt-use integer ())
                    (#pt-lambda
                      ((candidate-factor (#pt-use integer ())))
                      (#pt-app
                        (#pt-use integer-equal ())
                        third
                        (#pt-app (#pt-use integer-multiply ()) second candidate-factor))))))
              (#pt-app (#pt-use integer-divides ()) first third))
            (
              (#pt-lambda
                (
                  (second-factor (#pt-use integer ()))
                  (second-equivalence
                    (#pt-app
                      (#pt-use integer-equal ())
                      third
                      (#pt-app (#pt-use integer-multiply ()) second second-factor))))
                (#pt-construct
                  exists
                  (0)
                  (
                    (#pt-use integer ())
                    (#pt-lambda
                      ((candidate-factor (#pt-use integer ())))
                      (#pt-app
                        (#pt-use integer-equal ())
                        third
                        (#pt-app (#pt-use integer-multiply ()) first candidate-factor))))
                  introduce
                  (
                    (#pt-app (#pt-use integer-multiply ()) factor second-factor)
                    (#pt-app
                      (#pt-use integer-transitive ())
                      third
                      (#pt-app (#pt-use integer-multiply ()) second second-factor)
                      (#pt-app
                        (#pt-use integer-multiply ())
                        first
                        (#pt-app (#pt-use integer-multiply ()) factor second-factor))
                      second-equivalence
                      (#pt-app
                        (#pt-use integer-transitive ())
                        (#pt-app (#pt-use integer-multiply ()) second second-factor)
                        (#pt-app
                          (#pt-use integer-multiply ())
                          (#pt-app (#pt-use integer-multiply ()) first factor)
                          second-factor)
                        (#pt-app
                          (#pt-use integer-multiply ())
                          first
                          (#pt-app (#pt-use integer-multiply ()) factor second-factor))
                        (#pt-app
                          (#pt-use integer-multiply-congruent-first ())
                          second
                          (#pt-app (#pt-use integer-multiply ()) first factor)
                          second-factor
                          first-equivalence)
                        (#pt-app
                          (#pt-use integer-multiply-associative ())
                          first
                          factor
                          second-factor)))))))
            second-divides)))
      first-divides)))
(#theorem integer-divides-negative-target
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use integer ()))
    (#parameter number (#pt-use integer ()))
    (#parameter divides-proof (#pt-app (#pt-use integer-divides ()) divisor number)))
  (#statement
    (#pt-app (#pt-use integer-divides ()) divisor (#pt-app (#pt-use integer-negate ()) number)))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use integer ())
        (#pt-lambda
          ((candidate-factor (#pt-use integer ())))
          (#pt-app
            (#pt-use integer-equal ())
            number
            (#pt-app (#pt-use integer-multiply ()) divisor candidate-factor))))
      (#pt-lambda
        (
          (integer-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  number
                  (#pt-app (#pt-use integer-multiply ()) divisor candidate-factor))))))
        (#pt-app (#pt-use integer-divides ()) divisor (#pt-app (#pt-use integer-negate ()) number)))
      (
        (#pt-lambda
          (
            (factor (#pt-use integer ()))
            (factor-equivalence
              (#pt-app
                (#pt-use integer-equal ())
                number
                (#pt-app (#pt-use integer-multiply ()) divisor factor))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-app (#pt-use integer-negate ()) number)
                  (#pt-app (#pt-use integer-multiply ()) divisor candidate-factor))))
            introduce
            (
              (#pt-app (#pt-use integer-negate ()) factor)
              (#pt-app
                (#pt-use integer-transitive ())
                (#pt-app (#pt-use integer-negate ()) number)
                (#pt-app
                  (#pt-use integer-negate ())
                  (#pt-app (#pt-use integer-multiply ()) divisor factor))
                (#pt-app
                  (#pt-use integer-multiply ())
                  divisor
                  (#pt-app (#pt-use integer-negate ()) factor))
                (#pt-app
                  (#pt-use integer-negate-congruent ())
                  number
                  (#pt-app (#pt-use integer-multiply ()) divisor factor)
                  factor-equivalence)
                (#pt-app
                  (#pt-use integer-symmetric ())
                  (#pt-app
                    (#pt-use integer-multiply ())
                    divisor
                    (#pt-app (#pt-use integer-negate ()) factor))
                  (#pt-app
                    (#pt-use integer-negate ())
                    (#pt-app (#pt-use integer-multiply ()) divisor factor))
                  (#pt-app (#pt-use integer-multiply-negative-second ()) divisor factor)))))))
      divides-proof)))
(#theorem integer-divides-negative-divisor
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use integer ()))
    (#parameter number (#pt-use integer ()))
    (#parameter divides-proof (#pt-app (#pt-use integer-divides ()) divisor number)))
  (#statement
    (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-negate ()) divisor) number))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use integer ())
        (#pt-lambda
          ((candidate-factor (#pt-use integer ())))
          (#pt-app
            (#pt-use integer-equal ())
            number
            (#pt-app (#pt-use integer-multiply ()) divisor candidate-factor))))
      (#pt-lambda
        (
          (integer-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  number
                  (#pt-app (#pt-use integer-multiply ()) divisor candidate-factor))))))
        (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-negate ()) divisor) number))
      (
        (#pt-lambda
          (
            (factor (#pt-use integer ()))
            (factor-equivalence
              (#pt-app
                (#pt-use integer-equal ())
                number
                (#pt-app (#pt-use integer-multiply ()) divisor factor))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  number
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-app (#pt-use integer-negate ()) divisor)
                    candidate-factor))))
            introduce
            (
              (#pt-app (#pt-use integer-negate ()) factor)
              (#pt-app
                (#pt-use integer-transitive ())
                number
                (#pt-app (#pt-use integer-multiply ()) divisor factor)
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-negate ()) divisor)
                  (#pt-app (#pt-use integer-negate ()) factor))
                factor-equivalence
                (#pt-app
                  (#pt-use integer-symmetric ())
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-app (#pt-use integer-negate ()) divisor)
                    (#pt-app (#pt-use integer-negate ()) factor))
                  (#pt-app (#pt-use integer-multiply ()) divisor factor)
                  (#pt-app (#pt-use integer-multiply-two-negatives ()) divisor factor)))))))
      divides-proof)))
(#theorem integer-divides-of-natural
  (#universes)
  (#parameters
    (#parameter divisor-natural #pt-nat)
    (#parameter number-natural #pt-nat)
    (#parameter divides-proof (#pt-app (#pt-use divides ()) divisor-natural number-natural)))
  (#statement
    (#pt-app
      (#pt-use integer-divides ())
      (#pt-app (#pt-use integer-of-natural ()) divisor-natural)
      (#pt-app (#pt-use integer-of-natural ()) number-natural)))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-factor #pt-nat))
          (#pt-eq
            #pt-nat
            number-natural
            (#pt-app (#pt-use multiply ()) divisor-natural candidate-factor))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-factor #pt-nat))
                (#pt-eq
                  #pt-nat
                  number-natural
                  (#pt-app (#pt-use multiply ()) divisor-natural candidate-factor))))))
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) divisor-natural)
          (#pt-app (#pt-use integer-of-natural ()) number-natural)))
      (
        (#pt-lambda
          (
            (factor-natural #pt-nat)
            (factor-equation
              (#pt-eq
                #pt-nat
                number-natural
                (#pt-app (#pt-use multiply ()) divisor-natural factor-natural))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-app (#pt-use integer-of-natural ()) number-natural)
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-app (#pt-use integer-of-natural ()) divisor-natural)
                    candidate-factor))))
            introduce
            (
              (#pt-app (#pt-use integer-of-natural ()) factor-natural)
              (#pt-app
                (#pt-use integer-transitive ())
                (#pt-app (#pt-use integer-of-natural ()) number-natural)
                (#pt-app
                  (#pt-use integer-of-natural ())
                  (#pt-app (#pt-use multiply ()) divisor-natural factor-natural))
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-of-natural ()) divisor-natural)
                  (#pt-app (#pt-use integer-of-natural ()) factor-natural))
                (#pt-app
                  (#pt-use congruence (0 0))
                  #pt-nat
                  #pt-nat
                  (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use add ()) endpoint #pt-zero))
                  number-natural
                  (#pt-app (#pt-use multiply ()) divisor-natural factor-natural)
                  factor-equation)
                (#pt-app
                  (#pt-use integer-symmetric ())
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-app (#pt-use integer-of-natural ()) divisor-natural)
                    (#pt-app (#pt-use integer-of-natural ()) factor-natural))
                  (#pt-app
                    (#pt-use integer-of-natural ())
                    (#pt-app (#pt-use multiply ()) divisor-natural factor-natural))
                  (#pt-app (#pt-use integer-multiply-of-natural ()) divisor-natural factor-natural)))))))
      divides-proof)))
