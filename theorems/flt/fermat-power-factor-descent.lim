    (#parameter prime-certificate (#pt-app (#pt-use prime ()) prime-number))
    (#parameter first-equation (#pt-eq #pt-nat first (#pt-app (#pt-use multiply ()) prime-number reduced-first)))
    (#parameter second-equation (#pt-eq #pt-nat second (#pt-app (#pt-use multiply ()) prime-number reduced-second)))
    (#parameter third-equation (#pt-eq #pt-nat third (#pt-app (#pt-use multiply ()) prime-number reduced-third))))
  (#statement
    (#pt-app
      (#pt-use natural-power-solution ())
      exponent
      reduced-first
      reduced-second
      reduced-third))
  (#proof
    (#pt-construct
      natural-power-solution
      ()
      (exponent reduced-first reduced-second reduced-third)
      introduce
      (
        (#pt-app
          (#pt-use natural-factor-nonzero ())
          first
          prime-number
          reduced-first
          (#pt-project natural-power-solution 0 solution)
          first-equation)
        (#pt-app
          (#pt-use natural-factor-nonzero ())
          second
          prime-number
          reduced-second
          (#pt-project natural-power-solution 1 solution)
          second-equation)
        (#pt-app
          (#pt-use natural-factor-nonzero ())
          third
          prime-number
          reduced-third
          (#pt-project natural-power-solution 2 solution)
          third-equation)
        (#pt-app
          (#pt-use power-remove-common-factor ())
          exponent
          first
          second
          third
          prime-number
          reduced-first
          reduced-second
          reduced-third
          (#pt-app
            (#pt-use less-than-upper-nonzero ())
            (#pt-succ #pt-zero)
            prime-number
            (#pt-app (#pt-use prime-larger-than-one ()) prime-number prime-certificate))
          (#pt-project natural-power-solution 3 solution)
          first-equation
          second-equation
          third-equation)))))
