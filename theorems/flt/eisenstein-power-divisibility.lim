; Structural powers in the concrete Eisenstein commutative ring.
; Domain-dependent powers are isolated in eisenstein-domain-powers.lim.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias eisenstein-reflexive = ./eisenstein-equality.lim::eisenstein-reflexive)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-congruent = ./eisenstein-equality.lim::eisenstein-multiply-congruent)
(#alias exists = ./logic-exists.lim::exists)
(#alias eisenstein-one-multiply = ./eisenstein-cubic-bridge.lim::eisenstein-one-multiply)
(#alias eisenstein-multiply-one = ./eisenstein-ring.lim::eisenstein-multiply-one)
(#alias eisenstein-multiply-zero = ./eisenstein-ring.lim::eisenstein-multiply-zero)
(#alias eisenstein-multiply-associative = ./eisenstein-ring.lim::eisenstein-multiply-associative)
(#alias eisenstein-multiply-commutative = ./eisenstein-ring.lim::eisenstein-multiply-commutative)
(#alias
  eisenstein-divides-congruent-target
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-congruent-target)
(#alias
  eisenstein-divides-congruent-divisor
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-congruent-divisor)
(#alias
  eisenstein-divides-transitive
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-transitive)
(#alias eisenstein-power = ./eisenstein-defs.lim::eisenstein-power)
(#alias add = ../fermat_statement.lim::add)
(#theorem eisenstein-power-one
  (#universes)
  (#parameters
    (#parameter base (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app (#pt-use eisenstein-power ()) base (#pt-succ #pt-zero))
      base))
  (#proof (#pt-app (#pt-use eisenstein-multiply-one ()) base)))
(#theorem eisenstein-power-add
  (#universes)
  (#parameters
    (#parameter base (#pt-use eisenstein ()))
    (#parameter first-exponent #pt-nat)
    (#parameter second-exponent #pt-nat))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app
        (#pt-use eisenstein-power ())
        base
        (#pt-app (#pt-use add ()) first-exponent second-exponent))
      (#pt-app
        (#pt-use eisenstein-multiply ())
        (#pt-app (#pt-use eisenstein-power ()) base first-exponent)
        (#pt-app (#pt-use eisenstein-power ()) base second-exponent))))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((index #pt-nat))
        (#pt-app
          (#pt-use eisenstein-equal ())
          (#pt-app
            (#pt-use eisenstein-power ())
            base
            (#pt-app (#pt-use add ()) index second-exponent))
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-power ()) base index)
            (#pt-app (#pt-use eisenstein-power ()) base second-exponent))))
      (#pt-app
        (#pt-use eisenstein-symmetric ())
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-use eisenstein-one ())
          (#pt-app (#pt-use eisenstein-power ()) base second-exponent))
        (#pt-app (#pt-use eisenstein-power ()) base second-exponent)
        (#pt-app
          (#pt-use eisenstein-one-multiply ())
          (#pt-app (#pt-use eisenstein-power ()) base second-exponent)))
      (#pt-lambda
        (
          (previous #pt-nat)
          (previous-equivalence
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app
                (#pt-use eisenstein-power ())
                base
                (#pt-app (#pt-use add ()) previous second-exponent))
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app (#pt-use eisenstein-power ()) base previous)
                (#pt-app (#pt-use eisenstein-power ()) base second-exponent)))))
        (#pt-app
          (#pt-use eisenstein-transitive ())
          (#pt-app
            (#pt-use eisenstein-power ())
            base
            (#pt-app (#pt-use add ()) (#pt-succ previous) second-exponent))
          (#pt-app
            (#pt-use eisenstein-multiply ())
            base
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-power ()) base previous)
              (#pt-app (#pt-use eisenstein-power ()) base second-exponent)))
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-power ()) base (#pt-succ previous))
            (#pt-app (#pt-use eisenstein-power ()) base second-exponent))
          (#pt-app
            (#pt-use eisenstein-multiply-congruent ())
            base
            (#pt-app
              (#pt-use eisenstein-power ())
              base
              (#pt-app (#pt-use add ()) previous second-exponent))
            base
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-power ()) base previous)
              (#pt-app (#pt-use eisenstein-power ()) base second-exponent))
            (#pt-app (#pt-use eisenstein-reflexive ()) base)
            previous-equivalence)
          (#pt-app
            (#pt-use eisenstein-symmetric ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                base
                (#pt-app (#pt-use eisenstein-power ()) base previous))
              (#pt-app (#pt-use eisenstein-power ()) base second-exponent))
            (#pt-app
              (#pt-use eisenstein-multiply ())
              base
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app (#pt-use eisenstein-power ()) base previous)
                (#pt-app (#pt-use eisenstein-power ()) base second-exponent)))
            (#pt-app
              (#pt-use eisenstein-multiply-associative ())
              base
              (#pt-app (#pt-use eisenstein-power ()) base previous)
              (#pt-app (#pt-use eisenstein-power ()) base second-exponent)))))
      first-exponent)))
(#theorem eisenstein-power-divisor
  (#universes)
  (#parameters
    (#parameter base (#pt-use eisenstein ()))
    (#parameter exponent #pt-nat))
  (#statement
    (#pt-app
      (#pt-use eisenstein-divides ())
      base
      (#pt-app (#pt-use eisenstein-power ()) base (#pt-succ exponent))))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app (#pt-use eisenstein-power ()) base (#pt-succ exponent))
            (#pt-app (#pt-use eisenstein-multiply ()) base candidate-factor))))
      introduce
      (
        (#pt-app (#pt-use eisenstein-power ()) base exponent)
        (#pt-app
          (#pt-use eisenstein-reflexive ())
          (#pt-app (#pt-use eisenstein-power ()) base (#pt-succ exponent)))))))
(#theorem eisenstein-power-divides-add
  (#universes)
  (#parameters
    (#parameter base (#pt-use eisenstein ()))
    (#parameter first-exponent #pt-nat)
    (#parameter second-exponent #pt-nat))
  (#statement
    (#pt-app
      (#pt-use eisenstein-divides ())
      (#pt-app (#pt-use eisenstein-power ()) base first-exponent)
      (#pt-app
        (#pt-use eisenstein-power ())
        base
        (#pt-app (#pt-use add ()) first-exponent second-exponent))))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app
              (#pt-use eisenstein-power ())
              base
              (#pt-app (#pt-use add ()) first-exponent second-exponent))
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-power ()) base first-exponent)
              candidate-factor))))
      introduce
      (
        (#pt-app (#pt-use eisenstein-power ()) base second-exponent)
        (#pt-app (#pt-use eisenstein-power-add ()) base first-exponent second-exponent)))))
(#theorem eisenstein-power-divides-product-raise
  (#universes)
  (#parameters
    (#parameter base (#pt-use eisenstein ()))
    (#parameter exponent #pt-nat)
    (#parameter number (#pt-use eisenstein ()))
    (#parameter divides-proof (#pt-app (#pt-use eisenstein-divides ()) (#pt-app (#pt-use eisenstein-power ()) base exponent) number)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-divides ())
      (#pt-app (#pt-use eisenstein-power ()) base (#pt-succ exponent))
      (#pt-app (#pt-use eisenstein-multiply ()) base number)))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            number
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-power ()) base exponent)
              candidate-factor))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  number
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app (#pt-use eisenstein-power ()) base exponent)
                    candidate-factor))))))
        (#pt-app
          (#pt-use eisenstein-divides ())
          (#pt-app (#pt-use eisenstein-power ()) base (#pt-succ exponent))
          (#pt-app (#pt-use eisenstein-multiply ()) base number)))
      (
        (#pt-lambda
          (
            (factor (#pt-use eisenstein ()))
            (factor-equivalence
              (#pt-app
                (#pt-use eisenstein-equal ())
                number
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app (#pt-use eisenstein-power ()) base exponent)
                  factor))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-multiply ()) base number)
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app (#pt-use eisenstein-power ()) base (#pt-succ exponent))
                    candidate-factor))))
            introduce
            (factor
              (#pt-app
                (#pt-use eisenstein-transitive ())
                (#pt-app (#pt-use eisenstein-multiply ()) base number)
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  base
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app (#pt-use eisenstein-power ()) base exponent)
                    factor))
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app (#pt-use eisenstein-power ()) base (#pt-succ exponent))
                  factor)
                (#pt-app
                  (#pt-use eisenstein-multiply-congruent ())
                  base
                  number
                  base
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app (#pt-use eisenstein-power ()) base exponent)
                    factor)
                  (#pt-app (#pt-use eisenstein-reflexive ()) base)
                  factor-equivalence)
                (#pt-app
                  (#pt-use eisenstein-symmetric ())
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app
                      (#pt-use eisenstein-multiply ())
                      base
                      (#pt-app (#pt-use eisenstein-power ()) base exponent))
                    factor)
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    base
                    (#pt-app
                      (#pt-use eisenstein-multiply ())
                      (#pt-app (#pt-use eisenstein-power ()) base exponent)
                      factor))
                  (#pt-app
                    (#pt-use eisenstein-multiply-associative ())
                    base
                    (#pt-app (#pt-use eisenstein-power ()) base exponent)
                    factor)))))))
      divides-proof)))
(#theorem eisenstein-power-divides-step
  (#universes)
  (#parameters
    (#parameter base (#pt-use eisenstein ()))
    (#parameter exponent #pt-nat)
    (#parameter number (#pt-use eisenstein ()))
    (#parameter divides-proof (#pt-app (#pt-use eisenstein-divides ()) (#pt-app (#pt-use eisenstein-power ()) base (#pt-succ exponent)) number)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-divides ())
      (#pt-app (#pt-use eisenstein-power ()) base exponent)
      number))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            number
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-power ()) base (#pt-succ exponent))
              candidate-factor))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  number
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app (#pt-use eisenstein-power ()) base (#pt-succ exponent))
                    candidate-factor))))))
        (#pt-app
          (#pt-use eisenstein-divides ())
          (#pt-app (#pt-use eisenstein-power ()) base exponent)
          number))
      (
        (#pt-lambda
          (
            (factor (#pt-use eisenstein ()))
            (factor-equivalence
              (#pt-app
                (#pt-use eisenstein-equal ())
                number
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app (#pt-use eisenstein-power ()) base (#pt-succ exponent))
                  factor))))
          (#pt-construct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  number
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app (#pt-use eisenstein-power ()) base exponent)
                    candidate-factor))))
            introduce
            (
              (#pt-app (#pt-use eisenstein-multiply ()) base factor)
              (#pt-app
                (#pt-use eisenstein-transitive ())
                number
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app (#pt-use eisenstein-power ()) base (#pt-succ exponent))
                  factor)
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app (#pt-use eisenstein-power ()) base exponent)
                  (#pt-app (#pt-use eisenstein-multiply ()) base factor))
                factor-equivalence
                (#pt-app
                  (#pt-use eisenstein-transitive ())
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app (#pt-use eisenstein-power ()) base (#pt-succ exponent))
                    factor)
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app
                      (#pt-use eisenstein-multiply ())
                      (#pt-app (#pt-use eisenstein-power ()) base exponent)
                      base)
                    factor)
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app (#pt-use eisenstein-power ()) base exponent)
                    (#pt-app (#pt-use eisenstein-multiply ()) base factor))
                  (#pt-app
                    (#pt-use eisenstein-multiply-congruent ())
                    (#pt-app (#pt-use eisenstein-power ()) base (#pt-succ exponent))
                    factor
                    (#pt-app
                      (#pt-use eisenstein-multiply ())
                      (#pt-app (#pt-use eisenstein-power ()) base exponent)
                      base)
                    factor
                    (#pt-app
                      (#pt-use eisenstein-multiply-commutative ())
                      base
                      (#pt-app (#pt-use eisenstein-power ()) base exponent))
                    (#pt-app (#pt-use eisenstein-reflexive ()) factor))
                  (#pt-app
                    (#pt-use eisenstein-multiply-associative ())
                    (#pt-app (#pt-use eisenstein-power ()) base exponent)
                    base
                    factor)))))))
      divides-proof)))
