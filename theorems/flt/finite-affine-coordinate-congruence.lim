; Mathematical source: pinned Mathlib EllipticCurve/Affine/Formula.lean and Point.lean.
; Generated by scripts/generate-flt-affine-points.py; checked native proof terms.
; Coordinate value equality gives actual point identity, with
; proof-irrelevant nonsingularity witnesses transported by J.
(#alias less-than = ./natural-order.lim::less-than)
(#alias finite-residue = ./finite-residue-defs.lim::finite-residue)
(#alias finite-residue-extensional = ./finite-residue-extensional.lim::finite-residue-extensional)
(#alias finite-weierstrass-curve = ./finite-weierstrass-reduction.lim::finite-weierstrass-curve)
(#alias
  finite-weierstrass-nonsingular
  =
  ./finite-weierstrass-points.lim::finite-weierstrass-nonsingular)
(#alias finite-affine-point = ./finite-weierstrass-points.lim::finite-affine-point)
(#theorem finite-affine-coordinate-congruent
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
    (#parameter first-x (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second-x (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter first-y (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second-y (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter first-nonsingular (#pt-app (#pt-use finite-weierstrass-nonsingular ()) modulus positive-modulus curve first-x first-y))
    (#parameter second-nonsingular (#pt-app (#pt-use finite-weierstrass-nonsingular ()) modulus positive-modulus curve second-x second-y))
    (#parameter x-equation (#pt-eq #pt-nat (#pt-project finite-residue 0 first-x) (#pt-project finite-residue 0 second-x)))
    (#parameter y-equation (#pt-eq #pt-nat (#pt-project finite-residue 0 first-y) (#pt-project finite-residue 0 second-y))))
  (#statement
    (#pt-eq
      (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
      (#pt-construct
        finite-affine-point
        ()
        (modulus positive-modulus curve)
        coordinate
        (first-x first-y first-nonsingular))
      (#pt-construct
        finite-affine-point
        ()
        (modulus positive-modulus curve)
        coordinate
        (second-x second-y second-nonsingular))))
  (#proof
    (#pt-app
      (#pt-eq-elim
        (#pt-app (#pt-use finite-residue ()) modulus)
        first-x
        (#pt-lambda
          (
            (x-endpoint (#pt-app (#pt-use finite-residue ()) modulus))
            (x-path (#pt-eq (#pt-app (#pt-use finite-residue ()) modulus) first-x x-endpoint)))
          (#pt-pi
            (
              (selected-y (#pt-app (#pt-use finite-residue ()) modulus))
              (selected-y-path
                (#pt-eq (#pt-app (#pt-use finite-residue ()) modulus) first-y selected-y))
              (endpoint-evidence
                (#pt-app
                  (#pt-use finite-weierstrass-nonsingular ())
                  modulus
                  positive-modulus
                  curve
                  x-endpoint
                  selected-y)))
            (#pt-eq
              (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
              (#pt-construct
                finite-affine-point
                ()
                (modulus positive-modulus curve)
                coordinate
                (first-x first-y first-nonsingular))
              (#pt-construct
                finite-affine-point
                ()
                (modulus positive-modulus curve)
                coordinate
                (x-endpoint selected-y endpoint-evidence)))))
        (#pt-lambda
          (
            (selected-y (#pt-app (#pt-use finite-residue ()) modulus))
            (selected-y-path
              (#pt-eq (#pt-app (#pt-use finite-residue ()) modulus) first-y selected-y)))
          (#pt-eq-elim
            (#pt-app (#pt-use finite-residue ()) modulus)
            first-y
            (#pt-lambda
              (
                (y-endpoint (#pt-app (#pt-use finite-residue ()) modulus))
                (y-path (#pt-eq (#pt-app (#pt-use finite-residue ()) modulus) first-y y-endpoint)))
              (#pt-pi
                (
                  (endpoint-evidence
                    (#pt-app
                      (#pt-use finite-weierstrass-nonsingular ())
                      modulus
                      positive-modulus
                      curve
                      first-x
                      y-endpoint)))
                (#pt-eq
                  (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
                  (#pt-construct
                    finite-affine-point
                    ()
                    (modulus positive-modulus curve)
                    coordinate
                    (first-x first-y first-nonsingular))
                  (#pt-construct
                    finite-affine-point
                    ()
                    (modulus positive-modulus curve)
                    coordinate
                    (first-x y-endpoint endpoint-evidence)))))
            (#pt-lambda
              (
                (endpoint-evidence
                  (#pt-app
                    (#pt-use finite-weierstrass-nonsingular ())
                    modulus
                    positive-modulus
                    curve
                    first-x
                    first-y)))
              (#pt-refl
                (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
                (#pt-construct
                  finite-affine-point
                  ()
                  (modulus positive-modulus curve)
                  coordinate
                  (first-x first-y first-nonsingular))))
            selected-y
            selected-y-path))
        second-x
        (#pt-app
          (#pt-use finite-residue-extensional ())
          modulus
          positive-modulus
          first-x
          second-x
          x-equation))
      second-y
      (#pt-app
        (#pt-use finite-residue-extensional ())
        modulus
        positive-modulus
        first-y
        second-y
        y-equation)
      second-nonsingular)))
