; Actual natural norm certificates under conjugation, equivalence
; and multiplication. Uniqueness follows from the faithful integer
; embedding; the conjugate product is an actual embedded natural norm.
; No choice, field quotient or factorization result is assumed.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-conjugate = ./eisenstein-norm-defs.lim::eisenstein-conjugate)
(#alias eisenstein-norm = ./eisenstein-norm-defs.lim::eisenstein-norm)
(#alias eisenstein-natural-norm = ./eisenstein-norm-defs.lim::eisenstein-natural-norm)
(#alias eisenstein-of-integer = ./eisenstein-defs.lim::eisenstein-of-integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias integer-of-natural-injective = ./integer-equality.lim::integer-of-natural-injective)
(#alias eisenstein-norm-conjugate = ./eisenstein-norm-symmetries.lim::eisenstein-norm-conjugate)
(#alias eisenstein-norm-congruent = ./eisenstein-norm-basic.lim::eisenstein-norm-congruent)
(#alias
  eisenstein-of-integer-congruent
  =
  ./eisenstein-equality.lim::eisenstein-of-integer-congruent)
(#alias eisenstein-product-conjugate = ./eisenstein-conjugate.lim::eisenstein-product-conjugate)
(#alias
  eisenstein-natural-norm-multiply
  =
  ./eisenstein-natural-norm-multiply.lim::eisenstein-natural-norm-multiply)
(#alias multiply = ./../fermat_statement.lim::multiply)
(#theorem eisenstein-natural-norm-conjugate
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter natural-norm #pt-nat)
    (#parameter norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) number natural-norm)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-natural-norm ())
      (#pt-app (#pt-use eisenstein-conjugate ()) number)
      natural-norm))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app (#pt-use eisenstein-norm ()) (#pt-app (#pt-use eisenstein-conjugate ()) number))
      (#pt-app (#pt-use eisenstein-norm ()) number)
      (#pt-app (#pt-use integer-of-natural ()) natural-norm)
      (#pt-app (#pt-use eisenstein-norm-conjugate ()) number)
      norm-certificate)))
(#theorem eisenstein-natural-norm-congruent
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter other (#pt-use eisenstein ()))
    (#parameter natural-norm #pt-nat)
    (#parameter equivalent (#pt-app (#pt-use eisenstein-equal ()) number other))
    (#parameter norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) number natural-norm)))
  (#statement (#pt-app (#pt-use eisenstein-natural-norm ()) other natural-norm))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app (#pt-use eisenstein-norm ()) other)
      (#pt-app (#pt-use eisenstein-norm ()) number)
      (#pt-app (#pt-use integer-of-natural ()) natural-norm)
      (#pt-app
        (#pt-use eisenstein-norm-congruent ())
        other
        number
        (#pt-app (#pt-use eisenstein-symmetric ()) number other equivalent))
      norm-certificate)))
(#theorem eisenstein-natural-norm-unique
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter natural-norm #pt-nat)
    (#parameter other-norm #pt-nat)
    (#parameter first-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) number natural-norm))
    (#parameter second-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) number other-norm)))
  (#statement (#pt-eq #pt-nat natural-norm other-norm))
  (#proof
    (#pt-app
      (#pt-use integer-of-natural-injective ())
      natural-norm
      other-norm
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app (#pt-use integer-of-natural ()) natural-norm)
        (#pt-app (#pt-use eisenstein-norm ()) number)
        (#pt-app (#pt-use integer-of-natural ()) other-norm)
        (#pt-app
          (#pt-use integer-symmetric ())
          (#pt-app (#pt-use eisenstein-norm ()) number)
          (#pt-app (#pt-use integer-of-natural ()) natural-norm)
          first-certificate)
        second-certificate))))
(#theorem eisenstein-product-conjugate-natural
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter natural-norm #pt-nat)
    (#parameter norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) number natural-norm)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app
        (#pt-use eisenstein-multiply ())
        number
        (#pt-app (#pt-use eisenstein-conjugate ()) number))
      (#pt-app
        (#pt-use eisenstein-of-integer ())
        (#pt-app (#pt-use integer-of-natural ()) natural-norm))))
  (#proof
    (#pt-app
      (#pt-use eisenstein-transitive ())
      (#pt-app
        (#pt-use eisenstein-multiply ())
        number
        (#pt-app (#pt-use eisenstein-conjugate ()) number))
      (#pt-app (#pt-use eisenstein-of-integer ()) (#pt-app (#pt-use eisenstein-norm ()) number))
      (#pt-app
        (#pt-use eisenstein-of-integer ())
        (#pt-app (#pt-use integer-of-natural ()) natural-norm))
      (#pt-app (#pt-use eisenstein-product-conjugate ()) number)
      (#pt-app
        (#pt-use eisenstein-of-integer-congruent ())
        (#pt-app (#pt-use eisenstein-norm ()) number)
        (#pt-app (#pt-use integer-of-natural ()) natural-norm)
        norm-certificate))))
(#theorem eisenstein-product-natural-norm-equation
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter other (#pt-use eisenstein ()))
    (#parameter product (#pt-use eisenstein ()))
    (#parameter natural-norm #pt-nat)
    (#parameter other-norm #pt-nat)
    (#parameter product-norm #pt-nat)
    (#parameter product-equivalence (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-multiply ()) number other) product))
    (#parameter first-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) number natural-norm))
    (#parameter second-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) other other-norm))
    (#parameter product-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) product product-norm)))
  (#statement (#pt-eq #pt-nat (#pt-app (#pt-use multiply ()) natural-norm other-norm) product-norm))
  (#proof
    (#pt-app
      (#pt-use eisenstein-natural-norm-unique ())
      (#pt-app (#pt-use eisenstein-multiply ()) number other)
      (#pt-app (#pt-use multiply ()) natural-norm other-norm)
      product-norm
      (#pt-app
        (#pt-use eisenstein-natural-norm-multiply ())
        number
        other
        natural-norm
        other-norm
        first-certificate
        second-certificate)
      (#pt-app
        (#pt-use eisenstein-natural-norm-congruent ())
        product
        (#pt-app (#pt-use eisenstein-multiply ()) number other)
        product-norm
        (#pt-app
          (#pt-use eisenstein-symmetric ())
          (#pt-app (#pt-use eisenstein-multiply ()) number other)
          product
          product-equivalence)
        product-certificate))))
