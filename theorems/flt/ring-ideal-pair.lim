(#math-definition ring-ideal-pair ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (first-element Carrier)
      (second-element Carrier))
    (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (first-element Carrier)
      (second-element Carrier))
    (#pt-app
      (#pt-use ring-ideal-sum ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
      (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element))))
