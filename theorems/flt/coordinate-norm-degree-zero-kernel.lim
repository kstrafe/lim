(#theorem coordinate-norm-degree-element-norm-zero
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter zero-decider (#pt-pi ((coefficient Carrier)) (#pt-app (#pt-use decision ()) (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring coefficient (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))))
    (#parameter first-coordinate (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier)))
    (#parameter zero-norm (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring (#pt-app (#pt-use weierstrass-coordinate-norm ()) Carrier coefficient-ring a1 a2 a3 a4 a6 first-coordinate) (#pt-construct finite-list () (Carrier) nil ()))))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
      (#pt-app (#pt-use weierstrass-coordinate-ring ()) Carrier coefficient-ring a1 a2 a3 a4 a6)
      first-coordinate
      (#pt-app
        (#pt-use ring-zero ())
        (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
        (#pt-app (#pt-use weierstrass-coordinate-ring ()) Carrier coefficient-ring a1 a2 a3 a4 a6))))
  (#proof
    (#pt-app
      (#pt-use coordinate-norm-degree-zero-kernel ())
      Carrier
      coefficient-ring
      coefficient-domain
      a1
      a2
      a3
      a4
      a6
      zero-decider
      (#pt-project quadratic-element 0 first-coordinate)
      (#pt-project quadratic-element 1 first-coordinate)
      zero-norm)))
(#theorem coordinate-norm-degree-element-zero-norm
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter first-coordinate (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier)))
    (#parameter zero-coordinate (#pt-app (#pt-use ring-equal ()) (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier)) (#pt-app (#pt-use weierstrass-coordinate-ring ()) Carrier coefficient-ring a1 a2 a3 a4 a6) first-coordinate (#pt-app (#pt-use ring-zero ()) (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier)) (#pt-app (#pt-use weierstrass-coordinate-ring ()) Carrier coefficient-ring a1 a2 a3 a4 a6)))))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use weierstrass-coordinate-norm ())
        Carrier
        coefficient-ring
        a1
        a2
        a3
        a4
        a6
        first-coordinate)
      (#pt-construct finite-list () (Carrier) nil ())))
  (#proof
    (#pt-app
      (#pt-use coordinate-norm-degree-both-zero ())
      Carrier
      coefficient-ring
      a1
      a2
      a3
      a4
      a6
      (#pt-project quadratic-element 0 first-coordinate)
      (#pt-project quadratic-element 1 first-coordinate)
      (#pt-project conjunction 0 zero-coordinate)
      (#pt-project conjunction 1 zero-coordinate))))
