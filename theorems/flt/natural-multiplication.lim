; Direct mathematical source port of natural multiplication laws.
; Lean 4.33.1 Init/Data/Nat/Basic.lean: Nat.one_mul, Nat.add_mul, Nat.mul_assoc.
; Induction is adapted to Lim's multiplication recursing on its first argument.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias congruence = ./equality.lim::congruence)
(#alias add-zero-right = ./natural-addition.lim::add-zero-right)
(#alias add-associative = ./natural-addition.lim::add-associative)
(#theorem multiply-one-left
  (#universes)
  (#parameters
    (#parameter number #pt-nat))
  (#statement (#pt-eq #pt-nat (#pt-app (#pt-use multiply ()) (#pt-succ #pt-zero) number) number))
  (#proof (#pt-app (#pt-use add-zero-right ()) number)))
(#theorem multiply-add-left
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter third #pt-nat))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use add ()) first second) third)
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use multiply ()) first third)
        (#pt-app (#pt-use multiply ()) second third))))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((ordinal #pt-nat))
        (#pt-eq
          #pt-nat
          (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use add ()) ordinal second) third)
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use multiply ()) ordinal third)
            (#pt-app (#pt-use multiply ()) second third))))
      (#pt-refl #pt-nat (#pt-app (#pt-use multiply ()) second third))
      (#pt-lambda
        (
          (previous #pt-nat)
          (induction-hypothesis
            (#pt-eq
              #pt-nat
              (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use add ()) previous second) third)
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) previous third)
                (#pt-app (#pt-use multiply ()) second third)))))
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          (#pt-app
            (#pt-use multiply ())
            (#pt-app (#pt-use add ()) (#pt-succ previous) second)
            third)
          (#pt-app
            (#pt-use add ())
            third
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use multiply ()) previous third)
              (#pt-app (#pt-use multiply ()) second third)))
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use multiply ()) (#pt-succ previous) third)
            (#pt-app (#pt-use multiply ()) second third))
          (#pt-app
            (#pt-use congruence (0 0))
            #pt-nat
            #pt-nat
            (#pt-lambda ((value #pt-nat)) (#pt-app (#pt-use add ()) third value))
            (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use add ()) previous second) third)
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use multiply ()) previous third)
              (#pt-app (#pt-use multiply ()) second third))
            induction-hypothesis)
          (#pt-app
            (#pt-use symmetry (0))
            #pt-nat
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use multiply ()) (#pt-succ previous) third)
              (#pt-app (#pt-use multiply ()) second third))
            (#pt-app
              (#pt-use add ())
              third
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) previous third)
                (#pt-app (#pt-use multiply ()) second third)))
            (#pt-app
              (#pt-use add-associative ())
              third
              (#pt-app (#pt-use multiply ()) previous third)
              (#pt-app (#pt-use multiply ()) second third)))))
      first)))
(#theorem multiply-associative
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter third #pt-nat))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use multiply ()) first second) third)
      (#pt-app (#pt-use multiply ()) first (#pt-app (#pt-use multiply ()) second third))))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((ordinal #pt-nat))
        (#pt-eq
          #pt-nat
          (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use multiply ()) ordinal second) third)
          (#pt-app (#pt-use multiply ()) ordinal (#pt-app (#pt-use multiply ()) second third))))
      (#pt-refl #pt-nat #pt-zero)
      (#pt-lambda
        (
          (previous #pt-nat)
          (induction-hypothesis
            (#pt-eq
              #pt-nat
              (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use multiply ()) previous second) third)
              (#pt-app (#pt-use multiply ()) previous (#pt-app (#pt-use multiply ()) second third)))))
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          (#pt-app
            (#pt-use multiply ())
            (#pt-app (#pt-use multiply ()) (#pt-succ previous) second)
            third)
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use multiply ()) second third)
            (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use multiply ()) previous second) third))
          (#pt-app
            (#pt-use multiply ())
            (#pt-succ previous)
            (#pt-app (#pt-use multiply ()) second third))
          (#pt-app
            (#pt-use multiply-add-left ())
            second
            (#pt-app (#pt-use multiply ()) previous second)
            third)
          (#pt-app
            (#pt-use congruence (0 0))
            #pt-nat
            #pt-nat
            (#pt-lambda
              ((value #pt-nat))
              (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) second third) value))
            (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use multiply ()) previous second) third)
            (#pt-app (#pt-use multiply ()) previous (#pt-app (#pt-use multiply ()) second third))
            induction-hypothesis)))
      first)))
