; Every nonzero nonunit has a least actual nonunit divisor norm.
; Pointwise cases come from the proved sufficient finite coordinate
; search. The value itself supplies the starting divisor/norm witness;
; minimum construction remains in Prop and assumes no search oracle.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias eisenstein-unit = ./eisenstein-defs.lim::eisenstein-unit)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias exists = ./logic-exists.lim::exists)
(#alias eisenstein-divides-reflexive = ./eisenstein-divisibility.lim::eisenstein-divides-reflexive)
(#alias eisenstein-natural-norm = ./eisenstein-norm-defs.lim::eisenstein-natural-norm)
(#alias eisenstein-nonunit-divisor = ./eisenstein-nonunit-divisors.lim::eisenstein-nonunit-divisor)
(#alias
  eisenstein-nonunit-divisor-congruent
  =
  ./eisenstein-nonunit-divisors.lim::eisenstein-nonunit-divisor-congruent)
(#alias
  eisenstein-nonunit-divisor-cases
  =
  ./eisenstein-nonunit-divisors.lim::eisenstein-nonunit-divisor-cases)
(#alias eisenstein-norm-property = ./eisenstein-finite-norm-search.lim::eisenstein-norm-property)
(#alias
  eisenstein-norm-property-exists
  =
  ./eisenstein-finite-norm-search.lim::eisenstein-norm-property-exists)
(#alias
  eisenstein-norm-existence-cases
  =
  ./eisenstein-finite-norm-search.lim::eisenstein-norm-existence-cases)
(#alias has-minimum = ./least-witness.lim::has-minimum)
(#alias
  minimum-exists-from-proposition-cases
  =
  ./proposition-minimum.lim::minimum-exists-from-proposition-cases)
(#alias
  eisenstein-natural-norm-exists
  =
  ./eisenstein-norm-nonnegative.lim::eisenstein-natural-norm-exists)
(#math-definition eisenstein-nonunit-divisor-at-norm ()
  (#pt-pi ((number (#pt-use eisenstein ())) (natural-norm #pt-nat)) #pt-prop)
  (#pt-lambda
    ((number (#pt-use eisenstein ())) (natural-norm #pt-nat))
    (#pt-app
      (#pt-use eisenstein-norm-property-exists ())
      (#pt-lambda
        ((candidate-divisor (#pt-use eisenstein ())))
        (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number candidate-divisor))
      natural-norm)))
(#theorem eisenstein-nonunit-divisor-norm-cases
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter natural-norm #pt-nat)
    (#parameter number-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ())))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app (#pt-use eisenstein-nonunit-divisor-at-norm ()) number natural-norm)
      (#pt-pi
        (
          (denied-proof
            (#pt-app (#pt-use eisenstein-nonunit-divisor-at-norm ()) number natural-norm)))
        #pt-false)))
  (#proof
    (#pt-app
      (#pt-use eisenstein-norm-existence-cases ())
      (#pt-lambda
        ((candidate-divisor (#pt-use eisenstein ())))
        (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number candidate-divisor))
      natural-norm
      (#pt-lambda
        (
          (source-value (#pt-use eisenstein ()))
          (target-value (#pt-use eisenstein ()))
          (value-equivalence (#pt-app (#pt-use eisenstein-equal ()) source-value target-value))
          (source-evidence (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number source-value)))
        (#pt-app
          (#pt-use eisenstein-nonunit-divisor-congruent ())
          number
          source-value
          target-value
          value-equivalence
          source-evidence))
      (#pt-lambda
        ((case-value (#pt-use eisenstein ())))
        (#pt-app (#pt-use eisenstein-nonunit-divisor-cases ()) number case-value number-nonzero)))))
(#theorem eisenstein-minimum-nonunit-divisor-norm
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter number-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ())))) #pt-false))
    (#parameter number-nonunit (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) number))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use has-minimum ())
      (#pt-lambda
        ((candidate-norm #pt-nat))
        (#pt-app (#pt-use eisenstein-nonunit-divisor-at-norm ()) number candidate-norm))))
  (#proof
    (#pt-app
      (#pt-use minimum-exists-from-proposition-cases ())
      (#pt-lambda
        ((candidate-norm #pt-nat))
        (#pt-app (#pt-use eisenstein-nonunit-divisor-at-norm ()) number candidate-norm))
      (#pt-lambda
        ((candidate-norm #pt-nat))
        (#pt-app
          (#pt-use eisenstein-nonunit-divisor-norm-cases ())
          number
          candidate-norm
          number-nonzero))
      (#pt-induct
        exists
        (0)
        (#pt-nat
          (#pt-lambda
            ((candidate-natural-norm #pt-nat))
            (#pt-app (#pt-use eisenstein-natural-norm ()) number candidate-natural-norm)))
        (#pt-lambda
          (
            (certificate
              (#pt-app
                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((candidate-natural-norm #pt-nat))
                  (#pt-app (#pt-use eisenstein-natural-norm ()) number candidate-natural-norm)))))
          (#pt-app
            (#pt-use exists (0))
            #pt-nat
            (#pt-lambda
              ((candidate-norm #pt-nat))
              (#pt-app (#pt-use eisenstein-nonunit-divisor-at-norm ()) number candidate-norm))))
        (
          (#pt-lambda
            (
              (natural-norm #pt-nat)
              (norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) number natural-norm)))
            (#pt-construct
              exists
              (0)
              (#pt-nat
                (#pt-lambda
                  ((candidate-norm #pt-nat))
                  (#pt-app (#pt-use eisenstein-nonunit-divisor-at-norm ()) number candidate-norm)))
              introduce
              (natural-norm
                (#pt-construct
                  exists
                  (0)
                  (
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-value (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use eisenstein-norm-property ())
                        (#pt-lambda
                          ((candidate-divisor (#pt-use eisenstein ())))
                          (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number candidate-divisor))
                        candidate-value
                        natural-norm)))
                  introduce
                  (number
                    (#pt-app
                      (#pt-use conjunction-introduce ())
                      (#pt-app (#pt-use eisenstein-nonunit-divisor ()) number number)
                      (#pt-app (#pt-use eisenstein-natural-norm ()) number natural-norm)
                      (#pt-app
                        (#pt-use conjunction-introduce ())
                        (#pt-pi
                          ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) number)))
                          #pt-false)
                        (#pt-app (#pt-use eisenstein-divides ()) number number)
                        number-nonunit
                        (#pt-app (#pt-use eisenstein-divides-reflexive ()) number))
                      norm-certificate)))))))
        (#pt-app (#pt-use eisenstein-natural-norm-exists ()) number)))))
