(#theorem coordinate-norm-degree-double-not-one
  (#universes)
  (#parameters
    (#parameter constant-degree #pt-nat))
  (#statement
    (#pt-pi
      (
        (denied-evidence
          (#pt-eq
            #pt-nat
            (#pt-app (#pt-use add ()) constant-degree constant-degree)
            (#pt-numeral 1))))
      #pt-false))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((degree-index #pt-nat))
        (#pt-pi
          (
            (denied-evidence
              (#pt-eq #pt-nat (#pt-app (#pt-use add ()) degree-index degree-index) (#pt-numeral 1))))
          #pt-false))
      (#pt-lambda
        (
          (one-equation
            (#pt-eq #pt-nat (#pt-app (#pt-use add ()) #pt-zero #pt-zero) (#pt-numeral 1))))
        (#pt-app
          (#pt-app (#pt-use successor-not-zero ()) #pt-zero)
          (#pt-app (#pt-use symmetry (0)) #pt-nat #pt-zero (#pt-numeral 1) one-equation)))
      (#pt-lambda
        (
          (previous-degree #pt-nat)
          (previous-refutation
            (#pt-pi
              (
                (denied-evidence
                  (#pt-eq
                    #pt-nat
                    (#pt-app (#pt-use add ()) previous-degree previous-degree)
                    (#pt-numeral 1))))
              #pt-false)))
        (#pt-lambda
          (
            (one-equation
              (#pt-eq
                #pt-nat
                (#pt-app (#pt-use add ()) (#pt-succ previous-degree) (#pt-succ previous-degree))
                (#pt-numeral 1))))
          (#pt-app
            (#pt-app
              (#pt-use successor-not-zero ())
              (#pt-app (#pt-use add ()) previous-degree previous-degree))
            (#pt-app
              (#pt-use successor-injective ())
              (#pt-succ (#pt-app (#pt-use add ()) previous-degree previous-degree))
              #pt-zero
              (#pt-app
                (#pt-use transitivity (0))
                #pt-nat
                (#pt-succ (#pt-succ (#pt-app (#pt-use add ()) previous-degree previous-degree)))
                (#pt-app (#pt-use add ()) (#pt-succ previous-degree) (#pt-succ previous-degree))
                (#pt-numeral 1)
                (#pt-app
                  (#pt-use symmetry (0))
                  #pt-nat
                  (#pt-app (#pt-use add ()) (#pt-succ previous-degree) (#pt-succ previous-degree))
                  (#pt-succ (#pt-succ (#pt-app (#pt-use add ()) previous-degree previous-degree)))
                  (#pt-app
                    (#pt-use coordinate-norm-degree-double-successor-identity ())
                    previous-degree))
                one-equation)))))
      constant-degree)))
(#theorem coordinate-norm-degree-cubic-not-one
  (#universes)
  (#parameters
    (#parameter linear-degree #pt-nat))
  (#statement
    (#pt-pi
      (
        (denied-evidence
