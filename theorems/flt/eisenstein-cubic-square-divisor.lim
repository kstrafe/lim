; A witnessed divisor of a cube root supplies an actual square
; divisor of any coefficient times its cube (FLT/Three.lean:658-666).
; Product-power and factor witnesses construct the result directly;
; no lower-bound or square-divisibility oracle is assumed.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-power = ./eisenstein-defs.lim::eisenstein-power)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias eisenstein-reflexive = ./eisenstein-equality.lim::eisenstein-reflexive)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-multiply-congruent = ./eisenstein-equality.lim::eisenstein-multiply-congruent)
(#alias exists = ./logic-exists.lim::exists)
(#alias
  eisenstein-divides-congruent-target
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-congruent-target)
(#alias
  eisenstein-divides-product-left
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-product-left)
(#alias
  eisenstein-divides-product-right
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-product-right)
(#alias eisenstein-cube-product = ./eisenstein-cubic-factorization.lim::eisenstein-cube-product)
(#alias
  eisenstein-power-divides-add
  =
  ./eisenstein-power-divisibility.lim::eisenstein-power-divides-add)
(#alias eisenstein-power-congruent = ./eisenstein-ring.lim::eisenstein-power-congruent)
(#theorem eisenstein-square-divides-scaled-factor-cube
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter coefficient (#pt-use eisenstein ()))
    (#parameter factor (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use eisenstein-divides ())
      (#pt-app (#pt-use eisenstein-power ()) divisor (#pt-numeral 2))
      (#pt-app
        (#pt-use eisenstein-multiply ())
        coefficient
        (#pt-app
          (#pt-use eisenstein-power ())
          (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
          (#pt-numeral 3)))))
  (#proof
    (#pt-app
      (#pt-use eisenstein-divides-product-right ())
      (#pt-app (#pt-use eisenstein-power ()) divisor (#pt-numeral 2))
      coefficient
      (#pt-app
        (#pt-use eisenstein-power ())
        (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
        (#pt-numeral 3))
      (#pt-app
        (#pt-use eisenstein-divides-congruent-target ())
        (#pt-app (#pt-use eisenstein-power ()) divisor (#pt-numeral 2))
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app (#pt-use eisenstein-power ()) divisor (#pt-numeral 3))
          (#pt-app (#pt-use eisenstein-power ()) factor (#pt-numeral 3)))
        (#pt-app
          (#pt-use eisenstein-power ())
          (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
          (#pt-numeral 3))
        (#pt-app
          (#pt-use eisenstein-symmetric ())
          (#pt-app
            (#pt-use eisenstein-power ())
            (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
            (#pt-numeral 3))
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-power ()) divisor (#pt-numeral 3))
            (#pt-app (#pt-use eisenstein-power ()) factor (#pt-numeral 3)))
          (#pt-app (#pt-use eisenstein-cube-product ()) divisor factor))
        (#pt-app
          (#pt-use eisenstein-divides-product-left ())
          (#pt-app (#pt-use eisenstein-power ()) divisor (#pt-numeral 2))
          (#pt-app (#pt-use eisenstein-power ()) divisor (#pt-numeral 3))
          (#pt-app (#pt-use eisenstein-power ()) factor (#pt-numeral 3))
          (#pt-app
            (#pt-use eisenstein-power-divides-add ())
            divisor
            (#pt-numeral 2)
            (#pt-succ #pt-zero)))))))
(#theorem eisenstein-square-divides-scaled-cube-from-divisor
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter coefficient (#pt-use eisenstein ()))
    (#parameter number (#pt-use eisenstein ()))
    (#parameter number-divides (#pt-app (#pt-use eisenstein-divides ()) divisor number)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-divides ())
      (#pt-app (#pt-use eisenstein-power ()) divisor (#pt-numeral 2))
      (#pt-app
        (#pt-use eisenstein-multiply ())
        coefficient
        (#pt-app (#pt-use eisenstein-power ()) number (#pt-numeral 3)))))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            number
            (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  number
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))))
        (#pt-app
          (#pt-use eisenstein-divides ())
          (#pt-app (#pt-use eisenstein-power ()) divisor (#pt-numeral 2))
          (#pt-app
            (#pt-use eisenstein-multiply ())
            coefficient
            (#pt-app (#pt-use eisenstein-power ()) number (#pt-numeral 3)))))
      (
        (#pt-lambda
          (
            (factor (#pt-use eisenstein ()))
            (factor-equation
              (#pt-app
                (#pt-use eisenstein-equal ())
                number
                (#pt-app (#pt-use eisenstein-multiply ()) divisor factor))))
          (#pt-app
            (#pt-use eisenstein-divides-congruent-target ())
            (#pt-app (#pt-use eisenstein-power ()) divisor (#pt-numeral 2))
            (#pt-app
              (#pt-use eisenstein-multiply ())
              coefficient
              (#pt-app
                (#pt-use eisenstein-power ())
                (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
                (#pt-numeral 3)))
            (#pt-app
              (#pt-use eisenstein-multiply ())
              coefficient
              (#pt-app (#pt-use eisenstein-power ()) number (#pt-numeral 3)))
            (#pt-app
              (#pt-use eisenstein-symmetric ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                coefficient
                (#pt-app (#pt-use eisenstein-power ()) number (#pt-numeral 3)))
              (#pt-app
                (#pt-use eisenstein-multiply ())
                coefficient
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
                  (#pt-numeral 3)))
              (#pt-app
                (#pt-use eisenstein-multiply-congruent ())
                coefficient
                (#pt-app (#pt-use eisenstein-power ()) number (#pt-numeral 3))
                coefficient
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
                  (#pt-numeral 3))
                (#pt-app (#pt-use eisenstein-reflexive ()) coefficient)
                (#pt-app
                  (#pt-use eisenstein-power-congruent ())
                  number
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
                  (#pt-numeral 3)
                  factor-equation)))
            (#pt-app
              (#pt-use eisenstein-square-divides-scaled-factor-cube ())
              divisor
              coefficient
              factor))))
      number-divides)))
