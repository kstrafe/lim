(#theorem finite-affine-point-zero-add
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) modulus))
    (#parameter curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
    (#parameter second-point (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)))
  (#statement
    (#pt-eq
      (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
      (#pt-app
        (#pt-use finite-affine-point-add ())
        modulus
        positive-modulus
        prime-proof
        curve
        (#pt-construct finite-affine-point () (modulus positive-modulus curve) infinity ())
        second-point)
      second-point))
  (#proof
    (#pt-refl
      (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
      second-point)))
(#theorem finite-affine-point-add-zero
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) modulus))
    (#parameter curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
    (#parameter first-point (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)))
  (#statement
    (#pt-eq
      (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
      (#pt-app
        (#pt-use finite-affine-point-add ())
        modulus
        positive-modulus
        prime-proof
        curve
        first-point
        (#pt-construct finite-affine-point () (modulus positive-modulus curve) infinity ()))
      first-point))
  (#proof
    (#pt-induct
      finite-affine-point
      ()
      (modulus positive-modulus curve)
      (#pt-lambda
        ((selected-point (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)))
        (#pt-eq
          (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
          (#pt-app
            (#pt-use finite-affine-point-add ())
            modulus
            positive-modulus
            prime-proof
            curve
            selected-point
            (#pt-construct finite-affine-point () (modulus positive-modulus curve) infinity ()))
          selected-point))
      (
        (#pt-refl
          (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
          (#pt-construct finite-affine-point () (modulus positive-modulus curve) infinity ()))
        (#pt-lambda
          (
            (first-x (#pt-app (#pt-use finite-residue ()) modulus))
            (first-y (#pt-app (#pt-use finite-residue ()) modulus))
            (first-nonsingular
              (#pt-app
                (#pt-use finite-weierstrass-nonsingular ())
                modulus
                positive-modulus
                curve
                first-x
                first-y)))
          (#pt-refl
            (#pt-app (#pt-use finite-affine-point ()) modulus positive-modulus curve)
            (#pt-construct
              finite-affine-point
              ()
              (modulus positive-modulus curve)
              coordinate
              (first-x first-y first-nonsingular)))))
      first-point)))
