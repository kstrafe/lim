(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias substitution = ./equality.lim::substitution)
(#math-definition integer-magnitude ()
  (#pt-pi ((number (#pt-use integer ())) (magnitude #pt-nat)) #pt-prop)
  (#pt-lambda
    ((number (#pt-use integer ())) (magnitude #pt-nat))
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app
        (#pt-use integer-equal ())
        number
        (#pt-app (#pt-use integer-of-natural ()) magnitude))
      (#pt-app
        (#pt-use integer-equal ())
        number
        (#pt-app (#pt-use integer-negative-natural ()) magnitude)))))
(#theorem integer-natural-magnitude
  (#universes)
  (#parameters
    (#parameter magnitude #pt-nat))
  (#statement
    (#pt-app
      (#pt-use integer-magnitude ())
      (#pt-app (#pt-use integer-of-natural ()) magnitude)
      magnitude))
  (#proof
    (#pt-app
      (#pt-use disjunction-left ())
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-app (#pt-use integer-of-natural ()) magnitude)
        (#pt-app (#pt-use integer-of-natural ()) magnitude))
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-app (#pt-use integer-of-natural ()) magnitude)
        (#pt-app (#pt-use integer-negative-natural ()) magnitude))
      (#pt-app (#pt-use integer-reflexive ()) (#pt-app (#pt-use integer-of-natural ()) magnitude)))))
(#theorem integer-negative-magnitude
  (#universes)
  (#parameters
    (#parameter magnitude #pt-nat))
  (#statement
    (#pt-app
      (#pt-use integer-magnitude ())
      (#pt-app (#pt-use integer-negative-natural ()) magnitude)
      magnitude))
  (#proof
    (#pt-app
      (#pt-use disjunction-right ())
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-app (#pt-use integer-negative-natural ()) magnitude)
        (#pt-app (#pt-use integer-of-natural ()) magnitude))
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-app (#pt-use integer-negative-natural ()) magnitude)
        (#pt-app (#pt-use integer-negative-natural ()) magnitude))
      (#pt-app
        (#pt-use integer-reflexive ())
        (#pt-app (#pt-use integer-negative-natural ()) magnitude)))))
(#theorem integer-magnitude-exists
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-magnitude #pt-nat))
        (#pt-app (#pt-use integer-magnitude ()) number candidate-magnitude))))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app
        (#pt-use exists (0))
        #pt-nat
        (#pt-lambda
          ((normal-magnitude #pt-nat))
          (#pt-app
            (#pt-use integer-equal ())
            number
            (#pt-app (#pt-use integer-of-natural ()) normal-magnitude))))
      (#pt-app
        (#pt-use exists (0))
        #pt-nat
        (#pt-lambda
          ((normal-magnitude #pt-nat))
          (#pt-app
            (#pt-use integer-equal ())
            number
            (#pt-app (#pt-use integer-negative-natural ()) normal-magnitude))))
      (#pt-app
        (#pt-use exists (0))
        #pt-nat
        (#pt-lambda
          ((candidate-magnitude #pt-nat))
          (#pt-app (#pt-use integer-magnitude ()) number candidate-magnitude)))
      (#pt-lambda
        (
          (positive-form
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((normal-magnitude #pt-nat))
                (#pt-app
                  (#pt-use integer-equal ())
                  number
                  (#pt-app (#pt-use integer-of-natural ()) normal-magnitude))))))
        (#pt-induct
          exists
          (0)
          (#pt-nat
            (#pt-lambda
              ((normal-magnitude #pt-nat))
              (#pt-app
                (#pt-use integer-equal ())
                number
                (#pt-app (#pt-use integer-of-natural ()) normal-magnitude))))
          (#pt-lambda
            (
              (certificate
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((normal-magnitude #pt-nat))
                    (#pt-app
                      (#pt-use integer-equal ())
                      number
                      (#pt-app (#pt-use integer-of-natural ()) normal-magnitude))))))
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-magnitude #pt-nat))
                (#pt-app (#pt-use integer-magnitude ()) number candidate-magnitude))))
          (
            (#pt-lambda
              (
                (magnitude #pt-nat)
                (normal-equivalence
                  (#pt-app
                    (#pt-use integer-equal ())
                    number
                    (#pt-app (#pt-use integer-of-natural ()) magnitude))))
              (#pt-construct
                exists
                (0)
                (#pt-nat
                  (#pt-lambda
                    ((candidate-magnitude #pt-nat))
                    (#pt-app (#pt-use integer-magnitude ()) number candidate-magnitude)))
                introduce
                (magnitude
                  (#pt-app
                    (#pt-use disjunction-left ())
                    (#pt-app
                      (#pt-use integer-equal ())
                      number
                      (#pt-app (#pt-use integer-of-natural ()) magnitude))
                    (#pt-app
                      (#pt-use integer-equal ())
                      number
                      (#pt-app (#pt-use integer-negative-natural ()) magnitude))
                    normal-equivalence)))))
          positive-form))
      (#pt-lambda
        (
          (negative-form
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((normal-magnitude #pt-nat))
                (#pt-app
                  (#pt-use integer-equal ())
                  number
                  (#pt-app (#pt-use integer-negative-natural ()) normal-magnitude))))))
        (#pt-induct
          exists
          (0)
          (#pt-nat
            (#pt-lambda
              ((normal-magnitude #pt-nat))
              (#pt-app
                (#pt-use integer-equal ())
                number
                (#pt-app (#pt-use integer-negative-natural ()) normal-magnitude))))
          (#pt-lambda
            (
              (certificate
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((normal-magnitude #pt-nat))
                    (#pt-app
                      (#pt-use integer-equal ())
                      number
                      (#pt-app (#pt-use integer-negative-natural ()) normal-magnitude))))))
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-magnitude #pt-nat))
                (#pt-app (#pt-use integer-magnitude ()) number candidate-magnitude))))
          (
            (#pt-lambda
              (
                (magnitude #pt-nat)
                (normal-equivalence
                  (#pt-app
                    (#pt-use integer-equal ())
                    number
                    (#pt-app (#pt-use integer-negative-natural ()) magnitude))))
              (#pt-construct
                exists
                (0)
                (#pt-nat
                  (#pt-lambda
                    ((candidate-magnitude #pt-nat))
                    (#pt-app (#pt-use integer-magnitude ()) number candidate-magnitude)))
                introduce
                (magnitude
                  (#pt-app
                    (#pt-use disjunction-right ())
                    (#pt-app
                      (#pt-use integer-equal ())
                      number
                      (#pt-app (#pt-use integer-of-natural ()) magnitude))
                    (#pt-app
                      (#pt-use integer-equal ())
                      number
                      (#pt-app (#pt-use integer-negative-natural ()) magnitude))
                    normal-equivalence)))))
          negative-form))
      (#pt-app (#pt-use integer-normal-form ()) number))))
(#theorem integer-magnitude-congruent
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter other (#pt-use integer ()))
    (#parameter magnitude #pt-nat)
    (#parameter equivalent (#pt-app (#pt-use integer-equal ()) number other))
    (#parameter magnitude-proof (#pt-app (#pt-use integer-magnitude ()) number magnitude)))
  (#statement (#pt-app (#pt-use integer-magnitude ()) other magnitude))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app
        (#pt-use integer-equal ())
        number
        (#pt-app (#pt-use integer-of-natural ()) magnitude))
      (#pt-app
        (#pt-use integer-equal ())
        number
        (#pt-app (#pt-use integer-negative-natural ()) magnitude))
      (#pt-app (#pt-use integer-magnitude ()) other magnitude)
      (#pt-lambda
        (
          (sign-positive
            (#pt-app
              (#pt-use integer-equal ())
              number
              (#pt-app (#pt-use integer-of-natural ()) magnitude))))
        (#pt-app
          (#pt-use disjunction-left ())
          (#pt-app
            (#pt-use integer-equal ())
            other
            (#pt-app (#pt-use integer-of-natural ()) magnitude))
          (#pt-app
            (#pt-use integer-equal ())
            other
            (#pt-app (#pt-use integer-negative-natural ()) magnitude))
          (#pt-app
            (#pt-use integer-transitive ())
            other
            number
            (#pt-app (#pt-use integer-of-natural ()) magnitude)
            (#pt-app (#pt-use integer-symmetric ()) number other equivalent)
            sign-positive)))
      (#pt-lambda
        (
          (sign-negative
            (#pt-app
              (#pt-use integer-equal ())
              number
              (#pt-app (#pt-use integer-negative-natural ()) magnitude))))
        (#pt-app
          (#pt-use disjunction-right ())
          (#pt-app
            (#pt-use integer-equal ())
            other
            (#pt-app (#pt-use integer-of-natural ()) magnitude))
          (#pt-app
            (#pt-use integer-equal ())
            other
            (#pt-app (#pt-use integer-negative-natural ()) magnitude))
          (#pt-app
            (#pt-use integer-transitive ())
            other
            number
            (#pt-app (#pt-use integer-negative-natural ()) magnitude)
            (#pt-app (#pt-use integer-symmetric ()) number other equivalent)
            sign-negative)))
      magnitude-proof)))
(#theorem integer-magnitude-negate
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter magnitude #pt-nat)
    (#parameter magnitude-proof (#pt-app (#pt-use integer-magnitude ()) number magnitude)))
  (#statement
    (#pt-app (#pt-use integer-magnitude ()) (#pt-app (#pt-use integer-negate ()) number) magnitude))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app
        (#pt-use integer-equal ())
        number
        (#pt-app (#pt-use integer-of-natural ()) magnitude))
      (#pt-app
        (#pt-use integer-equal ())
        number
        (#pt-app (#pt-use integer-negative-natural ()) magnitude))
      (#pt-app
        (#pt-use integer-magnitude ())
        (#pt-app (#pt-use integer-negate ()) number)
        magnitude)
      (#pt-lambda
        (
          (sign-positive
            (#pt-app
              (#pt-use integer-equal ())
              number
              (#pt-app (#pt-use integer-of-natural ()) magnitude))))
        (#pt-app
          (#pt-use disjunction-right ())
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-app (#pt-use integer-negate ()) number)
            (#pt-app (#pt-use integer-of-natural ()) magnitude))
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-app (#pt-use integer-negate ()) number)
            (#pt-app (#pt-use integer-negative-natural ()) magnitude))
          (#pt-app
            (#pt-use integer-negate-congruent ())
            number
            (#pt-app (#pt-use integer-of-natural ()) magnitude)
            sign-positive)))
      (#pt-lambda
        (
          (sign-negative
            (#pt-app
              (#pt-use integer-equal ())
              number
              (#pt-app (#pt-use integer-negative-natural ()) magnitude))))
        (#pt-app
          (#pt-use disjunction-left ())
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-app (#pt-use integer-negate ()) number)
            (#pt-app (#pt-use integer-of-natural ()) magnitude))
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-app (#pt-use integer-negate ()) number)
            (#pt-app (#pt-use integer-negative-natural ()) magnitude))
          (#pt-app
            (#pt-use integer-negate-congruent ())
            number
            (#pt-app (#pt-use integer-negative-natural ()) magnitude)
            sign-negative)))
      magnitude-proof)))
(#theorem integer-opposite-magnitudes-equal
  (#universes)
  (#parameters
    (#parameter magnitude #pt-nat)
    (#parameter other-magnitude #pt-nat)
    (#parameter opposite-equivalence (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-of-natural ()) magnitude) (#pt-app (#pt-use integer-negative-natural ()) other-magnitude))))
  (#statement (#pt-eq #pt-nat magnitude other-magnitude))
  (#proof
    (#pt-app
      (#pt-use transitivity (0))
      #pt-nat
      magnitude
      #pt-zero
      other-magnitude
      (#pt-app
        (#pt-use integer-positive-negative-zero ())
        magnitude
        other-magnitude
        opposite-equivalence)
      (#pt-app
        (#pt-use symmetry (0))
        #pt-nat
        other-magnitude
        #pt-zero
        (#pt-app
          (#pt-use integer-positive-negative-zero ())
          other-magnitude
          magnitude
          (#pt-app
            (#pt-use transitivity (0))
            #pt-nat
            (#pt-app (#pt-use add ()) other-magnitude magnitude)
            (#pt-app (#pt-use add ()) magnitude other-magnitude)
            #pt-zero
            (#pt-app (#pt-use add-commutative ()) other-magnitude magnitude)
            opposite-equivalence))))))
(#theorem integer-magnitude-unique
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter magnitude #pt-nat)
    (#parameter other-magnitude #pt-nat)
    (#parameter first-magnitude-proof (#pt-app (#pt-use integer-magnitude ()) number magnitude))
    (#parameter second-magnitude-proof (#pt-app (#pt-use integer-magnitude ()) number other-magnitude)))
  (#statement (#pt-eq #pt-nat magnitude other-magnitude))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app
        (#pt-use integer-equal ())
        number
        (#pt-app (#pt-use integer-of-natural ()) magnitude))
      (#pt-app
        (#pt-use integer-equal ())
        number
        (#pt-app (#pt-use integer-negative-natural ()) magnitude))
      (#pt-eq #pt-nat magnitude other-magnitude)
      (#pt-lambda
        (
          (first-sign-positive
            (#pt-app
              (#pt-use integer-equal ())
              number
              (#pt-app (#pt-use integer-of-natural ()) magnitude))))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-app
            (#pt-use integer-equal ())
            number
            (#pt-app (#pt-use integer-of-natural ()) other-magnitude))
          (#pt-app
            (#pt-use integer-equal ())
            number
            (#pt-app (#pt-use integer-negative-natural ()) other-magnitude))
          (#pt-eq #pt-nat magnitude other-magnitude)
          (#pt-lambda
            (
              (second-sign-positive
                (#pt-app
                  (#pt-use integer-equal ())
                  number
                  (#pt-app (#pt-use integer-of-natural ()) other-magnitude))))
            (#pt-app
              (#pt-use integer-of-natural-injective ())
              magnitude
              other-magnitude
              (#pt-app
                (#pt-use integer-transitive ())
                (#pt-app (#pt-use integer-of-natural ()) magnitude)
                number
                (#pt-app (#pt-use integer-of-natural ()) other-magnitude)
                (#pt-app
                  (#pt-use integer-symmetric ())
                  number
                  (#pt-app (#pt-use integer-of-natural ()) magnitude)
                  first-sign-positive)
                second-sign-positive)))
          (#pt-lambda
            (
              (second-sign-negative
                (#pt-app
                  (#pt-use integer-equal ())
                  number
                  (#pt-app (#pt-use integer-negative-natural ()) other-magnitude))))
            (#pt-app
              (#pt-use integer-opposite-magnitudes-equal ())
              magnitude
              other-magnitude
              (#pt-app
                (#pt-use integer-transitive ())
                (#pt-app (#pt-use integer-of-natural ()) magnitude)
                number
                (#pt-app (#pt-use integer-negative-natural ()) other-magnitude)
                (#pt-app
                  (#pt-use integer-symmetric ())
                  number
                  (#pt-app (#pt-use integer-of-natural ()) magnitude)
                  first-sign-positive)
                second-sign-negative)))
          second-magnitude-proof))
      (#pt-lambda
        (
          (first-sign-negative
            (#pt-app
              (#pt-use integer-equal ())
              number
              (#pt-app (#pt-use integer-negative-natural ()) magnitude))))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-app
            (#pt-use integer-equal ())
            number
            (#pt-app (#pt-use integer-of-natural ()) other-magnitude))
          (#pt-app
            (#pt-use integer-equal ())
            number
            (#pt-app (#pt-use integer-negative-natural ()) other-magnitude))
          (#pt-eq #pt-nat magnitude other-magnitude)
          (#pt-lambda
            (
              (second-sign-positive
                (#pt-app
                  (#pt-use integer-equal ())
                  number
                  (#pt-app (#pt-use integer-of-natural ()) other-magnitude))))
            (#pt-app
              (#pt-use symmetry (0))
              #pt-nat
              other-magnitude
              magnitude
              (#pt-app
                (#pt-use integer-opposite-magnitudes-equal ())
                other-magnitude
                magnitude
                (#pt-app
                  (#pt-use integer-symmetric ())
                  (#pt-app (#pt-use integer-negative-natural ()) magnitude)
                  (#pt-app (#pt-use integer-of-natural ()) other-magnitude)
                  (#pt-app
                    (#pt-use integer-transitive ())
                    (#pt-app (#pt-use integer-negative-natural ()) magnitude)
                    number
                    (#pt-app (#pt-use integer-of-natural ()) other-magnitude)
                    (#pt-app
                      (#pt-use integer-symmetric ())
                      number
                      (#pt-app (#pt-use integer-negative-natural ()) magnitude)
                      first-sign-negative)
                    second-sign-positive)))))
          (#pt-lambda
            (
              (second-sign-negative
                (#pt-app
                  (#pt-use integer-equal ())
                  number
                  (#pt-app (#pt-use integer-negative-natural ()) other-magnitude))))
            (#pt-app
              (#pt-use integer-negative-natural-injective ())
              magnitude
              other-magnitude
              (#pt-app
                (#pt-use integer-transitive ())
                (#pt-app (#pt-use integer-negative-natural ()) magnitude)
                number
                (#pt-app (#pt-use integer-negative-natural ()) other-magnitude)
                (#pt-app
                  (#pt-use integer-symmetric ())
                  number
                  (#pt-app (#pt-use integer-negative-natural ()) magnitude)
                  first-sign-negative)
                second-sign-negative)))
          second-magnitude-proof))
      first-magnitude-proof)))
(#theorem integer-zero-of-magnitude-zero
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter magnitude #pt-nat)
    (#parameter magnitude-proof (#pt-app (#pt-use integer-magnitude ()) number magnitude))
    (#parameter magnitude-zero (#pt-eq #pt-nat magnitude #pt-zero)))
  (#statement (#pt-app (#pt-use integer-equal ()) number (#pt-use integer-zero ())))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app
        (#pt-use integer-equal ())
        number
        (#pt-app (#pt-use integer-of-natural ()) magnitude))
      (#pt-app
        (#pt-use integer-equal ())
        number
        (#pt-app (#pt-use integer-negative-natural ()) magnitude))
      (#pt-app (#pt-use integer-equal ()) number (#pt-use integer-zero ()))
      (#pt-lambda
        (
          (sign-positive
            (#pt-app
              (#pt-use integer-equal ())
              number
              (#pt-app (#pt-use integer-of-natural ()) magnitude))))
        (#pt-app
          (#pt-use substitution (0))
          #pt-nat
          (#pt-lambda
            ((endpoint #pt-nat))
            (#pt-app
              (#pt-use integer-equal ())
              number
              (#pt-app (#pt-use integer-of-natural ()) endpoint)))
          magnitude
          #pt-zero
          magnitude-zero
          sign-positive))
      (#pt-lambda
        (
          (sign-negative
            (#pt-app
              (#pt-use integer-equal ())
              number
              (#pt-app (#pt-use integer-negative-natural ()) magnitude))))
        (#pt-app
          (#pt-use substitution (0))
          #pt-nat
          (#pt-lambda
            ((endpoint #pt-nat))
            (#pt-app
              (#pt-use integer-equal ())
              number
              (#pt-app (#pt-use integer-negative-natural ()) endpoint)))
          magnitude
          #pt-zero
          magnitude-zero
          sign-negative))
      magnitude-proof)))
(#theorem integer-zero-forces-magnitude-zero
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter magnitude #pt-nat)
    (#parameter magnitude-proof (#pt-app (#pt-use integer-magnitude ()) number magnitude))
    (#parameter zero-equivalence (#pt-app (#pt-use integer-equal ()) number (#pt-use integer-zero ()))))
  (#statement (#pt-eq #pt-nat magnitude #pt-zero))
  (#proof
    (#pt-app
      (#pt-use integer-magnitude-unique ())
      (#pt-use integer-zero ())
      magnitude
      #pt-zero
      (#pt-app
        (#pt-use integer-magnitude-congruent ())
        number
        (#pt-use integer-zero ())
        magnitude
        zero-equivalence
        magnitude-proof)
      (#pt-app (#pt-use integer-natural-magnitude ()) #pt-zero))))
(#theorem integer-nonzero-magnitude
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter magnitude #pt-nat)
    (#parameter magnitude-proof (#pt-app (#pt-use integer-magnitude ()) number magnitude))
    (#parameter integer-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use integer-equal ()) number (#pt-use integer-zero ())))) #pt-false)))
  (#statement (#pt-pi ((denied-proof (#pt-eq #pt-nat magnitude #pt-zero))) #pt-false))
  (#proof
    (#pt-lambda
      ((magnitude-zero (#pt-eq #pt-nat magnitude #pt-zero)))
      (#pt-app
        integer-nonzero
        (#pt-app
          (#pt-use integer-zero-of-magnitude-zero ())
          number
          magnitude
          magnitude-proof
          magnitude-zero)))))
(#theorem integer-nonzero-of-magnitude
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter magnitude #pt-nat)
    (#parameter magnitude-proof (#pt-app (#pt-use integer-magnitude ()) number magnitude))
    (#parameter magnitude-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat magnitude #pt-zero))) #pt-false)))
  (#statement
    (#pt-pi
      ((denied-proof (#pt-app (#pt-use integer-equal ()) number (#pt-use integer-zero ()))))
      #pt-false))
