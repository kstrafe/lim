      (#pt-use disjunction-eliminate ())
      (#pt-app
        (#pt-use integer-equal ())
        number
        (#pt-app (#pt-use integer-of-natural ()) magnitude))
      (#pt-app
        (#pt-use integer-equal ())
        number
        (#pt-app (#pt-use integer-negative-natural ()) magnitude))
      (#pt-app (#pt-use divides ()) natural-divisor magnitude)
      (#pt-lambda
        (
          (sign-positive
            (#pt-app
              (#pt-use integer-equal ())
              number
              (#pt-app (#pt-use integer-of-natural ()) magnitude))))
        (#pt-app
          (#pt-use integer-natural-divisibility-reflects ())
          natural-divisor
          magnitude
          (#pt-app
            (#pt-use integer-divides-congruent-target ())
            (#pt-app (#pt-use integer-of-natural ()) natural-divisor)
            number
            (#pt-app (#pt-use integer-of-natural ()) magnitude)
            sign-positive
            divides-proof)))
