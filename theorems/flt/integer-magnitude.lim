  =
  ./integer-divisibility.lim::integer-divides-congruent-divisor)
(#alias
  integer-divides-negative-target
  =
  ./integer-divisibility.lim::integer-divides-negative-target)
(#alias
  integer-divides-negative-divisor
  =
  ./integer-divisibility.lim::integer-divides-negative-divisor)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias disjunction = ./logical-connectives.lim::disjunction)
