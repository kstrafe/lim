    (#pt-lambda
      ((zero-equivalence (#pt-app (#pt-use integer-equal ()) number (#pt-use integer-zero ()))))
      (#pt-app
        magnitude-nonzero
        (#pt-app
          (#pt-use integer-zero-forces-magnitude-zero ())
          number
          magnitude
          magnitude-proof
          zero-equivalence)))))
(#theorem integer-divides-magnitude
  (#universes)
  (#parameters
    (#parameter natural-divisor #pt-nat)
