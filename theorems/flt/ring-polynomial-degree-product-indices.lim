; Adapted source: pinned Mathlib Algebra/Polynomial/Degree/Defs.lean
; and Degree/Operations.lean; Affine/Point.lean.
; Generated by scripts/generate-flt-polynomial-degrees.py; checked native terms.
; Proved natural index equalities align shifted product
; support and leading coefficients. These are equations in Nat,
; not arithmetic rules built into the polynomial proof.
(#alias add = ./../fermat_statement.lim::add)
(#alias add-commutative = ./natural-addition.lim::add-commutative)
(#alias add-successor-right = ./natural-addition.lim::add-successor-right)
(#alias congruence = ./equality.lim::congruence)
(#alias transitivity = ./equality.lim::transitivity)
(#theorem ring-polynomial-degree-product-support-index
  (#universes)
  (#parameters
    (#parameter first-degree #pt-nat)
    (#parameter second-degree #pt-nat))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use add ()) (#pt-succ second-degree) (#pt-succ first-degree))
      (#pt-succ (#pt-succ (#pt-app (#pt-use add ()) first-degree second-degree)))))
  (#proof
    (#pt-app
      (#pt-use transitivity (0))
      #pt-nat
      (#pt-app (#pt-use add ()) (#pt-succ second-degree) (#pt-succ first-degree))
      (#pt-succ (#pt-succ (#pt-app (#pt-use add ()) second-degree first-degree)))
      (#pt-succ (#pt-succ (#pt-app (#pt-use add ()) first-degree second-degree)))
      (#pt-app
        (#pt-use congruence (0 0))
        #pt-nat
        #pt-nat
        (#pt-lambda ((summand #pt-nat)) (#pt-succ summand))
        (#pt-app (#pt-use add ()) second-degree (#pt-succ first-degree))
        (#pt-succ (#pt-app (#pt-use add ()) second-degree first-degree))
        (#pt-app (#pt-use add-successor-right ()) second-degree first-degree))
      (#pt-app
        (#pt-use congruence (0 0))
        #pt-nat
        #pt-nat
        (#pt-lambda ((summand #pt-nat)) (#pt-succ (#pt-succ summand)))
        (#pt-app (#pt-use add ()) second-degree first-degree)
        (#pt-app (#pt-use add ()) first-degree second-degree)
        (#pt-app (#pt-use add-commutative ()) second-degree first-degree)))))
(#theorem ring-polynomial-degree-product-leading-index
  (#universes)
  (#parameters
    (#parameter first-degree #pt-nat)
    (#parameter second-degree #pt-nat))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use add ()) (#pt-succ second-degree) first-degree)
      (#pt-succ (#pt-app (#pt-use add ()) first-degree second-degree))))
  (#proof
    (#pt-app
      (#pt-use congruence (0 0))
      #pt-nat
      #pt-nat
      (#pt-lambda ((summand #pt-nat)) (#pt-succ summand))
      (#pt-app (#pt-use add ()) second-degree first-degree)
      (#pt-app (#pt-use add ()) first-degree second-degree)
      (#pt-app (#pt-use add-commutative ()) second-degree first-degree))))
