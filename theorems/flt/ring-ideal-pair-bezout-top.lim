; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; An explicit checked linear combination
; equal to one proves the generated pair is the whole ring.
; No coprimality, inverse, or nonsingularity premise is invented.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias ring-add = ./commutative-ring-data.lim::ring-add)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-ideal-containing-one = ./ring-ideal-product-zero-unit.lim::ring-ideal-containing-one)
(#alias ring-ideal-equal = ./ring-ideal-data.lim::ring-ideal-equal)
(#alias ring-ideal-pair = ./ring-ideal-pair.lim::ring-ideal-pair)
(#alias ring-ideal-pair-introduce = ./ring-ideal-pair.lim::ring-ideal-pair-introduce)
(#alias ring-ideal-top = ./ring-ideal-zero-unit.lim::ring-ideal-top)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-one = ./commutative-ring-data.lim::ring-one)
(#theorem ring-ideal-pair-bezout-top
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-element Carrier)
    (#parameter second-element Carrier)
    (#parameter first-coefficient Carrier)
    (#parameter second-coefficient Carrier)
    (#parameter bezout-equation (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring) (#pt-app (#pt-use ring-add ()) Carrier coefficient-ring (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-coefficient first-element) (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring second-coefficient second-element)))))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring first-element second-element)
      (#pt-app (#pt-use ring-ideal-top ()) Carrier coefficient-ring)))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-containing-one ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring first-element second-element)
      (#pt-app
        (#pt-use ring-ideal-pair-introduce ())
        Carrier
        coefficient-ring
        first-element
        second-element
        (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
        first-coefficient
        second-coefficient
        bezout-equation))))
