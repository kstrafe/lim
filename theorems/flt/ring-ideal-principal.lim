(#theorem ring-ideal-principal-introduce
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter generator Carrier)
    (#parameter element Carrier)
    (#parameter multiplier Carrier)
    (#parameter multiple-equation (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring element (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring multiplier generator))))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-member ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring generator)
      element))
  (#proof
    (#pt-construct
      exists
      (0)
      (Carrier
        (#pt-lambda
          ((multiplier-bound-0000 Carrier))
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            element
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              multiplier-bound-0000
              generator))))
      introduce
      (multiplier multiple-equation))))
(#theorem ring-ideal-principal-generator
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter generator Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-member ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring generator)
      generator))
  (#proof
    (#pt-construct
      exists
      (0)
      (Carrier
        (#pt-lambda
          ((multiplier Carrier))
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            generator
            (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring multiplier generator))))
      introduce
      (
        (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
        (#pt-app
          (#pt-use ring-symmetric ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
            generator)
          generator
          (#pt-app (#pt-use ring-one-multiply ()) Carrier coefficient-ring generator))))))
