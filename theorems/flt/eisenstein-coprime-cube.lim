; Concrete specialization of the associated-power extraction used at
; FLT/Three.lean:567-578. For any coprime x,y and witnessed unit u,
; x*y=u*z^3 constructs actual associated-cube witnesses for both factors.
; The complete proof uses natural norms, prime existence and strict
; prime-cube removal, not a factorization or cube-extraction hypothesis.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-power = ./eisenstein-defs.lim::eisenstein-power)
(#alias eisenstein-unit = ./eisenstein-defs.lim::eisenstein-unit)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-commutative = ./eisenstein-ring.lim::eisenstein-multiply-commutative)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias exists = ./logic-exists.lim::exists)
(#alias eisenstein-coprime = ./eisenstein-defs.lim::eisenstein-coprime)
(#alias eisenstein-associated-cube = ./eisenstein-associated-cube.lim::eisenstein-associated-cube)
(#alias eisenstein-natural-norm = ./eisenstein-norm-defs.lim::eisenstein-natural-norm)
(#alias
  eisenstein-natural-norm-exists
  =
  ./eisenstein-norm-nonnegative.lim::eisenstein-natural-norm-exists)
(#alias
  eisenstein-coprime-cube-with-norm
  =
  ./eisenstein-coprime-cube-induction.lim::eisenstein-coprime-cube-with-norm)
(#alias
  eisenstein-coprime-symmetric
  =
  ./eisenstein-coprime-factors.lim::eisenstein-coprime-symmetric)
(#theorem eisenstein-coprime-product-associated-cube
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter root (#pt-use eisenstein ()))
    (#parameter coprime-certificate (#pt-app (#pt-use eisenstein-coprime ()) first second))
    (#parameter unit-certificate (#pt-app (#pt-use eisenstein-unit ()) unit))
    (#parameter product-equation (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-multiply ()) first second) (#pt-app (#pt-use eisenstein-multiply ()) unit (#pt-app (#pt-use eisenstein-power ()) root (#pt-numeral 3))))))
  (#statement (#pt-app (#pt-use eisenstein-associated-cube ()) first))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-norm #pt-nat))
          (#pt-app (#pt-use eisenstein-natural-norm ()) first candidate-norm)))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-norm #pt-nat))
                (#pt-app (#pt-use eisenstein-natural-norm ()) first candidate-norm)))))
        (#pt-app (#pt-use eisenstein-associated-cube ()) first))
      (
        (#pt-lambda
          (
            (natural-norm #pt-nat)
            (norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) first natural-norm)))
          (#pt-app
            (#pt-use eisenstein-coprime-cube-with-norm ())
            natural-norm
            first
            second
            unit
            root
            norm-certificate
            coprime-certificate
            unit-certificate
            product-equation)))
      (#pt-app (#pt-use eisenstein-natural-norm-exists ()) first))))
(#theorem eisenstein-coprime-product-associated-cubes
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter root (#pt-use eisenstein ()))
    (#parameter coprime-certificate (#pt-app (#pt-use eisenstein-coprime ()) first second))
    (#parameter unit-certificate (#pt-app (#pt-use eisenstein-unit ()) unit))
    (#parameter product-equation (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-multiply ()) first second) (#pt-app (#pt-use eisenstein-multiply ()) unit (#pt-app (#pt-use eisenstein-power ()) root (#pt-numeral 3))))))
  (#statement
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app (#pt-use eisenstein-associated-cube ()) first)
      (#pt-app (#pt-use eisenstein-associated-cube ()) second)))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app (#pt-use eisenstein-associated-cube ()) first)
      (#pt-app (#pt-use eisenstein-associated-cube ()) second)
      (#pt-app
        (#pt-use eisenstein-coprime-product-associated-cube ())
        first
        second
        unit
        root
        coprime-certificate
        unit-certificate
        product-equation)
      (#pt-app
        (#pt-use eisenstein-coprime-product-associated-cube ())
        second
        first
        unit
        root
        (#pt-app (#pt-use eisenstein-coprime-symmetric ()) first second coprime-certificate)
        unit-certificate
        (#pt-app
          (#pt-use eisenstein-transitive ())
          (#pt-app (#pt-use eisenstein-multiply ()) second first)
          (#pt-app (#pt-use eisenstein-multiply ()) first second)
          (#pt-app
            (#pt-use eisenstein-multiply ())
            unit
            (#pt-app (#pt-use eisenstein-power ()) root (#pt-numeral 3)))
          (#pt-app (#pt-use eisenstein-multiply-commutative ()) second first)
          product-equation)))))
