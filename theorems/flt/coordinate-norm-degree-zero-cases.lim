; Adapted source: pinned Mathlib Affine/Point.lean:409-470.
; All polynomial, coefficient-domain and index facts are proved.
; Generated by scripts/generate-flt-norm-degrees.py; checked native terms.
; With exactly one potentially nonzero input, the norm
; has cubic-shifted degree2*dq+3 or square degree2*dp. Both
; leading degrees may be0. These are consequences of the actual
; zero-equivalence equations and proved product/negation degree laws.
(#alias add = ./../fermat_statement.lim::add)
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias
  coordinate-norm-degree-cubic-term
  =
  ./coordinate-norm-degree-term-bounds.lim::coordinate-norm-degree-cubic-term)
(#alias
  coordinate-norm-degree-square
  =
  ./coordinate-norm-degree-term-bounds.lim::coordinate-norm-degree-square)
(#alias
  coordinate-norm-degree-value
  =
  ./coordinate-norm-degree-formula.lim::coordinate-norm-degree-value)
(#alias
  coordinate-norm-degree-zero-constant-equation
  =
  ./coordinate-norm-degree-zero-equations.lim::coordinate-norm-degree-zero-constant-equation)
(#alias
  coordinate-norm-degree-zero-linear-equation
  =
  ./coordinate-norm-degree-zero-equations.lim::coordinate-norm-degree-zero-linear-equation)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias
  ring-polynomial-degree-congruent
  =
  ./ring-polynomial-degree-leading.lim::ring-polynomial-degree-congruent)
(#alias
  ring-polynomial-degree-negate
  =
  ./ring-polynomial-degree-dominance.lim::ring-polynomial-degree-negate)
(#alias
  ring-polynomial-degree-witness
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-degree-witness)
(#alias
  ring-polynomial-domain-data
  =
  ./ring-polynomial-domain-data.lim::ring-polynomial-domain-data)
(#alias ring-polynomial-equal = ./ring-polynomial-data.lim::ring-polynomial-equal)
(#alias ring-polynomial-multiply = ./ring-polynomial-data.lim::ring-polynomial-multiply)
(#alias ring-polynomial-negate = ./ring-polynomial-data.lim::ring-polynomial-negate)
(#alias ring-polynomial-symmetric = ./ring-polynomial-equivalence.lim::ring-polynomial-symmetric)
(#alias
  weierstrass-coordinate-cubic
  =
  ./weierstrass-coordinate-normal-form.lim::weierstrass-coordinate-cubic)
(#theorem coordinate-norm-degree-zero-constant
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter linear-degree #pt-nat)
    (#parameter zero-constant (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring polynomial (#pt-construct finite-list () (Carrier) nil ())))
    (#parameter linear-certificate (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring other-polynomial linear-degree)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-degree-witness ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use coordinate-norm-degree-value ())
        Carrier
        coefficient-ring
        a1
        a2
        a3
        a4
        a6
        polynomial
        other-polynomial)
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use add ()) linear-degree linear-degree)
        (#pt-numeral 3))))
  (#proof
    (#pt-app
      (#pt-use ring-polynomial-degree-congruent ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-negate ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-multiply ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-multiply ())
            Carrier
            coefficient-ring
            other-polynomial
            other-polynomial)
          (#pt-app
            (#pt-use weierstrass-coordinate-cubic ())
            Carrier
            coefficient-ring
            a1
            a2
            a3
            a4
            a6)))
      (#pt-app
        (#pt-use coordinate-norm-degree-value ())
        Carrier
        coefficient-ring
        a1
        a2
        a3
        a4
        a6
        polynomial
        other-polynomial)
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use add ()) linear-degree linear-degree)
        (#pt-numeral 3))
      (#pt-app
        (#pt-use ring-polynomial-symmetric ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use coordinate-norm-degree-value ())
          Carrier
          coefficient-ring
          a1
          a2
          a3
          a4
          a6
          polynomial
          other-polynomial)
        (#pt-app
          (#pt-use ring-polynomial-negate ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-multiply ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-multiply ())
              Carrier
              coefficient-ring
              other-polynomial
              other-polynomial)
            (#pt-app
              (#pt-use weierstrass-coordinate-cubic ())
              Carrier
              coefficient-ring
              a1
              a2
              a3
              a4
              a6)))
        (#pt-app
          (#pt-use coordinate-norm-degree-zero-constant-equation ())
          Carrier
          coefficient-ring
          a1
          a2
          a3
          a4
          a6
          polynomial
          other-polynomial
          zero-constant))
      (#pt-app
        (#pt-use ring-polynomial-degree-negate ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-multiply ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-multiply ())
            Carrier
            coefficient-ring
            other-polynomial
            other-polynomial)
          (#pt-app
            (#pt-use weierstrass-coordinate-cubic ())
            Carrier
            coefficient-ring
            a1
            a2
            a3
            a4
            a6))
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use add ()) linear-degree linear-degree)
          (#pt-numeral 3))
        (#pt-app
          (#pt-use coordinate-norm-degree-cubic-term ())
          Carrier
          coefficient-ring
          coefficient-domain
          a1
          a2
          a3
          a4
          a6
          other-polynomial
          linear-degree
          linear-certificate)))))
(#theorem coordinate-norm-degree-zero-linear
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter constant-degree #pt-nat)
    (#parameter constant-certificate (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring polynomial constant-degree))
    (#parameter zero-linear (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring other-polynomial (#pt-construct finite-list () (Carrier) nil ()))))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-degree-witness ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use coordinate-norm-degree-value ())
        Carrier
        coefficient-ring
        a1
        a2
        a3
        a4
        a6
        polynomial
        other-polynomial)
      (#pt-app (#pt-use add ()) constant-degree constant-degree)))
  (#proof
    (#pt-app
      (#pt-use ring-polynomial-degree-congruent ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-polynomial-multiply ()) Carrier coefficient-ring polynomial polynomial)
      (#pt-app
        (#pt-use coordinate-norm-degree-value ())
        Carrier
        coefficient-ring
        a1
        a2
        a3
        a4
        a6
        polynomial
        other-polynomial)
      (#pt-app (#pt-use add ()) constant-degree constant-degree)
      (#pt-app
        (#pt-use ring-polynomial-symmetric ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use coordinate-norm-degree-value ())
          Carrier
          coefficient-ring
          a1
          a2
          a3
          a4
          a6
          polynomial
          other-polynomial)
        (#pt-app
          (#pt-use ring-polynomial-multiply ())
          Carrier
          coefficient-ring
          polynomial
          polynomial)
        (#pt-app
          (#pt-use coordinate-norm-degree-zero-linear-equation ())
          Carrier
          coefficient-ring
          a1
          a2
          a3
          a4
          a6
          polynomial
          other-polynomial
          zero-linear))
      (#pt-app
        (#pt-use coordinate-norm-degree-square ())
        Carrier
        coefficient-ring
        coefficient-domain
        a1
        a2
        a3
        a4
        a6
        polynomial
        constant-degree
        constant-certificate))))
