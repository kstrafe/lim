; Adapted mathematical source: pinned Mathlib RingTheory/AdjoinRoot.lean
; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean.
; Generated by scripts/generate-flt-point-evaluation.py; checked native terms.
; The actual reverse implication follows
; from the checked ideal kernel equality. This covers arbitrary
; coefficient representatives and all finite polynomial lists.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias
  point-evaluation-kernel-eliminate
  =
  ./point-evaluation-kernel.lim::point-evaluation-kernel-eliminate)
(#alias polynomial-root-divisor = ./polynomial-root-division-data.lim::polynomial-root-divisor)
(#alias
  polynomial-root-evaluation-mapping
  =
  ./polynomial-root-evaluation-morphism.lim::polynomial-root-evaluation-mapping)
(#alias
  polynomial-root-evaluation-morphism
  =
  ./polynomial-root-evaluation-morphism.lim::polynomial-root-evaluation-morphism)
(#alias
  polynomial-root-kernel-is-principal
  =
  ./polynomial-root-kernel-is-principal.lim::polynomial-root-kernel-is-principal)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-evaluation-map = ./ring-evaluation-morphism.lim::ring-evaluation-map)
(#alias ring-ideal-member = ./ring-ideal-data.lim::ring-ideal-member)
(#alias ring-ideal-principal = ./ring-ideal-principal.lim::ring-ideal-principal)
(#alias ring-polynomial-evaluate = ./ring-polynomial-data.lim::ring-polynomial-evaluate)
(#alias ring-polynomial-structure = ./ring-polynomial-structure.lim::ring-polynomial-structure)
(#alias ring-symmetric = ./commutative-ring-data.lim::ring-symmetric)
(#alias ring-transitive = ./commutative-ring-data.lim::ring-transitive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#theorem polynomial-root-vanishes-if-principal
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter root Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter member (#pt-app (#pt-use ring-ideal-member ()) (#pt-app (#pt-use finite-list ()) Carrier) (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring) (#pt-app (#pt-use ring-ideal-principal ()) (#pt-app (#pt-use finite-list ()) Carrier) (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring) (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)) polynomial)))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring polynomial root)
      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
  (#proof
    (#pt-app
      (#pt-use ring-transitive ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring polynomial root)
      (#pt-app
        (#pt-use ring-evaluation-map ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        Carrier
        coefficient-ring
        (#pt-app (#pt-use polynomial-root-evaluation-morphism ()) Carrier coefficient-ring root)
        polynomial)
      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
      (#pt-app
        (#pt-use ring-symmetric ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-evaluation-map ())
          (#pt-app (#pt-use finite-list ()) Carrier)
          (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-evaluation-morphism ()) Carrier coefficient-ring root)
          polynomial)
        (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring polynomial root)
        (#pt-app
          (#pt-use polynomial-root-evaluation-mapping ())
          Carrier
          coefficient-ring
          root
          polynomial))
      (#pt-app
        (#pt-use point-evaluation-kernel-eliminate ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        Carrier
        coefficient-ring
        (#pt-app (#pt-use polynomial-root-evaluation-morphism ()) Carrier coefficient-ring root)
        polynomial
        (#pt-app
          (#pt-project
            conjunction
            1
            (#pt-app (#pt-use polynomial-root-kernel-is-principal ()) Carrier coefficient-ring root))
          polynomial
          member)))))
