; A nonzero nonunit has natural norm greater than one.
; In an actual nonzero product with a nonunit cofactor, actual norm
; multiplication proves the first factor norm strictly smaller.
; Every factor, nonzero, nonunit and norm certificate remains explicit.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-unit = ./eisenstein-defs.lim::eisenstein-unit)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-commutative = ./eisenstein-ring.lim::eisenstein-multiply-commutative)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias exists = ./logic-exists.lim::exists)
(#alias eisenstein-natural-norm = ./eisenstein-norm-defs.lim::eisenstein-natural-norm)
(#alias eisenstein-divisor-nonzero = ./eisenstein-divisibility.lim::eisenstein-divisor-nonzero)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#alias
  eisenstein-natural-norm-nonzero
  =
  ./eisenstein-natural-norm-properties.lim::eisenstein-natural-norm-nonzero)
(#alias
  eisenstein-unit-of-natural-norm-one
  =
  ./eisenstein-norm-unit.lim::eisenstein-unit-of-natural-norm-one)
(#alias
  eisenstein-product-natural-norm-equation
  =
  ./eisenstein-natural-norm-transport.lim::eisenstein-product-natural-norm-equation)
(#alias zero-one-or-large = ./natural-small-cases.lim::zero-one-or-large)
(#alias nonunit-multiple-above = ./natural-square-arithmetic.lim::nonunit-multiple-above)
(#alias multiply-commutative = ./natural-multiplication-commutative.lim::multiply-commutative)
(#alias less-than = ./natural-order.lim::less-than)
(#alias substitution = ./equality.lim::substitution)
(#alias transitivity = ./equality.lim::transitivity)
(#alias multiply = ./../fermat_statement.lim::multiply)
(#theorem eisenstein-nonunit-natural-norm-large
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter natural-norm #pt-nat)
    (#parameter norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) number natural-norm))
    (#parameter number-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ())))) #pt-false))
    (#parameter number-nonunit (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) number))) #pt-false)))
  (#statement (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) natural-norm))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-eq #pt-nat natural-norm #pt-zero)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-eq #pt-nat natural-norm (#pt-succ #pt-zero))
        (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) natural-norm))
      (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) natural-norm)
      (#pt-lambda
        ((norm-zero (#pt-eq #pt-nat natural-norm #pt-zero)))
        (#pt-app
          (#pt-use false-elimination ())
          (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) natural-norm)
          (#pt-app
            (#pt-app
              (#pt-use eisenstein-natural-norm-nonzero ())
              number
              natural-norm
              norm-certificate
              number-nonzero)
            norm-zero)))
      (#pt-lambda
        (
          (one-or-large
            (#pt-app
              (#pt-use disjunction ())
              (#pt-eq #pt-nat natural-norm (#pt-succ #pt-zero))
              (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) natural-norm))))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-eq #pt-nat natural-norm (#pt-succ #pt-zero))
          (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) natural-norm)
          (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) natural-norm)
          (#pt-lambda
            ((norm-one (#pt-eq #pt-nat natural-norm (#pt-succ #pt-zero))))
            (#pt-app
              (#pt-use false-elimination ())
              (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) natural-norm)
              (#pt-app
                number-nonunit
                (#pt-app
                  (#pt-use eisenstein-unit-of-natural-norm-one ())
                  number
                  (#pt-app
                    (#pt-use substitution (0))
                    #pt-nat
                    (#pt-lambda
                      ((endpoint #pt-nat))
                      (#pt-app (#pt-use eisenstein-natural-norm ()) number endpoint))
                    natural-norm
                    (#pt-succ #pt-zero)
                    norm-one
                    norm-certificate)))))
          (#pt-lambda
            ((norm-large (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) natural-norm)))
            norm-large)
          one-or-large))
      (#pt-app (#pt-use zero-one-or-large ()) natural-norm))))
(#theorem eisenstein-nonunit-factor-norm-decreases
  (#universes)
  (#parameters
    (#parameter product (#pt-use eisenstein ()))
    (#parameter first-factor (#pt-use eisenstein ()))
    (#parameter second-factor (#pt-use eisenstein ()))
    (#parameter product-norm #pt-nat)
    (#parameter first-norm #pt-nat)
    (#parameter second-norm #pt-nat)
    (#parameter product-norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) product product-norm))
    (#parameter first-norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) first-factor first-norm))
    (#parameter second-norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) second-factor second-norm))
    (#parameter product-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) product (#pt-use eisenstein-zero ())))) #pt-false))
    (#parameter factorization (#pt-app (#pt-use eisenstein-equal ()) product (#pt-app (#pt-use eisenstein-multiply ()) first-factor second-factor)))
    (#parameter second-nonunit (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) second-factor))) #pt-false)))
  (#statement (#pt-app (#pt-use less-than ()) first-norm product-norm))
  (#proof
    (#pt-app
      (#pt-use substitution (0))
      #pt-nat
      (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use less-than ()) first-norm endpoint))
      (#pt-app (#pt-use multiply ()) second-norm first-norm)
      product-norm
      (#pt-app
        (#pt-use transitivity (0))
        #pt-nat
        (#pt-app (#pt-use multiply ()) second-norm first-norm)
        (#pt-app (#pt-use multiply ()) first-norm second-norm)
        product-norm
        (#pt-app (#pt-use multiply-commutative ()) second-norm first-norm)
        (#pt-app
          (#pt-use eisenstein-product-natural-norm-equation ())
          first-factor
          second-factor
          product
          first-norm
          second-norm
          product-norm
          (#pt-app
            (#pt-use eisenstein-symmetric ())
            product
            (#pt-app (#pt-use eisenstein-multiply ()) first-factor second-factor)
            factorization)
          first-norm-certificate
          second-norm-certificate
          product-norm-certificate))
      (#pt-app
        (#pt-use nonunit-multiple-above ())
        first-norm
        second-norm
        (#pt-app
          (#pt-use eisenstein-natural-norm-nonzero ())
          first-factor
          first-norm
          first-norm-certificate
          (#pt-app
            (#pt-use eisenstein-divisor-nonzero ())
            first-factor
            product
            product-nonzero
            (#pt-construct
              exists
              (0)
              (
                (#pt-use eisenstein ())
                (#pt-lambda
                  ((candidate-factor (#pt-use eisenstein ())))
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    product
                    (#pt-app (#pt-use eisenstein-multiply ()) first-factor candidate-factor))))
              introduce
              (second-factor factorization))))
        (#pt-app
          (#pt-use eisenstein-nonunit-natural-norm-large ())
          second-factor
          second-norm
          second-norm-certificate
          (#pt-app
            (#pt-use eisenstein-divisor-nonzero ())
            second-factor
            product
            product-nonzero
            (#pt-construct
              exists
              (0)
              (
                (#pt-use eisenstein ())
                (#pt-lambda
                  ((candidate-factor (#pt-use eisenstein ())))
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    product
                    (#pt-app (#pt-use eisenstein-multiply ()) second-factor candidate-factor))))
              introduce
              (first-factor
                (#pt-app
                  (#pt-use eisenstein-transitive ())
                  product
                  (#pt-app (#pt-use eisenstein-multiply ()) first-factor second-factor)
                  (#pt-app (#pt-use eisenstein-multiply ()) second-factor first-factor)
                  factorization
                  (#pt-app (#pt-use eisenstein-multiply-commutative ()) first-factor second-factor)))))
          second-nonunit)))))
