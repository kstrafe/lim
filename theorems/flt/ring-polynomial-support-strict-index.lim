; Generated by scripts/generate-flt-polynomial-degrees.py; checked native terms.
; The actual gap definition of strict natural order
; converts a support bound into zero at every higher index.
(#alias add = ./../fermat_statement.lim::add)
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias exists = ./logic-exists.lim::exists)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias less-than = ./natural-order.lim::less-than)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-polynomial-coefficient = ./ring-polynomial-data.lim::ring-polynomial-coefficient)
(#alias
  ring-polynomial-support-from
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-support-from)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#alias substitution = ./equality.lim::substitution)
(#alias symmetry = ./equality.lim::symmetry)
(#theorem ring-polynomial-support-after-degree
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter degree #pt-nat)
    (#parameter index #pt-nat)
    (#parameter support (#pt-app (#pt-use ring-polynomial-support-from ()) Carrier coefficient-ring polynomial (#pt-succ degree)))
    (#parameter strict-bound (#pt-app (#pt-use less-than ()) degree index)))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-polynomial-coefficient ()) Carrier coefficient-ring polynomial index)
      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((gap #pt-nat))
          (#pt-eq #pt-nat index (#pt-app (#pt-use add ()) (#pt-succ degree) gap))))
      (#pt-lambda
        ((position-certificate (#pt-app (#pt-use less-than ()) degree index)))
        (#pt-app
          (#pt-use ring-equal ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-coefficient ())
            Carrier
            coefficient-ring
            polynomial
            index)
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
      (
        (#pt-lambda
          (
            (gap #pt-nat)
            (position (#pt-eq #pt-nat index (#pt-app (#pt-use add ()) (#pt-succ degree) gap))))
          (#pt-app
            (#pt-use substitution (0))
            #pt-nat
            (#pt-lambda
              ((coefficient-index #pt-nat))
              (#pt-app
                (#pt-use ring-equal ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-polynomial-coefficient ())
                  Carrier
                  coefficient-ring
                  polynomial
                  coefficient-index)
                (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
            (#pt-app (#pt-use add ()) (#pt-succ degree) gap)
            index
            (#pt-app
              (#pt-use symmetry (0))
              #pt-nat
              index
              (#pt-app (#pt-use add ()) (#pt-succ degree) gap)
              position)
            (#pt-app support gap))))
      strict-bound)))
