; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean.
; Generated by scripts/generate-flt-point-ideal-basis.py; checked native terms.
; Prove the exact Nat index consequence
; (1+u)+v=1 ->1+u=1 by structural induction and successor
; injectivity. No arithmetic solver or bounded enumeration is used.
(#alias add = ./../fermat_statement.lim::add)
(#alias add-associative = ./natural-addition.lim::add-associative)
(#alias congruence = ./equality.lim::congruence)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#alias successor-injective = ./natural-successor.lim::successor-injective)
(#alias successor-not-zero = ./natural-nonzero.lim::successor-not-zero)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#theorem point-ideal-degree-zero-sum-left
  (#universes)
  (#parameters
    (#parameter first-number #pt-nat)
    (#parameter second-number #pt-nat)
    (#parameter sum-zero (#pt-eq #pt-nat (#pt-app (#pt-use add ()) first-number second-number) #pt-zero)))
  (#statement (#pt-eq #pt-nat first-number #pt-zero))
  (#proof
    (#pt-app
      (#pt-nat-induct
        (#pt-lambda
          ((number #pt-nat))
          (#pt-pi
            (
              (second-number-bound-0000 #pt-nat)
              (sum-zero-bound-0001
                (#pt-eq #pt-nat (#pt-app (#pt-use add ()) number second-number-bound-0000) #pt-zero)))
            (#pt-eq #pt-nat number #pt-zero)))
        (#pt-lambda
          (
            (second-number-bound-0002 #pt-nat)
            (sum-zero-bound-0003 (#pt-eq #pt-nat second-number-bound-0002 #pt-zero)))
          (#pt-refl #pt-nat #pt-zero))
        (#pt-lambda
          (
            (previous #pt-nat)
            (induction
              (#pt-pi
                (
                  (second-number-bound-0004 #pt-nat)
                  (sum-zero-bound-0005
                    (#pt-eq
                      #pt-nat
                      (#pt-app (#pt-use add ()) previous second-number-bound-0004)
                      #pt-zero)))
                (#pt-eq #pt-nat previous #pt-zero))))
          (#pt-lambda
            (
              (second-number-bound-0006 #pt-nat)
              (sum-zero-bound-0007
                (#pt-eq
                  #pt-nat
                  (#pt-app (#pt-use add ()) (#pt-succ previous) second-number-bound-0006)
                  #pt-zero)))
            (#pt-app
              (#pt-use false-elimination ())
              (#pt-eq #pt-nat (#pt-succ previous) #pt-zero)
              (#pt-app
                (#pt-use successor-not-zero ())
                (#pt-app (#pt-use add ()) previous second-number-bound-0006)
                sum-zero-bound-0007))))
        first-number)
      second-number
      sum-zero)))
(#theorem point-ideal-degree-one-sum-collapse
  (#universes)
  (#parameters
    (#parameter first-number #pt-nat)
    (#parameter second-number #pt-nat)
    (#parameter sum-one (#pt-eq #pt-nat (#pt-app (#pt-use add ()) (#pt-app (#pt-use add ()) (#pt-numeral 1) first-number) second-number) (#pt-numeral 1))))
  (#statement
    (#pt-eq #pt-nat (#pt-app (#pt-use add ()) (#pt-numeral 1) first-number) (#pt-numeral 1)))
  (#proof
    (#pt-app
      (#pt-use congruence (0 0))
      #pt-nat
      #pt-nat
      (#pt-lambda ((number #pt-nat)) (#pt-app (#pt-use add ()) (#pt-numeral 1) number))
      first-number
      #pt-zero
      (#pt-app
        (#pt-use point-ideal-degree-zero-sum-left ())
        first-number
        second-number
        (#pt-app
          (#pt-use successor-injective ())
          (#pt-app (#pt-use add ()) first-number second-number)
          #pt-zero
          (#pt-app
            (#pt-use transitivity (0))
            #pt-nat
            (#pt-app
              (#pt-use add ())
              (#pt-numeral 1)
              (#pt-app (#pt-use add ()) first-number second-number))
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use add ()) (#pt-numeral 1) first-number)
              second-number)
            (#pt-numeral 1)
            (#pt-app
              (#pt-use symmetry (0))
              #pt-nat
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use add ()) (#pt-numeral 1) first-number)
                second-number)
              (#pt-app
                (#pt-use add ())
                (#pt-numeral 1)
                (#pt-app (#pt-use add ()) first-number second-number))
              (#pt-app (#pt-use add-associative ()) (#pt-numeral 1) first-number second-number))
            sum-one))))))
