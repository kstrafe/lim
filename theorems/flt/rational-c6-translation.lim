        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-negate ())
            (#pt-app (#pt-use rational-power ()) b2 (#pt-numeral 3)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-multiply ())
