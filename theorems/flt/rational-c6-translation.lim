          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app (#pt-use integer-negative-natural ()) (#pt-numeral 1)))
          (#pt-app (#pt-use rational-multiply ()) b2 (#pt-app (#pt-use rational-multiply ()) b2 b2)))
        (#pt-app
