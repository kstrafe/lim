; Actual finite-residue equality is equality of representative
; naturals. Its existing proof-carrying Nat decision supplies the degree
; algorithm for prime, composite and unit moduli without a field assumption.
(#alias decide-equality = ./natural-decision.lim::decide-equality)
(#alias decision = ./logical-decision.lim::decision)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias finite-residue = ./finite-residue-defs.lim::finite-residue)
(#alias finite-residue-ring = ./finite-residue-ring-structure.lim::finite-residue-ring)
(#alias less-than = ./natural-order.lim::less-than)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias
  ring-polynomial-degree-computed-valid
