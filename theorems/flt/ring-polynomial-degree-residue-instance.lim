  ./ring-polynomial-degree-computation.lim::ring-polynomial-degree-natural)
(#alias
  ring-polynomial-degree-witness
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-degree-witness)
(#alias ring-polynomial-equal = ./ring-polynomial-data.lim::ring-polynomial-equal)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#math-definition ring-polynomial-degree-residue-zero-decider ()
  (#pt-pi
    ((modulus #pt-nat) (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus)))
    (#pt-pi
      ((coefficient (#pt-app (#pt-use finite-residue ()) modulus)))
      (#pt-app
        (#pt-use decision ())
        (#pt-app
          (#pt-use ring-equal ())
          (#pt-app (#pt-use finite-residue ()) modulus)
          (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)
          coefficient
          (#pt-app
            (#pt-use ring-zero ())
            (#pt-app (#pt-use finite-residue ()) modulus)
            (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus))))))
  (#pt-lambda
    ((modulus #pt-nat) (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus)))
    (#pt-lambda
      ((coefficient (#pt-app (#pt-use finite-residue ()) modulus)))
      (#pt-app
        (#pt-use decide-equality ())
        (#pt-project finite-residue 0 coefficient)
        (#pt-project
          finite-residue
          0
          (#pt-app
            (#pt-use ring-zero ())
            (#pt-app (#pt-use finite-residue ()) modulus)
            (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)))))))
(#theorem ring-polynomial-degree-residue-valid
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter residue-polynomial (#pt-app (#pt-use finite-list ()) (#pt-app (#pt-use finite-residue ()) modulus)))
    (#parameter nonzero-polynomial (#pt-pi ((denied-evidence (#pt-app (#pt-use ring-polynomial-equal ()) (#pt-app (#pt-use finite-residue ()) modulus) (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus) residue-polynomial (#pt-construct finite-list () ((#pt-app (#pt-use finite-residue ()) modulus)) nil ())))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-degree-witness ())
      (#pt-app (#pt-use finite-residue ()) modulus)
      (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)
      residue-polynomial
      (#pt-app
        (#pt-use ring-polynomial-degree-natural ())
        (#pt-app (#pt-use finite-residue ()) modulus)
        (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)
        (#pt-app (#pt-use ring-polynomial-degree-residue-zero-decider ()) modulus positive-modulus)
        residue-polynomial)))
  (#proof
    (#pt-app
      (#pt-use ring-polynomial-degree-computed-valid ())
      (#pt-app (#pt-use finite-residue ()) modulus)
      (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)
      (#pt-app (#pt-use ring-polynomial-degree-residue-zero-decider ()) modulus positive-modulus)
      residue-polynomial
      nonzero-polynomial)))
