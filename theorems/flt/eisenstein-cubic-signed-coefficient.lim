; A coefficient proved one or negative one equals its cube, so
; the normalized coefficient is absorbed into the second root
; (FLT/Three.lean:690-711). Actual inverse and common-divisor witnesses
; preserve nondivisibility and coprimality under that unit product.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-power = ./eisenstein-defs.lim::eisenstein-power)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias eisenstein-unit = ./eisenstein-defs.lim::eisenstein-unit)
(#alias eisenstein-reflexive = ./eisenstein-equality.lim::eisenstein-reflexive)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-congruent = ./eisenstein-equality.lim::eisenstein-multiply-congruent)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias eisenstein-add = ./eisenstein-defs.lim::eisenstein-add)
(#alias eisenstein-negate = ./eisenstein-defs.lim::eisenstein-negate)
(#alias eisenstein-add-congruent = ./eisenstein-equality.lim::eisenstein-add-congruent)
(#alias eisenstein-coprime = ./eisenstein-defs.lim::eisenstein-coprime)
(#alias eisenstein-cube-product = ./eisenstein-cubic-factorization.lim::eisenstein-cube-product)
(#alias eisenstein-power-congruent = ./eisenstein-ring.lim::eisenstein-power-congruent)
(#alias
  eisenstein-unit-divisibility-reflect
  =
  ./eisenstein-additive-divisibility.lim::eisenstein-unit-divisibility-reflect)
(#alias
  eisenstein-coprime-common-divisor-unit
  =
  ./eisenstein-coprime-factors.lim::eisenstein-coprime-common-divisor-unit)
(#alias
  eisenstein-coprime-of-common-divisors-unit
  =
  ./eisenstein-coprime-factors.lim::eisenstein-coprime-of-common-divisors-unit)
(#theorem eisenstein-signed-coefficient-cube
  (#universes)
  (#parameters
    (#parameter coefficient (#pt-use eisenstein ()))
    (#parameter coefficient-sign (#pt-app (#pt-use disjunction ()) (#pt-app (#pt-use eisenstein-equal ()) coefficient (#pt-use eisenstein-one ())) (#pt-app (#pt-use eisenstein-equal ()) coefficient (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))))))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app (#pt-use eisenstein-power ()) coefficient (#pt-numeral 3))
      coefficient))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use eisenstein-equal ()) coefficient (#pt-use eisenstein-one ()))
      (#pt-app
        (#pt-use eisenstein-equal ())
        coefficient
        (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ())))
      (#pt-app
        (#pt-use eisenstein-equal ())
        (#pt-app (#pt-use eisenstein-power ()) coefficient (#pt-numeral 3))
        coefficient)
      (#pt-lambda
        (
          (positive-coefficient
            (#pt-app (#pt-use eisenstein-equal ()) coefficient (#pt-use eisenstein-one ()))))
        (#pt-app
          (#pt-use eisenstein-transitive ())
          (#pt-app (#pt-use eisenstein-power ()) coefficient (#pt-numeral 3))
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-one ()) (#pt-numeral 3))
          coefficient
          (#pt-app
            (#pt-use eisenstein-power-congruent ())
            coefficient
            (#pt-use eisenstein-one ())
            (#pt-numeral 3)
            positive-coefficient)
          (#pt-app
            (#pt-use eisenstein-transitive ())
            (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-one ()) (#pt-numeral 3))
            (#pt-use eisenstein-one ())
            coefficient
            (#pt-app (#pt-use eisenstein-reflexive ()) (#pt-use eisenstein-one ()))
            (#pt-app
              (#pt-use eisenstein-symmetric ())
              coefficient
              (#pt-use eisenstein-one ())
              positive-coefficient))))
      (#pt-lambda
        (
          (negative-coefficient
            (#pt-app
              (#pt-use eisenstein-equal ())
              coefficient
              (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ())))))
        (#pt-app
          (#pt-use eisenstein-transitive ())
          (#pt-app (#pt-use eisenstein-power ()) coefficient (#pt-numeral 3))
          (#pt-app
            (#pt-use eisenstein-power ())
            (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))
            (#pt-numeral 3))
          coefficient
          (#pt-app
            (#pt-use eisenstein-power-congruent ())
            coefficient
            (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))
            (#pt-numeral 3)
            negative-coefficient)
          (#pt-app
            (#pt-use eisenstein-transitive ())
            (#pt-app
              (#pt-use eisenstein-power ())
              (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))
              (#pt-numeral 3))
            (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))
            coefficient
            (#pt-app
              (#pt-use eisenstein-reflexive ())
              (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ())))
            (#pt-app
              (#pt-use eisenstein-symmetric ())
              coefficient
              (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))
              negative-coefficient))))
      coefficient-sign)))
(#theorem eisenstein-signed-coefficient-product-cube
  (#universes)
  (#parameters
    (#parameter coefficient (#pt-use eisenstein ()))
    (#parameter number (#pt-use eisenstein ()))
    (#parameter coefficient-sign (#pt-app (#pt-use disjunction ()) (#pt-app (#pt-use eisenstein-equal ()) coefficient (#pt-use eisenstein-one ())) (#pt-app (#pt-use eisenstein-equal ()) coefficient (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ()))))))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app
        (#pt-use eisenstein-power ())
        (#pt-app (#pt-use eisenstein-multiply ()) coefficient number)
        (#pt-numeral 3))
      (#pt-app
        (#pt-use eisenstein-multiply ())
        coefficient
        (#pt-app (#pt-use eisenstein-power ()) number (#pt-numeral 3)))))
  (#proof
    (#pt-app
      (#pt-use eisenstein-transitive ())
      (#pt-app
        (#pt-use eisenstein-power ())
        (#pt-app (#pt-use eisenstein-multiply ()) coefficient number)
        (#pt-numeral 3))
      (#pt-app
        (#pt-use eisenstein-multiply ())
        (#pt-app (#pt-use eisenstein-power ()) coefficient (#pt-numeral 3))
        (#pt-app (#pt-use eisenstein-power ()) number (#pt-numeral 3)))
      (#pt-app
        (#pt-use eisenstein-multiply ())
        coefficient
        (#pt-app (#pt-use eisenstein-power ()) number (#pt-numeral 3)))
      (#pt-app (#pt-use eisenstein-cube-product ()) coefficient number)
      (#pt-app
        (#pt-use eisenstein-multiply-congruent ())
        (#pt-app (#pt-use eisenstein-power ()) coefficient (#pt-numeral 3))
        (#pt-app (#pt-use eisenstein-power ()) number (#pt-numeral 3))
        coefficient
        (#pt-app (#pt-use eisenstein-power ()) number (#pt-numeral 3))
        (#pt-app (#pt-use eisenstein-signed-coefficient-cube ()) coefficient coefficient-sign)
        (#pt-app
          (#pt-use eisenstein-reflexive ())
          (#pt-app (#pt-use eisenstein-power ()) number (#pt-numeral 3)))))))
(#theorem eisenstein-signed-cubic-absorption
  (#universes)
  (#parameters
    (#parameter other (#pt-use eisenstein ()))
    (#parameter second-root (#pt-use eisenstein ()))
    (#parameter coefficient (#pt-use eisenstein ()))
    (#parameter right-value (#pt-use eisenstein ()))
    (#parameter coefficient-sign (#pt-app (#pt-use disjunction ()) (#pt-app (#pt-use eisenstein-equal ()) coefficient (#pt-use eisenstein-one ())) (#pt-app (#pt-use eisenstein-equal ()) coefficient (#pt-app (#pt-use eisenstein-negate ()) (#pt-use eisenstein-one ())))))
    (#parameter normalized-equation (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-add ()) (#pt-app (#pt-use eisenstein-power ()) other (#pt-numeral 3)) (#pt-app (#pt-use eisenstein-multiply ()) coefficient (#pt-app (#pt-use eisenstein-power ()) second-root (#pt-numeral 3)))) right-value)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app (#pt-use eisenstein-power ()) other (#pt-numeral 3))
        (#pt-app
          (#pt-use eisenstein-power ())
          (#pt-app (#pt-use eisenstein-multiply ()) coefficient second-root)
          (#pt-numeral 3)))
      right-value))
  (#proof
    (#pt-app
      (#pt-use eisenstein-transitive ())
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app (#pt-use eisenstein-power ()) other (#pt-numeral 3))
        (#pt-app
          (#pt-use eisenstein-power ())
          (#pt-app (#pt-use eisenstein-multiply ()) coefficient second-root)
          (#pt-numeral 3)))
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app (#pt-use eisenstein-power ()) other (#pt-numeral 3))
        (#pt-app
          (#pt-use eisenstein-multiply ())
          coefficient
          (#pt-app (#pt-use eisenstein-power ()) second-root (#pt-numeral 3))))
      right-value
      (#pt-app
        (#pt-use eisenstein-add-congruent ())
        (#pt-app (#pt-use eisenstein-power ()) other (#pt-numeral 3))
        (#pt-app
          (#pt-use eisenstein-power ())
          (#pt-app (#pt-use eisenstein-multiply ()) coefficient second-root)
          (#pt-numeral 3))
        (#pt-app (#pt-use eisenstein-power ()) other (#pt-numeral 3))
        (#pt-app
          (#pt-use eisenstein-multiply ())
          coefficient
          (#pt-app (#pt-use eisenstein-power ()) second-root (#pt-numeral 3)))
        (#pt-app
          (#pt-use eisenstein-reflexive ())
          (#pt-app (#pt-use eisenstein-power ()) other (#pt-numeral 3)))
        (#pt-app
          (#pt-use eisenstein-signed-coefficient-product-cube ())
          coefficient
          second-root
          coefficient-sign))
      normalized-equation)))
(#theorem eisenstein-unit-product-nondivisor
  (#universes)
  (#parameters
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter coefficient (#pt-use eisenstein ()))
    (#parameter number (#pt-use eisenstein ()))
    (#parameter unit-certificate (#pt-app (#pt-use eisenstein-unit ()) coefficient))
    (#parameter number-free (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) divisor number))) #pt-false)))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use eisenstein-divides ())
            divisor
            (#pt-app (#pt-use eisenstein-multiply ()) coefficient number))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (product-divided
          (#pt-app
            (#pt-use eisenstein-divides ())
            divisor
            (#pt-app (#pt-use eisenstein-multiply ()) coefficient number))))
      (#pt-app
        number-free
        (#pt-app
          (#pt-use eisenstein-unit-divisibility-reflect ())
          divisor
          coefficient
          number
          unit-certificate
          product-divided)))))
(#theorem eisenstein-coprime-unit-product-right
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter other (#pt-use eisenstein ()))
    (#parameter coefficient (#pt-use eisenstein ()))
    (#parameter coprime-certificate (#pt-app (#pt-use eisenstein-coprime ()) number other))
    (#parameter unit-certificate (#pt-app (#pt-use eisenstein-unit ()) coefficient)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-coprime ())
      number
      (#pt-app (#pt-use eisenstein-multiply ()) coefficient other)))
  (#proof
    (#pt-app
      (#pt-use eisenstein-coprime-of-common-divisors-unit ())
      number
      (#pt-app (#pt-use eisenstein-multiply ()) coefficient other)
      (#pt-lambda
        (
          (divisor (#pt-use eisenstein ()))
          (first-divides (#pt-app (#pt-use eisenstein-divides ()) divisor number))
          (product-divides
            (#pt-app
              (#pt-use eisenstein-divides ())
              divisor
              (#pt-app (#pt-use eisenstein-multiply ()) coefficient other))))
        (#pt-app
          (#pt-use eisenstein-coprime-common-divisor-unit ())
          number
          other
          divisor
          coprime-certificate
          first-divides
          (#pt-app
            (#pt-use eisenstein-unit-divisibility-reflect ())
            divisor
            coefficient
            other
            unit-certificate
            product-divides))))))
