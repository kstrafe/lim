(#math-definition ring-evaluation ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (Image (#pt-type 0))
      (image-ring (#pt-app (#pt-use commutative-ring ()) Image))
      (coefficient-morphism
        (#pt-app (#pt-use ring-evaluation-morphism ()) Carrier coefficient-ring Image image-ring))
      (evaluation-point Image)
      (polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
    Image)
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (Image (#pt-type 0))
      (image-ring (#pt-app (#pt-use commutative-ring ()) Image))
      (coefficient-morphism
        (#pt-app (#pt-use ring-evaluation-morphism ()) Carrier coefficient-ring Image image-ring))
      (evaluation-point Image)
      (polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
    (#pt-induct
      finite-list
      ()
      (Carrier)
      (#pt-lambda ((evaluation-subject (#pt-app (#pt-use finite-list ()) Carrier))) Image)
      (
        (#pt-app (#pt-use ring-zero ()) Image image-ring)
        (#pt-lambda
          ((head Carrier) (tail (#pt-app (#pt-use finite-list ()) Carrier)) (tail-result Image))
          (#pt-app
            (#pt-use ring-add ())
            Image
            image-ring
            (#pt-app
              (#pt-use ring-evaluation-map ())
              Carrier
              coefficient-ring
              Image
              image-ring
              coefficient-morphism
              head)
            (#pt-app (#pt-use ring-multiply ()) Image image-ring evaluation-point tail-result))))
      polynomial)))
