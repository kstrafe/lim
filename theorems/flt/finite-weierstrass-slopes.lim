      (first-y (#pt-app (#pt-use finite-residue ()) modulus))
      (second-y (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-app
      (#pt-use finite-residue-choice ())
      modulus
      positive-modulus
      (#pt-eq
        #pt-nat
        (#pt-project finite-residue 0 first-x)
        (#pt-project finite-residue 0 second-x))
      (#pt-app
        (#pt-use decide-equality ())
        (#pt-project finite-residue 0 first-x)
        (#pt-project finite-residue 0 second-x))
      (#pt-app
        (#pt-use finite-residue-choice ())
        modulus
        positive-modulus
        (#pt-eq
          #pt-nat
          (#pt-project finite-residue 0 first-y)
          (#pt-project
            finite-residue
            0
            (#pt-app
              (#pt-use finite-weierstrass-neg-y ())
              modulus
              positive-modulus
              curve
              second-x
              second-y)))
        (#pt-app
          (#pt-use decide-equality ())
          (#pt-project finite-residue 0 first-y)
          (#pt-project
            finite-residue
            0
            (#pt-app
              (#pt-use finite-weierstrass-neg-y ())
              modulus
              positive-modulus
              curve
              second-x
              second-y)))
        (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)
        (#pt-app
          (#pt-use finite-residue-divide ())
          modulus
          positive-modulus
          (#pt-app
