        (#pt-app (#pt-use finite-residue-difference ()) modulus positive-modulus first-y second-y)
        (#pt-app (#pt-use finite-residue-difference ()) modulus positive-modulus first-x second-x)))))
(#theorem finite-weierstrass-slope-secant
  (#universes)
