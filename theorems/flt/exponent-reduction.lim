    (#parameter second #pt-nat)
    (#parameter third #pt-nat)
    (#parameter outer-exponent #pt-nat)
    (#parameter inner-exponent #pt-nat)
    (#parameter equation (#pt-eq #pt-nat (#pt-app (#pt-use add ()) (#pt-app (#pt-use power ()) first (#pt-app (#pt-use multiply ()) outer-exponent inner-exponent)) (#pt-app (#pt-use power ()) second (#pt-app (#pt-use multiply ()) outer-exponent inner-exponent))) (#pt-app (#pt-use power ()) third (#pt-app (#pt-use multiply ()) outer-exponent inner-exponent)))))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app
        (#pt-use add ())
        (#pt-app
          (#pt-use power ())
          (#pt-app (#pt-use power ()) first inner-exponent)
          outer-exponent)
        (#pt-app
          (#pt-use power ())
          (#pt-app (#pt-use power ()) second inner-exponent)
          outer-exponent))
      (#pt-app (#pt-use power ()) (#pt-app (#pt-use power ()) third inner-exponent) outer-exponent)))
  (#proof
    (#pt-app
      (#pt-use transitivity (0))
      #pt-nat
      (#pt-app
        (#pt-use add ())
        (#pt-app
          (#pt-use power ())
          (#pt-app (#pt-use power ()) first inner-exponent)
          outer-exponent)
        (#pt-app
          (#pt-use power ())
          (#pt-app (#pt-use power ()) second inner-exponent)
          outer-exponent))
      (#pt-app
        (#pt-use add ())
        (#pt-app
          (#pt-use power ())
          first
          (#pt-app (#pt-use multiply ()) outer-exponent inner-exponent))
        (#pt-app
          (#pt-use power ())
          second
          (#pt-app (#pt-use multiply ()) outer-exponent inner-exponent)))
      (#pt-app (#pt-use power ()) (#pt-app (#pt-use power ()) third inner-exponent) outer-exponent)
      (#pt-app
        (#pt-use symmetry (0))
        #pt-nat
        (#pt-app
          (#pt-use add ())
          (#pt-app
            (#pt-use power ())
            first
            (#pt-app (#pt-use multiply ()) outer-exponent inner-exponent))
          (#pt-app
            (#pt-use power ())
            second
            (#pt-app (#pt-use multiply ()) outer-exponent inner-exponent)))
        (#pt-app
          (#pt-use add ())
          (#pt-app
            (#pt-use power ())
            (#pt-app (#pt-use power ()) first inner-exponent)
            outer-exponent)
          (#pt-app
            (#pt-use power ())
            (#pt-app (#pt-use power ()) second inner-exponent)
            outer-exponent))
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          (#pt-app
            (#pt-use add ())
            (#pt-app
              (#pt-use power ())
              first
              (#pt-app (#pt-use multiply ()) outer-exponent inner-exponent))
            (#pt-app
              (#pt-use power ())
              second
              (#pt-app (#pt-use multiply ()) outer-exponent inner-exponent)))
          (#pt-app
            (#pt-use add ())
            (#pt-app
              (#pt-use power ())
              (#pt-app (#pt-use power ()) first inner-exponent)
              outer-exponent)
            (#pt-app
              (#pt-use power ())
              second
              (#pt-app (#pt-use multiply ()) outer-exponent inner-exponent)))
          (#pt-app
