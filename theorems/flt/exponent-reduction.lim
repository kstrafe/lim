; Direct FLT source port: regroup a hypothetical power equation.
; This is the exponent-rewrite part of FermatLastTheoremFor.mono.
; It proves no exponent case of FLT and does not assume FLT as an axiom.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias power = ../fermat_statement.lim::power)
(#alias symmetry = ./equality.lim::symmetry)
