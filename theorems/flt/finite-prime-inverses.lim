(#math-definition finite-residue-nonzero ()
  (#pt-pi ((modulus #pt-nat) (element (#pt-app (#pt-use finite-residue ()) modulus))) #pt-prop)
  (#pt-lambda
    ((modulus #pt-nat) (element (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-pi
      ((denied-proof (#pt-eq #pt-nat (#pt-project finite-residue 0 element) #pt-zero)))
      #pt-false)))
(#theorem modular-prime-positive
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter prime-proof (#pt-app (#pt-use prime ()) modulus)))
  (#statement (#pt-app (#pt-use less-than ()) #pt-zero modulus))
  (#proof
    (#pt-app
      (#pt-use less-than-transitive ())
      #pt-zero
      (#pt-succ #pt-zero)
      modulus
      (#pt-app (#pt-use zero-less-successor ()) #pt-zero)
      (#pt-app (#pt-use prime-larger-than-one ()) modulus prime-proof))))
(#theorem finite-prime-residue-coprime
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) modulus))
    (#parameter element (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter nonzero-proof (#pt-app (#pt-use finite-residue-nonzero ()) modulus element)))
  (#statement (#pt-app (#pt-use coprime ()) (#pt-project finite-residue 0 element) modulus))
  (#proof
    (#pt-app
      (#pt-use coprime-symmetric ())
      modulus
      (#pt-project finite-residue 0 element)
      (#pt-app
        (#pt-use prime-coprime-of-not-divides ())
        modulus
        (#pt-project finite-residue 0 element)
        prime-proof
        (#pt-lambda
          (
            (divisor-certificate
              (#pt-app (#pt-use divides ()) modulus (#pt-project finite-residue 0 element))))
          (#pt-app
            (#pt-app
              (#pt-use divisor-not-above ())
              modulus
              (#pt-project finite-residue 0 element)
              nonzero-proof
              divisor-certificate)
            (#pt-project finite-residue 1 element)))))))
(#theorem finite-prime-inverse-product
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) modulus))
    (#parameter element (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter nonzero-proof (#pt-app (#pt-use finite-residue-nonzero ()) modulus element)))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-residue-multiply ())
          modulus
          positive-modulus
          element
          (#pt-app (#pt-use finite-residue-inverse ()) modulus positive-modulus element)))
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-one ()) modulus positive-modulus))))
  (#proof
    (#pt-app
      (#pt-use finite-residue-inverse-coprime-product ())
      modulus
      positive-modulus
      element
      (#pt-app
        (#pt-use finite-prime-residue-coprime ())
        modulus
        positive-modulus
        prime-proof
        element
        nonzero-proof))))
