    (#pt-lambda
      (
        (zero-one-equation
          (#pt-eq
            #pt-nat
            (#pt-project
              finite-residue
              0
              (#pt-app (#pt-use finite-residue-one ()) modulus positive-modulus))
            #pt-zero)))
      (#pt-app
        (#pt-app (#pt-use successor-not-zero ()) #pt-zero)
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          (#pt-succ #pt-zero)
          (#pt-project
            finite-residue
            0
            (#pt-app (#pt-use finite-residue-one ()) modulus positive-modulus))
          #pt-zero
