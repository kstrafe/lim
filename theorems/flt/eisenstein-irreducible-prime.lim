  ./eisenstein-additive-divisibility.lim::eisenstein-unit-divisibility-reflect)
(#alias
  eisenstein-divides-transitive
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-transitive)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#alias eisenstein-coprime = ./eisenstein-defs.lim::eisenstein-coprime)
(#alias disjunction-left = ./logical-connectives.lim::disjunction-left)
(#alias disjunction-right = ./logical-connectives.lim::disjunction-right)
(#alias
  eisenstein-multiply-cancel-first
  =
  ./eisenstein-domain.lim::eisenstein-multiply-cancel-first)
(#alias eisenstein-lambda-prime = ./eisenstein-lambda-prime.lim::eisenstein-lambda-prime)
(#math-definition eisenstein-irreducible ()
  (#pt-pi ((number (#pt-use eisenstein ()))) #pt-prop)
  (#pt-lambda
    ((number (#pt-use eisenstein ())))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-pi
        ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ()))))
        #pt-false)
      (#pt-app
        (#pt-use conjunction ())
        (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) number))) #pt-false)
        (#pt-pi
          (
            (candidate-first (#pt-use eisenstein ()))
            (candidate-second (#pt-use eisenstein ()))
            (factorization
              (#pt-app
                (#pt-use eisenstein-equal ())
                number
                (#pt-app (#pt-use eisenstein-multiply ()) candidate-first candidate-second))))
          (#pt-app
            (#pt-use disjunction ())
            (#pt-app (#pt-use eisenstein-unit ()) candidate-first)
            (#pt-app (#pt-use eisenstein-unit ()) candidate-second)))))))
(#theorem eisenstein-irreducible-divisor-unit-or-associated
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter irreducible-proof (#pt-app (#pt-use eisenstein-irreducible ()) number))
    (#parameter divides-number (#pt-app (#pt-use eisenstein-divides ()) divisor number)))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app (#pt-use eisenstein-unit ()) divisor)
      (#pt-app (#pt-use eisenstein-divides ()) number divisor)))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            number
            (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  number
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))))
        (#pt-app
          (#pt-use disjunction ())
          (#pt-app (#pt-use eisenstein-unit ()) divisor)
          (#pt-app (#pt-use eisenstein-divides ()) number divisor)))
      (
        (#pt-lambda
          (
            (cofactor (#pt-use eisenstein ()))
            (factor-equivalence
              (#pt-app
                (#pt-use eisenstein-equal ())
                number
                (#pt-app (#pt-use eisenstein-multiply ()) divisor cofactor))))
          (#pt-app
            (#pt-use disjunction-eliminate ())
            (#pt-app (#pt-use eisenstein-unit ()) divisor)
            (#pt-app (#pt-use eisenstein-unit ()) cofactor)
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app (#pt-use eisenstein-unit ()) divisor)
              (#pt-app (#pt-use eisenstein-divides ()) number divisor))
            (#pt-lambda
              ((divisor-unit (#pt-app (#pt-use eisenstein-unit ()) divisor)))
              (#pt-app
                (#pt-use disjunction-left ())
                (#pt-app (#pt-use eisenstein-unit ()) divisor)
                (#pt-app (#pt-use eisenstein-divides ()) number divisor)
                divisor-unit))
            (#pt-lambda
              ((cofactor-unit (#pt-app (#pt-use eisenstein-unit ()) cofactor)))
              (#pt-app
                (#pt-use disjunction-right ())
                (#pt-app (#pt-use eisenstein-unit ()) divisor)
                (#pt-app (#pt-use eisenstein-divides ()) number divisor)
                (#pt-app
                  (#pt-use eisenstein-unit-divisibility-reflect ())
                  number
                  cofactor
                  divisor
                  cofactor-unit
                  (#pt-app
                    (#pt-use eisenstein-divides-congruent-target ())
                    number
                    (#pt-app (#pt-use eisenstein-multiply ()) divisor cofactor)
                    (#pt-app (#pt-use eisenstein-multiply ()) cofactor divisor)
                    (#pt-app (#pt-use eisenstein-multiply-commutative ()) divisor cofactor)
                    (#pt-app
                      (#pt-use eisenstein-divides-congruent-target ())
                      number
                      number
                      (#pt-app (#pt-use eisenstein-multiply ()) divisor cofactor)
                      factor-equivalence
                      (#pt-app (#pt-use eisenstein-divides-reflexive ()) number))))))
            (#pt-app
              (#pt-app
                (#pt-use conjunction-right ())
                (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) number))) #pt-false)
                (#pt-pi
                  (
                    (candidate-first (#pt-use eisenstein ()))
                    (candidate-second (#pt-use eisenstein ()))
                    (factorization
                      (#pt-app
                        (#pt-use eisenstein-equal ())
                        number
                        (#pt-app (#pt-use eisenstein-multiply ()) candidate-first candidate-second))))
                  (#pt-app
                    (#pt-use disjunction ())
                    (#pt-app (#pt-use eisenstein-unit ()) candidate-first)
                    (#pt-app (#pt-use eisenstein-unit ()) candidate-second)))
                (#pt-app
                  (#pt-use conjunction-right ())
                  (#pt-pi
                    (
                      (denied-proof
                        (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ()))))
                    #pt-false)
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-pi
                      ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) number)))
                      #pt-false)
                    (#pt-pi
                      (
                        (candidate-first (#pt-use eisenstein ()))
                        (candidate-second (#pt-use eisenstein ()))
                        (factorization
                          (#pt-app
                            (#pt-use eisenstein-equal ())
                            number
                            (#pt-app
                              (#pt-use eisenstein-multiply ())
                              candidate-first
                              candidate-second))))
                      (#pt-app
                        (#pt-use disjunction ())
                        (#pt-app (#pt-use eisenstein-unit ()) candidate-first)
                        (#pt-app (#pt-use eisenstein-unit ()) candidate-second))))
                  irreducible-proof))
              divisor
              cofactor
              factor-equivalence))))
      divides-number)))
(#theorem eisenstein-irreducible-coprime-of-not-divides
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter other (#pt-use eisenstein ()))
    (#parameter irreducible-proof (#pt-app (#pt-use eisenstein-irreducible ()) number))
    (#parameter number-not-divides (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) number other))) #pt-false)))
  (#statement (#pt-app (#pt-use eisenstein-coprime ()) number other))
  (#proof
    (#pt-app
      (#pt-use eisenstein-coprime-of-common-divisors-unit ())
      number
      other
      (#pt-lambda
        (
          (common-divisor (#pt-use eisenstein ()))
          (divides-first (#pt-app (#pt-use eisenstein-divides ()) common-divisor number))
          (divides-second (#pt-app (#pt-use eisenstein-divides ()) common-divisor other)))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-app (#pt-use eisenstein-unit ()) common-divisor)
          (#pt-app (#pt-use eisenstein-divides ()) number common-divisor)
          (#pt-app (#pt-use eisenstein-unit ()) common-divisor)
          (#pt-lambda
            ((divisor-unit (#pt-app (#pt-use eisenstein-unit ()) common-divisor)))
            divisor-unit)
          (#pt-lambda
            (
              (number-divides-divisor
                (#pt-app (#pt-use eisenstein-divides ()) number common-divisor)))
            (#pt-app
              (#pt-use false-elimination ())
              (#pt-app (#pt-use eisenstein-unit ()) common-divisor)
              (#pt-app
                number-not-divides
                (#pt-app
                  (#pt-use eisenstein-divides-transitive ())
                  number
                  common-divisor
                  other
                  number-divides-divisor
                  divides-second))))
          (#pt-app
            (#pt-use eisenstein-irreducible-divisor-unit-or-associated ())
            number
            common-divisor
            irreducible-proof
            divides-first))))))
(#theorem eisenstein-irreducible-prime
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter irreducible-proof (#pt-app (#pt-use eisenstein-irreducible ()) number)))
  (#statement (#pt-app (#pt-use eisenstein-prime ()) number))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-pi
        ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ()))))
        #pt-false)
      (#pt-app
        (#pt-use conjunction ())
        (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) number))) #pt-false)
        (#pt-pi
          (
            (candidate-first (#pt-use eisenstein ()))
            (candidate-second (#pt-use eisenstein ()))
            (product-evidence
              (#pt-app
                (#pt-use eisenstein-divides ())
                number
                (#pt-app (#pt-use eisenstein-multiply ()) candidate-first candidate-second))))
          (#pt-app
            (#pt-use disjunction ())
            (#pt-app (#pt-use eisenstein-divides ()) number candidate-first)
            (#pt-app (#pt-use eisenstein-divides ()) number candidate-second))))
      (#pt-app
        (#pt-use conjunction-left ())
        (#pt-pi
          (
            (denied-proof
              (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ()))))
          #pt-false)
        (#pt-app
          (#pt-use conjunction ())
          (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) number))) #pt-false)
          (#pt-pi
            (
              (candidate-first (#pt-use eisenstein ()))
              (candidate-second (#pt-use eisenstein ()))
              (factorization
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  number
                  (#pt-app (#pt-use eisenstein-multiply ()) candidate-first candidate-second))))
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app (#pt-use eisenstein-unit ()) candidate-first)
              (#pt-app (#pt-use eisenstein-unit ()) candidate-second))))
        irreducible-proof)
      (#pt-app
        (#pt-use conjunction-introduce ())
        (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) number))) #pt-false)
        (#pt-pi
          (
            (candidate-first (#pt-use eisenstein ()))
            (candidate-second (#pt-use eisenstein ()))
            (product-evidence
              (#pt-app
                (#pt-use eisenstein-divides ())
                number
                (#pt-app (#pt-use eisenstein-multiply ()) candidate-first candidate-second))))
          (#pt-app
            (#pt-use disjunction ())
            (#pt-app (#pt-use eisenstein-divides ()) number candidate-first)
            (#pt-app (#pt-use eisenstein-divides ()) number candidate-second)))
        (#pt-app
          (#pt-use conjunction-left ())
          (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) number))) #pt-false)
          (#pt-pi
            (
              (candidate-first (#pt-use eisenstein ()))
              (candidate-second (#pt-use eisenstein ()))
              (factorization
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  number
                  (#pt-app (#pt-use eisenstein-multiply ()) candidate-first candidate-second))))
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app (#pt-use eisenstein-unit ()) candidate-first)
              (#pt-app (#pt-use eisenstein-unit ()) candidate-second)))
          (#pt-app
            (#pt-use conjunction-right ())
            (#pt-pi
              (
                (denied-proof
                  (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ()))))
              #pt-false)
            (#pt-app
              (#pt-use conjunction ())
              (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) number))) #pt-false)
              (#pt-pi
                (
                  (candidate-first (#pt-use eisenstein ()))
                  (candidate-second (#pt-use eisenstein ()))
                  (factorization
                    (#pt-app
                      (#pt-use eisenstein-equal ())
                      number
                      (#pt-app (#pt-use eisenstein-multiply ()) candidate-first candidate-second))))
                (#pt-app
                  (#pt-use disjunction ())
                  (#pt-app (#pt-use eisenstein-unit ()) candidate-first)
                  (#pt-app (#pt-use eisenstein-unit ()) candidate-second))))
            irreducible-proof))
        (#pt-lambda
          (
            (first (#pt-use eisenstein ()))
            (second (#pt-use eisenstein ()))
            (product-evidence
              (#pt-app
                (#pt-use eisenstein-divides ())
                number
                (#pt-app (#pt-use eisenstein-multiply ()) first second))))
          (#pt-app
            (#pt-use disjunction-eliminate ())
            (#pt-app (#pt-use eisenstein-divides ()) number first)
            (#pt-pi
              ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) number first)))
              #pt-false)
            (#pt-app
              (#pt-use disjunction ())
              (#pt-app (#pt-use eisenstein-divides ()) number first)
              (#pt-app (#pt-use eisenstein-divides ()) number second))
            (#pt-lambda
              ((divides-first (#pt-app (#pt-use eisenstein-divides ()) number first)))
              (#pt-app
                (#pt-use disjunction-left ())
                (#pt-app (#pt-use eisenstein-divides ()) number first)
                (#pt-app (#pt-use eisenstein-divides ()) number second)
                divides-first))
            (#pt-lambda
              (
                (not-divides-first
                  (#pt-pi
                    ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) number first)))
                    #pt-false)))
              (#pt-app
                (#pt-use disjunction-right ())
                (#pt-app (#pt-use eisenstein-divides ()) number first)
                (#pt-app (#pt-use eisenstein-divides ()) number second)
                (#pt-app
                  (#pt-use eisenstein-coprime-divides-product ())
                  number
                  first
                  second
                  (#pt-app
                    (#pt-use eisenstein-irreducible-coprime-of-not-divides ())
                    number
                    first
                    irreducible-proof
                    not-divides-first)
                  product-evidence)))
            (#pt-app
              (#pt-use eisenstein-divisibility-cases-nonzero ())
              number
              first
              (#pt-app
                (#pt-use conjunction-left ())
                (#pt-pi
                  (
                    (denied-proof
                      (#pt-app (#pt-use eisenstein-equal ()) number (#pt-use eisenstein-zero ()))))
                  #pt-false)
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) number))) #pt-false)
                  (#pt-pi
                    (
                      (candidate-first (#pt-use eisenstein ()))
                      (candidate-second (#pt-use eisenstein ()))
                      (factorization
                        (#pt-app
                          (#pt-use eisenstein-equal ())
                          number
                          (#pt-app
                            (#pt-use eisenstein-multiply ())
                            candidate-first
                            candidate-second))))
                    (#pt-app
                      (#pt-use disjunction ())
                      (#pt-app (#pt-use eisenstein-unit ()) candidate-first)
                      (#pt-app (#pt-use eisenstein-unit ()) candidate-second))))
                irreducible-proof))))))))
(#theorem eisenstein-prime-factorization-unit-cofactor
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter prime-proof (#pt-app (#pt-use eisenstein-prime ()) number))
    (#parameter factorization (#pt-app (#pt-use eisenstein-equal ()) number (#pt-app (#pt-use eisenstein-multiply ()) first second)))
    (#parameter divides-first (#pt-app (#pt-use eisenstein-divides ()) number first)))
  (#statement (#pt-app (#pt-use eisenstein-unit ()) second))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            first
            (#pt-app (#pt-use eisenstein-multiply ()) number candidate-factor))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  first
                  (#pt-app (#pt-use eisenstein-multiply ()) number candidate-factor))))))
        (#pt-app (#pt-use eisenstein-unit ()) second))
      (
        (#pt-lambda
          (
            (cofactor (#pt-use eisenstein ()))
            (first-factor-equivalence
              (#pt-app
                (#pt-use eisenstein-equal ())
                first
                (#pt-app (#pt-use eisenstein-multiply ()) number cofactor))))
          (#pt-app
            (#pt-use eisenstein-unit-of-divides-one ())
            second
            (#pt-construct
              exists
              (0)
              (
                (#pt-use eisenstein ())
                (#pt-lambda
                  ((candidate-factor (#pt-use eisenstein ())))
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-use eisenstein-one ())
                    (#pt-app (#pt-use eisenstein-multiply ()) second candidate-factor))))
              introduce
              (cofactor
                (#pt-app
                  (#pt-use eisenstein-transitive ())
                  (#pt-use eisenstein-one ())
                  (#pt-app (#pt-use eisenstein-multiply ()) cofactor second)
                  (#pt-app (#pt-use eisenstein-multiply ()) second cofactor)
                  (#pt-app
                    (#pt-use eisenstein-multiply-cancel-first ())
                    number
                    (#pt-use eisenstein-one ())
                    (#pt-app (#pt-use eisenstein-multiply ()) cofactor second)
                    (#pt-app
                      (#pt-use conjunction-left ())
                      (#pt-pi
                        (
                          (denied-proof
                            (#pt-app
                              (#pt-use eisenstein-equal ())
                              number
                              (#pt-use eisenstein-zero ()))))
                        #pt-false)
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-pi
                          ((denied-proof (#pt-app (#pt-use eisenstein-unit ()) number)))
                          #pt-false)
                        (#pt-pi
                          (
                            (candidate-first (#pt-use eisenstein ()))
                            (candidate-second (#pt-use eisenstein ()))
                            (product-evidence
                              (#pt-app
                                (#pt-use eisenstein-divides ())
                                number
                                (#pt-app
                                  (#pt-use eisenstein-multiply ())
                                  candidate-first
                                  candidate-second))))
                          (#pt-app
                            (#pt-use disjunction ())
                            (#pt-app (#pt-use eisenstein-divides ()) number candidate-first)
                            (#pt-app (#pt-use eisenstein-divides ()) number candidate-second))))
                      prime-proof)
                    (#pt-app
                      (#pt-use eisenstein-transitive ())
                      (#pt-app (#pt-use eisenstein-multiply ()) number (#pt-use eisenstein-one ()))
                      number
                      (#pt-app
                        (#pt-use eisenstein-multiply ())
                        number
                        (#pt-app (#pt-use eisenstein-multiply ()) cofactor second))
                      (#pt-app (#pt-use eisenstein-multiply-one ()) number)
                      (#pt-app
                        (#pt-use eisenstein-transitive ())
                        number
                        (#pt-app (#pt-use eisenstein-multiply ()) first second)
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          number
                          (#pt-app (#pt-use eisenstein-multiply ()) cofactor second))
                        factorization
                        (#pt-app
                          (#pt-use eisenstein-transitive ())
                          (#pt-app (#pt-use eisenstein-multiply ()) first second)
                          (#pt-app
                            (#pt-use eisenstein-multiply ())
                            (#pt-app (#pt-use eisenstein-multiply ()) number cofactor)
                            second)
                          (#pt-app
                            (#pt-use eisenstein-multiply ())
                            number
                            (#pt-app (#pt-use eisenstein-multiply ()) cofactor second))
                          (#pt-app
                            (#pt-use eisenstein-multiply-congruent ())
                            first
                            second
                            (#pt-app (#pt-use eisenstein-multiply ()) number cofactor)
                            second
                            first-factor-equivalence
                            (#pt-app (#pt-use eisenstein-reflexive ()) second))
                          (#pt-app
                            (#pt-use eisenstein-multiply-associative ())
                            number
                            cofactor
                            second)))))
                  (#pt-app (#pt-use eisenstein-multiply-commutative ()) cofactor second)))))))
      divides-first)))
(#theorem eisenstein-prime-irreducible
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter prime-proof (#pt-app (#pt-use eisenstein-prime ()) number)))
  (#statement (#pt-app (#pt-use eisenstein-irreducible ()) number))
  (#proof
    (#pt-app
