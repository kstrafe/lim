; Adapted source: pinned Mathlib Affine/Point.lean:409-470.
; All polynomial, coefficient-domain and index facts are proved.
; Generated by scripts/generate-flt-norm-degrees.py; checked native terms.
; A zero norm cannot have a leading degree. A proved
; norm degree distinct from1 contradicts a claimed degree1 by the
; actual leading-degree uniqueness theorem.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias
  coordinate-norm-degree-value
  =
  ./coordinate-norm-degree-formula.lim::coordinate-norm-degree-value)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias
  ring-polynomial-degree-nonzero
  =
  ./ring-polynomial-degree-leading.lim::ring-polynomial-degree-nonzero)
(#alias
  ring-polynomial-degree-unique
  =
  ./ring-polynomial-degree-uniqueness.lim::ring-polynomial-degree-unique)
(#alias
  ring-polynomial-degree-witness
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-degree-witness)
(#alias ring-polynomial-equal = ./ring-polynomial-data.lim::ring-polynomial-equal)
(#theorem coordinate-norm-degree-contradict-zero
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter zero-norm (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring (#pt-app (#pt-use coordinate-norm-degree-value ()) Carrier coefficient-ring a1 a2 a3 a4 a6 polynomial other-polynomial) (#pt-construct finite-list () (Carrier) nil ())))
    (#parameter degree-one-certificate (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring (#pt-app (#pt-use coordinate-norm-degree-value ()) Carrier coefficient-ring a1 a2 a3 a4 a6 polynomial other-polynomial) (#pt-numeral 1))))
  (#statement #pt-false)
  (#proof
    (#pt-app
      (#pt-app
        (#pt-use ring-polynomial-degree-nonzero ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use coordinate-norm-degree-value ())
          Carrier
          coefficient-ring
          a1
          a2
          a3
          a4
          a6
          polynomial
          other-polynomial)
        (#pt-numeral 1)
        degree-one-certificate)
      zero-norm)))
(#theorem coordinate-norm-degree-contradict-leading
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter leading-degree #pt-nat)
    (#parameter norm-degree (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring (#pt-app (#pt-use coordinate-norm-degree-value ()) Carrier coefficient-ring a1 a2 a3 a4 a6 polynomial other-polynomial) leading-degree))
    (#parameter not-one (#pt-pi ((denied-evidence (#pt-eq #pt-nat leading-degree (#pt-numeral 1)))) #pt-false))
    (#parameter degree-one-certificate (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring (#pt-app (#pt-use coordinate-norm-degree-value ()) Carrier coefficient-ring a1 a2 a3 a4 a6 polynomial other-polynomial) (#pt-numeral 1))))
  (#statement #pt-false)
  (#proof
    (#pt-app
      not-one
      (#pt-app
        (#pt-use ring-polynomial-degree-unique ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use coordinate-norm-degree-value ())
          Carrier
          coefficient-ring
          a1
          a2
          a3
          a4
          a6
          polynomial
          other-polynomial)
        leading-degree
        (#pt-numeral 1)
        norm-degree
        degree-one-certificate))))
