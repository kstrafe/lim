; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean.
; Generated by scripts/generate-flt-point-ideal-products.py; checked native terms.
; Prove actual point ideals with equal
; Y evaluation are equal in both directions. This is the
; source generator-change principle, valid over arbitrary
; checked rings and arbitrary finite Y-polynomial lists.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias
  coordinate-point-ideal-X-class
  =
  ./coordinate-point-ideal-data.lim::coordinate-point-ideal-X-class)
(#alias coordinate-point-ideal-XY = ./coordinate-point-ideal-data.lim::coordinate-point-ideal-XY)
(#alias
  coordinate-point-ideal-Y-class
  =
  ./coordinate-point-ideal-data.lim::coordinate-point-ideal-Y-class)
(#alias
  coordinate-point-ideal-contains-X
  =
  ./coordinate-point-ideal-membership.lim::coordinate-point-ideal-contains-X)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias
  point-ideal-product-same-value-generator
  =
  ./point-ideal-product-same-value-generator.lim::point-ideal-product-same-value-generator)
(#alias quadratic-constant = ./quadratic-algebra-data.lim::quadratic-constant)
(#alias quadratic-element = ./quadratic-algebra-data.lim::quadratic-element)
(#alias quadratic-ring-structure = ./quadratic-algebra-ring-structure.lim::quadratic-ring-structure)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-ideal-equal = ./ring-ideal-data.lim::ring-ideal-equal)
(#alias ring-ideal-pair-least = ./ring-ideal-pair.lim::ring-ideal-pair-least)
(#alias ring-ideal-subset = ./ring-ideal-data.lim::ring-ideal-subset)
(#alias ring-polynomial-evaluate = ./ring-polynomial-data.lim::ring-polynomial-evaluate)
(#alias ring-polynomial-structure = ./ring-polynomial-structure.lim::ring-polynomial-structure)
(#alias ring-symmetric = ./commutative-ring-data.lim::ring-symmetric)
(#theorem point-ideal-product-same-value-ideals
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter quadratic-linear (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter quadratic-constant (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter root Carrier)
    (#parameter first-Y-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter second-Y-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter value-equation (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring first-Y-polynomial root) (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring second-Y-polynomial root))))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
      (#pt-app
        (#pt-use quadratic-ring-structure ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        quadratic-linear
        quadratic-constant)
      (#pt-app
        (#pt-use coordinate-point-ideal-XY ())
        Carrier
        coefficient-ring
        quadratic-linear
        quadratic-constant
        root
        first-Y-polynomial)
      (#pt-app
        (#pt-use coordinate-point-ideal-XY ())
        Carrier
        coefficient-ring
        quadratic-linear
        quadratic-constant
        root
        second-Y-polynomial)))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-ideal-subset ())
        (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
        (#pt-app
          (#pt-use quadratic-ring-structure ())
          (#pt-app (#pt-use finite-list ()) Carrier)
          (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
          quadratic-linear
          quadratic-constant)
        (#pt-app
          (#pt-use coordinate-point-ideal-XY ())
          Carrier
          coefficient-ring
          quadratic-linear
          quadratic-constant
          root
          first-Y-polynomial)
        (#pt-app
          (#pt-use coordinate-point-ideal-XY ())
          Carrier
          coefficient-ring
          quadratic-linear
          quadratic-constant
          root
          second-Y-polynomial))
      (#pt-app
        (#pt-use ring-ideal-subset ())
        (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
        (#pt-app
          (#pt-use quadratic-ring-structure ())
          (#pt-app (#pt-use finite-list ()) Carrier)
          (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
          quadratic-linear
          quadratic-constant)
        (#pt-app
          (#pt-use coordinate-point-ideal-XY ())
          Carrier
          coefficient-ring
          quadratic-linear
          quadratic-constant
          root
          second-Y-polynomial)
        (#pt-app
          (#pt-use coordinate-point-ideal-XY ())
          Carrier
          coefficient-ring
          quadratic-linear
          quadratic-constant
          root
          first-Y-polynomial))
      (#pt-app
        (#pt-use ring-ideal-pair-least ())
        (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
        (#pt-app
          (#pt-use quadratic-ring-structure ())
          (#pt-app (#pt-use finite-list ()) Carrier)
          (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
          quadratic-linear
          quadratic-constant)
        (#pt-app (#pt-use coordinate-point-ideal-X-class ()) Carrier coefficient-ring root)
        (#pt-app
          (#pt-use coordinate-point-ideal-Y-class ())
          Carrier
          coefficient-ring
          first-Y-polynomial)
        (#pt-app
          (#pt-use coordinate-point-ideal-XY ())
          Carrier
          coefficient-ring
          quadratic-linear
          quadratic-constant
          root
          second-Y-polynomial)
        (#pt-app
          (#pt-use coordinate-point-ideal-contains-X ())
          Carrier
          coefficient-ring
          quadratic-linear
          quadratic-constant
          root
          second-Y-polynomial)
        (#pt-app
          (#pt-use point-ideal-product-same-value-generator ())
          Carrier
          coefficient-ring
          quadratic-linear
          quadratic-constant
          root
          first-Y-polynomial
          second-Y-polynomial
          value-equation))
      (#pt-app
        (#pt-use ring-ideal-pair-least ())
        (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
        (#pt-app
          (#pt-use quadratic-ring-structure ())
          (#pt-app (#pt-use finite-list ()) Carrier)
          (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
          quadratic-linear
          quadratic-constant)
        (#pt-app (#pt-use coordinate-point-ideal-X-class ()) Carrier coefficient-ring root)
        (#pt-app
          (#pt-use coordinate-point-ideal-Y-class ())
          Carrier
          coefficient-ring
          second-Y-polynomial)
        (#pt-app
          (#pt-use coordinate-point-ideal-XY ())
          Carrier
          coefficient-ring
          quadratic-linear
          quadratic-constant
          root
          first-Y-polynomial)
        (#pt-app
          (#pt-use coordinate-point-ideal-contains-X ())
          Carrier
          coefficient-ring
          quadratic-linear
          quadratic-constant
          root
          first-Y-polynomial)
        (#pt-app
          (#pt-use point-ideal-product-same-value-generator ())
          Carrier
          coefficient-ring
          quadratic-linear
          quadratic-constant
          root
          second-Y-polynomial
          first-Y-polynomial
          (#pt-app
            (#pt-use ring-symmetric ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-evaluate ())
              Carrier
              coefficient-ring
              first-Y-polynomial
              root)
            (#pt-app
              (#pt-use ring-polynomial-evaluate ())
              Carrier
              coefficient-ring
              second-Y-polynomial
              root)
            value-equation))))))
