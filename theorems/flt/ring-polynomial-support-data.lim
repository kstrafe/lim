; Adapted source: pinned Mathlib Algebra/Polynomial/Degree/Defs.lean
; and Degree/Operations.lean; Affine/Point.lean.
; Generated by scripts/generate-flt-polynomial-degrees.py; checked native terms.
; Explicit upper support bounds and leading-degree witnesses.
; Degree zero includes nonzero constants; the zero polynomial has no
; natural leading-degree witness. Bounds refer to every formal coefficient.
(#alias add = ./../fermat_statement.lim::add)
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias finite-list-length = ./finite-list-defs.lim::finite-list-length)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-polynomial-coefficient = ./ring-polynomial-data.lim::ring-polynomial-coefficient)
(#alias ring-polynomial-equal = ./ring-polynomial-data.lim::ring-polynomial-equal)
(#alias
  ring-polynomial-finite-support
  =
  ./ring-polynomial-finite-support.lim::ring-polynomial-finite-support)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#math-definition ring-polynomial-support-from ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (polynomial (#pt-app (#pt-use finite-list ()) Carrier))
      (support-bound #pt-nat))
    #pt-prop)
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (polynomial (#pt-app (#pt-use finite-list ()) Carrier))
      (support-bound #pt-nat))
    (#pt-pi
      ((offset #pt-nat))
      (#pt-app
        (#pt-use ring-equal ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-coefficient ())
          Carrier
          coefficient-ring
          polynomial
          (#pt-app (#pt-use add ()) support-bound offset))
        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))))
(#math-definition ring-polynomial-degree-witness ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (polynomial (#pt-app (#pt-use finite-list ()) Carrier))
      (degree #pt-nat))
    #pt-prop)
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (polynomial (#pt-app (#pt-use finite-list ()) Carrier))
      (degree #pt-nat))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-pi
        (
          (denied-evidence
            (#pt-app
              (#pt-use ring-equal ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-coefficient ())
                Carrier
                coefficient-ring
                polynomial
                degree)
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
        #pt-false)
      (#pt-app
        (#pt-use ring-polynomial-support-from ())
        Carrier
        coefficient-ring
        polynomial
        (#pt-succ degree)))))
(#theorem ring-polynomial-support-nil
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter support-bound #pt-nat))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-support-from ())
      Carrier
      coefficient-ring
      (#pt-construct finite-list () (Carrier) nil ())
      support-bound))
  (#proof
    (#pt-lambda
      ((offset #pt-nat))
      (#pt-app
        (#pt-use ring-reflexive ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))))
(#theorem ring-polynomial-support-zero-equivalent
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter support (#pt-app (#pt-use ring-polynomial-support-from ()) Carrier coefficient-ring polynomial #pt-zero)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-equal ())
      Carrier
      coefficient-ring
      polynomial
      (#pt-construct finite-list () (Carrier) nil ())))
  (#proof support))
(#theorem ring-polynomial-support-from-zero
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter support-bound #pt-nat)
    (#parameter zero-polynomial (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring polynomial (#pt-construct finite-list () (Carrier) nil ()))))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-support-from ())
      Carrier
      coefficient-ring
      polynomial
      support-bound))
  (#proof
    (#pt-lambda
      ((offset #pt-nat))
      (#pt-app zero-polynomial (#pt-app (#pt-use add ()) support-bound offset)))))
(#theorem ring-polynomial-support-length
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-support-from ())
      Carrier
      coefficient-ring
      polynomial
      (#pt-app (#pt-use finite-list-length ()) Carrier polynomial)))
  (#proof (#pt-app (#pt-use ring-polynomial-finite-support ()) Carrier coefficient-ring polynomial)))
