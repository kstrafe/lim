; Generated by scripts/generate-flt-point-ideal-basis.py; checked native terms.
; The actual point-ideal columns X-x,Y-y form
; the triangular matrix [[X-x,-y],[0,1]]. Compute coefficient
; candidates using actual linear root division. Its actual
; determinant is X-x, with no basis or membership assumption.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias
  coordinate-point-ideal-X-class
  =
  ./coordinate-point-ideal-data.lim::coordinate-point-ideal-X-class)
(#alias
  coordinate-point-ideal-Y-class
  =
  ./coordinate-point-ideal-data.lim::coordinate-point-ideal-Y-class)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias point-ideal-matrix-columns = ./point-ideal-matrix-columns.lim::point-ideal-matrix-columns)
(#alias polynomial-root-divisor = ./polynomial-root-division-data.lim::polynomial-root-divisor)
(#alias polynomial-root-quotient = ./polynomial-root-division-data.lim::polynomial-root-quotient)
(#alias quadratic-element = ./quadratic-algebra-data.lim::quadratic-element)
(#alias ring-matrix2 = ./ring-matrix2-data.lim::ring-matrix2)
(#alias ring-matrix2-determinant = ./ring-matrix2-data.lim::ring-matrix2-determinant)
(#alias ring-one = ./commutative-ring-data.lim::ring-one)
(#alias ring-polynomial-add = ./ring-polynomial-data.lim::ring-polynomial-add)
(#alias
  ring-polynomial-add-congruent
  =
  ./ring-polynomial-congruence.lim::ring-polynomial-add-congruent)
(#alias ring-polynomial-add-zero = ./ring-polynomial-additive-laws.lim::ring-polynomial-add-zero)
(#alias ring-polynomial-equal = ./ring-polynomial-data.lim::ring-polynomial-equal)
(#alias ring-polynomial-multiply = ./ring-polynomial-data.lim::ring-polynomial-multiply)
(#alias
  ring-polynomial-multiply-one
  =
  ./ring-polynomial-multiplicative-identities.lim::ring-polynomial-multiply-one)
(#alias
  ring-polynomial-multiply-zero
  =
  ./ring-polynomial-multiplicative-identities.lim::ring-polynomial-multiply-zero)
(#alias ring-polynomial-negate = ./ring-polynomial-data.lim::ring-polynomial-negate)
(#alias
  ring-polynomial-negate-congruent
  =
  ./ring-polynomial-congruence.lim::ring-polynomial-negate-congruent)
(#alias ring-polynomial-reflexive = ./ring-polynomial-equivalence.lim::ring-polynomial-reflexive)
(#alias ring-polynomial-structure = ./ring-polynomial-structure.lim::ring-polynomial-structure)
(#alias ring-polynomial-transitive = ./ring-polynomial-equivalence.lim::ring-polynomial-transitive)
(#math-definition point-ideal-basis-matrix ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (root Carrier)
      (Y-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
    (#pt-app (#pt-use ring-matrix2 ()) (#pt-app (#pt-use finite-list ()) Carrier)))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (root Carrier)
      (Y-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
    (#pt-app
      (#pt-use point-ideal-matrix-columns ())
      (#pt-app (#pt-use finite-list ()) Carrier)
      (#pt-app (#pt-use coordinate-point-ideal-X-class ()) Carrier coefficient-ring root)
      (#pt-app (#pt-use coordinate-point-ideal-Y-class ()) Carrier coefficient-ring Y-polynomial))))
(#math-definition point-ideal-basis-coordinates ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (root Carrier)
      (Y-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
      (coordinate-element
        (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))))
    (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier)))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (root Carrier)
      (Y-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
      (coordinate-element
        (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))))
    (#pt-construct
      quadratic-element
      ()
      ((#pt-app (#pt-use finite-list ()) Carrier))
      coordinates
      (
        (#pt-app
          (#pt-use polynomial-root-quotient ())
          Carrier
          coefficient-ring
          root
          (#pt-app
            (#pt-use ring-polynomial-add ())
            Carrier
            coefficient-ring
            (#pt-project quadratic-element 0 coordinate-element)
            (#pt-app
              (#pt-use ring-polynomial-multiply ())
              Carrier
              coefficient-ring
              Y-polynomial
              (#pt-project quadratic-element 1 coordinate-element))))
        (#pt-project quadratic-element 1 coordinate-element)))))
(#theorem point-ideal-basis-determinant
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter root Carrier)
    (#parameter Y-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-matrix2-determinant ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        (#pt-app (#pt-use point-ideal-basis-matrix ()) Carrier coefficient-ring root Y-polynomial))
      (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)))
  (#proof
    (#pt-app
      (#pt-use ring-polynomial-transitive ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-matrix2-determinant ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        (#pt-app (#pt-use point-ideal-basis-matrix ()) Carrier coefficient-ring root Y-polynomial))
      (#pt-app
        (#pt-use ring-polynomial-add ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
        (#pt-construct finite-list () (Carrier) nil ()))
      (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
      (#pt-app
        (#pt-use ring-polynomial-add-congruent ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-multiply ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
          (#pt-construct
            finite-list
            ()
            (Carrier)
            cons
            (
              (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
              (#pt-construct finite-list () (Carrier) nil ()))))
        (#pt-app
          (#pt-use ring-polynomial-negate ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-multiply ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use ring-polynomial-negate ()) Carrier coefficient-ring Y-polynomial)
            (#pt-construct finite-list () (Carrier) nil ())))
        (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
        (#pt-construct finite-list () (Carrier) nil ())
        (#pt-app
          (#pt-use ring-polynomial-multiply-one ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root))
        (#pt-app
          (#pt-use ring-polynomial-transitive ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-negate ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-multiply ())
              Carrier
              coefficient-ring
              (#pt-app (#pt-use ring-polynomial-negate ()) Carrier coefficient-ring Y-polynomial)
              (#pt-construct finite-list () (Carrier) nil ())))
          (#pt-app
            (#pt-use ring-polynomial-negate ())
            Carrier
            coefficient-ring
            (#pt-construct finite-list () (Carrier) nil ()))
          (#pt-construct finite-list () (Carrier) nil ())
          (#pt-app
            (#pt-use ring-polynomial-negate-congruent ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-multiply ())
              Carrier
              coefficient-ring
              (#pt-app (#pt-use ring-polynomial-negate ()) Carrier coefficient-ring Y-polynomial)
              (#pt-construct finite-list () (Carrier) nil ()))
            (#pt-construct finite-list () (Carrier) nil ())
            (#pt-app
              (#pt-use ring-polynomial-multiply-zero ())
              Carrier
              coefficient-ring
              (#pt-app (#pt-use ring-polynomial-negate ()) Carrier coefficient-ring Y-polynomial)))
          (#pt-app
            (#pt-use ring-polynomial-reflexive ())
            Carrier
            coefficient-ring
            (#pt-construct finite-list () (Carrier) nil ()))))
      (#pt-app
        (#pt-use ring-polynomial-add-zero ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)))))
