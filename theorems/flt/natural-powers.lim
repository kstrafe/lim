; Mathematical adaptation: see provenance.json and LICENSE.LEAN4.
; Direct mathematical source port, not a Lean export translation.
; Reference: Lean 4.33.1 Init/Data/Nat/Lemmas.lean, Nat.pow_add and Nat.pow_mul'.
; Adapted induction follows Lim's first-operand arithmetic recursors.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias power = ../fermat_statement.lim::power)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias congruence = ./equality.lim::congruence)
(#alias multiply-one-left = ./natural-multiplication.lim::multiply-one-left)
(#alias multiply-associative = ./natural-multiplication.lim::multiply-associative)
(#theorem power-add
  (#universes)
  (#parameters
    (#parameter base #pt-nat)
    (#parameter left #pt-nat)
    (#parameter right #pt-nat))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use power ()) base (#pt-app (#pt-use add ()) left right))
      (#pt-app
        (#pt-use multiply ())
        (#pt-app (#pt-use power ()) base left)
        (#pt-app (#pt-use power ()) base right))))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((exponent #pt-nat))
        (#pt-eq
          #pt-nat
          (#pt-app (#pt-use power ()) base (#pt-app (#pt-use add ()) exponent right))
          (#pt-app
            (#pt-use multiply ())
            (#pt-app (#pt-use power ()) base exponent)
            (#pt-app (#pt-use power ()) base right))))
      (#pt-app
        (#pt-use symmetry (0))
        #pt-nat
        (#pt-app (#pt-use multiply ()) (#pt-succ #pt-zero) (#pt-app (#pt-use power ()) base right))
        (#pt-app (#pt-use power ()) base right)
        (#pt-app (#pt-use multiply-one-left ()) (#pt-app (#pt-use power ()) base right)))
      (#pt-lambda
        (
          (previous #pt-nat)
          (induction-hypothesis
            (#pt-eq
              #pt-nat
              (#pt-app (#pt-use power ()) base (#pt-app (#pt-use add ()) previous right))
              (#pt-app
                (#pt-use multiply ())
                (#pt-app (#pt-use power ()) base previous)
                (#pt-app (#pt-use power ()) base right)))))
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          (#pt-app (#pt-use power ()) base (#pt-app (#pt-use add ()) (#pt-succ previous) right))
          (#pt-app
            (#pt-use multiply ())
            base
            (#pt-app
              (#pt-use multiply ())
              (#pt-app (#pt-use power ()) base previous)
              (#pt-app (#pt-use power ()) base right)))
          (#pt-app
            (#pt-use multiply ())
            (#pt-app (#pt-use power ()) base (#pt-succ previous))
            (#pt-app (#pt-use power ()) base right))
          (#pt-app
            (#pt-use congruence (0 0))
            #pt-nat
            #pt-nat
            (#pt-lambda ((value #pt-nat)) (#pt-app (#pt-use multiply ()) base value))
            (#pt-app (#pt-use power ()) base (#pt-app (#pt-use add ()) previous right))
            (#pt-app
              (#pt-use multiply ())
              (#pt-app (#pt-use power ()) base previous)
              (#pt-app (#pt-use power ()) base right))
            induction-hypothesis)
          (#pt-app
            (#pt-use symmetry (0))
            #pt-nat
            (#pt-app
              (#pt-use multiply ())
              (#pt-app (#pt-use power ()) base (#pt-succ previous))
              (#pt-app (#pt-use power ()) base right))
            (#pt-app
              (#pt-use multiply ())
              base
              (#pt-app
                (#pt-use multiply ())
                (#pt-app (#pt-use power ()) base previous)
                (#pt-app (#pt-use power ()) base right)))
            (#pt-app
              (#pt-use multiply-associative ())
              base
              (#pt-app (#pt-use power ()) base previous)
              (#pt-app (#pt-use power ()) base right)))))
      left)))
(#theorem power-multiply
  (#universes)
  (#parameters
    (#parameter base #pt-nat)
    (#parameter outer-exponent #pt-nat)
    (#parameter inner-exponent #pt-nat))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app
        (#pt-use power ())
        base
        (#pt-app (#pt-use multiply ()) outer-exponent inner-exponent))
      (#pt-app (#pt-use power ()) (#pt-app (#pt-use power ()) base inner-exponent) outer-exponent)))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((exponent #pt-nat))
        (#pt-eq
          #pt-nat
          (#pt-app (#pt-use power ()) base (#pt-app (#pt-use multiply ()) exponent inner-exponent))
          (#pt-app (#pt-use power ()) (#pt-app (#pt-use power ()) base inner-exponent) exponent)))
      (#pt-refl #pt-nat (#pt-succ #pt-zero))
      (#pt-lambda
        (
          (previous #pt-nat)
          (induction-hypothesis
            (#pt-eq
              #pt-nat
              (#pt-app
                (#pt-use power ())
                base
                (#pt-app (#pt-use multiply ()) previous inner-exponent))
              (#pt-app (#pt-use power ()) (#pt-app (#pt-use power ()) base inner-exponent) previous))))
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          (#pt-app
            (#pt-use power ())
            base
            (#pt-app (#pt-use multiply ()) (#pt-succ previous) inner-exponent))
          (#pt-app
            (#pt-use multiply ())
            (#pt-app (#pt-use power ()) base inner-exponent)
            (#pt-app
              (#pt-use power ())
              base
              (#pt-app (#pt-use multiply ()) previous inner-exponent)))
          (#pt-app
            (#pt-use power ())
            (#pt-app (#pt-use power ()) base inner-exponent)
            (#pt-succ previous))
          (#pt-app
            (#pt-use power-add ())
            base
            inner-exponent
            (#pt-app (#pt-use multiply ()) previous inner-exponent))
          (#pt-app
            (#pt-use congruence (0 0))
            #pt-nat
            #pt-nat
            (#pt-lambda
              ((value #pt-nat))
              (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use power ()) base inner-exponent) value))
            (#pt-app
              (#pt-use power ())
              base
              (#pt-app (#pt-use multiply ()) previous inner-exponent))
            (#pt-app (#pt-use power ()) (#pt-app (#pt-use power ()) base inner-exponent) previous)
            induction-hypothesis)))
      outer-exponent)))
