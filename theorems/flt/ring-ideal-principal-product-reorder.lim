              coefficient-ring
              first-element
              second-element))
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            first-coefficient
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              second-coefficient
              (#pt-app
                (#pt-use ring-multiply ())
                Carrier
                coefficient-ring
                first-element
                second-element)))
          (#pt-app
            (#pt-use ring-multiply-associative ())
            Carrier
            coefficient-ring
            first-coefficient
            second-coefficient
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              first-element
              second-element)))))))
