; Explicit associativity and commutativity
; regroup (c*a)*(d*b) as (c*d)*(a*b), producing the coefficient
; witness needed for principal ideal multiplication.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-multiply-associative = ./commutative-ring-data.lim::ring-multiply-associative)
(#alias ring-multiply-congruent = ./commutative-ring-data.lim::ring-multiply-congruent)
(#alias
  ring-multiply-left-commutative
  =
  ./commutative-ring-elementary-laws.lim::ring-multiply-left-commutative)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#alias ring-symmetric = ./commutative-ring-data.lim::ring-symmetric)
(#alias ring-transitive = ./commutative-ring-data.lim::ring-transitive)
(#theorem ring-ideal-principal-product-reorder
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-coefficient Carrier)
    (#parameter first-element Carrier)
    (#parameter second-coefficient Carrier)
    (#parameter second-element Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-multiply ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          first-coefficient
          first-element)
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          second-coefficient
          second-element))
      (#pt-app
        (#pt-use ring-multiply ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          first-coefficient
          second-coefficient)
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element second-element))))
  (#proof
    (#pt-app
      (#pt-use ring-transitive ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-multiply ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          first-coefficient
          first-element)
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          second-coefficient
          second-element))
      (#pt-app
        (#pt-use ring-multiply ())
        Carrier
        coefficient-ring
        first-coefficient
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          first-element
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            second-coefficient
            second-element)))
      (#pt-app
        (#pt-use ring-multiply ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          first-coefficient
          second-coefficient)
        (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element second-element))
      (#pt-app
        (#pt-use ring-multiply-associative ())
        Carrier
        coefficient-ring
        first-coefficient
        first-element
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          second-coefficient
          second-element))
      (#pt-app
        (#pt-use ring-transitive ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          first-coefficient
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            first-element
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              second-coefficient
              second-element)))
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          first-coefficient
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            second-coefficient
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              first-element
              second-element)))
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            first-coefficient
            second-coefficient)
          (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element second-element))
        (#pt-app
          (#pt-use ring-multiply-congruent ())
          Carrier
          coefficient-ring
          first-coefficient
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            first-element
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              second-coefficient
              second-element))
          first-coefficient
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            second-coefficient
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              first-element
              second-element))
          (#pt-app (#pt-use ring-reflexive ()) Carrier coefficient-ring first-coefficient)
          (#pt-app
            (#pt-use ring-multiply-left-commutative ())
            Carrier
            coefficient-ring
            first-element
            second-coefficient
            second-element))
        (#pt-app
          (#pt-use ring-symmetric ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              first-coefficient
              second-coefficient)
            (#pt-app
