(#theorem pythagorean-coprime-from-hypotenuse
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter hypotenuse #pt-nat)
    (#parameter first-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat first #pt-zero))) #pt-false))
    (#parameter coprime-proof (#pt-app (#pt-use coprime ()) first hypotenuse))
    (#parameter square-equation (#pt-eq #pt-nat (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) first first) (#pt-app (#pt-use multiply ()) second second)) (#pt-app (#pt-use multiply ()) hypotenuse hypotenuse))))
  (#statement (#pt-app (#pt-use coprime ()) first second))
  (#proof
    (#pt-lambda
      (
        (common-divisor #pt-nat)
        (first-divides (#pt-app (#pt-use divides ()) common-divisor first))
        (second-divides (#pt-app (#pt-use divides ()) common-divisor second)))
      (#pt-app
        (#pt-use disjunction-eliminate ())
        (#pt-eq #pt-nat common-divisor #pt-zero)
        (#pt-app
          (#pt-use disjunction ())
          (#pt-eq #pt-nat common-divisor (#pt-succ #pt-zero))
          (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) common-divisor))
        (#pt-eq #pt-nat common-divisor (#pt-succ #pt-zero))
        (#pt-lambda
          ((zero-equation (#pt-eq #pt-nat common-divisor #pt-zero)))
          (#pt-app
            (#pt-use false-elimination ())
            (#pt-eq #pt-nat common-divisor (#pt-succ #pt-zero))
            (#pt-app
              (#pt-app
                (#pt-use divisor-nonzero ())
                common-divisor
                first
                first-nonzero
                first-divides)
              zero-equation)))
        (#pt-lambda
          (
            (nonzero-case
              (#pt-app
                (#pt-use disjunction ())
                (#pt-eq #pt-nat common-divisor (#pt-succ #pt-zero))
                (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) common-divisor))))
          (#pt-app
            (#pt-use disjunction-eliminate ())
            (#pt-eq #pt-nat common-divisor (#pt-succ #pt-zero))
            (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) common-divisor)
            (#pt-eq #pt-nat common-divisor (#pt-succ #pt-zero))
            (#pt-lambda
              ((one-equation (#pt-eq #pt-nat common-divisor (#pt-succ #pt-zero))))
              one-equation)
            (#pt-lambda
              (
                (larger-than-one
                  (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) common-divisor)))
              (#pt-induct
                exists
                (0)
                (#pt-nat
                  (#pt-lambda
                    ((prime-candidate #pt-nat))
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app (#pt-use prime ()) prime-candidate)
                      (#pt-app (#pt-use divides ()) prime-candidate common-divisor))))
                (#pt-lambda
                  (
                    (certificate
                      (#pt-app
                        (#pt-use exists (0))
                        #pt-nat
                        (#pt-lambda
                          ((prime-candidate #pt-nat))
                          (#pt-app
                            (#pt-use conjunction ())
                            (#pt-app (#pt-use prime ()) prime-candidate)
                            (#pt-app (#pt-use divides ()) prime-candidate common-divisor))))))
                  (#pt-eq #pt-nat common-divisor (#pt-succ #pt-zero)))
                (
                  (#pt-lambda
                    (
                      (prime-number #pt-nat)
                      (prime-certificate
                        (#pt-app
                          (#pt-use conjunction ())
                          (#pt-app (#pt-use prime ()) prime-number)
                          (#pt-app (#pt-use divides ()) prime-number common-divisor))))
                    (#pt-app
                      (#pt-use false-elimination ())
                      (#pt-eq #pt-nat common-divisor (#pt-succ #pt-zero))
                      (#pt-app
                        (#pt-app
                          (#pt-use prime-not-one ())
                          prime-number
                          (#pt-app
                            (#pt-use conjunction-left ())
                            (#pt-app (#pt-use prime ()) prime-number)
                            (#pt-app (#pt-use divides ()) prime-number common-divisor)
                            prime-certificate))
                        (#pt-app
                          coprime-proof
                          prime-number
                          (#pt-app
                            (#pt-use divides-transitive ())
                            prime-number
                            common-divisor
                            first
                            (#pt-app
                              (#pt-use conjunction-right ())
                              (#pt-app (#pt-use prime ()) prime-number)
                              (#pt-app (#pt-use divides ()) prime-number common-divisor)
                              prime-certificate)
                            first-divides)
                          (#pt-app
                            (#pt-use prime-divides-square ())
                            prime-number
                            hypotenuse
                            (#pt-app
                              (#pt-use conjunction-left ())
                              (#pt-app (#pt-use prime ()) prime-number)
                              (#pt-app (#pt-use divides ()) prime-number common-divisor)
                              prime-certificate)
                            (#pt-app
                              (#pt-use substitution (0))
                              #pt-nat
                              (#pt-lambda
                                ((endpoint #pt-nat))
                                (#pt-app (#pt-use divides ()) prime-number endpoint))
                              (#pt-app
                                (#pt-use add ())
                                (#pt-app (#pt-use multiply ()) first first)
                                (#pt-app (#pt-use multiply ()) second second))
                              (#pt-app (#pt-use multiply ()) hypotenuse hypotenuse)
                              square-equation
                              (#pt-app
                                (#pt-use divides-add ())
                                prime-number
                                (#pt-app (#pt-use multiply ()) first first)
                                (#pt-app (#pt-use multiply ()) second second)
                                (#pt-app
                                  (#pt-use divides-transitive ())
                                  prime-number
                                  first
