; Half-sum/difference factorization for positive primitive Pythagorean triples.
; The identities avoid truncated subtraction by retaining an explicit addition gap.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias exists = ./logic-exists.lim::exists)
(#alias odd = ./natural-parity.lim::odd)
(#alias even-or-odd = ./natural-parity.lim::even-or-odd)
(#alias odd-plus-odd-is-even = ./natural-parity-arithmetic.lim::odd-plus-odd-is-even)
(#alias odd-even-exclusion = ./natural-parity-arithmetic.lim::odd-even-exclusion)
(#alias less-than = ./natural-order.lim::less-than)
(#alias prime = ./natural-prime.lim::prime)
(#alias exists-prime-divisor = ./natural-prime.lim::exists-prime-divisor)
(#alias prime-not-one = ./natural-prime-divisibility.lim::prime-not-one)
(#alias prime-divides-square = ./natural-prime-divisibility.lim::prime-divides-square)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias divides-multiple = ./natural-divisibility.lim::divides-multiple)
(#alias divides-transitive = ./natural-divisibility.lim::divides-transitive)
(#alias divides-add = ./natural-divisibility-addition.lim::divides-add)
(#alias divides-add-cancel-left = ./natural-divisibility-addition.lim::divides-add-cancel-left)
(#alias divisor-nonzero = ./natural-divisibility-bounds.lim::divisor-nonzero)
(#alias coprime = ./natural-coprime.lim::coprime)
(#alias zero-one-or-large = ./natural-small-cases.lim::zero-one-or-large)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias add-associative = ./natural-addition.lim::add-associative)
(#alias add-commutative = ./natural-addition.lim::add-commutative)
(#alias add-successor-right = ./natural-addition.lim::add-successor-right)
(#alias add-cancel-left = ./natural-cancellation.lim::add-cancel-left)
(#alias double-as-sum = ./natural-semiring-identities.lim::double-as-sum)
(#alias double-square = ./natural-semiring-identities.lim::double-square)
(#alias square-double-gap = ./natural-semiring-identities.lim::square-double-gap)
(#alias
  multiply-cancel-left-nonzero
  =
  ./natural-square-arithmetic.lim::multiply-cancel-left-nonzero)
(#alias successor-not-zero = ./natural-nonzero.lim::successor-not-zero)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias congruence = ./equality.lim::congruence)
(#alias substitution = ./equality.lim::substitution)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#theorem pythagorean-coprime-hypotenuse
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter hypotenuse #pt-nat)
    (#parameter first-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat first #pt-zero))) #pt-false))
    (#parameter coprime-proof (#pt-app (#pt-use coprime ()) first second))
    (#parameter square-equation (#pt-eq #pt-nat (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) first first) (#pt-app (#pt-use multiply ()) second second)) (#pt-app (#pt-use multiply ()) hypotenuse hypotenuse))))
  (#statement (#pt-app (#pt-use coprime ()) first hypotenuse))
  (#proof
    (#pt-lambda
      (
        (common-divisor #pt-nat)
        (first-divides (#pt-app (#pt-use divides ()) common-divisor first))
        (hypotenuse-divides (#pt-app (#pt-use divides ()) common-divisor hypotenuse)))
      (#pt-app
        (#pt-use disjunction-eliminate ())
        (#pt-eq #pt-nat common-divisor #pt-zero)
        (#pt-app
          (#pt-use disjunction ())
          (#pt-eq #pt-nat common-divisor (#pt-succ #pt-zero))
          (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) common-divisor))
        (#pt-eq #pt-nat common-divisor (#pt-succ #pt-zero))
        (#pt-lambda
          ((zero-equation (#pt-eq #pt-nat common-divisor #pt-zero)))
          (#pt-app
            (#pt-use false-elimination ())
            (#pt-eq #pt-nat common-divisor (#pt-succ #pt-zero))
            (#pt-app
              (#pt-app
                (#pt-use divisor-nonzero ())
                common-divisor
                first
                first-nonzero
                first-divides)
              zero-equation)))
        (#pt-lambda
          (
            (nonzero-case
              (#pt-app
                (#pt-use disjunction ())
                (#pt-eq #pt-nat common-divisor (#pt-succ #pt-zero))
                (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) common-divisor))))
          (#pt-app
            (#pt-use disjunction-eliminate ())
            (#pt-eq #pt-nat common-divisor (#pt-succ #pt-zero))
            (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) common-divisor)
            (#pt-eq #pt-nat common-divisor (#pt-succ #pt-zero))
            (#pt-lambda
              ((one-equation (#pt-eq #pt-nat common-divisor (#pt-succ #pt-zero))))
              one-equation)
            (#pt-lambda
              (
                (larger-than-one
                  (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) common-divisor)))
              (#pt-induct
                exists
                (0)
                (#pt-nat
                  (#pt-lambda
                    ((prime-candidate #pt-nat))
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app (#pt-use prime ()) prime-candidate)
                      (#pt-app (#pt-use divides ()) prime-candidate common-divisor))))
                (#pt-lambda
                  (
                    (certificate
                      (#pt-app
                        (#pt-use exists (0))
                        #pt-nat
                        (#pt-lambda
                          ((prime-candidate #pt-nat))
                          (#pt-app
                            (#pt-use conjunction ())
                            (#pt-app (#pt-use prime ()) prime-candidate)
                            (#pt-app (#pt-use divides ()) prime-candidate common-divisor))))))
                  (#pt-eq #pt-nat common-divisor (#pt-succ #pt-zero)))
                (
                  (#pt-lambda
                    (
                      (prime-number #pt-nat)
                      (prime-certificate
                        (#pt-app
                          (#pt-use conjunction ())
                          (#pt-app (#pt-use prime ()) prime-number)
                          (#pt-app (#pt-use divides ()) prime-number common-divisor))))
                    (#pt-app
                      (#pt-use false-elimination ())
                      (#pt-eq #pt-nat common-divisor (#pt-succ #pt-zero))
                      (#pt-app
                        (#pt-app
                          (#pt-use prime-not-one ())
                          prime-number
                          (#pt-app
                            (#pt-use conjunction-left ())
                            (#pt-app (#pt-use prime ()) prime-number)
                            (#pt-app (#pt-use divides ()) prime-number common-divisor)
                            prime-certificate))
                        (#pt-app
                          coprime-proof
                          prime-number
                          (#pt-app
                            (#pt-use divides-transitive ())
                            prime-number
                            common-divisor
                            first
                            (#pt-app
                              (#pt-use conjunction-right ())
                              (#pt-app (#pt-use prime ()) prime-number)
                              (#pt-app (#pt-use divides ()) prime-number common-divisor)
                              prime-certificate)
                            first-divides)
                          (#pt-app
                            (#pt-use prime-divides-square ())
                            prime-number
                            second
                            (#pt-app
                              (#pt-use conjunction-left ())
                              (#pt-app (#pt-use prime ()) prime-number)
                              (#pt-app (#pt-use divides ()) prime-number common-divisor)
                              prime-certificate)
                            (#pt-app
                              (#pt-use divides-add-cancel-left ())
                              prime-number
                              (#pt-app (#pt-use multiply ()) first first)
                              (#pt-app (#pt-use multiply ()) second second)
                              (#pt-app
                                (#pt-use divides-transitive ())
                                prime-number
                                first
                                (#pt-app (#pt-use multiply ()) first first)
                                (#pt-app
                                  (#pt-use divides-transitive ())
                                  prime-number
                                  common-divisor
                                  first
                                  (#pt-app
                                    (#pt-use conjunction-right ())
                                    (#pt-app (#pt-use prime ()) prime-number)
                                    (#pt-app (#pt-use divides ()) prime-number common-divisor)
                                    prime-certificate)
                                  first-divides)
                                (#pt-app (#pt-use divides-multiple ()) first first))
                              (#pt-app
                                (#pt-use substitution (0))
                                #pt-nat
                                (#pt-lambda
                                  ((endpoint #pt-nat))
                                  (#pt-app (#pt-use divides ()) prime-number endpoint))
                                (#pt-app (#pt-use multiply ()) hypotenuse hypotenuse)
                                (#pt-app
                                  (#pt-use add ())
                                  (#pt-app (#pt-use multiply ()) first first)
                                  (#pt-app (#pt-use multiply ()) second second))
                                (#pt-app
                                  (#pt-use symmetry (0))
                                  #pt-nat
                                  (#pt-app
                                    (#pt-use add ())
                                    (#pt-app (#pt-use multiply ()) first first)
                                    (#pt-app (#pt-use multiply ()) second second))
                                  (#pt-app (#pt-use multiply ()) hypotenuse hypotenuse)
                                  square-equation)
                                (#pt-app
                                  (#pt-use divides-transitive ())
                                  prime-number
                                  hypotenuse
                                  (#pt-app (#pt-use multiply ()) hypotenuse hypotenuse)
                                  (#pt-app
                                    (#pt-use divides-transitive ())
                                    prime-number
                                    common-divisor
                                    hypotenuse
                                    (#pt-app
                                      (#pt-use conjunction-right ())
                                      (#pt-app (#pt-use prime ()) prime-number)
                                      (#pt-app (#pt-use divides ()) prime-number common-divisor)
                                      prime-certificate)
                                    hypotenuse-divides)
                                  (#pt-app (#pt-use divides-multiple ()) hypotenuse hypotenuse))))))))))
                (#pt-app (#pt-use exists-prime-divisor ()) common-divisor larger-than-one)))
            nonzero-case))
        (#pt-app (#pt-use zero-one-or-large ()) common-divisor)))))
(#theorem odd-increasing-even-gap
  (#universes)
  (#parameters
    (#parameter lower #pt-nat)
    (#parameter upper #pt-nat)
    (#parameter lower-odd (#pt-app (#pt-use odd ()) lower))
    (#parameter upper-odd (#pt-app (#pt-use odd ()) upper))
    (#parameter less-proof (#pt-app (#pt-use less-than ()) lower upper)))
  (#statement
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-half #pt-nat))
        (#pt-eq
          #pt-nat
          upper
          (#pt-app
            (#pt-use add ())
            lower
            (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) candidate-half))))))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-gap #pt-nat))
          (#pt-eq #pt-nat upper (#pt-app (#pt-use add ()) (#pt-succ lower) candidate-gap))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-gap #pt-nat))
                (#pt-eq #pt-nat upper (#pt-app (#pt-use add ()) (#pt-succ lower) candidate-gap))))))
        (#pt-app
          (#pt-use exists (0))
          #pt-nat
          (#pt-lambda
            ((candidate-half #pt-nat))
            (#pt-eq
              #pt-nat
              upper
              (#pt-app
                (#pt-use add ())
                lower
                (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) candidate-half))))))
      (
        (#pt-lambda
          (
            (gap #pt-nat)
            (gap-equation (#pt-eq #pt-nat upper (#pt-app (#pt-use add ()) (#pt-succ lower) gap))))
          (#pt-app
            (#pt-use disjunction-eliminate ())
            (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-succ gap))
            (#pt-app (#pt-use odd ()) (#pt-succ gap))
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-half #pt-nat))
                (#pt-eq
                  #pt-nat
                  upper
                  (#pt-app
                    (#pt-use add ())
                    lower
                    (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) candidate-half)))))
            (#pt-lambda
              (
                (gap-even
                  (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-succ gap))))
              (#pt-induct
                exists
                (0)
                (#pt-nat
                  (#pt-lambda
                    ((candidate-factor #pt-nat))
                    (#pt-eq
                      #pt-nat
                      (#pt-succ gap)
                      (#pt-app
                        (#pt-use multiply ())
                        (#pt-succ (#pt-succ #pt-zero))
                        candidate-factor))))
                (#pt-lambda
                  (
                    (certificate
                      (#pt-app
                        (#pt-use exists (0))
                        #pt-nat
                        (#pt-lambda
                          ((candidate-factor #pt-nat))
                          (#pt-eq
                            #pt-nat
                            (#pt-succ gap)
                            (#pt-app
                              (#pt-use multiply ())
                              (#pt-succ (#pt-succ #pt-zero))
                              candidate-factor))))))
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((candidate-half #pt-nat))
                      (#pt-eq
                        #pt-nat
                        upper
                        (#pt-app
                          (#pt-use add ())
                          lower
                          (#pt-app
                            (#pt-use multiply ())
                            (#pt-succ (#pt-succ #pt-zero))
                            candidate-half))))))
                (
                  (#pt-lambda
                    (
                      (half #pt-nat)
                      (half-equation
                        (#pt-eq
                          #pt-nat
                          (#pt-succ gap)
                          (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half))))
                    (#pt-construct
                      exists
                      (0)
                      (#pt-nat
                        (#pt-lambda
                          ((candidate-half #pt-nat))
                          (#pt-eq
                            #pt-nat
                            upper
                            (#pt-app
                              (#pt-use add ())
                              lower
                              (#pt-app
                                (#pt-use multiply ())
                                (#pt-succ (#pt-succ #pt-zero))
                                candidate-half)))))
                      introduce
                      (half
                        (#pt-app
                          (#pt-use transitivity (0))
                          #pt-nat
                          upper
                          (#pt-app (#pt-use add ()) lower (#pt-succ gap))
                          (#pt-app
                            (#pt-use add ())
                            lower
                            (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half))
                          (#pt-app
                            (#pt-use transitivity (0))
                            #pt-nat
                            upper
                            (#pt-app (#pt-use add ()) (#pt-succ lower) gap)
                            (#pt-app (#pt-use add ()) lower (#pt-succ gap))
                            gap-equation
                            (#pt-app
                              (#pt-use symmetry (0))
                              #pt-nat
                              (#pt-app (#pt-use add ()) lower (#pt-succ gap))
                              (#pt-app (#pt-use add ()) (#pt-succ lower) gap)
                              (#pt-app (#pt-use add-successor-right ()) lower gap)))
                          (#pt-app
                            (#pt-use congruence (0 0))
                            #pt-nat
                            #pt-nat
                            (#pt-lambda
                              ((endpoint #pt-nat))
                              (#pt-app (#pt-use add ()) lower endpoint))
                            (#pt-succ gap)
                            (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half)
                            half-equation))))))
                gap-even))
            (#pt-lambda
              ((gap-odd (#pt-app (#pt-use odd ()) (#pt-succ gap))))
              (#pt-app
                (#pt-use false-elimination ())
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((candidate-half #pt-nat))
                    (#pt-eq
                      #pt-nat
                      upper
                      (#pt-app
                        (#pt-use add ())
                        lower
                        (#pt-app
                          (#pt-use multiply ())
                          (#pt-succ (#pt-succ #pt-zero))
                          candidate-half)))))
                (#pt-app
                  (#pt-use odd-even-exclusion ())
                  upper
                  upper-odd
                  (#pt-app
                    (#pt-use substitution (0))
                    #pt-nat
                    (#pt-lambda
                      ((endpoint #pt-nat))
                      (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) endpoint))
                    (#pt-app (#pt-use add ()) lower (#pt-succ gap))
                    upper
                    (#pt-app
                      (#pt-use symmetry (0))
                      #pt-nat
                      upper
                      (#pt-app (#pt-use add ()) lower (#pt-succ gap))
                      (#pt-app
                        (#pt-use transitivity (0))
                        #pt-nat
                        upper
                        (#pt-app (#pt-use add ()) (#pt-succ lower) gap)
                        (#pt-app (#pt-use add ()) lower (#pt-succ gap))
                        gap-equation
                        (#pt-app
                          (#pt-use symmetry (0))
                          #pt-nat
                          (#pt-app (#pt-use add ()) lower (#pt-succ gap))
                          (#pt-app (#pt-use add ()) (#pt-succ lower) gap)
                          (#pt-app (#pt-use add-successor-right ()) lower gap))))
                    (#pt-app
                      (#pt-use odd-plus-odd-is-even ())
                      lower
                      (#pt-succ gap)
                      lower-odd
                      gap-odd)))))
            (#pt-app (#pt-use even-or-odd ()) (#pt-succ gap)))))
      less-proof)))
(#theorem pythagorean-halves-coprime
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter hypotenuse #pt-nat)
    (#parameter half #pt-nat)
    (#parameter gap-equation (#pt-eq #pt-nat hypotenuse (#pt-app (#pt-use add ()) first (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half))))
    (#parameter coprime-proof (#pt-app (#pt-use coprime ()) first hypotenuse)))
  (#statement (#pt-app (#pt-use coprime ()) half (#pt-app (#pt-use add ()) first half)))
  (#proof
    (#pt-lambda
      (
        (common-divisor #pt-nat)
        (lower-factor-divides (#pt-app (#pt-use divides ()) common-divisor half))
        (upper-factor-divides
          (#pt-app (#pt-use divides ()) common-divisor (#pt-app (#pt-use add ()) first half))))
      (#pt-app
        coprime-proof
        common-divisor
        (#pt-app
          (#pt-use divides-add-cancel-left ())
          common-divisor
          half
          first
          lower-factor-divides
          (#pt-app
            (#pt-use substitution (0))
            #pt-nat
            (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use divides ()) common-divisor endpoint))
            (#pt-app (#pt-use add ()) first half)
            (#pt-app (#pt-use add ()) half first)
            (#pt-app (#pt-use add-commutative ()) first half)
            upper-factor-divides))
        (#pt-app
          (#pt-use substitution (0))
          #pt-nat
          (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use divides ()) common-divisor endpoint))
          (#pt-app (#pt-use add ()) (#pt-app (#pt-use add ()) first half) half)
          hypotenuse
          (#pt-app
            (#pt-use symmetry (0))
            #pt-nat
            hypotenuse
            (#pt-app (#pt-use add ()) (#pt-app (#pt-use add ()) first half) half)
            (#pt-app
              (#pt-use transitivity (0))
              #pt-nat
              hypotenuse
              (#pt-app
                (#pt-use add ())
                first
                (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half))
              (#pt-app (#pt-use add ()) (#pt-app (#pt-use add ()) first half) half)
              gap-equation
              (#pt-app
                (#pt-use transitivity (0))
                #pt-nat
                (#pt-app
                  (#pt-use add ())
                  first
                  (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half))
                (#pt-app (#pt-use add ()) first (#pt-app (#pt-use add ()) half half))
                (#pt-app (#pt-use add ()) (#pt-app (#pt-use add ()) first half) half)
                (#pt-app
                  (#pt-use congruence (0 0))
                  #pt-nat
                  #pt-nat
                  (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use add ()) first endpoint))
                  (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half)
                  (#pt-app (#pt-use add ()) half half)
                  (#pt-app (#pt-use double-as-sum ()) half))
                (#pt-app
                  (#pt-use symmetry (0))
                  #pt-nat
                  (#pt-app (#pt-use add ()) (#pt-app (#pt-use add ()) first half) half)
                  (#pt-app (#pt-use add ()) first (#pt-app (#pt-use add ()) half half))
                  (#pt-app (#pt-use add-associative ()) first half half)))))
          (#pt-app
            (#pt-use divides-add ())
            common-divisor
            (#pt-app (#pt-use add ()) first half)
            half
            upper-factor-divides
            lower-factor-divides))))))
(#theorem pythagorean-half-product
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter hypotenuse #pt-nat)
    (#parameter second-half #pt-nat)
    (#parameter half #pt-nat)
    (#parameter second-equation (#pt-eq #pt-nat second (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) second-half)))
    (#parameter gap-equation (#pt-eq #pt-nat hypotenuse (#pt-app (#pt-use add ()) first (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) half))))
    (#parameter square-equation (#pt-eq #pt-nat (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) first first) (#pt-app (#pt-use multiply ()) second second)) (#pt-app (#pt-use multiply ()) hypotenuse hypotenuse))))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use multiply ()) second-half second-half)
      (#pt-app (#pt-use multiply ()) half (#pt-app (#pt-use add ()) first half))))
  (#proof
    (#pt-app
      (#pt-use multiply-cancel-left-nonzero ())
      (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
      (#pt-app (#pt-use multiply ()) second-half second-half)
      (#pt-app (#pt-use multiply ()) half (#pt-app (#pt-use add ()) first half))
      (#pt-app (#pt-use successor-not-zero ()) (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
      (#pt-app
        (#pt-use add-cancel-left ())
        (#pt-app (#pt-use multiply ()) first first)
        (#pt-app
          (#pt-use multiply ())
          (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
          (#pt-app (#pt-use multiply ()) second-half second-half))
        (#pt-app
          (#pt-use multiply ())
          (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
          (#pt-app (#pt-use multiply ()) half (#pt-app (#pt-use add ()) first half)))
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use multiply ()) first first)
            (#pt-app
              (#pt-use multiply ())
              (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
              (#pt-app (#pt-use multiply ()) second-half second-half)))
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use multiply ()) first first)
            (#pt-app (#pt-use multiply ()) second second))
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use multiply ()) first first)
            (#pt-app
              (#pt-use multiply ())
              (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
              (#pt-app (#pt-use multiply ()) half (#pt-app (#pt-use add ()) first half))))
          (#pt-app
            (#pt-use congruence (0 0))
            #pt-nat
            #pt-nat
            (#pt-lambda
              ((endpoint #pt-nat))
              (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) first first) endpoint))
            (#pt-app
              (#pt-use multiply ())
              (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
              (#pt-app (#pt-use multiply ()) second-half second-half))
            (#pt-app (#pt-use multiply ()) second second)
            (#pt-app
              (#pt-use symmetry (0))
              #pt-nat
              (#pt-app (#pt-use multiply ()) second second)
              (#pt-app
                (#pt-use multiply ())
                (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
                (#pt-app (#pt-use multiply ()) second-half second-half))
              (#pt-app
                (#pt-use transitivity (0))
                #pt-nat
                (#pt-app (#pt-use multiply ()) second second)
                (#pt-app
                  (#pt-use multiply ())
                  (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) second-half)
                  (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) second-half))
                (#pt-app
                  (#pt-use multiply ())
                  (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
