                  #pt-nat
                  (#pt-lambda
                    ((endpoint #pt-nat))
                    (#pt-app (#pt-use multiply ()) endpoint endpoint))
                  second
                  (#pt-app (#pt-use multiply ()) (#pt-succ (#pt-succ #pt-zero)) second-half)
                  second-equation)
