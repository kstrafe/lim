(#alias ring-polynomial-equal = ./ring-polynomial-data.lim::ring-polynomial-equal)
(#alias substitution = ./equality.lim::substitution)
(#alias symmetry = ./equality.lim::symmetry)
(#theorem ring-polynomial-degree-positive-natural-bridge
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter degree-data (#pt-app (#pt-use ring-polynomial-degree-data ()) Carrier coefficient-ring polynomial))
    (#parameter claimed-degree #pt-nat)
    (#parameter positive-degree (#pt-app (#pt-use less-than ()) #pt-zero claimed-degree))
    (#parameter natural-degree-equation (#pt-eq #pt-nat (#pt-app (#pt-use ring-polynomial-degree-data-natural ()) Carrier coefficient-ring polynomial degree-data) claimed-degree)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-degree-witness ())
      Carrier
      coefficient-ring
      polynomial
      claimed-degree))
  (#proof
    (#pt-app
      (#pt-induct
        ring-polynomial-degree-data
        ()
        (Carrier coefficient-ring polynomial)
        (#pt-lambda
          (
            (selected-degree-data
              (#pt-app (#pt-use ring-polynomial-degree-data ()) Carrier coefficient-ring polynomial)))
          (#pt-pi
            (
              (natural-degree-equation-bound-0000
                (#pt-eq
                  #pt-nat
                  (#pt-app
                    (#pt-use ring-polynomial-degree-data-natural ())
                    Carrier
                    coefficient-ring
                    polynomial
                    selected-degree-data)
                  claimed-degree)))
            (#pt-app
              (#pt-use ring-polynomial-degree-witness ())
              Carrier
              coefficient-ring
              polynomial
              claimed-degree)))
        (
          (#pt-lambda
            (
              (zero-equation
                (#pt-app
                  (#pt-use ring-polynomial-equal ())
                  Carrier
                  coefficient-ring
                  polynomial
                  (#pt-construct finite-list () (Carrier) nil ()))))
            (#pt-lambda
              ((natural-degree-equation-bound-0001 (#pt-eq #pt-nat #pt-zero claimed-degree)))
              (#pt-app
                (#pt-use false-elimination ())
                (#pt-app
                  (#pt-use ring-polynomial-degree-witness ())
                  Carrier
                  coefficient-ring
                  polynomial
                  claimed-degree)
                (#pt-app
                  (#pt-app
                    (#pt-use less-than-upper-nonzero ())
                    #pt-zero
                    claimed-degree
                    positive-degree)
                  (#pt-app
                    (#pt-use symmetry (0))
                    #pt-nat
                    #pt-zero
                    claimed-degree
                    natural-degree-equation-bound-0001)))))
          (#pt-lambda
            (
              (degree #pt-nat)
              (leading-certificate
                (#pt-app
                  (#pt-use ring-polynomial-degree-witness ())
                  Carrier
                  coefficient-ring
                  polynomial
                  degree)))
            (#pt-lambda
              ((natural-degree-equation-bound-0002 (#pt-eq #pt-nat degree claimed-degree)))
              (#pt-app
                (#pt-use substitution (0))
                #pt-nat
                (#pt-lambda
                  ((selected-degree #pt-nat))
                  (#pt-app
                    (#pt-use ring-polynomial-degree-witness ())
                    Carrier
                    coefficient-ring
                    polynomial
                    selected-degree))
                degree
                claimed-degree
                natural-degree-equation-bound-0002
                leading-certificate))))
        degree-data)
      natural-degree-equation)))
