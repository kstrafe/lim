; Adapted mathematical source: pinned Mathlib RingTheory/AdjoinRoot.lean
; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean.
; Generated by scripts/generate-flt-point-evaluation.py; checked native terms.
; For every finite polynomial compute Q,r
; and prove p=(X-root)*Q+[r]. Arbitrary trailing zeros and
; zero divisors are retained by coefficientwise equivalence.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias polynomial-root-divisor = ./polynomial-root-division-data.lim::polynomial-root-divisor)
(#alias polynomial-root-quotient = ./polynomial-root-division-data.lim::polynomial-root-quotient)
(#alias polynomial-root-remainder = ./polynomial-root-division-data.lim::polynomial-root-remainder)
(#alias
  polynomial-root-step-equation
  =
  ./polynomial-root-step-equation.lim::polynomial-root-step-equation)
(#alias ring-polynomial-add = ./ring-polynomial-data.lim::ring-polynomial-add)
(#alias
  ring-polynomial-add-congruent
  =
  ./ring-polynomial-congruence.lim::ring-polynomial-add-congruent)
(#alias ring-polynomial-equal = ./ring-polynomial-data.lim::ring-polynomial-equal)
(#alias ring-polynomial-multiply = ./ring-polynomial-data.lim::ring-polynomial-multiply)
(#alias
  ring-polynomial-multiply-zero
  =
  ./ring-polynomial-multiplicative-identities.lim::ring-polynomial-multiply-zero)
(#alias ring-polynomial-shift-nil = ./ring-polynomial-shift-laws.lim::ring-polynomial-shift-nil)
(#alias ring-polynomial-symmetric = ./ring-polynomial-equivalence.lim::ring-polynomial-symmetric)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#theorem polynomial-root-division-equation
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter root Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-equal ())
      Carrier
      coefficient-ring
      polynomial
      (#pt-app
        (#pt-use ring-polynomial-add ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-multiply ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
          (#pt-app (#pt-use polynomial-root-quotient ()) Carrier coefficient-ring root polynomial))
        (#pt-construct
          finite-list
          ()
          (Carrier)
          cons
          (
            (#pt-app
              (#pt-use polynomial-root-remainder ())
              Carrier
              coefficient-ring
              root
              polynomial)
            (#pt-construct finite-list () (Carrier) nil ()))))))
  (#proof
    (#pt-induct
      finite-list
      ()
      (Carrier)
      (#pt-lambda
        ((subject (#pt-app (#pt-use finite-list ()) Carrier)))
        (#pt-app
          (#pt-use ring-polynomial-equal ())
          Carrier
          coefficient-ring
          subject
          (#pt-app
            (#pt-use ring-polynomial-add ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-multiply ())
              Carrier
              coefficient-ring
              (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
              (#pt-app (#pt-use polynomial-root-quotient ()) Carrier coefficient-ring root subject))
            (#pt-construct
              finite-list
              ()
              (Carrier)
              cons
              (
                (#pt-app
                  (#pt-use polynomial-root-remainder ())
                  Carrier
                  coefficient-ring
                  root
                  subject)
                (#pt-construct finite-list () (Carrier) nil ()))))))
      (
        (#pt-app
          (#pt-use ring-polynomial-symmetric ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-add ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-multiply ())
              Carrier
              coefficient-ring
              (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
              (#pt-construct finite-list () (Carrier) nil ()))
            (#pt-construct
              finite-list
              ()
              (Carrier)
              cons
              (
                (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
                (#pt-construct finite-list () (Carrier) nil ()))))
          (#pt-construct finite-list () (Carrier) nil ())
          (#pt-app
            (#pt-use ring-polynomial-add-congruent ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-multiply ())
              Carrier
              coefficient-ring
              (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
              (#pt-construct finite-list () (Carrier) nil ()))
            (#pt-construct
              finite-list
              ()
              (Carrier)
              cons
              (
                (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
                (#pt-construct finite-list () (Carrier) nil ())))
            (#pt-construct finite-list () (Carrier) nil ())
            (#pt-construct finite-list () (Carrier) nil ())
            (#pt-app
              (#pt-use ring-polynomial-multiply-zero ())
              Carrier
              coefficient-ring
              (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root))
            (#pt-app (#pt-use ring-polynomial-shift-nil ()) Carrier coefficient-ring)))
        (#pt-lambda
          (
            (head Carrier)
            (tail (#pt-app (#pt-use finite-list ()) Carrier))
            (tail-result
              (#pt-app
                (#pt-use ring-polynomial-equal ())
                Carrier
                coefficient-ring
                tail
                (#pt-app
                  (#pt-use ring-polynomial-add ())
                  Carrier
                  coefficient-ring
                  (#pt-app
                    (#pt-use ring-polynomial-multiply ())
                    Carrier
                    coefficient-ring
                    (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
                    (#pt-app
                      (#pt-use polynomial-root-quotient ())
                      Carrier
                      coefficient-ring
                      root
                      tail))
                  (#pt-construct
                    finite-list
                    ()
                    (Carrier)
                    cons
                    (
                      (#pt-app
                        (#pt-use polynomial-root-remainder ())
                        Carrier
                        coefficient-ring
                        root
                        tail)
                      (#pt-construct finite-list () (Carrier) nil ())))))))
          (#pt-app
            (#pt-use polynomial-root-step-equation ())
            Carrier
            coefficient-ring
            root
            head
            tail
            (#pt-app (#pt-use polynomial-root-quotient ()) Carrier coefficient-ring root tail)
            (#pt-app (#pt-use polynomial-root-remainder ()) Carrier coefficient-ring root tail)
            tail-result)))
      polynomial)))
