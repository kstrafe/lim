; Port the full source not_isGoodPrimeFor_of_isIntegralModelOf_freyCurve
; result: all coordinate primes are bad on every integral Frey model.
; Construct and eliminate the actual native model witness only into Prop.
(#alias exists = ./logic-exists.lim::exists)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-divides = ./integer-defs.lim::integer-divides)
(#alias integer-weierstrass-curve = ./integer-weierstrass-defs.lim::integer-weierstrass-curve)
(#alias
  integer-weierstrass-discriminant
  =
  ./integer-weierstrass-defs.lim::integer-weierstrass-discriminant)
(#alias integer-frey-model-certificate = ./integer-frey-model.lim::integer-frey-model-certificate)
(#alias frey-rational-curve = ./frey-rational-curve.lim::frey-rational-curve)
(#alias prime = ./natural-prime.lim::prime)
(#alias
  integer-integral-model-bad-prime-transfer
  =
  ./integer-integral-model-bad-primes.lim::integer-integral-model-bad-prime-transfer)
(#alias
  integer-is-integral-model-of
  =
  ./integer-integral-model-defs.lim::integer-is-integral-model-of)
(#alias integer-is-good-prime-for = ./integer-model-prime-defs.lim::integer-is-good-prime-for)
(#alias
  frey-exact-model-is-integral-model
  =
  ./integer-integral-model.lim::frey-exact-model-is-integral-model)
(#alias
  frey-package-is-semistable-model
  =
  ./frey-semistable-model.lim::frey-package-is-semistable-model)
(#alias
  frey-package-coordinate-prime-divides-discriminant
  =
  ./frey-package-all-primes.lim::frey-package-coordinate-prime-divides-discriminant)
(#alias
  frey-package-has-integral-model
  =
  ./frey-package-integral-model.lim::frey-package-has-integral-model)
(#alias frey-package-certificate = ./frey-package.lim::frey-package-certificate)
(#theorem frey-package-model-bad-prime-transfer
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter package (#pt-app (#pt-use frey-package-certificate ()) exponent first second third))
    (#parameter native-model (#pt-use integer-weierstrass-curve ()))
    (#parameter native-model-certificate (#pt-app (#pt-use integer-frey-model-certificate ()) first second exponent native-model))
    (#parameter other-model (#pt-use integer-weierstrass-curve ()))
    (#parameter other-model-certificate (#pt-app (#pt-use integer-is-integral-model-of ()) other-model (#pt-app (#pt-use frey-rational-curve ()) first second exponent)))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter coordinate-divides (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) (#pt-app (#pt-use integer-multiply ()) (#pt-app (#pt-use integer-multiply ()) first second) third))))
  (#statement
    (#pt-app
      (#pt-use integer-divides ())
      (#pt-app (#pt-use integer-of-natural ()) prime-number)
      (#pt-app (#pt-use integer-weierstrass-discriminant ()) other-model)))
  (#proof
    (#pt-app
      (#pt-use integer-integral-model-bad-prime-transfer ())
      native-model
      other-model
      (#pt-app (#pt-use frey-rational-curve ()) first second exponent)
      prime-number
      (#pt-app
        (#pt-use frey-exact-model-is-integral-model ())
        first
        second
        exponent
        native-model
        native-model-certificate)
      other-model-certificate
      (#pt-app
        (#pt-use frey-package-is-semistable-model ())
        first
        second
        third
        exponent
        package
        native-model
        native-model-certificate)
      prime-proof
      (#pt-app
        (#pt-use frey-package-coordinate-prime-divides-discriminant ())
        prime-number
        first
        second
        third
        exponent
        package
        native-model
        native-model-certificate
        prime-proof
        coordinate-divides))))
(#theorem frey-package-not-good-prime-for-any-integral-model
  (#universes)
  (#parameters
    (#parameter prime-number #pt-nat)
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter package (#pt-app (#pt-use frey-package-certificate ()) exponent first second third))
    (#parameter other-model (#pt-use integer-weierstrass-curve ()))
    (#parameter other-model-certificate (#pt-app (#pt-use integer-is-integral-model-of ()) other-model (#pt-app (#pt-use frey-rational-curve ()) first second exponent)))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) prime-number))
    (#parameter coordinate-divides (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) prime-number) (#pt-app (#pt-use integer-multiply ()) (#pt-app (#pt-use integer-multiply ()) first second) third))))
  (#statement
    (#pt-pi
      ((denied-proof (#pt-app (#pt-use integer-is-good-prime-for ()) other-model prime-number)))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (good-prime-certificate
          (#pt-app (#pt-use integer-is-good-prime-for ()) other-model prime-number)))
      (#pt-app
        good-prime-certificate
        (#pt-induct
          exists
          (0)
          (
            (#pt-use integer-weierstrass-curve ())
            (#pt-lambda
              ((candidate-model (#pt-use integer-weierstrass-curve ())))
              (#pt-app
                (#pt-use integer-frey-model-certificate ())
                first
                second
                exponent
                candidate-model)))
          (#pt-lambda
            (
              (integral-model-existence
                (#pt-app
                  (#pt-use exists (0))
                  (#pt-use integer-weierstrass-curve ())
                  (#pt-lambda
                    ((candidate-model (#pt-use integer-weierstrass-curve ())))
                    (#pt-app
                      (#pt-use integer-frey-model-certificate ())
                      first
                      second
                      exponent
                      candidate-model)))))
            (#pt-app
              (#pt-use integer-divides ())
              (#pt-app (#pt-use integer-of-natural ()) prime-number)
              (#pt-app (#pt-use integer-weierstrass-discriminant ()) other-model)))
          (
            (#pt-lambda
              (
                (native-model (#pt-use integer-weierstrass-curve ()))
                (native-model-certificate
                  (#pt-app
                    (#pt-use integer-frey-model-certificate ())
                    first
                    second
                    exponent
                    native-model)))
              (#pt-app
                (#pt-use frey-package-model-bad-prime-transfer ())
                prime-number
                first
                second
                third
                exponent
                package
                native-model
                native-model-certificate
                other-model
                other-model-certificate
                prime-proof
                coordinate-divides)))
          (#pt-app (#pt-use frey-package-has-integral-model ()) first second third exponent package))))))
