(#theorem ring-polynomial-cons-congruent
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-head Carrier)
    (#parameter second-head Carrier)
    (#parameter first-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter second-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter head-equation (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring first-head second-head))
    (#parameter tail-equation (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring first-polynomial second-polynomial)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-equal ())
      Carrier
      coefficient-ring
      (#pt-construct finite-list () (Carrier) cons (first-head first-polynomial))
      (#pt-construct finite-list () (Carrier) cons (second-head second-polynomial))))
  (#proof
    (#pt-lambda
      ((coefficient-index #pt-nat))
      (#pt-nat-induct
        (#pt-lambda
          ((selected-index #pt-nat))
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-coefficient ())
              Carrier
              coefficient-ring
              (#pt-construct finite-list () (Carrier) cons (first-head first-polynomial))
              selected-index)
            (#pt-app
              (#pt-use ring-polynomial-coefficient ())
              Carrier
              coefficient-ring
              (#pt-construct finite-list () (Carrier) cons (second-head second-polynomial))
              selected-index)))
        head-equation
        (#pt-lambda
          (
            (previous-index #pt-nat)
            (ignored-index-proof
              (#pt-app
                (#pt-use ring-equal ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-polynomial-coefficient ())
                  Carrier
                  coefficient-ring
                  (#pt-construct finite-list () (Carrier) cons (first-head first-polynomial))
                  previous-index)
                (#pt-app
                  (#pt-use ring-polynomial-coefficient ())
                  Carrier
                  coefficient-ring
                  (#pt-construct finite-list () (Carrier) cons (second-head second-polynomial))
                  previous-index))))
          (#pt-app
            (#pt-lambda ((tail-index #pt-nat)) (#pt-app tail-equation tail-index))
            previous-index))
        coefficient-index))))
