              #pt-nat
              (#pt-lambda
                ((candidate-order #pt-nat))
                (#pt-app (#pt-use eisenstein-lambda-order ()) third candidate-order)))))
        (#pt-app
          (#pt-use exists (0))
          #pt-nat
          (#pt-lambda
            ((candidate-order #pt-nat))
            (#pt-app
              (#pt-use eisenstein-cubic-ordered-solution ())
              first
              second
              third
              unit
              candidate-order))))
      (
        (#pt-lambda
          (
            (third-order #pt-nat)
            (order-certificate (#pt-app (#pt-use eisenstein-lambda-order ()) third third-order)))
          (#pt-construct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-order #pt-nat))
                (#pt-app
                  (#pt-use eisenstein-cubic-ordered-solution ())
                  first
                  second
                  third
                  unit
                  candidate-order)))
            introduce
            (third-order
              (#pt-app
                (#pt-use conjunction-introduce ())
                (#pt-app (#pt-use eisenstein-cubic-solution-certificate ()) first second third unit)
                (#pt-app (#pt-use eisenstein-lambda-order ()) third third-order)
                solution-certificate
                order-certificate)))))
      (#pt-app
        (#pt-use eisenstein-lambda-order-exists ())
        third
        (#pt-app
          (#pt-use conjunction-left ())
          (#pt-pi
            (
              (denied-proof
                (#pt-app (#pt-use eisenstein-equal ()) third (#pt-use eisenstein-zero ()))))
            #pt-false)
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app (#pt-use eisenstein-coprime ()) first second)
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) third)
              (#pt-app
                (#pt-use eisenstein-equal ())
                (#pt-app
                  (#pt-use eisenstein-add ())
                  (#pt-app (#pt-use eisenstein-power ()) first (#pt-numeral 3))
                  (#pt-app (#pt-use eisenstein-power ()) second (#pt-numeral 3)))
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  unit
                  (#pt-app (#pt-use eisenstein-power ()) third (#pt-numeral 3))))))
          (#pt-app
            (#pt-use conjunction-right ())
            (#pt-pi
              (
                (denied-proof
                  (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) second)))
              #pt-false)
            (#pt-app
              (#pt-use conjunction ())
              (#pt-pi
                (
                  (denied-proof
                    (#pt-app (#pt-use eisenstein-equal ()) third (#pt-use eisenstein-zero ()))))
                #pt-false)
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use eisenstein-coprime ()) first second)
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) third)
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app
                      (#pt-use eisenstein-add ())
                      (#pt-app (#pt-use eisenstein-power ()) first (#pt-numeral 3))
                      (#pt-app (#pt-use eisenstein-power ()) second (#pt-numeral 3)))
                    (#pt-app
                      (#pt-use eisenstein-multiply ())
                      unit
                      (#pt-app (#pt-use eisenstein-power ()) third (#pt-numeral 3)))))))
            (#pt-app
              (#pt-use conjunction-right ())
              (#pt-pi
                (
                  (denied-proof
                    (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) first)))
                #pt-false)
              (#pt-app
                (#pt-use conjunction ())
                (#pt-pi
                  (
                    (denied-proof
