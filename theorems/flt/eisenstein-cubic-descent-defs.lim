                  (#pt-use eisenstein ())
                  (#pt-lambda
                    ((candidate-unit (#pt-use eisenstein ())))
                    (#pt-app
                      (#pt-use exists (0))
                      #pt-nat
                      (#pt-lambda
                        ((candidate-order #pt-nat))
                        (#pt-app
                          (#pt-use conjunction ())
                          (#pt-app (#pt-use less-than ()) candidate-order third-order)
                          (#pt-app
                            (#pt-use eisenstein-cubic-ordered-solution ())
                            candidate-first
                            candidate-second
                            candidate-third
                            candidate-unit
