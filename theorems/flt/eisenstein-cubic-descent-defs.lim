(#math-definition eisenstein-cubic-solution-certificate ()
  (#pt-pi
    (
      (first (#pt-use eisenstein ()))
      (second (#pt-use eisenstein ()))
      (third (#pt-use eisenstein ()))
      (unit (#pt-use eisenstein ())))
    #pt-prop)
  (#pt-lambda
    (
      (first (#pt-use eisenstein ()))
      (second (#pt-use eisenstein ()))
      (third (#pt-use eisenstein ()))
      (unit (#pt-use eisenstein ())))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app (#pt-use eisenstein-unit ()) unit)
      (#pt-app
        (#pt-use conjunction ())
        (#pt-pi
          (
            (denied-proof
              (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) first)))
          #pt-false)
        (#pt-app
          (#pt-use conjunction ())
          (#pt-pi
            (
              (denied-proof
                (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) second)))
            #pt-false)
          (#pt-app
            (#pt-use conjunction ())
            (#pt-pi
              (
                (denied-proof
                  (#pt-app (#pt-use eisenstein-equal ()) third (#pt-use eisenstein-zero ()))))
              #pt-false)
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app (#pt-use eisenstein-coprime ()) first second)
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) third)
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app
                    (#pt-use eisenstein-add ())
                    (#pt-app (#pt-use eisenstein-power ()) first (#pt-numeral 3))
                    (#pt-app (#pt-use eisenstein-power ()) second (#pt-numeral 3)))
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    unit
                    (#pt-app (#pt-use eisenstein-power ()) third (#pt-numeral 3))))))))))))
(#math-definition eisenstein-cubic-ordered-solution ()
  (#pt-pi
    (
      (first (#pt-use eisenstein ()))
      (second (#pt-use eisenstein ()))
      (third (#pt-use eisenstein ()))
      (unit (#pt-use eisenstein ()))
      (third-order #pt-nat))
