                    #pt-false)
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app (#pt-use eisenstein-coprime ()) first second)
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) third)
                      (#pt-app
                        (#pt-use eisenstein-equal ())
