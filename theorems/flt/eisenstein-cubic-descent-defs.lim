(#theorem eisenstein-cubic-solution-has-exact-order
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter third (#pt-use eisenstein ()))
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter solution-certificate (#pt-app (#pt-use eisenstein-cubic-solution-certificate ()) first second third unit)))
  (#statement
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-order #pt-nat))
        (#pt-app
          (#pt-use eisenstein-cubic-ordered-solution ())
          first
          second
          third
          unit
          candidate-order))))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-order #pt-nat))
          (#pt-app (#pt-use eisenstein-lambda-order ()) third candidate-order)))
      (#pt-lambda
        (
          (certificate
            (#pt-app
