      (#pt-app (#pt-use eisenstein-cubic-solution-certificate ()) first second third unit)
      (#pt-app (#pt-use eisenstein-lambda-order ()) third third-order))))
(#math-definition eisenstein-has-smaller-cubic-solution ()
  (#pt-pi ((third-order #pt-nat)) #pt-prop)
  (#pt-lambda
    ((third-order #pt-nat))
    (#pt-app
      (#pt-use exists (0))
      (#pt-use eisenstein ())
      (#pt-lambda
        ((candidate-first (#pt-use eisenstein ())))
        (#pt-app
          (#pt-use exists (0))
          (#pt-use eisenstein ())
          (#pt-lambda
            ((candidate-second (#pt-use eisenstein ())))
