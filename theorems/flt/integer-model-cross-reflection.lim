; Reflect c4^3*Delta cross identities through the proved invariant
; maps and faithful integer-to-rational embedding. No cancellation,
; model-change property or nonzero-discriminant premise is assumed.
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-power = ./integer-defs.lim::integer-power)
(#alias rational-equal = ./rational-defs.lim::rational-equal)
(#alias rational-of-integer = ./rational-defs.lim::rational-of-integer)
(#alias rational-multiply = ./rational-defs.lim::rational-multiply)
(#alias rational-power = ./rational-defs.lim::rational-power)
(#alias rational-reflexive = ./rational-equality.lim::rational-reflexive)
(#alias rational-symmetric = ./rational-equality.lim::rational-symmetric)
(#alias rational-transitive = ./rational-equality.lim::rational-transitive)
(#alias rational-multiply-congruent = ./rational-congruence.lim::rational-multiply-congruent)
(#alias rational-weierstrass-c4 = ./rational-weierstrass-defs.lim::rational-weierstrass-c4)
(#alias
  rational-weierstrass-discriminant
  =
  ./rational-weierstrass-defs.lim::rational-weierstrass-discriminant)
(#alias rational-of-integer-multiply = ./rational-congruence.lim::rational-of-integer-multiply)
(#alias rational-of-integer-power = ./rational-embedding-laws.lim::rational-of-integer-power)
(#alias rational-power-congruent = ./rational-fractions.lim::rational-power-congruent)
(#alias integer-weierstrass-curve = ./integer-weierstrass-defs.lim::integer-weierstrass-curve)
(#alias
  integer-weierstrass-map-rational
  =
  ./integer-weierstrass-defs.lim::integer-weierstrass-map-rational)
(#alias integer-weierstrass-c4 = ./integer-weierstrass-defs.lim::integer-weierstrass-c4)
(#alias
  integer-weierstrass-discriminant
  =
  ./integer-weierstrass-defs.lim::integer-weierstrass-discriminant)
(#alias integer-weierstrass-c4-map = ./integer-weierstrass-map.lim::integer-weierstrass-c4-map)
(#alias
  integer-weierstrass-discriminant-map
  =
  ./integer-weierstrass-map.lim::integer-weierstrass-discriminant-map)
(#alias
  rational-integer-embedding-injective
  =
  ./rational-fractions.lim::rational-integer-embedding-injective)
(#theorem integer-cross-invariants-map
  (#universes)
  (#parameters
    (#parameter first-model (#pt-use integer-weierstrass-curve ()))
    (#parameter second-model (#pt-use integer-weierstrass-curve ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-of-integer ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model)
            (#pt-numeral 3))
          (#pt-app (#pt-use integer-weierstrass-discriminant ()) second-model)))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app
            (#pt-use rational-weierstrass-c4 ())
            (#pt-app (#pt-use integer-weierstrass-map-rational ()) first-model))
          (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-weierstrass-discriminant ())
          (#pt-app (#pt-use integer-weierstrass-map-rational ()) second-model)))))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app
        (#pt-use rational-of-integer ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model)
            (#pt-numeral 3))
          (#pt-app (#pt-use integer-weierstrass-discriminant ()) second-model)))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model)
            (#pt-numeral 3)))
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app (#pt-use integer-weierstrass-discriminant ()) second-model)))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app
            (#pt-use rational-weierstrass-c4 ())
            (#pt-app (#pt-use integer-weierstrass-map-rational ()) first-model))
          (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-weierstrass-discriminant ())
          (#pt-app (#pt-use integer-weierstrass-map-rational ()) second-model)))
      (#pt-app
        (#pt-use rational-symmetric ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model)
              (#pt-numeral 3)))
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app (#pt-use integer-weierstrass-discriminant ()) second-model)))
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model)
              (#pt-numeral 3))
            (#pt-app (#pt-use integer-weierstrass-discriminant ()) second-model)))
        (#pt-app
          (#pt-use rational-of-integer-multiply ())
          (#pt-app
            (#pt-use integer-power ())
            (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model)
            (#pt-numeral 3))
          (#pt-app (#pt-use integer-weierstrass-discriminant ()) second-model)))
      (#pt-app
        (#pt-use rational-transitive ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model)
              (#pt-numeral 3)))
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app (#pt-use integer-weierstrass-discriminant ()) second-model)))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model))
            (#pt-numeral 3))
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app (#pt-use integer-weierstrass-discriminant ()) second-model)))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app
              (#pt-use rational-weierstrass-c4 ())
              (#pt-app (#pt-use integer-weierstrass-map-rational ()) first-model))
            (#pt-numeral 3))
          (#pt-app
            (#pt-use rational-weierstrass-discriminant ())
            (#pt-app (#pt-use integer-weierstrass-map-rational ()) second-model)))
        (#pt-app
          (#pt-use rational-multiply-congruent ())
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model)
              (#pt-numeral 3)))
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app (#pt-use integer-weierstrass-discriminant ()) second-model))
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model))
            (#pt-numeral 3))
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app (#pt-use integer-weierstrass-discriminant ()) second-model))
          (#pt-app
            (#pt-use rational-symmetric ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model))
              (#pt-numeral 3))
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app
                (#pt-use integer-power ())
                (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model)
                (#pt-numeral 3)))
            (#pt-app
              (#pt-use rational-of-integer-power ())
              (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model)
              (#pt-numeral 3)))
          (#pt-app
            (#pt-use rational-reflexive ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-weierstrass-discriminant ()) second-model))))
        (#pt-app
          (#pt-use rational-multiply-congruent ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model))
            (#pt-numeral 3))
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app (#pt-use integer-weierstrass-discriminant ()) second-model))
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app
              (#pt-use rational-weierstrass-c4 ())
              (#pt-app (#pt-use integer-weierstrass-map-rational ()) first-model))
            (#pt-numeral 3))
          (#pt-app
            (#pt-use rational-weierstrass-discriminant ())
            (#pt-app (#pt-use integer-weierstrass-map-rational ()) second-model))
          (#pt-app
            (#pt-use rational-power-congruent ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model))
            (#pt-app
              (#pt-use rational-weierstrass-c4 ())
              (#pt-app (#pt-use integer-weierstrass-map-rational ()) first-model))
            (#pt-numeral 3)
            (#pt-app
              (#pt-use rational-symmetric ())
              (#pt-app
                (#pt-use rational-weierstrass-c4 ())
                (#pt-app (#pt-use integer-weierstrass-map-rational ()) first-model))
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model))
              (#pt-app (#pt-use integer-weierstrass-c4-map ()) first-model)))
          (#pt-app
            (#pt-use rational-symmetric ())
            (#pt-app
              (#pt-use rational-weierstrass-discriminant ())
              (#pt-app (#pt-use integer-weierstrass-map-rational ()) second-model))
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-weierstrass-discriminant ()) second-model))
            (#pt-app (#pt-use integer-weierstrass-discriminant-map ()) second-model)))))))
(#theorem integer-cross-invariants-reflect
  (#universes)
  (#parameters
    (#parameter first-model (#pt-use integer-weierstrass-curve ()))
    (#parameter second-model (#pt-use integer-weierstrass-curve ()))
    (#parameter rational-cross-equation (#pt-app (#pt-use rational-equal ()) (#pt-app (#pt-use rational-multiply ()) (#pt-app (#pt-use rational-power ()) (#pt-app (#pt-use rational-weierstrass-c4 ()) (#pt-app (#pt-use integer-weierstrass-map-rational ()) first-model)) (#pt-numeral 3)) (#pt-app (#pt-use rational-weierstrass-discriminant ()) (#pt-app (#pt-use integer-weierstrass-map-rational ()) second-model))) (#pt-app (#pt-use rational-multiply ()) (#pt-app (#pt-use rational-power ()) (#pt-app (#pt-use rational-weierstrass-c4 ()) (#pt-app (#pt-use integer-weierstrass-map-rational ()) second-model)) (#pt-numeral 3)) (#pt-app (#pt-use rational-weierstrass-discriminant ()) (#pt-app (#pt-use integer-weierstrass-map-rational ()) first-model))))))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model)
          (#pt-numeral 3))
        (#pt-app (#pt-use integer-weierstrass-discriminant ()) second-model))
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app (#pt-use integer-weierstrass-c4 ()) second-model)
          (#pt-numeral 3))
        (#pt-app (#pt-use integer-weierstrass-discriminant ()) first-model))))
  (#proof
    (#pt-app
      (#pt-use rational-integer-embedding-injective ())
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model)
          (#pt-numeral 3))
        (#pt-app (#pt-use integer-weierstrass-discriminant ()) second-model))
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-app
          (#pt-use integer-power ())
          (#pt-app (#pt-use integer-weierstrass-c4 ()) second-model)
          (#pt-numeral 3))
        (#pt-app (#pt-use integer-weierstrass-discriminant ()) first-model))
      (#pt-app
        (#pt-use rational-transitive ())
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app (#pt-use integer-weierstrass-c4 ()) first-model)
              (#pt-numeral 3))
            (#pt-app (#pt-use integer-weierstrass-discriminant ()) second-model)))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app
              (#pt-use rational-weierstrass-c4 ())
              (#pt-app (#pt-use integer-weierstrass-map-rational ()) first-model))
            (#pt-numeral 3))
          (#pt-app
            (#pt-use rational-weierstrass-discriminant ())
            (#pt-app (#pt-use integer-weierstrass-map-rational ()) second-model)))
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app
              (#pt-use integer-power ())
              (#pt-app (#pt-use integer-weierstrass-c4 ()) second-model)
              (#pt-numeral 3))
            (#pt-app (#pt-use integer-weierstrass-discriminant ()) first-model)))
        (#pt-app (#pt-use integer-cross-invariants-map ()) first-model second-model)
        (#pt-app
          (#pt-use rational-transitive ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-app
                (#pt-use rational-weierstrass-c4 ())
                (#pt-app (#pt-use integer-weierstrass-map-rational ()) first-model))
              (#pt-numeral 3))
            (#pt-app
              (#pt-use rational-weierstrass-discriminant ())
              (#pt-app (#pt-use integer-weierstrass-map-rational ()) second-model)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-app
                (#pt-use rational-weierstrass-c4 ())
                (#pt-app (#pt-use integer-weierstrass-map-rational ()) second-model))
              (#pt-numeral 3))
            (#pt-app
              (#pt-use rational-weierstrass-discriminant ())
              (#pt-app (#pt-use integer-weierstrass-map-rational ()) first-model)))
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app
                (#pt-use integer-power ())
                (#pt-app (#pt-use integer-weierstrass-c4 ()) second-model)
                (#pt-numeral 3))
              (#pt-app (#pt-use integer-weierstrass-discriminant ()) first-model)))
          rational-cross-equation
          (#pt-app
            (#pt-use rational-symmetric ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app
                  (#pt-use integer-power ())
                  (#pt-app (#pt-use integer-weierstrass-c4 ()) second-model)
                  (#pt-numeral 3))
                (#pt-app (#pt-use integer-weierstrass-discriminant ()) first-model)))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-app
                  (#pt-use rational-weierstrass-c4 ())
                  (#pt-app (#pt-use integer-weierstrass-map-rational ()) second-model))
                (#pt-numeral 3))
              (#pt-app
                (#pt-use rational-weierstrass-discriminant ())
                (#pt-app (#pt-use integer-weierstrass-map-rational ()) first-model)))
            (#pt-app (#pt-use integer-cross-invariants-map ()) second-model first-model)))))))
