; Rational power and product rearrangements for the actual Frey
; discriminant calculation, proved by Nat induction and explicit ring
; laws. Closed numeral certificates are checked by the native kernel.
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias rational = ./rational-defs.lim::rational)
(#alias rational-equal = ./rational-defs.lim::rational-equal)
(#alias rational-one = ./rational-defs.lim::rational-one)
(#alias rational-of-integer = ./rational-defs.lim::rational-of-integer)
(#alias rational-multiply = ./rational-defs.lim::rational-multiply)
(#alias rational-negate = ./rational-defs.lim::rational-negate)
(#alias rational-power = ./rational-defs.lim::rational-power)
(#alias rational-reflexive = ./rational-equality.lim::rational-reflexive)
(#alias rational-symmetric = ./rational-equality.lim::rational-symmetric)
(#alias rational-transitive = ./rational-equality.lim::rational-transitive)
(#alias rational-multiply-congruent = ./rational-congruence.lim::rational-multiply-congruent)
(#alias rational-multiply-one = ./rational-ring.lim::rational-multiply-one)
(#alias rational-multiply-associative = ./rational-ring.lim::rational-multiply-associative)
(#alias rational-multiply-commutative = ./rational-ring.lim::rational-multiply-commutative)
(#alias rational-of-integer-multiply = ./rational-congruence.lim::rational-of-integer-multiply)
(#alias rational-of-integer-power = ./rational-embedding-laws.lim::rational-of-integer-power)
(#alias rational-multiply-two-negatives = ./rational-sign-laws.lim::rational-multiply-two-negatives)
(#theorem rational-power-one
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app (#pt-use rational-power ()) first (#pt-succ #pt-zero))
      first))
  (#proof (#pt-app (#pt-use rational-multiply-one ()) first)))
(#theorem rational-power-two
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app (#pt-use rational-power ()) first (#pt-succ (#pt-succ #pt-zero)))
      (#pt-app (#pt-use rational-multiply ()) first first)))
  (#proof
    (#pt-app
      (#pt-use rational-multiply-congruent ())
      first
      (#pt-app (#pt-use rational-multiply ()) first (#pt-use rational-one ()))
      first
      first
      (#pt-app (#pt-use rational-reflexive ()) first)
      (#pt-app (#pt-use rational-multiply-one ()) first))))
(#theorem rational-multiply-swap-inner
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter second (#pt-use rational ()))
    (#parameter third (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-multiply ())
        first
        (#pt-app (#pt-use rational-multiply ()) second third))
      (#pt-app
        (#pt-use rational-multiply ())
        second
        (#pt-app (#pt-use rational-multiply ()) first third))))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app
        (#pt-use rational-multiply ())
        first
        (#pt-app (#pt-use rational-multiply ()) second third))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app (#pt-use rational-multiply ()) first second)
        third)
      (#pt-app
        (#pt-use rational-multiply ())
        second
        (#pt-app (#pt-use rational-multiply ()) first third))
      (#pt-app
        (#pt-use rational-symmetric ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app (#pt-use rational-multiply ()) first second)
          third)
        (#pt-app
          (#pt-use rational-multiply ())
          first
          (#pt-app (#pt-use rational-multiply ()) second third))
        (#pt-app (#pt-use rational-multiply-associative ()) first second third))
      (#pt-app
        (#pt-use rational-transitive ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app (#pt-use rational-multiply ()) first second)
          third)
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app (#pt-use rational-multiply ()) second first)
          third)
        (#pt-app
          (#pt-use rational-multiply ())
          second
          (#pt-app (#pt-use rational-multiply ()) first third))
        (#pt-app
          (#pt-use rational-multiply-congruent ())
          (#pt-app (#pt-use rational-multiply ()) first second)
          third
          (#pt-app (#pt-use rational-multiply ()) second first)
          third
          (#pt-app (#pt-use rational-multiply-commutative ()) first second)
          (#pt-app (#pt-use rational-reflexive ()) third))
        (#pt-app (#pt-use rational-multiply-associative ()) second first third)))))
(#theorem rational-multiply-four-interchange
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter second (#pt-use rational ()))
    (#parameter third (#pt-use rational ()))
    (#parameter fourth (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app (#pt-use rational-multiply ()) first second)
        (#pt-app (#pt-use rational-multiply ()) third fourth))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app (#pt-use rational-multiply ()) first third)
        (#pt-app (#pt-use rational-multiply ()) second fourth))))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app (#pt-use rational-multiply ()) first second)
        (#pt-app (#pt-use rational-multiply ()) third fourth))
      (#pt-app
        (#pt-use rational-multiply ())
        first
        (#pt-app
          (#pt-use rational-multiply ())
          second
          (#pt-app (#pt-use rational-multiply ()) third fourth)))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app (#pt-use rational-multiply ()) first third)
        (#pt-app (#pt-use rational-multiply ()) second fourth))
      (#pt-app
        (#pt-use rational-multiply-associative ())
        first
        second
        (#pt-app (#pt-use rational-multiply ()) third fourth))
      (#pt-app
        (#pt-use rational-transitive ())
        (#pt-app
          (#pt-use rational-multiply ())
          first
          (#pt-app
            (#pt-use rational-multiply ())
            second
            (#pt-app (#pt-use rational-multiply ()) third fourth)))
        (#pt-app
          (#pt-use rational-multiply ())
          first
          (#pt-app
            (#pt-use rational-multiply ())
            third
            (#pt-app (#pt-use rational-multiply ()) second fourth)))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app (#pt-use rational-multiply ()) first third)
          (#pt-app (#pt-use rational-multiply ()) second fourth))
        (#pt-app
          (#pt-use rational-multiply-congruent ())
          first
          (#pt-app
            (#pt-use rational-multiply ())
            second
            (#pt-app (#pt-use rational-multiply ()) third fourth))
          first
          (#pt-app
            (#pt-use rational-multiply ())
            third
            (#pt-app (#pt-use rational-multiply ()) second fourth))
          (#pt-app (#pt-use rational-reflexive ()) first)
          (#pt-app (#pt-use rational-multiply-swap-inner ()) second third fourth))
        (#pt-app
          (#pt-use rational-symmetric ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app (#pt-use rational-multiply ()) first third)
            (#pt-app (#pt-use rational-multiply ()) second fourth))
          (#pt-app
            (#pt-use rational-multiply ())
            first
            (#pt-app
              (#pt-use rational-multiply ())
              third
              (#pt-app (#pt-use rational-multiply ()) second fourth)))
          (#pt-app
            (#pt-use rational-multiply-associative ())
            first
            third
            (#pt-app (#pt-use rational-multiply ()) second fourth)))))))
(#theorem rational-power-product
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter second (#pt-use rational ()))
    (#parameter exponent #pt-nat))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-power ())
        (#pt-app (#pt-use rational-multiply ()) first second)
        exponent)
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app (#pt-use rational-power ()) first exponent)
        (#pt-app (#pt-use rational-power ()) second exponent))))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((index #pt-nat))
        (#pt-app
          (#pt-use rational-equal ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app (#pt-use rational-multiply ()) first second)
            index)
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app (#pt-use rational-power ()) first index)
            (#pt-app (#pt-use rational-power ()) second index))))
      (#pt-app
        (#pt-use rational-symmetric ())
        (#pt-app (#pt-use rational-multiply ()) (#pt-use rational-one ()) (#pt-use rational-one ()))
        (#pt-use rational-one ())
        (#pt-app (#pt-use rational-multiply-one ()) (#pt-use rational-one ())))
      (#pt-lambda
        (
          (previous-exponent #pt-nat)
          (previous-product
            (#pt-app
              (#pt-use rational-equal ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-app (#pt-use rational-multiply ()) first second)
                previous-exponent)
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app (#pt-use rational-power ()) first previous-exponent)
                (#pt-app (#pt-use rational-power ()) second previous-exponent)))))
        (#pt-app
          (#pt-use rational-transitive ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app (#pt-use rational-multiply ()) first second)
            (#pt-app
              (#pt-use rational-power ())
              (#pt-app (#pt-use rational-multiply ()) first second)
              previous-exponent))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app (#pt-use rational-multiply ()) first second)
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app (#pt-use rational-power ()) first previous-exponent)
              (#pt-app (#pt-use rational-power ()) second previous-exponent)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-multiply ())
              first
              (#pt-app (#pt-use rational-power ()) first previous-exponent))
            (#pt-app
              (#pt-use rational-multiply ())
              second
              (#pt-app (#pt-use rational-power ()) second previous-exponent)))
          (#pt-app
            (#pt-use rational-multiply-congruent ())
            (#pt-app (#pt-use rational-multiply ()) first second)
            (#pt-app
              (#pt-use rational-power ())
              (#pt-app (#pt-use rational-multiply ()) first second)
              previous-exponent)
            (#pt-app (#pt-use rational-multiply ()) first second)
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app (#pt-use rational-power ()) first previous-exponent)
              (#pt-app (#pt-use rational-power ()) second previous-exponent))
            (#pt-app
              (#pt-use rational-reflexive ())
              (#pt-app (#pt-use rational-multiply ()) first second))
            previous-product)
          (#pt-app
            (#pt-use rational-multiply-four-interchange ())
            first
            second
            (#pt-app (#pt-use rational-power ()) first previous-exponent)
            (#pt-app (#pt-use rational-power ()) second previous-exponent))))
      exponent)))
(#theorem rational-square-negative
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-power ())
        (#pt-app (#pt-use rational-negate ()) first)
        (#pt-succ (#pt-succ #pt-zero)))
      (#pt-app (#pt-use rational-power ()) first (#pt-succ (#pt-succ #pt-zero)))))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app
        (#pt-use rational-power ())
        (#pt-app (#pt-use rational-negate ()) first)
        (#pt-succ (#pt-succ #pt-zero)))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app (#pt-use rational-negate ()) first)
        (#pt-app (#pt-use rational-negate ()) first))
      (#pt-app (#pt-use rational-power ()) first (#pt-succ (#pt-succ #pt-zero)))
      (#pt-app (#pt-use rational-power-two ()) (#pt-app (#pt-use rational-negate ()) first))
      (#pt-app
        (#pt-use rational-transitive ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app (#pt-use rational-negate ()) first)
          (#pt-app (#pt-use rational-negate ()) first))
        (#pt-app (#pt-use rational-multiply ()) first first)
        (#pt-app (#pt-use rational-power ()) first (#pt-succ (#pt-succ #pt-zero)))
        (#pt-app (#pt-use rational-multiply-two-negatives ()) first first)
        (#pt-app
          (#pt-use rational-symmetric ())
          (#pt-app (#pt-use rational-power ()) first (#pt-succ (#pt-succ #pt-zero)))
          (#pt-app (#pt-use rational-multiply ()) first first)
          (#pt-app (#pt-use rational-power-two ()) first))))))
(#theorem rational-two-cubed
  (#universes)
  (#parameters)
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-power ())
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2)))
        (#pt-numeral 3))
      (#pt-app
        (#pt-use rational-of-integer ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 8)))))
  (#proof
    (#pt-app
      (#pt-use rational-of-integer-power ())
      (#pt-app (#pt-use integer-of-natural ()) (#pt-succ (#pt-succ #pt-zero)))
      (#pt-numeral 3))))
(#theorem rational-eight-times-eight
  (#universes)
  (#parameters)
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 8)))
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 8))))
      (#pt-app
        (#pt-use rational-of-integer ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 64)))))
  (#proof
    (#pt-app
      (#pt-use rational-of-integer-multiply ())
      (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 8))
      (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 8)))))
