; Adapted source: pinned Mathlib Affine/Point.lean:409-470.
; All polynomial, coefficient-domain and index facts are proved.
; Generated by scripts/generate-flt-norm-degrees.py; checked native terms.
; A witnessed strict gap selects the corresponding
; operand of the actual computed maximum, proved by Nat equality
; transport and the recursive maximum gap equations.
(#alias add = ./../fermat_statement.lim::add)
(#alias add-successor-right = ./natural-addition.lim::add-successor-right)
(#alias
  coordinate-norm-degree-maximum
  =
  ./coordinate-norm-degree-maximum.lim::coordinate-norm-degree-maximum)
(#alias
  coordinate-norm-degree-maximum-gap-left
  =
  ./coordinate-norm-degree-maximum.lim::coordinate-norm-degree-maximum-gap-left)
(#alias
  coordinate-norm-degree-maximum-gap-right
  =
  ./coordinate-norm-degree-maximum.lim::coordinate-norm-degree-maximum-gap-right)
(#alias substitution = ./equality.lim::substitution)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#theorem coordinate-norm-degree-maximum-strict-right
  (#universes)
  (#parameters
    (#parameter first-index #pt-nat)
    (#parameter second-index #pt-nat)
    (#parameter gap #pt-nat)
    (#parameter strict-gap (#pt-eq #pt-nat second-index (#pt-app (#pt-use add ()) (#pt-succ first-index) gap))))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use coordinate-norm-degree-maximum ()) first-index second-index)
      second-index))
  (#proof
    (#pt-app
      (#pt-use substitution (0))
      #pt-nat
      (#pt-lambda
        ((selected-upper #pt-nat))
        (#pt-eq
          #pt-nat
          (#pt-app (#pt-use coordinate-norm-degree-maximum ()) first-index selected-upper)
          selected-upper))
      (#pt-app (#pt-use add ()) first-index (#pt-succ gap))
      second-index
      (#pt-app
        (#pt-use symmetry (0))
        #pt-nat
        second-index
        (#pt-app (#pt-use add ()) first-index (#pt-succ gap))
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          second-index
          (#pt-app (#pt-use add ()) (#pt-succ first-index) gap)
          (#pt-app (#pt-use add ()) first-index (#pt-succ gap))
          strict-gap
          (#pt-app
            (#pt-use symmetry (0))
            #pt-nat
            (#pt-app (#pt-use add ()) first-index (#pt-succ gap))
            (#pt-app (#pt-use add ()) (#pt-succ first-index) gap)
            (#pt-app (#pt-use add-successor-right ()) first-index gap))))
      (#pt-app (#pt-use coordinate-norm-degree-maximum-gap-right ()) first-index (#pt-succ gap)))))
(#theorem coordinate-norm-degree-maximum-strict-left
  (#universes)
  (#parameters
    (#parameter first-index #pt-nat)
    (#parameter second-index #pt-nat)
    (#parameter gap #pt-nat)
    (#parameter strict-gap (#pt-eq #pt-nat second-index (#pt-app (#pt-use add ()) (#pt-succ first-index) gap))))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use coordinate-norm-degree-maximum ()) second-index first-index)
      second-index))
  (#proof
    (#pt-app
      (#pt-use substitution (0))
      #pt-nat
      (#pt-lambda
        ((selected-upper #pt-nat))
        (#pt-eq
          #pt-nat
          (#pt-app (#pt-use coordinate-norm-degree-maximum ()) selected-upper first-index)
          selected-upper))
      (#pt-app (#pt-use add ()) first-index (#pt-succ gap))
      second-index
      (#pt-app
        (#pt-use symmetry (0))
        #pt-nat
        second-index
        (#pt-app (#pt-use add ()) first-index (#pt-succ gap))
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          second-index
          (#pt-app (#pt-use add ()) (#pt-succ first-index) gap)
          (#pt-app (#pt-use add ()) first-index (#pt-succ gap))
          strict-gap
          (#pt-app
            (#pt-use symmetry (0))
            #pt-nat
            (#pt-app (#pt-use add ()) first-index (#pt-succ gap))
            (#pt-app (#pt-use add ()) (#pt-succ first-index) gap)
            (#pt-app (#pt-use add-successor-right ()) first-index gap))))
      (#pt-app (#pt-use coordinate-norm-degree-maximum-gap-left ()) first-index (#pt-succ gap)))))
