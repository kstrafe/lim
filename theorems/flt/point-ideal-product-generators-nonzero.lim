; Adapted mathematical source: pinned Mathlib RingTheory/Ideal/Operations.lean
; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean.
; Generated by scripts/generate-flt-point-ideal-products.py; checked native terms.
; Actual X-x and Y-y classes
; cannot be zero: their respective coefficient-one entries
; contradict the checked field one-nonzero certificate.
; No coordinate nonzero or fractional-ideal witness is assumed.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias
  coordinate-point-ideal-X-class
  =
  ./coordinate-point-ideal-data.lim::coordinate-point-ideal-X-class)
(#alias
  coordinate-point-ideal-Y-class
  =
  ./coordinate-point-ideal-data.lim::coordinate-point-ideal-Y-class)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias
  point-ideal-product-field-data
  =
  ./point-ideal-product-field-data.lim::point-ideal-product-field-data)
(#alias
  point-ideal-product-field-one-nonzero
  =
  ./point-ideal-product-field-data.lim::point-ideal-product-field-one-nonzero)
(#alias quadratic-equal = ./quadratic-algebra-data.lim::quadratic-equal)
(#alias quadratic-zero = ./quadratic-algebra-data.lim::quadratic-zero)
(#alias ring-polynomial-structure = ./ring-polynomial-structure.lim::ring-polynomial-structure)
(#theorem point-ideal-product-X-nonzero
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter root Carrier)
    (#parameter ordinate Carrier)
    (#parameter field-data (#pt-app (#pt-use point-ideal-product-field-data ()) Carrier coefficient-ring)))
  (#statement
    (#pt-pi
      (
        (denied-evidence
          (#pt-app
            (#pt-use quadratic-equal ())
            (#pt-app (#pt-use finite-list ()) Carrier)
            (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
            (#pt-app (#pt-use coordinate-point-ideal-X-class ()) Carrier coefficient-ring root)
            (#pt-app
              (#pt-use quadratic-zero ())
              (#pt-app (#pt-use finite-list ()) Carrier)
              (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (zero-equation
          (#pt-app
            (#pt-use quadratic-equal ())
            (#pt-app (#pt-use finite-list ()) Carrier)
            (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
            (#pt-app (#pt-use coordinate-point-ideal-X-class ()) Carrier coefficient-ring root)
            (#pt-app
              (#pt-use quadratic-zero ())
              (#pt-app (#pt-use finite-list ()) Carrier)
              (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)))))
      (#pt-app
        (#pt-app
          (#pt-use point-ideal-product-field-one-nonzero ())
          Carrier
          coefficient-ring
          field-data)
        (#pt-app (#pt-project conjunction 0 zero-equation) (#pt-numeral 1))))))
(#theorem point-ideal-product-Y-nonzero
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter root Carrier)
    (#parameter ordinate Carrier)
    (#parameter field-data (#pt-app (#pt-use point-ideal-product-field-data ()) Carrier coefficient-ring)))
  (#statement
    (#pt-pi
      (
        (denied-evidence
          (#pt-app
            (#pt-use quadratic-equal ())
            (#pt-app (#pt-use finite-list ()) Carrier)
            (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
            (#pt-app
              (#pt-use coordinate-point-ideal-Y-class ())
              Carrier
              coefficient-ring
              (#pt-construct
                finite-list
                ()
                (Carrier)
                cons
                (ordinate (#pt-construct finite-list () (Carrier) nil ()))))
            (#pt-app
              (#pt-use quadratic-zero ())
              (#pt-app (#pt-use finite-list ()) Carrier)
              (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (zero-equation
          (#pt-app
            (#pt-use quadratic-equal ())
            (#pt-app (#pt-use finite-list ()) Carrier)
            (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
            (#pt-app
              (#pt-use coordinate-point-ideal-Y-class ())
              Carrier
              coefficient-ring
              (#pt-construct
                finite-list
                ()
                (Carrier)
                cons
                (ordinate (#pt-construct finite-list () (Carrier) nil ()))))
            (#pt-app
              (#pt-use quadratic-zero ())
              (#pt-app (#pt-use finite-list ()) Carrier)
              (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)))))
      (#pt-app
        (#pt-app
          (#pt-use point-ideal-product-field-one-nonzero ())
          Carrier
          coefficient-ring
          field-data)
        (#pt-app (#pt-project conjunction 1 zero-equation) #pt-zero)))))
