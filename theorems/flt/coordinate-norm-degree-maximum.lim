; Adapted source: pinned Mathlib Affine/Point.lean:409-470.
; All polynomial, coefficient-domain and index facts are proved.
; Generated by scripts/generate-flt-norm-degrees.py; checked native terms.
; Compute Nat maximum by structural recursion and prove
; its exact gap-left/gap-right equations. No desired ordering law
; is added as a kernel reduction or assumed arithmetic certificate.
(#alias add = ./../fermat_statement.lim::add)
(#alias congruence = ./equality.lim::congruence)
(#math-definition coordinate-norm-degree-maximum ()
  (#pt-pi ((first-index #pt-nat) (second-index #pt-nat)) #pt-nat)
  (#pt-lambda
    ((first-index #pt-nat) (second-index #pt-nat))
    (#pt-app
      (#pt-nat-induct
        (#pt-lambda ((first-subject #pt-nat)) (#pt-pi ((second-index-bound-0000 #pt-nat)) #pt-nat))
        (#pt-lambda ((second-index-bound-0001 #pt-nat)) second-index-bound-0001)
        (#pt-lambda
          (
            (previous-first #pt-nat)
            (previous-maximum (#pt-pi ((second-index-bound-0002 #pt-nat)) #pt-nat)))
          (#pt-lambda
            ((second-index-bound-0003 #pt-nat))
            (#pt-nat-induct
              (#pt-lambda ((second-subject #pt-nat)) #pt-nat)
              (#pt-succ previous-first)
              (#pt-lambda
                ((previous-second #pt-nat) (unused-second-result #pt-nat))
                (#pt-succ (#pt-app previous-maximum previous-second)))
              second-index-bound-0003)))
        first-index)
      second-index)))
(#theorem coordinate-norm-degree-maximum-zero-right
  (#universes)
  (#parameters
    (#parameter first-index #pt-nat))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use coordinate-norm-degree-maximum ()) first-index #pt-zero)
      first-index))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((selected-index #pt-nat))
        (#pt-eq
          #pt-nat
          (#pt-app (#pt-use coordinate-norm-degree-maximum ()) selected-index #pt-zero)
          selected-index))
      (#pt-refl #pt-nat #pt-zero)
      (#pt-lambda
        (
          (previous-index #pt-nat)
          (unused-maximum-proof
            (#pt-eq
              #pt-nat
              (#pt-app (#pt-use coordinate-norm-degree-maximum ()) previous-index #pt-zero)
              previous-index)))
        (#pt-refl #pt-nat (#pt-succ previous-index)))
      first-index)))
(#theorem coordinate-norm-degree-maximum-gap-right
  (#universes)
  (#parameters
    (#parameter first-index #pt-nat)
    (#parameter gap #pt-nat))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app
        (#pt-use coordinate-norm-degree-maximum ())
        first-index
        (#pt-app (#pt-use add ()) first-index gap))
      (#pt-app (#pt-use add ()) first-index gap)))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((selected-index #pt-nat))
        (#pt-eq
          #pt-nat
          (#pt-app
            (#pt-use coordinate-norm-degree-maximum ())
            selected-index
            (#pt-app (#pt-use add ()) selected-index gap))
          (#pt-app (#pt-use add ()) selected-index gap)))
      (#pt-refl #pt-nat gap)
      (#pt-lambda
        (
          (previous-index #pt-nat)
          (previous-maximum-proof
            (#pt-eq
              #pt-nat
              (#pt-app
                (#pt-use coordinate-norm-degree-maximum ())
                previous-index
                (#pt-app (#pt-use add ()) previous-index gap))
              (#pt-app (#pt-use add ()) previous-index gap))))
        (#pt-app
          (#pt-use congruence (0 0))
          #pt-nat
          #pt-nat
          (#pt-lambda ((index-input #pt-nat)) (#pt-succ index-input))
          (#pt-app
            (#pt-use coordinate-norm-degree-maximum ())
            previous-index
            (#pt-app (#pt-use add ()) previous-index gap))
          (#pt-app (#pt-use add ()) previous-index gap)
          previous-maximum-proof))
      first-index)))
(#theorem coordinate-norm-degree-maximum-gap-left
  (#universes)
  (#parameters
    (#parameter first-index #pt-nat)
    (#parameter gap #pt-nat))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app
        (#pt-use coordinate-norm-degree-maximum ())
        (#pt-app (#pt-use add ()) first-index gap)
        first-index)
      (#pt-app (#pt-use add ()) first-index gap)))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((selected-index #pt-nat))
        (#pt-eq
          #pt-nat
          (#pt-app
            (#pt-use coordinate-norm-degree-maximum ())
            (#pt-app (#pt-use add ()) selected-index gap)
            selected-index)
          (#pt-app (#pt-use add ()) selected-index gap)))
      (#pt-app (#pt-use coordinate-norm-degree-maximum-zero-right ()) gap)
      (#pt-lambda
        (
          (previous-index #pt-nat)
          (previous-maximum-proof
            (#pt-eq
              #pt-nat
              (#pt-app
                (#pt-use coordinate-norm-degree-maximum ())
                (#pt-app (#pt-use add ()) previous-index gap)
                previous-index)
              (#pt-app (#pt-use add ()) previous-index gap))))
        (#pt-app
          (#pt-use congruence (0 0))
          #pt-nat
          #pt-nat
          (#pt-lambda ((index-input #pt-nat)) (#pt-succ index-input))
          (#pt-app
            (#pt-use coordinate-norm-degree-maximum ())
            (#pt-app (#pt-use add ()) previous-index gap)
            previous-index)
          (#pt-app (#pt-use add ()) previous-index gap)
          previous-maximum-proof))
      first-index)))
