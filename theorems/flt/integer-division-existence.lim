                    (#pt-app (#pt-use integer-negative-natural ()) normal-value))))
              (#pt-app
                (#pt-use integer-has-division-congruent-dividend ())
                (#pt-app (#pt-use integer-negative-natural ()) normal-value)
                dividend
                divisor
                (#pt-app
                  (#pt-use integer-symmetric ())
                  dividend
                  (#pt-app (#pt-use integer-negative-natural ()) normal-value)
                  normal-equivalence)
                (#pt-app
                  (#pt-use integer-negative-division-exists ())
                  normal-value
                  divisor
                  positive-divisor))))
          negative-form))
      (#pt-app (#pt-use integer-normal-form ()) dividend))))
