(#theorem integer-of-natural-injective
  (#universes)
  (#parameters
    (#parameter first-natural #pt-nat)
    (#parameter second-natural #pt-nat)
    (#parameter embedded-equivalence (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-of-natural ()) first-natural) (#pt-app (#pt-use integer-of-natural ()) second-natural))))
  (#statement (#pt-eq #pt-nat first-natural second-natural))
  (#proof
    (#pt-app
      (#pt-use add-cancel-right ())
      first-natural
      second-natural
      #pt-zero
      embedded-equivalence)))
(#theorem integer-negative-natural-injective
  (#universes)
  (#parameters
    (#parameter first-natural #pt-nat)
    (#parameter second-natural #pt-nat)
    (#parameter embedded-equivalence (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-negative-natural ()) first-natural) (#pt-app (#pt-use integer-negative-natural ()) second-natural))))
  (#statement (#pt-eq #pt-nat first-natural second-natural))
  (#proof
    (#pt-app (#pt-use symmetry (0)) #pt-nat second-natural first-natural embedded-equivalence)))
