    (#parameter second-equivalence (#pt-app (#pt-use integer-equal ()) second fourth)))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-add ()) first second)
      (#pt-app (#pt-use integer-add ()) third fourth)))
  (#proof
    (#pt-app
      (#pt-use transitivity (0))
      #pt-nat
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 0 second))
        (#pt-app (#pt-use add ()) (#pt-project integer 1 third) (#pt-project integer 1 fourth)))
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 third))
        (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 1 fourth)))
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use add ()) (#pt-project integer 0 third) (#pt-project integer 0 fourth))
        (#pt-app (#pt-use add ()) (#pt-project integer 1 first) (#pt-project integer 1 second)))
      (#pt-app
        (#pt-use sum-four-interchange ())
        (#pt-project integer 0 first)
        (#pt-project integer 0 second)
        (#pt-project integer 1 third)
        (#pt-project integer 1 fourth))
      (#pt-app
        (#pt-use transitivity (0))
        #pt-nat
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 third))
          (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 1 fourth)))
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use add ()) (#pt-project integer 0 third) (#pt-project integer 1 first))
          (#pt-app (#pt-use add ()) (#pt-project integer 0 fourth) (#pt-project integer 1 second)))
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use add ()) (#pt-project integer 0 third) (#pt-project integer 0 fourth))
          (#pt-app (#pt-use add ()) (#pt-project integer 1 first) (#pt-project integer 1 second)))
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 third))
            (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 1 fourth)))
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use add ()) (#pt-project integer 0 third) (#pt-project integer 1 first))
            (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 1 fourth)))
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use add ()) (#pt-project integer 0 third) (#pt-project integer 1 first))
            (#pt-app (#pt-use add ()) (#pt-project integer 0 fourth) (#pt-project integer 1 second)))
          (#pt-app
            (#pt-use congruence (0 0))
            #pt-nat
            #pt-nat
            (#pt-lambda
              ((endpoint #pt-nat))
              (#pt-app
                (#pt-use add ())
                endpoint
                (#pt-app
                  (#pt-use add ())
                  (#pt-project integer 0 second)
                  (#pt-project integer 1 fourth))))
            (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 third))
            (#pt-app (#pt-use add ()) (#pt-project integer 0 third) (#pt-project integer 1 first))
            first-equivalence)
          (#pt-app
            (#pt-use congruence (0 0))
            #pt-nat
            #pt-nat
            (#pt-lambda
              ((endpoint #pt-nat))
              (#pt-app
                (#pt-use add ())
                (#pt-app
                  (#pt-use add ())
                  (#pt-project integer 0 third)
                  (#pt-project integer 1 first))
                endpoint))
            (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 1 fourth))
            (#pt-app (#pt-use add ()) (#pt-project integer 0 fourth) (#pt-project integer 1 second))
            second-equivalence))
        (#pt-app
          (#pt-use sum-four-interchange ())
          (#pt-project integer 0 third)
          (#pt-project integer 1 first)
          (#pt-project integer 0 fourth)
          (#pt-project integer 1 second))))))
(#theorem integer-multiply-congruent-first
