; Explicit equivalence and congruence of formal differences.
; These propositions relate integer representations; they do not equate
; distinct records using the kernel identity type or an unchecked quotient.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-negative-natural = ./integer-defs.lim::integer-negative-natural)
(#alias integer-zero = ./integer-defs.lim::integer-zero)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-cube = ./integer-defs.lim::integer-cube)
(#alias add-cancel-right = ./natural-cancellation.lim::add-cancel-right)
(#alias add-zero-right = ./natural-addition.lim::add-zero-right)
(#alias add-commutative = ./natural-addition.lim::add-commutative)
(#alias sum-three-permutation = ./integer-cross-identities.lim::sum-three-permutation)
(#alias sum-four-interchange = ./integer-cross-identities.lim::sum-four-interchange)
(#alias product-cross-group = ./integer-cross-identities.lim::product-cross-group)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias congruence = ./equality.lim::congruence)
(#theorem integer-reflexive
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ())))
  (#statement (#pt-app (#pt-use integer-equal ()) first first))
  (#proof
    (#pt-refl
      #pt-nat
      (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 first)))))
(#theorem integer-symmetric
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter equivalent (#pt-app (#pt-use integer-equal ()) first second)))
  (#statement (#pt-app (#pt-use integer-equal ()) second first))
  (#proof
    (#pt-app
      (#pt-use symmetry (0))
      #pt-nat
      (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 second))
      (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 1 first))
      equivalent)))
(#theorem integer-transitive
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter first-equivalence (#pt-app (#pt-use integer-equal ()) first second))
    (#parameter second-equivalence (#pt-app (#pt-use integer-equal ()) second third)))
  (#statement (#pt-app (#pt-use integer-equal ()) first third))
  (#proof
    (#pt-app
      (#pt-use add-cancel-right ())
      (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 third))
      (#pt-app (#pt-use add ()) (#pt-project integer 0 third) (#pt-project integer 1 first))
      (#pt-project integer 1 second)
      (#pt-app
        (#pt-use transitivity (0))
        #pt-nat
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 third))
          (#pt-project integer 1 second))
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 second))
          (#pt-project integer 1 third))
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use add ()) (#pt-project integer 0 third) (#pt-project integer 1 first))
          (#pt-project integer 1 second))
        (#pt-app
          (#pt-use sum-three-permutation ())
          (#pt-project integer 0 first)
          (#pt-project integer 1 third)
          (#pt-project integer 1 second))
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 second))
            (#pt-project integer 1 third))
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 1 first))
            (#pt-project integer 1 third))
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use add ()) (#pt-project integer 0 third) (#pt-project integer 1 first))
            (#pt-project integer 1 second))
          (#pt-app
            (#pt-use congruence (0 0))
            #pt-nat
            #pt-nat
            (#pt-lambda
              ((endpoint #pt-nat))
              (#pt-app (#pt-use add ()) endpoint (#pt-project integer 1 third)))
            (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 second))
            (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 1 first))
            first-equivalence)
          (#pt-app
            (#pt-use transitivity (0))
            #pt-nat
            (#pt-app
              (#pt-use add ())
              (#pt-app
                (#pt-use add ())
                (#pt-project integer 0 second)
                (#pt-project integer 1 first))
              (#pt-project integer 1 third))
            (#pt-app
              (#pt-use add ())
              (#pt-app
                (#pt-use add ())
                (#pt-project integer 0 second)
                (#pt-project integer 1 third))
              (#pt-project integer 1 first))
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use add ()) (#pt-project integer 0 third) (#pt-project integer 1 first))
              (#pt-project integer 1 second))
            (#pt-app
              (#pt-use sum-three-permutation ())
              (#pt-project integer 0 second)
              (#pt-project integer 1 first)
              (#pt-project integer 1 third))
            (#pt-app
              (#pt-use transitivity (0))
              #pt-nat
              (#pt-app
                (#pt-use add ())
                (#pt-app
                  (#pt-use add ())
                  (#pt-project integer 0 second)
                  (#pt-project integer 1 third))
                (#pt-project integer 1 first))
              (#pt-app
                (#pt-use add ())
                (#pt-app
                  (#pt-use add ())
                  (#pt-project integer 0 third)
                  (#pt-project integer 1 second))
                (#pt-project integer 1 first))
              (#pt-app
                (#pt-use add ())
                (#pt-app
                  (#pt-use add ())
                  (#pt-project integer 0 third)
                  (#pt-project integer 1 first))
                (#pt-project integer 1 second))
              (#pt-app
                (#pt-use congruence (0 0))
                #pt-nat
                #pt-nat
                (#pt-lambda
                  ((endpoint #pt-nat))
                  (#pt-app (#pt-use add ()) endpoint (#pt-project integer 1 first)))
                (#pt-app
                  (#pt-use add ())
                  (#pt-project integer 0 second)
                  (#pt-project integer 1 third))
                (#pt-app
                  (#pt-use add ())
                  (#pt-project integer 0 third)
                  (#pt-project integer 1 second))
                second-equivalence)
              (#pt-app
                (#pt-use sum-three-permutation ())
                (#pt-project integer 0 third)
                (#pt-project integer 1 second)
                (#pt-project integer 1 first)))))))))
(#theorem integer-negate-congruent
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter equivalent (#pt-app (#pt-use integer-equal ()) first second)))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-negate ()) first)
      (#pt-app (#pt-use integer-negate ()) second)))
  (#proof
    (#pt-app
      (#pt-use transitivity (0))
      #pt-nat
      (#pt-app (#pt-use add ()) (#pt-project integer 1 first) (#pt-project integer 0 second))
      (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 1 first))
      (#pt-app (#pt-use add ()) (#pt-project integer 1 second) (#pt-project integer 0 first))
      (#pt-app
        (#pt-use add-commutative ())
        (#pt-project integer 1 first)
        (#pt-project integer 0 second))
      (#pt-app
        (#pt-use transitivity (0))
        #pt-nat
        (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 1 first))
        (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 second))
        (#pt-app (#pt-use add ()) (#pt-project integer 1 second) (#pt-project integer 0 first))
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 second))
          (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 1 first))
          equivalent)
        (#pt-app
          (#pt-use add-commutative ())
          (#pt-project integer 0 first)
          (#pt-project integer 1 second))))))
(#theorem integer-add-congruent
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter fourth (#pt-use integer ()))
