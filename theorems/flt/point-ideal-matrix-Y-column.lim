; Generated by scripts/generate-flt-point-ideal-basis.py; checked native terms.
; Actual multiplication by Y is the second
; column of the existing multiplication matrix. Prove both
; coordinates without assuming the matrix represents multiplication.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias quadratic-Y = ./quadratic-algebra-data.lim::quadratic-Y)
(#alias quadratic-constant = ./quadratic-algebra-data.lim::quadratic-constant)
(#alias quadratic-element = ./quadratic-algebra-data.lim::quadratic-element)
(#alias quadratic-equal = ./quadratic-algebra-data.lim::quadratic-equal)
(#alias quadratic-left-matrix = ./quadratic-algebra-left-matrix.lim::quadratic-left-matrix)
(#alias quadratic-multiply = ./quadratic-algebra-data.lim::quadratic-multiply)
(#alias ring-add = ./commutative-ring-data.lim::ring-add)
(#alias ring-add-congruent = ./commutative-ring-data.lim::ring-add-congruent)
(#alias ring-add-zero = ./commutative-ring-data.lim::ring-add-zero)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-matrix2 = ./ring-matrix2-data.lim::ring-matrix2)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-multiply-congruent = ./commutative-ring-data.lim::ring-multiply-congruent)
(#alias ring-multiply-one = ./commutative-ring-data.lim::ring-multiply-one)
(#alias ring-multiply-zero = ./commutative-ring-data.lim::ring-multiply-zero)
(#alias ring-negate = ./commutative-ring-data.lim::ring-negate)
(#alias ring-negate-congruent = ./commutative-ring-data.lim::ring-negate-congruent)
(#alias ring-one = ./commutative-ring-data.lim::ring-one)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#alias ring-transitive = ./commutative-ring-data.lim::ring-transitive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#alias ring-zero-add = ./commutative-ring-elementary-laws.lim::ring-zero-add)
(#theorem point-ideal-matrix-Y-column
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter quadratic-linear Carrier)
    (#parameter quadratic-constant Carrier)
    (#parameter first-vector (#pt-app (#pt-use quadratic-element ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use quadratic-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use quadratic-multiply ())
        Carrier
        coefficient-ring
        quadratic-linear
        quadratic-constant
        first-vector
        (#pt-app (#pt-use quadratic-Y ()) Carrier coefficient-ring))
      (#pt-construct
        quadratic-element
        ()
        (Carrier)
        coordinates
        (
          (#pt-project
            ring-matrix2
            1
            (#pt-app
              (#pt-use quadratic-left-matrix ())
              Carrier
              coefficient-ring
              quadratic-linear
              quadratic-constant
              first-vector))
          (#pt-project
            ring-matrix2
            3
            (#pt-app
              (#pt-use quadratic-left-matrix ())
              Carrier
              coefficient-ring
              quadratic-linear
              quadratic-constant
              first-vector))))))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-equal ())
        Carrier
        coefficient-ring
        (#pt-project
          quadratic-element
          0
          (#pt-app
            (#pt-use quadratic-multiply ())
            Carrier
            coefficient-ring
            quadratic-linear
            quadratic-constant
            first-vector
            (#pt-app (#pt-use quadratic-Y ()) Carrier coefficient-ring)))
        (#pt-project
          quadratic-element
          0
          (#pt-construct
            quadratic-element
            ()
            (Carrier)
            coordinates
            (
              (#pt-project
                ring-matrix2
                1
                (#pt-app
                  (#pt-use quadratic-left-matrix ())
                  Carrier
                  coefficient-ring
                  quadratic-linear
                  quadratic-constant
                  first-vector))
              (#pt-project
                ring-matrix2
                3
                (#pt-app
                  (#pt-use quadratic-left-matrix ())
                  Carrier
                  coefficient-ring
                  quadratic-linear
                  quadratic-constant
                  first-vector))))))
      (#pt-app
        (#pt-use ring-equal ())
        Carrier
        coefficient-ring
        (#pt-project
          quadratic-element
          1
          (#pt-app
            (#pt-use quadratic-multiply ())
            Carrier
            coefficient-ring
            quadratic-linear
            quadratic-constant
            first-vector
            (#pt-app (#pt-use quadratic-Y ()) Carrier coefficient-ring)))
        (#pt-project
          quadratic-element
          1
          (#pt-construct
            quadratic-element
            ()
            (Carrier)
            coordinates
            (
              (#pt-project
                ring-matrix2
                1
                (#pt-app
                  (#pt-use quadratic-left-matrix ())
                  Carrier
                  coefficient-ring
                  quadratic-linear
                  quadratic-constant
                  first-vector))
              (#pt-project
                ring-matrix2
                3
                (#pt-app
                  (#pt-use quadratic-left-matrix ())
                  Carrier
                  coefficient-ring
                  quadratic-linear
                  quadratic-constant
                  first-vector))))))
      (#pt-app
        (#pt-use ring-transitive ())
        Carrier
        coefficient-ring
        (#pt-project
          quadratic-element
          0
          (#pt-app
            (#pt-use quadratic-multiply ())
            Carrier
            coefficient-ring
            quadratic-linear
            quadratic-constant
            first-vector
            (#pt-app (#pt-use quadratic-Y ()) Carrier coefficient-ring)))
        (#pt-app
          (#pt-use ring-add ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            quadratic-constant
            (#pt-project quadratic-element 1 first-vector)))
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          quadratic-constant
          (#pt-project quadratic-element 1 first-vector))
        (#pt-app
          (#pt-use ring-add-congruent ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            (#pt-project quadratic-element 0 first-vector)
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            quadratic-constant
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              (#pt-project quadratic-element 1 first-vector)
              (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)))
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            quadratic-constant
            (#pt-project quadratic-element 1 first-vector))
          (#pt-app
            (#pt-use ring-multiply-zero ())
            Carrier
            coefficient-ring
            (#pt-project quadratic-element 0 first-vector))
          (#pt-app
            (#pt-use ring-multiply-congruent ())
            Carrier
            coefficient-ring
            quadratic-constant
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              (#pt-project quadratic-element 1 first-vector)
              (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring))
            quadratic-constant
            (#pt-project quadratic-element 1 first-vector)
            (#pt-app (#pt-use ring-reflexive ()) Carrier coefficient-ring quadratic-constant)
            (#pt-app
              (#pt-use ring-multiply-one ())
              Carrier
              coefficient-ring
              (#pt-project quadratic-element 1 first-vector))))
        (#pt-app
          (#pt-use ring-zero-add ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            quadratic-constant
            (#pt-project quadratic-element 1 first-vector))))
      (#pt-app
        (#pt-use ring-add-congruent ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-add ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            (#pt-project quadratic-element 0 first-vector)
            (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring))
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            (#pt-project quadratic-element 1 first-vector)
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
        (#pt-app
          (#pt-use ring-negate ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            quadratic-linear
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              (#pt-project quadratic-element 1 first-vector)
              (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring))))
        (#pt-project quadratic-element 0 first-vector)
        (#pt-app
          (#pt-use ring-negate ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            quadratic-linear
            (#pt-project quadratic-element 1 first-vector)))
        (#pt-app
          (#pt-use ring-transitive ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-add ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              (#pt-project quadratic-element 0 first-vector)
              (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring))
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              (#pt-project quadratic-element 1 first-vector)
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
          (#pt-app
            (#pt-use ring-add ())
            Carrier
            coefficient-ring
            (#pt-project quadratic-element 0 first-vector)
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
          (#pt-project quadratic-element 0 first-vector)
          (#pt-app
            (#pt-use ring-add-congruent ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              (#pt-project quadratic-element 0 first-vector)
              (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring))
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              (#pt-project quadratic-element 1 first-vector)
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
            (#pt-project quadratic-element 0 first-vector)
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
            (#pt-app
              (#pt-use ring-multiply-one ())
              Carrier
              coefficient-ring
              (#pt-project quadratic-element 0 first-vector))
            (#pt-app
              (#pt-use ring-multiply-zero ())
              Carrier
              coefficient-ring
              (#pt-project quadratic-element 1 first-vector)))
          (#pt-app
            (#pt-use ring-add-zero ())
            Carrier
            coefficient-ring
            (#pt-project quadratic-element 0 first-vector)))
        (#pt-app
          (#pt-use ring-negate-congruent ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            quadratic-linear
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              (#pt-project quadratic-element 1 first-vector)
              (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)))
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            quadratic-linear
            (#pt-project quadratic-element 1 first-vector))
          (#pt-app
            (#pt-use ring-multiply-congruent ())
            Carrier
            coefficient-ring
            quadratic-linear
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              (#pt-project quadratic-element 1 first-vector)
              (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring))
            quadratic-linear
            (#pt-project quadratic-element 1 first-vector)
            (#pt-app (#pt-use ring-reflexive ()) Carrier coefficient-ring quadratic-linear)
            (#pt-app
              (#pt-use ring-multiply-one ())
              Carrier
              coefficient-ring
              (#pt-project quadratic-element 1 first-vector))))))))
