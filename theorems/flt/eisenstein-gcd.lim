; Every pair has an actual gcd for divisibility, including zero inputs.
; The universal common-divisor property is derived from actual Bezout
; coefficients and the proved Euclidean construction, not assumed.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias exists = ./logic-exists.lim::exists)
(#alias eisenstein-add = ./eisenstein-defs.lim::eisenstein-add)
(#alias eisenstein-bezout-gcd-spec = ./eisenstein-bezout-gcd-defs.lim::eisenstein-bezout-gcd-spec)
(#alias eisenstein-bezout-gcd-exists = ./eisenstein-bezout-gcd.lim::eisenstein-bezout-gcd-exists)
(#alias
  eisenstein-bezout-gcd-common-divisor
  =
  ./eisenstein-bezout-gcd-defs.lim::eisenstein-bezout-gcd-common-divisor)
(#math-definition eisenstein-gcd-spec ()
  (#pt-pi
    ((first (#pt-use eisenstein ())) (second (#pt-use eisenstein ())) (gcd (#pt-use eisenstein ())))
    #pt-prop)
  (#pt-lambda
    ((first (#pt-use eisenstein ())) (second (#pt-use eisenstein ())) (gcd (#pt-use eisenstein ())))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app (#pt-use eisenstein-divides ()) gcd first)
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app (#pt-use eisenstein-divides ()) gcd second)
        (#pt-pi
          (
            (common-divisor (#pt-use eisenstein ()))
            (divides-first (#pt-app (#pt-use eisenstein-divides ()) common-divisor first))
            (divides-second (#pt-app (#pt-use eisenstein-divides ()) common-divisor second)))
          (#pt-app (#pt-use eisenstein-divides ()) common-divisor gcd))))))
(#math-definition eisenstein-has-gcd ()
  (#pt-pi ((first (#pt-use eisenstein ())) (second (#pt-use eisenstein ()))) #pt-prop)
  (#pt-lambda
    ((first (#pt-use eisenstein ())) (second (#pt-use eisenstein ())))
    (#pt-app
      (#pt-use exists (0))
      (#pt-use eisenstein ())
      (#pt-lambda
        ((candidate-gcd (#pt-use eisenstein ())))
        (#pt-app (#pt-use eisenstein-gcd-spec ()) first second candidate-gcd)))))
(#theorem eisenstein-gcd-of-bezout-certificate
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter gcd (#pt-use eisenstein ()))
    (#parameter left-coefficient (#pt-use eisenstein ()))
    (#parameter right-coefficient (#pt-use eisenstein ()))
    (#parameter bezout-certificate (#pt-app (#pt-use eisenstein-bezout-gcd-spec ()) first second gcd left-coefficient right-coefficient)))
  (#statement (#pt-app (#pt-use eisenstein-gcd-spec ()) first second gcd))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app (#pt-use eisenstein-divides ()) gcd first)
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app (#pt-use eisenstein-divides ()) gcd second)
        (#pt-pi
          (
            (common-divisor (#pt-use eisenstein ()))
            (divides-first (#pt-app (#pt-use eisenstein-divides ()) common-divisor first))
            (divides-second (#pt-app (#pt-use eisenstein-divides ()) common-divisor second)))
          (#pt-app (#pt-use eisenstein-divides ()) common-divisor gcd)))
      (#pt-app
        (#pt-use conjunction-left ())
        (#pt-app (#pt-use eisenstein-divides ()) gcd first)
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app (#pt-use eisenstein-divides ()) gcd second)
          (#pt-app
            (#pt-use eisenstein-equal ())
            gcd
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first)
              (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient second))))
        bezout-certificate)
      (#pt-app
        (#pt-use conjunction-introduce ())
        (#pt-app (#pt-use eisenstein-divides ()) gcd second)
        (#pt-pi
          (
            (common-divisor (#pt-use eisenstein ()))
            (divides-first (#pt-app (#pt-use eisenstein-divides ()) common-divisor first))
            (divides-second (#pt-app (#pt-use eisenstein-divides ()) common-divisor second)))
          (#pt-app (#pt-use eisenstein-divides ()) common-divisor gcd))
        (#pt-app
          (#pt-use conjunction-left ())
          (#pt-app (#pt-use eisenstein-divides ()) gcd second)
          (#pt-app
            (#pt-use eisenstein-equal ())
            gcd
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first)
              (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient second)))
          (#pt-app
            (#pt-use conjunction-right ())
            (#pt-app (#pt-use eisenstein-divides ()) gcd first)
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app (#pt-use eisenstein-divides ()) gcd second)
              (#pt-app
                (#pt-use eisenstein-equal ())
                gcd
                (#pt-app
                  (#pt-use eisenstein-add ())
                  (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first)
                  (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient second))))
            bezout-certificate))
        (#pt-lambda
          (
            (common-divisor (#pt-use eisenstein ()))
            (divides-first (#pt-app (#pt-use eisenstein-divides ()) common-divisor first))
            (divides-second (#pt-app (#pt-use eisenstein-divides ()) common-divisor second)))
          (#pt-app
            (#pt-use eisenstein-bezout-gcd-common-divisor ())
            first
            second
            gcd
            left-coefficient
            right-coefficient
            common-divisor
            bezout-certificate
            divides-first
            divides-second))))))
(#theorem eisenstein-gcd-exists
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ())))
  (#statement (#pt-app (#pt-use eisenstein-has-gcd ()) first second))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-gcd (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use exists (0))
            (#pt-use eisenstein ())
            (#pt-lambda
              ((candidate-left-coefficient (#pt-use eisenstein ())))
              (#pt-app
                (#pt-use exists (0))
                (#pt-use eisenstein ())
                (#pt-lambda
                  ((candidate-right-coefficient (#pt-use eisenstein ())))
                  (#pt-app
                    (#pt-use eisenstein-bezout-gcd-spec ())
                    first
                    second
                    candidate-gcd
                    candidate-left-coefficient
                    candidate-right-coefficient)))))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-gcd (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use exists (0))
                  (#pt-use eisenstein ())
                  (#pt-lambda
                    ((candidate-left-coefficient (#pt-use eisenstein ())))
                    (#pt-app
                      (#pt-use exists (0))
                      (#pt-use eisenstein ())
                      (#pt-lambda
                        ((candidate-right-coefficient (#pt-use eisenstein ())))
                        (#pt-app
                          (#pt-use eisenstein-bezout-gcd-spec ())
                          first
                          second
                          candidate-gcd
                          candidate-left-coefficient
                          candidate-right-coefficient)))))))))
        (#pt-app (#pt-use eisenstein-has-gcd ()) first second))
      (
        (#pt-lambda
          (
            (gcd (#pt-use eisenstein ()))
            (left-existence
              (#pt-app
                (#pt-use exists (0))
                (#pt-use eisenstein ())
                (#pt-lambda
                  ((candidate-left-coefficient (#pt-use eisenstein ())))
                  (#pt-app
                    (#pt-use exists (0))
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-right-coefficient (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use eisenstein-bezout-gcd-spec ())
                        first
                        second
                        gcd
                        candidate-left-coefficient
                        candidate-right-coefficient)))))))
          (#pt-induct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-left-coefficient (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use exists (0))
                  (#pt-use eisenstein ())
                  (#pt-lambda
                    ((candidate-right-coefficient (#pt-use eisenstein ())))
                    (#pt-app
                      (#pt-use eisenstein-bezout-gcd-spec ())
                      first
                      second
                      gcd
                      candidate-left-coefficient
                      candidate-right-coefficient)))))
            (#pt-lambda
              (
                (eisenstein-certificate
                  (#pt-app
                    (#pt-use exists (0))
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-left-coefficient (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use exists (0))
                        (#pt-use eisenstein ())
                        (#pt-lambda
                          ((candidate-right-coefficient (#pt-use eisenstein ())))
                          (#pt-app
                            (#pt-use eisenstein-bezout-gcd-spec ())
                            first
                            second
                            gcd
                            candidate-left-coefficient
                            candidate-right-coefficient)))))))
              (#pt-app (#pt-use eisenstein-has-gcd ()) first second))
            (
              (#pt-lambda
                (
                  (left-coefficient (#pt-use eisenstein ()))
                  (right-existence
                    (#pt-app
                      (#pt-use exists (0))
                      (#pt-use eisenstein ())
                      (#pt-lambda
                        ((candidate-right-coefficient (#pt-use eisenstein ())))
                        (#pt-app
                          (#pt-use eisenstein-bezout-gcd-spec ())
                          first
                          second
                          gcd
                          left-coefficient
                          candidate-right-coefficient)))))
                (#pt-induct
                  exists
                  (0)
                  (
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-right-coefficient (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use eisenstein-bezout-gcd-spec ())
                        first
                        second
                        gcd
                        left-coefficient
                        candidate-right-coefficient)))
                  (#pt-lambda
                    (
                      (eisenstein-certificate
                        (#pt-app
                          (#pt-use exists (0))
                          (#pt-use eisenstein ())
                          (#pt-lambda
                            ((candidate-right-coefficient (#pt-use eisenstein ())))
                            (#pt-app
                              (#pt-use eisenstein-bezout-gcd-spec ())
                              first
                              second
                              gcd
                              left-coefficient
                              candidate-right-coefficient)))))
                    (#pt-app (#pt-use eisenstein-has-gcd ()) first second))
                  (
                    (#pt-lambda
                      (
                        (right-coefficient (#pt-use eisenstein ()))
                        (bezout-certificate
                          (#pt-app
                            (#pt-use eisenstein-bezout-gcd-spec ())
                            first
                            second
                            gcd
                            left-coefficient
                            right-coefficient)))
                      (#pt-construct
                        exists
                        (0)
                        (
                          (#pt-use eisenstein ())
                          (#pt-lambda
                            ((candidate-gcd (#pt-use eisenstein ())))
                            (#pt-app (#pt-use eisenstein-gcd-spec ()) first second candidate-gcd)))
                        introduce
                        (gcd
                          (#pt-app
                            (#pt-use eisenstein-gcd-of-bezout-certificate ())
                            first
                            second
                            gcd
                            left-coefficient
                            right-coefficient
                            bezout-certificate)))))
                  right-existence)))
            left-existence)))
      (#pt-app (#pt-use eisenstein-bezout-gcd-exists ()) first second))))
