; Generated by scripts/generate-flt-polynomial-degrees.py; checked native terms.
; Support bounds respect actual coefficient equivalence
; and can be weakened by any explicit natural gap. All index transport
; uses the proved natural addition associativity law.
(#alias add = ./../fermat_statement.lim::add)
(#alias add-associative = ./natural-addition.lim::add-associative)
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-polynomial-coefficient = ./ring-polynomial-data.lim::ring-polynomial-coefficient)
(#alias ring-polynomial-equal = ./ring-polynomial-data.lim::ring-polynomial-equal)
(#alias
  ring-polynomial-support-from
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-support-from)
(#alias ring-symmetric = ./commutative-ring-data.lim::ring-symmetric)
(#alias ring-transitive = ./commutative-ring-data.lim::ring-transitive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#alias substitution = ./equality.lim::substitution)
(#alias symmetry = ./equality.lim::symmetry)
(#theorem ring-polynomial-support-congruent
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter support-bound #pt-nat)
    (#parameter coefficient-equation (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring polynomial other-polynomial))
    (#parameter support (#pt-app (#pt-use ring-polynomial-support-from ()) Carrier coefficient-ring polynomial support-bound)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-support-from ())
      Carrier
      coefficient-ring
      other-polynomial
      support-bound))
  (#proof
    (#pt-lambda
      ((index #pt-nat))
      (#pt-app
        (#pt-use ring-transitive ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-coefficient ())
          Carrier
          coefficient-ring
          other-polynomial
          (#pt-app (#pt-use add ()) support-bound index))
        (#pt-app
          (#pt-use ring-polynomial-coefficient ())
          Carrier
          coefficient-ring
          polynomial
          (#pt-app (#pt-use add ()) support-bound index))
        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
        (#pt-app
          (#pt-use ring-symmetric ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-coefficient ())
            Carrier
            coefficient-ring
            polynomial
            (#pt-app (#pt-use add ()) support-bound index))
          (#pt-app
            (#pt-use ring-polynomial-coefficient ())
            Carrier
            coefficient-ring
            other-polynomial
            (#pt-app (#pt-use add ()) support-bound index))
          (#pt-app coefficient-equation (#pt-app (#pt-use add ()) support-bound index)))
        (#pt-app support index)))))
(#theorem ring-polynomial-support-weaken
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter support-bound #pt-nat)
    (#parameter gap #pt-nat)
    (#parameter support (#pt-app (#pt-use ring-polynomial-support-from ()) Carrier coefficient-ring polynomial support-bound)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-support-from ())
      Carrier
      coefficient-ring
      polynomial
      (#pt-app (#pt-use add ()) support-bound gap)))
  (#proof
    (#pt-lambda
      ((index #pt-nat))
      (#pt-app
        (#pt-use substitution (0))
        #pt-nat
        (#pt-lambda
          ((coefficient-index #pt-nat))
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-coefficient ())
              Carrier
              coefficient-ring
              polynomial
              coefficient-index)
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
        (#pt-app (#pt-use add ()) support-bound (#pt-app (#pt-use add ()) gap index))
        (#pt-app (#pt-use add ()) (#pt-app (#pt-use add ()) support-bound gap) index)
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          (#pt-app (#pt-use add ()) (#pt-app (#pt-use add ()) support-bound gap) index)
          (#pt-app (#pt-use add ()) support-bound (#pt-app (#pt-use add ()) gap index))
          (#pt-app (#pt-use add-associative ()) support-bound gap index))
        (#pt-app support (#pt-app (#pt-use add ()) gap index))))))
