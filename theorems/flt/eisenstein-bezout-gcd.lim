; Every pair of Eisenstein integers has actual gcd and Bezout witnesses.
; Natural norm existence and certified Euclidean strong induction
; construct the three existential values. No gcd, PID or factorization
; statement is admitted as a foundation or theorem proof parameter.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias exists = ./logic-exists.lim::exists)
(#alias eisenstein-has-bezout-gcd = ./eisenstein-bezout-gcd-defs.lim::eisenstein-has-bezout-gcd)
(#alias eisenstein-natural-norm = ./eisenstein-norm-defs.lim::eisenstein-natural-norm)
(#alias
  eisenstein-bezout-gcd-with-norm-exists
  =
  ./eisenstein-bezout-gcd-induction.lim::eisenstein-bezout-gcd-with-norm-exists)
(#alias
  eisenstein-natural-norm-exists
  =
  ./eisenstein-norm-nonnegative.lim::eisenstein-natural-norm-exists)
(#theorem eisenstein-bezout-gcd-exists
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ())))
  (#statement (#pt-app (#pt-use eisenstein-has-bezout-gcd ()) first second))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-norm #pt-nat))
          (#pt-app (#pt-use eisenstein-natural-norm ()) second candidate-norm)))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-norm #pt-nat))
                (#pt-app (#pt-use eisenstein-natural-norm ()) second candidate-norm)))))
        (#pt-app (#pt-use eisenstein-has-bezout-gcd ()) first second))
      (
        (#pt-lambda
          (
            (second-norm #pt-nat)
            (norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) second second-norm)))
          (#pt-app
            (#pt-use eisenstein-bezout-gcd-with-norm-exists ())
            second-norm
            first
            second
            norm-certificate)))
      (#pt-app (#pt-use eisenstein-natural-norm-exists ()) second))))
