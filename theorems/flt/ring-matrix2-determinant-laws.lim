; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean:82-208,409-468.
; Generated by scripts/generate-flt-coordinate-algebra.py; checked native terms.
; Universal determinant congruence and multiplicativity follow
; from explicit scalar ring derivations, with no matrix library axiom.
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias ring-negate = ./commutative-ring-data.lim::ring-negate)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-add-congruent = ./commutative-ring-data.lim::ring-add-congruent)
(#alias ring-multiply-congruent = ./commutative-ring-data.lim::ring-multiply-congruent)
(#alias ring-negate-congruent = ./commutative-ring-data.lim::ring-negate-congruent)
(#alias
  ring-matrix2-determinant-product-identity
  =
  ./ring-matrix2-determinant-product-identity.lim::ring-matrix2-determinant-product-identity)
(#alias ring-matrix2 = ./ring-matrix2-data.lim::ring-matrix2)
(#alias ring-matrix2-equal = ./ring-matrix2-data.lim::ring-matrix2-equal)
(#alias ring-matrix2-multiply = ./ring-matrix2-data.lim::ring-matrix2-multiply)
(#alias ring-matrix2-determinant = ./ring-matrix2-data.lim::ring-matrix2-determinant)
(#theorem ring-matrix2-determinant-congruent
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-matrix (#pt-app (#pt-use ring-matrix2 ()) Carrier))
    (#parameter second-matrix (#pt-app (#pt-use ring-matrix2 ()) Carrier))
    (#parameter matrix-equation (#pt-app (#pt-use ring-matrix2-equal ()) Carrier coefficient-ring first-matrix second-matrix)))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-matrix2-determinant ()) Carrier coefficient-ring first-matrix)
      (#pt-app (#pt-use ring-matrix2-determinant ()) Carrier coefficient-ring second-matrix)))
  (#proof
    (#pt-app
      (#pt-use ring-add-congruent ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-multiply ())
        Carrier
        coefficient-ring
        (#pt-project ring-matrix2 0 first-matrix)
        (#pt-project ring-matrix2 3 first-matrix))
      (#pt-app
        (#pt-use ring-negate ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          (#pt-project ring-matrix2 1 first-matrix)
          (#pt-project ring-matrix2 2 first-matrix)))
      (#pt-app
        (#pt-use ring-multiply ())
        Carrier
        coefficient-ring
        (#pt-project ring-matrix2 0 second-matrix)
        (#pt-project ring-matrix2 3 second-matrix))
      (#pt-app
        (#pt-use ring-negate ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          (#pt-project ring-matrix2 1 second-matrix)
          (#pt-project ring-matrix2 2 second-matrix)))
      (#pt-app
        (#pt-use ring-multiply-congruent ())
        Carrier
        coefficient-ring
        (#pt-project ring-matrix2 0 first-matrix)
        (#pt-project ring-matrix2 3 first-matrix)
        (#pt-project ring-matrix2 0 second-matrix)
        (#pt-project ring-matrix2 3 second-matrix)
        (#pt-project conjunction 0 matrix-equation)
        (#pt-project
          conjunction
          1
          (#pt-project conjunction 1 (#pt-project conjunction 1 matrix-equation))))
      (#pt-app
        (#pt-use ring-negate-congruent ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          (#pt-project ring-matrix2 1 first-matrix)
          (#pt-project ring-matrix2 2 first-matrix))
        (#pt-app
          (#pt-use ring-multiply ())
          Carrier
          coefficient-ring
          (#pt-project ring-matrix2 1 second-matrix)
          (#pt-project ring-matrix2 2 second-matrix))
        (#pt-app
          (#pt-use ring-multiply-congruent ())
          Carrier
          coefficient-ring
          (#pt-project ring-matrix2 1 first-matrix)
          (#pt-project ring-matrix2 2 first-matrix)
          (#pt-project ring-matrix2 1 second-matrix)
          (#pt-project ring-matrix2 2 second-matrix)
          (#pt-project conjunction 0 (#pt-project conjunction 1 matrix-equation))
          (#pt-project
            conjunction
            0
            (#pt-project conjunction 1 (#pt-project conjunction 1 matrix-equation))))))))
(#theorem ring-matrix2-determinant-multiply
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-matrix (#pt-app (#pt-use ring-matrix2 ()) Carrier))
    (#parameter second-matrix (#pt-app (#pt-use ring-matrix2 ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-matrix2-determinant ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-matrix2-multiply ())
          Carrier
          coefficient-ring
          first-matrix
          second-matrix))
      (#pt-app
        (#pt-use ring-multiply ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-matrix2-determinant ()) Carrier coefficient-ring first-matrix)
        (#pt-app (#pt-use ring-matrix2-determinant ()) Carrier coefficient-ring second-matrix))))
  (#proof
    (#pt-app
      (#pt-use ring-matrix2-determinant-product-identity ())
      Carrier
      coefficient-ring
      (#pt-project ring-matrix2 0 first-matrix)
      (#pt-project ring-matrix2 1 first-matrix)
      (#pt-project ring-matrix2 2 first-matrix)
      (#pt-project ring-matrix2 3 first-matrix)
      (#pt-project ring-matrix2 0 second-matrix)
      (#pt-project ring-matrix2 1 second-matrix)
      (#pt-project ring-matrix2 2 second-matrix)
      (#pt-project ring-matrix2 3 second-matrix))))
