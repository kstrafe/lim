(#theorem eisenstein-unit-omega-small
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter unit-proof (#pt-app (#pt-use eisenstein-unit ()) number)))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project eisenstein 1 number)
        (#pt-use integer-zero ()))
      (#pt-app
        (#pt-use disjunction ())
        (#pt-app
          (#pt-use integer-equal ())
          (#pt-project eisenstein 1 number)
          (#pt-use integer-one ()))
        (#pt-app
          (#pt-use integer-equal ())
          (#pt-project eisenstein 1 number)
          (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ()))))))
  (#proof
    (#pt-app
      (#pt-use integer-three-square-value-small ())
      (#pt-project eisenstein 1 number)
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 2))
          (#pt-project eisenstein 0 number))
        (#pt-app (#pt-use integer-negate ()) (#pt-project eisenstein 1 number)))
      (#pt-app (#pt-use eisenstein-unit-omega-square-budget ()) number unit-proof))))
