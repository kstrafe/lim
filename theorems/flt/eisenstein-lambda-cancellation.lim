(#theorem eisenstein-natural-divisor-cancel
  (#universes)
  (#parameters
    (#parameter natural-scalar #pt-nat)
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter scalar-nonzero (#pt-pi ((denied-proof (#pt-eq #pt-nat natural-scalar #pt-zero))) #pt-false))
    (#parameter divides-scalar (#pt-app (#pt-use eisenstein-divides ()) divisor (#pt-app (#pt-use eisenstein-of-integer ()) (#pt-app (#pt-use integer-of-natural ()) natural-scalar))))
    (#parameter products-equivalent (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-multiply ()) divisor first) (#pt-app (#pt-use eisenstein-multiply ()) divisor second))))
  (#statement (#pt-app (#pt-use eisenstein-equal ()) first second))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-factor (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app
              (#pt-use eisenstein-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) natural-scalar))
            (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-factor (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app
                    (#pt-use eisenstein-of-integer ())
                    (#pt-app (#pt-use integer-of-natural ()) natural-scalar))
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor candidate-factor))))))
        (#pt-app (#pt-use eisenstein-equal ()) first second))
      (
        (#pt-lambda
          (
            (factor (#pt-use eisenstein ()))
            (factor-equivalence
              (#pt-app
                (#pt-use eisenstein-equal ())
                (#pt-app
                  (#pt-use eisenstein-of-integer ())
                  (#pt-app (#pt-use integer-of-natural ()) natural-scalar))
                (#pt-app (#pt-use eisenstein-multiply ()) divisor factor))))
          (#pt-app
            (#pt-use eisenstein-natural-multiply-cancel ())
            natural-scalar
            first
            second
            scalar-nonzero
            (#pt-app
              (#pt-use eisenstein-transitive ())
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app
                  (#pt-use eisenstein-of-integer ())
                  (#pt-app (#pt-use integer-of-natural ()) natural-scalar))
                first)
              (#pt-app
                (#pt-use eisenstein-multiply ())
                factor
                (#pt-app (#pt-use eisenstein-multiply ()) divisor first))
              (#pt-app
                (#pt-use eisenstein-multiply ())
                (#pt-app
                  (#pt-use eisenstein-of-integer ())
                  (#pt-app (#pt-use integer-of-natural ()) natural-scalar))
                second)
              (#pt-app
                (#pt-use eisenstein-transitive ())
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app
                    (#pt-use eisenstein-of-integer ())
                    (#pt-app (#pt-use integer-of-natural ()) natural-scalar))
                  first)
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  (#pt-app (#pt-use eisenstein-multiply ()) factor divisor)
                  first)
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  factor
                  (#pt-app (#pt-use eisenstein-multiply ()) divisor first))
                (#pt-app
                  (#pt-use eisenstein-multiply-congruent ())
                  (#pt-app
                    (#pt-use eisenstein-of-integer ())
                    (#pt-app (#pt-use integer-of-natural ()) natural-scalar))
                  first
                  (#pt-app (#pt-use eisenstein-multiply ()) factor divisor)
                  first
                  (#pt-app
                    (#pt-use eisenstein-symmetric ())
                    (#pt-app (#pt-use eisenstein-multiply ()) factor divisor)
                    (#pt-app
                      (#pt-use eisenstein-of-integer ())
                      (#pt-app (#pt-use integer-of-natural ()) natural-scalar))
                    (#pt-app
                      (#pt-use eisenstein-transitive ())
                      (#pt-app (#pt-use eisenstein-multiply ()) factor divisor)
                      (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
                      (#pt-app
                        (#pt-use eisenstein-of-integer ())
                        (#pt-app (#pt-use integer-of-natural ()) natural-scalar))
                      (#pt-app (#pt-use eisenstein-multiply-commutative ()) factor divisor)
                      (#pt-app
                        (#pt-use eisenstein-symmetric ())
                        (#pt-app
