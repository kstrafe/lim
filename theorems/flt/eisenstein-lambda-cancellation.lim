(#theorem eisenstein-scalar-multiply-real
  (#universes)
  (#parameters
    (#parameter scalar (#pt-use integer ()))
    (#parameter first (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-project
        eisenstein
        0
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app (#pt-use eisenstein-of-integer ()) scalar)
          first))
      (#pt-app (#pt-use integer-multiply ()) scalar (#pt-project eisenstein 0 first))))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-project
        eisenstein
        0
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app (#pt-use eisenstein-of-integer ()) scalar)
          first))
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use integer-multiply ()) scalar (#pt-project eisenstein 0 first))
        (#pt-use integer-zero ()))
      (#pt-app (#pt-use integer-multiply ()) scalar (#pt-project eisenstein 0 first))
      (#pt-app
        (#pt-use integer-add-congruent ())
        (#pt-app (#pt-use integer-multiply ()) scalar (#pt-project eisenstein 0 first))
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-use integer-zero ())
            (#pt-project eisenstein 1 first)))
        (#pt-app (#pt-use integer-multiply ()) scalar (#pt-project eisenstein 0 first))
        (#pt-use integer-zero ())
        (#pt-app
          (#pt-use integer-reflexive ())
          (#pt-app (#pt-use integer-multiply ()) scalar (#pt-project eisenstein 0 first)))
        (#pt-app
          (#pt-use integer-negate-congruent ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-use integer-zero ())
            (#pt-project eisenstein 1 first))
          (#pt-use integer-zero ())
          (#pt-app
            (#pt-use integer-transitive ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-use integer-zero ())
              (#pt-project eisenstein 1 first))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project eisenstein 1 first)
              (#pt-use integer-zero ()))
            (#pt-use integer-zero ())
            (#pt-app
              (#pt-use integer-multiply-commutative ())
              (#pt-use integer-zero ())
              (#pt-project eisenstein 1 first))
            (#pt-app (#pt-use integer-multiply-zero ()) (#pt-project eisenstein 1 first)))))
      (#pt-app
        (#pt-use integer-add-zero ())
        (#pt-app (#pt-use integer-multiply ()) scalar (#pt-project eisenstein 0 first))))))
