                          (#pt-app (#pt-use integer-of-natural ()) natural-scalar))
                        (#pt-app (#pt-use eisenstein-multiply ()) divisor factor)
                        factor-equivalence)))
                  (#pt-app (#pt-use eisenstein-reflexive ()) first))
                (#pt-app (#pt-use eisenstein-multiply-associative ()) factor divisor first))
              (#pt-app
                (#pt-use eisenstein-transitive ())
                (#pt-app
