; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Prove (I*J)*K is included in I*(J*K)
; by two product universal properties. The colon ideal carries
; the fixed last factor through the inner linear combinations.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias ring-ideal = ./ring-ideal-data.lim::ring-ideal)
(#alias ring-ideal-colon-element = ./ring-ideal-colon-element.lim::ring-ideal-colon-element)
(#alias ring-ideal-member = ./ring-ideal-data.lim::ring-ideal-member)
(#alias ring-ideal-member-congruent = ./ring-ideal-data.lim::ring-ideal-member-congruent)
(#alias ring-ideal-product = ./ring-ideal-product.lim::ring-ideal-product)
(#alias ring-ideal-product-introduce = ./ring-ideal-product.lim::ring-ideal-product-introduce)
(#alias ring-ideal-product-least = ./ring-ideal-product.lim::ring-ideal-product-least)
(#alias ring-ideal-subset = ./ring-ideal-data.lim::ring-ideal-subset)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-multiply-associative = ./commutative-ring-data.lim::ring-multiply-associative)
(#alias ring-symmetric = ./commutative-ring-data.lim::ring-symmetric)
(#theorem ring-ideal-product-associative-inclusion
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter third-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal second-ideal)
        third-ideal)
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        first-ideal
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring second-ideal third-ideal))))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-product-least ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal second-ideal)
      third-ideal
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        first-ideal
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring second-ideal third-ideal))
      (#pt-lambda
        (
          (first-element Carrier)
          (last-factor Carrier)
          (pair-member
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-ideal-product ())
                Carrier
                coefficient-ring
                first-ideal
                second-ideal)
              first-element))
          (last-member
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              third-ideal
              last-factor)))
        (#pt-app
          (#pt-app
            (#pt-use ring-ideal-product-least ())
            Carrier
            coefficient-ring
            first-ideal
            second-ideal
            (#pt-app
              (#pt-use ring-ideal-colon-element ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-ideal-product ())
                Carrier
                coefficient-ring
                first-ideal
                (#pt-app
                  (#pt-use ring-ideal-product ())
                  Carrier
                  coefficient-ring
                  second-ideal
                  third-ideal))
              last-factor)
            (#pt-lambda
              (
                (inner-first-factor Carrier)
                (inner-second-factor Carrier)
                (inner-first-member
                  (#pt-app
                    (#pt-use ring-ideal-member ())
                    Carrier
                    coefficient-ring
                    first-ideal
                    inner-first-factor))
                (inner-second-member
                  (#pt-app
                    (#pt-use ring-ideal-member ())
                    Carrier
                    coefficient-ring
                    second-ideal
                    inner-second-factor)))
              (#pt-app
                (#pt-use ring-ideal-member-congruent ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-ideal-product ())
                  Carrier
                  coefficient-ring
                  first-ideal
                  (#pt-app
                    (#pt-use ring-ideal-product ())
                    Carrier
                    coefficient-ring
                    second-ideal
                    third-ideal))
                (#pt-app
                  (#pt-use ring-multiply ())
                  Carrier
                  coefficient-ring
                  inner-first-factor
                  (#pt-app
                    (#pt-use ring-multiply ())
                    Carrier
                    coefficient-ring
                    inner-second-factor
                    last-factor))
                (#pt-app
                  (#pt-use ring-multiply ())
                  Carrier
                  coefficient-ring
                  (#pt-app
                    (#pt-use ring-multiply ())
                    Carrier
                    coefficient-ring
                    inner-first-factor
                    inner-second-factor)
                  last-factor)
                (#pt-app
                  (#pt-use ring-symmetric ())
                  Carrier
                  coefficient-ring
                  (#pt-app
                    (#pt-use ring-multiply ())
                    Carrier
                    coefficient-ring
                    (#pt-app
                      (#pt-use ring-multiply ())
                      Carrier
                      coefficient-ring
                      inner-first-factor
                      inner-second-factor)
                    last-factor)
                  (#pt-app
                    (#pt-use ring-multiply ())
                    Carrier
                    coefficient-ring
                    inner-first-factor
                    (#pt-app
                      (#pt-use ring-multiply ())
                      Carrier
                      coefficient-ring
                      inner-second-factor
                      last-factor))
                  (#pt-app
                    (#pt-use ring-multiply-associative ())
                    Carrier
                    coefficient-ring
                    inner-first-factor
                    inner-second-factor
                    last-factor))
                (#pt-app
                  (#pt-use ring-ideal-product-introduce ())
                  Carrier
                  coefficient-ring
                  first-ideal
                  (#pt-app
                    (#pt-use ring-ideal-product ())
                    Carrier
                    coefficient-ring
                    second-ideal
                    third-ideal)
                  inner-first-factor
                  (#pt-app
                    (#pt-use ring-multiply ())
                    Carrier
                    coefficient-ring
                    inner-second-factor
                    last-factor)
                  inner-first-member
                  (#pt-app
                    (#pt-use ring-ideal-product-introduce ())
                    Carrier
                    coefficient-ring
                    second-ideal
                    third-ideal
                    inner-second-factor
                    last-factor
                    inner-second-member
                    last-member)))))
          first-element
          pair-member)))))
