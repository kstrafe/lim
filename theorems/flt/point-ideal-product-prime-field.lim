(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#math-definition point-ideal-product-prime-field ()
  (#pt-pi
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (prime-proof (#pt-app (#pt-use prime ()) modulus)))
    (#pt-app
      (#pt-use point-ideal-product-field-data ())
      (#pt-app (#pt-use finite-residue ()) modulus)
      (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)))
  (#pt-lambda
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (prime-proof (#pt-app (#pt-use prime ()) modulus)))
    (#pt-construct
      point-ideal-product-field-data
      ()
      (
        (#pt-app (#pt-use finite-residue ()) modulus)
        (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus))
      field
      (
        (#pt-app
          (#pt-use ring-polynomial-domain-one-nonzero ())
          (#pt-app (#pt-use finite-residue ()) modulus)
          (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)
          (#pt-app
            (#pt-use ring-polynomial-domain-prime-residue ())
            modulus
            positive-modulus
            prime-proof))
        (#pt-lambda
          (
            (value (#pt-app (#pt-use finite-residue ()) modulus))
            (nonzero
              (#pt-pi
                (
                  (denied-evidence
                    (#pt-app
                      (#pt-use ring-equal ())
                      (#pt-app (#pt-use finite-residue ()) modulus)
                      (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)
                      value
                      (#pt-app
                        (#pt-use ring-zero ())
                        (#pt-app (#pt-use finite-residue ()) modulus)
                        (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)))))
                #pt-false)))
          (#pt-construct
            exists
            (0)
            (
              (#pt-app (#pt-use finite-residue ()) modulus)
              (#pt-lambda
                ((inverse (#pt-app (#pt-use finite-residue ()) modulus)))
                (#pt-app
                  (#pt-use ring-equal ())
                  (#pt-app (#pt-use finite-residue ()) modulus)
                  (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)
                  (#pt-app
                    (#pt-use ring-multiply ())
                    (#pt-app (#pt-use finite-residue ()) modulus)
                    (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)
                    value
                    inverse)
                  (#pt-app
                    (#pt-use ring-one ())
                    (#pt-app (#pt-use finite-residue ()) modulus)
                    (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)))))
            introduce
            (
              (#pt-app (#pt-use finite-residue-inverse ()) modulus positive-modulus value)
              (#pt-app
                (#pt-use finite-prime-inverse-product ())
                modulus
                positive-modulus
                prime-proof
                value
                nonzero))))))))
(#theorem point-ideal-product-prime-field-inverse
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) modulus))
    (#parameter value (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter nonzero (#pt-pi ((denied-evidence (#pt-app (#pt-use ring-equal ()) (#pt-app (#pt-use finite-residue ()) modulus) (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus) value (#pt-app (#pt-use ring-zero ()) (#pt-app (#pt-use finite-residue ()) modulus) (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus))))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use exists (0))
      (#pt-app (#pt-use finite-residue ()) modulus)
      (#pt-lambda
        ((inverse (#pt-app (#pt-use finite-residue ()) modulus)))
        (#pt-app
          (#pt-use ring-equal ())
          (#pt-app (#pt-use finite-residue ()) modulus)
          (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)
          (#pt-app
            (#pt-use ring-multiply ())
            (#pt-app (#pt-use finite-residue ()) modulus)
            (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)
            value
            inverse)
          (#pt-app
            (#pt-use ring-one ())
            (#pt-app (#pt-use finite-residue ()) modulus)
            (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus))))))
  (#proof
    (#pt-app
      (#pt-use point-ideal-product-field-inverse ())
      (#pt-app (#pt-use finite-residue ()) modulus)
      (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)
      (#pt-app (#pt-use point-ideal-product-prime-field ()) modulus positive-modulus prime-proof)
      value
      nonzero)))
