; Actual extended-gcd inverse computation
; and native prime evidence construct the field instance for
; each prime residue ring. Composite nonunits are not promoted
; to invertible values by the interface.
(#alias exists = ./logic-exists.lim::exists)
(#alias finite-prime-inverse-product = ./finite-prime-inverses.lim::finite-prime-inverse-product)
(#alias finite-residue = ./finite-residue-defs.lim::finite-residue)
