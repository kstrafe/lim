; Authors: Kevin Buzzard, David Kurniadi Angdinata
; Apache 2.0; see LICENSE.MATHLIB. Native rational specialization of
; Weierstrass.lean:359-364 (unit discriminant), and
; Def_FreyCurve_Basic.lean:18-24 (Frey ellipticity).
; Source repository: Copyright 2026 Anthropic, PBC; see NOTICE.FLT.
; Prove the actual unit witness from the constructed package and exact
; nonzero discriminant. No ellipticity or field axiom is assumed.
(#alias integer = ./integer-defs.lim::integer)
(#alias rational-equal = ./rational-defs.lim::rational-equal)
(#alias rational-zero = ./rational-defs.lim::rational-zero)
(#alias rational-weierstrass-curve = ./rational-weierstrass-defs.lim::rational-weierstrass-curve)
(#alias
  rational-weierstrass-discriminant
  =
  ./rational-weierstrass-defs.lim::rational-weierstrass-discriminant)
(#alias rational-is-unit = ./rational-units.lim::rational-is-unit)
(#alias rational-nonzero-is-unit = ./rational-units.lim::rational-nonzero-is-unit)
(#alias
  frey-package-discriminant-nonzero
  =
  ./frey-package-discriminant.lim::frey-package-discriminant-nonzero)
(#alias frey-package-certificate = ./frey-package.lim::frey-package-certificate)
(#alias frey-rational-curve = ./frey-rational-curve.lim::frey-rational-curve)
(#math-definition rational-weierstrass-is-elliptic ()
  (#pt-pi ((curve (#pt-use rational-weierstrass-curve ()))) #pt-prop)
  (#pt-lambda
    ((curve (#pt-use rational-weierstrass-curve ())))
    (#pt-app
      (#pt-use rational-is-unit ())
      (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve))))
(#theorem rational-weierstrass-nonzero-discriminant-is-elliptic
  (#universes)
  (#parameters
    (#parameter curve (#pt-use rational-weierstrass-curve ()))
    (#parameter discriminant-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use rational-equal ()) (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve) (#pt-use rational-zero ())))) #pt-false)))
  (#statement (#pt-app (#pt-use rational-weierstrass-is-elliptic ()) curve))
  (#proof
    (#pt-app
      (#pt-use rational-nonzero-is-unit ())
      (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve)
      discriminant-nonzero)))
(#theorem frey-package-is-elliptic
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter package (#pt-app (#pt-use frey-package-certificate ()) exponent first second third)))
  (#statement
    (#pt-app
      (#pt-use rational-weierstrass-is-elliptic ())
      (#pt-app (#pt-use frey-rational-curve ()) first second exponent)))
  (#proof
    (#pt-app
      (#pt-use rational-weierstrass-nonzero-discriminant-is-elliptic ())
      (#pt-app (#pt-use frey-rational-curve ()) first second exponent)
      (#pt-app (#pt-use frey-package-discriminant-nonzero ()) first second third exponent package))))
