(#math-definition point-evaluation-section-morphism ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (Image (#pt-type 0))
      (image-ring (#pt-app (#pt-use commutative-ring ()) Image))
      (morphism
        (#pt-app (#pt-use ring-evaluation-morphism ()) Carrier coefficient-ring Image image-ring))
      (section (#pt-pi ((first-value Image)) Carrier))
      (section-right-inverse
        (#pt-pi
          ((first-value Image))
          (#pt-app
            (#pt-use ring-equal ())
            Image
            image-ring
            (#pt-app
              (#pt-use ring-evaluation-map ())
              Carrier
              coefficient-ring
              Image
              image-ring
              morphism
              (#pt-app section first-value))
            first-value))))
    (#pt-app
      (#pt-use ring-evaluation-morphism ())
      Image
      image-ring
      Carrier
      (#pt-app
        (#pt-use point-evaluation-image-ring ())
        Carrier
        coefficient-ring
        Image
        image-ring
        morphism)))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (Image (#pt-type 0))
      (image-ring (#pt-app (#pt-use commutative-ring ()) Image))
      (morphism
        (#pt-app (#pt-use ring-evaluation-morphism ()) Carrier coefficient-ring Image image-ring))
      (section (#pt-pi ((first-value Image)) Carrier))
      (section-right-inverse
        (#pt-pi
          ((first-value Image))
          (#pt-app
            (#pt-use ring-equal ())
            Image
            image-ring
            (#pt-app
              (#pt-use ring-evaluation-map ())
              Carrier
              coefficient-ring
              Image
              image-ring
              morphism
              (#pt-app section first-value))
            first-value))))
    (#pt-construct
      ring-evaluation-morphism
      ()
      (Image
        image-ring
        Carrier
        (#pt-app
          (#pt-use point-evaluation-image-ring ())
          Carrier
          coefficient-ring
          Image
          image-ring
          morphism))
      morphism
      (
        (#pt-lambda ((first-value Image)) (#pt-app section first-value))
        (#pt-lambda
          (
            (first-value Image)
            (second-value Image)
            (equation (#pt-app (#pt-use ring-equal ()) Image image-ring first-value second-value)))
          (#pt-app
            (#pt-use point-evaluation-section-congruent ())
            Carrier
            coefficient-ring
            Image
            image-ring
            morphism
            section
            section-right-inverse
            first-value
            second-value
            equation))
        (#pt-app
          (#pt-use point-evaluation-section-zero ())
          Carrier
          coefficient-ring
          Image
          image-ring
          morphism
          section
          section-right-inverse)
        (#pt-app
          (#pt-use point-evaluation-section-one ())
          Carrier
          coefficient-ring
          Image
          image-ring
          morphism
          section
          section-right-inverse)
        (#pt-lambda
          ((first-value Image) (second-value Image))
          (#pt-app
            (#pt-use point-evaluation-section-add ())
            Carrier
            coefficient-ring
            Image
            image-ring
            morphism
            section
            section-right-inverse
            first-value
            second-value))
        (#pt-lambda
          ((first-value Image) (second-value Image))
