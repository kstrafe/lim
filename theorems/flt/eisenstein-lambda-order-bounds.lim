; Power divisibility is equivalent to being at or below the exact order.
; The upper bound is written not(order < exponent), with constructive
; natural trichotomy supplying the converse. No valuation law is assumed.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-lambda = ./eisenstein-defs.lim::eisenstein-lambda)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-power = ./eisenstein-defs.lim::eisenstein-power)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias eisenstein-unit = ./eisenstein-defs.lim::eisenstein-unit)
(#alias eisenstein-reflexive = ./eisenstein-equality.lim::eisenstein-reflexive)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-congruent = ./eisenstein-equality.lim::eisenstein-multiply-congruent)
(#alias eisenstein-multiply-one = ./eisenstein-ring.lim::eisenstein-multiply-one)
(#alias eisenstein-multiply-zero = ./eisenstein-ring.lim::eisenstein-multiply-zero)
(#alias eisenstein-multiply-commutative = ./eisenstein-ring.lim::eisenstein-multiply-commutative)
(#alias eisenstein-multiply-associative = ./eisenstein-ring.lim::eisenstein-multiply-associative)
(#alias eisenstein-one-multiply = ./eisenstein-cubic-bridge.lim::eisenstein-one-multiply)
(#alias
  eisenstein-lambda-multiply-cancel
  =
  ./eisenstein-lambda-cancellation.lim::eisenstein-lambda-multiply-cancel)
(#alias eisenstein-lambda-order = ./eisenstein-lambda-order.lim::eisenstein-lambda-order)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias exists = ./logic-exists.lim::exists)
(#alias
  eisenstein-lambda-order-excludes-higher
  =
  ./eisenstein-lambda-order.lim::eisenstein-lambda-order-excludes-higher)
(#alias
  eisenstein-power-divides-add
  =
  ./eisenstein-power-divisibility.lim::eisenstein-power-divides-add)
(#alias
  eisenstein-power-divides-step
  =
  ./eisenstein-power-divisibility.lim::eisenstein-power-divides-step)
(#alias
  eisenstein-divides-transitive
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-transitive)
(#alias less-than = ./natural-order.lim::less-than)
(#alias natural-trichotomy = ./natural-discrete-order.lim::natural-trichotomy)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#alias symmetry = ./equality.lim::symmetry)
(#alias substitution = ./equality.lim::substitution)
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#theorem eisenstein-lambda-order-divides-below
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter order-exponent #pt-nat)
    (#parameter power-exponent #pt-nat)
    (#parameter order-certificate (#pt-app (#pt-use eisenstein-lambda-order ()) number order-exponent))
    (#parameter below-order (#pt-app (#pt-use less-than ()) power-exponent order-exponent)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-divides ())
      (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) power-exponent)
      number))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-gap #pt-nat))
          (#pt-eq
            #pt-nat
            order-exponent
            (#pt-app (#pt-use add ()) (#pt-succ power-exponent) candidate-gap))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-gap #pt-nat))
                (#pt-eq
                  #pt-nat
                  order-exponent
                  (#pt-app (#pt-use add ()) (#pt-succ power-exponent) candidate-gap))))))
        (#pt-app
          (#pt-use eisenstein-divides ())
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) power-exponent)
          number))
      (
        (#pt-lambda
          (
            (gap #pt-nat)
            (position
              (#pt-eq
                #pt-nat
                order-exponent
                (#pt-app (#pt-use add ()) (#pt-succ power-exponent) gap))))
          (#pt-app
            (#pt-use eisenstein-divides-transitive ())
            (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) power-exponent)
            (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) order-exponent)
            number
            (#pt-app
              (#pt-use eisenstein-power-divides-step ())
              (#pt-use eisenstein-lambda ())
              power-exponent
              (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) order-exponent)
              (#pt-app
                (#pt-use substitution (0))
                #pt-nat
                (#pt-lambda
                  ((endpoint #pt-nat))
                  (#pt-app
                    (#pt-use eisenstein-divides ())
                    (#pt-app
                      (#pt-use eisenstein-power ())
                      (#pt-use eisenstein-lambda ())
                      (#pt-succ power-exponent))
                    (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) endpoint)))
                (#pt-app (#pt-use add ()) (#pt-succ power-exponent) gap)
                order-exponent
                (#pt-app
                  (#pt-use symmetry (0))
                  #pt-nat
                  order-exponent
                  (#pt-app (#pt-use add ()) (#pt-succ power-exponent) gap)
                  position)
                (#pt-app
                  (#pt-use eisenstein-power-divides-add ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-succ power-exponent)
                  gap)))
            (#pt-project eisenstein-lambda-order 0 order-certificate))))
      below-order)))
(#theorem eisenstein-lambda-order-divisibility-upper
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter order-exponent #pt-nat)
    (#parameter power-exponent #pt-nat)
    (#parameter order-certificate (#pt-app (#pt-use eisenstein-lambda-order ()) number order-exponent))
    (#parameter power-divides (#pt-app (#pt-use eisenstein-divides ()) (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) power-exponent) number)))
  (#statement
    (#pt-pi
      ((denied-proof (#pt-app (#pt-use less-than ()) order-exponent power-exponent)))
      #pt-false))
  (#proof
    (#pt-lambda
      ((above-order (#pt-app (#pt-use less-than ()) order-exponent power-exponent)))
      (#pt-app
        (#pt-app
          (#pt-use eisenstein-lambda-order-excludes-higher ())
          number
          order-exponent
          power-exponent
          order-certificate
          above-order)
        power-divides))))
(#theorem eisenstein-lambda-order-divisibility-lower
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter order-exponent #pt-nat)
    (#parameter power-exponent #pt-nat)
    (#parameter order-certificate (#pt-app (#pt-use eisenstein-lambda-order ()) number order-exponent))
    (#parameter not-above-order (#pt-pi ((denied-proof (#pt-app (#pt-use less-than ()) order-exponent power-exponent))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-divides ())
      (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) power-exponent)
      number))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use less-than ()) power-exponent order-exponent)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-eq #pt-nat power-exponent order-exponent)
        (#pt-app (#pt-use less-than ()) order-exponent power-exponent))
      (#pt-app
        (#pt-use eisenstein-divides ())
        (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) power-exponent)
        number)
      (#pt-lambda
        ((less-order (#pt-app (#pt-use less-than ()) power-exponent order-exponent)))
        (#pt-app
          (#pt-use eisenstein-lambda-order-divides-below ())
          number
          order-exponent
          power-exponent
          order-certificate
          less-order))
      (#pt-lambda
        (
          (equal-or-above
            (#pt-app
              (#pt-use disjunction ())
              (#pt-eq #pt-nat power-exponent order-exponent)
              (#pt-app (#pt-use less-than ()) order-exponent power-exponent))))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-eq #pt-nat power-exponent order-exponent)
          (#pt-app (#pt-use less-than ()) order-exponent power-exponent)
          (#pt-app
            (#pt-use eisenstein-divides ())
            (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) power-exponent)
            number)
          (#pt-lambda
            ((same-order (#pt-eq #pt-nat power-exponent order-exponent)))
            (#pt-app
              (#pt-use substitution (0))
              #pt-nat
              (#pt-lambda
                ((endpoint #pt-nat))
                (#pt-app
                  (#pt-use eisenstein-divides ())
                  (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) endpoint)
                  number))
              order-exponent
              power-exponent
              (#pt-app (#pt-use symmetry (0)) #pt-nat power-exponent order-exponent same-order)
              (#pt-project eisenstein-lambda-order 0 order-certificate)))
          (#pt-lambda
            ((above-order (#pt-app (#pt-use less-than ()) order-exponent power-exponent)))
            (#pt-app
              (#pt-use false-elimination ())
              (#pt-app
                (#pt-use eisenstein-divides ())
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-use eisenstein-lambda ())
                  power-exponent)
                number)
              (#pt-app not-above-order above-order)))
          equal-or-above))
      (#pt-app (#pt-use natural-trichotomy ()) power-exponent order-exponent))))
