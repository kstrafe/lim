; Rational cross equality is an equivalence relation with actual
; denominator nonzero evidence. Zero fractions have exactly zero
; numerators, independently of noncanonical signed representations.
; No quotient or denominator-cancellation oracle is assumed.
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-zero = ./integer-defs.lim::integer-zero)
(#alias integer-one = ./integer-defs.lim::integer-one)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-reflexive = ./integer-equality.lim::integer-reflexive)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias rational = ./rational-defs.lim::rational)
(#alias rational-equal = ./rational-defs.lim::rational-equal)
(#alias rational-zero = ./rational-defs.lim::rational-zero)
(#alias integer-multiply-one = ./integer-multiplication.lim::integer-multiply-one)
(#alias integer-zero-multiply = ./integer-bezout-algebra.lim::integer-zero-multiply)
(#alias integer-natural-embedding-nonzero = ./integer-domain.lim::integer-natural-embedding-nonzero)
(#alias
  integer-cross-product-transitive
  =
  ./integer-cross-products.lim::integer-cross-product-transitive)
(#theorem rational-reflexive
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ())))
  (#statement (#pt-app (#pt-use rational-equal ()) first first))
  (#proof
    (#pt-app
      (#pt-use integer-reflexive ())
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-project rational 0 first)
        (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))))))
(#theorem rational-symmetric
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter second (#pt-use rational ()))
    (#parameter cross-equivalence (#pt-app (#pt-use rational-equal ()) first second)))
  (#statement (#pt-app (#pt-use rational-equal ()) second first))
  (#proof
    (#pt-app
      (#pt-use integer-symmetric ())
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-project rational 0 first)
        (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second)))
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-project rational 0 second)
        (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))
      cross-equivalence)))
(#theorem rational-transitive
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter second (#pt-use rational ()))
    (#parameter third (#pt-use rational ()))
    (#parameter first-equivalence (#pt-app (#pt-use rational-equal ()) first second))
    (#parameter second-equivalence (#pt-app (#pt-use rational-equal ()) second third)))
  (#statement (#pt-app (#pt-use rational-equal ()) first third))
  (#proof
    (#pt-app
      (#pt-use integer-cross-product-transitive ())
      (#pt-project rational 0 first)
      (#pt-project rational 0 second)
      (#pt-project rational 0 third)
      (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))
      (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second))
      (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 third))
      (#pt-app
        (#pt-use integer-natural-embedding-nonzero ())
        (#pt-project rational 1 second)
        (#pt-project rational 2 second))
      first-equivalence
      second-equivalence)))
(#theorem rational-fraction-zero-implies-numerator-zero
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter fraction-zero (#pt-app (#pt-use rational-equal ()) first (#pt-use rational-zero ()))))
  (#statement
    (#pt-app (#pt-use integer-equal ()) (#pt-project rational 0 first) (#pt-use integer-zero ())))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-project rational 0 first)
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-project rational 0 first)
        (#pt-use integer-one ()))
      (#pt-use integer-zero ())
      (#pt-app
        (#pt-use integer-symmetric ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-project rational 0 first)
          (#pt-use integer-one ()))
        (#pt-project rational 0 first)
        (#pt-app (#pt-use integer-multiply-one ()) (#pt-project rational 0 first)))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-project rational 0 first)
          (#pt-use integer-one ()))
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-use integer-zero ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))
        (#pt-use integer-zero ())
        fraction-zero
        (#pt-app
          (#pt-use integer-zero-multiply ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))))))
(#theorem rational-zero-numerator
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter numerator-zero (#pt-app (#pt-use integer-equal ()) (#pt-project rational 0 first) (#pt-use integer-zero ()))))
  (#statement (#pt-app (#pt-use rational-equal ()) first (#pt-use rational-zero ())))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-project rational 0 first)
        (#pt-use integer-one ()))
      (#pt-project rational 0 first)
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-use integer-zero ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))
      (#pt-app (#pt-use integer-multiply-one ()) (#pt-project rational 0 first))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-project rational 0 first)
        (#pt-use integer-zero ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-use integer-zero ())
          (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))
        numerator-zero
        (#pt-app
          (#pt-use integer-symmetric ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-use integer-zero ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))
          (#pt-use integer-zero ())
          (#pt-app
            (#pt-use integer-zero-multiply ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))))))))
(#theorem rational-fraction-nonzero
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter numerator-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use integer-equal ()) (#pt-project rational 0 first) (#pt-use integer-zero ())))) #pt-false)))
  (#statement
    (#pt-pi
      ((denied-proof (#pt-app (#pt-use rational-equal ()) first (#pt-use rational-zero ()))))
      #pt-false))
  (#proof
    (#pt-lambda
      ((fraction-zero (#pt-app (#pt-use rational-equal ()) first (#pt-use rational-zero ()))))
      (#pt-app
        numerator-nonzero
        (#pt-app (#pt-use rational-fraction-zero-implies-numerator-zero ()) first fraction-zero)))))
