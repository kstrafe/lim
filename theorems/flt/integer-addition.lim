; Additive group laws for concrete formal-difference integers.
; All equalities below use the proved integer equivalence relation.
(#alias add = ../fermat_statement.lim::add)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-zero = ./integer-defs.lim::integer-zero)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-reflexive = ./integer-equality.lim::integer-reflexive)
(#alias add-associative = ./natural-addition.lim::add-associative)
(#alias add-commutative = ./natural-addition.lim::add-commutative)
(#alias add-zero-right = ./natural-addition.lim::add-zero-right)
(#alias add-cancel-left = ./natural-cancellation.lim::add-cancel-left)
(#alias sum-four-interchange = ./integer-cross-identities.lim::sum-four-interchange)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias congruence = ./equality.lim::congruence)
(#theorem integer-add-commutative
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-add ()) first second)
      (#pt-app (#pt-use integer-add ()) second first)))
  (#proof
    (#pt-app
      (#pt-use transitivity (0))
      #pt-nat
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 0 second))
        (#pt-app (#pt-use add ()) (#pt-project integer 1 second) (#pt-project integer 1 first)))
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 0 first))
        (#pt-app (#pt-use add ()) (#pt-project integer 1 second) (#pt-project integer 1 first)))
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 0 first))
        (#pt-app (#pt-use add ()) (#pt-project integer 1 first) (#pt-project integer 1 second)))
      (#pt-app
        (#pt-use congruence (0 0))
        #pt-nat
        #pt-nat
        (#pt-lambda
          ((endpoint #pt-nat))
          (#pt-app
            (#pt-use add ())
            endpoint
            (#pt-app (#pt-use add ()) (#pt-project integer 1 second) (#pt-project integer 1 first))))
        (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 0 second))
        (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 0 first))
        (#pt-app
          (#pt-use add-commutative ())
          (#pt-project integer 0 first)
          (#pt-project integer 0 second)))
      (#pt-app
        (#pt-use congruence (0 0))
        #pt-nat
        #pt-nat
        (#pt-lambda
          ((endpoint #pt-nat))
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 0 first))
            endpoint))
        (#pt-app (#pt-use add ()) (#pt-project integer 1 second) (#pt-project integer 1 first))
        (#pt-app (#pt-use add ()) (#pt-project integer 1 first) (#pt-project integer 1 second))
        (#pt-app
          (#pt-use add-commutative ())
          (#pt-project integer 1 second)
          (#pt-project integer 1 first))))))
(#theorem integer-add-associative
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-add ()) first second) third)
      (#pt-app (#pt-use integer-add ()) first (#pt-app (#pt-use integer-add ()) second third))))
  (#proof
    (#pt-app
      (#pt-use transitivity (0))
      #pt-nat
      (#pt-app
        (#pt-use add ())
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 0 second))
          (#pt-project integer 0 third))
        (#pt-app
          (#pt-use add ())
          (#pt-project integer 1 first)
          (#pt-app (#pt-use add ()) (#pt-project integer 1 second) (#pt-project integer 1 third))))
      (#pt-app
        (#pt-use add ())
        (#pt-app
          (#pt-use add ())
          (#pt-project integer 0 first)
          (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 0 third)))
        (#pt-app
          (#pt-use add ())
          (#pt-project integer 1 first)
          (#pt-app (#pt-use add ()) (#pt-project integer 1 second) (#pt-project integer 1 third))))
      (#pt-app
        (#pt-use add ())
        (#pt-app
          (#pt-use add ())
          (#pt-project integer 0 first)
          (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 0 third)))
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use add ()) (#pt-project integer 1 first) (#pt-project integer 1 second))
          (#pt-project integer 1 third)))
      (#pt-app
        (#pt-use congruence (0 0))
        #pt-nat
        #pt-nat
        (#pt-lambda
          ((endpoint #pt-nat))
          (#pt-app
            (#pt-use add ())
            endpoint
            (#pt-app
              (#pt-use add ())
              (#pt-project integer 1 first)
              (#pt-app
                (#pt-use add ())
                (#pt-project integer 1 second)
                (#pt-project integer 1 third)))))
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 0 second))
          (#pt-project integer 0 third))
        (#pt-app
          (#pt-use add ())
          (#pt-project integer 0 first)
          (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 0 third)))
        (#pt-app
          (#pt-use add-associative ())
          (#pt-project integer 0 first)
          (#pt-project integer 0 second)
          (#pt-project integer 0 third)))
      (#pt-app
        (#pt-use congruence (0 0))
        #pt-nat
        #pt-nat
        (#pt-lambda
          ((endpoint #pt-nat))
          (#pt-app
            (#pt-use add ())
            (#pt-app
              (#pt-use add ())
              (#pt-project integer 0 first)
              (#pt-app
                (#pt-use add ())
                (#pt-project integer 0 second)
                (#pt-project integer 0 third)))
            endpoint))
        (#pt-app
          (#pt-use add ())
          (#pt-project integer 1 first)
          (#pt-app (#pt-use add ()) (#pt-project integer 1 second) (#pt-project integer 1 third)))
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use add ()) (#pt-project integer 1 first) (#pt-project integer 1 second))
          (#pt-project integer 1 third))
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use add ()) (#pt-project integer 1 first) (#pt-project integer 1 second))
            (#pt-project integer 1 third))
          (#pt-app
            (#pt-use add ())
            (#pt-project integer 1 first)
            (#pt-app (#pt-use add ()) (#pt-project integer 1 second) (#pt-project integer 1 third)))
          (#pt-app
            (#pt-use add-associative ())
            (#pt-project integer 1 first)
            (#pt-project integer 1 second)
            (#pt-project integer 1 third)))))))
(#theorem integer-add-zero
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-add ()) first (#pt-use integer-zero ()))
      first))
  (#proof
    (#pt-app
      (#pt-use transitivity (0))
      #pt-nat
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use add ()) (#pt-project integer 0 first) #pt-zero)
        (#pt-project integer 1 first))
      (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 first))
      (#pt-app
        (#pt-use add ())
        (#pt-project integer 0 first)
        (#pt-app (#pt-use add ()) (#pt-project integer 1 first) #pt-zero))
      (#pt-app
        (#pt-use congruence (0 0))
        #pt-nat
        #pt-nat
        (#pt-lambda
          ((endpoint #pt-nat))
          (#pt-app (#pt-use add ()) endpoint (#pt-project integer 1 first)))
        (#pt-app (#pt-use add ()) (#pt-project integer 0 first) #pt-zero)
        (#pt-project integer 0 first)
        (#pt-app (#pt-use add-zero-right ()) (#pt-project integer 0 first)))
      (#pt-app
        (#pt-use congruence (0 0))
        #pt-nat
        #pt-nat
        (#pt-lambda
          ((endpoint #pt-nat))
          (#pt-app (#pt-use add ()) (#pt-project integer 0 first) endpoint))
        (#pt-project integer 1 first)
        (#pt-app (#pt-use add ()) (#pt-project integer 1 first) #pt-zero)
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          (#pt-app (#pt-use add ()) (#pt-project integer 1 first) #pt-zero)
          (#pt-project integer 1 first)
          (#pt-app (#pt-use add-zero-right ()) (#pt-project integer 1 first)))))))
(#theorem integer-add-inverse
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-add ()) first (#pt-app (#pt-use integer-negate ()) first))
      (#pt-use integer-zero ())))
  (#proof
    (#pt-app
      (#pt-use transitivity (0))
      #pt-nat
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 first))
        #pt-zero)
      (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 first))
      (#pt-app (#pt-use add ()) (#pt-project integer 1 first) (#pt-project integer 0 first))
      (#pt-app
        (#pt-use add-zero-right ())
        (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 first)))
      (#pt-app
        (#pt-use add-commutative ())
        (#pt-project integer 0 first)
        (#pt-project integer 1 first)))))
(#theorem integer-negate-involution
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-negate ()) first))
      first))
  (#proof
    (#pt-refl
      #pt-nat
      (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 first)))))
(#theorem integer-negate-add
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-add ()) first second))
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use integer-negate ()) first)
        (#pt-app (#pt-use integer-negate ()) second))))
  (#proof
    (#pt-refl
      #pt-nat
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use add ()) (#pt-project integer 1 first) (#pt-project integer 1 second))
        (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 0 second))))))
(#theorem integer-add-cancel-left
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter sum-equivalence (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) first second) (#pt-app (#pt-use integer-add ()) first third))))
  (#statement (#pt-app (#pt-use integer-equal ()) second third))
  (#proof
    (#pt-app
      (#pt-use add-cancel-left ())
      (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 first))
      (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 1 third))
      (#pt-app (#pt-use add ()) (#pt-project integer 0 third) (#pt-project integer 1 second))
      (#pt-app
        (#pt-use transitivity (0))
        #pt-nat
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 first))
          (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 1 third)))
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 0 second))
          (#pt-app (#pt-use add ()) (#pt-project integer 1 first) (#pt-project integer 1 third)))
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 first))
          (#pt-app (#pt-use add ()) (#pt-project integer 0 third) (#pt-project integer 1 second)))
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 0 second))
            (#pt-app (#pt-use add ()) (#pt-project integer 1 first) (#pt-project integer 1 third)))
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 first))
            (#pt-app (#pt-use add ()) (#pt-project integer 0 second) (#pt-project integer 1 third)))
          (#pt-app
            (#pt-use sum-four-interchange ())
            (#pt-project integer 0 first)
            (#pt-project integer 0 second)
            (#pt-project integer 1 first)
            (#pt-project integer 1 third)))
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 0 second))
            (#pt-app (#pt-use add ()) (#pt-project integer 1 first) (#pt-project integer 1 third)))
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 0 third))
            (#pt-app (#pt-use add ()) (#pt-project integer 1 first) (#pt-project integer 1 second)))
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use add ()) (#pt-project integer 0 first) (#pt-project integer 1 first))
            (#pt-app (#pt-use add ()) (#pt-project integer 0 third) (#pt-project integer 1 second)))
          sum-equivalence
          (#pt-app
            (#pt-use sum-four-interchange ())
            (#pt-project integer 0 first)
            (#pt-project integer 0 third)
            (#pt-project integer 1 first)
            (#pt-project integer 1 second)))))))
