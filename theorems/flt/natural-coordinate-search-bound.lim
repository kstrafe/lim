; An arbitrary natural square budget B=3*m*m+q proves m<B+1.
; The actual gap m*m=m+g gives an explicit strict-bound witness.
; There is no finite sampling bound on the original mathematical naturals.
(#alias add = ./../fermat_statement.lim::add)
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#alias square-has-self-gap = ./natural-descent-bounds.lim::square-has-self-gap)
(#alias add-zero-right = ./natural-addition.lim::add-zero-right)
(#alias add-associative = ./natural-addition.lim::add-associative)
(#alias congruence = ./equality.lim::congruence)
(#alias transitivity = ./equality.lim::transitivity)
(#theorem natural-three-summands-with-tail
  (#universes)
  (#parameters
    (#parameter value #pt-nat)
    (#parameter tail #pt-nat))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) (#pt-numeral 3) value) tail)
      (#pt-app
        (#pt-use add ())
        value
        (#pt-app (#pt-use add ()) value (#pt-app (#pt-use add ()) value tail)))))
  (#proof
    (#pt-app
      (#pt-use transitivity (0))
      #pt-nat
      (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) (#pt-numeral 3) value) tail)
      (#pt-app
        (#pt-use add ())
        (#pt-app (#pt-use add ()) value (#pt-app (#pt-use add ()) value value))
        tail)
      (#pt-app
        (#pt-use add ())
        value
        (#pt-app (#pt-use add ()) value (#pt-app (#pt-use add ()) value tail)))
      (#pt-app
        (#pt-use congruence (0 0))
        #pt-nat
        #pt-nat
        (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use add ()) endpoint tail))
        (#pt-app (#pt-use multiply ()) (#pt-numeral 3) value)
        (#pt-app (#pt-use add ()) value (#pt-app (#pt-use add ()) value value))
        (#pt-app
          (#pt-use congruence (0 0))
          #pt-nat
          #pt-nat
          (#pt-lambda
            ((endpoint #pt-nat))
            (#pt-app (#pt-use add ()) value (#pt-app (#pt-use add ()) value endpoint)))
          (#pt-app (#pt-use add ()) value #pt-zero)
          value
          (#pt-app (#pt-use add-zero-right ()) value)))
      (#pt-app
        (#pt-use transitivity (0))
        #pt-nat
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use add ()) value (#pt-app (#pt-use add ()) value value))
          tail)
        (#pt-app
          (#pt-use add ())
          value
          (#pt-app (#pt-use add ()) (#pt-app (#pt-use add ()) value value) tail))
        (#pt-app
          (#pt-use add ())
          value
          (#pt-app (#pt-use add ()) value (#pt-app (#pt-use add ()) value tail)))
        (#pt-app (#pt-use add-associative ()) value (#pt-app (#pt-use add ()) value value) tail)
        (#pt-app
          (#pt-use congruence (0 0))
          #pt-nat
          #pt-nat
          (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use add ()) value endpoint))
          (#pt-app (#pt-use add ()) (#pt-app (#pt-use add ()) value value) tail)
          (#pt-app (#pt-use add ()) value (#pt-app (#pt-use add ()) value tail))
          (#pt-app (#pt-use add-associative ()) value value tail))))))
(#theorem natural-three-square-budget-magnitude-bound
  (#universes)
  (#parameters
    (#parameter magnitude #pt-nat)
    (#parameter square-remainder #pt-nat)
    (#parameter budget #pt-nat)
    (#parameter budget-equation (#pt-eq #pt-nat budget (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) (#pt-numeral 3) (#pt-app (#pt-use multiply ()) magnitude magnitude)) square-remainder))))
  (#statement (#pt-app (#pt-use less-than ()) magnitude (#pt-succ budget)))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-square-gap #pt-nat))
          (#pt-eq
            #pt-nat
            (#pt-app (#pt-use multiply ()) magnitude magnitude)
            (#pt-app (#pt-use add ()) magnitude candidate-square-gap))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-square-gap #pt-nat))
                (#pt-eq
                  #pt-nat
                  (#pt-app (#pt-use multiply ()) magnitude magnitude)
                  (#pt-app (#pt-use add ()) magnitude candidate-square-gap))))))
        (#pt-app (#pt-use less-than ()) magnitude (#pt-succ budget)))
      (
        (#pt-lambda
          (
            (square-gap #pt-nat)
            (square-equation
              (#pt-eq
                #pt-nat
                (#pt-app (#pt-use multiply ()) magnitude magnitude)
                (#pt-app (#pt-use add ()) magnitude square-gap))))
          (#pt-construct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-gap #pt-nat))
                (#pt-eq
                  #pt-nat
                  (#pt-succ budget)
                  (#pt-app (#pt-use add ()) (#pt-succ magnitude) candidate-gap))))
            introduce
            (
              (#pt-app
                (#pt-use add ())
                square-gap
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) magnitude magnitude)
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use multiply ()) magnitude magnitude)
                    square-remainder)))
              (#pt-app
                (#pt-use congruence (0 0))
                #pt-nat
                #pt-nat
                (#pt-lambda ((endpoint #pt-nat)) (#pt-succ endpoint))
                budget
                (#pt-app
                  (#pt-use add ())
                  magnitude
                  (#pt-app
                    (#pt-use add ())
                    square-gap
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use multiply ()) magnitude magnitude)
                      (#pt-app
                        (#pt-use add ())
                        (#pt-app (#pt-use multiply ()) magnitude magnitude)
                        square-remainder))))
                (#pt-app
                  (#pt-use transitivity (0))
                  #pt-nat
                  budget
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app
                      (#pt-use multiply ())
                      (#pt-numeral 3)
                      (#pt-app (#pt-use multiply ()) magnitude magnitude))
                    square-remainder)
                  (#pt-app
                    (#pt-use add ())
                    magnitude
                    (#pt-app
                      (#pt-use add ())
                      square-gap
                      (#pt-app
                        (#pt-use add ())
                        (#pt-app (#pt-use multiply ()) magnitude magnitude)
                        (#pt-app
                          (#pt-use add ())
                          (#pt-app (#pt-use multiply ()) magnitude magnitude)
                          square-remainder))))
                  budget-equation
                  (#pt-app
                    (#pt-use transitivity (0))
                    #pt-nat
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app
                        (#pt-use multiply ())
                        (#pt-numeral 3)
                        (#pt-app (#pt-use multiply ()) magnitude magnitude))
                      square-remainder)
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use multiply ()) magnitude magnitude)
                      (#pt-app
                        (#pt-use add ())
                        (#pt-app (#pt-use multiply ()) magnitude magnitude)
                        (#pt-app
                          (#pt-use add ())
                          (#pt-app (#pt-use multiply ()) magnitude magnitude)
                          square-remainder)))
                    (#pt-app
                      (#pt-use add ())
                      magnitude
                      (#pt-app
                        (#pt-use add ())
                        square-gap
                        (#pt-app
                          (#pt-use add ())
                          (#pt-app (#pt-use multiply ()) magnitude magnitude)
                          (#pt-app
                            (#pt-use add ())
                            (#pt-app (#pt-use multiply ()) magnitude magnitude)
                            square-remainder))))
                    (#pt-app
                      (#pt-use natural-three-summands-with-tail ())
                      (#pt-app (#pt-use multiply ()) magnitude magnitude)
                      square-remainder)
                    (#pt-app
                      (#pt-use transitivity (0))
                      #pt-nat
                      (#pt-app
                        (#pt-use add ())
                        (#pt-app (#pt-use multiply ()) magnitude magnitude)
                        (#pt-app
                          (#pt-use add ())
                          (#pt-app (#pt-use multiply ()) magnitude magnitude)
                          (#pt-app
                            (#pt-use add ())
                            (#pt-app (#pt-use multiply ()) magnitude magnitude)
                            square-remainder)))
                      (#pt-app
                        (#pt-use add ())
                        (#pt-app (#pt-use add ()) magnitude square-gap)
                        (#pt-app
                          (#pt-use add ())
                          (#pt-app (#pt-use multiply ()) magnitude magnitude)
                          (#pt-app
                            (#pt-use add ())
                            (#pt-app (#pt-use multiply ()) magnitude magnitude)
                            square-remainder)))
                      (#pt-app
                        (#pt-use add ())
                        magnitude
                        (#pt-app
                          (#pt-use add ())
                          square-gap
                          (#pt-app
                            (#pt-use add ())
                            (#pt-app (#pt-use multiply ()) magnitude magnitude)
                            (#pt-app
                              (#pt-use add ())
                              (#pt-app (#pt-use multiply ()) magnitude magnitude)
                              square-remainder))))
                      (#pt-app
                        (#pt-use congruence (0 0))
                        #pt-nat
                        #pt-nat
                        (#pt-lambda
                          ((endpoint #pt-nat))
                          (#pt-app
                            (#pt-use add ())
                            endpoint
                            (#pt-app
                              (#pt-use add ())
                              (#pt-app (#pt-use multiply ()) magnitude magnitude)
                              (#pt-app
                                (#pt-use add ())
                                (#pt-app (#pt-use multiply ()) magnitude magnitude)
                                square-remainder))))
                        (#pt-app (#pt-use multiply ()) magnitude magnitude)
                        (#pt-app (#pt-use add ()) magnitude square-gap)
                        square-equation)
                      (#pt-app
                        (#pt-use add-associative ())
                        magnitude
                        square-gap
                        (#pt-app
                          (#pt-use add ())
                          (#pt-app (#pt-use multiply ()) magnitude magnitude)
                          (#pt-app
                            (#pt-use add ())
                            (#pt-app (#pt-use multiply ()) magnitude magnitude)
                            square-remainder)))))))))))
      (#pt-app (#pt-use square-has-self-gap ()) magnitude))))
