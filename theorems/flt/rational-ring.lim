          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project rational 0 second)
                (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 third)))
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project rational 0 third)
