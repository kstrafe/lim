        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 first)
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app
                (#pt-use multiply ())
                (#pt-project rational 1 second)
