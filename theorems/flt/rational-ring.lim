                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-project rational 0 third)
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second))))
                (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))))))
      (#pt-app
        (#pt-use multiply-associative ())
        (#pt-project rational 1 first)
        (#pt-project rational 1 second)
        (#pt-project rational 1 third)))))
(#theorem rational-add-zero
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app (#pt-use rational-add ()) first (#pt-use rational-zero ()))
      first))
  (#proof
    (#pt-app
      (#pt-use rational-components-congruent ())
      (#pt-app (#pt-use rational-add ()) first (#pt-use rational-zero ()))
      first
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 first)
            (#pt-use integer-one ()))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-use integer-zero ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))))
        (#pt-app (#pt-use integer-add ()) (#pt-project rational 0 first) (#pt-use integer-zero ()))
        (#pt-project rational 0 first)
        (#pt-app
          (#pt-use integer-add-congruent ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 first)
            (#pt-use integer-one ()))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-use integer-zero ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))
          (#pt-project rational 0 first)
          (#pt-use integer-zero ())
          (#pt-app (#pt-use integer-multiply-one ()) (#pt-project rational 0 first))
          (#pt-app
            (#pt-use integer-zero-multiply ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))))
        (#pt-app (#pt-use integer-add-zero ()) (#pt-project rational 0 first)))
      (#pt-app (#pt-use multiply-one-right ()) (#pt-project rational 1 first)))))
(#theorem rational-add-inverse
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app (#pt-use rational-add ()) first (#pt-app (#pt-use rational-negate ()) first))
      (#pt-use rational-zero ())))
  (#proof
    (#pt-app
      (#pt-use rational-zero-numerator ())
      (#pt-app (#pt-use rational-add ()) first (#pt-app (#pt-use rational-negate ()) first))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 first)
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-negate ()) (#pt-project rational 0 first))
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))))
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 first)
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project rational 0 first)
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))))
        (#pt-use integer-zero ())
        (#pt-app
          (#pt-use integer-add-congruent ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 first)
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))
