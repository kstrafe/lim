          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project rational 0 first)
                (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second)))
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project rational 0 second)
                (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))))
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 third)))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 third)
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second))))
          (#pt-app
            (#pt-use integer-reflexive ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app
                (#pt-use integer-add ())
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-project rational 0 first)
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second)))
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-project rational 0 second)
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))))
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 third))))
          (#pt-app
            (#pt-use integer-multiply-congruent ())
            (#pt-project rational 0 third)
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app
                (#pt-use multiply ())
                (#pt-project rational 1 first)
                (#pt-project rational 1 second)))
            (#pt-project rational 0 third)
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second)))
            (#pt-app (#pt-use integer-reflexive ()) (#pt-project rational 0 third))
            (#pt-app
              (#pt-use integer-symmetric ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))
                (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second)))
              (#pt-app
                (#pt-use integer-of-natural ())
                (#pt-app
                  (#pt-use multiply ())
                  (#pt-project rational 1 first)
                  (#pt-project rational 1 second)))
              (#pt-app
                (#pt-use integer-multiply-of-natural ())
                (#pt-project rational 1 first)
