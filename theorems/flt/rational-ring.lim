; Construct the actual rational commutative-ring laws from certified
; integer cross products and denominator proofs. Equivalent fractions
; may have different denominators. Nonzero multiplication and powers
; are derived from the actual integer numerators, not a field axiom.
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-zero = ./integer-defs.lim::integer-zero)
(#alias integer-one = ./integer-defs.lim::integer-one)
