(#alias multiply-one-right = ./natural-multiplication-right.lim::multiply-one-right)
(#alias integer-negate-involution = ./integer-addition.lim::integer-negate-involution)
(#alias integer-nonzero-product = ./integer-domain.lim::integer-nonzero-product)
(#theorem rational-multiply-commutative
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter second (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app (#pt-use rational-multiply ()) first second)
      (#pt-app (#pt-use rational-multiply ()) second first)))
  (#proof
    (#pt-app
      (#pt-use rational-components-congruent ())
      (#pt-app (#pt-use rational-multiply ()) first second)
      (#pt-app (#pt-use rational-multiply ()) second first)
      (#pt-app
        (#pt-use integer-multiply-commutative ())
        (#pt-project rational 0 first)
        (#pt-project rational 0 second))
      (#pt-app
        (#pt-use multiply-commutative ())
        (#pt-project rational 1 first)
        (#pt-project rational 1 second)))))
(#theorem rational-multiply-associative
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter second (#pt-use rational ()))
    (#parameter third (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app (#pt-use rational-multiply ()) first second)
        third)
      (#pt-app
        (#pt-use rational-multiply ())
        first
        (#pt-app (#pt-use rational-multiply ()) second third))))
  (#proof
    (#pt-app
      (#pt-use rational-components-congruent ())
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app (#pt-use rational-multiply ()) first second)
        third)
      (#pt-app
        (#pt-use rational-multiply ())
        first
        (#pt-app (#pt-use rational-multiply ()) second third))
      (#pt-app
        (#pt-use integer-multiply-associative ())
        (#pt-project rational 0 first)
        (#pt-project rational 0 second)
        (#pt-project rational 0 third))
      (#pt-app
        (#pt-use multiply-associative ())
        (#pt-project rational 1 first)
        (#pt-project rational 1 second)
        (#pt-project rational 1 third)))))
(#theorem rational-multiply-one
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app (#pt-use rational-multiply ()) first (#pt-use rational-one ()))
      first))
  (#proof
    (#pt-app
      (#pt-use rational-components-congruent ())
      (#pt-app (#pt-use rational-multiply ()) first (#pt-use rational-one ()))
      first
      (#pt-app (#pt-use integer-multiply-one ()) (#pt-project rational 0 first))
      (#pt-app (#pt-use multiply-one-right ()) (#pt-project rational 1 first)))))
(#theorem rational-multiply-zero
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app (#pt-use rational-multiply ()) first (#pt-use rational-zero ()))
      (#pt-use rational-zero ())))
  (#proof
    (#pt-app
      (#pt-use rational-zero-numerator ())
      (#pt-app (#pt-use rational-multiply ()) first (#pt-use rational-zero ()))
      (#pt-app (#pt-use integer-multiply-zero ()) (#pt-project rational 0 first)))))
(#theorem rational-add-commutative
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter second (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app (#pt-use rational-add ()) first second)
      (#pt-app (#pt-use rational-add ()) second first)))
  (#proof
    (#pt-app
      (#pt-use rational-components-congruent ())
      (#pt-app (#pt-use rational-add ()) first second)
      (#pt-app (#pt-use rational-add ()) second first)
      (#pt-app
        (#pt-use integer-add-commutative ())
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-project rational 0 first)
          (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second)))
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-project rational 0 second)
          (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))))
      (#pt-app
        (#pt-use multiply-commutative ())
        (#pt-project rational 1 first)
        (#pt-project rational 1 second)))))
(#theorem rational-add-associative
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter second (#pt-use rational ()))
    (#parameter third (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app (#pt-use rational-add ()) (#pt-app (#pt-use rational-add ()) first second) third)
      (#pt-app (#pt-use rational-add ()) first (#pt-app (#pt-use rational-add ()) second third))))
  (#proof
    (#pt-app
      (#pt-use rational-components-congruent ())
      (#pt-app (#pt-use rational-add ()) (#pt-app (#pt-use rational-add ()) first second) third)
      (#pt-app (#pt-use rational-add ()) first (#pt-app (#pt-use rational-add ()) second third))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project rational 0 first)
                (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second)))
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project rational 0 second)
                (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))))
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 third)))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 third)
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app
                (#pt-use multiply ())
                (#pt-project rational 1 first)
                (#pt-project rational 1 second)))))
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app
              (#pt-use integer-add ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project rational 0 first)
                (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second)))
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project rational 0 second)
                (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))))
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 third)))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 third)
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))
