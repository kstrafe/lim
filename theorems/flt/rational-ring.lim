                (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))
                (#pt-app
                  (#pt-use integer-of-natural ())
                  (#pt-project rational 1 (#pt-app (#pt-use rational-add ()) second third)))
                (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second))
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 third)))
                (#pt-app
                  (#pt-use integer-reflexive ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))
                (#pt-app
                  (#pt-use integer-symmetric ())
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second))
                    (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 third)))
                  (#pt-app
                    (#pt-use integer-of-natural ())
                    (#pt-app
                      (#pt-use multiply ())
                      (#pt-project rational 1 second)
                      (#pt-project rational 1 third)))
                  (#pt-app
                    (#pt-use integer-multiply-of-natural ())
                    (#pt-project rational 1 second)
                    (#pt-project rational 1 third)))))))))))
(#theorem rational-nonzero-numerator
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter fraction-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use rational-equal ()) first (#pt-use rational-zero ())))) #pt-false)))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-project rational 0 first)
            (#pt-use integer-zero ()))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (numerator-zero
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-project rational 0 first)
            (#pt-use integer-zero ()))))
      (#pt-app fraction-nonzero (#pt-app (#pt-use rational-zero-numerator ()) first numerator-zero)))))
(#theorem rational-nonzero-product
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter second (#pt-use rational ()))
    (#parameter first-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use rational-equal ()) first (#pt-use rational-zero ())))) #pt-false))
    (#parameter second-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use rational-equal ()) second (#pt-use rational-zero ())))) #pt-false)))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-app (#pt-use rational-multiply ()) first second)
            (#pt-use rational-zero ()))))
      #pt-false))
  (#proof
    (#pt-app
      (#pt-use rational-fraction-nonzero ())
      (#pt-app (#pt-use rational-multiply ()) first second)
      (#pt-app
        (#pt-use integer-nonzero-product ())
        (#pt-project rational 0 first)
        (#pt-project rational 0 second)
        (#pt-app (#pt-use rational-nonzero-numerator ()) first first-nonzero)
        (#pt-app (#pt-use rational-nonzero-numerator ()) second second-nonzero)))))
(#theorem rational-power-nonzero
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter exponent #pt-nat)
    (#parameter number-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use rational-equal ()) first (#pt-use rational-zero ())))) #pt-false)))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use rational-equal ())
            (#pt-app (#pt-use rational-power ()) first exponent)
            (#pt-use rational-zero ()))))
      #pt-false))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((index #pt-nat))
        (#pt-pi
          (
            (denied-proof
              (#pt-app
                (#pt-use rational-equal ())
                (#pt-app (#pt-use rational-power ()) first index)
                (#pt-use rational-zero ()))))
          #pt-false))
      (#pt-app
        (#pt-use rational-fraction-nonzero ())
        (#pt-use rational-one ())
        (#pt-app
          (#pt-use integer-natural-embedding-nonzero ())
          (#pt-succ #pt-zero)
          (#pt-app (#pt-use successor-not-zero ()) #pt-zero)))
      (#pt-lambda
        (
          (previous-exponent #pt-nat)
          (previous-nonzero
            (#pt-pi
              (
                (denied-proof
                  (#pt-app
                    (#pt-use rational-equal ())
                    (#pt-app (#pt-use rational-power ()) first previous-exponent)
                    (#pt-use rational-zero ()))))
              #pt-false)))
        (#pt-app
          (#pt-use rational-nonzero-product ())
          first
          (#pt-app (#pt-use rational-power ()) first previous-exponent)
          number-nonzero
          previous-nonzero))
      exponent)))
