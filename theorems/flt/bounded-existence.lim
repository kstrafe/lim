; A generic constructive predicate saying that property holds at some index
; in the finite prefix from zero through bound.
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-left = ./logical-connectives.lim::disjunction-left)
(#alias disjunction-right = ./logical-connectives.lim::disjunction-right)
(#math-definition any-up-to ()
  (#pt-pi ((property (#pt-pi ((index #pt-nat)) #pt-prop)) (bound #pt-nat)) #pt-prop)
  (#pt-lambda
    ((property (#pt-pi ((index #pt-nat)) #pt-prop)) (bound #pt-nat))
    (#pt-nat-induct
      (#pt-lambda ((ordinal #pt-nat)) #pt-prop)
      (#pt-app property #pt-zero)
      (#pt-lambda
        ((previous #pt-nat) (accumulated #pt-prop))
        (#pt-app (#pt-use disjunction ()) accumulated (#pt-app property (#pt-succ previous))))
      bound)))
(#theorem any-up-to-grow
  (#universes)
  (#parameters
    (#parameter property (#pt-pi ((index #pt-nat)) #pt-prop))
    (#parameter bound #pt-nat)
    (#parameter found (#pt-app (#pt-use any-up-to ()) property bound)))
  (#statement (#pt-app (#pt-use any-up-to ()) property (#pt-succ bound)))
  (#proof
    (#pt-app
      (#pt-use disjunction-left ())
      (#pt-app (#pt-use any-up-to ()) property bound)
      (#pt-app property (#pt-succ bound))
      found)))
(#theorem any-up-to-here
  (#universes)
  (#parameters
    (#parameter property (#pt-pi ((index #pt-nat)) #pt-prop))
    (#parameter bound #pt-nat)
    (#parameter at-bound (#pt-app property bound)))
  (#statement (#pt-app (#pt-use any-up-to ()) property bound))
  (#proof
    (#pt-app
      (#pt-nat-induct
        (#pt-lambda
          ((ordinal #pt-nat))
          (#pt-pi
            ((proof-at-index (#pt-app property ordinal)))
            (#pt-app (#pt-use any-up-to ()) property ordinal)))
        (#pt-lambda ((proof-at-zero (#pt-app property #pt-zero))) proof-at-zero)
        (#pt-lambda
          (
            (previous #pt-nat)
            (induction-hypothesis
              (#pt-pi
                ((proof-at-previous (#pt-app property previous)))
                (#pt-app (#pt-use any-up-to ()) property previous)))
            (proof-at-successor (#pt-app property (#pt-succ previous))))
          (#pt-app
            (#pt-use disjunction-right ())
            (#pt-app (#pt-use any-up-to ()) property previous)
            (#pt-app property (#pt-succ previous))
            proof-at-successor))
        bound)
      at-bound)))
