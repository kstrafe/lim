; Adapted mathematical source: pinned Mathlib RingTheory/Ideal/Operations.lean
; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean:268-376.
; Generated by scripts/generate-flt-point-ideal-addition.py; checked native terms.
; Construct the actual first
; point-ideal inclusion and both additional common-ideal
; memberships. No kernel or comaximality witness is assumed.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias
  point-ideal-addition-common-ideal
  =
  ./point-ideal-addition-product-generators.lim::point-ideal-addition-common-ideal)
(#alias ring-ideal-member = ./ring-ideal-data.lim::ring-ideal-member)
(#alias ring-ideal-pair = ./ring-ideal-pair.lim::ring-ideal-pair)
(#alias ring-ideal-pair-first = ./ring-ideal-pair.lim::ring-ideal-pair-first)
(#alias ring-ideal-pair-least = ./ring-ideal-pair.lim::ring-ideal-pair-least)
(#alias ring-ideal-pair-second = ./ring-ideal-pair.lim::ring-ideal-pair-second)
(#alias ring-ideal-subset = ./ring-ideal-data.lim::ring-ideal-subset)
(#alias ring-ideal-sum-left = ./ring-ideal-sum-universal.lim::ring-ideal-sum-left)
(#alias ring-ideal-sum-right = ./ring-ideal-sum-universal.lim::ring-ideal-sum-right)
(#theorem point-ideal-addition-common-contains-point
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-X Carrier)
    (#parameter second-X Carrier)
    (#parameter sum-X Carrier)
    (#parameter line Carrier)
    (#parameter opposite Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring first-X line)
      (#pt-app
        (#pt-use point-ideal-addition-common-ideal ())
        Carrier
        coefficient-ring
        first-X
        second-X
        sum-X
        line
        opposite)))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-pair-least ())
      Carrier
      coefficient-ring
      first-X
      line
      (#pt-app
        (#pt-use point-ideal-addition-common-ideal ())
        Carrier
        coefficient-ring
        first-X
        second-X
        sum-X
        line
        opposite)
      (#pt-app
        (#pt-app
          (#pt-use ring-ideal-sum-left ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring first-X second-X)
          (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring line opposite))
        first-X
        (#pt-app (#pt-use ring-ideal-pair-first ()) Carrier coefficient-ring first-X second-X))
      (#pt-app
        (#pt-app
          (#pt-use ring-ideal-sum-right ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring first-X second-X)
          (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring line opposite))
        line
        (#pt-app (#pt-use ring-ideal-pair-first ()) Carrier coefficient-ring line opposite)))))
(#theorem point-ideal-addition-common-contains-second
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-X Carrier)
    (#parameter second-X Carrier)
    (#parameter sum-X Carrier)
    (#parameter line Carrier)
    (#parameter opposite Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-member ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use point-ideal-addition-common-ideal ())
        Carrier
        coefficient-ring
        first-X
        second-X
        sum-X
        line
        opposite)
      second-X))
  (#proof
    (#pt-app
      (#pt-app
        (#pt-use ring-ideal-sum-left ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring first-X second-X)
        (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring line opposite))
      second-X
      (#pt-app (#pt-use ring-ideal-pair-second ()) Carrier coefficient-ring first-X second-X))))
(#theorem point-ideal-addition-common-contains-opposite
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-X Carrier)
    (#parameter second-X Carrier)
    (#parameter sum-X Carrier)
    (#parameter line Carrier)
    (#parameter opposite Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-member ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use point-ideal-addition-common-ideal ())
        Carrier
        coefficient-ring
        first-X
        second-X
        sum-X
        line
        opposite)
      opposite))
  (#proof
    (#pt-app
      (#pt-app
        (#pt-use ring-ideal-sum-right ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring first-X second-X)
        (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring line opposite))
      opposite
      (#pt-app (#pt-use ring-ideal-pair-second ()) Carrier coefficient-ring line opposite))))
