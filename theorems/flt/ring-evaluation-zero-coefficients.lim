                      Image
                      image-ring
                      coefficient-morphism
                      evaluation-point
                      tail)
                    (#pt-app (#pt-use ring-zero ()) Image image-ring)))))
            (#pt-lambda
              (
                (zero-coefficients-bound-0003
                  (#pt-app
                    (#pt-use ring-polynomial-equal ())
                    Carrier
                    coefficient-ring
                    (#pt-construct finite-list () (Carrier) cons (head tail))
                    (#pt-construct finite-list () (Carrier) nil ()))))
              (#pt-app
