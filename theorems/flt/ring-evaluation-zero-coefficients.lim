    (#parameter coefficient-morphism (#pt-app (#pt-use ring-evaluation-morphism ()) Carrier coefficient-ring Image image-ring))
    (#parameter evaluation-point Image)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter zero-coefficients (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring polynomial (#pt-construct finite-list () (Carrier) nil ()))))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
