                      Carrier
                      coefficient-ring
                      Image
                      image-ring
                      coefficient-morphism
                      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
                    (#pt-app (#pt-use ring-zero ()) Image image-ring)
                    (#pt-app
                      (#pt-use ring-evaluation-map-congruent ())
                      Carrier
                      coefficient-ring
                      Image
                      image-ring
                      coefficient-morphism
                      head
                      (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
                      (#pt-app zero-coefficients-bound-0003 #pt-zero))
                    (#pt-app
