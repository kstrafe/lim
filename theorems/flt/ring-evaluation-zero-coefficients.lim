                  (#pt-app
                    (#pt-use ring-multiply ())
                    Image
                    image-ring
                    evaluation-point
                    (#pt-app (#pt-use ring-zero ()) Image image-ring)))
                (#pt-app (#pt-use ring-zero ()) Image image-ring)
                (#pt-app
                  (#pt-use ring-add-congruent ())
                  Image
                  image-ring
                  (#pt-app
                    (#pt-use ring-evaluation-map ())
                    Carrier
                    coefficient-ring
                    Image
                    image-ring
                    coefficient-morphism
                    head)
                  (#pt-app
                    (#pt-use ring-multiply ())
