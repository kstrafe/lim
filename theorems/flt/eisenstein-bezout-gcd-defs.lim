; A gcd carries actual divisor witnesses for both inputs and actual
; left/right Bezout coefficients. Every common divisor then divides it.
; This certificate is a proposition, without an abstract gcd oracle.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-divides = ./eisenstein-defs.lim::eisenstein-divides)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-zero = ./eisenstein-ring.lim::eisenstein-multiply-zero)
(#alias eisenstein-multiply-commutative = ./eisenstein-ring.lim::eisenstein-multiply-commutative)
(#alias eisenstein-one-multiply = ./eisenstein-cubic-bridge.lim::eisenstein-one-multiply)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias exists = ./logic-exists.lim::exists)
(#alias eisenstein-add = ./eisenstein-defs.lim::eisenstein-add)
(#alias eisenstein-add-congruent = ./eisenstein-equality.lim::eisenstein-add-congruent)
(#alias eisenstein-add-zero = ./eisenstein-ring.lim::eisenstein-add-zero)
(#alias eisenstein-divides-reflexive = ./eisenstein-divisibility.lim::eisenstein-divides-reflexive)
(#alias eisenstein-divides-zero = ./eisenstein-divisibility.lim::eisenstein-divides-zero)
(#alias
  eisenstein-divides-congruent-target
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-congruent-target)
(#alias
  eisenstein-divides-product-right
  =
  ./eisenstein-divisibility.lim::eisenstein-divides-product-right)
(#alias eisenstein-divides-add = ./eisenstein-additive-divisibility.lim::eisenstein-divides-add)
(#alias eisenstein-natural-norm = ./eisenstein-norm-defs.lim::eisenstein-natural-norm)
(#math-definition eisenstein-bezout-gcd-spec ()
  (#pt-pi
    (
      (first (#pt-use eisenstein ()))
      (second (#pt-use eisenstein ()))
      (gcd (#pt-use eisenstein ()))
      (left-coefficient (#pt-use eisenstein ()))
      (right-coefficient (#pt-use eisenstein ())))
    #pt-prop)
  (#pt-lambda
    (
      (first (#pt-use eisenstein ()))
      (second (#pt-use eisenstein ()))
      (gcd (#pt-use eisenstein ()))
      (left-coefficient (#pt-use eisenstein ()))
      (right-coefficient (#pt-use eisenstein ())))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app (#pt-use eisenstein-divides ()) gcd first)
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app (#pt-use eisenstein-divides ()) gcd second)
        (#pt-app
          (#pt-use eisenstein-equal ())
          gcd
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first)
            (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient second)))))))
(#math-definition eisenstein-has-bezout-gcd ()
  (#pt-pi ((first (#pt-use eisenstein ())) (second (#pt-use eisenstein ()))) #pt-prop)
  (#pt-lambda
    ((first (#pt-use eisenstein ())) (second (#pt-use eisenstein ())))
    (#pt-app
      (#pt-use exists (0))
      (#pt-use eisenstein ())
      (#pt-lambda
        ((candidate-gcd (#pt-use eisenstein ())))
        (#pt-app
          (#pt-use exists (0))
          (#pt-use eisenstein ())
          (#pt-lambda
            ((candidate-left-coefficient (#pt-use eisenstein ())))
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-right-coefficient (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-bezout-gcd-spec ())
                  first
                  second
                  candidate-gcd
                  candidate-left-coefficient
                  candidate-right-coefficient)))))))))
(#math-definition eisenstein-bezout-gcd-at-norm ()
  (#pt-pi ((divisor-norm #pt-nat)) #pt-prop)
  (#pt-lambda
    ((divisor-norm #pt-nat))
    (#pt-pi
      (
        (norm-first (#pt-use eisenstein ()))
        (norm-second (#pt-use eisenstein ()))
        (norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) norm-second divisor-norm)))
      (#pt-app (#pt-use eisenstein-has-bezout-gcd ()) norm-first norm-second))))
(#theorem eisenstein-bezout-gcd-zero-right
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter second-zero (#pt-app (#pt-use eisenstein-equal ()) second (#pt-use eisenstein-zero ()))))
  (#statement (#pt-app (#pt-use eisenstein-has-bezout-gcd ()) first second))
  (#proof
    (#pt-construct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-gcd (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use exists (0))
            (#pt-use eisenstein ())
            (#pt-lambda
              ((candidate-left-coefficient (#pt-use eisenstein ())))
              (#pt-app
                (#pt-use exists (0))
                (#pt-use eisenstein ())
                (#pt-lambda
                  ((candidate-right-coefficient (#pt-use eisenstein ())))
                  (#pt-app
                    (#pt-use eisenstein-bezout-gcd-spec ())
                    first
                    second
                    candidate-gcd
                    candidate-left-coefficient
                    candidate-right-coefficient)))))))
      introduce
      (first
        (#pt-construct
          exists
          (0)
          (
            (#pt-use eisenstein ())
            (#pt-lambda
              ((candidate-left-coefficient (#pt-use eisenstein ())))
              (#pt-app
                (#pt-use exists (0))
                (#pt-use eisenstein ())
                (#pt-lambda
                  ((candidate-right-coefficient (#pt-use eisenstein ())))
                  (#pt-app
                    (#pt-use eisenstein-bezout-gcd-spec ())
                    first
                    second
                    first
                    candidate-left-coefficient
                    candidate-right-coefficient)))))
          introduce
          (
            (#pt-use eisenstein-one ())
            (#pt-construct
              exists
              (0)
              (
                (#pt-use eisenstein ())
                (#pt-lambda
                  ((candidate-right-coefficient (#pt-use eisenstein ())))
                  (#pt-app
                    (#pt-use eisenstein-bezout-gcd-spec ())
                    first
                    second
                    first
                    (#pt-use eisenstein-one ())
                    candidate-right-coefficient)))
              introduce
              (
                (#pt-use eisenstein-zero ())
                (#pt-app
                  (#pt-use conjunction-introduce ())
                  (#pt-app (#pt-use eisenstein-divides ()) first first)
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app (#pt-use eisenstein-divides ()) first second)
                    (#pt-app
                      (#pt-use eisenstein-equal ())
                      first
                      (#pt-app
                        (#pt-use eisenstein-add ())
                        (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) first)
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          (#pt-use eisenstein-zero ())
                          second))))
                  (#pt-app (#pt-use eisenstein-divides-reflexive ()) first)
                  (#pt-app
                    (#pt-use conjunction-introduce ())
                    (#pt-app (#pt-use eisenstein-divides ()) first second)
                    (#pt-app
                      (#pt-use eisenstein-equal ())
                      first
                      (#pt-app
                        (#pt-use eisenstein-add ())
                        (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) first)
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          (#pt-use eisenstein-zero ())
                          second)))
                    (#pt-app
                      (#pt-use eisenstein-divides-congruent-target ())
                      first
                      (#pt-use eisenstein-zero ())
                      second
                      (#pt-app
                        (#pt-use eisenstein-symmetric ())
                        second
                        (#pt-use eisenstein-zero ())
                        second-zero)
                      (#pt-app (#pt-use eisenstein-divides-zero ()) first))
                    (#pt-app
                      (#pt-use eisenstein-symmetric ())
                      (#pt-app
                        (#pt-use eisenstein-add ())
                        (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-one ()) first)
                        (#pt-app
                          (#pt-use eisenstein-multiply ())
                          (#pt-use eisenstein-zero ())
                          second))
                      first
                      (#pt-app
                        (#pt-use eisenstein-transitive ())
                        (#pt-app
                          (#pt-use eisenstein-add ())
                          (#pt-app
                            (#pt-use eisenstein-multiply ())
                            (#pt-use eisenstein-one ())
                            first)
                          (#pt-app
                            (#pt-use eisenstein-multiply ())
                            (#pt-use eisenstein-zero ())
                            second))
                        (#pt-app (#pt-use eisenstein-add ()) first (#pt-use eisenstein-zero ()))
                        first
                        (#pt-app
                          (#pt-use eisenstein-add-congruent ())
                          (#pt-app
                            (#pt-use eisenstein-multiply ())
                            (#pt-use eisenstein-one ())
                            first)
                          (#pt-app
                            (#pt-use eisenstein-multiply ())
                            (#pt-use eisenstein-zero ())
                            second)
                          first
                          (#pt-use eisenstein-zero ())
                          (#pt-app (#pt-use eisenstein-one-multiply ()) first)
                          (#pt-app
                            (#pt-use eisenstein-transitive ())
                            (#pt-app
                              (#pt-use eisenstein-multiply ())
                              (#pt-use eisenstein-zero ())
                              second)
                            (#pt-app
                              (#pt-use eisenstein-multiply ())
                              second
                              (#pt-use eisenstein-zero ()))
                            (#pt-use eisenstein-zero ())
                            (#pt-app
                              (#pt-use eisenstein-multiply-commutative ())
                              (#pt-use eisenstein-zero ())
                              second)
                            (#pt-app (#pt-use eisenstein-multiply-zero ()) second)))
                        (#pt-app (#pt-use eisenstein-add-zero ()) first)))))))))))))
(#theorem eisenstein-bezout-gcd-common-divisor
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter gcd (#pt-use eisenstein ()))
    (#parameter left-coefficient (#pt-use eisenstein ()))
    (#parameter right-coefficient (#pt-use eisenstein ()))
    (#parameter common-divisor (#pt-use eisenstein ()))
    (#parameter gcd-certificate (#pt-app (#pt-use eisenstein-bezout-gcd-spec ()) first second gcd left-coefficient right-coefficient))
    (#parameter divides-first (#pt-app (#pt-use eisenstein-divides ()) common-divisor first))
    (#parameter divides-second (#pt-app (#pt-use eisenstein-divides ()) common-divisor second)))
  (#statement (#pt-app (#pt-use eisenstein-divides ()) common-divisor gcd))
  (#proof
    (#pt-app
      (#pt-use eisenstein-divides-congruent-target ())
      common-divisor
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first)
        (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient second))
      gcd
      (#pt-app
        (#pt-use eisenstein-symmetric ())
        gcd
        (#pt-app
          (#pt-use eisenstein-add ())
          (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first)
          (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient second))
        (#pt-app
          (#pt-use conjunction-right ())
          (#pt-app (#pt-use eisenstein-divides ()) gcd second)
          (#pt-app
            (#pt-use eisenstein-equal ())
            gcd
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first)
              (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient second)))
          (#pt-app
            (#pt-use conjunction-right ())
            (#pt-app (#pt-use eisenstein-divides ()) gcd first)
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app (#pt-use eisenstein-divides ()) gcd second)
              (#pt-app
                (#pt-use eisenstein-equal ())
                gcd
                (#pt-app
                  (#pt-use eisenstein-add ())
                  (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first)
                  (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient second))))
            gcd-certificate)))
      (#pt-app
        (#pt-use eisenstein-divides-add ())
        common-divisor
        (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first)
        (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient second)
        (#pt-app
          (#pt-use eisenstein-divides-product-right ())
          common-divisor
          left-coefficient
          first
          divides-first)
        (#pt-app
          (#pt-use eisenstein-divides-product-right ())
          common-divisor
          right-coefficient
          second
          divides-second)))))
