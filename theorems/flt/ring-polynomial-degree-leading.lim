; Adapted source: pinned Mathlib Algebra/Polynomial/Degree/Defs.lean
; and Degree/Operations.lean; Affine/Point.lean.
; Generated by scripts/generate-flt-polynomial-degrees.py; checked native terms.
; Leading witnesses imply actual polynomial nonvanishing,
; survive coefficient equivalence and handle constant/successor-degree
; constructor cases without excluding degree-zero constants.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-polynomial-coefficient = ./ring-polynomial-data.lim::ring-polynomial-coefficient)
(#alias
  ring-polynomial-degree-witness
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-degree-witness)
(#alias ring-polynomial-equal = ./ring-polynomial-data.lim::ring-polynomial-equal)
(#alias
  ring-polynomial-support-congruent
  =
  ./ring-polynomial-support-transport.lim::ring-polynomial-support-congruent)
(#alias
  ring-polynomial-support-from
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-support-from)
(#alias ring-transitive = ./commutative-ring-data.lim::ring-transitive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#theorem ring-polynomial-degree-nonzero
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter degree #pt-nat)
    (#parameter degree-certificate (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring polynomial degree)))
  (#statement
    (#pt-pi
      (
        (denied-evidence
          (#pt-app
            (#pt-use ring-polynomial-equal ())
            Carrier
            coefficient-ring
            polynomial
            (#pt-construct finite-list () (Carrier) nil ()))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (zero-polynomial
          (#pt-app
            (#pt-use ring-polynomial-equal ())
            Carrier
            coefficient-ring
            polynomial
            (#pt-construct finite-list () (Carrier) nil ()))))
      (#pt-app (#pt-project conjunction 0 degree-certificate) (#pt-app zero-polynomial degree)))))
(#theorem ring-polynomial-degree-congruent
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter degree #pt-nat)
    (#parameter coefficient-equation (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring polynomial other-polynomial))
    (#parameter degree-certificate (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring polynomial degree)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-degree-witness ())
      Carrier
      coefficient-ring
      other-polynomial
      degree))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-pi
        (
          (denied-evidence
            (#pt-app
              (#pt-use ring-equal ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-coefficient ())
                Carrier
                coefficient-ring
                other-polynomial
                degree)
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
        #pt-false)
      (#pt-app
        (#pt-use ring-polynomial-support-from ())
        Carrier
        coefficient-ring
        other-polynomial
        (#pt-succ degree))
      (#pt-lambda
        (
          (zero-leading
            (#pt-app
              (#pt-use ring-equal ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-coefficient ())
                Carrier
                coefficient-ring
                other-polynomial
                degree)
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
        (#pt-app
          (#pt-project conjunction 0 degree-certificate)
          (#pt-app
            (#pt-use ring-transitive ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-coefficient ())
              Carrier
              coefficient-ring
              polynomial
              degree)
            (#pt-app
              (#pt-use ring-polynomial-coefficient ())
              Carrier
              coefficient-ring
              other-polynomial
              degree)
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
            (#pt-app coefficient-equation degree)
            zero-leading)))
      (#pt-app
        (#pt-use ring-polynomial-support-congruent ())
        Carrier
        coefficient-ring
        polynomial
        other-polynomial
        (#pt-succ degree)
        coefficient-equation
        (#pt-project conjunction 1 degree-certificate)))))
(#theorem ring-polynomial-degree-cons-zero
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter head Carrier)
    (#parameter tail (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter nonzero-head (#pt-pi ((denied-evidence (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring head (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))) #pt-false))
    (#parameter zero-tail (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring tail (#pt-construct finite-list () (Carrier) nil ()))))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-degree-witness ())
      Carrier
      coefficient-ring
      (#pt-construct finite-list () (Carrier) cons (head tail))
      #pt-zero))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-pi
        (
          (denied-evidence
            (#pt-app
              (#pt-use ring-equal ())
              Carrier
              coefficient-ring
              head
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
        #pt-false)
      (#pt-app
        (#pt-use ring-polynomial-support-from ())
        Carrier
        coefficient-ring
        (#pt-construct finite-list () (Carrier) cons (head tail))
        (#pt-succ #pt-zero))
      nonzero-head
      zero-tail)))
(#theorem ring-polynomial-degree-cons-successor
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter head Carrier)
    (#parameter tail (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter degree #pt-nat)
    (#parameter degree-certificate (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring tail degree)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-degree-witness ())
      Carrier
      coefficient-ring
      (#pt-construct finite-list () (Carrier) cons (head tail))
      (#pt-succ degree)))
  (#proof degree-certificate))
(#theorem ring-polynomial-degree-tail-zero
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter head Carrier)
    (#parameter tail (#pt-app (#pt-use finite-list ()) Carrier))
