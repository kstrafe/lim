  (#proof (#pt-project conjunction 1 degree-certificate)))
(#theorem ring-polynomial-degree-tail-successor
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter head Carrier)
    (#parameter tail (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter degree #pt-nat)
    (#parameter degree-certificate (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring (#pt-construct finite-list () (Carrier) cons (head tail)) (#pt-succ degree))))
  (#statement
    (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring tail degree))
