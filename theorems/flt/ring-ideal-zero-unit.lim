; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Construct the actual zero and whole-ring ideals,
; supplying every closure proof. The zero ideal uses coefficient
; equivalence, so noncanonical zero representatives remain members.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias ring-add = ./commutative-ring-data.lim::ring-add)
(#alias ring-add-congruent = ./commutative-ring-data.lim::ring-add-congruent)
(#alias ring-add-zero = ./commutative-ring-data.lim::ring-add-zero)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-ideal = ./ring-ideal-data.lim::ring-ideal)
(#alias ring-ideal-member = ./ring-ideal-data.lim::ring-ideal-member)
(#alias ring-ideal-member-congruent = ./ring-ideal-data.lim::ring-ideal-member-congruent)
(#alias ring-ideal-subset = ./ring-ideal-data.lim::ring-ideal-subset)
(#alias ring-ideal-zero = ./ring-ideal-data.lim::ring-ideal-zero)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-multiply-congruent = ./commutative-ring-data.lim::ring-multiply-congruent)
(#alias ring-multiply-zero = ./commutative-ring-data.lim::ring-multiply-zero)
(#alias ring-negate = ./commutative-ring-data.lim::ring-negate)
(#alias ring-negate-congruent = ./commutative-ring-data.lim::ring-negate-congruent)
(#alias ring-negate-zero = ./commutative-ring-cancellation.lim::ring-negate-zero)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#alias ring-symmetric = ./commutative-ring-data.lim::ring-symmetric)
(#alias ring-transitive = ./commutative-ring-data.lim::ring-transitive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#math-definition ring-ideal-bottom ()
  (#pt-pi
    ((Carrier (#pt-type 0)) (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier)))
    (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
  (#pt-lambda
    ((Carrier (#pt-type 0)) (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier)))
    (#pt-construct
      ring-ideal
      ()
      (Carrier coefficient-ring)
      ideal
      (
        (#pt-lambda
          ((first-element Carrier))
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            first-element
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
        (#pt-lambda
          (
            (first-element Carrier)
            (second-element Carrier)
            (equation
              (#pt-app
                (#pt-use ring-equal ())
                Carrier
                coefficient-ring
                first-element
                second-element))
            (member
              (#pt-app
                (#pt-use ring-equal ())
                Carrier
                coefficient-ring
                first-element
                (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
          (#pt-app
            (#pt-use ring-transitive ())
            Carrier
            coefficient-ring
            second-element
            first-element
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
            (#pt-app
              (#pt-use ring-symmetric ())
              Carrier
              coefficient-ring
              first-element
              second-element
              equation)
            member))
        (#pt-app
          (#pt-use ring-reflexive ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
        (#pt-lambda
          (
            (first-element Carrier)
            (second-element Carrier)
            (first-member
              (#pt-app
                (#pt-use ring-equal ())
                Carrier
                coefficient-ring
                first-element
                (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
            (second-member
              (#pt-app
                (#pt-use ring-equal ())
                Carrier
                coefficient-ring
                second-element
                (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
          (#pt-app
            (#pt-use ring-transitive ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use ring-add ()) Carrier coefficient-ring first-element second-element)
            (#pt-app
              (#pt-use ring-add ())
              Carrier
              coefficient-ring
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
            (#pt-app
              (#pt-use ring-add-congruent ())
              Carrier
              coefficient-ring
              first-element
              second-element
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
              first-member
              second-member)
            (#pt-app
              (#pt-use ring-add-zero ())
              Carrier
              coefficient-ring
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
        (#pt-lambda
          (
            (first-element Carrier)
            (member
              (#pt-app
                (#pt-use ring-equal ())
                Carrier
                coefficient-ring
                first-element
                (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
          (#pt-app
            (#pt-use ring-transitive ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use ring-negate ()) Carrier coefficient-ring first-element)
            (#pt-app
              (#pt-use ring-negate ())
              Carrier
              coefficient-ring
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
            (#pt-app
              (#pt-use ring-negate-congruent ())
              Carrier
              coefficient-ring
              first-element
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
              member)
            (#pt-app (#pt-use ring-negate-zero ()) Carrier coefficient-ring)))
        (#pt-lambda
          (
            (coefficient Carrier)
            (first-element Carrier)
            (member
              (#pt-app
                (#pt-use ring-equal ())
                Carrier
                coefficient-ring
                first-element
                (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
          (#pt-app
            (#pt-use ring-transitive ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring coefficient first-element)
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              coefficient
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
            (#pt-app
              (#pt-use ring-multiply-congruent ())
              Carrier
              coefficient-ring
              coefficient
              first-element
              coefficient
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
              (#pt-app (#pt-use ring-reflexive ()) Carrier coefficient-ring coefficient)
              member)
            (#pt-app (#pt-use ring-multiply-zero ()) Carrier coefficient-ring coefficient)))))))
(#math-definition ring-ideal-top ()
  (#pt-pi
    ((Carrier (#pt-type 0)) (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier)))
    (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
  (#pt-lambda
    ((Carrier (#pt-type 0)) (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier)))
    (#pt-construct
      ring-ideal
      ()
      (Carrier coefficient-ring)
      ideal
      (
        (#pt-lambda ((first-element Carrier)) (#pt-eq #pt-nat #pt-zero #pt-zero))
        (#pt-lambda
          (
            (first-element Carrier)
            (second-element Carrier)
            (equation
              (#pt-app
                (#pt-use ring-equal ())
                Carrier
                coefficient-ring
                first-element
                second-element))
            (member (#pt-eq #pt-nat #pt-zero #pt-zero)))
          member)
        (#pt-refl #pt-nat #pt-zero)
        (#pt-lambda
          (
            (first-element Carrier)
            (second-element Carrier)
            (first-member (#pt-eq #pt-nat #pt-zero #pt-zero))
            (second-member (#pt-eq #pt-nat #pt-zero #pt-zero)))
          first-member)
        (#pt-lambda ((first-element Carrier) (member (#pt-eq #pt-nat #pt-zero #pt-zero))) member)
        (#pt-lambda
          (
            (coefficient Carrier)
            (first-element Carrier)
            (member (#pt-eq #pt-nat #pt-zero #pt-zero)))
          member)))))
(#theorem ring-ideal-bottom-least
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-bottom ()) Carrier coefficient-ring)
      first-ideal))
  (#proof
    (#pt-lambda
      (
        (first-element Carrier)
        (zero-equation
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            first-element
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
      (#pt-app
        (#pt-use ring-ideal-member-congruent ())
        Carrier
        coefficient-ring
        first-ideal
        (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
        first-element
        (#pt-app
          (#pt-use ring-symmetric ())
          Carrier
          coefficient-ring
          first-element
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
          zero-equation)
        (#pt-app (#pt-use ring-ideal-zero ()) Carrier coefficient-ring first-ideal)))))
(#theorem ring-ideal-top-greatest
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      first-ideal
      (#pt-app (#pt-use ring-ideal-top ()) Carrier coefficient-ring)))
  (#proof
    (#pt-lambda
      (
        (first-element Carrier)
        (member
          (#pt-app
            (#pt-use ring-ideal-member ())
            Carrier
            coefficient-ring
            first-ideal
            first-element)))
      (#pt-refl #pt-nat #pt-zero))))
(#theorem ring-ideal-top-member
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-element Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-member ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-top ()) Carrier coefficient-ring)
      first-element))
  (#proof (#pt-refl #pt-nat #pt-zero)))
