; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean.
; Generated by scripts/generate-flt-point-ideal-basis.py; checked native terms.
; Two actual column representations
; prove an actual matrix product factorization. Every entry
; is checked from the supplied coordinate equations.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias point-ideal-matrix-action = ./point-ideal-matrix-columns.lim::point-ideal-matrix-action)
(#alias point-ideal-matrix-columns = ./point-ideal-matrix-columns.lim::point-ideal-matrix-columns)
(#alias quadratic-element = ./quadratic-algebra-data.lim::quadratic-element)
(#alias quadratic-equal = ./quadratic-algebra-data.lim::quadratic-equal)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-matrix2 = ./ring-matrix2-data.lim::ring-matrix2)
(#alias ring-matrix2-equal = ./ring-matrix2-data.lim::ring-matrix2-equal)
(#alias ring-matrix2-multiply = ./ring-matrix2-data.lim::ring-matrix2-multiply)
(#theorem point-ideal-matrix-column-factorization
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-matrix (#pt-app (#pt-use ring-matrix2 ()) Carrier))
    (#parameter first-vector (#pt-app (#pt-use quadratic-element ()) Carrier))
    (#parameter second-vector (#pt-app (#pt-use quadratic-element ()) Carrier))
    (#parameter first-coordinates (#pt-app (#pt-use quadratic-element ()) Carrier))
    (#parameter second-coordinates (#pt-app (#pt-use quadratic-element ()) Carrier))
    (#parameter first-column-equation (#pt-app (#pt-use quadratic-equal ()) Carrier coefficient-ring first-vector (#pt-app (#pt-use point-ideal-matrix-action ()) Carrier coefficient-ring first-matrix first-coordinates)))
    (#parameter second-column-equation (#pt-app (#pt-use quadratic-equal ()) Carrier coefficient-ring second-vector (#pt-app (#pt-use point-ideal-matrix-action ()) Carrier coefficient-ring first-matrix second-coordinates))))
  (#statement
    (#pt-app
      (#pt-use ring-matrix2-equal ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use point-ideal-matrix-columns ()) Carrier first-vector second-vector)
      (#pt-app
        (#pt-use ring-matrix2-multiply ())
        Carrier
        coefficient-ring
        first-matrix
        (#pt-app
          (#pt-use point-ideal-matrix-columns ())
          Carrier
          first-coordinates
          second-coordinates))))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-equal ())
        Carrier
        coefficient-ring
        (#pt-project
          ring-matrix2
          0
          (#pt-app (#pt-use point-ideal-matrix-columns ()) Carrier first-vector second-vector))
        (#pt-project
          ring-matrix2
          0
          (#pt-app
            (#pt-use ring-matrix2-multiply ())
            Carrier
            coefficient-ring
            first-matrix
            (#pt-app
              (#pt-use point-ideal-matrix-columns ())
              Carrier
              first-coordinates
              second-coordinates))))
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app
          (#pt-use ring-equal ())
          Carrier
          coefficient-ring
          (#pt-project
            ring-matrix2
            1
            (#pt-app (#pt-use point-ideal-matrix-columns ()) Carrier first-vector second-vector))
          (#pt-project
            ring-matrix2
            1
            (#pt-app
              (#pt-use ring-matrix2-multiply ())
              Carrier
              coefficient-ring
              first-matrix
              (#pt-app
                (#pt-use point-ideal-matrix-columns ())
                Carrier
                first-coordinates
                second-coordinates))))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-project
              ring-matrix2
              2
              (#pt-app (#pt-use point-ideal-matrix-columns ()) Carrier first-vector second-vector))
            (#pt-project
              ring-matrix2
              2
              (#pt-app
                (#pt-use ring-matrix2-multiply ())
                Carrier
                coefficient-ring
                first-matrix
                (#pt-app
                  (#pt-use point-ideal-matrix-columns ())
                  Carrier
                  first-coordinates
                  second-coordinates))))
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-project
              ring-matrix2
              3
              (#pt-app (#pt-use point-ideal-matrix-columns ()) Carrier first-vector second-vector))
            (#pt-project
              ring-matrix2
              3
              (#pt-app
                (#pt-use ring-matrix2-multiply ())
                Carrier
                coefficient-ring
                first-matrix
                (#pt-app
                  (#pt-use point-ideal-matrix-columns ())
                  Carrier
                  first-coordinates
                  second-coordinates))))))
      (#pt-project conjunction 0 first-column-equation)
      (#pt-app
        (#pt-use conjunction-introduce ())
        (#pt-app
          (#pt-use ring-equal ())
          Carrier
          coefficient-ring
          (#pt-project
            ring-matrix2
            1
            (#pt-app (#pt-use point-ideal-matrix-columns ()) Carrier first-vector second-vector))
          (#pt-project
            ring-matrix2
            1
            (#pt-app
              (#pt-use ring-matrix2-multiply ())
              Carrier
              coefficient-ring
              first-matrix
              (#pt-app
                (#pt-use point-ideal-matrix-columns ())
                Carrier
                first-coordinates
                second-coordinates))))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-project
              ring-matrix2
              2
              (#pt-app (#pt-use point-ideal-matrix-columns ()) Carrier first-vector second-vector))
            (#pt-project
              ring-matrix2
              2
              (#pt-app
                (#pt-use ring-matrix2-multiply ())
                Carrier
                coefficient-ring
                first-matrix
                (#pt-app
                  (#pt-use point-ideal-matrix-columns ())
                  Carrier
                  first-coordinates
                  second-coordinates))))
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-project
              ring-matrix2
              3
              (#pt-app (#pt-use point-ideal-matrix-columns ()) Carrier first-vector second-vector))
            (#pt-project
              ring-matrix2
              3
              (#pt-app
                (#pt-use ring-matrix2-multiply ())
                Carrier
                coefficient-ring
                first-matrix
                (#pt-app
                  (#pt-use point-ideal-matrix-columns ())
                  Carrier
                  first-coordinates
                  second-coordinates)))))
        (#pt-project conjunction 0 second-column-equation)
        (#pt-app
          (#pt-use conjunction-introduce ())
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-project
              ring-matrix2
              2
              (#pt-app (#pt-use point-ideal-matrix-columns ()) Carrier first-vector second-vector))
            (#pt-project
              ring-matrix2
              2
              (#pt-app
                (#pt-use ring-matrix2-multiply ())
                Carrier
                coefficient-ring
                first-matrix
                (#pt-app
                  (#pt-use point-ideal-matrix-columns ())
                  Carrier
                  first-coordinates
                  second-coordinates))))
          (#pt-app
            (#pt-use ring-equal ())
            Carrier
            coefficient-ring
            (#pt-project
              ring-matrix2
              3
              (#pt-app (#pt-use point-ideal-matrix-columns ()) Carrier first-vector second-vector))
            (#pt-project
              ring-matrix2
              3
              (#pt-app
                (#pt-use ring-matrix2-multiply ())
                Carrier
                coefficient-ring
                first-matrix
                (#pt-app
                  (#pt-use point-ideal-matrix-columns ())
                  Carrier
                  first-coordinates
                  second-coordinates))))
          (#pt-project conjunction 1 first-column-equation)
          (#pt-project conjunction 1 second-column-equation))))))
