; Transport cube equations between equivalent signed representations.
; Separate these short composition lemmas from the sign case analysis.
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-negative-natural = ./integer-defs.lim::integer-negative-natural)
(#alias integer-one = ./integer-defs.lim::integer-one)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-cube = ./integer-defs.lim::integer-cube)
(#alias integer-power = ./integer-defs.lim::integer-power)
(#alias cube = ./natural-ninth-residues.lim::cube)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias integer-add-congruent = ./integer-equality.lim::integer-add-congruent)
(#alias integer-cube-congruent = ./integer-multiplication.lim::integer-cube-congruent)
(#alias integer-cube-positive = ./integer-multiplication.lim::integer-cube-positive)
(#alias integer-cube-negative = ./integer-multiplication.lim::integer-cube-negative)
(#alias
  integer-multiply-congruent-second
  =
  ./integer-multiplication.lim::integer-multiply-congruent-second)
(#alias integer-multiply-one = ./integer-multiplication.lim::integer-multiply-one)
(#theorem integer-cube-normal-positive
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter magnitude #pt-nat)
    (#parameter normal-equivalence (#pt-app (#pt-use integer-equal ()) number (#pt-app (#pt-use integer-of-natural ()) magnitude))))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-cube ()) number)
      (#pt-app (#pt-use integer-of-natural ()) (#pt-app (#pt-use cube ()) magnitude))))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app (#pt-use integer-cube ()) number)
      (#pt-app (#pt-use integer-cube ()) (#pt-app (#pt-use integer-of-natural ()) magnitude))
      (#pt-app (#pt-use integer-of-natural ()) (#pt-app (#pt-use cube ()) magnitude))
      (#pt-app
        (#pt-use integer-cube-congruent ())
        number
        (#pt-app (#pt-use integer-of-natural ()) magnitude)
        normal-equivalence)
      (#pt-app (#pt-use integer-cube-positive ()) magnitude))))
(#theorem integer-cube-normal-negative
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter magnitude #pt-nat)
    (#parameter normal-equivalence (#pt-app (#pt-use integer-equal ()) number (#pt-app (#pt-use integer-negative-natural ()) magnitude))))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-cube ()) number)
      (#pt-app (#pt-use integer-negative-natural ()) (#pt-app (#pt-use cube ()) magnitude))))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app (#pt-use integer-cube ()) number)
      (#pt-app (#pt-use integer-cube ()) (#pt-app (#pt-use integer-negative-natural ()) magnitude))
      (#pt-app (#pt-use integer-negative-natural ()) (#pt-app (#pt-use cube ()) magnitude))
      (#pt-app
        (#pt-use integer-cube-congruent ())
        number
        (#pt-app (#pt-use integer-negative-natural ()) magnitude)
        normal-equivalence)
      (#pt-app (#pt-use integer-cube-negative ()) magnitude))))
(#theorem integer-cube-equation-transport
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter first-normal-cube (#pt-use integer ()))
    (#parameter second-normal-cube (#pt-use integer ()))
    (#parameter third-normal-cube (#pt-use integer ()))
    (#parameter first-normalization (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-cube ()) first) first-normal-cube))
    (#parameter second-normalization (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-cube ()) second) second-normal-cube))
    (#parameter third-normalization (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-cube ()) third) third-normal-cube))
    (#parameter cube-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-cube ()) first) (#pt-app (#pt-use integer-cube ()) second)) (#pt-app (#pt-use integer-cube ()) third))))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-add ()) first-normal-cube second-normal-cube)
      third-normal-cube))
  (#proof
    (#pt-app
      (#pt-use integer-transitive ())
      (#pt-app (#pt-use integer-add ()) first-normal-cube second-normal-cube)
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use integer-cube ()) first)
        (#pt-app (#pt-use integer-cube ()) second))
      third-normal-cube
      (#pt-app
        (#pt-use integer-symmetric ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app (#pt-use integer-cube ()) first)
          (#pt-app (#pt-use integer-cube ()) second))
        (#pt-app (#pt-use integer-add ()) first-normal-cube second-normal-cube)
        (#pt-app
          (#pt-use integer-add-congruent ())
          (#pt-app (#pt-use integer-cube ()) first)
          (#pt-app (#pt-use integer-cube ()) second)
          first-normal-cube
          second-normal-cube
          first-normalization
          second-normalization))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app (#pt-use integer-cube ()) first)
          (#pt-app (#pt-use integer-cube ()) second))
        (#pt-app (#pt-use integer-cube ()) third)
        third-normal-cube
        cube-equation
        third-normalization))))
(#theorem integer-power-three-as-cube
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app (#pt-use integer-power ()) number (#pt-numeral 3))
      (#pt-app (#pt-use integer-cube ()) number)))
  (#proof
    (#pt-app
      (#pt-use integer-multiply-congruent-second ())
      number
      (#pt-app
        (#pt-use integer-multiply ())
        number
        (#pt-app (#pt-use integer-multiply ()) number (#pt-use integer-one ())))
      (#pt-app (#pt-use integer-multiply ()) number number)
      (#pt-app
        (#pt-use integer-multiply-congruent-second ())
        number
        (#pt-app (#pt-use integer-multiply ()) number (#pt-use integer-one ()))
        number
        (#pt-app (#pt-use integer-multiply-one ()) number)))))
