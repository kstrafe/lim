; Pairwise coprimality and parity from actual arbitrary-power equations.
; Coprime powers and witnessed positive-power divisors transmit the
; original coprimality to either pair with the third coordinate.
; Two odd bases have odd powers and an even sum; actual prime-two
; divisibility then makes the third coordinate even. These are the
; concrete prerequisites of S_FreyPackage_of_counterexample:31-43.
(#alias add = ./../fermat_statement.lim::add)
(#alias power = ./../fermat_statement.lim::power)
(#alias less-than = ./natural-order.lim::less-than)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#alias transitivity = ./equality.lim::transitivity)
(#alias substitution = ./equality.lim::substitution)
(#alias coprime = ./natural-coprime.lim::coprime)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias coprime-power-left = ./natural-euclid.lim::coprime-power-left)
(#alias coprime-power-right = ./natural-euclid.lim::coprime-power-right)
(#alias coprime-divisor-right = ./natural-euclid.lim::coprime-divisor-right)
(#alias coprime-symmetric = ./natural-coprime.lim::coprime-symmetric)
(#alias coprime-add-left = ./natural-coprime.lim::coprime-add-left)
(#alias divides-positive-power = ./natural-power-products.lim::divides-positive-power)
(#alias divides-reflexive = ./natural-divisibility.lim::divides-reflexive)
(#alias prime-divides-power = ./natural-prime-divisibility.lim::prime-divides-power)
(#alias prime-two = ./natural-prime-two.lim::prime-two)
(#alias even-or-odd = ./natural-parity.lim::even-or-odd)
(#alias odd = ./natural-parity.lim::odd)
(#alias odd-even-exclusion = ./natural-parity-arithmetic.lim::odd-even-exclusion)
(#alias odd-plus-odd-is-even = ./natural-parity-arithmetic.lim::odd-plus-odd-is-even)
(#alias add-commutative = ./natural-addition.lim::add-commutative)
(#theorem power-solution-first-third-coprime
  (#universes)
  (#parameters
    (#parameter exponent #pt-nat)
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter third #pt-nat)
    (#parameter positive-exponent (#pt-app (#pt-use less-than ()) #pt-zero exponent))
    (#parameter coprime-certificate (#pt-app (#pt-use coprime ()) first second))
    (#parameter power-equation (#pt-eq #pt-nat (#pt-app (#pt-use add ()) (#pt-app (#pt-use power ()) first exponent) (#pt-app (#pt-use power ()) second exponent)) (#pt-app (#pt-use power ()) third exponent))))
  (#statement (#pt-app (#pt-use coprime ()) first third))
  (#proof
    (#pt-app
      (#pt-use coprime-symmetric ())
      third
      first
      (#pt-app
        (#pt-use coprime-divisor-right ())
        third
        (#pt-app (#pt-use power ()) first exponent)
        first
        (#pt-app
          (#pt-use coprime-symmetric ())
          (#pt-app (#pt-use power ()) first exponent)
          third
          (#pt-app
            (#pt-use coprime-divisor-right ())
            (#pt-app (#pt-use power ()) first exponent)
            (#pt-app (#pt-use power ()) third exponent)
            third
            (#pt-app
              (#pt-use substitution (0))
              #pt-nat
              (#pt-lambda
                ((endpoint #pt-nat))
                (#pt-app (#pt-use coprime ()) (#pt-app (#pt-use power ()) first exponent) endpoint))
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use power ()) first exponent)
                (#pt-app (#pt-use power ()) second exponent))
              (#pt-app (#pt-use power ()) third exponent)
              power-equation
              (#pt-app
                (#pt-use coprime-add-left ())
                (#pt-app (#pt-use power ()) first exponent)
                (#pt-app (#pt-use power ()) second exponent)
                (#pt-app
                  (#pt-use coprime-power-right ())
                  (#pt-app (#pt-use power ()) first exponent)
                  second
                  exponent
                  (#pt-app
                    (#pt-use coprime-power-left ())
                    first
                    second
                    exponent
                    coprime-certificate))))
            (#pt-app
              (#pt-use divides-positive-power ())
              third
              third
              exponent
              positive-exponent
              (#pt-app (#pt-use divides-reflexive ()) third))))
        (#pt-app
          (#pt-use divides-positive-power ())
          first
          first
          exponent
          positive-exponent
          (#pt-app (#pt-use divides-reflexive ()) first))))))
(#theorem power-solution-second-third-coprime
  (#universes)
  (#parameters
    (#parameter exponent #pt-nat)
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter third #pt-nat)
    (#parameter positive-exponent (#pt-app (#pt-use less-than ()) #pt-zero exponent))
    (#parameter coprime-certificate (#pt-app (#pt-use coprime ()) first second))
    (#parameter power-equation (#pt-eq #pt-nat (#pt-app (#pt-use add ()) (#pt-app (#pt-use power ()) first exponent) (#pt-app (#pt-use power ()) second exponent)) (#pt-app (#pt-use power ()) third exponent))))
  (#statement (#pt-app (#pt-use coprime ()) second third))
  (#proof
    (#pt-app
      (#pt-use power-solution-first-third-coprime ())
      exponent
      second
      first
      third
      positive-exponent
      (#pt-app (#pt-use coprime-symmetric ()) first second coprime-certificate)
      (#pt-app
        (#pt-use transitivity (0))
        #pt-nat
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use power ()) second exponent)
          (#pt-app (#pt-use power ()) first exponent))
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use power ()) first exponent)
          (#pt-app (#pt-use power ()) second exponent))
        (#pt-app (#pt-use power ()) third exponent)
        (#pt-app
          (#pt-use add-commutative ())
          (#pt-app (#pt-use power ()) second exponent)
          (#pt-app (#pt-use power ()) first exponent))
        power-equation))))
(#theorem odd-positive-base-power
  (#universes)
  (#parameters
    (#parameter number #pt-nat)
    (#parameter exponent #pt-nat)
    (#parameter number-odd (#pt-app (#pt-use odd ()) number)))
  (#statement (#pt-app (#pt-use odd ()) (#pt-app (#pt-use power ()) number exponent)))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app
        (#pt-use divides ())
        (#pt-succ (#pt-succ #pt-zero))
        (#pt-app (#pt-use power ()) number exponent))
      (#pt-app (#pt-use odd ()) (#pt-app (#pt-use power ()) number exponent))
      (#pt-app (#pt-use odd ()) (#pt-app (#pt-use power ()) number exponent))
      (#pt-lambda
        (
          (power-even
            (#pt-app
              (#pt-use divides ())
              (#pt-succ (#pt-succ #pt-zero))
              (#pt-app (#pt-use power ()) number exponent))))
        (#pt-app
          (#pt-use false-elimination ())
          (#pt-app (#pt-use odd ()) (#pt-app (#pt-use power ()) number exponent))
          (#pt-app
            (#pt-use odd-even-exclusion ())
            number
            number-odd
            (#pt-app
              (#pt-use prime-divides-power ())
              (#pt-succ (#pt-succ #pt-zero))
              number
              exponent
              (#pt-use prime-two ())
              power-even))))
      (#pt-lambda
        ((power-odd (#pt-app (#pt-use odd ()) (#pt-app (#pt-use power ()) number exponent))))
        power-odd)
      (#pt-app (#pt-use even-or-odd ()) (#pt-app (#pt-use power ()) number exponent)))))
(#theorem power-solution-odd-first-second-third-even
  (#universes)
  (#parameters
    (#parameter exponent #pt-nat)
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter third #pt-nat)
    (#parameter first-odd (#pt-app (#pt-use odd ()) first))
    (#parameter second-odd (#pt-app (#pt-use odd ()) second))
    (#parameter power-equation (#pt-eq #pt-nat (#pt-app (#pt-use add ()) (#pt-app (#pt-use power ()) first exponent) (#pt-app (#pt-use power ()) second exponent)) (#pt-app (#pt-use power ()) third exponent))))
  (#statement (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) third))
  (#proof
    (#pt-app
      (#pt-use prime-divides-power ())
      (#pt-succ (#pt-succ #pt-zero))
      third
      exponent
      (#pt-use prime-two ())
      (#pt-app
        (#pt-use substitution (0))
        #pt-nat
        (#pt-lambda
          ((endpoint #pt-nat))
          (#pt-app (#pt-use divides ()) (#pt-succ (#pt-succ #pt-zero)) endpoint))
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use power ()) first exponent)
          (#pt-app (#pt-use power ()) second exponent))
        (#pt-app (#pt-use power ()) third exponent)
        power-equation
        (#pt-app
          (#pt-use odd-plus-odd-is-even ())
          (#pt-app (#pt-use power ()) first exponent)
          (#pt-app (#pt-use power ()) second exponent)
          (#pt-app (#pt-use odd-positive-base-power ()) first exponent first-odd)
          (#pt-app (#pt-use odd-positive-base-power ()) second exponent second-odd))))))
