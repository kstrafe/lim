; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean.
; Generated by scripts/generate-flt-point-evaluation.py; checked native terms.
; The actual identity function carries
; checked congruence and zero/one/add/multiply fields, so the
; existing generic evaluation laws can be instantiated faithfully.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias ring-add = ./commutative-ring-data.lim::ring-add)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-evaluation-map = ./ring-evaluation-morphism.lim::ring-evaluation-map)
(#alias ring-evaluation-morphism = ./ring-evaluation-morphism.lim::ring-evaluation-morphism)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-one = ./commutative-ring-data.lim::ring-one)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#math-definition polynomial-root-identity-morphism ()
  (#pt-pi
    ((Carrier (#pt-type 0)) (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier)))
    (#pt-app
      (#pt-use ring-evaluation-morphism ())
      Carrier
      coefficient-ring
      Carrier
      coefficient-ring))
  (#pt-lambda
    ((Carrier (#pt-type 0)) (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier)))
    (#pt-construct
      ring-evaluation-morphism
      ()
      (Carrier coefficient-ring Carrier coefficient-ring)
      morphism
      (
        (#pt-lambda ((first-value Carrier)) first-value)
        (#pt-lambda
          (
            (first-value Carrier)
            (second-value Carrier)
            (equation
              (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring first-value second-value)))
          equation)
        (#pt-app
          (#pt-use ring-reflexive ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
        (#pt-app
          (#pt-use ring-reflexive ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring))
        (#pt-lambda
          ((first-value Carrier) (second-value Carrier))
          (#pt-app
            (#pt-use ring-reflexive ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use ring-add ()) Carrier coefficient-ring first-value second-value)))
        (#pt-lambda
          ((first-value Carrier) (second-value Carrier))
          (#pt-app
            (#pt-use ring-reflexive ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-value second-value)))))))
(#theorem polynomial-root-identity-mapping
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-value Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-evaluation-map ())
        Carrier
        coefficient-ring
        Carrier
        coefficient-ring
        (#pt-app (#pt-use polynomial-root-identity-morphism ()) Carrier coefficient-ring)
        first-value)
      first-value))
  (#proof (#pt-app (#pt-use ring-reflexive ()) Carrier coefficient-ring first-value)))
