(#theorem point-evaluation-coordinate-constant-contained
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter quadratic-linear (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter quadratic-constant (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter root Carrier)
    (#parameter Y-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter curve-equation (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring (#pt-app (#pt-use ring-evaluation ()) (#pt-app (#pt-use finite-list ()) Carrier) (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring) Carrier coefficient-ring (#pt-app (#pt-use polynomial-root-evaluation-morphism ()) Carrier coefficient-ring root) (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring Y-polynomial root) (#pt-app (#pt-use quadratic-division-divisor ()) (#pt-app (#pt-use finite-list ()) Carrier) (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring) quadratic-linear quadratic-constant)) (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
    (#parameter coordinate-element (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier)))
    (#parameter vanishes (#pt-app (#pt-use ring-equal ()) Carrier coefficient-ring (#pt-app (#pt-use ring-evaluation-map ()) (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier)) (#pt-app (#pt-use quadratic-ring-structure ()) (#pt-app (#pt-use finite-list ()) Carrier) (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring) quadratic-linear quadratic-constant) Carrier coefficient-ring (#pt-app (#pt-use point-evaluation-coordinate-morphism ()) Carrier coefficient-ring quadratic-linear quadratic-constant root Y-polynomial curve-equation) coordinate-element) (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-member ())
      (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
      (#pt-app
