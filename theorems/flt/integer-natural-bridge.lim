; Faithful natural embedding and divisibility reflection for formal integers.
; In particular, allowing a signed factor does not create false Nat divisibility.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias exists = ./logic-exists.lim::exists)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias divides-zero = ./natural-divisibility.lim::divides-zero)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-negative-natural = ./integer-defs.lim::integer-negative-natural)
(#alias integer-zero = ./integer-defs.lim::integer-zero)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-divides = ./integer-defs.lim::integer-divides)
(#alias integer-of-natural-injective = ./integer-equality.lim::integer-of-natural-injective)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias integer-negate-congruent = ./integer-equality.lim::integer-negate-congruent)
(#alias
  integer-multiply-congruent-second
  =
  ./integer-multiplication.lim::integer-multiply-congruent-second)
(#alias integer-multiply-of-natural = ./integer-multiplication.lim::integer-multiply-of-natural)
(#alias
  integer-multiply-negative-second
  =
  ./integer-divisibility.lim::integer-multiply-negative-second)
(#alias integer-normal-form = ./integer-normal-form.lim::integer-normal-form)
(#alias successor-not-zero = ./natural-nonzero.lim::successor-not-zero)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias symmetry = ./equality.lim::symmetry)
(#alias substitution = ./equality.lim::substitution)
(#theorem natural-zero-sum-first
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter sum-zero (#pt-eq #pt-nat (#pt-app (#pt-use add ()) first second) #pt-zero)))
  (#statement (#pt-eq #pt-nat first #pt-zero))
  (#proof
    (#pt-app
      (#pt-nat-induct
        (#pt-lambda
          ((index #pt-nat))
          (#pt-pi
            ((index-zero (#pt-eq #pt-nat (#pt-app (#pt-use add ()) index second) #pt-zero)))
            (#pt-eq #pt-nat index #pt-zero)))
        (#pt-lambda
          ((zero-sum (#pt-eq #pt-nat (#pt-app (#pt-use add ()) #pt-zero second) #pt-zero)))
          (#pt-refl #pt-nat #pt-zero))
        (#pt-lambda
          (
            (previous #pt-nat)
            (unused-previous
              (#pt-pi
                (
                  (earlier-zero
                    (#pt-eq #pt-nat (#pt-app (#pt-use add ()) previous second) #pt-zero)))
                (#pt-eq #pt-nat previous #pt-zero)))
            (successor-zero
              (#pt-eq #pt-nat (#pt-app (#pt-use add ()) (#pt-succ previous) second) #pt-zero)))
          (#pt-app
            (#pt-use false-elimination ())
            (#pt-eq #pt-nat (#pt-succ previous) #pt-zero)
            (#pt-app
              (#pt-app (#pt-use successor-not-zero ()) (#pt-app (#pt-use add ()) previous second))
              successor-zero)))
        first)
      sum-zero)))
(#theorem integer-positive-negative-zero
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter signed-equivalence (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-of-natural ()) first) (#pt-app (#pt-use integer-negative-natural ()) second))))
  (#statement (#pt-eq #pt-nat first #pt-zero))
  (#proof (#pt-app (#pt-use natural-zero-sum-first ()) first second signed-equivalence)))
(#theorem integer-natural-divisibility-reflects
  (#universes)
  (#parameters
    (#parameter divisor-natural #pt-nat)
    (#parameter number-natural #pt-nat)
    (#parameter integer-divides-proof (#pt-app (#pt-use integer-divides ()) (#pt-app (#pt-use integer-of-natural ()) divisor-natural) (#pt-app (#pt-use integer-of-natural ()) number-natural))))
  (#statement (#pt-app (#pt-use divides ()) divisor-natural number-natural))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use integer ())
        (#pt-lambda
          ((candidate-factor (#pt-use integer ())))
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-app (#pt-use integer-of-natural ()) number-natural)
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-of-natural ()) divisor-natural)
              candidate-factor))))
      (#pt-lambda
        (
          (integer-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use integer ())
              (#pt-lambda
                ((candidate-factor (#pt-use integer ())))
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-app (#pt-use integer-of-natural ()) number-natural)
                  (#pt-app
                    (#pt-use integer-multiply ())
                    (#pt-app (#pt-use integer-of-natural ()) divisor-natural)
                    candidate-factor))))))
        (#pt-app (#pt-use divides ()) divisor-natural number-natural))
      (
        (#pt-lambda
          (
            (integer-factor (#pt-use integer ()))
            (factor-equivalence
              (#pt-app
                (#pt-use integer-equal ())
                (#pt-app (#pt-use integer-of-natural ()) number-natural)
                (#pt-app
                  (#pt-use integer-multiply ())
                  (#pt-app (#pt-use integer-of-natural ()) divisor-natural)
                  integer-factor))))
          (#pt-app
            (#pt-use disjunction-eliminate ())
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-magnitude #pt-nat))
                (#pt-app
                  (#pt-use integer-equal ())
                  integer-factor
                  (#pt-app (#pt-use integer-of-natural ()) candidate-magnitude))))
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-magnitude #pt-nat))
                (#pt-app
                  (#pt-use integer-equal ())
                  integer-factor
                  (#pt-app (#pt-use integer-negative-natural ()) candidate-magnitude))))
            (#pt-app (#pt-use divides ()) divisor-natural number-natural)
            (#pt-lambda
              (
                (positive-normal-form
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((candidate-magnitude #pt-nat))
                      (#pt-app
                        (#pt-use integer-equal ())
                        integer-factor
                        (#pt-app (#pt-use integer-of-natural ()) candidate-magnitude))))))
              (#pt-induct
                exists
                (0)
                (#pt-nat
                  (#pt-lambda
                    ((candidate-magnitude #pt-nat))
                    (#pt-app
                      (#pt-use integer-equal ())
                      integer-factor
                      (#pt-app (#pt-use integer-of-natural ()) candidate-magnitude))))
                (#pt-lambda
                  (
                    (certificate
                      (#pt-app
                        (#pt-use exists (0))
                        #pt-nat
                        (#pt-lambda
                          ((candidate-magnitude #pt-nat))
                          (#pt-app
                            (#pt-use integer-equal ())
                            integer-factor
                            (#pt-app (#pt-use integer-of-natural ()) candidate-magnitude))))))
                  (#pt-app (#pt-use divides ()) divisor-natural number-natural))
                (
                  (#pt-lambda
                    (
                      (magnitude #pt-nat)
                      (normal-equivalence
                        (#pt-app
                          (#pt-use integer-equal ())
                          integer-factor
                          (#pt-app (#pt-use integer-of-natural ()) magnitude))))
                    (#pt-construct
                      exists
                      (0)
                      (#pt-nat
                        (#pt-lambda
                          ((candidate-factor #pt-nat))
                          (#pt-eq
                            #pt-nat
                            number-natural
                            (#pt-app (#pt-use multiply ()) divisor-natural candidate-factor))))
                      introduce
                      (magnitude
                        (#pt-app
                          (#pt-use integer-of-natural-injective ())
                          number-natural
                          (#pt-app (#pt-use multiply ()) divisor-natural magnitude)
                          (#pt-app
                            (#pt-use integer-transitive ())
                            (#pt-app (#pt-use integer-of-natural ()) number-natural)
                            (#pt-app
                              (#pt-use integer-multiply ())
                              (#pt-app (#pt-use integer-of-natural ()) divisor-natural)
                              integer-factor)
                            (#pt-app
                              (#pt-use integer-of-natural ())
                              (#pt-app (#pt-use multiply ()) divisor-natural magnitude))
                            factor-equivalence
                            (#pt-app
                              (#pt-use integer-transitive ())
                              (#pt-app
                                (#pt-use integer-multiply ())
                                (#pt-app (#pt-use integer-of-natural ()) divisor-natural)
                                integer-factor)
                              (#pt-app
                                (#pt-use integer-multiply ())
                                (#pt-app (#pt-use integer-of-natural ()) divisor-natural)
                                (#pt-app (#pt-use integer-of-natural ()) magnitude))
                              (#pt-app
                                (#pt-use integer-of-natural ())
                                (#pt-app (#pt-use multiply ()) divisor-natural magnitude))
                              (#pt-app
                                (#pt-use integer-multiply-congruent-second ())
                                (#pt-app (#pt-use integer-of-natural ()) divisor-natural)
                                integer-factor
                                (#pt-app (#pt-use integer-of-natural ()) magnitude)
                                normal-equivalence)
                              (#pt-app
                                (#pt-use integer-multiply-of-natural ())
                                divisor-natural
                                magnitude))))))))
                positive-normal-form))
            (#pt-lambda
              (
                (negative-normal-form
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((candidate-magnitude #pt-nat))
                      (#pt-app
                        (#pt-use integer-equal ())
                        integer-factor
                        (#pt-app (#pt-use integer-negative-natural ()) candidate-magnitude))))))
              (#pt-induct
                exists
                (0)
                (#pt-nat
                  (#pt-lambda
                    ((candidate-magnitude #pt-nat))
                    (#pt-app
                      (#pt-use integer-equal ())
                      integer-factor
                      (#pt-app (#pt-use integer-negative-natural ()) candidate-magnitude))))
                (#pt-lambda
                  (
                    (certificate
                      (#pt-app
                        (#pt-use exists (0))
                        #pt-nat
                        (#pt-lambda
                          ((candidate-magnitude #pt-nat))
                          (#pt-app
                            (#pt-use integer-equal ())
                            integer-factor
                            (#pt-app (#pt-use integer-negative-natural ()) candidate-magnitude))))))
                  (#pt-app (#pt-use divides ()) divisor-natural number-natural))
                (
                  (#pt-lambda
                    (
                      (magnitude #pt-nat)
                      (normal-equivalence
                        (#pt-app
                          (#pt-use integer-equal ())
                          integer-factor
                          (#pt-app (#pt-use integer-negative-natural ()) magnitude))))
                    (#pt-app
                      (#pt-use substitution (0))
                      #pt-nat
                      (#pt-lambda
                        ((endpoint #pt-nat))
                        (#pt-app (#pt-use divides ()) divisor-natural endpoint))
                      #pt-zero
                      number-natural
                      (#pt-app
                        (#pt-use symmetry (0))
                        #pt-nat
                        number-natural
                        #pt-zero
                        (#pt-app
                          (#pt-use integer-positive-negative-zero ())
                          number-natural
                          (#pt-app (#pt-use multiply ()) divisor-natural magnitude)
                          (#pt-app
                            (#pt-use integer-transitive ())
                            (#pt-app (#pt-use integer-of-natural ()) number-natural)
                            (#pt-app
                              (#pt-use integer-multiply ())
                              (#pt-app (#pt-use integer-of-natural ()) divisor-natural)
                              integer-factor)
                            (#pt-app
                              (#pt-use integer-negative-natural ())
                              (#pt-app (#pt-use multiply ()) divisor-natural magnitude))
                            factor-equivalence
                            (#pt-app
                              (#pt-use integer-transitive ())
                              (#pt-app
                                (#pt-use integer-multiply ())
                                (#pt-app (#pt-use integer-of-natural ()) divisor-natural)
                                integer-factor)
                              (#pt-app
                                (#pt-use integer-multiply ())
                                (#pt-app (#pt-use integer-of-natural ()) divisor-natural)
                                (#pt-app (#pt-use integer-negative-natural ()) magnitude))
                              (#pt-app
                                (#pt-use integer-negative-natural ())
                                (#pt-app (#pt-use multiply ()) divisor-natural magnitude))
                              (#pt-app
                                (#pt-use integer-multiply-congruent-second ())
                                (#pt-app (#pt-use integer-of-natural ()) divisor-natural)
                                integer-factor
                                (#pt-app (#pt-use integer-negative-natural ()) magnitude)
                                normal-equivalence)
                              (#pt-app
                                (#pt-use integer-transitive ())
                                (#pt-app
                                  (#pt-use integer-multiply ())
                                  (#pt-app (#pt-use integer-of-natural ()) divisor-natural)
                                  (#pt-app (#pt-use integer-negative-natural ()) magnitude))
                                (#pt-app
                                  (#pt-use integer-negate ())
                                  (#pt-app
                                    (#pt-use integer-multiply ())
                                    (#pt-app (#pt-use integer-of-natural ()) divisor-natural)
                                    (#pt-app (#pt-use integer-of-natural ()) magnitude)))
                                (#pt-app
                                  (#pt-use integer-negative-natural ())
                                  (#pt-app (#pt-use multiply ()) divisor-natural magnitude))
                                (#pt-app
                                  (#pt-use integer-multiply-negative-second ())
                                  (#pt-app (#pt-use integer-of-natural ()) divisor-natural)
                                  (#pt-app (#pt-use integer-of-natural ()) magnitude))
                                (#pt-app
                                  (#pt-use integer-negate-congruent ())
                                  (#pt-app
                                    (#pt-use integer-multiply ())
                                    (#pt-app (#pt-use integer-of-natural ()) divisor-natural)
                                    (#pt-app (#pt-use integer-of-natural ()) magnitude))
                                  (#pt-app
                                    (#pt-use integer-of-natural ())
                                    (#pt-app (#pt-use multiply ()) divisor-natural magnitude))
                                  (#pt-app
                                    (#pt-use integer-multiply-of-natural ())
                                    divisor-natural
                                    magnitude)))))))
                      (#pt-app (#pt-use divides-zero ()) divisor-natural))))
                negative-normal-form))
            (#pt-app (#pt-use integer-normal-form ()) integer-factor))))
      integer-divides-proof)))
