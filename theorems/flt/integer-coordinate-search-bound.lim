; An arbitrary signed three-square budget gives an actual natural
; square witness and magnitude bound. Formal-difference equivalence
; and faithful natural embedding justify the integer-to-natural step.
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-reflexive = ./integer-equality.lim::integer-reflexive)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias integer-add-congruent = ./integer-equality.lim::integer-add-congruent)
(#alias integer-of-natural-injective = ./integer-equality.lim::integer-of-natural-injective)
(#alias integer-multiply-congruent = ./integer-multiplication.lim::integer-multiply-congruent)
(#alias integer-multiply-of-natural = ./integer-multiplication.lim::integer-multiply-of-natural)
(#alias integer-add-of-natural = ./integer-multiplication.lim::integer-add-of-natural)
(#alias
  integer-square-magnitude-positive
  =
  ./integer-nonnegative.lim::integer-square-magnitude-positive)
(#alias integer-square-nonnegative = ./integer-nonnegative.lim::integer-square-nonnegative)
(#alias integer-magnitude = ./integer-magnitude.lim::integer-magnitude)
(#alias
  natural-three-square-budget-magnitude-bound
  =
  ./natural-coordinate-search-bound.lim::natural-three-square-budget-magnitude-bound)
(#alias add = ./../fermat_statement.lim::add)
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#theorem integer-three-square-natural-budget
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter other-square (#pt-use integer ()))
    (#parameter magnitude #pt-nat)
    (#parameter budget #pt-nat)
    (#parameter magnitude-proof (#pt-app (#pt-use integer-magnitude ()) number magnitude))
    (#parameter budget-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-multiply ()) (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)) (#pt-app (#pt-use integer-multiply ()) number number)) (#pt-app (#pt-use integer-multiply ()) other-square other-square)) (#pt-app (#pt-use integer-of-natural ()) budget))))
  (#statement
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-square #pt-nat))
        (#pt-eq
          #pt-nat
          budget
          (#pt-app
            (#pt-use add ())
            (#pt-app
              (#pt-use multiply ())
              (#pt-numeral 3)
              (#pt-app (#pt-use multiply ()) magnitude magnitude))
            candidate-square)))))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-square-value #pt-nat))
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-app (#pt-use integer-multiply ()) other-square other-square)
            (#pt-app (#pt-use integer-of-natural ()) candidate-square-value))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-square-value #pt-nat))
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-app (#pt-use integer-multiply ()) other-square other-square)
                  (#pt-app (#pt-use integer-of-natural ()) candidate-square-value))))))
        (#pt-app
          (#pt-use exists (0))
          #pt-nat
          (#pt-lambda
            ((candidate-square #pt-nat))
            (#pt-eq
              #pt-nat
              budget
              (#pt-app
                (#pt-use add ())
                (#pt-app
                  (#pt-use multiply ())
                  (#pt-numeral 3)
                  (#pt-app (#pt-use multiply ()) magnitude magnitude))
                candidate-square)))))
      (
        (#pt-lambda
          (
            (natural-square #pt-nat)
            (square-equivalence
              (#pt-app
                (#pt-use integer-equal ())
                (#pt-app (#pt-use integer-multiply ()) other-square other-square)
                (#pt-app (#pt-use integer-of-natural ()) natural-square))))
          (#pt-construct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-square #pt-nat))
                (#pt-eq
                  #pt-nat
                  budget
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app
                      (#pt-use multiply ())
                      (#pt-numeral 3)
                      (#pt-app (#pt-use multiply ()) magnitude magnitude))
                    candidate-square))))
            introduce
            (natural-square
              (#pt-app
                (#pt-use integer-of-natural-injective ())
                budget
                (#pt-app
                  (#pt-use add ())
                  (#pt-app
                    (#pt-use multiply ())
                    (#pt-numeral 3)
                    (#pt-app (#pt-use multiply ()) magnitude magnitude))
                  natural-square)
                (#pt-app
                  (#pt-use integer-transitive ())
                  (#pt-app (#pt-use integer-of-natural ()) budget)
                  (#pt-app
                    (#pt-use integer-add ())
                    (#pt-app
                      (#pt-use integer-multiply ())
                      (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                      (#pt-app (#pt-use integer-multiply ()) number number))
                    (#pt-app (#pt-use integer-multiply ()) other-square other-square))
                  (#pt-app
                    (#pt-use integer-of-natural ())
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app
                        (#pt-use multiply ())
                        (#pt-numeral 3)
                        (#pt-app (#pt-use multiply ()) magnitude magnitude))
                      natural-square))
                  (#pt-app
                    (#pt-use integer-symmetric ())
                    (#pt-app
                      (#pt-use integer-add ())
                      (#pt-app
                        (#pt-use integer-multiply ())
                        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                        (#pt-app (#pt-use integer-multiply ()) number number))
                      (#pt-app (#pt-use integer-multiply ()) other-square other-square))
                    (#pt-app (#pt-use integer-of-natural ()) budget)
                    budget-equation)
                  (#pt-app
                    (#pt-use integer-transitive ())
                    (#pt-app
                      (#pt-use integer-add ())
                      (#pt-app
                        (#pt-use integer-multiply ())
                        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                        (#pt-app (#pt-use integer-multiply ()) number number))
                      (#pt-app (#pt-use integer-multiply ()) other-square other-square))
                    (#pt-app
                      (#pt-use integer-add ())
                      (#pt-app
                        (#pt-use integer-multiply ())
                        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                        (#pt-app
                          (#pt-use integer-of-natural ())
                          (#pt-app (#pt-use multiply ()) magnitude magnitude)))
                      (#pt-app (#pt-use integer-of-natural ()) natural-square))
                    (#pt-app
                      (#pt-use integer-of-natural ())
                      (#pt-app
                        (#pt-use add ())
                        (#pt-app
                          (#pt-use multiply ())
                          (#pt-numeral 3)
                          (#pt-app (#pt-use multiply ()) magnitude magnitude))
                        natural-square))
                    (#pt-app
                      (#pt-use integer-add-congruent ())
                      (#pt-app
                        (#pt-use integer-multiply ())
                        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                        (#pt-app (#pt-use integer-multiply ()) number number))
                      (#pt-app (#pt-use integer-multiply ()) other-square other-square)
                      (#pt-app
                        (#pt-use integer-multiply ())
                        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                        (#pt-app
                          (#pt-use integer-of-natural ())
                          (#pt-app (#pt-use multiply ()) magnitude magnitude)))
                      (#pt-app (#pt-use integer-of-natural ()) natural-square)
                      (#pt-app
                        (#pt-use integer-multiply-congruent ())
                        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                        (#pt-app (#pt-use integer-multiply ()) number number)
                        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                        (#pt-app
                          (#pt-use integer-of-natural ())
                          (#pt-app (#pt-use multiply ()) magnitude magnitude))
                        (#pt-app
                          (#pt-use integer-reflexive ())
                          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)))
                        (#pt-app
                          (#pt-use integer-square-magnitude-positive ())
                          number
                          magnitude
                          magnitude-proof))
                      square-equivalence)
                    (#pt-app
                      (#pt-use integer-transitive ())
                      (#pt-app
                        (#pt-use integer-add ())
                        (#pt-app
                          (#pt-use integer-multiply ())
                          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                          (#pt-app
                            (#pt-use integer-of-natural ())
                            (#pt-app (#pt-use multiply ()) magnitude magnitude)))
                        (#pt-app (#pt-use integer-of-natural ()) natural-square))
                      (#pt-app
                        (#pt-use integer-add ())
                        (#pt-app
                          (#pt-use integer-of-natural ())
                          (#pt-app
                            (#pt-use multiply ())
                            (#pt-numeral 3)
                            (#pt-app (#pt-use multiply ()) magnitude magnitude)))
                        (#pt-app (#pt-use integer-of-natural ()) natural-square))
                      (#pt-app
                        (#pt-use integer-of-natural ())
                        (#pt-app
                          (#pt-use add ())
                          (#pt-app
                            (#pt-use multiply ())
                            (#pt-numeral 3)
                            (#pt-app (#pt-use multiply ()) magnitude magnitude))
                          natural-square))
                      (#pt-app
                        (#pt-use integer-add-congruent ())
                        (#pt-app
                          (#pt-use integer-multiply ())
                          (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3))
                          (#pt-app
                            (#pt-use integer-of-natural ())
                            (#pt-app (#pt-use multiply ()) magnitude magnitude)))
                        (#pt-app (#pt-use integer-of-natural ()) natural-square)
                        (#pt-app
                          (#pt-use integer-of-natural ())
                          (#pt-app
                            (#pt-use multiply ())
                            (#pt-numeral 3)
                            (#pt-app (#pt-use multiply ()) magnitude magnitude)))
                        (#pt-app (#pt-use integer-of-natural ()) natural-square)
                        (#pt-app
                          (#pt-use integer-multiply-of-natural ())
                          (#pt-numeral 3)
                          (#pt-app (#pt-use multiply ()) magnitude magnitude))
                        (#pt-app
                          (#pt-use integer-reflexive ())
                          (#pt-app (#pt-use integer-of-natural ()) natural-square)))
                      (#pt-app
                        (#pt-use integer-add-of-natural ())
                        (#pt-app
                          (#pt-use multiply ())
                          (#pt-numeral 3)
                          (#pt-app (#pt-use multiply ()) magnitude magnitude))
                        natural-square)))))))))
      (#pt-app (#pt-use integer-square-nonnegative ()) other-square))))
(#theorem integer-three-square-magnitude-bound
  (#universes)
  (#parameters
    (#parameter number (#pt-use integer ()))
    (#parameter other-square (#pt-use integer ()))
    (#parameter magnitude #pt-nat)
    (#parameter budget #pt-nat)
    (#parameter magnitude-proof (#pt-app (#pt-use integer-magnitude ()) number magnitude))
    (#parameter budget-equation (#pt-app (#pt-use integer-equal ()) (#pt-app (#pt-use integer-add ()) (#pt-app (#pt-use integer-multiply ()) (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 3)) (#pt-app (#pt-use integer-multiply ()) number number)) (#pt-app (#pt-use integer-multiply ()) other-square other-square)) (#pt-app (#pt-use integer-of-natural ()) budget))))
  (#statement (#pt-app (#pt-use less-than ()) magnitude (#pt-succ budget)))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-square #pt-nat))
          (#pt-eq
            #pt-nat
            budget
            (#pt-app
              (#pt-use add ())
              (#pt-app
                (#pt-use multiply ())
                (#pt-numeral 3)
                (#pt-app (#pt-use multiply ()) magnitude magnitude))
              candidate-square))))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-square #pt-nat))
                (#pt-eq
                  #pt-nat
                  budget
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app
                      (#pt-use multiply ())
                      (#pt-numeral 3)
                      (#pt-app (#pt-use multiply ()) magnitude magnitude))
                    candidate-square))))))
        (#pt-app (#pt-use less-than ()) magnitude (#pt-succ budget)))
      (
        (#pt-lambda
          (
            (natural-square #pt-nat)
            (natural-budget-equation
              (#pt-eq
                #pt-nat
                budget
                (#pt-app
                  (#pt-use add ())
                  (#pt-app
                    (#pt-use multiply ())
                    (#pt-numeral 3)
                    (#pt-app (#pt-use multiply ()) magnitude magnitude))
                  natural-square))))
          (#pt-app
            (#pt-use natural-three-square-budget-magnitude-bound ())
            magnitude
            natural-square
            budget
            natural-budget-equation)))
      (#pt-app
        (#pt-use integer-three-square-natural-budget ())
        number
        other-square
        magnitude
        budget
        magnitude-proof
        budget-equation))))
