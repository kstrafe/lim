; Natural coprimality, gcd uniqueness and Euclidean invariance.
; Coprime means every common natural divisor is one. Its equivalence to
; the proved gcd specification being one is checked explicitly below.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias exists = ./logic-exists.lim::exists)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias divides-multiple = ./natural-divisibility.lim::divides-multiple)
(#alias divides-transitive = ./natural-divisibility.lim::divides-transitive)
(#alias divides-add = ./natural-divisibility-addition.lim::divides-add)
(#alias divides-add-cancel-left = ./natural-divisibility-addition.lim::divides-add-cancel-left)
(#alias divides-antisymmetric = ./natural-divisibility-bounds.lim::divides-antisymmetric)
(#alias divides-one = ./natural-divisibility-bounds.lim::divides-one)
(#alias multiply-commutative = ./natural-multiplication-commutative.lim::multiply-commutative)
(#alias add-commutative = ./natural-addition.lim::add-commutative)
(#alias less-than = ./natural-order.lim::less-than)
(#alias division-spec = ./natural-division.lim::division-spec)
(#alias gcd-spec = ./natural-gcd.lim::gcd-spec)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias symmetry = ./equality.lim::symmetry)
(#alias substitution = ./equality.lim::substitution)
(#math-definition coprime ()
  (#pt-pi ((left #pt-nat) (right #pt-nat)) #pt-prop)
  (#pt-lambda
    ((left #pt-nat) (right #pt-nat))
    (#pt-pi
      (
        (candidate-divisor #pt-nat)
        (candidate-left (#pt-app (#pt-use divides ()) candidate-divisor left))
        (candidate-right (#pt-app (#pt-use divides ()) candidate-divisor right)))
      (#pt-eq #pt-nat candidate-divisor (#pt-succ #pt-zero)))))
(#theorem gcd-unique
  (#universes)
  (#parameters
    (#parameter left #pt-nat)
    (#parameter right #pt-nat)
    (#parameter first-gcd #pt-nat)
    (#parameter second-gcd #pt-nat)
    (#parameter first-certificate (#pt-app (#pt-use gcd-spec ()) left right first-gcd))
    (#parameter second-certificate (#pt-app (#pt-use gcd-spec ()) left right second-gcd)))
  (#statement (#pt-eq #pt-nat first-gcd second-gcd))
  (#proof
    (#pt-app
      (#pt-use divides-antisymmetric ())
      first-gcd
      second-gcd
      (#pt-app
        (#pt-app
          (#pt-use conjunction-right ())
          (#pt-app (#pt-use divides ()) second-gcd right)
          (#pt-pi
            (
              (candidate-common #pt-nat)
              (candidate-first (#pt-app (#pt-use divides ()) candidate-common left))
              (candidate-second (#pt-app (#pt-use divides ()) candidate-common right)))
            (#pt-app (#pt-use divides ()) candidate-common second-gcd))
          (#pt-app
            (#pt-use conjunction-right ())
            (#pt-app (#pt-use divides ()) second-gcd left)
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app (#pt-use divides ()) second-gcd right)
              (#pt-pi
                (
                  (candidate-common #pt-nat)
                  (candidate-first (#pt-app (#pt-use divides ()) candidate-common left))
                  (candidate-second (#pt-app (#pt-use divides ()) candidate-common right)))
                (#pt-app (#pt-use divides ()) candidate-common second-gcd)))
            second-certificate))
        first-gcd
        (#pt-app
          (#pt-use conjunction-left ())
          (#pt-app (#pt-use divides ()) first-gcd left)
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app (#pt-use divides ()) first-gcd right)
            (#pt-pi
              (
                (candidate-common #pt-nat)
                (candidate-first (#pt-app (#pt-use divides ()) candidate-common left))
                (candidate-second (#pt-app (#pt-use divides ()) candidate-common right)))
              (#pt-app (#pt-use divides ()) candidate-common first-gcd)))
          first-certificate)
        (#pt-app
          (#pt-use conjunction-left ())
          (#pt-app (#pt-use divides ()) first-gcd right)
          (#pt-pi
            (
              (candidate-common #pt-nat)
              (candidate-first (#pt-app (#pt-use divides ()) candidate-common left))
              (candidate-second (#pt-app (#pt-use divides ()) candidate-common right)))
            (#pt-app (#pt-use divides ()) candidate-common first-gcd))
          (#pt-app
            (#pt-use conjunction-right ())
            (#pt-app (#pt-use divides ()) first-gcd left)
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app (#pt-use divides ()) first-gcd right)
              (#pt-pi
                (
                  (candidate-common #pt-nat)
                  (candidate-first (#pt-app (#pt-use divides ()) candidate-common left))
                  (candidate-second (#pt-app (#pt-use divides ()) candidate-common right)))
                (#pt-app (#pt-use divides ()) candidate-common first-gcd)))
            first-certificate)))
      (#pt-app
        (#pt-app
          (#pt-use conjunction-right ())
          (#pt-app (#pt-use divides ()) first-gcd right)
          (#pt-pi
            (
              (candidate-common #pt-nat)
              (candidate-first (#pt-app (#pt-use divides ()) candidate-common left))
              (candidate-second (#pt-app (#pt-use divides ()) candidate-common right)))
            (#pt-app (#pt-use divides ()) candidate-common first-gcd))
          (#pt-app
            (#pt-use conjunction-right ())
            (#pt-app (#pt-use divides ()) first-gcd left)
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app (#pt-use divides ()) first-gcd right)
              (#pt-pi
                (
                  (candidate-common #pt-nat)
                  (candidate-first (#pt-app (#pt-use divides ()) candidate-common left))
                  (candidate-second (#pt-app (#pt-use divides ()) candidate-common right)))
                (#pt-app (#pt-use divides ()) candidate-common first-gcd)))
            first-certificate))
        second-gcd
        (#pt-app
          (#pt-use conjunction-left ())
          (#pt-app (#pt-use divides ()) second-gcd left)
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app (#pt-use divides ()) second-gcd right)
            (#pt-pi
              (
                (candidate-common #pt-nat)
                (candidate-first (#pt-app (#pt-use divides ()) candidate-common left))
                (candidate-second (#pt-app (#pt-use divides ()) candidate-common right)))
              (#pt-app (#pt-use divides ()) candidate-common second-gcd)))
          second-certificate)
        (#pt-app
          (#pt-use conjunction-left ())
          (#pt-app (#pt-use divides ()) second-gcd right)
          (#pt-pi
            (
              (candidate-common #pt-nat)
              (candidate-first (#pt-app (#pt-use divides ()) candidate-common left))
              (candidate-second (#pt-app (#pt-use divides ()) candidate-common right)))
            (#pt-app (#pt-use divides ()) candidate-common second-gcd))
          (#pt-app
            (#pt-use conjunction-right ())
            (#pt-app (#pt-use divides ()) second-gcd left)
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app (#pt-use divides ()) second-gcd right)
              (#pt-pi
                (
                  (candidate-common #pt-nat)
                  (candidate-first (#pt-app (#pt-use divides ()) candidate-common left))
                  (candidate-second (#pt-app (#pt-use divides ()) candidate-common right)))
                (#pt-app (#pt-use divides ()) candidate-common second-gcd)))
            second-certificate))))))
(#theorem gcd-one-of-coprime
  (#universes)
  (#parameters
    (#parameter left #pt-nat)
    (#parameter right #pt-nat)
    (#parameter greatest-divisor #pt-nat)
    (#parameter gcd-proof (#pt-app (#pt-use gcd-spec ()) left right greatest-divisor))
    (#parameter coprime-proof (#pt-app (#pt-use coprime ()) left right)))
  (#statement (#pt-eq #pt-nat greatest-divisor (#pt-succ #pt-zero)))
  (#proof
    (#pt-app
      coprime-proof
      greatest-divisor
      (#pt-app
        (#pt-use conjunction-left ())
        (#pt-app (#pt-use divides ()) greatest-divisor left)
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app (#pt-use divides ()) greatest-divisor right)
          (#pt-pi
            (
              (candidate-common #pt-nat)
              (candidate-first (#pt-app (#pt-use divides ()) candidate-common left))
              (candidate-second (#pt-app (#pt-use divides ()) candidate-common right)))
            (#pt-app (#pt-use divides ()) candidate-common greatest-divisor)))
        gcd-proof)
      (#pt-app
        (#pt-use conjunction-left ())
        (#pt-app (#pt-use divides ()) greatest-divisor right)
        (#pt-pi
          (
            (candidate-common #pt-nat)
            (candidate-first (#pt-app (#pt-use divides ()) candidate-common left))
            (candidate-second (#pt-app (#pt-use divides ()) candidate-common right)))
          (#pt-app (#pt-use divides ()) candidate-common greatest-divisor))
        (#pt-app
          (#pt-use conjunction-right ())
          (#pt-app (#pt-use divides ()) greatest-divisor left)
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app (#pt-use divides ()) greatest-divisor right)
            (#pt-pi
              (
                (candidate-common #pt-nat)
                (candidate-first (#pt-app (#pt-use divides ()) candidate-common left))
                (candidate-second (#pt-app (#pt-use divides ()) candidate-common right)))
              (#pt-app (#pt-use divides ()) candidate-common greatest-divisor)))
          gcd-proof)))))
(#theorem coprime-of-gcd-one
  (#universes)
  (#parameters
    (#parameter left #pt-nat)
    (#parameter right #pt-nat)
    (#parameter greatest-divisor #pt-nat)
    (#parameter gcd-proof (#pt-app (#pt-use gcd-spec ()) left right greatest-divisor))
    (#parameter gcd-is-one (#pt-eq #pt-nat greatest-divisor (#pt-succ #pt-zero))))
  (#statement (#pt-app (#pt-use coprime ()) left right))
  (#proof
    (#pt-lambda
      (
        (common-divisor #pt-nat)
        (left-divides (#pt-app (#pt-use divides ()) common-divisor left))
        (right-divides (#pt-app (#pt-use divides ()) common-divisor right)))
      (#pt-app
        (#pt-use divides-one ())
        common-divisor
        (#pt-app
          (#pt-use substitution (0))
          #pt-nat
          (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use divides ()) common-divisor endpoint))
          greatest-divisor
          (#pt-succ #pt-zero)
          gcd-is-one
          (#pt-app
            (#pt-app
              (#pt-use conjunction-right ())
              (#pt-app (#pt-use divides ()) greatest-divisor right)
              (#pt-pi
                (
                  (candidate-common #pt-nat)
                  (candidate-first (#pt-app (#pt-use divides ()) candidate-common left))
                  (candidate-second (#pt-app (#pt-use divides ()) candidate-common right)))
                (#pt-app (#pt-use divides ()) candidate-common greatest-divisor))
              (#pt-app
                (#pt-use conjunction-right ())
                (#pt-app (#pt-use divides ()) greatest-divisor left)
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app (#pt-use divides ()) greatest-divisor right)
                  (#pt-pi
                    (
                      (candidate-common #pt-nat)
                      (candidate-first (#pt-app (#pt-use divides ()) candidate-common left))
                      (candidate-second (#pt-app (#pt-use divides ()) candidate-common right)))
                    (#pt-app (#pt-use divides ()) candidate-common greatest-divisor)))
                gcd-proof))
            common-divisor
            left-divides
            right-divides))))))
(#theorem coprime-symmetric
  (#universes)
  (#parameters
    (#parameter left #pt-nat)
    (#parameter right #pt-nat)
    (#parameter coprime-proof (#pt-app (#pt-use coprime ()) left right)))
  (#statement (#pt-app (#pt-use coprime ()) right left))
  (#proof
    (#pt-lambda
      (
        (common-divisor #pt-nat)
        (left-divides (#pt-app (#pt-use divides ()) common-divisor right))
        (right-divides (#pt-app (#pt-use divides ()) common-divisor left)))
      (#pt-app coprime-proof common-divisor right-divides left-divides))))
(#theorem coprime-one-left
  (#universes)
  (#parameters
    (#parameter number #pt-nat))
  (#statement (#pt-app (#pt-use coprime ()) (#pt-succ #pt-zero) number))
  (#proof
    (#pt-lambda
      (
        (common-divisor #pt-nat)
        (one-divides (#pt-app (#pt-use divides ()) common-divisor (#pt-succ #pt-zero)))
        (number-divides (#pt-app (#pt-use divides ()) common-divisor number)))
      (#pt-app (#pt-use divides-one ()) common-divisor one-divides))))
(#theorem coprime-add-left
  (#universes)
  (#parameters
    (#parameter left #pt-nat)
    (#parameter right #pt-nat)
    (#parameter coprime-proof (#pt-app (#pt-use coprime ()) left right)))
  (#statement (#pt-app (#pt-use coprime ()) left (#pt-app (#pt-use add ()) left right)))
  (#proof
    (#pt-lambda
      (
        (common-divisor #pt-nat)
        (left-divides (#pt-app (#pt-use divides ()) common-divisor left))
        (sum-divides
          (#pt-app (#pt-use divides ()) common-divisor (#pt-app (#pt-use add ()) left right))))
      (#pt-app
        coprime-proof
        common-divisor
        left-divides
        (#pt-app
          (#pt-use divides-add-cancel-left ())
          common-divisor
          left
          right
          left-divides
          sum-divides)))))
(#theorem coprime-add-right
  (#universes)
  (#parameters
    (#parameter left #pt-nat)
    (#parameter right #pt-nat)
    (#parameter coprime-proof (#pt-app (#pt-use coprime ()) left right)))
  (#statement (#pt-app (#pt-use coprime ()) (#pt-app (#pt-use add ()) left right) right))
  (#proof
    (#pt-lambda
      (
        (common-divisor #pt-nat)
        (sum-divides
          (#pt-app (#pt-use divides ()) common-divisor (#pt-app (#pt-use add ()) left right)))
        (right-divides (#pt-app (#pt-use divides ()) common-divisor right)))
      (#pt-app
        coprime-proof
        common-divisor
        (#pt-app
          (#pt-use divides-add-cancel-left ())
          common-divisor
          right
          left
          right-divides
          (#pt-app
            (#pt-use substitution (0))
            #pt-nat
            (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use divides ()) common-divisor endpoint))
            (#pt-app (#pt-use add ()) left right)
            (#pt-app (#pt-use add ()) right left)
            (#pt-app (#pt-use add-commutative ()) left right)
            sum-divides))
        right-divides))))
(#theorem coprime-euclidean-remainder
  (#universes)
  (#parameters
    (#parameter dividend #pt-nat)
    (#parameter divisor #pt-nat)
    (#parameter quotient #pt-nat)
    (#parameter remainder #pt-nat)
    (#parameter division-proof (#pt-app (#pt-use division-spec ()) dividend divisor quotient remainder))
    (#parameter coprime-proof (#pt-app (#pt-use coprime ()) dividend divisor)))
  (#statement (#pt-app (#pt-use coprime ()) divisor remainder))
  (#proof
    (#pt-lambda
      (
        (common-divisor #pt-nat)
        (divisor-divides (#pt-app (#pt-use divides ()) common-divisor divisor))
        (remainder-divides (#pt-app (#pt-use divides ()) common-divisor remainder)))
      (#pt-app
        coprime-proof
        common-divisor
        (#pt-app
          (#pt-use substitution (0))
          #pt-nat
          (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use divides ()) common-divisor endpoint))
          (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) quotient divisor) remainder)
          dividend
          (#pt-app
            (#pt-use symmetry (0))
            #pt-nat
            dividend
            (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) quotient divisor) remainder)
            (#pt-app
              (#pt-use conjunction-left ())
              (#pt-eq
                #pt-nat
                dividend
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) quotient divisor)
                  remainder))
              (#pt-app (#pt-use less-than ()) remainder divisor)
              division-proof))
          (#pt-app
            (#pt-use divides-add ())
            common-divisor
            (#pt-app (#pt-use multiply ()) quotient divisor)
            remainder
            (#pt-app
              (#pt-use divides-transitive ())
              common-divisor
              divisor
              (#pt-app (#pt-use multiply ()) quotient divisor)
              divisor-divides
              (#pt-app
                (#pt-use substitution (0))
                #pt-nat
                (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use divides ()) divisor endpoint))
                (#pt-app (#pt-use multiply ()) divisor quotient)
                (#pt-app (#pt-use multiply ()) quotient divisor)
                (#pt-app (#pt-use multiply-commutative ()) divisor quotient)
                (#pt-app (#pt-use divides-multiple ()) divisor quotient)))
            remainder-divides))
        divisor-divides))))
(#theorem coprime-euclidean-reconstruct
  (#universes)
  (#parameters
    (#parameter dividend #pt-nat)
    (#parameter divisor #pt-nat)
    (#parameter quotient #pt-nat)
    (#parameter remainder #pt-nat)
    (#parameter division-proof (#pt-app (#pt-use division-spec ()) dividend divisor quotient remainder))
    (#parameter coprime-proof (#pt-app (#pt-use coprime ()) divisor remainder)))
  (#statement (#pt-app (#pt-use coprime ()) dividend divisor))
  (#proof
    (#pt-lambda
      (
        (common-divisor #pt-nat)
        (dividend-divides (#pt-app (#pt-use divides ()) common-divisor dividend))
        (divisor-divides (#pt-app (#pt-use divides ()) common-divisor divisor)))
      (#pt-app
        coprime-proof
        common-divisor
        divisor-divides
        (#pt-app
          (#pt-use divides-add-cancel-left ())
          common-divisor
          (#pt-app (#pt-use multiply ()) quotient divisor)
          remainder
          (#pt-app
            (#pt-use divides-transitive ())
            common-divisor
            divisor
            (#pt-app (#pt-use multiply ()) quotient divisor)
            divisor-divides
            (#pt-app
              (#pt-use substitution (0))
              #pt-nat
              (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use divides ()) divisor endpoint))
              (#pt-app (#pt-use multiply ()) divisor quotient)
              (#pt-app (#pt-use multiply ()) quotient divisor)
              (#pt-app (#pt-use multiply-commutative ()) divisor quotient)
              (#pt-app (#pt-use divides-multiple ()) divisor quotient)))
          (#pt-app
            (#pt-use substitution (0))
            #pt-nat
            (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use divides ()) common-divisor endpoint))
            dividend
            (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) quotient divisor) remainder)
            (#pt-app
              (#pt-use conjunction-left ())
              (#pt-eq
                #pt-nat
                dividend
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) quotient divisor)
                  remainder))
              (#pt-app (#pt-use less-than ()) remainder divisor)
              division-proof)
            dividend-divides))))))
