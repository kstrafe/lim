      (constant-degree-data
        (#pt-app (#pt-use ring-polynomial-degree-data ()) Carrier coefficient-ring polynomial))
      (linear-degree-data
        (#pt-app (#pt-use ring-polynomial-degree-data ()) Carrier coefficient-ring other-polynomial)))
    (#pt-app
      (#pt-use ring-polynomial-degree-data ())
