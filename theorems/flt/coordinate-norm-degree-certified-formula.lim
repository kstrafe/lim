          Carrier
          coefficient-ring
          coefficient-domain
          a1
          a2
          a3
          a4
          a6
          polynomial
          other-polynomial
          constant-degree-data
          linear-degree-data))))
  (#proof
    (#pt-app
      (#pt-use ring-polynomial-degree-data-valid ())
