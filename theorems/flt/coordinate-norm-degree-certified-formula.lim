      (#pt-app
        (#pt-use coordinate-norm-degree-value ())
        Carrier
        coefficient-ring
        a1
        a2
        a3
        a4
        a6
        polynomial
        other-polynomial)))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (coefficient-domain
        (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
