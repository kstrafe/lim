    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter constant-degree-data (#pt-app (#pt-use ring-polynomial-degree-data ()) Carrier coefficient-ring polynomial))
    (#parameter linear-degree-data (#pt-app (#pt-use ring-polynomial-degree-data ()) Carrier coefficient-ring other-polynomial))
    (#parameter nonzero-norm (#pt-pi ((denied-evidence (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring (#pt-app (#pt-use coordinate-norm-degree-value ()) Carrier coefficient-ring a1 a2 a3 a4 a6 polynomial other-polynomial) (#pt-construct finite-list () (Carrier) nil ())))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-degree-witness ())
