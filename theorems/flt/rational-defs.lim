; Exact mathematical rationals for the actual rational Frey curve.
; A fraction carries a signed numerator, natural denominator and an
; actual proof that the denominator is nonzero. Equality is cross
; multiplication of formal-difference integers, not kernel identity.
; Operations construct nonzero-denominator witnesses explicitly; no
; quotient, division or field axiom is introduced.
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-zero = ./integer-defs.lim::integer-zero)
(#alias integer-one = ./integer-defs.lim::integer-one)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias multiply-nonzero = ./natural-nonzero.lim::multiply-nonzero)
(#alias successor-not-zero = ./natural-nonzero.lim::successor-not-zero)
(#math-inductive rational ()
  ()
  (#pt-type 0)
  (
    (fraction
      (
        (numerator (#pt-use integer ()))
        (denominator #pt-nat)
        (denominator-nonzero
          (#pt-pi ((denied-proof (#pt-eq #pt-nat denominator #pt-zero))) #pt-false))))))
(#math-definition rational-equal ()
  (#pt-pi ((first (#pt-use rational ())) (second (#pt-use rational ()))) #pt-prop)
  (#pt-lambda
    ((first (#pt-use rational ())) (second (#pt-use rational ())))
    (#pt-app
      (#pt-use integer-equal ())
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-project rational 0 first)
        (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second)))
      (#pt-app
        (#pt-use integer-multiply ())
        (#pt-project rational 0 second)
        (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))))))
(#math-definition rational-of-integer ()
  (#pt-pi ((numerator (#pt-use integer ()))) (#pt-use rational ()))
  (#pt-lambda
    ((numerator (#pt-use integer ())))
    (#pt-construct
      rational
      ()
      ()
      fraction
      (numerator (#pt-succ #pt-zero) (#pt-app (#pt-use successor-not-zero ()) #pt-zero)))))
(#math-definition rational-zero ()
  (#pt-use rational ())
  (#pt-app (#pt-use rational-of-integer ()) (#pt-use integer-zero ())))
(#math-definition rational-one ()
  (#pt-use rational ())
  (#pt-app (#pt-use rational-of-integer ()) (#pt-use integer-one ())))
(#math-definition rational-negate ()
  (#pt-pi ((first (#pt-use rational ()))) (#pt-use rational ()))
  (#pt-lambda
    ((first (#pt-use rational ())))
    (#pt-construct
      rational
      ()
      ()
      fraction
      (
        (#pt-app (#pt-use integer-negate ()) (#pt-project rational 0 first))
        (#pt-project rational 1 first)
        (#pt-project rational 2 first)))))
(#math-definition rational-multiply ()
  (#pt-pi ((first (#pt-use rational ())) (second (#pt-use rational ()))) (#pt-use rational ()))
  (#pt-lambda
    ((first (#pt-use rational ())) (second (#pt-use rational ())))
    (#pt-construct
      rational
      ()
      ()
      fraction
      (
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-project rational 0 first)
          (#pt-project rational 0 second))
        (#pt-app
          (#pt-use multiply ())
          (#pt-project rational 1 first)
          (#pt-project rational 1 second))
        (#pt-app
          (#pt-use multiply-nonzero ())
          (#pt-project rational 1 first)
          (#pt-project rational 1 second)
          (#pt-project rational 2 first)
          (#pt-project rational 2 second))))))
(#math-definition rational-add ()
  (#pt-pi ((first (#pt-use rational ())) (second (#pt-use rational ()))) (#pt-use rational ()))
  (#pt-lambda
    ((first (#pt-use rational ())) (second (#pt-use rational ())))
    (#pt-construct
      rational
      ()
      ()
      fraction
      (
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 first)
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second)))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 second)
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))))
        (#pt-app
          (#pt-use multiply ())
          (#pt-project rational 1 first)
          (#pt-project rational 1 second))
        (#pt-app
          (#pt-use multiply-nonzero ())
          (#pt-project rational 1 first)
          (#pt-project rational 1 second)
          (#pt-project rational 2 first)
          (#pt-project rational 2 second))))))
(#math-definition rational-power ()
  (#pt-pi ((first (#pt-use rational ())) (exponent #pt-nat)) (#pt-use rational ()))
  (#pt-lambda
    ((first (#pt-use rational ())) (exponent #pt-nat))
    (#pt-nat-induct
      (#pt-lambda ((index #pt-nat)) (#pt-use rational ()))
      (#pt-use rational-one ())
      (#pt-lambda
        ((previous-exponent #pt-nat) (previous-power (#pt-use rational ())))
        (#pt-app (#pt-use rational-multiply ()) first previous-power))
      exponent)))
