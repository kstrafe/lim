; Mathematical adaptation; see provenance.json and LICENSE.MATHLIB.
; Power-of-two branch of Mathlib Nat.four_dvd_or_exists_odd_prime_and_dvd_of_two_lt.
; Any 2^k greater than two is divisible by four. The odd-prime classification
; and the exponent-four FLT case remain separate proofs, not assumptions here.
(#alias exists = ./logic-exists.lim::exists)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias power = ../fermat_statement.lim::power)
(#alias power-add = ./natural-powers.lim::power-add)
(#alias less-than = ./natural-order.lim::less-than)
(#alias less-than-successor = ./natural-order.lim::less-than-successor)
(#alias less-than-transitive = ./natural-order.lim::less-than-transitive)
(#alias not-less-than-self = ./natural-order.lim::not-less-than-self)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#theorem four-divides-two-power
  (#universes)
  (#parameters
    (#parameter exponent #pt-nat))
  (#statement
    (#pt-app
      (#pt-use divides ())
      (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
      (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-succ (#pt-succ exponent)))))
  (#proof
    (#pt-construct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((divisibility-witness #pt-nat))
          (#pt-eq
            #pt-nat
            (#pt-app
              (#pt-use power ())
              (#pt-succ (#pt-succ #pt-zero))
              (#pt-succ (#pt-succ exponent)))
            (#pt-app
              (#pt-use multiply ())
              (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
              divisibility-witness))))
      introduce
      (
        (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) exponent)
        (#pt-app
          (#pt-use power-add ())
          (#pt-succ (#pt-succ #pt-zero))
          (#pt-succ (#pt-succ #pt-zero))
          exponent)))))
(#theorem four-divides-large-two-power
  (#universes)
  (#parameters
    (#parameter exponent #pt-nat))
  (#statement
    (#pt-pi
      (
        (large
          (#pt-app
            (#pt-use less-than ())
            (#pt-succ (#pt-succ #pt-zero))
            (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) exponent))))
      (#pt-app
        (#pt-use divides ())
        (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
        (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) exponent))))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((power-index #pt-nat))
        (#pt-pi
          (
            (large
              (#pt-app
                (#pt-use less-than ())
                (#pt-succ (#pt-succ #pt-zero))
                (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) power-index))))
          (#pt-app
            (#pt-use divides ())
            (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
            (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) power-index))))
      (#pt-lambda
        (
          (large
            (#pt-app
              (#pt-use less-than ())
              (#pt-succ (#pt-succ #pt-zero))
              (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) #pt-zero))))
        (#pt-app
          (#pt-use false-elimination ())
          (#pt-app
            (#pt-use divides ())
            (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
            (#pt-succ #pt-zero))
          (#pt-app
            (#pt-app (#pt-use not-less-than-self ()) (#pt-succ #pt-zero))
            (#pt-app
              (#pt-use less-than-transitive ())
              (#pt-succ #pt-zero)
              (#pt-succ (#pt-succ #pt-zero))
              (#pt-succ #pt-zero)
              (#pt-app (#pt-use less-than-successor ()) (#pt-succ #pt-zero))
              large))))
      (#pt-lambda
        (
          (previous #pt-nat)
          (outer-history
            (#pt-pi
              (
                (large
                  (#pt-app
                    (#pt-use less-than ())
                    (#pt-succ (#pt-succ #pt-zero))
                    (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) previous))))
              (#pt-app
                (#pt-use divides ())
                (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
                (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) previous)))))
        (#pt-nat-induct
          (#pt-lambda
            ((power-index #pt-nat))
            (#pt-pi
              (
                (large
                  (#pt-app
                    (#pt-use less-than ())
                    (#pt-succ (#pt-succ #pt-zero))
                    (#pt-app
                      (#pt-use power ())
                      (#pt-succ (#pt-succ #pt-zero))
                      (#pt-succ power-index)))))
              (#pt-app
                (#pt-use divides ())
                (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
                (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-succ power-index)))))
          (#pt-lambda
            (
              (large
                (#pt-app
                  (#pt-use less-than ())
                  (#pt-succ (#pt-succ #pt-zero))
                  (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-succ #pt-zero)))))
            (#pt-app
              (#pt-use false-elimination ())
              (#pt-app
                (#pt-use divides ())
                (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
                (#pt-succ (#pt-succ #pt-zero)))
              (#pt-app
                (#pt-app (#pt-use not-less-than-self ()) (#pt-succ (#pt-succ #pt-zero)))
                large)))
          (#pt-lambda
            (
              (offset #pt-nat)
              (inner-history
                (#pt-pi
                  (
                    (large
                      (#pt-app
                        (#pt-use less-than ())
                        (#pt-succ (#pt-succ #pt-zero))
                        (#pt-app
                          (#pt-use power ())
                          (#pt-succ (#pt-succ #pt-zero))
                          (#pt-succ offset)))))
                  (#pt-app
                    (#pt-use divides ())
                    (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero))))
                    (#pt-app (#pt-use power ()) (#pt-succ (#pt-succ #pt-zero)) (#pt-succ offset)))))
              (large
                (#pt-app
                  (#pt-use less-than ())
                  (#pt-succ (#pt-succ #pt-zero))
                  (#pt-app
                    (#pt-use power ())
                    (#pt-succ (#pt-succ #pt-zero))
                    (#pt-succ (#pt-succ offset))))))
            (#pt-app (#pt-use four-divides-two-power ()) offset))
          previous))
      exponent)))
