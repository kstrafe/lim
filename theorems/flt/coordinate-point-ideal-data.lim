; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Actual XClass=(X-x,0), YClass=(-y(X),1)
; and their principal/two-generator ideals in the proved coordinate
; ring. Alpha=a1*X+a3 and beta=X^3+a2*X^2+a4*X+a6 specialize
; these definitions to the source Weierstrass coordinate ring.
; No evaluation-kernel or quotient-isomorphism claim is assumed.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias quadratic-constant = ./quadratic-algebra-data.lim::quadratic-constant)
(#alias quadratic-element = ./quadratic-algebra-data.lim::quadratic-element)
(#alias quadratic-ring-structure = ./quadratic-algebra-ring-structure.lim::quadratic-ring-structure)
(#alias ring-ideal = ./ring-ideal-data.lim::ring-ideal)
(#alias ring-ideal-pair = ./ring-ideal-pair.lim::ring-ideal-pair)
(#alias ring-ideal-principal = ./ring-ideal-principal.lim::ring-ideal-principal)
(#alias ring-negate = ./commutative-ring-data.lim::ring-negate)
(#alias ring-one = ./commutative-ring-data.lim::ring-one)
(#alias ring-polynomial-negate = ./ring-polynomial-data.lim::ring-polynomial-negate)
(#alias ring-polynomial-structure = ./ring-polynomial-structure.lim::ring-polynomial-structure)
(#math-definition coordinate-point-ideal-X-class ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (root Carrier))
    (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier)))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (root Carrier))
    (#pt-construct
      quadratic-element
      ()
      ((#pt-app (#pt-use finite-list ()) Carrier))
      coordinates
      (
        (#pt-construct
          finite-list
          ()
          (Carrier)
          cons
          (
            (#pt-app (#pt-use ring-negate ()) Carrier coefficient-ring root)
            (#pt-construct
              finite-list
              ()
              (Carrier)
              cons
              (
                (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
                (#pt-construct finite-list () (Carrier) nil ())))))
        (#pt-construct finite-list () (Carrier) nil ())))))
(#math-definition coordinate-point-ideal-Y-class ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (Y-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
    (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier)))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (Y-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
    (#pt-construct
      quadratic-element
      ()
      ((#pt-app (#pt-use finite-list ()) Carrier))
      coordinates
      (
        (#pt-app (#pt-use ring-polynomial-negate ()) Carrier coefficient-ring Y-polynomial)
        (#pt-construct
          finite-list
          ()
          (Carrier)
          cons
          (
            (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
            (#pt-construct finite-list () (Carrier) nil ())))))))
(#math-definition coordinate-point-ideal-X ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (quadratic-linear (#pt-app (#pt-use finite-list ()) Carrier))
      (quadratic-constant (#pt-app (#pt-use finite-list ()) Carrier))
      (root Carrier))
    (#pt-app
      (#pt-use ring-ideal ())
      (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
      (#pt-app
        (#pt-use quadratic-ring-structure ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        quadratic-linear
        quadratic-constant)))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (quadratic-linear (#pt-app (#pt-use finite-list ()) Carrier))
      (quadratic-constant (#pt-app (#pt-use finite-list ()) Carrier))
      (root Carrier))
    (#pt-app
      (#pt-use ring-ideal-principal ())
      (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
      (#pt-app
        (#pt-use quadratic-ring-structure ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        quadratic-linear
        quadratic-constant)
      (#pt-app (#pt-use coordinate-point-ideal-X-class ()) Carrier coefficient-ring root))))
(#math-definition coordinate-point-ideal-Y ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (quadratic-linear (#pt-app (#pt-use finite-list ()) Carrier))
      (quadratic-constant (#pt-app (#pt-use finite-list ()) Carrier))
      (Y-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
    (#pt-app
      (#pt-use ring-ideal ())
      (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
      (#pt-app
        (#pt-use quadratic-ring-structure ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        quadratic-linear
        quadratic-constant)))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (quadratic-linear (#pt-app (#pt-use finite-list ()) Carrier))
      (quadratic-constant (#pt-app (#pt-use finite-list ()) Carrier))
      (Y-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
    (#pt-app
      (#pt-use ring-ideal-principal ())
      (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
      (#pt-app
        (#pt-use quadratic-ring-structure ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        quadratic-linear
        quadratic-constant)
      (#pt-app (#pt-use coordinate-point-ideal-Y-class ()) Carrier coefficient-ring Y-polynomial))))
(#math-definition coordinate-point-ideal-XY ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (quadratic-linear (#pt-app (#pt-use finite-list ()) Carrier))
      (quadratic-constant (#pt-app (#pt-use finite-list ()) Carrier))
      (root Carrier)
      (Y-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
    (#pt-app
      (#pt-use ring-ideal ())
      (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
      (#pt-app
        (#pt-use quadratic-ring-structure ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        quadratic-linear
        quadratic-constant)))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (quadratic-linear (#pt-app (#pt-use finite-list ()) Carrier))
      (quadratic-constant (#pt-app (#pt-use finite-list ()) Carrier))
      (root Carrier)
      (Y-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
    (#pt-app
      (#pt-use ring-ideal-pair ())
      (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
      (#pt-app
        (#pt-use quadratic-ring-structure ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        quadratic-linear
        quadratic-constant)
      (#pt-app (#pt-use coordinate-point-ideal-X-class ()) Carrier coefficient-ring root)
      (#pt-app (#pt-use coordinate-point-ideal-Y-class ()) Carrier coefficient-ring Y-polynomial))))
(#theorem coordinate-point-ideal-X-constant
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter root Carrier))
  (#statement
    (#pt-eq
      (#pt-app (#pt-use finite-list ()) Carrier)
      (#pt-project
        quadratic-element
        0
        (#pt-app (#pt-use coordinate-point-ideal-X-class ()) Carrier coefficient-ring root))
      (#pt-construct
        finite-list
        ()
        (Carrier)
        cons
        (
          (#pt-app (#pt-use ring-negate ()) Carrier coefficient-ring root)
          (#pt-construct
            finite-list
            ()
            (Carrier)
            cons
            (
              (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
              (#pt-construct finite-list () (Carrier) nil ())))))))
  (#proof
    (#pt-refl
      (#pt-app (#pt-use finite-list ()) Carrier)
      (#pt-construct
        finite-list
        ()
        (Carrier)
        cons
        (
          (#pt-app (#pt-use ring-negate ()) Carrier coefficient-ring root)
          (#pt-construct
            finite-list
            ()
            (Carrier)
            cons
            (
              (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
              (#pt-construct finite-list () (Carrier) nil ()))))))))
