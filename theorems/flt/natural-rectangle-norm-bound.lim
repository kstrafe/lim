; Exact rectangular norm estimate for the Eisenstein Euclidean step.
; n+a*b=a*a+b*b with a,b<d implies n<d*d. Ordered coordinates
; give the actual gap between n and the larger coordinate square;
; constructive trichotomy handles both orientations and equality.
(#alias add = ./../fermat_statement.lim::add)
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#alias natural-trichotomy = ./natural-discrete-order.lim::natural-trichotomy)
(#alias square-strict-monotone = ./natural-square-order.lim::square-strict-monotone)
(#alias less-than-lower-addend = ./natural-descent-bounds.lim::less-than-lower-addend)
(#alias multiply-add-right = ./natural-multiplication-order.lim::multiply-add-right)
(#alias multiply-commutative = ./natural-multiplication-commutative.lim::multiply-commutative)
(#alias add-left-commutative = ./natural-multiplication-commutative.lim::add-left-commutative)
(#alias add-cancel-left = ./natural-cancellation.lim::add-cancel-left)
(#alias add-zero-right = ./natural-addition.lim::add-zero-right)
(#alias add-commutative = ./natural-addition.lim::add-commutative)
(#alias add-successor-right = ./natural-addition.lim::add-successor-right)
(#alias congruence = ./equality.lim::congruence)
(#alias symmetry = ./equality.lim::symmetry)
(#alias transitivity = ./equality.lim::transitivity)
(#alias substitution = ./equality.lim::substitution)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#theorem natural-square-budget-gap
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter gap #pt-nat)
    (#parameter norm #pt-nat)
    (#parameter square-budget (#pt-eq #pt-nat (#pt-app (#pt-use add ()) norm (#pt-app (#pt-use multiply ()) first (#pt-app (#pt-use add ()) first gap))) (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) first first) (#pt-app (#pt-use multiply ()) (#pt-app (#pt-use add ()) first gap) (#pt-app (#pt-use add ()) first gap))))))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-app (#pt-use add ()) norm (#pt-app (#pt-use multiply ()) first gap))
      (#pt-app
        (#pt-use multiply ())
        (#pt-app (#pt-use add ()) first gap)
        (#pt-app (#pt-use add ()) first gap))))
  (#proof
    (#pt-app
      (#pt-use add-cancel-left ())
      (#pt-app (#pt-use multiply ()) first first)
      (#pt-app (#pt-use add ()) norm (#pt-app (#pt-use multiply ()) first gap))
      (#pt-app
        (#pt-use multiply ())
        (#pt-app (#pt-use add ()) first gap)
        (#pt-app (#pt-use add ()) first gap))
      (#pt-app
        (#pt-use transitivity (0))
        #pt-nat
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use multiply ()) first first)
          (#pt-app (#pt-use add ()) norm (#pt-app (#pt-use multiply ()) first gap)))
        (#pt-app
          (#pt-use add ())
          norm
          (#pt-app (#pt-use multiply ()) first (#pt-app (#pt-use add ()) first gap)))
        (#pt-app
          (#pt-use add ())
          (#pt-app (#pt-use multiply ()) first first)
          (#pt-app
            (#pt-use multiply ())
            (#pt-app (#pt-use add ()) first gap)
            (#pt-app (#pt-use add ()) first gap)))
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          (#pt-app
            (#pt-use add ())
            norm
            (#pt-app (#pt-use multiply ()) first (#pt-app (#pt-use add ()) first gap)))
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use multiply ()) first first)
            (#pt-app (#pt-use add ()) norm (#pt-app (#pt-use multiply ()) first gap)))
          (#pt-app
            (#pt-use transitivity (0))
            #pt-nat
            (#pt-app
              (#pt-use add ())
              norm
              (#pt-app (#pt-use multiply ()) first (#pt-app (#pt-use add ()) first gap)))
            (#pt-app
              (#pt-use add ())
              norm
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) first first)
                (#pt-app (#pt-use multiply ()) first gap)))
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use multiply ()) first first)
              (#pt-app (#pt-use add ()) norm (#pt-app (#pt-use multiply ()) first gap)))
            (#pt-app
              (#pt-use congruence (0 0))
              #pt-nat
              #pt-nat
              (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use add ()) norm endpoint))
              (#pt-app (#pt-use multiply ()) first (#pt-app (#pt-use add ()) first gap))
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) first first)
                (#pt-app (#pt-use multiply ()) first gap))
              (#pt-app (#pt-use multiply-add-right ()) first first gap))
            (#pt-app
              (#pt-use add-left-commutative ())
              norm
              (#pt-app (#pt-use multiply ()) first first)
              (#pt-app (#pt-use multiply ()) first gap))))
        square-budget))))
(#theorem natural-square-budget-ordered-bound
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter gap #pt-nat)
    (#parameter norm #pt-nat)
    (#parameter bound #pt-nat)
    (#parameter ordered-position (#pt-eq #pt-nat second (#pt-app (#pt-use add ()) first gap)))
    (#parameter square-budget (#pt-eq #pt-nat (#pt-app (#pt-use add ()) norm (#pt-app (#pt-use multiply ()) first second)) (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) first first) (#pt-app (#pt-use multiply ()) second second))))
    (#parameter second-bound (#pt-app (#pt-use less-than ()) second bound)))
  (#statement (#pt-app (#pt-use less-than ()) norm (#pt-app (#pt-use multiply ()) bound bound)))
  (#proof
    (#pt-app
      (#pt-use less-than-lower-addend ())
      norm
      (#pt-app (#pt-use multiply ()) first gap)
      (#pt-app (#pt-use multiply ()) bound bound)
      (#pt-app
        (#pt-use substitution (0))
        #pt-nat
        (#pt-lambda
          ((endpoint #pt-nat))
          (#pt-app (#pt-use less-than ()) endpoint (#pt-app (#pt-use multiply ()) bound bound)))
        (#pt-app (#pt-use multiply ()) second second)
        (#pt-app (#pt-use add ()) norm (#pt-app (#pt-use multiply ()) first gap))
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          (#pt-app (#pt-use add ()) norm (#pt-app (#pt-use multiply ()) first gap))
          (#pt-app (#pt-use multiply ()) second second)
          (#pt-app
            (#pt-use substitution (0))
            #pt-nat
            (#pt-lambda
              ((endpoint #pt-nat))
              (#pt-eq
                #pt-nat
                (#pt-app (#pt-use add ()) norm (#pt-app (#pt-use multiply ()) first gap))
                (#pt-app (#pt-use multiply ()) endpoint endpoint)))
            (#pt-app (#pt-use add ()) first gap)
            second
            (#pt-app
              (#pt-use symmetry (0))
              #pt-nat
              second
              (#pt-app (#pt-use add ()) first gap)
              ordered-position)
            (#pt-app
              (#pt-use natural-square-budget-gap ())
              first
              gap
              norm
              (#pt-app
                (#pt-use substitution (0))
                #pt-nat
                (#pt-lambda
                  ((endpoint #pt-nat))
                  (#pt-eq
                    #pt-nat
                    (#pt-app (#pt-use add ()) norm (#pt-app (#pt-use multiply ()) first endpoint))
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use multiply ()) first first)
                      (#pt-app (#pt-use multiply ()) endpoint endpoint))))
                second
                (#pt-app (#pt-use add ()) first gap)
                ordered-position
                square-budget))))
        (#pt-app (#pt-use square-strict-monotone ()) second bound second-bound)))))
(#theorem natural-rectangle-square-budget-bound
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat)
    (#parameter norm #pt-nat)
    (#parameter bound #pt-nat)
    (#parameter square-budget (#pt-eq #pt-nat (#pt-app (#pt-use add ()) norm (#pt-app (#pt-use multiply ()) first second)) (#pt-app (#pt-use add ()) (#pt-app (#pt-use multiply ()) first first) (#pt-app (#pt-use multiply ()) second second))))
    (#parameter first-bound (#pt-app (#pt-use less-than ()) first bound))
    (#parameter second-bound (#pt-app (#pt-use less-than ()) second bound)))
  (#statement (#pt-app (#pt-use less-than ()) norm (#pt-app (#pt-use multiply ()) bound bound)))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use less-than ()) first second)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-eq #pt-nat first second)
        (#pt-app (#pt-use less-than ()) second first))
      (#pt-app (#pt-use less-than ()) norm (#pt-app (#pt-use multiply ()) bound bound))
      (#pt-lambda
        ((first-below-second (#pt-app (#pt-use less-than ()) first second)))
        (#pt-induct
          exists
          (0)
          (#pt-nat
            (#pt-lambda
              ((candidate-gap #pt-nat))
              (#pt-eq #pt-nat second (#pt-app (#pt-use add ()) (#pt-succ first) candidate-gap))))
          (#pt-lambda
            (
              (certificate
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((candidate-gap #pt-nat))
                    (#pt-eq
                      #pt-nat
                      second
                      (#pt-app (#pt-use add ()) (#pt-succ first) candidate-gap))))))
            (#pt-app (#pt-use less-than ()) norm (#pt-app (#pt-use multiply ()) bound bound)))
          (
            (#pt-lambda
              (
                (order-gap #pt-nat)
                (order-position
                  (#pt-eq #pt-nat second (#pt-app (#pt-use add ()) (#pt-succ first) order-gap))))
              (#pt-app
                (#pt-use natural-square-budget-ordered-bound ())
                first
                second
                (#pt-succ order-gap)
                norm
                bound
                (#pt-app
                  (#pt-use transitivity (0))
                  #pt-nat
                  second
                  (#pt-app (#pt-use add ()) (#pt-succ first) order-gap)
                  (#pt-app (#pt-use add ()) first (#pt-succ order-gap))
                  order-position
                  (#pt-app
                    (#pt-use symmetry (0))
                    #pt-nat
                    (#pt-app (#pt-use add ()) first (#pt-succ order-gap))
                    (#pt-app (#pt-use add ()) (#pt-succ first) order-gap)
                    (#pt-app (#pt-use add-successor-right ()) first order-gap)))
                square-budget
                second-bound)))
          first-below-second))
      (#pt-lambda
        (
          (equal-or-reverse
            (#pt-app
              (#pt-use disjunction ())
              (#pt-eq #pt-nat first second)
              (#pt-app (#pt-use less-than ()) second first))))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-eq #pt-nat first second)
          (#pt-app (#pt-use less-than ()) second first)
          (#pt-app (#pt-use less-than ()) norm (#pt-app (#pt-use multiply ()) bound bound))
          (#pt-lambda
            ((equal-coordinates (#pt-eq #pt-nat first second)))
            (#pt-app
              (#pt-use natural-square-budget-ordered-bound ())
              first
              second
              #pt-zero
              norm
              bound
              (#pt-app
                (#pt-use transitivity (0))
                #pt-nat
                second
                first
                (#pt-app (#pt-use add ()) first #pt-zero)
                (#pt-app (#pt-use symmetry (0)) #pt-nat first second equal-coordinates)
                (#pt-app
                  (#pt-use symmetry (0))
                  #pt-nat
                  (#pt-app (#pt-use add ()) first #pt-zero)
                  first
                  (#pt-app (#pt-use add-zero-right ()) first)))
              square-budget
              second-bound))
          (#pt-lambda
            ((second-below-first (#pt-app (#pt-use less-than ()) second first)))
            (#pt-induct
              exists
              (0)
              (#pt-nat
                (#pt-lambda
                  ((candidate-gap #pt-nat))
                  (#pt-eq #pt-nat first (#pt-app (#pt-use add ()) (#pt-succ second) candidate-gap))))
              (#pt-lambda
                (
                  (certificate
                    (#pt-app
                      (#pt-use exists (0))
                      #pt-nat
                      (#pt-lambda
                        ((candidate-gap #pt-nat))
                        (#pt-eq
                          #pt-nat
                          first
                          (#pt-app (#pt-use add ()) (#pt-succ second) candidate-gap))))))
                (#pt-app (#pt-use less-than ()) norm (#pt-app (#pt-use multiply ()) bound bound)))
              (
                (#pt-lambda
                  (
                    (order-gap #pt-nat)
                    (order-position
                      (#pt-eq #pt-nat first (#pt-app (#pt-use add ()) (#pt-succ second) order-gap))))
                  (#pt-app
                    (#pt-use natural-square-budget-ordered-bound ())
                    second
                    first
                    (#pt-succ order-gap)
                    norm
                    bound
                    (#pt-app
                      (#pt-use transitivity (0))
                      #pt-nat
                      first
                      (#pt-app (#pt-use add ()) (#pt-succ second) order-gap)
                      (#pt-app (#pt-use add ()) second (#pt-succ order-gap))
                      order-position
                      (#pt-app
                        (#pt-use symmetry (0))
                        #pt-nat
                        (#pt-app (#pt-use add ()) second (#pt-succ order-gap))
                        (#pt-app (#pt-use add ()) (#pt-succ second) order-gap)
                        (#pt-app (#pt-use add-successor-right ()) second order-gap)))
                    (#pt-app
                      (#pt-use transitivity (0))
                      #pt-nat
                      (#pt-app (#pt-use add ()) norm (#pt-app (#pt-use multiply ()) second first))
                      (#pt-app (#pt-use add ()) norm (#pt-app (#pt-use multiply ()) first second))
                      (#pt-app
                        (#pt-use add ())
                        (#pt-app (#pt-use multiply ()) second second)
                        (#pt-app (#pt-use multiply ()) first first))
                      (#pt-app
                        (#pt-use congruence (0 0))
                        #pt-nat
                        #pt-nat
                        (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use add ()) norm endpoint))
                        (#pt-app (#pt-use multiply ()) second first)
                        (#pt-app (#pt-use multiply ()) first second)
                        (#pt-app (#pt-use multiply-commutative ()) second first))
                      (#pt-app
                        (#pt-use transitivity (0))
                        #pt-nat
                        (#pt-app (#pt-use add ()) norm (#pt-app (#pt-use multiply ()) first second))
                        (#pt-app
                          (#pt-use add ())
                          (#pt-app (#pt-use multiply ()) first first)
                          (#pt-app (#pt-use multiply ()) second second))
                        (#pt-app
                          (#pt-use add ())
                          (#pt-app (#pt-use multiply ()) second second)
                          (#pt-app (#pt-use multiply ()) first first))
                        square-budget
                        (#pt-app
                          (#pt-use add-commutative ())
                          (#pt-app (#pt-use multiply ()) first first)
                          (#pt-app (#pt-use multiply ()) second second))))
                    first-bound)))
              second-below-first))
          equal-or-reverse))
      (#pt-app (#pt-use natural-trichotomy ()) first second))))
