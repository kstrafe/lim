              (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) endpoint)
              primary-residual)))
        primary-order
        (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 3) predecessor))
        (#pt-app
          (#pt-use natural-cubic-balance-predecessor-order ())
          primary-order
          third-order
          predecessor
          orders-balance
          predecessor-equation)
        primary-equation)
      omega-equation
      square-equation
      primary-cube-equation
      omega-cube-equation
      square-cube-equation
      inverse-certificate)))
