(#theorem natural-cubic-balance-predecessor-order
  (#universes)
  (#parameters
    (#parameter primary-order #pt-nat)
    (#parameter third-order #pt-nat)
    (#parameter predecessor #pt-nat)
    (#parameter orders-balance (#pt-eq #pt-nat (#pt-app (#pt-use add ()) (#pt-app (#pt-use add ()) primary-order (#pt-succ #pt-zero)) (#pt-succ #pt-zero)) (#pt-app (#pt-use multiply ()) (#pt-numeral 3) third-order)))
    (#parameter predecessor-equation (#pt-eq #pt-nat third-order (#pt-succ predecessor))))
  (#statement
    (#pt-eq
      #pt-nat
      primary-order
      (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 3) predecessor))))
  (#proof
    (#pt-app
      (#pt-use add-cancel-right ())
      primary-order
      (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 3) predecessor))
      (#pt-succ #pt-zero)
      (#pt-app
        (#pt-use add-cancel-right ())
        (#pt-app (#pt-use add ()) primary-order (#pt-succ #pt-zero))
        (#pt-app
          (#pt-use add ())
          (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 3) predecessor))
          (#pt-succ #pt-zero))
        (#pt-succ #pt-zero)
        (#pt-app
          (#pt-use transitivity (0))
          #pt-nat
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use add ()) primary-order (#pt-succ #pt-zero))
            (#pt-succ #pt-zero))
          (#pt-app
            (#pt-use add ())
            (#pt-app (#pt-use multiply ()) (#pt-numeral 3) predecessor)
            (#pt-numeral 3))
          (#pt-app
            (#pt-use add ())
            (#pt-app
              (#pt-use add ())
              (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 3) predecessor))
              (#pt-succ #pt-zero))
            (#pt-succ #pt-zero))
          (#pt-app
            (#pt-use transitivity (0))
            #pt-nat
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use add ()) primary-order (#pt-succ #pt-zero))
              (#pt-succ #pt-zero))
            (#pt-app (#pt-use multiply ()) (#pt-numeral 3) third-order)
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use multiply ()) (#pt-numeral 3) predecessor)
              (#pt-numeral 3))
            orders-balance
            (#pt-app
              (#pt-use transitivity (0))
              #pt-nat
              (#pt-app (#pt-use multiply ()) (#pt-numeral 3) third-order)
              (#pt-app (#pt-use multiply ()) (#pt-numeral 3) (#pt-succ predecessor))
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) (#pt-numeral 3) predecessor)
                (#pt-numeral 3))
              (#pt-app
                (#pt-use congruence (0 0))
                #pt-nat
                #pt-nat
                (#pt-lambda
                  ((endpoint #pt-nat))
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 3) endpoint))
                third-order
                (#pt-succ predecessor)
                predecessor-equation)
              (#pt-app
                (#pt-use transitivity (0))
                #pt-nat
                (#pt-app (#pt-use multiply ()) (#pt-numeral 3) (#pt-succ predecessor))
                (#pt-app
                  (#pt-use multiply ())
                  (#pt-numeral 3)
                  (#pt-app (#pt-use add ()) predecessor (#pt-succ #pt-zero)))
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 3) predecessor)
                  (#pt-numeral 3))
                (#pt-app
                  (#pt-use congruence (0 0))
                  #pt-nat
                  #pt-nat
                  (#pt-lambda
                    ((endpoint #pt-nat))
                    (#pt-app (#pt-use multiply ()) (#pt-numeral 3) endpoint))
                  (#pt-succ predecessor)
                  (#pt-app (#pt-use add ()) predecessor (#pt-succ #pt-zero))
                  (#pt-app
                    (#pt-use symmetry (0))
                    #pt-nat
                    (#pt-app (#pt-use add ()) predecessor (#pt-succ #pt-zero))
                    (#pt-succ predecessor)
                    (#pt-app
                      (#pt-use transitivity (0))
                      #pt-nat
                      (#pt-app (#pt-use add ()) predecessor (#pt-succ #pt-zero))
                      (#pt-succ (#pt-app (#pt-use add ()) predecessor #pt-zero))
                      (#pt-succ predecessor)
                      (#pt-app (#pt-use add-successor-right ()) predecessor #pt-zero)
                      (#pt-app
                        (#pt-use congruence (0 0))
                        #pt-nat
                        #pt-nat
                        (#pt-lambda ((endpoint #pt-nat)) (#pt-succ endpoint))
                        (#pt-app (#pt-use add ()) predecessor #pt-zero)
                        predecessor
                        (#pt-app (#pt-use add-zero-right ()) predecessor)))))
                (#pt-app
                  (#pt-use multiply-add-right ())
                  (#pt-numeral 3)
                  predecessor
                  (#pt-succ #pt-zero)))))
          (#pt-app
            (#pt-use symmetry (0))
            #pt-nat
            (#pt-app
              (#pt-use add ())
              (#pt-app
                (#pt-use add ())
                (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 3) predecessor))
                (#pt-succ #pt-zero))
              (#pt-succ #pt-zero))
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use multiply ()) (#pt-numeral 3) predecessor)
              (#pt-numeral 3))
            (#pt-app
              (#pt-use transitivity (0))
              #pt-nat
              (#pt-app
                (#pt-use add ())
                (#pt-app
                  (#pt-use add ())
                  (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 3) predecessor))
                  (#pt-succ #pt-zero))
                (#pt-succ #pt-zero))
              (#pt-app
                (#pt-use add ())
                (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 3) predecessor))
                (#pt-numeral 2))
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) (#pt-numeral 3) predecessor)
                (#pt-numeral 3))
              (#pt-app
                (#pt-use add-associative ())
                (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 3) predecessor))
                (#pt-succ #pt-zero)
                (#pt-succ #pt-zero))
              (#pt-app
                (#pt-use symmetry (0))
                #pt-nat
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 3) predecessor)
                  (#pt-numeral 3))
                (#pt-succ
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use multiply ()) (#pt-numeral 3) predecessor)
                    (#pt-numeral 2)))
                (#pt-app
                  (#pt-use add-successor-right ())
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 3) predecessor)
                  (#pt-numeral 2))))))))))
(#theorem natural-cubic-balance-has-predecessor
  (#universes)
  (#parameters
    (#parameter primary-order #pt-nat)
    (#parameter third-order #pt-nat)
    (#parameter orders-balance (#pt-eq #pt-nat (#pt-app (#pt-use add ()) (#pt-app (#pt-use add ()) primary-order (#pt-succ #pt-zero)) (#pt-succ #pt-zero)) (#pt-app (#pt-use multiply ()) (#pt-numeral 3) third-order))))
  (#statement
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-predecessor #pt-nat))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-eq #pt-nat third-order (#pt-succ candidate-predecessor))
          (#pt-eq
            #pt-nat
            primary-order
            (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 3) candidate-predecessor)))))))
  (#proof
    (#pt-app
      (#pt-nat-induct
        (#pt-lambda
          ((index #pt-nat))
          (#pt-pi
            (
              (candidate-primary #pt-nat)
              (candidate-balance
                (#pt-eq
                  #pt-nat
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use add ()) candidate-primary (#pt-succ #pt-zero))
                    (#pt-succ #pt-zero))
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 3) index))))
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-predecessor #pt-nat))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-eq #pt-nat index (#pt-succ candidate-predecessor))
                  (#pt-eq
                    #pt-nat
                    candidate-primary
                    (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 3) candidate-predecessor))))))))
        (#pt-lambda
          (
            (candidate-primary #pt-nat)
            (candidate-balance
              (#pt-eq
                #pt-nat
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use add ()) candidate-primary (#pt-succ #pt-zero))
                  (#pt-succ #pt-zero))
                (#pt-app (#pt-use multiply ()) (#pt-numeral 3) #pt-zero))))
          (#pt-app
            (#pt-use false-elimination ())
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-predecessor #pt-nat))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-eq #pt-nat #pt-zero (#pt-succ candidate-predecessor))
                  (#pt-eq
                    #pt-nat
                    candidate-primary
                    (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 3) candidate-predecessor))))))
            (#pt-app
              (#pt-use successor-not-zero ())
              (#pt-succ candidate-primary)
              (#pt-app
                (#pt-use transitivity (0))
                #pt-nat
                (#pt-succ (#pt-succ candidate-primary))
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use add ()) candidate-primary (#pt-succ #pt-zero))
                  (#pt-succ #pt-zero))
                #pt-zero
                (#pt-app
                  (#pt-use symmetry (0))
                  #pt-nat
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use add ()) candidate-primary (#pt-succ #pt-zero))
                    (#pt-succ #pt-zero))
                  (#pt-succ (#pt-succ candidate-primary))
                  (#pt-app
                    (#pt-use transitivity (0))
                    #pt-nat
                    (#pt-app
                      (#pt-use add ())
                      (#pt-app (#pt-use add ()) candidate-primary (#pt-succ #pt-zero))
                      (#pt-succ #pt-zero))
                    (#pt-app (#pt-use add ()) (#pt-succ candidate-primary) (#pt-succ #pt-zero))
                    (#pt-succ (#pt-succ candidate-primary))
                    (#pt-app
                      (#pt-use congruence (0 0))
                      #pt-nat
                      #pt-nat
                      (#pt-lambda
                        ((endpoint #pt-nat))
                        (#pt-app (#pt-use add ()) endpoint (#pt-succ #pt-zero)))
                      (#pt-app (#pt-use add ()) candidate-primary (#pt-succ #pt-zero))
                      (#pt-succ candidate-primary)
                      (#pt-app
                        (#pt-use transitivity (0))
                        #pt-nat
                        (#pt-app (#pt-use add ()) candidate-primary (#pt-succ #pt-zero))
                        (#pt-succ (#pt-app (#pt-use add ()) candidate-primary #pt-zero))
                        (#pt-succ candidate-primary)
                        (#pt-app (#pt-use add-successor-right ()) candidate-primary #pt-zero)
                        (#pt-app
                          (#pt-use congruence (0 0))
                          #pt-nat
                          #pt-nat
                          (#pt-lambda ((endpoint #pt-nat)) (#pt-succ endpoint))
                          (#pt-app (#pt-use add ()) candidate-primary #pt-zero)
                          candidate-primary
                          (#pt-app (#pt-use add-zero-right ()) candidate-primary))))
                    (#pt-app
                      (#pt-use congruence (0 0))
                      #pt-nat
                      #pt-nat
                      (#pt-lambda ((endpoint #pt-nat)) (#pt-succ endpoint))
                      (#pt-app (#pt-use add ()) candidate-primary (#pt-succ #pt-zero))
                      (#pt-succ candidate-primary)
                      (#pt-app
                        (#pt-use transitivity (0))
                        #pt-nat
                        (#pt-app (#pt-use add ()) candidate-primary (#pt-succ #pt-zero))
                        (#pt-succ (#pt-app (#pt-use add ()) candidate-primary #pt-zero))
                        (#pt-succ candidate-primary)
                        (#pt-app (#pt-use add-successor-right ()) candidate-primary #pt-zero)
                        (#pt-app
                          (#pt-use congruence (0 0))
                          #pt-nat
                          #pt-nat
                          (#pt-lambda ((endpoint #pt-nat)) (#pt-succ endpoint))
                          (#pt-app (#pt-use add ()) candidate-primary #pt-zero)
                          candidate-primary
                          (#pt-app (#pt-use add-zero-right ()) candidate-primary))))))
                candidate-balance))))
        (#pt-lambda
          (
            (previous-third #pt-nat)
            (previous-result
              (#pt-pi
                (
                  (candidate-primary #pt-nat)
                  (candidate-balance
                    (#pt-eq
                      #pt-nat
                      (#pt-app
                        (#pt-use add ())
                        (#pt-app (#pt-use add ()) candidate-primary (#pt-succ #pt-zero))
                        (#pt-succ #pt-zero))
                      (#pt-app (#pt-use multiply ()) (#pt-numeral 3) previous-third))))
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((candidate-predecessor #pt-nat))
                    (#pt-app
                      (#pt-use conjunction ())
                      (#pt-eq #pt-nat previous-third (#pt-succ candidate-predecessor))
                      (#pt-eq
                        #pt-nat
                        candidate-primary
                        (#pt-succ
                          (#pt-app (#pt-use multiply ()) (#pt-numeral 3) candidate-predecessor))))))))
            (candidate-primary #pt-nat)
            (candidate-balance
              (#pt-eq
                #pt-nat
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use add ()) candidate-primary (#pt-succ #pt-zero))
                  (#pt-succ #pt-zero))
                (#pt-app (#pt-use multiply ()) (#pt-numeral 3) (#pt-succ previous-third)))))
          (#pt-construct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-predecessor #pt-nat))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-eq #pt-nat (#pt-succ previous-third) (#pt-succ candidate-predecessor))
                  (#pt-eq
                    #pt-nat
                    candidate-primary
                    (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 3) candidate-predecessor))))))
            introduce
            (previous-third
              (#pt-app
                (#pt-use conjunction-introduce ())
                (#pt-eq #pt-nat (#pt-succ previous-third) (#pt-succ previous-third))
                (#pt-eq
                  #pt-nat
                  candidate-primary
                  (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 3) previous-third)))
                (#pt-refl #pt-nat (#pt-succ previous-third))
                (#pt-app
                  (#pt-use natural-cubic-balance-predecessor-order ())
                  candidate-primary
                  (#pt-succ previous-third)
                  previous-third
                  candidate-balance
                  (#pt-refl #pt-nat (#pt-succ previous-third)))))))
        third-order)
      primary-order
      orders-balance)))
(#theorem eisenstein-normalized-cubic-from-balanced-factors
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter primary-order #pt-nat)
    (#parameter third-order #pt-nat)
    (#parameter primary-residual (#pt-use eisenstein ()))
    (#parameter omega-residual (#pt-use eisenstein ()))
    (#parameter square-residual (#pt-use eisenstein ()))
    (#parameter primary-root (#pt-use eisenstein ()))
    (#parameter omega-root (#pt-use eisenstein ()))
    (#parameter square-root (#pt-use eisenstein ()))
    (#parameter primary-unit (#pt-use eisenstein ()))
    (#parameter omega-unit (#pt-use eisenstein ()))
    (#parameter square-unit (#pt-use eisenstein ()))
    (#parameter inverse (#pt-use eisenstein ()))
    (#parameter predecessor #pt-nat)
    (#parameter orders-balance (#pt-eq #pt-nat (#pt-app (#pt-use add ()) (#pt-app (#pt-use add ()) primary-order (#pt-succ #pt-zero)) (#pt-succ #pt-zero)) (#pt-app (#pt-use multiply ()) (#pt-numeral 3) third-order)))
    (#parameter primary-equation (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-add ()) first second) (#pt-app (#pt-use eisenstein-multiply ()) (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) primary-order) primary-residual)))
    (#parameter omega-equation (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-add ()) first (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-omega ()) second)) (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) omega-residual)))
    (#parameter square-equation (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-add ()) first (#pt-app (#pt-use eisenstein-multiply ()) (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-omega ()) (#pt-numeral 2)) second)) (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-lambda ()) square-residual)))
    (#parameter primary-cube-equation (#pt-app (#pt-use eisenstein-equal ()) primary-residual (#pt-app (#pt-use eisenstein-multiply ()) primary-unit (#pt-app (#pt-use eisenstein-power ()) primary-root (#pt-numeral 3)))))
    (#parameter omega-cube-equation (#pt-app (#pt-use eisenstein-equal ()) omega-residual (#pt-app (#pt-use eisenstein-multiply ()) omega-unit (#pt-app (#pt-use eisenstein-power ()) omega-root (#pt-numeral 3)))))
    (#parameter square-cube-equation (#pt-app (#pt-use eisenstein-equal ()) square-residual (#pt-app (#pt-use eisenstein-multiply ()) square-unit (#pt-app (#pt-use eisenstein-power ()) square-root (#pt-numeral 3)))))
    (#parameter inverse-certificate (#pt-app (#pt-use conjunction ()) (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-multiply ()) omega-unit inverse) (#pt-use eisenstein-one ())) (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-multiply ()) inverse omega-unit) (#pt-use eisenstein-one ()))))
    (#parameter predecessor-equation (#pt-eq #pt-nat third-order (#pt-succ predecessor))))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app
        (#pt-use eisenstein-add ())
        (#pt-app (#pt-use eisenstein-power ()) omega-root (#pt-numeral 3))
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-multiply ()) (#pt-use eisenstein-omega ()) square-unit)
            inverse)
          (#pt-app (#pt-use eisenstein-power ()) square-root (#pt-numeral 3))))
      (#pt-app
        (#pt-use eisenstein-multiply ())
        (#pt-app
          (#pt-use eisenstein-negate ())
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-omega ()) (#pt-numeral 2))
              primary-unit)
            inverse))
        (#pt-app
          (#pt-use eisenstein-power ())
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) predecessor)
            primary-root)
          (#pt-numeral 3)))))
  (#proof
    (#pt-app
      (#pt-use eisenstein-normalized-cubic-from-factor-equations ())
      first
      second
      predecessor
      primary-residual
      omega-residual
      square-residual
      primary-root
      omega-root
      square-root
      primary-unit
      omega-unit
      square-unit
      inverse
      (#pt-app
        (#pt-use substitution (0))
        #pt-nat
        (#pt-lambda
          ((endpoint #pt-nat))
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app (#pt-use eisenstein-add ()) first second)
            (#pt-app
