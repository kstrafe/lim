(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#math-definition ring-polynomial-domain-prime-residue ()
  (#pt-pi
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (prime-proof (#pt-app (#pt-use prime ()) modulus)))
    (#pt-app
      (#pt-use ring-polynomial-domain-data ())
      (#pt-app (#pt-use finite-residue ()) modulus)
      (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)))
  (#pt-lambda
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (prime-proof (#pt-app (#pt-use prime ()) modulus)))
    (#pt-construct
      ring-polynomial-domain-data
      ()
      (
        (#pt-app (#pt-use finite-residue ()) modulus)
        (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus))
      domain
      (
        (#pt-app (#pt-use finite-prime-one-nonzero ()) modulus positive-modulus prime-proof)
        (#pt-lambda
          (
            (first-coefficient (#pt-app (#pt-use finite-residue ()) modulus))
            (second-coefficient (#pt-app (#pt-use finite-residue ()) modulus))
            (first-nonzero
              (#pt-pi
                (
                  (denied-evidence
                    (#pt-app
                      (#pt-use ring-equal ())
                      (#pt-app (#pt-use finite-residue ()) modulus)
                      (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)
                      first-coefficient
                      (#pt-app
                        (#pt-use ring-zero ())
                        (#pt-app (#pt-use finite-residue ()) modulus)
                        (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)))))
                #pt-false))
            (second-nonzero
              (#pt-pi
                (
                  (denied-evidence
                    (#pt-app
                      (#pt-use ring-equal ())
                      (#pt-app (#pt-use finite-residue ()) modulus)
                      (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)
                      second-coefficient
                      (#pt-app
                        (#pt-use ring-zero ())
                        (#pt-app (#pt-use finite-residue ()) modulus)
                        (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)))))
                #pt-false)))
          (#pt-app
            (#pt-use finite-prime-product-nonzero ())
            modulus
            positive-modulus
            prime-proof
            first-coefficient
            first-nonzero
            second-coefficient
            second-nonzero))))))
(#theorem ring-polynomial-domain-prime-residue-one
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) modulus)))
  (#statement
    (#pt-pi
      (
        (denied-evidence
          (#pt-app
            (#pt-use ring-equal ())
            (#pt-app (#pt-use finite-residue ()) modulus)
            (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)
            (#pt-app
              (#pt-use ring-one ())
              (#pt-app (#pt-use finite-residue ()) modulus)
              (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus))
            (#pt-app
              (#pt-use ring-zero ())
              (#pt-app (#pt-use finite-residue ()) modulus)
              (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)))))
      #pt-false))
  (#proof
    (#pt-app
      (#pt-use ring-polynomial-domain-one-nonzero ())
      (#pt-app (#pt-use finite-residue ()) modulus)
      (#pt-app (#pt-use finite-residue-ring ()) modulus positive-modulus)
