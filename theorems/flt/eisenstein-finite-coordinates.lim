; Every pair with actual natural norm n is equivalent to one of four
; signed coordinate representatives with magnitudes below 4*n+1.
; All magnitude, sign, equivalence and bound witnesses are retained.
; This proves finite coverage, not a finite substitute for FLT.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias exists = ./logic-exists.lim::exists)
(#alias eisenstein-natural-norm = ./eisenstein-norm-defs.lim::eisenstein-natural-norm)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-negative-natural = ./integer-defs.lim::integer-negative-natural)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-magnitude = ./integer-magnitude.lim::integer-magnitude)
(#alias integer-magnitude-exists = ./integer-magnitude.lim::integer-magnitude-exists)
(#alias
  eisenstein-real-coordinate-magnitude-bound
  =
  ./eisenstein-coordinate-search-bound.lim::eisenstein-real-coordinate-magnitude-bound)
(#alias
  eisenstein-omega-coordinate-magnitude-bound
  =
  ./eisenstein-coordinate-search-bound.lim::eisenstein-omega-coordinate-magnitude-bound)
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias less-than = ./natural-order.lim::less-than)
(#alias disjunction-left = ./logical-connectives.lim::disjunction-left)
(#alias disjunction-right = ./logical-connectives.lim::disjunction-right)
(#math-definition eisenstein-coordinate-representatives ()
  (#pt-pi
    ((number (#pt-use eisenstein ())) (real-magnitude #pt-nat) (omega-magnitude #pt-nat))
    #pt-prop)
  (#pt-lambda
    ((number (#pt-use eisenstein ())) (real-magnitude #pt-nat) (omega-magnitude #pt-nat))
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app
        (#pt-use eisenstein-equal ())
        number
        (#pt-construct
          eisenstein
          ()
          ()
          pair
          (
            (#pt-app (#pt-use integer-of-natural ()) real-magnitude)
            (#pt-app (#pt-use integer-of-natural ()) omega-magnitude))))
      (#pt-app
        (#pt-use disjunction ())
        (#pt-app
          (#pt-use eisenstein-equal ())
          number
          (#pt-construct
            eisenstein
            ()
            ()
            pair
            (
              (#pt-app (#pt-use integer-of-natural ()) real-magnitude)
              (#pt-app (#pt-use integer-negative-natural ()) omega-magnitude))))
        (#pt-app
          (#pt-use disjunction ())
          (#pt-app
            (#pt-use eisenstein-equal ())
            number
            (#pt-construct
              eisenstein
              ()
              ()
              pair
              (
                (#pt-app (#pt-use integer-negative-natural ()) real-magnitude)
                (#pt-app (#pt-use integer-of-natural ()) omega-magnitude))))
          (#pt-app
            (#pt-use eisenstein-equal ())
            number
            (#pt-construct
              eisenstein
              ()
              ()
              pair
              (
                (#pt-app (#pt-use integer-negative-natural ()) real-magnitude)
                (#pt-app (#pt-use integer-negative-natural ()) omega-magnitude)))))))))
(#math-definition eisenstein-coordinate-box-witness ()
  (#pt-pi
    (
      (number (#pt-use eisenstein ()))
      (natural-norm #pt-nat)
      (real-magnitude #pt-nat)
      (omega-magnitude #pt-nat))
    #pt-prop)
  (#pt-lambda
    (
      (number (#pt-use eisenstein ()))
      (natural-norm #pt-nat)
      (real-magnitude #pt-nat)
      (omega-magnitude #pt-nat))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app
        (#pt-use less-than ())
        real-magnitude
        (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 4) natural-norm)))
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app
          (#pt-use less-than ())
          omega-magnitude
          (#pt-succ (#pt-app (#pt-use multiply ()) (#pt-numeral 4) natural-norm)))
        (#pt-app
          (#pt-use eisenstein-coordinate-representatives ())
          number
          real-magnitude
          omega-magnitude)))))
(#math-definition eisenstein-has-finite-coordinates ()
  (#pt-pi ((number (#pt-use eisenstein ())) (natural-norm #pt-nat)) #pt-prop)
  (#pt-lambda
    ((number (#pt-use eisenstein ())) (natural-norm #pt-nat))
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-real-magnitude #pt-nat))
        (#pt-app
          (#pt-use exists (0))
          #pt-nat
          (#pt-lambda
            ((candidate-omega-magnitude #pt-nat))
            (#pt-app
              (#pt-use eisenstein-coordinate-box-witness ())
              number
              natural-norm
              candidate-real-magnitude
              candidate-omega-magnitude)))))))
