(#theorem eisenstein-finite-coordinates-exist
  (#universes)
  (#parameters
    (#parameter number (#pt-use eisenstein ()))
    (#parameter natural-norm #pt-nat)
    (#parameter norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) number natural-norm)))
  (#statement (#pt-app (#pt-use eisenstein-has-finite-coordinates ()) number natural-norm))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-magnitude #pt-nat))
          (#pt-app
            (#pt-use integer-magnitude ())
            (#pt-project eisenstein 0 number)
            candidate-magnitude)))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-magnitude #pt-nat))
                (#pt-app
                  (#pt-use integer-magnitude ())
                  (#pt-project eisenstein 0 number)
                  candidate-magnitude)))))
        (#pt-app (#pt-use eisenstein-has-finite-coordinates ()) number natural-norm))
      (
        (#pt-lambda
          (
            (real-magnitude #pt-nat)
            (real-magnitude-proof
              (#pt-app
                (#pt-use integer-magnitude ())
                (#pt-project eisenstein 0 number)
                real-magnitude)))
          (#pt-induct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-magnitude #pt-nat))
                (#pt-app
                  (#pt-use integer-magnitude ())
                  (#pt-project eisenstein 1 number)
                  candidate-magnitude)))
            (#pt-lambda
              (
                (certificate
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((candidate-magnitude #pt-nat))
                      (#pt-app
                        (#pt-use integer-magnitude ())
                        (#pt-project eisenstein 1 number)
                        candidate-magnitude)))))
              (#pt-app (#pt-use eisenstein-has-finite-coordinates ()) number natural-norm))
            (
              (#pt-lambda
                (
                  (omega-magnitude #pt-nat)
                  (omega-magnitude-proof
                    (#pt-app
                      (#pt-use integer-magnitude ())
                      (#pt-project eisenstein 1 number)
                      omega-magnitude)))
                (#pt-construct
                  exists
                  (0)
                  (#pt-nat
                    (#pt-lambda
                      ((candidate-real-magnitude #pt-nat))
                      (#pt-app
                        (#pt-use exists (0))
                        #pt-nat
                        (#pt-lambda
                          ((candidate-omega-magnitude #pt-nat))
                          (#pt-app
                            (#pt-use eisenstein-coordinate-box-witness ())
                            number
                            natural-norm
