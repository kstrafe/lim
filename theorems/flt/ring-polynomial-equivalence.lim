; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean:82-208,409-468.
; Generated by scripts/generate-flt-coordinate-algebra.py; checked native terms.
; Pointwise coefficient equivalence is reflexive, symmetric
; and transitive using the actual coefficient ring relation.
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#alias ring-symmetric = ./commutative-ring-data.lim::ring-symmetric)
(#alias ring-transitive = ./commutative-ring-data.lim::ring-transitive)
(#alias ring-polynomial-coefficient = ./ring-polynomial-data.lim::ring-polynomial-coefficient)
(#alias ring-polynomial-equal = ./ring-polynomial-data.lim::ring-polynomial-equal)
(#theorem ring-polynomial-reflexive
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-equal ())
      Carrier
      coefficient-ring
      first-polynomial
      first-polynomial))
  (#proof
    (#pt-lambda
      ((coefficient-index #pt-nat))
      (#pt-app
        (#pt-use ring-reflexive ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-coefficient ())
          Carrier
          coefficient-ring
          first-polynomial
          coefficient-index)))))
(#theorem ring-polynomial-symmetric
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter second-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter equation (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring first-polynomial second-polynomial)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-equal ())
      Carrier
      coefficient-ring
      second-polynomial
      first-polynomial))
  (#proof
    (#pt-lambda
      ((coefficient-index #pt-nat))
      (#pt-app
        (#pt-use ring-symmetric ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-coefficient ())
          Carrier
          coefficient-ring
          first-polynomial
          coefficient-index)
        (#pt-app
          (#pt-use ring-polynomial-coefficient ())
          Carrier
          coefficient-ring
          second-polynomial
          coefficient-index)
        (#pt-app equation coefficient-index)))))
(#theorem ring-polynomial-transitive
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter second-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter third-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter first-equation (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring first-polynomial second-polynomial))
    (#parameter second-equation (#pt-app (#pt-use ring-polynomial-equal ()) Carrier coefficient-ring second-polynomial third-polynomial)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-equal ())
      Carrier
      coefficient-ring
      first-polynomial
      third-polynomial))
  (#proof
    (#pt-lambda
      ((coefficient-index #pt-nat))
      (#pt-app
        (#pt-use ring-transitive ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-coefficient ())
          Carrier
          coefficient-ring
          first-polynomial
          coefficient-index)
        (#pt-app
          (#pt-use ring-polynomial-coefficient ())
          Carrier
          coefficient-ring
          second-polynomial
          coefficient-index)
        (#pt-app
          (#pt-use ring-polynomial-coefficient ())
          Carrier
          coefficient-ring
          third-polynomial
          coefficient-index)
        (#pt-app first-equation coefficient-index)
        (#pt-app second-equation coefficient-index)))))
