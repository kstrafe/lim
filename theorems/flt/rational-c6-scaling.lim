; Native rational specialization of pinned Mathlib VariableChange.lean.
; Candidate proof terms are checked by Lim; no algebra oracle is used.
; Explicit polynomial proof, with checked auxiliary source chunks.
; Every equation is checked; no arithmetic oracle or admission.
(#alias add = ./../fermat_statement.lim::add)
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias rational = ./rational-defs.lim::rational)
(#alias rational-equal = ./rational-defs.lim::rational-equal)
(#alias rational-of-integer = ./rational-defs.lim::rational-of-integer)
(#alias rational-add = ./rational-defs.lim::rational-add)
(#alias rational-multiply = ./rational-defs.lim::rational-multiply)
(#alias rational-negate = ./rational-defs.lim::rational-negate)
(#alias rational-power = ./rational-defs.lim::rational-power)
(#alias discriminant-step-0134 = ./rational-c6-scaling-part-01.lim::discriminant-step-0134)
(#theorem rational-c6-scaling-polynomial
  (#universes)
  (#parameters
    (#parameter inverse-scale (#pt-use rational ()))
    (#parameter b2 (#pt-use rational ()))
    (#parameter b4 (#pt-use rational ()))
    (#parameter b6 (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-negate ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app (#pt-use rational-power ()) inverse-scale (#pt-numeral 2))
                b2)
              (#pt-numeral 3)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 36)))
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app (#pt-use rational-power ()) inverse-scale (#pt-numeral 2))
                b2))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app (#pt-use rational-power ()) inverse-scale (#pt-numeral 4))
              b4)))
        (#pt-app
          (#pt-use rational-negate ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app
                (#pt-use integer-of-natural ())
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 1))
                  (#pt-numeral 88))))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app (#pt-use rational-power ()) inverse-scale (#pt-numeral 6))
              b6))))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app (#pt-use rational-power ()) inverse-scale (#pt-numeral 6))
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-add ())
            (#pt-app
              (#pt-use rational-negate ())
              (#pt-app (#pt-use rational-power ()) b2 (#pt-numeral 3)))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-multiply ())
                (#pt-app
                  (#pt-use rational-of-integer ())
                  (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 36)))
                b2)
              b4))
          (#pt-app
            (#pt-use rational-negate ())
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-app
                  (#pt-use integer-of-natural ())
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 1))
                    (#pt-numeral 88))))
              b6))))))
  (#proof (#pt-app (#pt-use discriminant-step-0134 ()) inverse-scale b2 b4 b6)))
