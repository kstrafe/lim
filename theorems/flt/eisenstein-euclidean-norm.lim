(#theorem eisenstein-remainder-natural-norm-equation
  (#universes)
  (#parameters
    (#parameter dividend (#pt-use eisenstein ()))
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter quotient (#pt-use eisenstein ()))
    (#parameter divisor-norm #pt-nat)
    (#parameter real-remainder #pt-nat)
    (#parameter omega-remainder #pt-nat)
    (#parameter remainder-norm #pt-nat)
    (#parameter small-norm #pt-nat)
    (#parameter divisor-norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) divisor divisor-norm))
    (#parameter coordinate-certificate (#pt-app (#pt-use eisenstein-coordinate-division-spec ()) (#pt-app (#pt-use eisenstein-multiply ()) dividend (#pt-app (#pt-use eisenstein-conjugate ()) divisor)) divisor-norm quotient real-remainder omega-remainder))
    (#parameter remainder-norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) (#pt-app (#pt-use eisenstein-division-remainder ()) dividend divisor quotient) remainder-norm))
    (#parameter small-norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) (#pt-construct eisenstein () () pair ((#pt-app (#pt-use integer-of-natural ()) real-remainder) (#pt-app (#pt-use integer-of-natural ()) omega-remainder))) small-norm)))
  (#statement
    (#pt-eq #pt-nat (#pt-app (#pt-use multiply ()) remainder-norm divisor-norm) small-norm))
  (#proof
    (#pt-app
      (#pt-use eisenstein-product-natural-norm-equation ())
      (#pt-app (#pt-use eisenstein-division-remainder ()) dividend divisor quotient)
      (#pt-app (#pt-use eisenstein-conjugate ()) divisor)
      (#pt-construct
        eisenstein
        ()
        ()
        pair
        (
          (#pt-app (#pt-use integer-of-natural ()) real-remainder)
          (#pt-app (#pt-use integer-of-natural ()) omega-remainder)))
      remainder-norm
      divisor-norm
      small-norm
      (#pt-app
        (#pt-use eisenstein-remainder-conjugate-from-coordinates ())
        dividend
        divisor
        quotient
        divisor-norm
        real-remainder
        omega-remainder
        divisor-norm-certificate
        coordinate-certificate)
      remainder-norm-certificate
      (#pt-app
        (#pt-use eisenstein-natural-norm-conjugate ())
        divisor
        divisor-norm
        divisor-norm-certificate)
      small-norm-certificate)))
(#theorem eisenstein-remainder-natural-norm-decreases
  (#universes)
  (#parameters
    (#parameter dividend (#pt-use eisenstein ()))
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter quotient (#pt-use eisenstein ()))
    (#parameter divisor-norm #pt-nat)
    (#parameter real-remainder #pt-nat)
    (#parameter omega-remainder #pt-nat)
    (#parameter remainder-norm #pt-nat)
    (#parameter small-norm #pt-nat)
    (#parameter divisor-norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) divisor divisor-norm))
    (#parameter coordinate-certificate (#pt-app (#pt-use eisenstein-coordinate-division-spec ()) (#pt-app (#pt-use eisenstein-multiply ()) dividend (#pt-app (#pt-use eisenstein-conjugate ()) divisor)) divisor-norm quotient real-remainder omega-remainder))
    (#parameter remainder-norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) (#pt-app (#pt-use eisenstein-division-remainder ()) dividend divisor quotient) remainder-norm))
    (#parameter small-norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) (#pt-construct eisenstein () () pair ((#pt-app (#pt-use integer-of-natural ()) real-remainder) (#pt-app (#pt-use integer-of-natural ()) omega-remainder))) small-norm))
    (#parameter divisor-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) divisor (#pt-use eisenstein-zero ())))) #pt-false)))
  (#statement (#pt-app (#pt-use less-than ()) remainder-norm divisor-norm))
  (#proof
    (#pt-app
      (#pt-use natural-multiply-strict-reflect ())
      divisor-norm
      remainder-norm
      divisor-norm
      (#pt-app
        (#pt-use eisenstein-natural-norm-nonzero ())
        divisor
        divisor-norm
        divisor-norm-certificate
        divisor-nonzero)
      (#pt-app
        (#pt-use substitution (0))
        #pt-nat
        (#pt-lambda
          ((endpoint #pt-nat))
          (#pt-app
            (#pt-use less-than ())
            endpoint
            (#pt-app (#pt-use multiply ()) divisor-norm divisor-norm)))
        small-norm
        (#pt-app (#pt-use multiply ()) remainder-norm divisor-norm)
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          (#pt-app (#pt-use multiply ()) remainder-norm divisor-norm)
          small-norm
          (#pt-app
            (#pt-use eisenstein-remainder-natural-norm-equation ())
            dividend
            divisor
            quotient
            divisor-norm
            real-remainder
            omega-remainder
            remainder-norm
            small-norm
            divisor-norm-certificate
            coordinate-certificate
            remainder-norm-certificate
            small-norm-certificate))
        (#pt-app
          (#pt-use eisenstein-natural-coordinate-norm-bound ())
          real-remainder
          omega-remainder
          small-norm
          divisor-norm
          small-norm-certificate
          (#pt-app
            (#pt-use conjunction-left ())
            (#pt-app (#pt-use less-than ()) real-remainder divisor-norm)
            (#pt-app (#pt-use less-than ()) omega-remainder divisor-norm)
            (#pt-app
              (#pt-use conjunction-right ())
              (#pt-app
                (#pt-use eisenstein-equal ())
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  dividend
                  (#pt-app (#pt-use eisenstein-conjugate ()) divisor))
                (#pt-app
                  (#pt-use eisenstein-add ())
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app
                      (#pt-use eisenstein-of-integer ())
                      (#pt-app (#pt-use integer-of-natural ()) divisor-norm))
                    quotient)
                  (#pt-construct
                    eisenstein
                    ()
                    ()
                    pair
                    (
                      (#pt-app (#pt-use integer-of-natural ()) real-remainder)
                      (#pt-app (#pt-use integer-of-natural ()) omega-remainder)))))
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use less-than ()) real-remainder divisor-norm)
                (#pt-app (#pt-use less-than ()) omega-remainder divisor-norm))
              coordinate-certificate))
          (#pt-app
            (#pt-use conjunction-right ())
            (#pt-app (#pt-use less-than ()) real-remainder divisor-norm)
            (#pt-app (#pt-use less-than ()) omega-remainder divisor-norm)
            (#pt-app
              (#pt-use conjunction-right ())
              (#pt-app
                (#pt-use eisenstein-equal ())
                (#pt-app
                  (#pt-use eisenstein-multiply ())
                  dividend
                  (#pt-app (#pt-use eisenstein-conjugate ()) divisor))
                (#pt-app
                  (#pt-use eisenstein-add ())
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-app
                      (#pt-use eisenstein-of-integer ())
                      (#pt-app (#pt-use integer-of-natural ()) divisor-norm))
                    quotient)
                  (#pt-construct
                    eisenstein
                    ()
                    ()
                    pair
                    (
                      (#pt-app (#pt-use integer-of-natural ()) real-remainder)
                      (#pt-app (#pt-use integer-of-natural ()) omega-remainder)))))
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use less-than ()) real-remainder divisor-norm)
                (#pt-app (#pt-use less-than ()) omega-remainder divisor-norm))
              coordinate-certificate)))))))
(#theorem eisenstein-remainder-small-norm-exists
  (#universes)
  (#parameters
    (#parameter dividend (#pt-use eisenstein ()))
    (#parameter divisor (#pt-use eisenstein ()))
    (#parameter quotient (#pt-use eisenstein ()))
    (#parameter divisor-norm #pt-nat)
    (#parameter real-remainder #pt-nat)
    (#parameter omega-remainder #pt-nat)
    (#parameter divisor-norm-certificate (#pt-app (#pt-use eisenstein-natural-norm ()) divisor divisor-norm))
    (#parameter coordinate-certificate (#pt-app (#pt-use eisenstein-coordinate-division-spec ()) (#pt-app (#pt-use eisenstein-multiply ()) dividend (#pt-app (#pt-use eisenstein-conjugate ()) divisor)) divisor-norm quotient real-remainder omega-remainder))
    (#parameter divisor-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) divisor (#pt-use eisenstein-zero ())))) #pt-false)))
  (#statement
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-remainder-norm #pt-nat))
        (#pt-app
          (#pt-use conjunction ())
          (#pt-app
            (#pt-use eisenstein-natural-norm ())
            (#pt-app (#pt-use eisenstein-division-remainder ()) dividend divisor quotient)
            candidate-remainder-norm)
          (#pt-app (#pt-use less-than ()) candidate-remainder-norm divisor-norm)))))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-natural-norm #pt-nat))
          (#pt-app
            (#pt-use eisenstein-natural-norm ())
            (#pt-app (#pt-use eisenstein-division-remainder ()) dividend divisor quotient)
            candidate-natural-norm)))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-natural-norm #pt-nat))
                (#pt-app
                  (#pt-use eisenstein-natural-norm ())
                  (#pt-app (#pt-use eisenstein-division-remainder ()) dividend divisor quotient)
                  candidate-natural-norm)))))
        (#pt-app
          (#pt-use exists (0))
          #pt-nat
          (#pt-lambda
            ((candidate-remainder-norm #pt-nat))
            (#pt-app
              (#pt-use conjunction ())
              (#pt-app
                (#pt-use eisenstein-natural-norm ())
                (#pt-app (#pt-use eisenstein-division-remainder ()) dividend divisor quotient)
                candidate-remainder-norm)
              (#pt-app (#pt-use less-than ()) candidate-remainder-norm divisor-norm)))))
      (
        (#pt-lambda
          (
            (remainder-norm #pt-nat)
            (remainder-norm-certificate
              (#pt-app
                (#pt-use eisenstein-natural-norm ())
                (#pt-app (#pt-use eisenstein-division-remainder ()) dividend divisor quotient)
                remainder-norm)))
          (#pt-induct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-small-norm #pt-nat))
                (#pt-app
                  (#pt-use eisenstein-natural-norm ())
                  (#pt-construct
                    eisenstein
                    ()
                    ()
                    pair
                    (
                      (#pt-app (#pt-use integer-of-natural ()) real-remainder)
                      (#pt-app (#pt-use integer-of-natural ()) omega-remainder)))
                  candidate-small-norm)))
            (#pt-lambda
              (
                (certificate
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((candidate-small-norm #pt-nat))
                      (#pt-app
                        (#pt-use eisenstein-natural-norm ())
                        (#pt-construct
                          eisenstein
                          ()
                          ()
                          pair
                          (
                            (#pt-app (#pt-use integer-of-natural ()) real-remainder)
                            (#pt-app (#pt-use integer-of-natural ()) omega-remainder)))
                        candidate-small-norm)))))
              (#pt-app
                (#pt-use exists (0))
                #pt-nat
                (#pt-lambda
                  ((candidate-remainder-norm #pt-nat))
                  (#pt-app
                    (#pt-use conjunction ())
                    (#pt-app
                      (#pt-use eisenstein-natural-norm ())
                      (#pt-app (#pt-use eisenstein-division-remainder ()) dividend divisor quotient)
                      candidate-remainder-norm)
                    (#pt-app (#pt-use less-than ()) candidate-remainder-norm divisor-norm)))))
            (
              (#pt-lambda
                (
                  (small-norm #pt-nat)
                  (small-norm-certificate
                    (#pt-app
                      (#pt-use eisenstein-natural-norm ())
                      (#pt-construct
                        eisenstein
                        ()
                        ()
                        pair
                        (
                          (#pt-app (#pt-use integer-of-natural ()) real-remainder)
                          (#pt-app (#pt-use integer-of-natural ()) omega-remainder)))
                      small-norm)))
                (#pt-construct
                  exists
                  (0)
                  (#pt-nat
                    (#pt-lambda
                      ((candidate-remainder-norm #pt-nat))
                      (#pt-app
                        (#pt-use conjunction ())
                        (#pt-app
                          (#pt-use eisenstein-natural-norm ())
                          (#pt-app
                            (#pt-use eisenstein-division-remainder ())
                            dividend
                            divisor
                            quotient)
                          candidate-remainder-norm)
                        (#pt-app (#pt-use less-than ()) candidate-remainder-norm divisor-norm))))
                  introduce
                  (remainder-norm
                    (#pt-app
                      (#pt-use conjunction-introduce ())
                      (#pt-app
                        (#pt-use eisenstein-natural-norm ())
                        (#pt-app
                          (#pt-use eisenstein-division-remainder ())
                          dividend
                          divisor
                          quotient)
                        remainder-norm)
                      (#pt-app (#pt-use less-than ()) remainder-norm divisor-norm)
                      remainder-norm-certificate
                      (#pt-app
                        (#pt-use eisenstein-remainder-natural-norm-decreases ())
                        dividend
                        divisor
                        quotient
                        divisor-norm
                        real-remainder
                        omega-remainder
                        remainder-norm
                        small-norm
                        divisor-norm-certificate
                        coordinate-certificate
                        remainder-norm-certificate
                        small-norm-certificate
                        divisor-nonzero))))))
            (#pt-app
              (#pt-use eisenstein-natural-norm-exists ())
              (#pt-construct
                eisenstein
                ()
                ()
                pair
                (
                  (#pt-app (#pt-use integer-of-natural ()) real-remainder)
                  (#pt-app (#pt-use integer-of-natural ()) omega-remainder)))))))
      (#pt-app
        (#pt-use eisenstein-natural-norm-exists ())
        (#pt-app (#pt-use eisenstein-division-remainder ()) dividend divisor quotient)))))
