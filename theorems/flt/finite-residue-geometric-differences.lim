                0
                (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)))
            (#pt-app
              (#pt-use finite-prime-multiply-cancel ())
              modulus
              positive-modulus
              prime-proof
              first-value
              (#pt-lambda
                ((bare-zero (#pt-eq #pt-nat (#pt-project finite-residue 0 first-value) #pt-zero)))
                (#pt-app
                  first-nonzero
                  (#pt-app
                    (#pt-use transitivity (0))
                    #pt-nat
                    (#pt-project finite-residue 0 first-value)
                    #pt-zero
                    (#pt-project
                      finite-residue
                      0
                      (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus))
                    bare-zero
                    (#pt-app
                      (#pt-use symmetry (0))
                      #pt-nat
                      (#pt-project
                        finite-residue
                        0
                        (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus))
                      #pt-zero
                      (#pt-app (#pt-use finite-residue-zero-value ()) modulus positive-modulus)))))
              second-value
              (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)
              (#pt-app
                (#pt-use transitivity (0))
                #pt-nat
                (#pt-project
                  finite-residue
                  0
                  (#pt-app
                    (#pt-use finite-residue-multiply ())
