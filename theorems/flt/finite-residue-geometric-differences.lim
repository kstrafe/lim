(#theorem finite-residue-difference-zero-implies-equal
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter first-value (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second-value (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter difference-zero (#pt-eq #pt-nat (#pt-project finite-residue 0 (#pt-app (#pt-use finite-residue-difference ()) modulus positive-modulus first-value second-value)) (#pt-project finite-residue 0 (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)))))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project finite-residue 0 first-value)
      (#pt-project finite-residue 0 second-value)))
  (#proof
    (#pt-app
      (#pt-use transitivity (0))
      #pt-nat
      (#pt-project finite-residue 0 first-value)
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-residue-add ())
          modulus
          positive-modulus
          (#pt-app
            (#pt-use finite-residue-difference ())
            modulus
            positive-modulus
            first-value
            second-value)
          second-value))
      (#pt-project finite-residue 0 second-value)
      (#pt-app
        (#pt-use symmetry (0))
        #pt-nat
        (#pt-project
          finite-residue
          0
          (#pt-app
            (#pt-use finite-residue-add ())
            modulus
            positive-modulus
            (#pt-app
              (#pt-use finite-residue-difference ())
              modulus
              positive-modulus
              first-value
              second-value)
            second-value))
        (#pt-project finite-residue 0 first-value)
        (#pt-app
          (#pt-use finite-residue-difference-add-denominator ())
          modulus
          positive-modulus
          first-value
          second-value))
      (#pt-app
        (#pt-use transitivity (0))
        #pt-nat
        (#pt-project
          finite-residue
          0
          (#pt-app
            (#pt-use finite-residue-add ())
            modulus
            positive-modulus
            (#pt-app
              (#pt-use finite-residue-difference ())
              modulus
              positive-modulus
              first-value
              second-value)
            second-value))
        (#pt-project
          finite-residue
          0
          (#pt-app
            (#pt-use finite-residue-add ())
            modulus
            positive-modulus
            (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)
            second-value))
        (#pt-project finite-residue 0 second-value)
        (#pt-app
          (#pt-use finite-residue-add-congruent ())
          modulus
          positive-modulus
          (#pt-app
            (#pt-use finite-residue-difference ())
            modulus
            positive-modulus
            first-value
            second-value)
          second-value
          (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)
          second-value
          difference-zero
          (#pt-refl #pt-nat (#pt-project finite-residue 0 second-value)))
        (#pt-app (#pt-use finite-residue-add-zero-left ()) modulus positive-modulus second-value)))))
(#theorem finite-residue-difference-of-unequal-nonzero
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter first-value (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second-value (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter unequal (#pt-pi ((denied-evidence (#pt-eq #pt-nat (#pt-project finite-residue 0 first-value) (#pt-project finite-residue 0 second-value)))) #pt-false)))
  (#statement
    (#pt-pi
      (
        (denied-evidence
          (#pt-eq
            #pt-nat
            (#pt-project
              finite-residue
              0
              (#pt-app
                (#pt-use finite-residue-difference ())
                modulus
                positive-modulus
                first-value
                second-value))
            (#pt-project
              finite-residue
              0
              (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (difference-zero
          (#pt-eq
            #pt-nat
            (#pt-project
              finite-residue
              0
              (#pt-app
                (#pt-use finite-residue-difference ())
                modulus
                positive-modulus
                first-value
                second-value))
            (#pt-project
              finite-residue
              0
              (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)))))
      (#pt-app
        unequal
        (#pt-app
          (#pt-use finite-residue-difference-zero-implies-equal ())
          modulus
          positive-modulus
          first-value
          second-value
          difference-zero)))))
(#theorem finite-prime-zero-product-cases
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter prime-proof (#pt-app (#pt-use prime ()) modulus))
    (#parameter first-value (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second-value (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter product-zero (#pt-eq #pt-nat (#pt-project finite-residue 0 (#pt-app (#pt-use finite-residue-multiply ()) modulus positive-modulus first-value second-value)) (#pt-project finite-residue 0 (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)))))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-eq
        #pt-nat
        (#pt-project finite-residue 0 first-value)
        (#pt-project
          finite-residue
          0
          (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)))
      (#pt-eq
        #pt-nat
        (#pt-project finite-residue 0 second-value)
        (#pt-project
          finite-residue
          0
          (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)))))
  (#proof
    (#pt-induct
      decision
      ()
      (
        (#pt-eq
          #pt-nat
          (#pt-project finite-residue 0 first-value)
          (#pt-project
            finite-residue
            0
            (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus))))
      (#pt-lambda
        (
          (first-zero-decision
            (#pt-app
              (#pt-use decision ())
              (#pt-eq
                #pt-nat
                (#pt-project finite-residue 0 first-value)
                (#pt-project
                  finite-residue
                  0
                  (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus))))))
        (#pt-app
          (#pt-use disjunction ())
          (#pt-eq
            #pt-nat
            (#pt-project finite-residue 0 first-value)
            (#pt-project
              finite-residue
              0
              (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)))
          (#pt-eq
            #pt-nat
            (#pt-project finite-residue 0 second-value)
            (#pt-project
              finite-residue
              0
              (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)))))
      (
        (#pt-lambda
          (
            (first-nonzero
              (#pt-pi
                (
                  (denied-evidence
                    (#pt-eq
                      #pt-nat
                      (#pt-project finite-residue 0 first-value)
                      (#pt-project
                        finite-residue
                        0
                        (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)))))
                #pt-false)))
          (#pt-app
            (#pt-use disjunction-right ())
            (#pt-eq
              #pt-nat
              (#pt-project finite-residue 0 first-value)
