(#math-definition finite-weierstrass-decide-equation ()
  (#pt-pi
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
      (x-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
      (y-coordinate (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-app
      (#pt-use decision ())
      (#pt-app
        (#pt-use finite-weierstrass-equation ())
        modulus
        positive-modulus
        curve
        x-coordinate
        y-coordinate)))
  (#pt-lambda
    (
      (modulus #pt-nat)
      (positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
      (curve (#pt-app (#pt-use finite-weierstrass-curve ()) modulus))
      (x-coordinate (#pt-app (#pt-use finite-residue ()) modulus))
      (y-coordinate (#pt-app (#pt-use finite-residue ()) modulus)))
    (#pt-app
      (#pt-use decide-equality ())
      (#pt-project
        finite-residue
        0
        (#pt-app
          (#pt-use finite-weierstrass-polynomial ())
          modulus
          positive-modulus
          curve
          x-coordinate
          y-coordinate))
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)))))
