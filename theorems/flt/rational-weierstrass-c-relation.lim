  =
  ./rational-weierstrass-four-discriminant.lim::rational-cubic-discriminant4)
(#alias
  rational-c-relation-polynomial
  =
  ./rational-c-relation-polynomial.lim::rational-c-relation-polynomial)
(#theorem rational-weierstrass-c-relation
  (#universes)
  (#parameters
    (#parameter curve (#pt-use rational-weierstrass-curve ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app
            (#pt-use integer-of-natural ())
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 13))
              (#pt-numeral 64))))
        (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve))
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app (#pt-use rational-weierstrass-c4 ()) curve)
          (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-negate ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app (#pt-use rational-weierstrass-c6 ()) curve)
            (#pt-numeral 2))))))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app
            (#pt-use integer-of-natural ())
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 13))
              (#pt-numeral 64))))
        (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve))
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 3))
                (#pt-numeral 48))))
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))))
        (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve))
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app
          (#pt-use rational-power ())
          (#pt-app (#pt-use rational-weierstrass-c4 ()) curve)
          (#pt-numeral 3))
        (#pt-app
          (#pt-use rational-negate ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app (#pt-use rational-weierstrass-c6 ()) curve)
            (#pt-numeral 2))))
      (#pt-app
        (#pt-use rational-multiply-congruent ())
        (#pt-app
          (#pt-use rational-of-integer ())
          (#pt-app
            (#pt-use integer-of-natural ())
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 13))
              (#pt-numeral 64))))
        (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve)
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 3))
                (#pt-numeral 48))))
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))))
        (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve)
        (#pt-app
          (#pt-use rational-symmetric ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app
                (#pt-use integer-of-natural ())
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 3))
                  (#pt-numeral 48))))
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))))
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 13))
                (#pt-numeral 64))))
          (#pt-refl
            #pt-nat
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 13))
              (#pt-numeral 64))))
        (#pt-app
          (#pt-use rational-reflexive ())
          (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve)))
      (#pt-app
        (#pt-use rational-transitive ())
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app
                (#pt-use integer-of-natural ())
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 3))
                  (#pt-numeral 48))))
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))))
          (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve))
        (#pt-app
          (#pt-use rational-multiply ())
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 3))
                (#pt-numeral 48))))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
            (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve)))
        (#pt-app
          (#pt-use rational-add ())
          (#pt-app
            (#pt-use rational-power ())
            (#pt-app (#pt-use rational-weierstrass-c4 ()) curve)
            (#pt-numeral 3))
          (#pt-app
            (#pt-use rational-negate ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-app (#pt-use rational-weierstrass-c6 ()) curve)
              (#pt-numeral 2))))
        (#pt-app
          (#pt-use rational-multiply-associative ())
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app
              (#pt-use integer-of-natural ())
              (#pt-app
                (#pt-use add ())
                (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 3))
                (#pt-numeral 48))))
          (#pt-app
            (#pt-use rational-of-integer ())
            (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
          (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve))
        (#pt-app
          (#pt-use rational-transitive ())
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app
                (#pt-use integer-of-natural ())
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 3))
                  (#pt-numeral 48))))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
              (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve)))
          (#pt-app
            (#pt-use rational-multiply ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app
                (#pt-use integer-of-natural ())
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 3))
                  (#pt-numeral 48))))
            (#pt-app
              (#pt-use rational-cubic-discriminant4 ())
              (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)
              (#pt-app (#pt-use rational-weierstrass-b4 ()) curve)
              (#pt-app (#pt-use rational-weierstrass-b6 ()) curve)))
          (#pt-app
            (#pt-use rational-add ())
            (#pt-app
              (#pt-use rational-power ())
              (#pt-app (#pt-use rational-weierstrass-c4 ()) curve)
              (#pt-numeral 3))
            (#pt-app
              (#pt-use rational-negate ())
              (#pt-app
                (#pt-use rational-power ())
                (#pt-app (#pt-use rational-weierstrass-c6 ()) curve)
                (#pt-numeral 2))))
          (#pt-app
            (#pt-use rational-multiply-congruent ())
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app
                (#pt-use integer-of-natural ())
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 3))
                  (#pt-numeral 48))))
            (#pt-app
              (#pt-use rational-multiply ())
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4)))
              (#pt-app (#pt-use rational-weierstrass-discriminant ()) curve))
            (#pt-app
              (#pt-use rational-of-integer ())
              (#pt-app
                (#pt-use integer-of-natural ())
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 3))
                  (#pt-numeral 48))))
            (#pt-app
              (#pt-use rational-cubic-discriminant4 ())
              (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)
              (#pt-app (#pt-use rational-weierstrass-b4 ()) curve)
              (#pt-app (#pt-use rational-weierstrass-b6 ()) curve))
            (#pt-app
              (#pt-use rational-reflexive ())
              (#pt-app
                (#pt-use rational-of-integer ())
                (#pt-app
                  (#pt-use integer-of-natural ())
                  (#pt-app
                    (#pt-use add ())
                    (#pt-app (#pt-use multiply ()) (#pt-numeral 128) (#pt-numeral 3))
                    (#pt-numeral 48)))))
            (#pt-app (#pt-use rational-weierstrass-four-discriminant ()) curve))
          (#pt-app
            (#pt-use rational-c-relation-polynomial ())
            (#pt-app (#pt-use rational-weierstrass-b2 ()) curve)
            (#pt-app (#pt-use rational-weierstrass-b4 ()) curve)
            (#pt-app (#pt-use rational-weierstrass-b6 ()) curve)))))))
