; Constructive equality decision for arbitrary mathematical naturals.
; Every branch returns checked equality evidence or a checked refutation.
(#alias decision = ./logical-decision.lim::decision)
(#alias decision-map = ./logical-decision.lim::decision-map)
(#alias symmetry = ./equality.lim::symmetry)
(#alias congruence = ./equality.lim::congruence)
(#alias successor-injective = ./natural-successor.lim::successor-injective)
(#alias successor-not-zero = ./natural-nonzero.lim::successor-not-zero)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias decision-evidence = ./decidable-logic.lim::decision-evidence)
(#math-definition decide-equality ()
  (#pt-pi
    ((first #pt-nat) (second #pt-nat))
    (#pt-app (#pt-use decision ()) (#pt-eq #pt-nat first second)))
  (#pt-lambda
    ((first #pt-nat))
    (#pt-nat-induct
      (#pt-lambda
        ((index #pt-nat))
        (#pt-pi
          ((comparison #pt-nat))
          (#pt-app (#pt-use decision ()) (#pt-eq #pt-nat index comparison))))
      (#pt-lambda
        ((second #pt-nat))
        (#pt-nat-induct
          (#pt-lambda
            ((comparison #pt-nat))
            (#pt-app (#pt-use decision ()) (#pt-eq #pt-nat #pt-zero comparison)))
          (#pt-construct
            decision
            ()
            ((#pt-eq #pt-nat #pt-zero #pt-zero))
            yes
            ((#pt-refl #pt-nat #pt-zero)))
          (#pt-lambda
            (
              (previous #pt-nat)
              (unused-decision (#pt-app (#pt-use decision ()) (#pt-eq #pt-nat #pt-zero previous))))
            (#pt-construct
              decision
              ()
              ((#pt-eq #pt-nat #pt-zero (#pt-succ previous)))
              no
              (
                (#pt-lambda
                  ((path (#pt-eq #pt-nat #pt-zero (#pt-succ previous))))
                  (#pt-app
                    (#pt-app (#pt-use successor-not-zero ()) previous)
                    (#pt-app (#pt-use symmetry (0)) #pt-nat #pt-zero (#pt-succ previous) path))))))
          second))
      (#pt-lambda
        (
          (previous #pt-nat)
          (previous-decider
            (#pt-pi
              ((comparison #pt-nat))
              (#pt-app (#pt-use decision ()) (#pt-eq #pt-nat previous comparison))))
          (second #pt-nat))
        (#pt-nat-induct
          (#pt-lambda
            ((comparison #pt-nat))
            (#pt-app (#pt-use decision ()) (#pt-eq #pt-nat (#pt-succ previous) comparison)))
          (#pt-construct
            decision
            ()
            ((#pt-eq #pt-nat (#pt-succ previous) #pt-zero))
            no
            ((#pt-app (#pt-use successor-not-zero ()) previous)))
          (#pt-lambda
            (
              (other-previous #pt-nat)
              (unused-decision
                (#pt-app (#pt-use decision ()) (#pt-eq #pt-nat (#pt-succ previous) other-previous))))
            (#pt-app
              (#pt-use decision-map ())
              (#pt-eq #pt-nat previous other-previous)
              (#pt-eq #pt-nat (#pt-succ previous) (#pt-succ other-previous))
              (#pt-lambda
                ((path (#pt-eq #pt-nat previous other-previous)))
                (#pt-app
                  (#pt-use congruence (0 0))
                  #pt-nat
                  #pt-nat
                  (#pt-lambda ((value #pt-nat)) (#pt-succ value))
                  previous
                  other-previous
                  path))
              (#pt-lambda
                ((path (#pt-eq #pt-nat (#pt-succ previous) (#pt-succ other-previous))))
                (#pt-app (#pt-use successor-injective ()) previous other-previous path))
              (#pt-app previous-decider other-previous)))
          second))
      first)))
(#theorem natural-equality-decided
  (#universes)
  (#parameters
    (#parameter first #pt-nat)
    (#parameter second #pt-nat))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-eq #pt-nat first second)
      (#pt-pi ((equality (#pt-eq #pt-nat first second))) #pt-false)))
  (#proof
    (#pt-app
      (#pt-use decision-evidence ())
      (#pt-eq #pt-nat first second)
      (#pt-app (#pt-use decide-equality ()) first second))))
