; Exhaust all four possible remainders by actual strict bounds.
; Nat induction and the proved three-remainder cases give 0,1,2 or3;
; this is an unbounded lemma about every remainder below four.
(#alias less-than = ./natural-order.lim::less-than)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias congruence = ./equality.lim::congruence)
(#alias disjunction-left = ./logical-connectives.lim::disjunction-left)
(#alias disjunction-right = ./logical-connectives.lim::disjunction-right)
(#alias less-than-three-cases = ./natural-small-remainders.lim::less-than-three-cases)
(#alias successor-less-reflect = ./natural-discrete-order.lim::successor-less-reflect)
(#theorem less-than-four-cases
  (#universes)
  (#parameters
    (#parameter remainder #pt-nat)
    (#parameter given-bound (#pt-app (#pt-use less-than ()) remainder (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero)))))))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-eq #pt-nat remainder #pt-zero)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-eq #pt-nat remainder (#pt-succ #pt-zero))
        (#pt-app
          (#pt-use disjunction ())
          (#pt-eq #pt-nat remainder (#pt-succ (#pt-succ #pt-zero)))
          (#pt-eq #pt-nat remainder (#pt-numeral 3))))))
  (#proof
    (#pt-app
      (#pt-nat-induct
        (#pt-lambda
          ((index #pt-nat))
          (#pt-pi
            (
              (remainder-bound
                (#pt-app
                  (#pt-use less-than ())
                  index
                  (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero)))))))
            (#pt-app
              (#pt-use disjunction ())
              (#pt-eq #pt-nat index #pt-zero)
              (#pt-app
                (#pt-use disjunction ())
                (#pt-eq #pt-nat index (#pt-succ #pt-zero))
                (#pt-app
                  (#pt-use disjunction ())
                  (#pt-eq #pt-nat index (#pt-succ (#pt-succ #pt-zero)))
                  (#pt-eq #pt-nat index (#pt-numeral 3)))))))
        (#pt-lambda
          (
            (initial-bound
              (#pt-app
                (#pt-use less-than ())
                #pt-zero
                (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero)))))))
          (#pt-app
            (#pt-use disjunction-left ())
            (#pt-eq #pt-nat #pt-zero #pt-zero)
            (#pt-app
              (#pt-use disjunction ())
              (#pt-eq #pt-nat #pt-zero (#pt-succ #pt-zero))
              (#pt-app
                (#pt-use disjunction ())
                (#pt-eq #pt-nat #pt-zero (#pt-succ (#pt-succ #pt-zero)))
                (#pt-eq #pt-nat #pt-zero (#pt-numeral 3))))
            (#pt-refl #pt-nat #pt-zero)))
        (#pt-lambda
          (
            (previous-remainder #pt-nat)
            (unused-history
              (#pt-pi
                (
                  (remainder-bound
                    (#pt-app
                      (#pt-use less-than ())
                      previous-remainder
                      (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero)))))))
                (#pt-app
                  (#pt-use disjunction ())
                  (#pt-eq #pt-nat previous-remainder #pt-zero)
                  (#pt-app
                    (#pt-use disjunction ())
                    (#pt-eq #pt-nat previous-remainder (#pt-succ #pt-zero))
                    (#pt-app
                      (#pt-use disjunction ())
                      (#pt-eq #pt-nat previous-remainder (#pt-succ (#pt-succ #pt-zero)))
                      (#pt-eq #pt-nat previous-remainder (#pt-numeral 3)))))))
            (successor-bound
              (#pt-app
                (#pt-use less-than ())
                (#pt-succ previous-remainder)
                (#pt-succ (#pt-succ (#pt-succ (#pt-succ #pt-zero)))))))
          (#pt-app
            (#pt-use disjunction-eliminate ())
            (#pt-eq #pt-nat previous-remainder #pt-zero)
            (#pt-app
              (#pt-use disjunction ())
              (#pt-eq #pt-nat previous-remainder (#pt-succ #pt-zero))
              (#pt-eq #pt-nat previous-remainder (#pt-succ (#pt-succ #pt-zero))))
            (#pt-app
              (#pt-use disjunction ())
              (#pt-eq #pt-nat (#pt-succ previous-remainder) #pt-zero)
              (#pt-app
                (#pt-use disjunction ())
                (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-succ #pt-zero))
                (#pt-app
                  (#pt-use disjunction ())
                  (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-succ (#pt-succ #pt-zero)))
                  (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-numeral 3)))))
            (#pt-lambda
              ((previous-position (#pt-eq #pt-nat previous-remainder #pt-zero)))
              (#pt-app
                (#pt-use disjunction-right ())
                (#pt-eq #pt-nat (#pt-succ previous-remainder) #pt-zero)
                (#pt-app
                  (#pt-use disjunction ())
                  (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-succ #pt-zero))
                  (#pt-app
                    (#pt-use disjunction ())
                    (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-succ (#pt-succ #pt-zero)))
                    (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-numeral 3))))
                (#pt-app
                  (#pt-use disjunction-left ())
                  (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-succ #pt-zero))
                  (#pt-app
                    (#pt-use disjunction ())
                    (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-succ (#pt-succ #pt-zero)))
                    (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-numeral 3)))
                  (#pt-app
                    (#pt-use congruence (0 0))
                    #pt-nat
                    #pt-nat
                    (#pt-lambda ((endpoint #pt-nat)) (#pt-succ endpoint))
                    previous-remainder
                    #pt-zero
                    previous-position))))
            (#pt-lambda
              (
                (remaining-cases
                  (#pt-app
                    (#pt-use disjunction ())
                    (#pt-eq #pt-nat previous-remainder (#pt-succ #pt-zero))
                    (#pt-eq #pt-nat previous-remainder (#pt-succ (#pt-succ #pt-zero))))))
              (#pt-app
                (#pt-use disjunction-eliminate ())
                (#pt-eq #pt-nat previous-remainder (#pt-succ #pt-zero))
                (#pt-eq #pt-nat previous-remainder (#pt-succ (#pt-succ #pt-zero)))
                (#pt-app
                  (#pt-use disjunction ())
                  (#pt-eq #pt-nat (#pt-succ previous-remainder) #pt-zero)
                  (#pt-app
                    (#pt-use disjunction ())
                    (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-succ #pt-zero))
                    (#pt-app
                      (#pt-use disjunction ())
                      (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-succ (#pt-succ #pt-zero)))
                      (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-numeral 3)))))
                (#pt-lambda
                  ((previous-position (#pt-eq #pt-nat previous-remainder (#pt-succ #pt-zero))))
                  (#pt-app
                    (#pt-use disjunction-right ())
                    (#pt-eq #pt-nat (#pt-succ previous-remainder) #pt-zero)
                    (#pt-app
                      (#pt-use disjunction ())
                      (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-succ #pt-zero))
                      (#pt-app
                        (#pt-use disjunction ())
                        (#pt-eq
                          #pt-nat
                          (#pt-succ previous-remainder)
                          (#pt-succ (#pt-succ #pt-zero)))
                        (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-numeral 3))))
                    (#pt-app
                      (#pt-use disjunction-right ())
                      (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-succ #pt-zero))
                      (#pt-app
                        (#pt-use disjunction ())
                        (#pt-eq
                          #pt-nat
                          (#pt-succ previous-remainder)
                          (#pt-succ (#pt-succ #pt-zero)))
                        (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-numeral 3)))
                      (#pt-app
                        (#pt-use disjunction-left ())
                        (#pt-eq
                          #pt-nat
                          (#pt-succ previous-remainder)
                          (#pt-succ (#pt-succ #pt-zero)))
                        (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-numeral 3))
                        (#pt-app
                          (#pt-use congruence (0 0))
                          #pt-nat
                          #pt-nat
                          (#pt-lambda ((endpoint #pt-nat)) (#pt-succ endpoint))
                          previous-remainder
                          (#pt-succ #pt-zero)
                          previous-position)))))
                (#pt-lambda
                  (
                    (previous-position
                      (#pt-eq #pt-nat previous-remainder (#pt-succ (#pt-succ #pt-zero)))))
                  (#pt-app
                    (#pt-use disjunction-right ())
                    (#pt-eq #pt-nat (#pt-succ previous-remainder) #pt-zero)
                    (#pt-app
                      (#pt-use disjunction ())
                      (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-succ #pt-zero))
                      (#pt-app
                        (#pt-use disjunction ())
                        (#pt-eq
                          #pt-nat
                          (#pt-succ previous-remainder)
                          (#pt-succ (#pt-succ #pt-zero)))
                        (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-numeral 3))))
                    (#pt-app
                      (#pt-use disjunction-right ())
                      (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-succ #pt-zero))
                      (#pt-app
                        (#pt-use disjunction ())
                        (#pt-eq
                          #pt-nat
                          (#pt-succ previous-remainder)
                          (#pt-succ (#pt-succ #pt-zero)))
                        (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-numeral 3)))
                      (#pt-app
                        (#pt-use disjunction-right ())
                        (#pt-eq
                          #pt-nat
                          (#pt-succ previous-remainder)
                          (#pt-succ (#pt-succ #pt-zero)))
                        (#pt-eq #pt-nat (#pt-succ previous-remainder) (#pt-numeral 3))
                        (#pt-app
                          (#pt-use congruence (0 0))
                          #pt-nat
                          #pt-nat
                          (#pt-lambda ((endpoint #pt-nat)) (#pt-succ endpoint))
                          previous-remainder
                          (#pt-succ (#pt-succ #pt-zero))
                          previous-position)))))
                remaining-cases))
            (#pt-app
              (#pt-use less-than-three-cases ())
              previous-remainder
              (#pt-app
                (#pt-use successor-less-reflect ())
                previous-remainder
                (#pt-numeral 3)
                successor-bound))))
        remainder)
      given-bound)))
