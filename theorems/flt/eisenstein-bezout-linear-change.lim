; Constructive Bezout transport. A checked change of coordinates
; transforms the actual two coefficients. Unit shifts use the actual
; inverse witness, without a PID, prime-factor or coprimality oracle.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias eisenstein-unit = ./eisenstein-defs.lim::eisenstein-unit)
(#alias eisenstein-reflexive = ./eisenstein-equality.lim::eisenstein-reflexive)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-congruent = ./eisenstein-equality.lim::eisenstein-multiply-congruent)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias exists = ./logic-exists.lim::exists)
(#alias eisenstein-add = ./eisenstein-defs.lim::eisenstein-add)
(#alias eisenstein-negate = ./eisenstein-defs.lim::eisenstein-negate)
(#alias eisenstein-coprime = ./eisenstein-defs.lim::eisenstein-coprime)
(#alias eisenstein-add-congruent = ./eisenstein-equality.lim::eisenstein-add-congruent)
(#alias
  eisenstein-bezout-linear-expansion
  =
  ./eisenstein-bezout-linear-expansion.lim::eisenstein-bezout-linear-expansion)
(#alias
  eisenstein-inverse-linear-second
  =
  ./eisenstein-bezout-linear-algebra.lim::eisenstein-inverse-linear-second)
(#alias
  eisenstein-linear-complement
  =
  ./eisenstein-bezout-linear-algebra.lim::eisenstein-linear-complement)
(#theorem eisenstein-coprime-linear-change
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter x (#pt-use eisenstein ()))
    (#parameter y (#pt-use eisenstein ()))
    (#parameter first-x (#pt-use eisenstein ()))
    (#parameter first-y (#pt-use eisenstein ()))
    (#parameter second-x (#pt-use eisenstein ()))
    (#parameter second-y (#pt-use eisenstein ()))
    (#parameter first-equivalence (#pt-app (#pt-use eisenstein-equal ()) first (#pt-app (#pt-use eisenstein-add ()) (#pt-app (#pt-use eisenstein-multiply ()) first-x x) (#pt-app (#pt-use eisenstein-multiply ()) first-y y))))
    (#parameter second-equivalence (#pt-app (#pt-use eisenstein-equal ()) second (#pt-app (#pt-use eisenstein-add ()) (#pt-app (#pt-use eisenstein-multiply ()) second-x x) (#pt-app (#pt-use eisenstein-multiply ()) second-y y))))
    (#parameter coprime-proof (#pt-app (#pt-use eisenstein-coprime ()) first second)))
  (#statement (#pt-app (#pt-use eisenstein-coprime ()) x y))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-left (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use exists (0))
            (#pt-use eisenstein ())
            (#pt-lambda
              ((candidate-right (#pt-use eisenstein ())))
              (#pt-app
                (#pt-use eisenstein-equal ())
                (#pt-use eisenstein-one ())
                (#pt-app
                  (#pt-use eisenstein-add ())
                  (#pt-app (#pt-use eisenstein-multiply ()) candidate-left first)
                  (#pt-app (#pt-use eisenstein-multiply ()) candidate-right second)))))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-left (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use exists (0))
                  (#pt-use eisenstein ())
                  (#pt-lambda
                    ((candidate-right (#pt-use eisenstein ())))
                    (#pt-app
                      (#pt-use eisenstein-equal ())
                      (#pt-use eisenstein-one ())
                      (#pt-app
                        (#pt-use eisenstein-add ())
                        (#pt-app (#pt-use eisenstein-multiply ()) candidate-left first)
                        (#pt-app (#pt-use eisenstein-multiply ()) candidate-right second)))))))))
        (#pt-app (#pt-use eisenstein-coprime ()) x y))
      (
        (#pt-lambda
          (
            (left-coefficient (#pt-use eisenstein ()))
            (right-certificate
              (#pt-app
                (#pt-use exists (0))
                (#pt-use eisenstein ())
                (#pt-lambda
                  ((candidate-right (#pt-use eisenstein ())))
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-use eisenstein-one ())
                    (#pt-app
                      (#pt-use eisenstein-add ())
                      (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first)
                      (#pt-app (#pt-use eisenstein-multiply ()) candidate-right second)))))))
          (#pt-induct
            exists
            (0)
            (
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-right (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-use eisenstein-one ())
                  (#pt-app
                    (#pt-use eisenstein-add ())
                    (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first)
                    (#pt-app (#pt-use eisenstein-multiply ()) candidate-right second)))))
            (#pt-lambda
              (
                (eisenstein-certificate
                  (#pt-app
                    (#pt-use exists (0))
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-right (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use eisenstein-equal ())
                        (#pt-use eisenstein-one ())
                        (#pt-app
                          (#pt-use eisenstein-add ())
                          (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first)
                          (#pt-app (#pt-use eisenstein-multiply ()) candidate-right second)))))))
              (#pt-app (#pt-use eisenstein-coprime ()) x y))
            (
              (#pt-lambda
                (
                  (right-coefficient (#pt-use eisenstein ()))
                  (bezout-equation
                    (#pt-app
                      (#pt-use eisenstein-equal ())
                      (#pt-use eisenstein-one ())
                      (#pt-app
                        (#pt-use eisenstein-add ())
                        (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first)
                        (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient second)))))
                (#pt-construct
                  exists
                  (0)
                  (
                    (#pt-use eisenstein ())
                    (#pt-lambda
                      ((candidate-left (#pt-use eisenstein ())))
                      (#pt-app
                        (#pt-use exists (0))
                        (#pt-use eisenstein ())
                        (#pt-lambda
                          ((candidate-right (#pt-use eisenstein ())))
                          (#pt-app
                            (#pt-use eisenstein-equal ())
                            (#pt-use eisenstein-one ())
                            (#pt-app
                              (#pt-use eisenstein-add ())
                              (#pt-app (#pt-use eisenstein-multiply ()) candidate-left x)
                              (#pt-app (#pt-use eisenstein-multiply ()) candidate-right y)))))))
                  introduce
                  (
                    (#pt-app
                      (#pt-use eisenstein-add ())
                      (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first-x)
                      (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient second-x))
                    (#pt-construct
                      exists
                      (0)
                      (
                        (#pt-use eisenstein ())
                        (#pt-lambda
                          ((candidate-right (#pt-use eisenstein ())))
                          (#pt-app
                            (#pt-use eisenstein-equal ())
                            (#pt-use eisenstein-one ())
                            (#pt-app
                              (#pt-use eisenstein-add ())
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                (#pt-app
                                  (#pt-use eisenstein-add ())
                                  (#pt-app
                                    (#pt-use eisenstein-multiply ())
                                    left-coefficient
                                    first-x)
                                  (#pt-app
                                    (#pt-use eisenstein-multiply ())
                                    right-coefficient
                                    second-x))
                                x)
                              (#pt-app (#pt-use eisenstein-multiply ()) candidate-right y)))))
                      introduce
                      (
                        (#pt-app
                          (#pt-use eisenstein-add ())
                          (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first-y)
                          (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient second-y))
                        (#pt-app
                          (#pt-use eisenstein-transitive ())
                          (#pt-use eisenstein-one ())
                          (#pt-app
                            (#pt-use eisenstein-add ())
                            (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first)
                            (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient second))
                          (#pt-app
                            (#pt-use eisenstein-add ())
                            (#pt-app
                              (#pt-use eisenstein-multiply ())
                              (#pt-app
                                (#pt-use eisenstein-add ())
                                (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first-x)
                                (#pt-app
                                  (#pt-use eisenstein-multiply ())
                                  right-coefficient
                                  second-x))
                              x)
                            (#pt-app
                              (#pt-use eisenstein-multiply ())
                              (#pt-app
                                (#pt-use eisenstein-add ())
                                (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first-y)
                                (#pt-app
                                  (#pt-use eisenstein-multiply ())
                                  right-coefficient
                                  second-y))
                              y))
                          bezout-equation
                          (#pt-app
                            (#pt-use eisenstein-transitive ())
                            (#pt-app
                              (#pt-use eisenstein-add ())
                              (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first)
                              (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient second))
                            (#pt-app
                              (#pt-use eisenstein-add ())
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                left-coefficient
                                (#pt-app
                                  (#pt-use eisenstein-add ())
                                  (#pt-app (#pt-use eisenstein-multiply ()) first-x x)
                                  (#pt-app (#pt-use eisenstein-multiply ()) first-y y)))
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                right-coefficient
                                (#pt-app
                                  (#pt-use eisenstein-add ())
                                  (#pt-app (#pt-use eisenstein-multiply ()) second-x x)
                                  (#pt-app (#pt-use eisenstein-multiply ()) second-y y))))
                            (#pt-app
                              (#pt-use eisenstein-add ())
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                (#pt-app
                                  (#pt-use eisenstein-add ())
                                  (#pt-app
                                    (#pt-use eisenstein-multiply ())
                                    left-coefficient
                                    first-x)
                                  (#pt-app
                                    (#pt-use eisenstein-multiply ())
                                    right-coefficient
                                    second-x))
                                x)
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                (#pt-app
                                  (#pt-use eisenstein-add ())
                                  (#pt-app
                                    (#pt-use eisenstein-multiply ())
                                    left-coefficient
                                    first-y)
                                  (#pt-app
                                    (#pt-use eisenstein-multiply ())
                                    right-coefficient
                                    second-y))
                                y))
                            (#pt-app
                              (#pt-use eisenstein-add-congruent ())
                              (#pt-app (#pt-use eisenstein-multiply ()) left-coefficient first)
                              (#pt-app (#pt-use eisenstein-multiply ()) right-coefficient second)
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                left-coefficient
                                (#pt-app
                                  (#pt-use eisenstein-add ())
                                  (#pt-app (#pt-use eisenstein-multiply ()) first-x x)
                                  (#pt-app (#pt-use eisenstein-multiply ()) first-y y)))
                              (#pt-app
                                (#pt-use eisenstein-multiply ())
                                right-coefficient
                                (#pt-app
                                  (#pt-use eisenstein-add ())
                                  (#pt-app (#pt-use eisenstein-multiply ()) second-x x)
                                  (#pt-app (#pt-use eisenstein-multiply ()) second-y y)))
                              (#pt-app
                                (#pt-use eisenstein-multiply-congruent ())
                                left-coefficient
                                first
                                left-coefficient
                                (#pt-app
                                  (#pt-use eisenstein-add ())
                                  (#pt-app (#pt-use eisenstein-multiply ()) first-x x)
                                  (#pt-app (#pt-use eisenstein-multiply ()) first-y y))
                                (#pt-app (#pt-use eisenstein-reflexive ()) left-coefficient)
                                first-equivalence)
                              (#pt-app
                                (#pt-use eisenstein-multiply-congruent ())
                                right-coefficient
                                second
                                right-coefficient
                                (#pt-app
                                  (#pt-use eisenstein-add ())
                                  (#pt-app (#pt-use eisenstein-multiply ()) second-x x)
                                  (#pt-app (#pt-use eisenstein-multiply ()) second-y y))
                                (#pt-app (#pt-use eisenstein-reflexive ()) right-coefficient)
                                second-equivalence))
                            (#pt-app
                              (#pt-use eisenstein-bezout-linear-expansion ())
                              left-coefficient
                              right-coefficient
                              first-x
                              first-y
                              second-x
                              second-y
                              x
                              y)))))))))
            right-certificate)))
      coprime-proof)))
(#theorem eisenstein-coprime-from-sum-and-unit-shift
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter x (#pt-use eisenstein ()))
    (#parameter y (#pt-use eisenstein ()))
    (#parameter primary (#pt-use eisenstein ()))
    (#parameter shift (#pt-use eisenstein ()))
    (#parameter unit (#pt-use eisenstein ()))
    (#parameter unit-proof (#pt-app (#pt-use eisenstein-unit ()) unit))
    (#parameter primary-equivalence (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-add ()) first second) (#pt-app (#pt-use eisenstein-multiply ()) primary x)))
    (#parameter shift-equivalence (#pt-app (#pt-use eisenstein-equal ()) y (#pt-app (#pt-use eisenstein-add ()) (#pt-app (#pt-use eisenstein-multiply ()) shift x) (#pt-app (#pt-use eisenstein-multiply ()) unit second))))
    (#parameter coprime-proof (#pt-app (#pt-use eisenstein-coprime ()) first second)))
  (#statement (#pt-app (#pt-use eisenstein-coprime ()) x y))
  (#proof
    (#pt-induct
      exists
      (0)
      (
        (#pt-use eisenstein ())
        (#pt-lambda
          ((candidate-inverse (#pt-use eisenstein ())))
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app (#pt-use eisenstein-multiply ()) unit candidate-inverse)
              (#pt-use eisenstein-one ()))
            (#pt-app
              (#pt-use eisenstein-equal ())
              (#pt-app (#pt-use eisenstein-multiply ()) candidate-inverse unit)
              (#pt-use eisenstein-one ())))))
      (#pt-lambda
        (
          (eisenstein-certificate
            (#pt-app
              (#pt-use exists (0))
              (#pt-use eisenstein ())
              (#pt-lambda
                ((candidate-inverse (#pt-use eisenstein ())))
                (#pt-app
                  (#pt-use conjunction ())
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) unit candidate-inverse)
                    (#pt-use eisenstein-one ()))
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) candidate-inverse unit)
                    (#pt-use eisenstein-one ())))))))
        (#pt-app (#pt-use eisenstein-coprime ()) x y))
      (
        (#pt-lambda
          (
            (inverse (#pt-use eisenstein ()))
            (inverse-equations
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-multiply ()) unit inverse)
                  (#pt-use eisenstein-one ()))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-multiply ()) inverse unit)
                  (#pt-use eisenstein-one ())))))
          (#pt-app
            (#pt-use eisenstein-coprime-linear-change ())
            first
            second
            x
            y
            (#pt-app
              (#pt-use eisenstein-add ())
              primary
              (#pt-app (#pt-use eisenstein-multiply ()) inverse shift))
            (#pt-app (#pt-use eisenstein-negate ()) inverse)
            (#pt-app
              (#pt-use eisenstein-negate ())
              (#pt-app (#pt-use eisenstein-multiply ()) inverse shift))
            inverse
            (#pt-app
              (#pt-use eisenstein-linear-complement ())
              first
              second
              primary
              (#pt-app (#pt-use eisenstein-multiply ()) inverse shift)
              inverse
              x
              y
              primary-equivalence
              (#pt-app
                (#pt-use eisenstein-inverse-linear-second ())
                shift
                x
                unit
                inverse
                second
                y
                shift-equivalence
                (#pt-app
                  (#pt-use conjunction-right ())
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) unit inverse)
                    (#pt-use eisenstein-one ()))
                  (#pt-app
                    (#pt-use eisenstein-equal ())
                    (#pt-app (#pt-use eisenstein-multiply ()) inverse unit)
                    (#pt-use eisenstein-one ()))
                  inverse-equations)))
            (#pt-app
              (#pt-use eisenstein-inverse-linear-second ())
              shift
              x
              unit
              inverse
              second
              y
              shift-equivalence
              (#pt-app
                (#pt-use conjunction-right ())
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-multiply ()) unit inverse)
                  (#pt-use eisenstein-one ()))
                (#pt-app
                  (#pt-use eisenstein-equal ())
                  (#pt-app (#pt-use eisenstein-multiply ()) inverse unit)
                  (#pt-use eisenstein-one ()))
                inverse-equations))
            coprime-proof)))
      unit-proof)))
