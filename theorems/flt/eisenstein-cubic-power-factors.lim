          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) exponent)
          (#pt-app
            (#pt-use eisenstein-power ())
            (#pt-use eisenstein-lambda ())
            (#pt-app (#pt-use add ()) exponent exponent))
          (#pt-app
            (#pt-use eisenstein-reflexive ())
            (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) exponent))
          (#pt-app
