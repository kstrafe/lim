              (#pt-app
                (#pt-use eisenstein-power ())
                (#pt-use eisenstein-lambda ())
                (#pt-app (#pt-use add ()) exponent (#pt-app (#pt-use add ()) exponent exponent))))))))))
(#theorem eisenstein-cube-lambda-powered-factor
  (#universes)
  (#parameters
    (#parameter exponent #pt-nat)
    (#parameter residual (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app
        (#pt-use eisenstein-power ())
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) exponent)
          residual)
        (#pt-numeral 3))
      (#pt-app
        (#pt-use eisenstein-multiply ())
        (#pt-app
          (#pt-use eisenstein-power ())
          (#pt-use eisenstein-lambda ())
          (#pt-app (#pt-use multiply ()) (#pt-numeral 3) exponent))
        (#pt-app (#pt-use eisenstein-power ()) residual (#pt-numeral 3)))))
  (#proof
    (#pt-app
      (#pt-use eisenstein-transitive ())
      (#pt-app
        (#pt-use eisenstein-power ())
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) exponent)
          residual)
        (#pt-numeral 3))
      (#pt-app
        (#pt-use eisenstein-multiply ())
        (#pt-app
          (#pt-use eisenstein-power ())
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) exponent)
          (#pt-numeral 3))
        (#pt-app (#pt-use eisenstein-power ()) residual (#pt-numeral 3)))
      (#pt-app
        (#pt-use eisenstein-multiply ())
        (#pt-app
          (#pt-use eisenstein-power ())
          (#pt-use eisenstein-lambda ())
          (#pt-app (#pt-use multiply ()) (#pt-numeral 3) exponent))
        (#pt-app (#pt-use eisenstein-power ()) residual (#pt-numeral 3)))
      (#pt-app
        (#pt-use eisenstein-cube-product ())
        (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) exponent)
        residual)
      (#pt-app
        (#pt-use eisenstein-multiply-congruent ())
        (#pt-app
          (#pt-use eisenstein-power ())
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) exponent)
          (#pt-numeral 3))
        (#pt-app (#pt-use eisenstein-power ()) residual (#pt-numeral 3))
        (#pt-app
          (#pt-use eisenstein-power ())
          (#pt-use eisenstein-lambda ())
          (#pt-app (#pt-use multiply ()) (#pt-numeral 3) exponent))
        (#pt-app (#pt-use eisenstein-power ()) residual (#pt-numeral 3))
        (#pt-app (#pt-use eisenstein-lambda-power-cube ()) exponent)
        (#pt-app
          (#pt-use eisenstein-reflexive ())
          (#pt-app (#pt-use eisenstein-power ()) residual (#pt-numeral 3)))))))
