                (#pt-use eisenstein-lambda ())
                (#pt-app (#pt-use add ()) primary-order (#pt-succ #pt-zero)))
              (#pt-use eisenstein-lambda ())
              (#pt-app (#pt-use eisenstein-lambda-power-multiply-step ()) primary-order)
              (#pt-app (#pt-use eisenstein-reflexive ()) (#pt-use eisenstein-lambda ())))
            (#pt-app
              (#pt-use eisenstein-lambda-power-multiply-step ())
              (#pt-app (#pt-use add ()) primary-order (#pt-succ #pt-zero))))
          (#pt-app
            (#pt-use eisenstein-reflexive ())
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-app (#pt-use eisenstein-multiply ()) first second)
              third)))))))
(#theorem eisenstein-lambda-power-cube
  (#universes)
  (#parameters
    (#parameter exponent #pt-nat))
  (#statement
    (#pt-app
      (#pt-use eisenstein-equal ())
      (#pt-app
        (#pt-use eisenstein-power ())
        (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) exponent)
        (#pt-numeral 3))
      (#pt-app
        (#pt-use eisenstein-power ())
        (#pt-use eisenstein-lambda ())
        (#pt-app (#pt-use multiply ()) (#pt-numeral 3) exponent))))
  (#proof
    (#pt-app
      (#pt-use eisenstein-transitive ())
      (#pt-app
        (#pt-use eisenstein-power ())
        (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) exponent)
