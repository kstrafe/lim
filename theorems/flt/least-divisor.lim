; Least divisors above one, using explicit constructive arithmetic decisions.
; A later proof establishes primality from this minimum; none is assumed here.
(#alias less-than = ./natural-order.lim::less-than)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias divides-reflexive = ./natural-divisibility.lim::divides-reflexive)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias decision = ./logical-decision.lim::decision)
(#alias decision-conjunction = ./decidable-logic.lim::decision-conjunction)
(#alias decide-less-than = ./decidable-order.lim::decide-less-than)
(#alias decide-divides = ./decidable-divisibility.lim::decide-divides)
(#alias any-up-to-here = ./bounded-existence.lim::any-up-to-here)
(#alias has-minimum = ./least-witness.lim::has-minimum)
(#alias bounded-minimum = ./least-witness.lim::bounded-minimum)
(#math-definition nontrivial-divisor ()
  (#pt-pi ((multiple #pt-nat) (divisor #pt-nat)) #pt-prop)
  (#pt-lambda
    ((multiple #pt-nat) (divisor #pt-nat))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) divisor)
      (#pt-app (#pt-use divides ()) divisor multiple))))
(#math-definition decide-nontrivial-divisor ()
  (#pt-pi
    ((multiple #pt-nat) (divisor #pt-nat))
    (#pt-app (#pt-use decision ()) (#pt-app (#pt-use nontrivial-divisor ()) multiple divisor)))
  (#pt-lambda
    ((multiple #pt-nat) (divisor #pt-nat))
    (#pt-app
      (#pt-use decision-conjunction ())
      (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) divisor)
      (#pt-app (#pt-use divides ()) divisor multiple)
      (#pt-app (#pt-use decide-less-than ()) (#pt-succ #pt-zero) divisor)
      (#pt-app (#pt-use decide-divides ()) divisor multiple))))
(#theorem least-nontrivial-divisor
  (#universes)
  (#parameters
    (#parameter multiple #pt-nat)
    (#parameter larger-than-one (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) multiple)))
  (#statement
    (#pt-app
      (#pt-use has-minimum ())
      (#pt-lambda
        ((candidate #pt-nat))
        (#pt-app (#pt-use nontrivial-divisor ()) multiple candidate))))
  (#proof
    (#pt-app
      (#pt-use bounded-minimum ())
      (#pt-lambda
        ((candidate #pt-nat))
        (#pt-app (#pt-use nontrivial-divisor ()) multiple candidate))
      (#pt-lambda
        ((candidate #pt-nat))
        (#pt-app (#pt-use decide-nontrivial-divisor ()) multiple candidate))
      multiple
      (#pt-app
        (#pt-use any-up-to-here ())
        (#pt-lambda
          ((candidate #pt-nat))
          (#pt-app (#pt-use nontrivial-divisor ()) multiple candidate))
        multiple
        (#pt-app
          (#pt-use conjunction-introduce ())
          (#pt-app (#pt-use less-than ()) (#pt-succ #pt-zero) multiple)
          (#pt-app (#pt-use divides ()) multiple multiple)
          larger-than-one
          (#pt-app (#pt-use divides-reflexive ()) multiple))))))
