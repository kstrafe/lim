; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Expand the product of two actual point-ideal
; shaped pairs into the four pairwise products. This is the
; span-pair multiplication step used in Affine/Point.lean, proved
; from actual ideal operations without a span rewrite axiom.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias ring-ideal-equal = ./ring-ideal-data.lim::ring-ideal-equal)
(#alias ring-ideal-equal-transitive = ./ring-ideal-equivalence.lim::ring-ideal-equal-transitive)
(#alias ring-ideal-pair = ./ring-ideal-pair.lim::ring-ideal-pair)
(#alias ring-ideal-principal = ./ring-ideal-principal.lim::ring-ideal-principal)
(#alias
  ring-ideal-principal-pair-product
  =
  ./ring-ideal-principal-pair-product.lim::ring-ideal-principal-pair-product)
(#alias ring-ideal-product = ./ring-ideal-product.lim::ring-ideal-product)
(#alias
  ring-ideal-product-distribute-first
  =
  ./ring-ideal-product-distribute-first.lim::ring-ideal-product-distribute-first)
(#alias ring-ideal-sum = ./ring-ideal-sum.lim::ring-ideal-sum)
(#alias ring-ideal-sum-congruent = ./ring-ideal-operation-congruence.lim::ring-ideal-sum-congruent)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#theorem ring-ideal-pair-product
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-element Carrier)
    (#parameter second-element Carrier)
    (#parameter coefficient Carrier)
    (#parameter fourth-generator Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring first-element second-element)
        (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring coefficient fourth-generator))
      (#pt-app
        (#pt-use ring-ideal-sum ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-pair ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element coefficient)
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            first-element
            fourth-generator))
        (#pt-app
          (#pt-use ring-ideal-pair ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring second-element coefficient)
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            second-element
            fourth-generator)))))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-equal-transitive ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring first-element second-element)
        (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring coefficient fourth-generator))
      (#pt-app
        (#pt-use ring-ideal-sum ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
          (#pt-app
            (#pt-use ring-ideal-pair ())
            Carrier
            coefficient-ring
            coefficient
            fourth-generator))
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element)
          (#pt-app
            (#pt-use ring-ideal-pair ())
            Carrier
            coefficient-ring
            coefficient
            fourth-generator)))
      (#pt-app
        (#pt-use ring-ideal-sum ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-pair ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element coefficient)
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            first-element
            fourth-generator))
        (#pt-app
          (#pt-use ring-ideal-pair ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring second-element coefficient)
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            second-element
            fourth-generator)))
      (#pt-app
        (#pt-use ring-ideal-product-distribute-first ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
        (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element)
        (#pt-app (#pt-use ring-ideal-pair ()) Carrier coefficient-ring coefficient fourth-generator))
      (#pt-app
        (#pt-use ring-ideal-sum-congruent ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring first-element)
          (#pt-app
            (#pt-use ring-ideal-pair ())
            Carrier
            coefficient-ring
            coefficient
            fourth-generator))
        (#pt-app
          (#pt-use ring-ideal-product ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-ideal-principal ()) Carrier coefficient-ring second-element)
          (#pt-app
            (#pt-use ring-ideal-pair ())
            Carrier
            coefficient-ring
            coefficient
            fourth-generator))
        (#pt-app
          (#pt-use ring-ideal-pair ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-element coefficient)
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            first-element
            fourth-generator))
        (#pt-app
          (#pt-use ring-ideal-pair ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring second-element coefficient)
          (#pt-app
            (#pt-use ring-multiply ())
            Carrier
            coefficient-ring
            second-element
            fourth-generator))
        (#pt-app
          (#pt-use ring-ideal-principal-pair-product ())
          Carrier
          coefficient-ring
          first-element
          coefficient
          fourth-generator)
        (#pt-app
          (#pt-use ring-ideal-principal-pair-product ())
          Carrier
          coefficient-ring
          second-element
          coefficient
          fourth-generator)))))
