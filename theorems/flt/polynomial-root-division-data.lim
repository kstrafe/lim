            (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
            (#pt-construct finite-list () (Carrier) nil ())))))))
(#math-definition polynomial-root-divide ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (root Carrier)
      (polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
    (#pt-app (#pt-use polynomial-root-division-data ()) Carrier))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (root Carrier)
      (polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
    (#pt-induct
      finite-list
      ()
      (Carrier)
      (#pt-lambda
        ((subject (#pt-app (#pt-use finite-list ()) Carrier)))
        (#pt-app (#pt-use polynomial-root-division-data ()) Carrier))
      (
        (#pt-construct
          polynomial-root-division-data
          ()
          (Carrier)
          division
          (
            (#pt-construct finite-list () (Carrier) nil ())
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)))
        (#pt-lambda
          (
            (head Carrier)
            (tail (#pt-app (#pt-use finite-list ()) Carrier))
            (tail-result (#pt-app (#pt-use polynomial-root-division-data ()) Carrier)))
          (#pt-construct
            polynomial-root-division-data
            ()
