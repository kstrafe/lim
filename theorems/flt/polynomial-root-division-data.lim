    (#pt-project
      polynomial-root-division-data
      1
      (#pt-app (#pt-use polynomial-root-divide ()) Carrier coefficient-ring root polynomial))))
(#theorem polynomial-root-divisor-linear-coefficient
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter root Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-coefficient ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
        (#pt-numeral 1))
      (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)))
  (#proof
    (#pt-app
      (#pt-use ring-reflexive ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring))))
