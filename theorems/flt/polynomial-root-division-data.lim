(#math-inductive polynomial-root-division-data ()
  ((Carrier (#pt-type 0)))
  (#pt-type 0)
  ((division ((quotient (#pt-app (#pt-use finite-list ()) Carrier)) (remainder Carrier)))))
(#math-definition polynomial-root-divisor ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (root Carrier))
    (#pt-app (#pt-use finite-list ()) Carrier))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (root Carrier))
    (#pt-construct
      finite-list
      ()
      (Carrier)
      cons
