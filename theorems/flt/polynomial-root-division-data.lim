(#math-definition polynomial-root-quotient ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (root Carrier)
      (polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
    (#pt-app (#pt-use finite-list ()) Carrier))
