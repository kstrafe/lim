(#theorem integer-gcd-exists
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ())))
  (#statement
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-gcd #pt-nat))
        (#pt-app (#pt-use integer-gcd-spec ()) first second candidate-gcd))))
  (#proof
    (#pt-induct
      exists
      (0)
      (#pt-nat
        (#pt-lambda
          ((candidate-magnitude #pt-nat))
          (#pt-app (#pt-use integer-magnitude ()) first candidate-magnitude)))
      (#pt-lambda
        (
          (certificate
            (#pt-app
              (#pt-use exists (0))
              #pt-nat
              (#pt-lambda
                ((candidate-magnitude #pt-nat))
                (#pt-app (#pt-use integer-magnitude ()) first candidate-magnitude)))))
        (#pt-app
          (#pt-use exists (0))
          #pt-nat
          (#pt-lambda
            ((candidate-gcd #pt-nat))
            (#pt-app (#pt-use integer-gcd-spec ()) first second candidate-gcd))))
      (
        (#pt-lambda
          (
            (first-magnitude #pt-nat)
            (first-magnitude-proof (#pt-app (#pt-use integer-magnitude ()) first first-magnitude)))
          (#pt-induct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-magnitude #pt-nat))
                (#pt-app (#pt-use integer-magnitude ()) second candidate-magnitude)))
