                        common-magnitude
                        second
                        second-magnitude
                        second-magnitude-proof
                        (#pt-app
                          (#pt-use integer-divides-magnitude-divisor ())
                          common-integer
                          common-magnitude
                          second
                          common-magnitude-proof
                          common-second-divides)))))))
            (#pt-app (#pt-use integer-magnitude-exists ()) common-integer)))))))
