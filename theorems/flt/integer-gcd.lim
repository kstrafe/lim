          (#pt-app
            (#pt-use integer-divides ())
            candidate-integer
            (#pt-app (#pt-use integer-of-natural ()) greatest-divisor))))
      (#pt-app
        (#pt-use integer-divides-of-magnitude ())
        greatest-divisor
        first
        first-magnitude
        first-magnitude-proof
        (#pt-app
          (#pt-use conjunction-left ())
          (#pt-app (#pt-use divides ()) greatest-divisor first-magnitude)
          (#pt-app
            (#pt-use conjunction ())
            (#pt-app (#pt-use divides ()) greatest-divisor second-magnitude)
            (#pt-pi
              (
                (candidate-natural #pt-nat)
                (candidate-first (#pt-app (#pt-use divides ()) candidate-natural first-magnitude))
                (candidate-second (#pt-app (#pt-use divides ()) candidate-natural second-magnitude)))
              (#pt-app (#pt-use divides ()) candidate-natural greatest-divisor)))
          natural-gcd-proof))
      (#pt-app
        (#pt-use conjunction-introduce ())
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) greatest-divisor)
          second)
        (#pt-pi
          (
            (candidate-integer (#pt-use integer ()))
            (candidate-first (#pt-app (#pt-use integer-divides ()) candidate-integer first))
            (candidate-second (#pt-app (#pt-use integer-divides ()) candidate-integer second)))
          (#pt-app
            (#pt-use integer-divides ())
            candidate-integer
            (#pt-app (#pt-use integer-of-natural ()) greatest-divisor)))
        (#pt-app
          (#pt-use integer-divides-of-magnitude ())
          greatest-divisor
          second
          second-magnitude
          second-magnitude-proof
          (#pt-app
            (#pt-use conjunction-left ())
            (#pt-app (#pt-use divides ()) greatest-divisor second-magnitude)
            (#pt-pi
              (
                (candidate-natural #pt-nat)
                (candidate-first (#pt-app (#pt-use divides ()) candidate-natural first-magnitude))
                (candidate-second (#pt-app (#pt-use divides ()) candidate-natural second-magnitude)))
              (#pt-app (#pt-use divides ()) candidate-natural greatest-divisor))
            (#pt-app
              (#pt-use conjunction-right ())
              (#pt-app (#pt-use divides ()) greatest-divisor first-magnitude)
              (#pt-app
                (#pt-use conjunction ())
                (#pt-app (#pt-use divides ()) greatest-divisor second-magnitude)
                (#pt-pi
                  (
                    (candidate-natural #pt-nat)
                    (candidate-first
                      (#pt-app (#pt-use divides ()) candidate-natural first-magnitude))
                    (candidate-second
                      (#pt-app (#pt-use divides ()) candidate-natural second-magnitude)))
                  (#pt-app (#pt-use divides ()) candidate-natural greatest-divisor)))
              natural-gcd-proof)))
        (#pt-lambda
          (
            (common-integer (#pt-use integer ()))
            (common-first-divides (#pt-app (#pt-use integer-divides ()) common-integer first))
            (common-second-divides (#pt-app (#pt-use integer-divides ()) common-integer second)))
          (#pt-induct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-magnitude #pt-nat))
                (#pt-app (#pt-use integer-magnitude ()) common-integer candidate-magnitude)))
            (#pt-lambda
              (
