                  (#pt-use integer-divides-from-magnitude-divisor ())
                  common-integer
                  common-magnitude
                  (#pt-app (#pt-use integer-of-natural ()) greatest-divisor)
                  common-magnitude-proof
                  (#pt-app
                    (#pt-use integer-divides-of-natural ())
                    common-magnitude
                    greatest-divisor
                    (#pt-app
                      (#pt-app
                        (#pt-use conjunction-right ())
                        (#pt-app (#pt-use divides ()) greatest-divisor second-magnitude)
                        (#pt-pi
                          (
