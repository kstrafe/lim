; Gcd certificates of signed formal differences, with natural representatives.
; Every signed common divisor must divide the embedded gcd. No gcd algorithm,
; absolute-value oracle, choice axiom, or opaque algebraic law is assumed.
(#alias exists = ./logic-exists.lim::exists)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias gcd-spec = ./natural-gcd.lim::gcd-spec)
(#alias has-gcd = ./natural-gcd.lim::has-gcd)
