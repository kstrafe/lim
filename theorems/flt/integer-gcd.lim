                                (candidate-second
                                  (#pt-app (#pt-use divides ()) candidate-natural second-magnitude)))
                              (#pt-app (#pt-use divides ()) candidate-natural greatest-divisor)))
                          natural-gcd-proof))
                      common-magnitude
                      (#pt-app
                        (#pt-use integer-divides-magnitude ())
                        common-magnitude
                        first
                        first-magnitude
                        first-magnitude-proof
                        (#pt-app
                          (#pt-use integer-divides-magnitude-divisor ())
                          common-integer
                          common-magnitude
                          first
                          common-magnitude-proof
                          common-first-divides))
                      (#pt-app
