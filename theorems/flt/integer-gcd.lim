(#math-definition integer-gcd-spec ()
  (#pt-pi
    ((first (#pt-use integer ())) (second (#pt-use integer ())) (greatest-divisor #pt-nat))
    #pt-prop)
  (#pt-lambda
    ((first (#pt-use integer ())) (second (#pt-use integer ())) (greatest-divisor #pt-nat))
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app
        (#pt-use integer-divides ())
        (#pt-app (#pt-use integer-of-natural ()) greatest-divisor)
        first)
      (#pt-app
        (#pt-use conjunction ())
        (#pt-app
          (#pt-use integer-divides ())
          (#pt-app (#pt-use integer-of-natural ()) greatest-divisor)
          second)
        (#pt-pi
          (
            (candidate-integer (#pt-use integer ()))
            (candidate-first (#pt-app (#pt-use integer-divides ()) candidate-integer first))
            (candidate-second (#pt-app (#pt-use integer-divides ()) candidate-integer second)))
          (#pt-app
            (#pt-use integer-divides ())
            candidate-integer
            (#pt-app (#pt-use integer-of-natural ()) greatest-divisor)))))))
(#math-definition integer-has-gcd ()
  (#pt-pi ((first (#pt-use integer ())) (second (#pt-use integer ()))) #pt-prop)
  (#pt-lambda
    ((first (#pt-use integer ())) (second (#pt-use integer ())))
    (#pt-app
      (#pt-use exists (0))
      #pt-nat
      (#pt-lambda
        ((candidate-gcd #pt-nat))
        (#pt-app (#pt-use integer-gcd-spec ()) first second candidate-gcd)))))
(#theorem integer-gcd-divides-first
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter greatest-divisor #pt-nat)
    (#parameter gcd-proof (#pt-app (#pt-use integer-gcd-spec ()) first second greatest-divisor)))
