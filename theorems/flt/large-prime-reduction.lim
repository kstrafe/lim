; Native mathematical source adaptation of the small-prime split in
; P2M/Sol/S_FLT_fermatLastTheorem.lean:130-139 at the pinned FLT revision.
; See provenance.json for upstream attribution and license information.
; Primality gives p>1; oddness excludes p=2, the closed native cubic
; theorem supplies p=3, and the actual divisor2 excludes prime4.
; Remaining cases have p>=5. Their proofs remain an explicit parameter.
; This reduction does not assert the remaining large-prime argument.
(#alias prime = ./natural-prime.lim::prime)
(#alias prime-larger-than-one = ./natural-prime.lim::prime-larger-than-one)
(#alias prime-excludes-proper-divisor = ./natural-prime.lim::prime-excludes-proper-divisor)
(#alias odd = ./natural-parity.lim::odd)
(#alias odd-even-exclusion = ./natural-parity-arithmetic.lim::odd-even-exclusion)
(#alias two-divides-four = ./natural-parity-arithmetic.lim::two-divides-four)
(#alias divides = ./natural-divisibility-defs.lim::divides)
(#alias divides-reflexive = ./natural-divisibility.lim::divides-reflexive)
(#alias less-than = ./natural-order.lim::less-than)
(#alias less-than-successor = ./natural-order.lim::less-than-successor)
(#alias less-than-discrete-step = ./natural-discrete-order.lim::less-than-discrete-step)
(#alias less-than-transitive = ./natural-order.lim::less-than-transitive)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#alias substitution = ./equality.lim::substitution)
(#alias fermat-for = ./fermat-for.lim::fermat-for)
(#alias fermat-for-three = ./fermat-three.lim::fermat-for-three)
(#alias fermat-statement-from-odd-primes = ./fermat-four.lim::fermat-statement-from-odd-primes)
(#alias fermats-last-theorem-statement = ./../fermat_statement.lim::fermats-last-theorem-statement)
(#math-definition large-prime-fermat-cases ()
  #pt-prop
  (#pt-pi
    (
      (large-prime #pt-nat)
      (large-primality (#pt-app (#pt-use prime ()) large-prime))
      (large-bound (#pt-app (#pt-use less-than ()) (#pt-numeral 4) large-prime)))
    (#pt-app (#pt-use fermat-for ()) large-prime)))
(#theorem fermat-for-odd-prime-from-large-primes
  (#universes)
  (#parameters
    (#parameter prime-exponent #pt-nat)
    (#parameter prime-certificate (#pt-app (#pt-use prime ()) prime-exponent))
    (#parameter odd-certificate (#pt-app (#pt-use odd ()) prime-exponent))
    (#parameter large-prime-cases (#pt-use large-prime-fermat-cases ())))
  (#statement (#pt-app (#pt-use fermat-for ()) prime-exponent))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-eq #pt-nat (#pt-numeral 2) prime-exponent)
      (#pt-app (#pt-use less-than ()) (#pt-numeral 2) prime-exponent)
      (#pt-app (#pt-use fermat-for ()) prime-exponent)
      (#pt-lambda
        ((two-equation (#pt-eq #pt-nat (#pt-numeral 2) prime-exponent)))
        (#pt-app
          (#pt-use false-elimination ())
          (#pt-app (#pt-use fermat-for ()) prime-exponent)
          (#pt-app
            (#pt-use odd-even-exclusion ())
            prime-exponent
            odd-certificate
            (#pt-app
              (#pt-use substitution (0))
              #pt-nat
              (#pt-lambda
                ((endpoint #pt-nat))
                (#pt-app (#pt-use divides ()) (#pt-numeral 2) endpoint))
              (#pt-numeral 2)
              prime-exponent
              two-equation
              (#pt-app (#pt-use divides-reflexive ()) (#pt-numeral 2))))))
      (#pt-lambda
        ((above-two (#pt-app (#pt-use less-than ()) (#pt-numeral 2) prime-exponent)))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-eq #pt-nat (#pt-numeral 3) prime-exponent)
          (#pt-app (#pt-use less-than ()) (#pt-numeral 3) prime-exponent)
          (#pt-app (#pt-use fermat-for ()) prime-exponent)
          (#pt-lambda
            ((three-equation (#pt-eq #pt-nat (#pt-numeral 3) prime-exponent)))
            (#pt-app
              (#pt-use substitution (0))
              #pt-nat
              (#pt-lambda ((endpoint #pt-nat)) (#pt-app (#pt-use fermat-for ()) endpoint))
              (#pt-numeral 3)
              prime-exponent
              three-equation
              (#pt-use fermat-for-three ())))
          (#pt-lambda
            ((above-three (#pt-app (#pt-use less-than ()) (#pt-numeral 3) prime-exponent)))
            (#pt-app
              (#pt-use disjunction-eliminate ())
              (#pt-eq #pt-nat (#pt-numeral 4) prime-exponent)
              (#pt-app (#pt-use less-than ()) (#pt-numeral 4) prime-exponent)
              (#pt-app (#pt-use fermat-for ()) prime-exponent)
              (#pt-lambda
                ((four-equation (#pt-eq #pt-nat (#pt-numeral 4) prime-exponent)))
                (#pt-app
                  (#pt-use false-elimination ())
                  (#pt-app (#pt-use fermat-for ()) prime-exponent)
                  (#pt-app
                    (#pt-app
                      (#pt-use prime-excludes-proper-divisor ())
                      prime-exponent
                      prime-certificate)
                    (#pt-numeral 2)
                    (#pt-app (#pt-use less-than-successor ()) (#pt-succ #pt-zero))
                    (#pt-app
                      (#pt-use substitution (0))
                      #pt-nat
                      (#pt-lambda
                        ((endpoint #pt-nat))
                        (#pt-app (#pt-use less-than ()) (#pt-numeral 2) endpoint))
                      (#pt-numeral 4)
                      prime-exponent
                      four-equation
                      (#pt-app
                        (#pt-use less-than-transitive ())
                        (#pt-numeral 2)
                        (#pt-numeral 3)
                        (#pt-numeral 4)
                        (#pt-app (#pt-use less-than-successor ()) (#pt-numeral 2))
                        (#pt-app (#pt-use less-than-successor ()) (#pt-numeral 3))))
                    (#pt-app
                      (#pt-use substitution (0))
                      #pt-nat
                      (#pt-lambda
                        ((endpoint #pt-nat))
                        (#pt-app (#pt-use divides ()) (#pt-numeral 2) endpoint))
                      (#pt-numeral 4)
                      prime-exponent
                      four-equation
                      (#pt-use two-divides-four ())))))
              (#pt-lambda
                ((large-position (#pt-app (#pt-use less-than ()) (#pt-numeral 4) prime-exponent)))
                (#pt-app large-prime-cases prime-exponent prime-certificate large-position))
              (#pt-app
                (#pt-use less-than-discrete-step ())
                (#pt-numeral 3)
                prime-exponent
                above-three)))
          (#pt-app (#pt-use less-than-discrete-step ()) (#pt-numeral 2) prime-exponent above-two)))
      (#pt-app
        (#pt-use less-than-discrete-step ())
        (#pt-succ #pt-zero)
        prime-exponent
        (#pt-app (#pt-use prime-larger-than-one ()) prime-exponent prime-certificate)))))
(#theorem fermat-statement-from-primes-at-least-five
  (#universes)
  (#parameters
    (#parameter large-prime-cases (#pt-use large-prime-fermat-cases ())))
  (#statement (#pt-use fermats-last-theorem-statement ()))
  (#proof
    (#pt-app
      (#pt-use fermat-statement-from-odd-primes ())
      (#pt-lambda
        (
          (prime-exponent #pt-nat)
          (prime-certificate (#pt-app (#pt-use prime ()) prime-exponent))
          (odd-certificate (#pt-app (#pt-use odd ()) prime-exponent)))
        (#pt-app
          (#pt-use fermat-for-odd-prime-from-large-primes ())
          prime-exponent
          prime-certificate
          odd-certificate
          large-prime-cases)))))
