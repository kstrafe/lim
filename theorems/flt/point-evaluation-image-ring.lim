              coefficient-ring
              (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-value second-value)
              third-value)
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              first-value
              (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring second-value third-value))
            (#pt-app
              (#pt-use ring-multiply-associative ())
              Carrier
              coefficient-ring
              first-value
              second-value
              third-value)))
        (#pt-lambda
          ((first-value Carrier) (second-value Carrier))
          (#pt-app
            (#pt-use ring-evaluation-map-congruent ())
            Carrier
            coefficient-ring
            Image
            image-ring
            morphism
            (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-value second-value)
            (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring second-value first-value)
            (#pt-app
              (#pt-use ring-multiply-commutative ())
              Carrier
              coefficient-ring
              first-value
              second-value)))
        (#pt-lambda
          ((first-value Carrier) (second-value Carrier) (third-value Carrier))
          (#pt-app
            (#pt-use ring-evaluation-map-congruent ())
            Carrier
            coefficient-ring
            Image
            image-ring
            morphism
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              first-value
              (#pt-app (#pt-use ring-add ()) Carrier coefficient-ring second-value third-value))
            (#pt-app
              (#pt-use ring-add ())
              Carrier
              coefficient-ring
              (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-value second-value)
              (#pt-app (#pt-use ring-multiply ()) Carrier coefficient-ring first-value third-value))
            (#pt-app
              (#pt-use ring-distributive ())
              Carrier
              coefficient-ring
              first-value
              second-value
              third-value)))
        (#pt-lambda
          ((first-value Carrier))
          (#pt-app
            (#pt-use ring-evaluation-map-congruent ())
            Carrier
            coefficient-ring
            Image
            image-ring
            morphism
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              first-value
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
            (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring)
            (#pt-app (#pt-use ring-multiply-zero ()) Carrier coefficient-ring first-value)))))))
(#theorem point-evaluation-image-relation
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter Image (#pt-type 0))
    (#parameter image-ring (#pt-app (#pt-use commutative-ring ()) Image))
    (#parameter morphism (#pt-app (#pt-use ring-evaluation-morphism ()) Carrier coefficient-ring Image image-ring))
    (#parameter first-value Carrier)
    (#parameter second-value Carrier)
    (#parameter equation (#pt-app (#pt-use ring-equal ()) Image image-ring (#pt-app (#pt-use ring-evaluation-map ()) Carrier coefficient-ring Image image-ring morphism first-value) (#pt-app (#pt-use ring-evaluation-map ()) Carrier coefficient-ring Image image-ring morphism second-value))))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      (#pt-app
        (#pt-use point-evaluation-image-ring ())
        Carrier
        coefficient-ring
        Image
        image-ring
        morphism)
      first-value
      second-value))
  (#proof equation))
