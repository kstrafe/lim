          (#pt-eq
            #pt-nat
            (#pt-project finite-residue 0 first-y)
            (#pt-project finite-residue 0 second-y))
          (#pt-app not-inverse-y inverse-y)))
      (#pt-app
        (#pt-use finite-weierstrass-equal-x-y-cases ())
        modulus
        positive-modulus
        prime-proof
        curve
        first-x
        second-x
        first-y
        second-y
        first-equation
        second-equation
        x-equation))))
