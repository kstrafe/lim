; Bezout for every certified natural gcd, with signed coefficients.
; Strong induction follows the strictly smaller Euclidean remainder.
; All division equations/bounds and gcd transitions are checked inputs,
; and the resulting coefficient witnesses are constructed explicitly.
(#alias add = ../fermat_statement.lim::add)
(#alias multiply = ../fermat_statement.lim::multiply)
(#alias exists = ./logic-exists.lim::exists)
(#alias less-than = ./natural-order.lim::less-than)
(#alias strong-induction = ./natural-order.lim::strong-induction)
(#alias zero-less-successor = ./natural-discrete-order.lim::zero-less-successor)
(#alias division-spec = ./natural-division.lim::division-spec)
(#alias has-division = ./natural-division.lim::has-division)
(#alias division-exists = ./natural-division.lim::division-exists)
(#alias gcd-spec = ./natural-gcd.lim::gcd-spec)
(#alias gcd-zero-right = ./natural-gcd.lim::gcd-zero-right)
(#alias gcd-unique = ./natural-coprime.lim::gcd-unique)
(#alias gcd-euclidean-reverse = ./natural-gcd-scaling.lim::gcd-euclidean-reverse)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-has-bezout = ./integer-bezout-defs.lim::integer-has-bezout)
(#alias integer-bezout-reflexive-left = ./integer-bezout.lim::integer-bezout-reflexive-left)
(#alias integer-bezout-euclidean-step = ./integer-bezout.lim::integer-bezout-euclidean-step)
(#alias
  integer-natural-division-equation
  =
  ./integer-bezout-algebra.lim::integer-natural-division-equation)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias symmetry = ./equality.lim::symmetry)
(#alias substitution = ./equality.lim::substitution)
(#theorem natural-bezout-induction-step
  (#universes)
  (#parameters
    (#parameter stage #pt-nat)
    (#parameter given-history (#pt-pi ((earlier #pt-nat) (earlier-proof (#pt-app (#pt-use less-than ()) earlier stage))) (#pt-pi ((candidate-number #pt-nat) (candidate-gcd #pt-nat) (candidate-gcd-proof (#pt-app (#pt-use gcd-spec ()) candidate-number earlier candidate-gcd))) (#pt-app (#pt-use integer-has-bezout ()) (#pt-app (#pt-use integer-of-natural ()) candidate-number) (#pt-app (#pt-use integer-of-natural ()) earlier) (#pt-app (#pt-use integer-of-natural ()) candidate-gcd))))))
  (#statement
    (#pt-pi
      (
        (candidate-number #pt-nat)
        (candidate-gcd #pt-nat)
        (candidate-gcd-proof (#pt-app (#pt-use gcd-spec ()) candidate-number stage candidate-gcd)))
      (#pt-app
        (#pt-use integer-has-bezout ())
        (#pt-app (#pt-use integer-of-natural ()) candidate-number)
        (#pt-app (#pt-use integer-of-natural ()) stage)
        (#pt-app (#pt-use integer-of-natural ()) candidate-gcd))))
  (#proof
    (#pt-app
      (#pt-nat-induct
        (#pt-lambda
          ((index #pt-nat))
          (#pt-pi
            (
              (stage-history
                (#pt-pi
                  ((earlier #pt-nat) (earlier-proof (#pt-app (#pt-use less-than ()) earlier index)))
                  (#pt-pi
                    (
                      (candidate-number #pt-nat)
                      (candidate-gcd #pt-nat)
                      (candidate-gcd-proof
                        (#pt-app (#pt-use gcd-spec ()) candidate-number earlier candidate-gcd)))
                    (#pt-app
                      (#pt-use integer-has-bezout ())
                      (#pt-app (#pt-use integer-of-natural ()) candidate-number)
                      (#pt-app (#pt-use integer-of-natural ()) earlier)
                      (#pt-app (#pt-use integer-of-natural ()) candidate-gcd))))))
            (#pt-pi
              (
                (candidate-number #pt-nat)
                (candidate-gcd #pt-nat)
                (candidate-gcd-proof
                  (#pt-app (#pt-use gcd-spec ()) candidate-number index candidate-gcd)))
              (#pt-app
                (#pt-use integer-has-bezout ())
                (#pt-app (#pt-use integer-of-natural ()) candidate-number)
                (#pt-app (#pt-use integer-of-natural ()) index)
                (#pt-app (#pt-use integer-of-natural ()) candidate-gcd)))))
        (#pt-lambda
          (
            (zero-history
              (#pt-pi
                (
                  (earlier #pt-nat)
                  (earlier-proof (#pt-app (#pt-use less-than ()) earlier #pt-zero)))
                (#pt-pi
                  (
                    (candidate-number #pt-nat)
                    (candidate-gcd #pt-nat)
                    (candidate-gcd-proof
                      (#pt-app (#pt-use gcd-spec ()) candidate-number earlier candidate-gcd)))
                  (#pt-app
                    (#pt-use integer-has-bezout ())
                    (#pt-app (#pt-use integer-of-natural ()) candidate-number)
                    (#pt-app (#pt-use integer-of-natural ()) earlier)
                    (#pt-app (#pt-use integer-of-natural ()) candidate-gcd)))))
            (number #pt-nat)
            (greatest-divisor #pt-nat)
            (gcd-proof (#pt-app (#pt-use gcd-spec ()) number #pt-zero greatest-divisor)))
          (#pt-app
            (#pt-use substitution (0))
            #pt-nat
            (#pt-lambda
              ((endpoint #pt-nat))
              (#pt-app
                (#pt-use integer-has-bezout ())
                (#pt-app (#pt-use integer-of-natural ()) number)
                (#pt-app (#pt-use integer-of-natural ()) #pt-zero)
                (#pt-app (#pt-use integer-of-natural ()) endpoint)))
            number
            greatest-divisor
            (#pt-app
              (#pt-use symmetry (0))
              #pt-nat
              greatest-divisor
              number
              (#pt-app
                (#pt-use gcd-unique ())
                number
                #pt-zero
                greatest-divisor
                number
                gcd-proof
                (#pt-app (#pt-use gcd-zero-right ()) number)))
            (#pt-app
              (#pt-use integer-bezout-reflexive-left ())
              (#pt-app (#pt-use integer-of-natural ()) number)
              (#pt-app (#pt-use integer-of-natural ()) #pt-zero))))
        (#pt-lambda
          (
            (previous #pt-nat)
            (unused-previous
              (#pt-pi
                (
                  (previous-history
                    (#pt-pi
                      (
                        (earlier #pt-nat)
                        (earlier-proof (#pt-app (#pt-use less-than ()) earlier previous)))
                      (#pt-pi
                        (
                          (candidate-number #pt-nat)
                          (candidate-gcd #pt-nat)
                          (candidate-gcd-proof
                            (#pt-app (#pt-use gcd-spec ()) candidate-number earlier candidate-gcd)))
                        (#pt-app
                          (#pt-use integer-has-bezout ())
                          (#pt-app (#pt-use integer-of-natural ()) candidate-number)
                          (#pt-app (#pt-use integer-of-natural ()) earlier)
                          (#pt-app (#pt-use integer-of-natural ()) candidate-gcd))))))
                (#pt-pi
                  (
                    (candidate-number #pt-nat)
                    (candidate-gcd #pt-nat)
                    (candidate-gcd-proof
                      (#pt-app (#pt-use gcd-spec ()) candidate-number previous candidate-gcd)))
                  (#pt-app
                    (#pt-use integer-has-bezout ())
                    (#pt-app (#pt-use integer-of-natural ()) candidate-number)
                    (#pt-app (#pt-use integer-of-natural ()) previous)
                    (#pt-app (#pt-use integer-of-natural ()) candidate-gcd)))))
            (smaller-cases
              (#pt-pi
                (
                  (earlier #pt-nat)
                  (earlier-proof (#pt-app (#pt-use less-than ()) earlier (#pt-succ previous))))
                (#pt-pi
                  (
                    (candidate-number #pt-nat)
                    (candidate-gcd #pt-nat)
                    (candidate-gcd-proof
                      (#pt-app (#pt-use gcd-spec ()) candidate-number earlier candidate-gcd)))
                  (#pt-app
                    (#pt-use integer-has-bezout ())
                    (#pt-app (#pt-use integer-of-natural ()) candidate-number)
                    (#pt-app (#pt-use integer-of-natural ()) earlier)
                    (#pt-app (#pt-use integer-of-natural ()) candidate-gcd)))))
            (number #pt-nat)
            (greatest-divisor #pt-nat)
            (gcd-proof (#pt-app (#pt-use gcd-spec ()) number (#pt-succ previous) greatest-divisor)))
          (#pt-induct
            exists
            (0)
            (#pt-nat
              (#pt-lambda
                ((candidate-quotient #pt-nat))
                (#pt-app
                  (#pt-use exists (0))
                  #pt-nat
                  (#pt-lambda
                    ((candidate-remainder #pt-nat))
                    (#pt-app
                      (#pt-use division-spec ())
                      number
                      (#pt-succ previous)
                      candidate-quotient
                      candidate-remainder)))))
            (#pt-lambda
              (
                (certificate
                  (#pt-app
                    (#pt-use exists (0))
                    #pt-nat
                    (#pt-lambda
                      ((candidate-quotient #pt-nat))
                      (#pt-app
                        (#pt-use exists (0))
                        #pt-nat
                        (#pt-lambda
                          ((candidate-remainder #pt-nat))
                          (#pt-app
                            (#pt-use division-spec ())
                            number
                            (#pt-succ previous)
                            candidate-quotient
                            candidate-remainder)))))))
              (#pt-app
                (#pt-use integer-has-bezout ())
                (#pt-app (#pt-use integer-of-natural ()) number)
                (#pt-app (#pt-use integer-of-natural ()) (#pt-succ previous))
                (#pt-app (#pt-use integer-of-natural ()) greatest-divisor)))
            (
              (#pt-lambda
                (
                  (quotient #pt-nat)
                  (remainder-certificate
                    (#pt-app
                      (#pt-use exists (0))
                      #pt-nat
                      (#pt-lambda
                        ((candidate-remainder #pt-nat))
                        (#pt-app
                          (#pt-use division-spec ())
                          number
                          (#pt-succ previous)
                          quotient
                          candidate-remainder)))))
                (#pt-induct
                  exists
                  (0)
                  (#pt-nat
                    (#pt-lambda
                      ((candidate-remainder #pt-nat))
                      (#pt-app
                        (#pt-use division-spec ())
                        number
                        (#pt-succ previous)
                        quotient
                        candidate-remainder)))
                  (#pt-lambda
                    (
                      (certificate
                        (#pt-app
                          (#pt-use exists (0))
                          #pt-nat
                          (#pt-lambda
                            ((candidate-remainder #pt-nat))
                            (#pt-app
                              (#pt-use division-spec ())
                              number
                              (#pt-succ previous)
                              quotient
                              candidate-remainder)))))
                    (#pt-app
                      (#pt-use integer-has-bezout ())
                      (#pt-app (#pt-use integer-of-natural ()) number)
                      (#pt-app (#pt-use integer-of-natural ()) (#pt-succ previous))
                      (#pt-app (#pt-use integer-of-natural ()) greatest-divisor)))
                  (
                    (#pt-lambda
                      (
                        (remainder #pt-nat)
                        (division-proof
                          (#pt-app
                            (#pt-use division-spec ())
                            number
                            (#pt-succ previous)
                            quotient
                            remainder)))
                      (#pt-app
                        (#pt-use integer-bezout-euclidean-step ())
                        (#pt-app (#pt-use integer-of-natural ()) number)
                        (#pt-app (#pt-use integer-of-natural ()) (#pt-succ previous))
                        (#pt-app (#pt-use integer-of-natural ()) quotient)
                        (#pt-app (#pt-use integer-of-natural ()) remainder)
                        (#pt-app (#pt-use integer-of-natural ()) greatest-divisor)
                        (#pt-app
                          (#pt-use integer-natural-division-equation ())
                          number
                          (#pt-succ previous)
                          quotient
                          remainder
                          (#pt-app
                            (#pt-use conjunction-left ())
                            (#pt-eq
                              #pt-nat
                              number
                              (#pt-app
                                (#pt-use add ())
                                (#pt-app (#pt-use multiply ()) quotient (#pt-succ previous))
                                remainder))
                            (#pt-app (#pt-use less-than ()) remainder (#pt-succ previous))
                            division-proof))
                        (#pt-app
                          (#pt-app
                            smaller-cases
                            remainder
                            (#pt-app
                              (#pt-use conjunction-right ())
                              (#pt-eq
                                #pt-nat
                                number
                                (#pt-app
                                  (#pt-use add ())
                                  (#pt-app (#pt-use multiply ()) quotient (#pt-succ previous))
                                  remainder))
                              (#pt-app (#pt-use less-than ()) remainder (#pt-succ previous))
                              division-proof))
                          (#pt-succ previous)
                          greatest-divisor
                          (#pt-app
                            (#pt-use gcd-euclidean-reverse ())
                            number
                            (#pt-succ previous)
                            quotient
                            remainder
                            division-proof
                            greatest-divisor
                            gcd-proof)))))
                  remainder-certificate)))
            (#pt-app
              (#pt-use division-exists ())
              number
              (#pt-succ previous)
              (#pt-app (#pt-use zero-less-successor ()) previous))))
        stage)
      given-history)))
(#theorem natural-gcd-bezout
  (#universes)
  (#parameters
    (#parameter dividend #pt-nat)
    (#parameter divisor #pt-nat)
    (#parameter greatest-divisor #pt-nat)
    (#parameter gcd-proof (#pt-app (#pt-use gcd-spec ()) dividend divisor greatest-divisor)))
  (#statement
    (#pt-app
      (#pt-use integer-has-bezout ())
      (#pt-app (#pt-use integer-of-natural ()) dividend)
      (#pt-app (#pt-use integer-of-natural ()) divisor)
      (#pt-app (#pt-use integer-of-natural ()) greatest-divisor)))
  (#proof
    (#pt-app
      (#pt-app
        (#pt-app
          (#pt-use strong-induction ())
          (#pt-lambda
            ((index #pt-nat))
            (#pt-pi
              (
                (candidate-number #pt-nat)
                (candidate-gcd #pt-nat)
                (candidate-gcd-proof
                  (#pt-app (#pt-use gcd-spec ()) candidate-number index candidate-gcd)))
              (#pt-app
                (#pt-use integer-has-bezout ())
                (#pt-app (#pt-use integer-of-natural ()) candidate-number)
                (#pt-app (#pt-use integer-of-natural ()) index)
                (#pt-app (#pt-use integer-of-natural ()) candidate-gcd))))
          (#pt-lambda
            (
              (induction-stage #pt-nat)
              (induction-history
                (#pt-pi
                  (
                    (earlier #pt-nat)
                    (earlier-proof (#pt-app (#pt-use less-than ()) earlier induction-stage)))
                  (#pt-pi
                    (
                      (candidate-number #pt-nat)
                      (candidate-gcd #pt-nat)
                      (candidate-gcd-proof
                        (#pt-app (#pt-use gcd-spec ()) candidate-number earlier candidate-gcd)))
                    (#pt-app
                      (#pt-use integer-has-bezout ())
                      (#pt-app (#pt-use integer-of-natural ()) candidate-number)
                      (#pt-app (#pt-use integer-of-natural ()) earlier)
                      (#pt-app (#pt-use integer-of-natural ()) candidate-gcd))))))
            (#pt-app (#pt-use natural-bezout-induction-step ()) induction-stage induction-history)))
        divisor)
      dividend
      greatest-divisor
      gcd-proof)))
