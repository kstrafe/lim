; Explicit signed linear combinations and existential Bezout certificates.
; A certificate contains both integer coefficients and a checked equation.
(#alias exists = ./logic-exists.lim::exists)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#math-definition integer-bezout-equation ()
  (#pt-pi
    (
      (first (#pt-use integer ()))
      (second (#pt-use integer ()))
      (value (#pt-use integer ()))
      (left-coefficient (#pt-use integer ()))
      (right-coefficient (#pt-use integer ())))
    #pt-prop)
  (#pt-lambda
    (
      (first (#pt-use integer ()))
      (second (#pt-use integer ()))
      (value (#pt-use integer ()))
      (left-coefficient (#pt-use integer ()))
      (right-coefficient (#pt-use integer ())))
    (#pt-app
      (#pt-use integer-equal ())
      value
      (#pt-app
        (#pt-use integer-add ())
        (#pt-app (#pt-use integer-multiply ()) left-coefficient first)
        (#pt-app (#pt-use integer-multiply ()) right-coefficient second)))))
(#math-definition integer-has-bezout ()
  (#pt-pi
    ((first (#pt-use integer ())) (second (#pt-use integer ())) (value (#pt-use integer ())))
    #pt-prop)
  (#pt-lambda
    ((first (#pt-use integer ())) (second (#pt-use integer ())) (value (#pt-use integer ())))
    (#pt-app
      (#pt-use exists (0))
      (#pt-use integer ())
      (#pt-lambda
        ((candidate-left (#pt-use integer ())))
        (#pt-app
          (#pt-use exists (0))
          (#pt-use integer ())
          (#pt-lambda
            ((candidate-right (#pt-use integer ())))
            (#pt-app
              (#pt-use integer-bezout-equation ())
              first
              second
              value
              candidate-left
              candidate-right)))))))
