  =
  ./quadratic-quotient-isomorphism.lim::quadratic-quotient-inverse-morphism)
(#alias quadratic-quotient-linear = ./quadratic-quotient-evaluation.lim::quadratic-quotient-linear)
(#alias quadratic-quotient-ring = ./quadratic-quotient-ring-structure.lim::quadratic-quotient-ring)
(#alias quadratic-ring-structure = ./quadratic-algebra-ring-structure.lim::quadratic-ring-structure)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-evaluation = ./ring-evaluation-data.lim::ring-evaluation)
(#alias ring-evaluation-map = ./ring-evaluation-morphism.lim::ring-evaluation-map)
(#alias ring-evaluation-morphism = ./ring-evaluation-morphism.lim::ring-evaluation-morphism)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#math-definition point-evaluation-quadratic-morphism ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (Image (#pt-type 0))
      (image-ring (#pt-app (#pt-use commutative-ring ()) Image))
      (morphism
        (#pt-app (#pt-use ring-evaluation-morphism ()) Carrier coefficient-ring Image image-ring))
      (quadratic-linear Carrier)
      (quadratic-constant Carrier)
      (image-root Image)
      (quadratic-root
        (#pt-app
          (#pt-use ring-equal ())
          Image
          image-ring
          (#pt-app
            (#pt-use ring-evaluation ())
            Carrier
            coefficient-ring
            Image
            image-ring
            morphism
            image-root
            (#pt-app
              (#pt-use quadratic-division-divisor ())
              Carrier
              coefficient-ring
              quadratic-linear
              quadratic-constant))
          (#pt-app (#pt-use ring-zero ()) Image image-ring))))
    (#pt-app
      (#pt-use ring-evaluation-morphism ())
      (#pt-app (#pt-use quadratic-element ()) Carrier)
      (#pt-app
        (#pt-use quadratic-ring-structure ())
        Carrier
        coefficient-ring
        quadratic-linear
        quadratic-constant)
      Image
      image-ring))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (Image (#pt-type 0))
      (image-ring (#pt-app (#pt-use commutative-ring ()) Image))
      (morphism
        (#pt-app (#pt-use ring-evaluation-morphism ()) Carrier coefficient-ring Image image-ring))
      (quadratic-linear Carrier)
      (quadratic-constant Carrier)
      (image-root Image)
      (quadratic-root
        (#pt-app
          (#pt-use ring-equal ())
          Image
          image-ring
          (#pt-app
            (#pt-use ring-evaluation ())
            Carrier
            coefficient-ring
            Image
            image-ring
            morphism
            image-root
            (#pt-app
              (#pt-use quadratic-division-divisor ())
              Carrier
              coefficient-ring
              quadratic-linear
              quadratic-constant))
          (#pt-app (#pt-use ring-zero ()) Image image-ring))))
    (#pt-app
      (#pt-use point-evaluation-compose ())
      (#pt-app (#pt-use quadratic-element ()) Carrier)
      (#pt-app
        (#pt-use quadratic-ring-structure ())
        Carrier
        coefficient-ring
        quadratic-linear
        quadratic-constant)
      (#pt-app (#pt-use finite-list ()) Carrier)
      (#pt-app
        (#pt-use quadratic-quotient-ring ())
        Carrier
        coefficient-ring
        quadratic-linear
        quadratic-constant)
      (#pt-app
        (#pt-use quadratic-quotient-inverse-morphism ())
        Carrier
        coefficient-ring
        quadratic-linear
        quadratic-constant)
      Image
      image-ring
      (#pt-app
        (#pt-use point-evaluation-quotient-morphism ())
        Carrier
        coefficient-ring
        Image
        image-ring
        morphism
        quadratic-linear
        quadratic-constant
        image-root
        quadratic-root))))
(#theorem point-evaluation-quadratic-mapping
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter Image (#pt-type 0))
    (#parameter image-ring (#pt-app (#pt-use commutative-ring ()) Image))
    (#parameter morphism (#pt-app (#pt-use ring-evaluation-morphism ()) Carrier coefficient-ring Image image-ring))
    (#parameter quadratic-linear Carrier)
    (#parameter quadratic-constant Carrier)
    (#parameter image-root Image)
    (#parameter quadratic-root (#pt-app (#pt-use ring-equal ()) Image image-ring (#pt-app (#pt-use ring-evaluation ()) Carrier coefficient-ring Image image-ring morphism image-root (#pt-app (#pt-use quadratic-division-divisor ()) Carrier coefficient-ring quadratic-linear quadratic-constant)) (#pt-app (#pt-use ring-zero ()) Image image-ring)))
    (#parameter coordinate-element (#pt-app (#pt-use quadratic-element ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Image
      image-ring
      (#pt-app
        (#pt-use ring-evaluation-map ())
        (#pt-app (#pt-use quadratic-element ()) Carrier)
        (#pt-app
          (#pt-use quadratic-ring-structure ())
          Carrier
          coefficient-ring
          quadratic-linear
          quadratic-constant)
        Image
        image-ring
        (#pt-app
          (#pt-use point-evaluation-quadratic-morphism ())
          Carrier
          coefficient-ring
          Image
          image-ring
          morphism
          quadratic-linear
          quadratic-constant
          image-root
          quadratic-root)
        coordinate-element)
      (#pt-app
        (#pt-use ring-evaluation ())
        Carrier
        coefficient-ring
        Image
        image-ring
        morphism
        image-root
        (#pt-app (#pt-use quadratic-quotient-linear ()) Carrier coefficient-ring coordinate-element))))
  (#proof
    (#pt-app
      (#pt-use ring-reflexive ())
      Image
      image-ring
      (#pt-app
        (#pt-use ring-evaluation ())
        Carrier
        coefficient-ring
        Image
        image-ring
        morphism
        image-root
        (#pt-app (#pt-use quadratic-quotient-linear ()) Carrier coefficient-ring coordinate-element)))))
