; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean.
; Generated by scripts/generate-flt-point-evaluation.py; checked native terms.
; Compose the proved coordinate-ring
; inverse correspondence with root evaluation on the quotient.
; This constructs a checked map out of the actual quadratic algebra,
; rather than assuming evaluation preserves its multiplication.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias point-evaluation-compose = ./point-evaluation-composition.lim::point-evaluation-compose)
(#alias
