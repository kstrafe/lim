; Extract the actual exponent, parity and modulo-four certificates
; from a Frey package to construct both integral coefficient divisors.
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-one = ./integer-defs.lim::integer-one)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-power = ./integer-defs.lim::integer-power)
(#alias integer-divides = ./integer-defs.lim::integer-divides)
(#alias frey-package-certificate = ./frey-package.lim::frey-package-certificate)
(#alias large-prime-positive-and-odd = ./frey-package.lim::large-prime-positive-and-odd)
(#alias
  frey-integral-coefficients-divisible
  =
  ./frey-coefficient-divisibility.lim::frey-integral-coefficients-divisible)
(#theorem frey-package-coefficients-divisible
  (#universes)
  (#parameters
    (#parameter first (#pt-use integer ()))
    (#parameter second (#pt-use integer ()))
    (#parameter third (#pt-use integer ()))
    (#parameter exponent #pt-nat)
    (#parameter package (#pt-app (#pt-use frey-package-certificate ()) exponent first second third)))
  (#statement
    (#pt-app
      (#pt-use conjunction ())
      (#pt-app
        (#pt-use integer-divides ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 4))
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app (#pt-use integer-power ()) second exponent)
            (#pt-app (#pt-use integer-negate ()) (#pt-use integer-one ())))
          (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-power ()) first exponent))))
      (#pt-app
        (#pt-use integer-divides ())
        (#pt-app (#pt-use integer-of-natural ()) (#pt-numeral 16))
        (#pt-app
          (#pt-use integer-multiply ())
          (#pt-app (#pt-use integer-negate ()) (#pt-app (#pt-use integer-power ()) first exponent))
          (#pt-app (#pt-use integer-power ()) second exponent)))))
  (#proof
    (#pt-app
      (#pt-use frey-integral-coefficients-divisible ())
      first
      second
      exponent
      (#pt-project conjunction 0 (#pt-project conjunction 1 package))
      (#pt-project
        conjunction
        1
        (#pt-app
          (#pt-use large-prime-positive-and-odd ())
          exponent
          (#pt-project conjunction 0 package)
          (#pt-project conjunction 0 (#pt-project conjunction 1 package))))
      (#pt-project
        conjunction
        0
        (#pt-project
          conjunction
          1
          (#pt-project
            conjunction
            1
            (#pt-project
              conjunction
              1
              (#pt-project
                conjunction
                1
                (#pt-project
                  conjunction
                  0
                  (#pt-project conjunction 1 (#pt-project conjunction 1 package))))))))
      (#pt-project conjunction 1 (#pt-project conjunction 1 (#pt-project conjunction 1 package))))))
