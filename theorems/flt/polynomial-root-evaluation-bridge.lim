; Adapted mathematical source: pinned Mathlib RingTheory/AdjoinRoot.lean
; and AlgebraicGeometry/EllipticCurve/Affine/Point.lean.
; Generated by scripts/generate-flt-point-evaluation.py; checked native terms.
; Actual Horner evaluation equals generic
; evaluation through the checked identity map, by list induction.
; This connects existing operations without changing their definitions.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias
  polynomial-root-identity-morphism
  =
  ./polynomial-root-identity-morphism.lim::polynomial-root-identity-morphism)
(#alias ring-add-congruent = ./commutative-ring-data.lim::ring-add-congruent)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-evaluation = ./ring-evaluation-data.lim::ring-evaluation)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-multiply-congruent = ./commutative-ring-data.lim::ring-multiply-congruent)
(#alias ring-polynomial-evaluate = ./ring-polynomial-data.lim::ring-polynomial-evaluate)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#theorem polynomial-root-evaluation-bridge
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter root Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use ring-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-evaluation ())
        Carrier
        coefficient-ring
        Carrier
        coefficient-ring
        (#pt-app (#pt-use polynomial-root-identity-morphism ()) Carrier coefficient-ring)
        root
        polynomial)
      (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring polynomial root)))
  (#proof
    (#pt-induct
      finite-list
      ()
      (Carrier)
      (#pt-lambda
        ((subject (#pt-app (#pt-use finite-list ()) Carrier)))
        (#pt-app
          (#pt-use ring-equal ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-evaluation ())
            Carrier
            coefficient-ring
            Carrier
            coefficient-ring
            (#pt-app (#pt-use polynomial-root-identity-morphism ()) Carrier coefficient-ring)
            root
            subject)
          (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring subject root)))
      (
        (#pt-app
          (#pt-use ring-reflexive ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))
        (#pt-lambda
          (
            (head Carrier)
            (tail (#pt-app (#pt-use finite-list ()) Carrier))
            (tail-result
              (#pt-app
                (#pt-use ring-equal ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-evaluation ())
                  Carrier
                  coefficient-ring
                  Carrier
                  coefficient-ring
                  (#pt-app (#pt-use polynomial-root-identity-morphism ()) Carrier coefficient-ring)
                  root
                  tail)
                (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring tail root))))
          (#pt-app
            (#pt-use ring-add-congruent ())
            Carrier
            coefficient-ring
            head
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              root
              (#pt-app
                (#pt-use ring-evaluation ())
                Carrier
                coefficient-ring
                Carrier
                coefficient-ring
                (#pt-app (#pt-use polynomial-root-identity-morphism ()) Carrier coefficient-ring)
                root
                tail))
            head
            (#pt-app
              (#pt-use ring-multiply ())
              Carrier
              coefficient-ring
              root
              (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring tail root))
            (#pt-app (#pt-use ring-reflexive ()) Carrier coefficient-ring head)
            (#pt-app
              (#pt-use ring-multiply-congruent ())
              Carrier
              coefficient-ring
              root
              (#pt-app
                (#pt-use ring-evaluation ())
                Carrier
                coefficient-ring
                Carrier
                coefficient-ring
                (#pt-app (#pt-use polynomial-root-identity-morphism ()) Carrier coefficient-ring)
                root
                tail)
              root
              (#pt-app (#pt-use ring-polynomial-evaluate ()) Carrier coefficient-ring tail root)
              (#pt-app (#pt-use ring-reflexive ()) Carrier coefficient-ring root)
              tail-result))))
      polynomial)))
