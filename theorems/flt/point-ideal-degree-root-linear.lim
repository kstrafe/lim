; Generated by scripts/generate-flt-point-ideal-basis.py; checked native terms.
; X-x has actual degree one over every
; supplied coefficient domain. Its leading coefficient is the
; actual nonzero one, and all higher coefficients compute to zero.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias polynomial-root-divisor = ./polynomial-root-division-data.lim::polynomial-root-divisor)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-polynomial-coefficient = ./ring-polynomial-data.lim::ring-polynomial-coefficient)
(#alias
  ring-polynomial-degree-witness
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-degree-witness)
(#alias
  ring-polynomial-domain-data
  =
  ./ring-polynomial-domain-data.lim::ring-polynomial-domain-data)
(#alias
  ring-polynomial-domain-one-nonzero
  =
  ./ring-polynomial-domain-data.lim::ring-polynomial-domain-one-nonzero)
(#alias
  ring-polynomial-support-from
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-support-from)
(#alias ring-reflexive = ./commutative-ring-data.lim::ring-reflexive)
(#alias ring-zero = ./commutative-ring-data.lim::ring-zero)
(#theorem point-ideal-degree-root-linear
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
    (#parameter root Carrier))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-degree-witness ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
      (#pt-numeral 1)))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-pi
        (
          (denied-evidence
            (#pt-app
              (#pt-use ring-equal ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-coefficient ())
                Carrier
                coefficient-ring
                (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
                (#pt-numeral 1))
              (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))
        #pt-false)
      (#pt-app
        (#pt-use ring-polynomial-support-from ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use polynomial-root-divisor ()) Carrier coefficient-ring root)
        (#pt-numeral 2))
      (#pt-app
        (#pt-use ring-polynomial-domain-one-nonzero ())
        Carrier
        coefficient-ring
        coefficient-domain)
      (#pt-lambda
        ((offset #pt-nat))
        (#pt-app
          (#pt-use ring-reflexive ())
          Carrier
          coefficient-ring
          (#pt-app (#pt-use ring-zero ()) Carrier coefficient-ring))))))
