; Adapted source: pinned Mathlib Affine/Point.lean:409-470.
; All polynomial, coefficient-domain and index facts are proved.
; Generated by scripts/generate-flt-norm-degrees.py; checked native terms.
; If dp=dq+2+gap, the cross and cubic terms have
; support strictly below the square leading degree2*dp. Regrouping
; and strict dominance prove the actual norm has that degree.
; The boundary gap0 is retained, with no division by2 or3.
(#alias add = ./../fermat_statement.lim::add)
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias
  coordinate-norm-degree-cross-bound
  =
  ./coordinate-norm-degree-term-bounds.lim::coordinate-norm-degree-cross-bound)
(#alias
  coordinate-norm-degree-cubic-term
  =
  ./coordinate-norm-degree-term-bounds.lim::coordinate-norm-degree-cubic-term)
(#alias
  coordinate-norm-degree-high-cross-gap
  =
  ./coordinate-norm-degree-index-gaps.lim::coordinate-norm-degree-high-cross-gap)
(#alias
  coordinate-norm-degree-high-cubic-gap
  =
  ./coordinate-norm-degree-index-gaps.lim::coordinate-norm-degree-high-cubic-gap)
(#alias
  coordinate-norm-degree-polynomial
  =
  ./coordinate-norm-degree-formula.lim::coordinate-norm-degree-polynomial)
(#alias
  coordinate-norm-degree-regroup
  =
  ./coordinate-norm-degree-regroup.lim::coordinate-norm-degree-regroup)
(#alias
  coordinate-norm-degree-square
  =
  ./coordinate-norm-degree-term-bounds.lim::coordinate-norm-degree-square)
(#alias
  coordinate-norm-degree-transfer
  =
  ./coordinate-norm-degree-formula.lim::coordinate-norm-degree-transfer)
(#alias
  coordinate-norm-degree-value
  =
  ./coordinate-norm-degree-formula.lim::coordinate-norm-degree-value)
(#alias
  coordinate-norm-degree-weaken-support
  =
  ./coordinate-norm-degree-support-gaps.lim::coordinate-norm-degree-weaken-support)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias ring-polynomial-add = ./ring-polynomial-data.lim::ring-polynomial-add)
(#alias
  ring-polynomial-degree-congruent
  =
  ./ring-polynomial-degree-leading.lim::ring-polynomial-degree-congruent)
(#alias
  ring-polynomial-degree-subtract-left-dominant
  =
  ./ring-polynomial-degree-dominance.lim::ring-polynomial-degree-subtract-left-dominant)
(#alias
  ring-polynomial-degree-witness
  =
  ./ring-polynomial-support-data.lim::ring-polynomial-degree-witness)
(#alias
  ring-polynomial-domain-data
  =
  ./ring-polynomial-domain-data.lim::ring-polynomial-domain-data)
(#alias ring-polynomial-multiply = ./ring-polynomial-data.lim::ring-polynomial-multiply)
(#alias ring-polynomial-negate = ./ring-polynomial-data.lim::ring-polynomial-negate)
(#alias
  ring-polynomial-support-add
  =
  ./ring-polynomial-support-operations.lim::ring-polynomial-support-add)
(#alias ring-polynomial-symmetric = ./ring-polynomial-equivalence.lim::ring-polynomial-symmetric)
(#alias
  weierstrass-coordinate-cubic
  =
  ./weierstrass-coordinate-normal-form.lim::weierstrass-coordinate-cubic)
(#alias
  weierstrass-coordinate-linear
  =
  ./weierstrass-coordinate-normal-form.lim::weierstrass-coordinate-linear)
(#theorem coordinate-norm-degree-square-dominant
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
    (#parameter a1 Carrier)
    (#parameter a2 Carrier)
    (#parameter a3 Carrier)
    (#parameter a4 Carrier)
    (#parameter a6 Carrier)
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter other-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter constant-degree #pt-nat)
    (#parameter linear-degree #pt-nat)
    (#parameter gap #pt-nat)
    (#parameter constant-certificate (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring polynomial constant-degree))
    (#parameter linear-certificate (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring other-polynomial linear-degree))
    (#parameter high-relation (#pt-eq #pt-nat constant-degree (#pt-app (#pt-use add ()) (#pt-succ (#pt-succ linear-degree)) gap))))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-degree-witness ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use coordinate-norm-degree-value ())
        Carrier
        coefficient-ring
        a1
        a2
        a3
        a4
        a6
        polynomial
        other-polynomial)
      (#pt-app (#pt-use add ()) constant-degree constant-degree)))
  (#proof
    (#pt-app
      (#pt-use coordinate-norm-degree-transfer ())
      Carrier
      coefficient-ring
      a1
      a2
      a3
      a4
      a6
      polynomial
      other-polynomial
      (#pt-app (#pt-use add ()) constant-degree constant-degree)
      (#pt-app
        (#pt-use ring-polynomial-degree-congruent ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-polynomial-add ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-multiply ())
            Carrier
            coefficient-ring
            polynomial
            polynomial)
          (#pt-app
            (#pt-use ring-polynomial-negate ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-add ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-multiply ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-polynomial-multiply ())
                  Carrier
                  coefficient-ring
                  polynomial
                  other-polynomial)
                (#pt-app
                  (#pt-use weierstrass-coordinate-linear ())
                  Carrier
                  coefficient-ring
                  a1
                  a2
                  a3
                  a4
                  a6))
              (#pt-app
                (#pt-use ring-polynomial-multiply ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-polynomial-multiply ())
                  Carrier
                  coefficient-ring
                  other-polynomial
                  other-polynomial)
                (#pt-app
                  (#pt-use weierstrass-coordinate-cubic ())
                  Carrier
                  coefficient-ring
                  a1
                  a2
                  a3
                  a4
                  a6)))))
        (#pt-app
          (#pt-use coordinate-norm-degree-polynomial ())
          Carrier
          coefficient-ring
          a1
          a2
          a3
          a4
          a6
          polynomial
          other-polynomial)
        (#pt-app (#pt-use add ()) constant-degree constant-degree)
        (#pt-app
          (#pt-use ring-polynomial-symmetric ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use coordinate-norm-degree-polynomial ())
            Carrier
            coefficient-ring
            a1
            a2
            a3
            a4
            a6
            polynomial
            other-polynomial)
          (#pt-app
            (#pt-use ring-polynomial-add ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-multiply ())
              Carrier
              coefficient-ring
              polynomial
              polynomial)
            (#pt-app
              (#pt-use ring-polynomial-negate ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-add ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-polynomial-multiply ())
                  Carrier
                  coefficient-ring
                  (#pt-app
                    (#pt-use ring-polynomial-multiply ())
                    Carrier
                    coefficient-ring
                    polynomial
                    other-polynomial)
                  (#pt-app
                    (#pt-use weierstrass-coordinate-linear ())
                    Carrier
                    coefficient-ring
                    a1
                    a2
                    a3
                    a4
                    a6))
                (#pt-app
                  (#pt-use ring-polynomial-multiply ())
                  Carrier
                  coefficient-ring
                  (#pt-app
                    (#pt-use ring-polynomial-multiply ())
                    Carrier
                    coefficient-ring
                    other-polynomial
                    other-polynomial)
                  (#pt-app
                    (#pt-use weierstrass-coordinate-cubic ())
                    Carrier
                    coefficient-ring
                    a1
                    a2
                    a3
                    a4
                    a6)))))
          (#pt-app
            (#pt-use coordinate-norm-degree-regroup ())
            Carrier
            coefficient-ring
            a1
            a2
            a3
            a4
            a6
            polynomial
            other-polynomial))
        (#pt-app
          (#pt-use ring-polynomial-degree-subtract-left-dominant ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-multiply ())
            Carrier
            coefficient-ring
            polynomial
            polynomial)
          (#pt-app
            (#pt-use ring-polynomial-add ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-multiply ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-multiply ())
                Carrier
                coefficient-ring
                polynomial
                other-polynomial)
              (#pt-app
                (#pt-use weierstrass-coordinate-linear ())
                Carrier
                coefficient-ring
                a1
                a2
                a3
                a4
                a6))
            (#pt-app
              (#pt-use ring-polynomial-multiply ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-multiply ())
                Carrier
                coefficient-ring
                other-polynomial
                other-polynomial)
              (#pt-app
                (#pt-use weierstrass-coordinate-cubic ())
                Carrier
                coefficient-ring
                a1
                a2
                a3
                a4
                a6)))
          (#pt-app (#pt-use add ()) constant-degree constant-degree)
          (#pt-app
            (#pt-use coordinate-norm-degree-square ())
            Carrier
            coefficient-ring
            coefficient-domain
            a1
            a2
            a3
            a4
            a6
            polynomial
            constant-degree
            constant-certificate)
          (#pt-app
            (#pt-use ring-polynomial-support-add ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-polynomial-multiply ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-multiply ())
                Carrier
                coefficient-ring
                polynomial
                other-polynomial)
              (#pt-app
                (#pt-use weierstrass-coordinate-linear ())
                Carrier
                coefficient-ring
                a1
                a2
                a3
                a4
                a6))
            (#pt-app
              (#pt-use ring-polynomial-multiply ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-multiply ())
                Carrier
                coefficient-ring
                other-polynomial
                other-polynomial)
              (#pt-app
                (#pt-use weierstrass-coordinate-cubic ())
                Carrier
                coefficient-ring
                a1
                a2
                a3
                a4
                a6))
            (#pt-app (#pt-use add ()) constant-degree constant-degree)
            (#pt-app
              (#pt-use coordinate-norm-degree-weaken-support ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-multiply ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-polynomial-multiply ())
                  Carrier
                  coefficient-ring
                  polynomial
                  other-polynomial)
                (#pt-app
                  (#pt-use weierstrass-coordinate-linear ())
                  Carrier
                  coefficient-ring
                  a1
                  a2
                  a3
                  a4
                  a6))
              (#pt-succ
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use add ()) constant-degree linear-degree)
                  (#pt-numeral 1)))
              gap
              (#pt-app (#pt-use add ()) constant-degree constant-degree)
              (#pt-app
                (#pt-use coordinate-norm-degree-cross-bound ())
                Carrier
                coefficient-ring
                coefficient-domain
                a1
                a2
                a3
                a4
                a6
                polynomial
                other-polynomial
                constant-degree
                linear-degree
                (#pt-project conjunction 1 constant-certificate)
                (#pt-project conjunction 1 linear-certificate))
              (#pt-app
                (#pt-use coordinate-norm-degree-high-cross-gap ())
                constant-degree
                linear-degree
                gap
                high-relation))
            (#pt-app
              (#pt-use coordinate-norm-degree-weaken-support ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-multiply ())
                Carrier
                coefficient-ring
                (#pt-app
                  (#pt-use ring-polynomial-multiply ())
                  Carrier
                  coefficient-ring
                  other-polynomial
                  other-polynomial)
                (#pt-app
                  (#pt-use weierstrass-coordinate-cubic ())
                  Carrier
                  coefficient-ring
                  a1
                  a2
                  a3
                  a4
                  a6))
              (#pt-succ
                (#pt-app
                  (#pt-use add ())
                  (#pt-app (#pt-use add ()) linear-degree linear-degree)
                  (#pt-numeral 3)))
              (#pt-app (#pt-use add ()) gap gap)
              (#pt-app (#pt-use add ()) constant-degree constant-degree)
              (#pt-project
                conjunction
                1
                (#pt-app
                  (#pt-use coordinate-norm-degree-cubic-term ())
                  Carrier
                  coefficient-ring
                  coefficient-domain
                  a1
                  a2
                  a3
                  a4
                  a6
                  other-polynomial
                  linear-degree
                  linear-certificate))
              (#pt-app
                (#pt-use coordinate-norm-degree-high-cubic-gap ())
                constant-degree
                linear-degree
                gap
                high-relation))))))))
