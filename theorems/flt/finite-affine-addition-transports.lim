(#theorem finite-residue-zero-sum-first
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter first-value (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second-value (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter sum-zero (#pt-eq #pt-nat (#pt-project finite-residue 0 (#pt-app (#pt-use finite-residue-add ()) modulus positive-modulus first-value second-value)) (#pt-project finite-residue 0 (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus)))))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project finite-residue 0 first-value)
      (#pt-project
        finite-residue
        0
        (#pt-app (#pt-use finite-residue-negate ()) modulus positive-modulus second-value))))
  (#proof
    (#pt-app
      (#pt-use finite-residue-add-cancel-right ())
      modulus
      positive-modulus
      first-value
      (#pt-app (#pt-use finite-residue-negate ()) modulus positive-modulus second-value)
      second-value
      (#pt-app
        (#pt-use transitivity (0))
        #pt-nat
        (#pt-project
          finite-residue
          0
          (#pt-app
            (#pt-use finite-residue-add ())
            modulus
            positive-modulus
            first-value
            second-value))
        (#pt-project
          finite-residue
          0
          (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus))
        (#pt-project
          finite-residue
          0
          (#pt-app
            (#pt-use finite-residue-add ())
            modulus
            positive-modulus
            (#pt-app (#pt-use finite-residue-negate ()) modulus positive-modulus second-value)
            second-value))
        sum-zero
        (#pt-app
          (#pt-use symmetry (0))
          #pt-nat
          (#pt-project
            finite-residue
            0
            (#pt-app
              (#pt-use finite-residue-add ())
              modulus
              positive-modulus
              (#pt-app (#pt-use finite-residue-negate ()) modulus positive-modulus second-value)
              second-value))
          (#pt-project
            finite-residue
            0
            (#pt-app (#pt-use finite-residue-zero ()) modulus positive-modulus))
          (#pt-app
            (#pt-use finite-residue-add-inverse-left-zero ())
            modulus
            positive-modulus
            second-value))))))
(#theorem finite-residue-apply-congruent
  (#universes)
  (#parameters
    (#parameter modulus #pt-nat)
    (#parameter positive-modulus (#pt-app (#pt-use less-than ()) #pt-zero modulus))
    (#parameter operation (#pt-pi ((function-input (#pt-app (#pt-use finite-residue ()) modulus))) (#pt-app (#pt-use finite-residue ()) modulus)))
    (#parameter first-value (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter second-value (#pt-app (#pt-use finite-residue ()) modulus))
    (#parameter input-equation (#pt-eq #pt-nat (#pt-project finite-residue 0 first-value) (#pt-project finite-residue 0 second-value))))
  (#statement
    (#pt-eq
      #pt-nat
      (#pt-project finite-residue 0 (#pt-app operation first-value))
      (#pt-project finite-residue 0 (#pt-app operation second-value))))
  (#proof
    (#pt-app
      (#pt-use congruence (0 0))
      (#pt-app (#pt-use finite-residue ()) modulus)
      #pt-nat
      (#pt-lambda
        ((function-input (#pt-app (#pt-use finite-residue ()) modulus)))
        (#pt-project finite-residue 0 (#pt-app operation function-input)))
      first-value
      second-value
      (#pt-app
        (#pt-use finite-residue-extensional ())
        modulus
        positive-modulus
        first-value
        second-value
        input-equation))))
