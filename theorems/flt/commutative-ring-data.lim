(#math-inductive commutative-ring ()
  ((Carrier (#pt-type 0)))
  (#pt-type 0)
  (
    (structure
      (
        (zero Carrier)
        (one Carrier)
        (addition (#pt-pi ((first Carrier) (second Carrier)) Carrier))
        (negation (#pt-pi ((first Carrier)) Carrier))
        (multiplication (#pt-pi ((first Carrier) (second Carrier)) Carrier))
        (equality (#pt-pi ((first Carrier) (second Carrier)) #pt-prop))
        (reflexive-law (#pt-pi ((first Carrier)) (#pt-app equality first first)))
        (symmetric-law
          (#pt-pi
            ((first Carrier) (second Carrier) (equation (#pt-app equality first second)))
            (#pt-app equality second first)))
        (transitive-law
          (#pt-pi
            (
              (first Carrier)
              (second Carrier)
              (third Carrier)
              (first-equation (#pt-app equality first second))
              (second-equation (#pt-app equality second third)))
            (#pt-app equality first third)))
        (add-congruent-law
          (#pt-pi
            (
              (first Carrier)
              (second Carrier)
              (third Carrier)
              (fourth Carrier)
              (first-equation (#pt-app equality first third))
              (second-equation (#pt-app equality second fourth)))
            (#pt-app equality (#pt-app addition first second) (#pt-app addition third fourth))))
        (multiply-congruent-law
          (#pt-pi
            (
              (first Carrier)
              (second Carrier)
              (third Carrier)
              (fourth Carrier)
              (first-equation (#pt-app equality first third))
              (second-equation (#pt-app equality second fourth)))
            (#pt-app
              equality
              (#pt-app multiplication first second)
              (#pt-app multiplication third fourth))))
        (negate-congruent-law
          (#pt-pi
            ((first Carrier) (second Carrier) (equation (#pt-app equality first second)))
            (#pt-app equality (#pt-app negation first) (#pt-app negation second))))
        (add-zero-law
          (#pt-pi ((first Carrier)) (#pt-app equality (#pt-app addition first zero) first)))
        (add-associative-law
          (#pt-pi
            ((first Carrier) (second Carrier) (third Carrier))
            (#pt-app
              equality
              (#pt-app addition (#pt-app addition first second) third)
              (#pt-app addition first (#pt-app addition second third)))))
        (add-commutative-law
          (#pt-pi
            ((first Carrier) (second Carrier))
            (#pt-app equality (#pt-app addition first second) (#pt-app addition second first))))
        (add-inverse-law
          (#pt-pi
            ((first Carrier))
            (#pt-app equality (#pt-app addition first (#pt-app negation first)) zero)))
        (multiply-one-law
          (#pt-pi ((first Carrier)) (#pt-app equality (#pt-app multiplication first one) first)))
        (multiply-associative-law
          (#pt-pi
            ((first Carrier) (second Carrier) (third Carrier))
            (#pt-app
              equality
              (#pt-app multiplication (#pt-app multiplication first second) third)
              (#pt-app multiplication first (#pt-app multiplication second third)))))
        (multiply-commutative-law
          (#pt-pi
            ((first Carrier) (second Carrier))
            (#pt-app
              equality
              (#pt-app multiplication first second)
              (#pt-app multiplication second first))))
        (distributive-law
          (#pt-pi
            ((first Carrier) (second Carrier) (third Carrier))
            (#pt-app
              equality
              (#pt-app multiplication first (#pt-app addition second third))
              (#pt-app
                addition
                (#pt-app multiplication first second)
                (#pt-app multiplication first third)))))
        (multiply-zero-law
          (#pt-pi ((first Carrier)) (#pt-app equality (#pt-app multiplication first zero) zero)))))))
