; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Prove the forward distributive inclusion
; by sum minimality in the colon ideal and product minimality.
; The two generator inclusions are separately checked lemmas.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias ring-ideal = ./ring-ideal-data.lim::ring-ideal)
(#alias ring-ideal-colon-element = ./ring-ideal-colon-element.lim::ring-ideal-colon-element)
(#alias ring-ideal-member = ./ring-ideal-data.lim::ring-ideal-member)
(#alias ring-ideal-product = ./ring-ideal-product.lim::ring-ideal-product)
(#alias
  ring-ideal-product-from-colon
  =
  ./ring-ideal-colon-factorization.lim::ring-ideal-product-from-colon)
(#alias
  ring-ideal-product-sum-colon-left
  =
  ./ring-ideal-product-sum-colon.lim::ring-ideal-product-sum-colon-left)
(#alias
  ring-ideal-product-sum-colon-right
  =
  ./ring-ideal-product-sum-colon.lim::ring-ideal-product-sum-colon-right)
(#alias ring-ideal-subset = ./ring-ideal-data.lim::ring-ideal-subset)
(#alias ring-ideal-sum = ./ring-ideal-sum.lim::ring-ideal-sum)
(#alias ring-ideal-sum-least = ./ring-ideal-sum-universal.lim::ring-ideal-sum-least)
(#theorem ring-ideal-product-distribute-first-inclusion
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter third-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-ideal-product ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)
        third-ideal)
      (#pt-app
        (#pt-use ring-ideal-sum ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal third-ideal)
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring second-ideal third-ideal))))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-product-from-colon ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-sum ()) Carrier coefficient-ring first-ideal second-ideal)
      third-ideal
      (#pt-app
        (#pt-use ring-ideal-sum ())
        Carrier
        coefficient-ring
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring first-ideal third-ideal)
        (#pt-app (#pt-use ring-ideal-product ()) Carrier coefficient-ring second-ideal third-ideal))
      (#pt-lambda
        (
          (last-factor Carrier)
          (last-member
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              third-ideal
              last-factor)))
        (#pt-app
          (#pt-use ring-ideal-sum-least ())
          Carrier
          coefficient-ring
          first-ideal
          second-ideal
          (#pt-app
            (#pt-use ring-ideal-colon-element ())
            Carrier
            coefficient-ring
            (#pt-app
              (#pt-use ring-ideal-sum ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-ideal-product ())
                Carrier
                coefficient-ring
                first-ideal
                third-ideal)
              (#pt-app
                (#pt-use ring-ideal-product ())
                Carrier
                coefficient-ring
                second-ideal
                third-ideal))
            last-factor)
          (#pt-app
            (#pt-use ring-ideal-product-sum-colon-left ())
            Carrier
            coefficient-ring
            first-ideal
            second-ideal
            third-ideal
            last-factor
            last-member)
          (#pt-app
            (#pt-use ring-ideal-product-sum-colon-right ())
            Carrier
            coefficient-ring
            first-ideal
            second-ideal
            third-ideal
            last-factor
            last-member))))))
