; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Instantiate the proved four-generator
; ideal product with the actual X/Y coordinate classes. This is
; the source span_pair_mul_span_pair step; the later point equation,
; nonsingularity, quotient, class group and injection remain open.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias
  coordinate-point-ideal-X-class
  =
  ./coordinate-point-ideal-data.lim::coordinate-point-ideal-X-class)
(#alias coordinate-point-ideal-XY = ./coordinate-point-ideal-data.lim::coordinate-point-ideal-XY)
(#alias
  coordinate-point-ideal-Y-class
  =
  ./coordinate-point-ideal-data.lim::coordinate-point-ideal-Y-class)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias quadratic-constant = ./quadratic-algebra-data.lim::quadratic-constant)
(#alias quadratic-element = ./quadratic-algebra-data.lim::quadratic-element)
(#alias quadratic-ring-structure = ./quadratic-algebra-ring-structure.lim::quadratic-ring-structure)
(#alias ring-ideal-equal = ./ring-ideal-data.lim::ring-ideal-equal)
(#alias ring-ideal-pair = ./ring-ideal-pair.lim::ring-ideal-pair)
(#alias ring-ideal-pair-product = ./ring-ideal-pair-product.lim::ring-ideal-pair-product)
(#alias ring-ideal-product = ./ring-ideal-product.lim::ring-ideal-product)
(#alias ring-ideal-sum = ./ring-ideal-sum.lim::ring-ideal-sum)
(#alias ring-multiply = ./commutative-ring-data.lim::ring-multiply)
(#alias ring-polynomial-structure = ./ring-polynomial-structure.lim::ring-polynomial-structure)
(#theorem coordinate-point-ideal-product-expansion
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter quadratic-linear (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter quadratic-constant (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter root Carrier)
    (#parameter Y-polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter second-root Carrier)
    (#parameter second-Y-polynomial (#pt-app (#pt-use finite-list ()) Carrier)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
      (#pt-app
        (#pt-use quadratic-ring-structure ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        quadratic-linear
        quadratic-constant)
      (#pt-app
        (#pt-use ring-ideal-product ())
        (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
        (#pt-app
          (#pt-use quadratic-ring-structure ())
          (#pt-app (#pt-use finite-list ()) Carrier)
          (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
          quadratic-linear
          quadratic-constant)
        (#pt-app
          (#pt-use coordinate-point-ideal-XY ())
          Carrier
          coefficient-ring
          quadratic-linear
          quadratic-constant
          root
          Y-polynomial)
        (#pt-app
          (#pt-use coordinate-point-ideal-XY ())
          Carrier
          coefficient-ring
          quadratic-linear
          quadratic-constant
          second-root
          second-Y-polynomial))
      (#pt-app
        (#pt-use ring-ideal-sum ())
        (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
        (#pt-app
          (#pt-use quadratic-ring-structure ())
          (#pt-app (#pt-use finite-list ()) Carrier)
          (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
          quadratic-linear
          quadratic-constant)
        (#pt-app
          (#pt-use ring-ideal-pair ())
          (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
          (#pt-app
            (#pt-use quadratic-ring-structure ())
            (#pt-app (#pt-use finite-list ()) Carrier)
            (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
            quadratic-linear
            quadratic-constant)
          (#pt-app
            (#pt-use ring-multiply ())
            (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
            (#pt-app
              (#pt-use quadratic-ring-structure ())
              (#pt-app (#pt-use finite-list ()) Carrier)
              (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
              quadratic-linear
              quadratic-constant)
            (#pt-app (#pt-use coordinate-point-ideal-X-class ()) Carrier coefficient-ring root)
            (#pt-app
              (#pt-use coordinate-point-ideal-X-class ())
              Carrier
              coefficient-ring
              second-root))
          (#pt-app
            (#pt-use ring-multiply ())
            (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
            (#pt-app
              (#pt-use quadratic-ring-structure ())
              (#pt-app (#pt-use finite-list ()) Carrier)
              (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
              quadratic-linear
              quadratic-constant)
            (#pt-app (#pt-use coordinate-point-ideal-X-class ()) Carrier coefficient-ring root)
            (#pt-app
              (#pt-use coordinate-point-ideal-Y-class ())
              Carrier
              coefficient-ring
              second-Y-polynomial)))
        (#pt-app
          (#pt-use ring-ideal-pair ())
          (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
          (#pt-app
            (#pt-use quadratic-ring-structure ())
            (#pt-app (#pt-use finite-list ()) Carrier)
            (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
            quadratic-linear
            quadratic-constant)
          (#pt-app
            (#pt-use ring-multiply ())
            (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
            (#pt-app
              (#pt-use quadratic-ring-structure ())
              (#pt-app (#pt-use finite-list ()) Carrier)
              (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
              quadratic-linear
              quadratic-constant)
            (#pt-app
              (#pt-use coordinate-point-ideal-Y-class ())
              Carrier
              coefficient-ring
              Y-polynomial)
            (#pt-app
              (#pt-use coordinate-point-ideal-X-class ())
              Carrier
              coefficient-ring
              second-root))
          (#pt-app
            (#pt-use ring-multiply ())
            (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
            (#pt-app
              (#pt-use quadratic-ring-structure ())
              (#pt-app (#pt-use finite-list ()) Carrier)
              (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
              quadratic-linear
              quadratic-constant)
            (#pt-app
              (#pt-use coordinate-point-ideal-Y-class ())
              Carrier
              coefficient-ring
              Y-polynomial)
            (#pt-app
              (#pt-use coordinate-point-ideal-Y-class ())
              Carrier
              coefficient-ring
              second-Y-polynomial))))))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-pair-product ())
      (#pt-app (#pt-use quadratic-element ()) (#pt-app (#pt-use finite-list ()) Carrier))
      (#pt-app
        (#pt-use quadratic-ring-structure ())
        (#pt-app (#pt-use finite-list ()) Carrier)
        (#pt-app (#pt-use ring-polynomial-structure ()) Carrier coefficient-ring)
        quadratic-linear
        quadratic-constant)
      (#pt-app (#pt-use coordinate-point-ideal-X-class ()) Carrier coefficient-ring root)
      (#pt-app (#pt-use coordinate-point-ideal-Y-class ()) Carrier coefficient-ring Y-polynomial)
      (#pt-app (#pt-use coordinate-point-ideal-X-class ()) Carrier coefficient-ring second-root)
      (#pt-app
        (#pt-use coordinate-point-ideal-Y-class ())
        Carrier
        coefficient-ring
        second-Y-polynomial))))
