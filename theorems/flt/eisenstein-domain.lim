; No zero divisors and cancellation for concrete Eisenstein equivalence.
; Norm multiplicativity and nondegeneracy reduce products to the proved
; integer domain. All equality cases and cancellation steps are constructive.
(#alias eisenstein = ./eisenstein-defs.lim::eisenstein)
(#alias eisenstein-zero = ./eisenstein-defs.lim::eisenstein-zero)
(#alias eisenstein-one = ./eisenstein-defs.lim::eisenstein-one)
(#alias eisenstein-lambda = ./eisenstein-defs.lim::eisenstein-lambda)
(#alias eisenstein-of-integer = ./eisenstein-defs.lim::eisenstein-of-integer)
(#alias eisenstein-equal = ./eisenstein-defs.lim::eisenstein-equal)
(#alias eisenstein-add = ./eisenstein-defs.lim::eisenstein-add)
(#alias eisenstein-negate = ./eisenstein-defs.lim::eisenstein-negate)
(#alias eisenstein-multiply = ./eisenstein-defs.lim::eisenstein-multiply)
(#alias integer = ./integer-defs.lim::integer)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-zero = ./integer-defs.lim::integer-zero)
(#alias integer-one = ./integer-defs.lim::integer-one)
(#alias integer-equal = ./integer-defs.lim::integer-equal)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias eisenstein-reflexive = ./eisenstein-equality.lim::eisenstein-reflexive)
(#alias eisenstein-symmetric = ./eisenstein-equality.lim::eisenstein-symmetric)
(#alias eisenstein-transitive = ./eisenstein-equality.lim::eisenstein-transitive)
(#alias eisenstein-multiply-congruent = ./eisenstein-equality.lim::eisenstein-multiply-congruent)
(#alias eisenstein-add-congruent = ./eisenstein-equality.lim::eisenstein-add-congruent)
(#alias
  eisenstein-of-integer-injective
  =
  ./eisenstein-equality.lim::eisenstein-of-integer-injective)
(#alias integer-reflexive = ./integer-equality.lim::integer-reflexive)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias integer-add-congruent = ./integer-equality.lim::integer-add-congruent)
(#alias integer-negate-congruent = ./integer-equality.lim::integer-negate-congruent)
(#alias integer-multiply-congruent = ./integer-multiplication.lim::integer-multiply-congruent)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias conjunction-left = ./logical-connectives.lim::conjunction-left)
(#alias conjunction-right = ./logical-connectives.lim::conjunction-right)
(#alias eisenstein-conjugate = ./eisenstein-norm-defs.lim::eisenstein-conjugate)
(#alias eisenstein-norm = ./eisenstein-norm-defs.lim::eisenstein-norm)
(#alias eisenstein-natural-norm = ./eisenstein-norm-defs.lim::eisenstein-natural-norm)
(#alias integer-equality-decided = ./integer-domain.lim::integer-equality-decided)
(#alias integer-nonzero-product = ./integer-domain.lim::integer-nonzero-product)
(#alias eisenstein-nonzero-norm = ./eisenstein-norm-nondegenerate.lim::eisenstein-nonzero-norm)
(#alias
  eisenstein-zero-implies-norm-zero
  =
  ./eisenstein-norm-nondegenerate.lim::eisenstein-zero-implies-norm-zero)
(#alias eisenstein-norm-multiply = ./eisenstein-norm-multiply.lim::eisenstein-norm-multiply)
(#alias integer-zero-difference = ./integer-linear-identities.lim::integer-zero-difference)
(#alias false-elimination = ./logic-false.lim::false-elimination)
(#alias eisenstein-add-inverse = ./eisenstein-ring.lim::eisenstein-add-inverse)
(#alias
  eisenstein-multiply-distribute-second
  =
  ./eisenstein-ring.lim::eisenstein-multiply-distribute-second)
(#alias
  eisenstein-multiply-negative-second
  =
  ./eisenstein-ring.lim::eisenstein-multiply-negative-second)
(#alias eisenstein-multiply-commutative = ./eisenstein-ring.lim::eisenstein-multiply-commutative)
(#alias disjunction = ./logical-connectives.lim::disjunction)
(#alias disjunction-left = ./logical-connectives.lim::disjunction-left)
(#alias disjunction-right = ./logical-connectives.lim::disjunction-right)
(#alias disjunction-eliminate = ./logical-connectives.lim::disjunction-eliminate)
(#theorem eisenstein-equality-decided
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ())))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app (#pt-use eisenstein-equal ()) first second)
      (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) first second))) #pt-false)))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project eisenstein 0 first)
        (#pt-project eisenstein 0 second))
      (#pt-pi
        (
          (denied-proof
            (#pt-app
              (#pt-use integer-equal ())
              (#pt-project eisenstein 0 first)
              (#pt-project eisenstein 0 second))))
        #pt-false)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-app (#pt-use eisenstein-equal ()) first second)
        (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) first second))) #pt-false))
      (#pt-lambda
        (
          (real-equivalent
            (#pt-app
              (#pt-use integer-equal ())
              (#pt-project eisenstein 0 first)
              (#pt-project eisenstein 0 second))))
        (#pt-app
          (#pt-use disjunction-eliminate ())
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-project eisenstein 1 first)
            (#pt-project eisenstein 1 second))
          (#pt-pi
            (
              (denied-proof
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-project eisenstein 1 first)
                  (#pt-project eisenstein 1 second))))
            #pt-false)
          (#pt-app
            (#pt-use disjunction ())
            (#pt-app (#pt-use eisenstein-equal ()) first second)
            (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) first second))) #pt-false))
          (#pt-lambda
            (
              (omega-equivalent
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-project eisenstein 1 first)
                  (#pt-project eisenstein 1 second))))
            (#pt-app
              (#pt-use disjunction-left ())
              (#pt-app (#pt-use eisenstein-equal ()) first second)
              (#pt-pi
                ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) first second)))
                #pt-false)
              (#pt-app
                (#pt-use conjunction-introduce ())
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-project eisenstein 0 first)
                  (#pt-project eisenstein 0 second))
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-project eisenstein 1 first)
                  (#pt-project eisenstein 1 second))
                real-equivalent
                omega-equivalent)))
          (#pt-lambda
            (
              (omega-distinct
                (#pt-pi
                  (
                    (denied-proof
                      (#pt-app
                        (#pt-use integer-equal ())
                        (#pt-project eisenstein 1 first)
                        (#pt-project eisenstein 1 second))))
                  #pt-false)))
            (#pt-app
              (#pt-use disjunction-right ())
              (#pt-app (#pt-use eisenstein-equal ()) first second)
              (#pt-pi
                ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) first second)))
                #pt-false)
              (#pt-lambda
                ((equivalent (#pt-app (#pt-use eisenstein-equal ()) first second)))
                (#pt-app
                  omega-distinct
                  (#pt-app
                    (#pt-use conjunction-right ())
                    (#pt-app
                      (#pt-use integer-equal ())
                      (#pt-project eisenstein 0 first)
                      (#pt-project eisenstein 0 second))
                    (#pt-app
                      (#pt-use integer-equal ())
                      (#pt-project eisenstein 1 first)
                      (#pt-project eisenstein 1 second))
                    equivalent)))))
          (#pt-app
            (#pt-use integer-equality-decided ())
            (#pt-project eisenstein 1 first)
            (#pt-project eisenstein 1 second))))
      (#pt-lambda
        (
          (real-distinct
            (#pt-pi
              (
                (denied-proof
                  (#pt-app
                    (#pt-use integer-equal ())
                    (#pt-project eisenstein 0 first)
                    (#pt-project eisenstein 0 second))))
              #pt-false)))
        (#pt-app
          (#pt-use disjunction-right ())
          (#pt-app (#pt-use eisenstein-equal ()) first second)
          (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) first second))) #pt-false)
          (#pt-lambda
            ((equivalent (#pt-app (#pt-use eisenstein-equal ()) first second)))
            (#pt-app
              real-distinct
              (#pt-app
                (#pt-use conjunction-left ())
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-project eisenstein 0 first)
                  (#pt-project eisenstein 0 second))
                (#pt-app
                  (#pt-use integer-equal ())
                  (#pt-project eisenstein 1 first)
                  (#pt-project eisenstein 1 second))
                equivalent)))))
      (#pt-app
        (#pt-use integer-equality-decided ())
        (#pt-project eisenstein 0 first)
        (#pt-project eisenstein 0 second)))))
(#theorem eisenstein-nonzero-product
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter first-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) first (#pt-use eisenstein-zero ())))) #pt-false))
    (#parameter second-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) second (#pt-use eisenstein-zero ())))) #pt-false)))
  (#statement
    (#pt-pi
      (
        (denied-proof
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app (#pt-use eisenstein-multiply ()) first second)
            (#pt-use eisenstein-zero ()))))
      #pt-false))
  (#proof
    (#pt-lambda
      (
        (product-zero
          (#pt-app
            (#pt-use eisenstein-equal ())
            (#pt-app (#pt-use eisenstein-multiply ()) first second)
            (#pt-use eisenstein-zero ()))))
      (#pt-app
        (#pt-app
          (#pt-use integer-nonzero-product ())
          (#pt-app (#pt-use eisenstein-norm ()) first)
          (#pt-app (#pt-use eisenstein-norm ()) second)
          (#pt-app (#pt-use eisenstein-nonzero-norm ()) first first-nonzero)
          (#pt-app (#pt-use eisenstein-nonzero-norm ()) second second-nonzero))
        (#pt-app
          (#pt-use integer-transitive ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use eisenstein-norm ()) first)
            (#pt-app (#pt-use eisenstein-norm ()) second))
          (#pt-app
            (#pt-use eisenstein-norm ())
            (#pt-app (#pt-use eisenstein-multiply ()) first second))
          (#pt-use integer-zero ())
          (#pt-app
            (#pt-use integer-symmetric ())
            (#pt-app
              (#pt-use eisenstein-norm ())
              (#pt-app (#pt-use eisenstein-multiply ()) first second))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use eisenstein-norm ()) first)
              (#pt-app (#pt-use eisenstein-norm ()) second))
            (#pt-app (#pt-use eisenstein-norm-multiply ()) first second))
          (#pt-app
            (#pt-use eisenstein-zero-implies-norm-zero ())
            (#pt-app (#pt-use eisenstein-multiply ()) first second)
            product-zero))))))
(#theorem eisenstein-product-zero-cancel-first
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter first-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) first (#pt-use eisenstein-zero ())))) #pt-false))
    (#parameter product-zero (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-multiply ()) first second) (#pt-use eisenstein-zero ()))))
  (#statement (#pt-app (#pt-use eisenstein-equal ()) second (#pt-use eisenstein-zero ())))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use eisenstein-equal ()) second (#pt-use eisenstein-zero ()))
      (#pt-pi
        ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) second (#pt-use eisenstein-zero ()))))
        #pt-false)
      (#pt-app (#pt-use eisenstein-equal ()) second (#pt-use eisenstein-zero ()))
      (#pt-lambda
        ((second-zero (#pt-app (#pt-use eisenstein-equal ()) second (#pt-use eisenstein-zero ()))))
        second-zero)
      (#pt-lambda
        (
          (second-nonzero
            (#pt-pi
              (
                (denied-proof
                  (#pt-app (#pt-use eisenstein-equal ()) second (#pt-use eisenstein-zero ()))))
              #pt-false)))
        (#pt-app
          (#pt-use false-elimination ())
          (#pt-app (#pt-use eisenstein-equal ()) second (#pt-use eisenstein-zero ()))
          (#pt-app
            (#pt-app
              (#pt-use eisenstein-nonzero-product ())
              first
              second
              first-nonzero
              second-nonzero)
            product-zero)))
      (#pt-app (#pt-use eisenstein-equality-decided ()) second (#pt-use eisenstein-zero ())))))
(#theorem eisenstein-zero-difference
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter difference-zero (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-add ()) first (#pt-app (#pt-use eisenstein-negate ()) second)) (#pt-use eisenstein-zero ()))))
  (#statement (#pt-app (#pt-use eisenstein-equal ()) first second))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project eisenstein 0 first)
        (#pt-project eisenstein 0 second))
      (#pt-app
        (#pt-use integer-equal ())
        (#pt-project eisenstein 1 first)
        (#pt-project eisenstein 1 second))
      (#pt-app
        (#pt-use integer-zero-difference ())
        (#pt-project eisenstein 0 first)
        (#pt-project eisenstein 0 second)
        (#pt-app
          (#pt-use conjunction-left ())
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-project
              eisenstein
              0
              (#pt-app
                (#pt-use eisenstein-add ())
                first
                (#pt-app (#pt-use eisenstein-negate ()) second)))
            (#pt-project eisenstein 0 (#pt-use eisenstein-zero ())))
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-project
              eisenstein
              1
              (#pt-app
                (#pt-use eisenstein-add ())
                first
                (#pt-app (#pt-use eisenstein-negate ()) second)))
            (#pt-project eisenstein 1 (#pt-use eisenstein-zero ())))
          difference-zero))
      (#pt-app
        (#pt-use integer-zero-difference ())
        (#pt-project eisenstein 1 first)
        (#pt-project eisenstein 1 second)
        (#pt-app
          (#pt-use conjunction-right ())
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-project
              eisenstein
              0
              (#pt-app
                (#pt-use eisenstein-add ())
                first
                (#pt-app (#pt-use eisenstein-negate ()) second)))
            (#pt-project eisenstein 0 (#pt-use eisenstein-zero ())))
          (#pt-app
            (#pt-use integer-equal ())
            (#pt-project
              eisenstein
              1
              (#pt-app
                (#pt-use eisenstein-add ())
                first
                (#pt-app (#pt-use eisenstein-negate ()) second)))
            (#pt-project eisenstein 1 (#pt-use eisenstein-zero ())))
          difference-zero)))))
(#theorem eisenstein-multiply-cancel-first
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter third (#pt-use eisenstein ()))
    (#parameter factor-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) first (#pt-use eisenstein-zero ())))) #pt-false))
    (#parameter products-equivalent (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-multiply ()) first second) (#pt-app (#pt-use eisenstein-multiply ()) first third))))
  (#statement (#pt-app (#pt-use eisenstein-equal ()) second third))
  (#proof
    (#pt-app
      (#pt-use eisenstein-zero-difference ())
      second
      third
      (#pt-app
        (#pt-use eisenstein-product-zero-cancel-first ())
        first
        (#pt-app (#pt-use eisenstein-add ()) second (#pt-app (#pt-use eisenstein-negate ()) third))
        factor-nonzero
        (#pt-app
          (#pt-use eisenstein-transitive ())
          (#pt-app
            (#pt-use eisenstein-multiply ())
            first
            (#pt-app
              (#pt-use eisenstein-add ())
              second
              (#pt-app (#pt-use eisenstein-negate ()) third)))
          (#pt-app
            (#pt-use eisenstein-add ())
            (#pt-app (#pt-use eisenstein-multiply ()) first second)
            (#pt-app
              (#pt-use eisenstein-multiply ())
              first
              (#pt-app (#pt-use eisenstein-negate ()) third)))
          (#pt-use eisenstein-zero ())
          (#pt-app
            (#pt-use eisenstein-multiply-distribute-second ())
            first
            second
            (#pt-app (#pt-use eisenstein-negate ()) third))
          (#pt-app
            (#pt-use eisenstein-transitive ())
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-multiply ()) first second)
              (#pt-app
                (#pt-use eisenstein-multiply ())
                first
                (#pt-app (#pt-use eisenstein-negate ()) third)))
            (#pt-app
              (#pt-use eisenstein-add ())
              (#pt-app (#pt-use eisenstein-multiply ()) first second)
              (#pt-app
                (#pt-use eisenstein-negate ())
                (#pt-app (#pt-use eisenstein-multiply ()) first third)))
            (#pt-use eisenstein-zero ())
            (#pt-app
              (#pt-use eisenstein-add-congruent ())
              (#pt-app (#pt-use eisenstein-multiply ()) first second)
              (#pt-app
                (#pt-use eisenstein-multiply ())
                first
                (#pt-app (#pt-use eisenstein-negate ()) third))
              (#pt-app (#pt-use eisenstein-multiply ()) first second)
              (#pt-app
                (#pt-use eisenstein-negate ())
                (#pt-app (#pt-use eisenstein-multiply ()) first third))
              (#pt-app
                (#pt-use eisenstein-reflexive ())
                (#pt-app (#pt-use eisenstein-multiply ()) first second))
              (#pt-app (#pt-use eisenstein-multiply-negative-second ()) first third))
            (#pt-app
              (#pt-use eisenstein-transitive ())
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-app (#pt-use eisenstein-multiply ()) first second)
                (#pt-app
                  (#pt-use eisenstein-negate ())
                  (#pt-app (#pt-use eisenstein-multiply ()) first third)))
              (#pt-app
                (#pt-use eisenstein-add ())
                (#pt-app (#pt-use eisenstein-multiply ()) first third)
                (#pt-app
                  (#pt-use eisenstein-negate ())
                  (#pt-app (#pt-use eisenstein-multiply ()) first third)))
              (#pt-use eisenstein-zero ())
              (#pt-app
                (#pt-use eisenstein-add-congruent ())
                (#pt-app (#pt-use eisenstein-multiply ()) first second)
                (#pt-app
                  (#pt-use eisenstein-negate ())
                  (#pt-app (#pt-use eisenstein-multiply ()) first third))
                (#pt-app (#pt-use eisenstein-multiply ()) first third)
                (#pt-app
                  (#pt-use eisenstein-negate ())
                  (#pt-app (#pt-use eisenstein-multiply ()) first third))
                products-equivalent
                (#pt-app
                  (#pt-use eisenstein-reflexive ())
                  (#pt-app
                    (#pt-use eisenstein-negate ())
                    (#pt-app (#pt-use eisenstein-multiply ()) first third))))
              (#pt-app
                (#pt-use eisenstein-add-inverse ())
                (#pt-app (#pt-use eisenstein-multiply ()) first third)))))))))
(#theorem eisenstein-multiply-cancel-second
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter third (#pt-use eisenstein ()))
    (#parameter factor-nonzero (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) third (#pt-use eisenstein-zero ())))) #pt-false))
    (#parameter products-equivalent (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-multiply ()) first third) (#pt-app (#pt-use eisenstein-multiply ()) second third))))
  (#statement (#pt-app (#pt-use eisenstein-equal ()) first second))
  (#proof
    (#pt-app
      (#pt-use eisenstein-multiply-cancel-first ())
      third
      first
      second
      factor-nonzero
      (#pt-app
        (#pt-use eisenstein-transitive ())
        (#pt-app (#pt-use eisenstein-multiply ()) third first)
        (#pt-app (#pt-use eisenstein-multiply ()) first third)
        (#pt-app (#pt-use eisenstein-multiply ()) third second)
        (#pt-app (#pt-use eisenstein-multiply-commutative ()) third first)
        (#pt-app
          (#pt-use eisenstein-transitive ())
          (#pt-app (#pt-use eisenstein-multiply ()) first third)
          (#pt-app (#pt-use eisenstein-multiply ()) second third)
          (#pt-app (#pt-use eisenstein-multiply ()) third second)
          products-equivalent
          (#pt-app (#pt-use eisenstein-multiply-commutative ()) second third))))))
(#theorem eisenstein-product-zero-cases
  (#universes)
  (#parameters
    (#parameter first (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter product-zero (#pt-app (#pt-use eisenstein-equal ()) (#pt-app (#pt-use eisenstein-multiply ()) first second) (#pt-use eisenstein-zero ()))))
  (#statement
    (#pt-app
      (#pt-use disjunction ())
      (#pt-app (#pt-use eisenstein-equal ()) first (#pt-use eisenstein-zero ()))
      (#pt-app (#pt-use eisenstein-equal ()) second (#pt-use eisenstein-zero ()))))
  (#proof
    (#pt-app
      (#pt-use disjunction-eliminate ())
      (#pt-app (#pt-use eisenstein-equal ()) first (#pt-use eisenstein-zero ()))
      (#pt-pi
        ((denied-proof (#pt-app (#pt-use eisenstein-equal ()) first (#pt-use eisenstein-zero ()))))
        #pt-false)
      (#pt-app
        (#pt-use disjunction ())
        (#pt-app (#pt-use eisenstein-equal ()) first (#pt-use eisenstein-zero ()))
        (#pt-app (#pt-use eisenstein-equal ()) second (#pt-use eisenstein-zero ())))
      (#pt-lambda
        ((first-zero (#pt-app (#pt-use eisenstein-equal ()) first (#pt-use eisenstein-zero ()))))
        (#pt-app
          (#pt-use disjunction-left ())
          (#pt-app (#pt-use eisenstein-equal ()) first (#pt-use eisenstein-zero ()))
          (#pt-app (#pt-use eisenstein-equal ()) second (#pt-use eisenstein-zero ()))
          first-zero))
      (#pt-lambda
        (
          (first-nonzero
            (#pt-pi
              (
                (denied-proof
                  (#pt-app (#pt-use eisenstein-equal ()) first (#pt-use eisenstein-zero ()))))
              #pt-false)))
        (#pt-app
          (#pt-use disjunction-right ())
          (#pt-app (#pt-use eisenstein-equal ()) first (#pt-use eisenstein-zero ()))
          (#pt-app (#pt-use eisenstein-equal ()) second (#pt-use eisenstein-zero ()))
          (#pt-app
            (#pt-use eisenstein-product-zero-cancel-first ())
            first
            second
            first-nonzero
            product-zero)))
      (#pt-app (#pt-use eisenstein-equality-decided ()) first (#pt-use eisenstein-zero ())))))
