; Exact signed rational identities, derived from the proved integer
; numerator laws and actual denominator evidence. No field axiom.
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias integer-of-natural = ./integer-defs.lim::integer-of-natural)
(#alias integer-zero = ./integer-defs.lim::integer-zero)
(#alias integer-add = ./integer-defs.lim::integer-add)
(#alias integer-multiply = ./integer-defs.lim::integer-multiply)
(#alias integer-negate = ./integer-defs.lim::integer-negate)
(#alias integer-reflexive = ./integer-equality.lim::integer-reflexive)
(#alias integer-symmetric = ./integer-equality.lim::integer-symmetric)
(#alias integer-transitive = ./integer-equality.lim::integer-transitive)
(#alias integer-add-congruent = ./integer-equality.lim::integer-add-congruent)
(#alias integer-multiply-negative = ./integer-multiplication.lim::integer-multiply-negative)
(#alias integer-multiply-two-negatives = ./integer-divisibility.lim::integer-multiply-two-negatives)
(#alias rational = ./rational-defs.lim::rational)
(#alias rational-equal = ./rational-defs.lim::rational-equal)
(#alias rational-zero = ./rational-defs.lim::rational-zero)
(#alias rational-one = ./rational-defs.lim::rational-one)
(#alias rational-add = ./rational-defs.lim::rational-add)
(#alias rational-multiply = ./rational-defs.lim::rational-multiply)
(#alias rational-negate = ./rational-defs.lim::rational-negate)
(#alias
  integer-multiply-negative-second
  =
  ./integer-divisibility.lim::integer-multiply-negative-second)
(#alias rational-transitive = ./rational-equality.lim::rational-transitive)
(#alias rational-components-congruent = ./rational-congruence.lim::rational-components-congruent)
(#alias rational-add-zero = ./rational-ring.lim::rational-add-zero)
(#alias rational-multiply-zero = ./rational-ring.lim::rational-multiply-zero)
(#alias rational-multiply-one = ./rational-ring.lim::rational-multiply-one)
(#alias rational-multiply-commutative = ./rational-ring.lim::rational-multiply-commutative)
(#alias rational-add-commutative = ./rational-ring.lim::rational-add-commutative)
(#alias rational-zero-numerator = ./rational-equality.lim::rational-zero-numerator)
(#alias integer-negate-add = ./integer-addition.lim::integer-negate-add)
(#theorem rational-negate-zero
  (#universes)
  (#parameters)
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app (#pt-use rational-negate ()) (#pt-use rational-zero ()))
      (#pt-use rational-zero ())))
  (#proof
    (#pt-app
      (#pt-use rational-zero-numerator ())
      (#pt-app (#pt-use rational-negate ()) (#pt-use rational-zero ()))
      (#pt-app (#pt-use integer-reflexive ()) (#pt-use integer-zero ())))))
(#theorem rational-zero-multiply
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app (#pt-use rational-multiply ()) (#pt-use rational-zero ()) first)
      (#pt-use rational-zero ())))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app (#pt-use rational-multiply ()) (#pt-use rational-zero ()) first)
      (#pt-app (#pt-use rational-multiply ()) first (#pt-use rational-zero ()))
      (#pt-use rational-zero ())
      (#pt-app (#pt-use rational-multiply-commutative ()) (#pt-use rational-zero ()) first)
      (#pt-app (#pt-use rational-multiply-zero ()) first))))
(#theorem rational-one-multiply
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app (#pt-use rational-multiply ()) (#pt-use rational-one ()) first)
      first))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app (#pt-use rational-multiply ()) (#pt-use rational-one ()) first)
      (#pt-app (#pt-use rational-multiply ()) first (#pt-use rational-one ()))
      first
      (#pt-app (#pt-use rational-multiply-commutative ()) (#pt-use rational-one ()) first)
      (#pt-app (#pt-use rational-multiply-one ()) first))))
(#theorem rational-zero-add
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app (#pt-use rational-add ()) (#pt-use rational-zero ()) first)
      first))
  (#proof
    (#pt-app
      (#pt-use rational-transitive ())
      (#pt-app (#pt-use rational-add ()) (#pt-use rational-zero ()) first)
      (#pt-app (#pt-use rational-add ()) first (#pt-use rational-zero ()))
      first
      (#pt-app (#pt-use rational-add-commutative ()) (#pt-use rational-zero ()) first)
      (#pt-app (#pt-use rational-add-zero ()) first))))
(#theorem rational-multiply-negative
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter second (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app (#pt-use rational-multiply ()) (#pt-app (#pt-use rational-negate ()) first) second)
      (#pt-app (#pt-use rational-negate ()) (#pt-app (#pt-use rational-multiply ()) first second))))
  (#proof
    (#pt-app
      (#pt-use rational-components-congruent ())
      (#pt-app (#pt-use rational-multiply ()) (#pt-app (#pt-use rational-negate ()) first) second)
      (#pt-app (#pt-use rational-negate ()) (#pt-app (#pt-use rational-multiply ()) first second))
      (#pt-app
        (#pt-use integer-multiply-negative ())
        (#pt-project rational 0 first)
        (#pt-project rational 0 second))
      (#pt-refl
        #pt-nat
        (#pt-app
          (#pt-use multiply ())
          (#pt-project rational 1 first)
          (#pt-project rational 1 second))))))
(#theorem rational-multiply-negative-second
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter second (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app (#pt-use rational-multiply ()) first (#pt-app (#pt-use rational-negate ()) second))
      (#pt-app (#pt-use rational-negate ()) (#pt-app (#pt-use rational-multiply ()) first second))))
  (#proof
    (#pt-app
      (#pt-use rational-components-congruent ())
      (#pt-app (#pt-use rational-multiply ()) first (#pt-app (#pt-use rational-negate ()) second))
      (#pt-app (#pt-use rational-negate ()) (#pt-app (#pt-use rational-multiply ()) first second))
      (#pt-app
        (#pt-use integer-multiply-negative-second ())
        (#pt-project rational 0 first)
        (#pt-project rational 0 second))
      (#pt-refl
        #pt-nat
        (#pt-app
          (#pt-use multiply ())
          (#pt-project rational 1 first)
          (#pt-project rational 1 second))))))
(#theorem rational-multiply-two-negatives
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter second (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app (#pt-use rational-negate ()) first)
        (#pt-app (#pt-use rational-negate ()) second))
      (#pt-app (#pt-use rational-multiply ()) first second)))
  (#proof
    (#pt-app
      (#pt-use rational-components-congruent ())
      (#pt-app
        (#pt-use rational-multiply ())
        (#pt-app (#pt-use rational-negate ()) first)
        (#pt-app (#pt-use rational-negate ()) second))
      (#pt-app (#pt-use rational-multiply ()) first second)
      (#pt-app
        (#pt-use integer-multiply-two-negatives ())
        (#pt-project rational 0 first)
        (#pt-project rational 0 second))
      (#pt-refl
        #pt-nat
        (#pt-app
          (#pt-use multiply ())
          (#pt-project rational 1 first)
          (#pt-project rational 1 second))))))
(#theorem rational-negate-add
  (#universes)
  (#parameters
    (#parameter first (#pt-use rational ()))
    (#parameter second (#pt-use rational ())))
  (#statement
    (#pt-app
      (#pt-use rational-equal ())
      (#pt-app (#pt-use rational-negate ()) (#pt-app (#pt-use rational-add ()) first second))
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app (#pt-use rational-negate ()) first)
        (#pt-app (#pt-use rational-negate ()) second))))
  (#proof
    (#pt-app
      (#pt-use rational-components-congruent ())
      (#pt-app (#pt-use rational-negate ()) (#pt-app (#pt-use rational-add ()) first second))
      (#pt-app
        (#pt-use rational-add ())
        (#pt-app (#pt-use rational-negate ()) first)
        (#pt-app (#pt-use rational-negate ()) second))
      (#pt-app
        (#pt-use integer-transitive ())
        (#pt-app
          (#pt-use integer-negate ())
          (#pt-app
            (#pt-use integer-add ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project rational 0 first)
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second)))
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project rational 0 second)
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))))
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project rational 0 first)
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second))))
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project rational 0 second)
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))))
        (#pt-app
          (#pt-use integer-add ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-negate ()) (#pt-project rational 0 first))
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second)))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-negate ()) (#pt-project rational 0 second))
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))))
        (#pt-app
          (#pt-use integer-negate-add ())
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 first)
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second)))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-project rational 0 second)
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))))
        (#pt-app
          (#pt-use integer-add-congruent ())
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project rational 0 first)
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second))))
          (#pt-app
            (#pt-use integer-negate ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-project rational 0 second)
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-negate ()) (#pt-project rational 0 first))
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second)))
          (#pt-app
            (#pt-use integer-multiply ())
            (#pt-app (#pt-use integer-negate ()) (#pt-project rational 0 second))
            (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))
          (#pt-app
            (#pt-use integer-symmetric ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-negate ()) (#pt-project rational 0 first))
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second)))
            (#pt-app
              (#pt-use integer-negate ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project rational 0 first)
                (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second))))
            (#pt-app
              (#pt-use integer-multiply-negative ())
              (#pt-project rational 0 first)
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 second))))
          (#pt-app
            (#pt-use integer-symmetric ())
            (#pt-app
              (#pt-use integer-multiply ())
              (#pt-app (#pt-use integer-negate ()) (#pt-project rational 0 second))
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first)))
            (#pt-app
              (#pt-use integer-negate ())
              (#pt-app
                (#pt-use integer-multiply ())
                (#pt-project rational 0 second)
                (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))))
            (#pt-app
              (#pt-use integer-multiply-negative ())
              (#pt-project rational 0 second)
              (#pt-app (#pt-use integer-of-natural ()) (#pt-project rational 1 first))))))
      (#pt-refl
        #pt-nat
        (#pt-app
          (#pt-use multiply ())
          (#pt-project rational 1 first)
          (#pt-project rational 1 second))))))
