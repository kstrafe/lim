(#theorem eisenstein-lambda-order-one-after-square-shift
  (#universes)
  (#parameters
    (#parameter primary (#pt-use eisenstein ()))
    (#parameter second (#pt-use eisenstein ()))
    (#parameter coefficient (#pt-use eisenstein ()))
    (#parameter unit-proof (#pt-app (#pt-use eisenstein-unit ()) coefficient))
    (#parameter second-not-divides (#pt-pi ((denied-proof (#pt-app (#pt-use eisenstein-divides ()) (#pt-use eisenstein-lambda ()) second))) #pt-false))
    (#parameter primary-square-divides (#pt-app (#pt-use eisenstein-divides ()) (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2)) primary)))
  (#statement
    (#pt-app
      (#pt-use eisenstein-lambda-order ())
      (#pt-app
        (#pt-use eisenstein-add ())
        primary
        (#pt-app
          (#pt-use eisenstein-multiply ())
          (#pt-use eisenstein-lambda ())
          (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)))
      (#pt-succ #pt-zero)))
  (#proof
    (#pt-construct
      eisenstein-lambda-order
      ()
      (
        (#pt-app
          (#pt-use eisenstein-add ())
          primary
          (#pt-app
            (#pt-use eisenstein-multiply ())
            (#pt-use eisenstein-lambda ())
            (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)))
        (#pt-succ #pt-zero))
      introduce
      (
        (#pt-app
          (#pt-use eisenstein-divides-congruent-divisor ())
          (#pt-use eisenstein-lambda ())
          (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-succ #pt-zero))
          (#pt-app
            (#pt-use eisenstein-add ())
            primary
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-use eisenstein-lambda ())
              (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)))
          (#pt-app
            (#pt-use eisenstein-symmetric ())
            (#pt-app
              (#pt-use eisenstein-power ())
              (#pt-use eisenstein-lambda ())
              (#pt-succ #pt-zero))
            (#pt-use eisenstein-lambda ())
            (#pt-app (#pt-use eisenstein-power-one ()) (#pt-use eisenstein-lambda ())))
          (#pt-app
            (#pt-use eisenstein-divides-add ())
            (#pt-use eisenstein-lambda ())
            primary
            (#pt-app
              (#pt-use eisenstein-multiply ())
              (#pt-use eisenstein-lambda ())
              (#pt-app (#pt-use eisenstein-multiply ()) coefficient second))
            (#pt-app
              (#pt-use eisenstein-divides-transitive ())
              (#pt-use eisenstein-lambda ())
              (#pt-app (#pt-use eisenstein-power ()) (#pt-use eisenstein-lambda ()) (#pt-numeral 2))
              primary
              (#pt-app
                (#pt-use eisenstein-power-divisor ())
                (#pt-use eisenstein-lambda ())
                (#pt-succ #pt-zero))
              primary-square-divides)
            (#pt-app
              (#pt-use eisenstein-divides-product-left ())
              (#pt-use eisenstein-lambda ())
              (#pt-use eisenstein-lambda ())
              (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)
              (#pt-app (#pt-use eisenstein-divides-reflexive ()) (#pt-use eisenstein-lambda ())))))
        (#pt-lambda
          (
            (shifted-square-divides
              (#pt-app
                (#pt-use eisenstein-divides ())
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-numeral 2))
                (#pt-app
                  (#pt-use eisenstein-add ())
                  primary
                  (#pt-app
                    (#pt-use eisenstein-multiply ())
                    (#pt-use eisenstein-lambda ())
                    (#pt-app (#pt-use eisenstein-multiply ()) coefficient second))))))
          (#pt-app
            second-not-divides
            (#pt-app
              (#pt-use eisenstein-unit-divisibility-reflect ())
              (#pt-use eisenstein-lambda ())
              coefficient
              second
              unit-proof
              (#pt-app
                (#pt-use eisenstein-divides-congruent-divisor ())
                (#pt-app
                  (#pt-use eisenstein-power ())
                  (#pt-use eisenstein-lambda ())
                  (#pt-succ #pt-zero))
                (#pt-use eisenstein-lambda ())
                (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)
                (#pt-app (#pt-use eisenstein-power-one ()) (#pt-use eisenstein-lambda ()))
                (#pt-app
                  (#pt-use eisenstein-lambda-power-divides-product-cancel ())
                  (#pt-succ #pt-zero)
                  (#pt-app (#pt-use eisenstein-multiply ()) coefficient second)
                  (#pt-app
                    (#pt-use eisenstein-divides-add-cancel-left ())
                    (#pt-app
                      (#pt-use eisenstein-power ())
                      (#pt-use eisenstein-lambda ())
                      (#pt-numeral 2))
                    primary
                    (#pt-app
                      (#pt-use eisenstein-multiply ())
                      (#pt-use eisenstein-lambda ())
                      (#pt-app (#pt-use eisenstein-multiply ()) coefficient second))
                    primary-square-divides
                    shifted-square-divides))))))))))
