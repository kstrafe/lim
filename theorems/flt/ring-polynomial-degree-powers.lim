; Actual polynomial powers have degree exponent*degree
; in a supplied checked coefficient domain, including exponent0 and
; degree0. The base case proves the constant-one leading witness.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias finite-list = ./finite-list-defs.lim::finite-list)
(#alias multiply = ./../fermat_statement.lim::multiply)
(#alias ring-one = ./commutative-ring-data.lim::ring-one)
(#alias
  ring-polynomial-degree-cons-zero
  =
