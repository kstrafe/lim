  ./ring-polynomial-support-data.lim::ring-polynomial-degree-witness)
(#alias
  ring-polynomial-domain-data
  =
  ./ring-polynomial-domain-data.lim::ring-polynomial-domain-data)
(#alias
  ring-polynomial-domain-one-nonzero
  =
  ./ring-polynomial-domain-data.lim::ring-polynomial-domain-one-nonzero)
(#alias ring-polynomial-multiply = ./ring-polynomial-data.lim::ring-polynomial-multiply)
(#alias ring-polynomial-reflexive = ./ring-polynomial-equivalence.lim::ring-polynomial-reflexive)
(#math-definition ring-polynomial-degree-power ()
  (#pt-pi
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (polynomial (#pt-app (#pt-use finite-list ()) Carrier))
      (exponent #pt-nat))
    (#pt-app (#pt-use finite-list ()) Carrier))
  (#pt-lambda
    (
      (Carrier (#pt-type 0))
      (coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
      (polynomial (#pt-app (#pt-use finite-list ()) Carrier))
      (exponent #pt-nat))
    (#pt-nat-induct
      (#pt-lambda ((power-index #pt-nat)) (#pt-app (#pt-use finite-list ()) Carrier))
      (#pt-construct
        finite-list
        ()
        (Carrier)
        cons
        (
          (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
          (#pt-construct finite-list () (Carrier) nil ())))
      (#pt-lambda
        ((previous-exponent #pt-nat) (previous-power (#pt-app (#pt-use finite-list ()) Carrier)))
        (#pt-app
          (#pt-use ring-polynomial-multiply ())
          Carrier
          coefficient-ring
          polynomial
          previous-power))
      exponent)))
(#theorem ring-polynomial-degree-one
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-degree-witness ())
      Carrier
      coefficient-ring
      (#pt-construct
        finite-list
        ()
        (Carrier)
        cons
        (
          (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
          (#pt-construct finite-list () (Carrier) nil ())))
      #pt-zero))
  (#proof
    (#pt-app
      (#pt-use ring-polynomial-degree-cons-zero ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-one ()) Carrier coefficient-ring)
      (#pt-construct finite-list () (Carrier) nil ())
      (#pt-app
        (#pt-use ring-polynomial-domain-one-nonzero ())
        Carrier
        coefficient-ring
        coefficient-domain)
      (#pt-app
        (#pt-use ring-polynomial-reflexive ())
        Carrier
        coefficient-ring
        (#pt-construct finite-list () (Carrier) nil ())))))
(#theorem ring-polynomial-degree-power-law
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter coefficient-domain (#pt-app (#pt-use ring-polynomial-domain-data ()) Carrier coefficient-ring))
    (#parameter polynomial (#pt-app (#pt-use finite-list ()) Carrier))
    (#parameter degree #pt-nat)
    (#parameter exponent #pt-nat)
    (#parameter degree-certificate (#pt-app (#pt-use ring-polynomial-degree-witness ()) Carrier coefficient-ring polynomial degree)))
  (#statement
    (#pt-app
      (#pt-use ring-polynomial-degree-witness ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-polynomial-degree-power ())
        Carrier
        coefficient-ring
        polynomial
        exponent)
      (#pt-app (#pt-use multiply ()) exponent degree)))
  (#proof
    (#pt-nat-induct
      (#pt-lambda
        ((power-index #pt-nat))
        (#pt-app
          (#pt-use ring-polynomial-degree-witness ())
          Carrier
          coefficient-ring
          (#pt-app
            (#pt-use ring-polynomial-degree-power ())
            Carrier
            coefficient-ring
            polynomial
            power-index)
          (#pt-app (#pt-use multiply ()) power-index degree)))
      (#pt-app (#pt-use ring-polynomial-degree-one ()) Carrier coefficient-ring coefficient-domain)
      (#pt-lambda
        (
          (previous-exponent #pt-nat)
          (previous-degree-certificate
            (#pt-app
              (#pt-use ring-polynomial-degree-witness ())
              Carrier
              coefficient-ring
              (#pt-app
                (#pt-use ring-polynomial-degree-power ())
                Carrier
                coefficient-ring
                polynomial
                previous-exponent)
              (#pt-app (#pt-use multiply ()) previous-exponent degree))))
        (#pt-app
          (#pt-use ring-polynomial-degree-product ())
          Carrier
          coefficient-ring
          coefficient-domain
          polynomial
          (#pt-app
            (#pt-use ring-polynomial-degree-power ())
            Carrier
            coefficient-ring
            polynomial
            previous-exponent)
          degree
          (#pt-app (#pt-use multiply ()) previous-exponent degree)
          degree-certificate
          previous-degree-certificate))
      exponent)))
