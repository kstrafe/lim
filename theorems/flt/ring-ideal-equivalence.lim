; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Prove inclusion transitivity and extensional ideal
; equality reflexive/symmetric/transitive from explicit membership
; maps, not kernel identity or a set-extensionality principle.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction = ./logical-connectives.lim::conjunction)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias ring-ideal = ./ring-ideal-data.lim::ring-ideal)
(#alias ring-ideal-equal = ./ring-ideal-data.lim::ring-ideal-equal)
(#alias ring-ideal-member = ./ring-ideal-data.lim::ring-ideal-member)
(#alias ring-ideal-subset = ./ring-ideal-data.lim::ring-ideal-subset)
(#theorem ring-ideal-subset-reflexive
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
  (#statement
    (#pt-app (#pt-use ring-ideal-subset ()) Carrier coefficient-ring first-ideal first-ideal))
  (#proof
    (#pt-lambda
      (
        (first-element Carrier)
        (member
          (#pt-app
            (#pt-use ring-ideal-member ())
            Carrier
            coefficient-ring
            first-ideal
            first-element)))
      member)))
(#theorem ring-ideal-subset-transitive
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter third-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter first-inclusion (#pt-app (#pt-use ring-ideal-subset ()) Carrier coefficient-ring first-ideal second-ideal))
    (#parameter second-inclusion (#pt-app (#pt-use ring-ideal-subset ()) Carrier coefficient-ring second-ideal third-ideal)))
  (#statement
    (#pt-app (#pt-use ring-ideal-subset ()) Carrier coefficient-ring first-ideal third-ideal))
  (#proof
    (#pt-lambda
      (
        (first-element Carrier)
        (member
          (#pt-app
            (#pt-use ring-ideal-member ())
            Carrier
            coefficient-ring
            first-ideal
            first-element)))
      (#pt-app second-inclusion first-element (#pt-app first-inclusion first-element member)))))
(#theorem ring-ideal-equal-reflexive
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
  (#statement
    (#pt-app (#pt-use ring-ideal-equal ()) Carrier coefficient-ring first-ideal first-ideal))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app (#pt-use ring-ideal-subset ()) Carrier coefficient-ring first-ideal first-ideal)
      (#pt-app (#pt-use ring-ideal-subset ()) Carrier coefficient-ring first-ideal first-ideal)
      (#pt-lambda
        (
          (first-element Carrier)
          (member
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              first-ideal
              first-element)))
        member)
      (#pt-lambda
        (
          (first-element Carrier)
          (member
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              first-ideal
              first-element)))
        member))))
(#theorem ring-ideal-equal-symmetric
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter ideal-equation (#pt-app (#pt-use ring-ideal-equal ()) Carrier coefficient-ring first-ideal second-ideal)))
  (#statement
    (#pt-app (#pt-use ring-ideal-equal ()) Carrier coefficient-ring second-ideal first-ideal))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app (#pt-use ring-ideal-subset ()) Carrier coefficient-ring second-ideal first-ideal)
      (#pt-app (#pt-use ring-ideal-subset ()) Carrier coefficient-ring first-ideal second-ideal)
      (#pt-project conjunction 1 ideal-equation)
      (#pt-project conjunction 0 ideal-equation))))
(#theorem ring-ideal-equal-transitive
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter second-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter third-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter first-equation (#pt-app (#pt-use ring-ideal-equal ()) Carrier coefficient-ring first-ideal second-ideal))
    (#parameter second-equation (#pt-app (#pt-use ring-ideal-equal ()) Carrier coefficient-ring second-ideal third-ideal)))
  (#statement
    (#pt-app (#pt-use ring-ideal-equal ()) Carrier coefficient-ring first-ideal third-ideal))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app (#pt-use ring-ideal-subset ()) Carrier coefficient-ring first-ideal third-ideal)
      (#pt-app (#pt-use ring-ideal-subset ()) Carrier coefficient-ring third-ideal first-ideal)
      (#pt-app
        (#pt-use ring-ideal-subset-transitive ())
        Carrier
        coefficient-ring
        first-ideal
        second-ideal
        third-ideal
        (#pt-project conjunction 0 first-equation)
        (#pt-project conjunction 0 second-equation))
      (#pt-app
        (#pt-use ring-ideal-subset-transitive ())
        Carrier
        coefficient-ring
        third-ideal
        second-ideal
        first-ideal
        (#pt-project conjunction 1 second-equation)
        (#pt-project conjunction 1 first-equation)))))
