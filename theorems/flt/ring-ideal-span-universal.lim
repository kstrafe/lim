; Adapted source: pinned Mathlib Ideal/Defs.lean, Ideal/Operations.lean
; and Affine/Point.lean. All ideal closures are checked proofs.
; Generated by scripts/generate-flt-ideals.py; checked native terms.
; Structural expression induction proves the actual
; span is the least ideal containing its generators. Derive monotonicity
; and span-of-an-ideal equality through explicit membership maps.
; No minimality or span identity is supplied as an assumption.
(#alias commutative-ring = ./commutative-ring-data.lim::commutative-ring)
(#alias conjunction-introduce = ./logical-connectives.lim::conjunction-introduce)
(#alias exists = ./logic-exists.lim::exists)
(#alias ring-equal = ./commutative-ring-data.lim::ring-equal)
(#alias ring-ideal = ./ring-ideal-data.lim::ring-ideal)
(#alias ring-ideal-add = ./ring-ideal-data.lim::ring-ideal-add)
(#alias ring-ideal-equal = ./ring-ideal-data.lim::ring-ideal-equal)
(#alias ring-ideal-expression = ./ring-ideal-expression.lim::ring-ideal-expression)
(#alias ring-ideal-expression-value = ./ring-ideal-expression.lim::ring-ideal-expression-value)
(#alias ring-ideal-member = ./ring-ideal-data.lim::ring-ideal-member)
(#alias ring-ideal-member-congruent = ./ring-ideal-data.lim::ring-ideal-member-congruent)
(#alias ring-ideal-multiply-left = ./ring-ideal-data.lim::ring-ideal-multiply-left)
(#alias ring-ideal-negate = ./ring-ideal-data.lim::ring-ideal-negate)
(#alias ring-ideal-span = ./ring-ideal-span-construction.lim::ring-ideal-span)
(#alias ring-ideal-span-generator = ./ring-ideal-span-construction.lim::ring-ideal-span-generator)
(#alias ring-ideal-span-member = ./ring-ideal-span-construction.lim::ring-ideal-span-member)
(#alias ring-ideal-subset = ./ring-ideal-data.lim::ring-ideal-subset)
(#alias ring-ideal-zero = ./ring-ideal-data.lim::ring-ideal-zero)
(#alias ring-symmetric = ./commutative-ring-data.lim::ring-symmetric)
(#theorem ring-ideal-span-expression-contained
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter generators (#pt-pi ((element Carrier)) #pt-prop))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter generators-contained (#pt-pi ((first-element Carrier) (generator-proof (#pt-app generators first-element))) (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring first-ideal first-element)))
    (#parameter expression (#pt-app (#pt-use ring-ideal-expression ()) Carrier generators)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-member ())
      Carrier
      coefficient-ring
      first-ideal
      (#pt-app
        (#pt-use ring-ideal-expression-value ())
        Carrier
        coefficient-ring
        generators
        expression)))
  (#proof
    (#pt-induct
      ring-ideal-expression
      ()
      (Carrier generators)
      (#pt-lambda
        ((selected-expression (#pt-app (#pt-use ring-ideal-expression ()) Carrier generators)))
        (#pt-app
          (#pt-use ring-ideal-member ())
          Carrier
          coefficient-ring
          first-ideal
          (#pt-app
            (#pt-use ring-ideal-expression-value ())
            Carrier
            coefficient-ring
            generators
            selected-expression)))
      (
        (#pt-app (#pt-use ring-ideal-zero ()) Carrier coefficient-ring first-ideal)
        (#pt-lambda
          ((generator Carrier) (generator-proof (#pt-app generators generator)))
          (#pt-app generators-contained generator generator-proof))
        (#pt-lambda
          (
            (left (#pt-app (#pt-use ring-ideal-expression ()) Carrier generators))
            (left-contained
              (#pt-app
                (#pt-use ring-ideal-member ())
                Carrier
                coefficient-ring
                first-ideal
                (#pt-app
                  (#pt-use ring-ideal-expression-value ())
                  Carrier
                  coefficient-ring
                  generators
                  left)))
            (right (#pt-app (#pt-use ring-ideal-expression ()) Carrier generators))
            (right-contained
              (#pt-app
                (#pt-use ring-ideal-member ())
                Carrier
                coefficient-ring
                first-ideal
                (#pt-app
                  (#pt-use ring-ideal-expression-value ())
                  Carrier
                  coefficient-ring
                  generators
                  right))))
          (#pt-app
            (#pt-use ring-ideal-add ())
            Carrier
            coefficient-ring
            first-ideal
            (#pt-app
              (#pt-use ring-ideal-expression-value ())
              Carrier
              coefficient-ring
              generators
              left)
            (#pt-app
              (#pt-use ring-ideal-expression-value ())
              Carrier
              coefficient-ring
              generators
              right)
            left-contained
            right-contained))
        (#pt-lambda
          (
            (original (#pt-app (#pt-use ring-ideal-expression ()) Carrier generators))
            (original-contained
              (#pt-app
                (#pt-use ring-ideal-member ())
                Carrier
                coefficient-ring
                first-ideal
                (#pt-app
                  (#pt-use ring-ideal-expression-value ())
                  Carrier
                  coefficient-ring
                  generators
                  original))))
          (#pt-app
            (#pt-use ring-ideal-negate ())
            Carrier
            coefficient-ring
            first-ideal
            (#pt-app
              (#pt-use ring-ideal-expression-value ())
              Carrier
              coefficient-ring
              generators
              original)
            original-contained))
        (#pt-lambda
          (
            (scalar Carrier)
            (original (#pt-app (#pt-use ring-ideal-expression ()) Carrier generators))
            (original-contained
              (#pt-app
                (#pt-use ring-ideal-member ())
                Carrier
                coefficient-ring
                first-ideal
                (#pt-app
                  (#pt-use ring-ideal-expression-value ())
                  Carrier
                  coefficient-ring
                  generators
                  original))))
          (#pt-app
            (#pt-use ring-ideal-multiply-left ())
            Carrier
            coefficient-ring
            first-ideal
            scalar
            (#pt-app
              (#pt-use ring-ideal-expression-value ())
              Carrier
              coefficient-ring
              generators
              original)
            original-contained)))
      expression)))
(#theorem ring-ideal-span-least
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter generators (#pt-pi ((element Carrier)) #pt-prop))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring))
    (#parameter generators-contained (#pt-pi ((first-element Carrier) (generator-proof (#pt-app generators first-element))) (#pt-app (#pt-use ring-ideal-member ()) Carrier coefficient-ring first-ideal first-element))))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-span ()) Carrier coefficient-ring generators)
      first-ideal))
  (#proof
    (#pt-lambda
      (
        (first-element Carrier)
        (span-proof
          (#pt-app
            (#pt-use ring-ideal-member ())
            Carrier
            coefficient-ring
            (#pt-app (#pt-use ring-ideal-span ()) Carrier coefficient-ring generators)
            first-element)))
      (#pt-induct
        exists
        (0)
        (
          (#pt-app (#pt-use ring-ideal-expression ()) Carrier generators)
          (#pt-lambda
            ((span-expression (#pt-app (#pt-use ring-ideal-expression ()) Carrier generators)))
            (#pt-app
              (#pt-use ring-equal ())
              Carrier
              coefficient-ring
              first-element
              (#pt-app
                (#pt-use ring-ideal-expression-value ())
                Carrier
                coefficient-ring
                generators
                span-expression))))
        (#pt-lambda
          (
            (membership-certificate
              (#pt-app
                (#pt-use ring-ideal-span-member ())
                Carrier
                coefficient-ring
                generators
                first-element)))
          (#pt-app
            (#pt-use ring-ideal-member ())
            Carrier
            coefficient-ring
            first-ideal
            first-element))
        (
          (#pt-lambda
            (
              (witness (#pt-app (#pt-use ring-ideal-expression ()) Carrier generators))
              (value-equation
                (#pt-app
                  (#pt-use ring-equal ())
                  Carrier
                  coefficient-ring
                  first-element
                  (#pt-app
                    (#pt-use ring-ideal-expression-value ())
                    Carrier
                    coefficient-ring
                    generators
                    witness))))
            (#pt-app
              (#pt-use ring-ideal-member-congruent ())
              Carrier
              coefficient-ring
              first-ideal
              (#pt-app
                (#pt-use ring-ideal-expression-value ())
                Carrier
                coefficient-ring
                generators
                witness)
              first-element
              (#pt-app
                (#pt-use ring-symmetric ())
                Carrier
                coefficient-ring
                first-element
                (#pt-app
                  (#pt-use ring-ideal-expression-value ())
                  Carrier
                  coefficient-ring
                  generators
                  witness)
                value-equation)
              (#pt-app
                (#pt-use ring-ideal-span-expression-contained ())
                Carrier
                coefficient-ring
                generators
                first-ideal
                generators-contained
                witness))))
        span-proof))))
(#theorem ring-ideal-span-monotone
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter generators (#pt-pi ((element Carrier)) #pt-prop))
    (#parameter other-generators (#pt-pi ((element Carrier)) #pt-prop))
    (#parameter generator-inclusion (#pt-pi ((first-element Carrier) (generator-proof (#pt-app generators first-element))) (#pt-app other-generators first-element))))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-subset ())
      Carrier
      coefficient-ring
      (#pt-app (#pt-use ring-ideal-span ()) Carrier coefficient-ring generators)
      (#pt-app (#pt-use ring-ideal-span ()) Carrier coefficient-ring other-generators)))
  (#proof
    (#pt-app
      (#pt-use ring-ideal-span-least ())
      Carrier
      coefficient-ring
      generators
      (#pt-app (#pt-use ring-ideal-span ()) Carrier coefficient-ring other-generators)
      (#pt-lambda
        ((first-element Carrier) (generator-proof (#pt-app generators first-element)))
        (#pt-app
          (#pt-use ring-ideal-span-generator ())
          Carrier
          coefficient-ring
          other-generators
          first-element
          (#pt-app generator-inclusion first-element generator-proof))))))
(#theorem ring-ideal-span-ideal
  (#universes)
  (#parameters
    (#parameter Carrier (#pt-type 0))
    (#parameter coefficient-ring (#pt-app (#pt-use commutative-ring ()) Carrier))
    (#parameter first-ideal (#pt-app (#pt-use ring-ideal ()) Carrier coefficient-ring)))
  (#statement
    (#pt-app
      (#pt-use ring-ideal-equal ())
      Carrier
      coefficient-ring
      (#pt-app
        (#pt-use ring-ideal-span ())
        Carrier
        coefficient-ring
        (#pt-lambda
          ((first-element Carrier))
          (#pt-app
            (#pt-use ring-ideal-member ())
            Carrier
            coefficient-ring
            first-ideal
            first-element)))
      first-ideal))
  (#proof
    (#pt-app
      (#pt-use conjunction-introduce ())
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        (#pt-app
          (#pt-use ring-ideal-span ())
          Carrier
          coefficient-ring
          (#pt-lambda
            ((first-element Carrier))
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              first-ideal
              first-element)))
        first-ideal)
      (#pt-app
        (#pt-use ring-ideal-subset ())
        Carrier
        coefficient-ring
        first-ideal
        (#pt-app
          (#pt-use ring-ideal-span ())
          Carrier
          coefficient-ring
          (#pt-lambda
            ((first-element Carrier))
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              first-ideal
              first-element))))
      (#pt-app
        (#pt-use ring-ideal-span-least ())
        Carrier
        coefficient-ring
        (#pt-lambda
          ((first-element Carrier))
          (#pt-app
            (#pt-use ring-ideal-member ())
            Carrier
            coefficient-ring
            first-ideal
            first-element))
        first-ideal
        (#pt-lambda
          (
            (first-element Carrier)
            (member
              (#pt-app
                (#pt-use ring-ideal-member ())
                Carrier
                coefficient-ring
                first-ideal
                first-element)))
          member))
      (#pt-lambda
        (
          (first-element Carrier)
          (member
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              first-ideal
              first-element)))
        (#pt-app
          (#pt-use ring-ideal-span-generator ())
          Carrier
          coefficient-ring
          (#pt-lambda
            ((first-element-bound-0000 Carrier))
            (#pt-app
              (#pt-use ring-ideal-member ())
              Carrier
              coefficient-ring
              first-ideal
              first-element-bound-0000))
          first-element
          member)))))
