; The unbounded mathematical statement of Fermat's Last Theorem.
; This file contains NO proof of FLT. It defines a proposition, not a theorem.
; See docs/lean-compatibility.md for the upstream formalization and port gaps.
(#math-definition add ()
  (#pt-pi ((left #pt-nat) (right #pt-nat)) #pt-nat)
  (#pt-lambda
    ((left #pt-nat) (right #pt-nat))
    (#pt-nat-induct
      (#pt-lambda ((ordinal #pt-nat)) #pt-nat)
      right
      (#pt-lambda ((previous #pt-nat) (sum #pt-nat)) (#pt-succ sum))
      left)))
(#math-definition multiply ()
  (#pt-pi ((left #pt-nat) (right #pt-nat)) #pt-nat)
  (#pt-lambda
    ((left #pt-nat) (right #pt-nat))
    (#pt-nat-induct
      (#pt-lambda ((ordinal #pt-nat)) #pt-nat)
      #pt-zero
      (#pt-lambda ((previous #pt-nat) (product #pt-nat)) (#pt-app (#pt-use add ()) right product))
      left)))
(#math-definition power ()
  (#pt-pi ((base #pt-nat) (exponent #pt-nat)) #pt-nat)
  (#pt-lambda
    ((base #pt-nat) (exponent #pt-nat))
    (#pt-nat-induct
      (#pt-lambda ((ordinal #pt-nat)) #pt-nat)
      (#pt-succ #pt-zero)
      (#pt-lambda ((previous #pt-nat) (value #pt-nat)) (#pt-app (#pt-use multiply ()) base value))
      exponent)))
; succ(a), succ(b), succ(c) range over all positive naturals.
; succ(succ(succ(n))) ranges over exactly the exponents >= 3.
; An equality witness would imply False. No bounded search is involved.
(#math-definition fermats-last-theorem-statement ()
  #pt-prop
  (#pt-pi
    ((a #pt-nat) (b #pt-nat) (c #pt-nat) (n #pt-nat))
    (#pt-pi
      (
        (counterexample
          (#pt-eq
            #pt-nat
            (#pt-app
              (#pt-use add ())
              (#pt-app (#pt-use power ()) (#pt-succ a) (#pt-succ (#pt-succ (#pt-succ n))))
              (#pt-app (#pt-use power ()) (#pt-succ b) (#pt-succ (#pt-succ (#pt-succ n)))))
            (#pt-app (#pt-use power ()) (#pt-succ c) (#pt-succ (#pt-succ (#pt-succ n)))))))
      #pt-false)))
