; Pythagoras in its orthogonal-vector formulation.
; Define squared length as inner(v,v). For every symmetric biadditive pairing,
; orthogonal u and v satisfy length²(u+v) = length²(u) + length²(v).
; All algebraic laws are universally quantified proof parameters below.
; There are no admitted axioms, numeric bounds, Lean imports, real-number
; construction, distance functions or angle definitions in this file.
; Check: lim --check-theorem theorems/pythagoras.lim pythagoras-orthogonal
(#theorem transitivity
  (#universes u)
  (#parameters
    (#parameter a (#pt-type u))
    (#parameter start a)
    (#parameter midpoint a)
    (#parameter endpoint a)
    (#parameter initial (#pt-eq a start midpoint))
    (#parameter following (#pt-eq a midpoint endpoint)))
  (#statement (#pt-eq a start endpoint))
  (#proof
    (#pt-eq-elim
      a
      midpoint
      (#pt-lambda ((other a) (evidence (#pt-eq a midpoint other))) (#pt-eq a start other))
      initial
      endpoint
      following)))
(#theorem congruence
  (#universes u v)
  (#parameters
    (#parameter a (#pt-type u))
    (#parameter b (#pt-type v))
    (#parameter function (#pt-pi ((argument a)) b))
    (#parameter left a)
    (#parameter right a)
    (#parameter path (#pt-eq a left right)))
  (#statement (#pt-eq b (#pt-app function left) (#pt-app function right)))
  (#proof
    (#pt-eq-elim
      a
      left
      (#pt-lambda
        ((other a) (evidence (#pt-eq a left other)))
        (#pt-eq b (#pt-app function left) (#pt-app function other)))
      (#pt-refl b (#pt-app function left))
      right
      path)))
; Squared length has its standard inner-product definition.
(#math-definition squared-length (scalar-level vector-level)
  (#pt-pi
    (
      (Scalar (#pt-type scalar-level))
      (Vector (#pt-type vector-level))
      (inner (#pt-pi ((left-vector Vector) (right-vector Vector)) Scalar))
      (value Vector))
    Scalar)
  (#pt-lambda
    (
      (Scalar (#pt-type scalar-level))
      (Vector (#pt-type vector-level))
      (inner (#pt-pi ((left-vector Vector) (right-vector Vector)) Scalar))
      (value Vector))
    (#pt-app inner value value)))
; Expand the two arguments, cancel both orthogonal cross terms, and combine.
(#theorem pythagoras-orthogonal
  (#universes scalar-level vector-level)
  (#parameters
    (#parameter Scalar (#pt-type scalar-level))
    (#parameter Vector (#pt-type vector-level))
    (#parameter zero Scalar)
    (#parameter add-scalar (#pt-pi ((left-scalar Scalar) (right-scalar Scalar)) Scalar))
    (#parameter add-vector (#pt-pi ((left-vector Vector) (right-vector Vector)) Vector))
    (#parameter inner (#pt-pi ((left-vector Vector) (right-vector Vector)) Scalar))
    (#parameter add-zero (#pt-pi ((value Scalar)) (#pt-eq Scalar (#pt-app add-scalar value zero) value)))
    (#parameter zero-add (#pt-pi ((value Scalar)) (#pt-eq Scalar (#pt-app add-scalar zero value) value)))
    (#parameter inner-symmetric (#pt-pi ((first Vector) (second Vector)) (#pt-eq Scalar (#pt-app inner first second) (#pt-app inner second first))))
    (#parameter inner-add-left (#pt-pi ((first Vector) (second Vector) (third Vector)) (#pt-eq Scalar (#pt-app inner (#pt-app add-vector first second) third) (#pt-app add-scalar (#pt-app inner first third) (#pt-app inner second third)))))
    (#parameter inner-add-right (#pt-pi ((first Vector) (second Vector) (third Vector)) (#pt-eq Scalar (#pt-app inner first (#pt-app add-vector second third)) (#pt-app add-scalar (#pt-app inner first second) (#pt-app inner first third)))))
    (#parameter u Vector)
    (#parameter v Vector)
    (#parameter orthogonal (#pt-eq Scalar (#pt-app inner u v) zero)))
  (#statement
    (#pt-eq
      Scalar
      (#pt-app
        (#pt-use squared-length (scalar-level vector-level))
        Scalar
        Vector
        inner
        (#pt-app add-vector u v))
      (#pt-app
        add-scalar
        (#pt-app (#pt-use squared-length (scalar-level vector-level)) Scalar Vector inner u)
        (#pt-app (#pt-use squared-length (scalar-level vector-level)) Scalar Vector inner v))))
  (#proof
    (#pt-let
      (#parameter reverse-orthogonal (#pt-eq Scalar (#pt-app inner v u) zero))
      (#pt-app
        (#pt-use transitivity (scalar-level))
        Scalar
        (#pt-app inner v u)
        (#pt-app inner u v)
        zero
        (#pt-app inner-symmetric v u)
        orthogonal)
      (#pt-let
        (#parameter left-cancel (#pt-eq Scalar (#pt-app add-scalar (#pt-app inner u u) (#pt-app inner u v)) (#pt-app inner u u)))
        (#pt-app
          (#pt-use transitivity (scalar-level))
          Scalar
          (#pt-app add-scalar (#pt-app inner u u) (#pt-app inner u v))
          (#pt-app add-scalar (#pt-app inner u u) zero)
          (#pt-app inner u u)
          (#pt-app
            (#pt-use congruence (scalar-level scalar-level))
            Scalar
            Scalar
            (#pt-lambda ((amount Scalar)) (#pt-app add-scalar (#pt-app inner u u) amount))
            (#pt-app inner u v)
            zero
            orthogonal)
          (#pt-app add-zero (#pt-app inner u u)))
        (#pt-let
          (#parameter right-cancel (#pt-eq Scalar (#pt-app add-scalar (#pt-app inner v u) (#pt-app inner v v)) (#pt-app inner v v)))
          (#pt-app
            (#pt-use transitivity (scalar-level))
            Scalar
            (#pt-app add-scalar (#pt-app inner v u) (#pt-app inner v v))
            (#pt-app add-scalar zero (#pt-app inner v v))
            (#pt-app inner v v)
            (#pt-app
              (#pt-use congruence (scalar-level scalar-level))
              Scalar
              Scalar
              (#pt-lambda ((amount Scalar)) (#pt-app add-scalar amount (#pt-app inner v v)))
              (#pt-app inner v u)
              zero
              reverse-orthogonal)
            (#pt-app zero-add (#pt-app inner v v)))
          (#pt-let
            (#parameter left-expansion (#pt-eq Scalar (#pt-app inner u (#pt-app add-vector u v)) (#pt-app inner u u)))
            (#pt-app
              (#pt-use transitivity (scalar-level))
              Scalar
              (#pt-app inner u (#pt-app add-vector u v))
              (#pt-app add-scalar (#pt-app inner u u) (#pt-app inner u v))
              (#pt-app inner u u)
              (#pt-app inner-add-right u u v)
              left-cancel)
            (#pt-let
              (#parameter right-expansion (#pt-eq Scalar (#pt-app inner v (#pt-app add-vector u v)) (#pt-app inner v v)))
              (#pt-app
                (#pt-use transitivity (scalar-level))
                Scalar
                (#pt-app inner v (#pt-app add-vector u v))
                (#pt-app add-scalar (#pt-app inner v u) (#pt-app inner v v))
                (#pt-app inner v v)
                (#pt-app inner-add-right v u v)
                right-cancel)
              (#pt-app
                (#pt-use transitivity (scalar-level))
                Scalar
                (#pt-app inner (#pt-app add-vector u v) (#pt-app add-vector u v))
                (#pt-app
                  add-scalar
                  (#pt-app inner u (#pt-app add-vector u v))
                  (#pt-app inner v (#pt-app add-vector u v)))
                (#pt-app add-scalar (#pt-app inner u u) (#pt-app inner v v))
                (#pt-app inner-add-left u v (#pt-app add-vector u v))
                (#pt-app
                  (#pt-use transitivity (scalar-level))
                  Scalar
                  (#pt-app
                    add-scalar
                    (#pt-app inner u (#pt-app add-vector u v))
                    (#pt-app inner v (#pt-app add-vector u v)))
                  (#pt-app
                    add-scalar
                    (#pt-app inner u u)
                    (#pt-app inner v (#pt-app add-vector u v)))
                  (#pt-app add-scalar (#pt-app inner u u) (#pt-app inner v v))
                  (#pt-app
                    (#pt-use congruence (scalar-level scalar-level))
                    Scalar
                    Scalar
                    (#pt-lambda
                      ((amount Scalar))
                      (#pt-app add-scalar amount (#pt-app inner v (#pt-app add-vector u v))))
                    (#pt-app inner u (#pt-app add-vector u v))
                    (#pt-app inner u u)
                    left-expansion)
                  (#pt-app
                    (#pt-use congruence (scalar-level scalar-level))
                    Scalar
                    Scalar
                    (#pt-lambda ((amount Scalar)) (#pt-app add-scalar (#pt-app inner u u) amount))
                    (#pt-app inner v (#pt-app add-vector u v))
                    (#pt-app inner v v)
                    right-expansion))))))))))
