//; Concrete four-slot wake-token authority. Tokens identify a slot and its
//; generation; stale tokens are rejected after retirement and re-registration.
//; This module does not own tasks, I/O operations, or a ready queue.
#struct WakeToken4 () ((slot #usize) (generation #u64))
#opaque WakeToken4
#struct WakeTable4 (#linear)
    ((generations (#array #u64 4)) (active (#array #bool 4)))
#opaque WakeTable4

#enum WakeRegister4 ()
    ((WakeRegister4.WakeRegistered4 WakeToken4) WakeRegister4.WakeBusy4 WakeRegister4.WakeInvalid4 WakeRegister4.WakeExhausted4)
#enum WakeRetire4 () (WakeRetire4.WakeRetired4 WakeRetire4.WakeStale4)

#fn wake-table4-create () WakeTable4
    (#return (#struct-literal WakeTable4
      ((generations (#array-repeat 1u64))
       (active (#array-repeat false)))))

#fn wake-token4-generation ((token WakeToken4)) #u64
    (#return (#get token generation))

#fn wake-token4-slot ((token WakeToken4)) #usize
    (#return (#get token slot))

// A valid but exhausted table for deterministic protocol tests.
#fn wake-table4-create-exhausted () WakeTable4
    (#return (#struct-literal WakeTable4
      ((generations (#array-of (#array #u64 4)
        1u64 18446744073709551615u64 1u64 1u64))
       (active (#array-repeat false)))))

#fn wake-table4-register ((table (#ref-mut WakeTable4)) (slot #usize)) WakeRegister4
    (#return
      (#if (#usize::ge slot 4usize)
        WakeRegister4.WakeInvalid4
        (#if (#index (#clone (#get table active)) slot)
          WakeRegister4.WakeBusy4
          (#if (#u64::eq (#index (#clone (#get table generations)) slot)
                18446744073709551615u64)
            WakeRegister4.WakeExhausted4
            (#block
              (#let-mut flags (#array #bool 4) (#clone (#get table active)))
              (#set-index flags slot true)
              (#deref-set (#borrow-mut (#get table active)) flags)
              (WakeRegister4.WakeRegistered4 (#struct-literal WakeToken4
                ((slot slot)
                 (generation (#index (#clone (#get table generations)) slot))))))))))

#fn wake-table4-valid ((table (#ref WakeTable4)) (token WakeToken4)) #bool
    (#let slot #usize (#get token slot))
    (#let generation #u64 (#get token generation))
    (#return
      (#if (#usize::lt slot 4usize)
        (#bool::and
          (#index (#clone (#get table active)) slot)
          (#u64::eq (#index (#clone (#get table generations)) slot)
            generation))
        false))

#fn wake-table4-retire ((table (#ref-mut WakeTable4)) (token WakeToken4)) WakeRetire4
    (#let slot #usize (#get token slot))
    (#let generation #u64 (#get token generation))
    (#return
      (#if (#usize::ge slot 4usize)
        WakeRetire4.WakeStale4
        (#if (#bool::and
              (#index (#clone (#get table active)) slot)
              (#u64::eq (#index (#clone (#get table generations)) slot)
                generation))
          (#block
            (#let-mut flags (#array #bool 4) (#clone (#get table active)))
            (#set-index flags slot false)
            (#deref-set (#borrow-mut (#get table active)) flags)
            (#let-mut generations (#array #u64 4) (#clone (#get table generations)))
            (#set-index generations slot
              (#u64::add-saturate (#index generations slot) 1u64))
            (#deref-set (#borrow-mut (#get table generations)) generations)
            WakeRetire4.WakeRetired4)
          WakeRetire4.WakeStale4)))
