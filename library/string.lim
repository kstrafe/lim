        #block
        (#return false)
      )
      ()
    )
    (
      #if
      (
        #usize::gt
        width
        (#literal #usize 1)
      )
      (
        #block
        (
          #let
          second
          #u8
          (
            #deref
            (
              #slice-idx
              bytes
