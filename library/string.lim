      #match
      (
        #call
        String::reserve
        (: string (#borrow-mut string) : additional capacity)      )
      (
        #case
        StringStatus.StringOk
        (StringCreateResult.StringCreated string)
      )
      (
        #case
        (StringStatus.StringErr error)
        (
          #block
          (
            #call
            String::free
            (: string string)          )
          (StringCreateResult.StringCreateFailed error)        )      )    )  ))
; Zero is not a scalar width: reject surrogates and out-of-range #char casts.
(
  #fn
  String::scalar-width
  (: value #char)
  #usize
  (
    #let
    code
    #u32
    (#as value #u32)
  )
  (
    #return
    (
      #if
      (
        #bool::or
        (
          #u32::gt
          code
          (#literal #u32 1114111)
        )
        (
          #bool::and
          (
            #u32::ge
            code
            (#literal #u32 55296)
          )
          (
            #u32::le
            code
            (#literal #u32 57343)
          )
        )
      )
      (#literal #usize 0)
      (
        #if
        (
          #u32::lt
          code
          (#literal #u32 128)
        )
        (#literal #usize 1)
        (
          #if
          (
            #u32::lt
            code
            (#literal #u32 2048)
          )
          (#literal #usize 2)
          (
            #if
            (
              #u32::lt
              code
              (#literal #u32 65536)
            )
            (#literal #usize 3)
            (#literal #usize 4)
          )
        )
      )
    )
  ))
; Caller proves room for a complete validated scalar at offset. This raw helper
; is unsafe so outside callers cannot write through arbitrary pointers safely.
(
  #unsafe-fn
  String::write-scalar
  (: pointer (#ptr-mut #u8) : offset #usize : value #char : width #usize)
  ()
  (
    #let
    code
    #u32
    (#as value #u32)
  )
  (
    #let
    lead
    #u8
    (
      #if
      (
        #usize::eq
        width
        (#literal #usize 1)
      )
      (#as code #u8)
      (
        #if
        (
          #usize::eq
          width
          (#literal #usize 2)
        )
        (
          #as
          (
            #u32::bit-or
            (#literal #u32 192)
            (
              #u32::shr
              code
              (#literal #u32 6)
            )
          )
          #u8
        )
        (
          #if
          (
            #usize::eq
            width
            (#literal #usize 3)
          )
          (
            #as
            (
              #u32::bit-or
              (#literal #u32 224)
              (
                #u32::shr
                code
                (#literal #u32 12)
              )
            )
            #u8
          )
          (
            #as
            (
              #u32::bit-or
              (#literal #u32 240)
              (
                #u32::shr
                code
                (#literal #u32 18)
              )
            )
            #u8
          )
        )
      )
    )
  )
  (
    #unsafe
    (
      #ptr-write
      (#ptr-offset pointer offset)
      lead
    )
  )
  (
    #let-mut
    index
    #usize
    (#literal #usize 1)
  )
  (
    #while
    (#usize::lt index width)
    (
      #let
      shift
      #u32
      (
        #as
        (
          #usize::mul-wrap
          (
            #usize::sub-wrap
            width
            (
              #usize::add-wrap
              index
              (#literal #usize 1)
            )
          )
          (#literal #usize 6)
        )
        #u32
      )
    )
    (
      #let
      byte
      #u8
      (
        #as
        (
          #u32::bit-or
          (#literal #u32 128)
          (
            #u32::bit-and
            (#u32::shr code shift)
            (#literal #u32 63)
          )
        )
        #u8
      )
    )
    (
      #unsafe
      (
        #ptr-write
        (
          #ptr-offset
          pointer
          (#usize::add-wrap offset index)
        )
        byte
      )
    )
    (
      #set
      index
      (
        #usize::add-wrap
        index
        (#literal #usize 1)
      )
    )
  )
  (
    #return
    ()
  ))
