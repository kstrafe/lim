; Opaque, linear UTF-8 text backed by the native Lim process heap (no libc).
; Length/capacity are bytes, not characters. Strings are not NUL::terminated;
; embedded NUL is valid text. No safe mutable byte access or shallow clone exists.
; Allocation is fallible, moves do not allocate, and String::free is explicit.
(#import "system_allocator.lim")
(
  #struct
  String (#linear)
  (: pointer (#ptr-mut #u8) : length #usize : capacity #usize))
(#opaque String)

(
  #struct
  StringBytes ()
  (: owner (#ref String)))
(#opaque StringBytes)
; Raw access is an unsafe boundary: retain the owner borrow and do not move,
; reallocate, mutate, or free its allocation while this pointer is used.
; The raw pointer is mutable only because Lim has no raw mut-to-const cast;
; writing through it from this shared borrow is forbidden.
(
  #unsafe-fn
  String::data-pointer
  (: string (#ref String))
  (#ptr-mut #u8)
  (
    #return
    (#get string pointer)
  ))
; Append a complete validated UTF-8 String. The exclusive destination and
; shared source loans must be disjoint; no implicit clone or source move occurs.
(
  #fn
  String::push-string
  (: string (#ref-mut String) : text (#ref String))
  StringStatus
  (
    #let
    additional
    #usize
    (#get text length)
  )
  (
    #return
    (
      #match
      (
        #call
        String::reserve
        (: string string : additional additional)      )
      (
        #case
        (StringStatus.StringErr error)
        (StringStatus.StringErr error)
      )
      (
        #case
        StringStatus.StringOk
        (
          #block
          (
            #let
            length
            #usize
            (#get string length)
          )
          (
            #let
            target
            (#ptr-mut #u8)
            (#get string pointer)
          )
          (
            #let
            source
            (#ptr-mut #u8)
            (#get text pointer)
          )
          (
            #let-mut
            index
            #usize
            (#literal #usize 0)
          )
          (
            #while
            (#usize::lt index additional)
            (
              #unsafe
              (
                #ptr-write
                (
                  #ptr-offset
                  target
                  (#usize::add-wrap length index)
                )
                (
                  #ptr-read
                  (#ptr-offset source index)
                )
              )
            )
            (
              #set
              index
              (
                #usize::add-wrap
                index
                (#literal #usize 1)
              )
            )
          )
          (
            #deref-set
            (
              #borrow-mut
              (#get string length)
            )
            (#usize::add-wrap length additional)
          )
          StringStatus.StringOk
        )
      )    )  ))
(
  #enum
  StringError ()
  (StringError.StringOutOfMemory StringError.StringCapacityOverflow StringError.StringInvalidUtf8 StringError.StringInvalidChar)
)
(
  #enum
  StringStatus ()
  (
    StringStatus.StringOk
    (StringStatus.StringErr StringError)
  )
)
(
  #enum
  StringCreateResult ()
  (
    (StringCreateResult.StringCreated String)
    (StringCreateResult.StringCreateFailed StringError)
  )
)
(
  #enum
  StringByteResult ()
  (
    (StringByteResult.StringByte #u8)
    StringByteResult.StringByteOutOfBounds
  )
)
(
  #enum
  StringPopResult ()
  (
    (StringPopResult.StringPopped #char)
    StringPopResult.StringEmpty
  )
)
(
  #fn
  String::new
  ()
  String
  (
    #return
    (
      #struct-literal
      String
      (: pointer (#ptr-null (#ptr-mut #u8)) : length 0usize : capacity 0usize)    )  ))
(
  #fn
  String::len
  (: string (#ref String))
  #usize
  (
    #return
    (#get string length)
  ))
(
  #fn
  String::capacity
  (: string (#ref String))
  #usize
  (
    #return
    (#get string capacity)
  ))
(
  #fn
  String::is-empty
  (: string (#ref String))
  #bool
  (
    #return
    (
      #usize::eq
      (#get string length)
      (#literal #usize 0)
    )
  ))
; Reserve once before a bulk append. Outcome.Failure changes neither allocation nor text.
(
  #fn
  String::reserve
  (: string (#ref-mut String) : additional #usize)
  StringStatus
  (
    #let
    length
    #usize
    (#get string length)
  )
  (
    #let
    capacity
    #usize
    (#get string capacity)
  )
  (
    #return
    (
      #if
      (
        #usize::gt
        additional
        (#usize::sub-wrap sYSTEM-ALLOCATION-MAX length)
      )
      (StringStatus.StringErr StringError.StringCapacityOverflow)
      (
        #block
        (
          #let
          requested
          #usize
          (#usize::add-wrap length additional)
        )
        (
          #if
          (#usize::le requested capacity)
          StringStatus.StringOk
          (
            #block
            (
              #let
              doubled
              #usize
              (
                #usize::mul-saturate
                capacity
                (#literal #usize 2)
              )
            )
            (
              #let
              geometric
              #usize
              (
                #if
                (
                  #usize::lt
                  doubled
                  (#literal #usize 8)
                )
                (#literal #usize 8)
                doubled
              )
            )
            (
              #let
              bounded
              #usize
              (
                #if
                (#usize::gt geometric sYSTEM-ALLOCATION-MAX)
                sYSTEM-ALLOCATION-MAX
                geometric
              )
            )
            (
              #let
              chosen
              #usize
              (
                #if
                (#usize::gt requested bounded)
                requested
                bounded
              )
            )
            (
              #let
              allocation
              SystemAllocationResult
              (
                #if
                (
                  #usize::eq
                  capacity
                  (#literal #usize 0)
                )
                (
                  #call
                  system-allocate
                  (: size chosen)                )
                (
                  #unsafe
                  (
                    #unsafe-call
                    system-reallocate
                    (: pointer (#get string pointer) : size chosen)                  )                )              )            )
            (
              #match
              allocation
              (
                #case
                (SystemAllocationResult.SystemAllocated pointer)
                (
                  #block
                  (
                    #deref-set
                    (
                      #borrow-mut
                      (#get string pointer)
                    )
                    pointer
                  )
                  (
                    #deref-set
                    (
                      #borrow-mut
                      (#get string capacity)
                    )
                    chosen
                  )
                  StringStatus.StringOk
                )
              )
              (
                #case
                (SystemAllocationResult.SystemAllocationFailed error)
                (
                  #match
                  error
                  (
                    #case
                    SystemAllocationError.SystemAllocationOutOfMemory
                    (StringStatus.StringErr StringError.StringOutOfMemory)
                  )
                  (
                    #case
                    SystemAllocationError.SystemAllocationInvalidSize
                    (StringStatus.StringErr StringError.StringCapacityOverflow)
                  )
                )
              )
            )          )        )      )    )  ))
(
  #fn
  String::with-capacity
  (: capacity #usize)
  StringCreateResult
  (
    #let-mut
    string
    String
    (
      #call
      String::new
      ()
    )
  )
  (
    #return
