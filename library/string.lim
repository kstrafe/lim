(
  #fn
  String::push-chars
  (: string (#ref-mut String) : text (#slice #char))
  StringStatus
  (
    #let
    count
    #usize
    (#slice-len text)
  )
  (
    #let-mut
    additional
    #usize
    (#literal #usize 0)
