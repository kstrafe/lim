                #usize::add-wrap
                index
                (#literal #usize 1)
              )
            )
          )
        )
        (
          #if
          (
            #bool::or
            (
              #bool::or
              (
                #bool::and
                (
                  #u8::eq
                  first
                  (#literal #u8 224)
                )
                (
                  #u8::lt
                  second
                  (#literal #u8 160)
