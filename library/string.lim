              (
                #bool::and
                (
                  #u8::eq
                  first
                  (#literal #u8 237)
                )
                (
                  #u8::gt
                  second
                  (#literal #u8 159)
                )
              )
            )
            (
              #bool::or
              (
                #bool::and
                (
                  #u8::eq
                  first
                  (#literal #u8 240)
                )
                (
                  #u8::lt
                  second
                  (#literal #u8 144)
                )
              )
              (
                #bool::and
                (
                  #u8::eq
                  first
                  (#literal #u8 244)
                )
                (
                  #u8::gt
                  second
                  (#literal #u8 143)
                )
              )
            )
          )
          (
            #block
            (#return false)
          )
          ()
