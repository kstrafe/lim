(#gn #error-enum (variants name)
  `((#enum ,name () ,variants)))

;; The registry is a statically sized homogeneous array in the binary.
;; Borrow it with #slice-of inside #unsafe, as for every static in Lim.
(#gn #distributed-slice (elements name element)
  `((#static ,name (#array ,element ,(#gn-length elements))
      (#array-of (#array ,element ,(#gn-length elements)) ,@elements))))
