#alias AsyncPollSource4 = ./async_poll4.lim::AsyncPollSource4
#alias WakeReady4 = ./wake_ready4.lim::WakeReady4
#alias WakeRegister4 = ./wake_tokens.lim::WakeRegister4
#alias WakeRetire4 = ./wake_tokens.lim::WakeRetire4
#alias WakeToken4 = ./wake_tokens.lim::WakeToken4
#alias async-poll4-source = ./async_poll4.lim::async-poll4-source
#alias lINUX-SYS-TIMERFD-SETTIME = ./linux_x86_64_syscall_numbers.lim::lINUX-SYS-TIMERFD-SETTIME
#alias linux-close = ./linux_x86_64.lim::linux-close
#alias linux-mmap = ./linux_x86_64.lim::linux-mmap
#alias linux-munmap = ./linux_x86_64.lim::linux-munmap
#alias linux-poll = ./linux_x86_64.lim::linux-poll
#alias linux-read = ./linux_x86_64.lim::linux-read
#alias linux-timerfd-create = ./linux_x86_64.lim::linux-timerfd-create
#alias wake-ready4-create = ./wake_ready4.lim::wake-ready4-create
#alias wake-ready4-notify = ./wake_ready4.lim::wake-ready4-notify
#alias wake-ready4-register = ./wake_ready4.lim::wake-ready4-register
#alias wake-ready4-retire = ./wake_ready4.lim::wake-ready4-retire
#alias wake-ready4-take = ./wake_ready4.lim::wake-ready4-take

//; One::shot Linux timer with owned kernel resources and a validated local wake.
//; The kernel never retains the scratch mapping after a synchronous poll/read
//; syscall returns. Cancel closes the fd before unmapping its storage.




#struct TimerReactor1 (#linear)
    ((fd #i64) (memory (#ptr-mut #u8)) (queue WakeReady4) (token WakeToken4))
#opaque TimerReactor1

#enum TimerCreate1 () ((TimerCreate1.TimerCreated1 TimerReactor1) (TimerCreate1.TimerCreateFailed1 #i64))
#enum TimerWait1 () (TimerWait1.TimerWoken1 (TimerWait1.TimerWaitFailed1 #i64))
#struct TimerPairReady1 () ((first #bool) (second #bool))
#enum TimerWait2 () ((TimerWait2.TimerPairWoken1 TimerPairReady1) (TimerWait2.TimerPairFailed1 #i64))
#enum TimerManyWait () ((TimerManyWait.TimerManyReady #u64) (TimerManyWait.TimerManyFailed #i64))
#enum TimerPoll1 () (TimerPoll1.TimerPending1 (TimerPoll1.TimerReady1 #u64) (TimerPoll1.TimerPollFailed1 #i64))

#fn timer-reactor1-source {
  #params = ((timer (#ref TimerReactor1)));
  #returns = AsyncPollSource4;
  #body = (
    (#return (#call async-poll4-source
      ((fd (#get timer fd))
       (queue (#borrow (#get timer queue)))
       (token (#get timer token)))))
  );
}

#fn timer-reactor1-create {
  #params = ((nanoseconds #u64));
  #returns = TimerCreate1;
  #body = (
    (#return (#if (#bool::or (#u64::eq nanoseconds 0u64)
                            (#u64::ge nanoseconds 1000000000u64))
      (TimerCreate1.TimerCreateFailed1 -22i64)
      (#block
        (#let fd #i64 (#call linux-timerfd-create ((clock-id 1i32) (flags 0i32))))
        (#if (#i64::lt fd 0i64)
          (TimerCreate1.TimerCreateFailed1 fd)
          (#block
            (#let memory (#ptr-mut #u8)
              (#unsafe (#unsafe-call linux-mmap
                ((address (#ptr-null (#ptr-mut #u8))) (length 4096usize)
                 (protection 3u32) (flags 34u32) (fd -1i64) (offset 0i64)))))
            (#let address #i64 (#as (#ptr-address memory) #i64))
            (#if (#i64::lt address 0i64)
              (#block
                (#let closed #i64 (#call linux-close ((fd fd))))
                (#if (#i64::lt closed 0i64)
                  (TimerCreate1.TimerCreateFailed1 closed)
                  (TimerCreate1.TimerCreateFailed1 address)))
              (#block
                //; pollfd at bytes 0..7; itimerspec at 16..47.
                (#for-range (position #u64) 0u64 48u64
                  (#unsafe (#ptr-write
                    (#ptr-offset (#clone memory) (#as position #usize)) 0u8)))
                (#for-range (position #u64) 0u64 4u64
                  (#unsafe (#ptr-write
                    (#ptr-offset (#clone memory) (#as position #usize))
                    (#as (#u64::shr (#as fd #u64) (#u64::mul-wrap position 8u64)) #u8))))
                (#unsafe (#ptr-write (#ptr-offset (#clone memory) 4usize) 1u8))
                (#for-range (position #u64) 0u64 8u64
                  (#unsafe (#ptr-write
                    (#ptr-offset (#clone memory) (#as (#u64::add-wrap 40u64 position) #usize))
                    (#as (#u64::shr nanoseconds (#u64::mul-wrap position 8u64)) #u8))))
                (#let armed #i64 (#unsafe (#linux-syscall #i64
                  lINUX-SYS-TIMERFD-SETTIME
                  (fd 0i32 (#ptr-offset (#clone memory) 16usize)
                    (#ptr-null (#ptr-mut #u8))))))
                (#if (#i64::lt armed 0i64)
                  (#block
                    (#let unmapped #i64 (#unsafe (#unsafe-call linux-munmap
                      ((address (#clone memory)) (length 4096usize)))))
                    (#let closed #i64 (#call linux-close ((fd fd))))
                    (#if (#i64::lt unmapped 0i64)
                      (TimerCreate1.TimerCreateFailed1 unmapped)
                      (#if (#i64::lt closed 0i64)
                        (TimerCreate1.TimerCreateFailed1 closed)
                        (TimerCreate1.TimerCreateFailed1 armed))))
                  (#block
                    (#let-mut queue WakeReady4 (#call wake-ready4-create ()))
                    (#let registration WakeRegister4
                      (#call wake-ready4-register
                        ((queue (#borrow-mut queue)) (slot 0usize))))
                    (#let token WakeToken4 (#match registration
                      (#case (WakeRegister4.WakeRegistered4 value) value)
                      (#case _ (#unreachable))))
                    (TimerCreate1.TimerCreated1 (#struct-literal TimerReactor1
                      ((fd fd) (memory memory) (queue queue) (token token)))))))))))))
  );
}

#fn timer-reactor1-wait {
  #params = ((timer (#ref TimerReactor1)));
  #returns = TimerWait1;
  #body = (
    (#let result #i64 (#unsafe (#unsafe-call linux-poll
      ((pollfds (#get timer memory)) (count 1usize) (timeout-ms -1i32)))))
    (#return (#if (#i64::eq result 1i64)
      (#if (#call wake-ready4-notify
             ((queue (#borrow (#get timer queue))) (token (#get timer token))))
        TimerWait1.TimerWoken1
        (TimerWait1.TimerWaitFailed1 -22i64))
      (TimerWait1.TimerWaitFailed1 result)))
  );
}

//; Borrow two distinct timer owners. The first owner's 4096-byte mapping has
//; spare space at offsets 8..15 for the second pollfd. No pointer escapes the
//; synchronous kernel wait, and each notification checks its own generation.
#fn timer-reactor2-wait {
  #params = ((first (#ref TimerReactor1)) (second (#ref TimerReactor1)));
  #returns = TimerWait2;
  #body = (
    (#let second-fd #i64 (#get second fd))
    (#return (#if (#i64::eq (#get first fd) second-fd)
      (TimerWait2.TimerPairFailed1 -22i64)
      (#block
        (#let memory (#ptr-mut #u8) (#get first memory))
        (#unsafe (#block
          (#ptr-write (#ptr-offset (#clone memory) 8usize)
            (#as second-fd #u8))
          (#ptr-write (#ptr-offset (#clone memory) 9usize)
            (#as (#u64::shr (#as second-fd #u64) 8u64) #u8))
          (#ptr-write (#ptr-offset (#clone memory) 10usize)
            (#as (#u64::shr (#as second-fd #u64) 16u64) #u8))
          (#ptr-write (#ptr-offset (#clone memory) 11usize)
            (#as (#u64::shr (#as second-fd #u64) 24u64) #u8))
          (#ptr-write (#ptr-offset (#clone memory) 6usize) 0u8)
          (#ptr-write (#ptr-offset (#clone memory) 7usize) 0u8)
          (#ptr-write (#ptr-offset (#clone memory) 12usize) 1u8)
          (#ptr-write (#ptr-offset (#clone memory) 13usize) 0u8)
          (#ptr-write (#ptr-offset (#clone memory) 14usize) 0u8)
          (#ptr-write (#ptr-offset (#clone memory) 15usize) 0u8)))
        (#let count #i64 (#unsafe (#unsafe-call linux-poll
          ((pollfds memory) (count 2usize) (timeout-ms -1i32)))))
        (#if (#i64::le count 0i64)
          (TimerWait2.TimerPairFailed1 (#if (#i64::eq count 0i64) -22i64 count))
          (#block
            (#let first-flags #u8 (#unsafe (#ptr-read
              (#ptr-offset (#clone memory) 6usize))))
            (#let second-flags #u8 (#unsafe (#ptr-read
              (#ptr-offset (#clone memory) 14usize))))
            (#if (#bool::or (#u8::ne (#u8::bit-and first-flags 56u8) 0u8)
                          (#u8::ne (#u8::bit-and second-flags 56u8) 0u8))
              (TimerWait2.TimerPairFailed1 -5i64)
              (#block
                (#let first-ready #bool (#u8::ne (#u8::bit-and first-flags 1u8) 0u8))
                (#let second-ready #bool (#u8::ne (#u8::bit-and second-flags 1u8) 0u8))
                (#let first-valid #bool (#if first-ready
                  (#call wake-ready4-notify
                    ((queue (#borrow (#get first queue))) (token (#get first token))))
                  true))
                (#let second-valid #bool (#if second-ready
                  (#call wake-ready4-notify
                    ((queue (#borrow (#get second queue))) (token (#get second token))))
                  true))
                (#if (#bool::and first-valid second-valid)
                  (TimerWait2.TimerPairWoken1 (#struct-literal TimerPairReady1
                    ((first first-ready) (second second-ready))))
                  (TimerWait2.TimerPairFailed1 -22i64)))))))))
  );
}

#fn timer-reactor1-poll {
  #params = ((timer (#ref TimerReactor1)));
  #returns = TimerPoll1;
  #body = (
    (#return (#if (#call wake-ready4-take
                  ((queue (#borrow (#get timer queue))) (token (#get timer token))))
      (#block
        (#let destination (#ptr-mut #u8)
          (#unsafe (#ptr-offset (#get timer memory) 64usize)))
        (#let count #i64 (#unsafe (#unsafe-call linux-read
          ((fd (#get timer fd)) (destination destination) (count 8usize)))))
        (#if (#i64::eq count 8i64)
          (TimerPoll1.TimerReady1 1u64)
          (TimerPoll1.TimerPollFailed1 count)))
      TimerPoll1.TimerPending1))
  );
}

#fn timer-reactor1-cancel {
  #params = ((timer TimerReactor1));
  #returns = #i64;
  #body = (
    (#let (TimerReactor1 fd memory queue token) TimerReactor1 timer)
    (#let-mut queue-mut WakeReady4 queue)
    (#let retired WakeRetire4
      (#call wake-ready4-retire ((queue (#borrow-mut queue-mut)) (token token))))
    (#assert (#match retired (#case WakeRetire4.WakeRetired4 true) (#case WakeRetire4.WakeStale4 false)))
    (#forget queue-mut)
    (#let closed #i64 (#call linux-close ((fd fd))))
    (#let unmapped #i64 (#unsafe (#unsafe-call linux-munmap
      ((address memory) (length 4096usize)))))
    (#return (#if (#i64::lt closed 0i64) closed unmapped))
  );
}

//; Bounded, runtime-sized blocking waits over borrowed timer owners. pollfd
//; records use the first owner's scratch mapping only for this synchronous
//; call. Result bits identify timers whose registered wake was notified.
#fn timer-reactor-many-wait {
  #params = ((timers (#slice (#ref TimerReactor1))));
  #returns = TimerManyWait;
  #body = (
    (#let count #usize (#slice-len timers))
    (#let-mut error #i64 -22i64)
    (#let-mut ready-mask #u64 0u64)
    (#if (#bool::and (#usize::ne count 0usize) (#usize::le count 4usize))
      (#block
        (#set error 0i64)
        (#let first (#ref TimerReactor1) (#deref (#slice-idx timers 0usize)))
        (#let memory (#ptr-mut #u8) (#get first memory))
        (#let-mut duplicate #bool false)
        (#for-range (slot #usize) 0usize count
          (#block
            (#let timer (#ref TimerReactor1) (#deref (#slice-idx timers slot)))
            (#let fd #i64 (#get timer fd))
            (#for-range (prior #usize) 0usize slot
              (#block
                (#let prior-timer (#ref TimerReactor1)
                  (#deref (#slice-idx timers prior)))
                (#if (#i64::eq fd (#get prior-timer fd))
                  (#block (#set duplicate true) ())
                  ())))
            (#for-range (byte #usize) 0usize 4usize
              (#unsafe (#ptr-write
                (#ptr-offset (#clone memory)
                  (#usize::add-wrap (#usize::mul-wrap slot 8usize) byte))
                (#as (#u64::shr (#as fd #u64)
                  (#as (#usize::mul-wrap byte 8usize) #u64)) #u8)))
            (#unsafe (#ptr-write
              (#ptr-offset (#clone memory)
                (#usize::add-wrap (#usize::mul-wrap slot 8usize) 4usize)) 1u8))
            (#unsafe (#ptr-write
              (#ptr-offset (#clone memory)
                (#usize::add-wrap (#usize::mul-wrap slot 8usize) 5usize)) 0u8))
            (#unsafe (#ptr-write
              (#ptr-offset (#clone memory)
                (#usize::add-wrap (#usize::mul-wrap slot 8usize) 6usize)) 0u8))
            (#unsafe (#ptr-write
              (#ptr-offset (#clone memory)
                (#usize::add-wrap (#usize::mul-wrap slot 8usize) 7usize)) 0u8))))
        (#if duplicate
          (#block (#set error -22i64) ())
          (#block
            (#let ready-count #i64
              (#unsafe (#unsafe-call linux-poll
                ((pollfds memory) (count count) (timeout-ms -1i32)))))
            (#if (#i64::lt ready-count 0i64)
              (#block (#set error ready-count) ())
              (#block
                (#for-range (poll-slot #usize) 0usize count
                  (#block
                    (#let flags #u8 (#unsafe (#ptr-read
                      (#ptr-offset (#clone memory)
                        (#usize::add-wrap (#usize::mul-wrap poll-slot 8usize) 6usize)))))
                    (#if (#u8::ne (#u8::bit-and flags 1u8) 0u8)
                      (#block
                        (#let timer (#ref TimerReactor1)
                          (#deref (#slice-idx timers poll-slot)))
                        (#if (#call wake-ready4-notify
                              ((queue (#borrow (#get timer queue)))
                               (token (#get timer token))))
                          (#block
                            (#set ready-mask
                              (#u64::bit-or ready-mask
                                (#u64::shl 1u64 (#as poll-slot #u64))))
                            ())
                          (#block (#set error -22i64) ())))
                      ())
                    (#if (#u8::ne (#u8::bit-and flags 56u8) 0u8)
                      (#block (#set error -5i64) ())
                      ())))))))))
      ())
    (#return (#if (#i64::lt error 0i64)
      (TimerManyWait.TimerManyFailed error)
      (TimerManyWait.TimerManyReady ready-mask)))
  );
}
