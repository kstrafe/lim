    (#fn linux-getcwd ((buffer (#ptr-mut u8)) (size usize)) i64 (#return -38i64))
    (#fn linux-getdents64 ((fd i64) (buffer (#ptr-mut u8)) (size usize)) i64 (#return -38i64))
