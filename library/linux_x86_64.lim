; Linux x86-64 syscall-backed byte IO and process query primitives.
; Import only for cfg(os=linux, arch=x86_64). Raw syscall errors are returned
; as negative errno values in i64; no libc or FFI calls are made here.
(#import "linux_x86_64_syscall_numbers.lim")

; Lim stack aggregates are laid out toward lower addresses. Keep nanoseconds
; first so a pointer adjusted to the low end has the Linux C timespec order.
(#struct LinuxTimespec ((nanoseconds i64) (seconds i64)))

(#cfg-if (#cfg-and (#cfg-is #os linux) (#cfg-is #arch x86_64))
  (#fn linux-read-byte ((destination (#ref-mut u8))) i64
    (#return (#unsafe (#asm i64
      ((rax LINUX-SYS-READ) (rdi 0usize) (rsi destination) (rdx 1usize))
      "and rsi, -2\n1:\nsyscall\ncmp rax, -4\nje 1b"))))
  (#fn linux-write-byte ((source (#ref u8))) i64
    (#return (#unsafe (#asm i64
      ((rax LINUX-SYS-WRITE) (rdi 1usize) (rsi source) (rdx 1usize))
      "and rsi, -2\n1:\nsyscall\ncmp rax, -4\nje 1b"))))
  (#fn linux-getpid () i64
    (#return (#unsafe (#asm i64 ((rax LINUX-SYS-GETPID)) "syscall"))))
  (#fn linux-getuid () i64
    (#return (#unsafe (#asm i64 ((rax LINUX-SYS-GETUID)) "syscall"))))
  (#fn linux-getgid () i64
    (#return (#unsafe (#asm i64 ((rax LINUX-SYS-GETGID)) "syscall"))))
  (#fn linux-geteuid () i64
    (#return (#unsafe (#asm i64 ((rax LINUX-SYS-GETEUID)) "syscall"))))
  (#fn linux-getegid () i64
    (#return (#unsafe (#asm i64 ((rax LINUX-SYS-GETEGID)) "syscall"))))
  (#fn linux-getppid () i64
    (#return (#unsafe (#asm i64 ((rax LINUX-SYS-GETPPID)) "syscall"))))
  (#fn linux-getpgrp () i64
    (#return (#unsafe (#asm i64 ((rax LINUX-SYS-GETPGRP)) "syscall"))))
  (#fn linux-getpgid ((pid i64)) i64
    (#return (#unsafe (#asm i64 ((rax LINUX-SYS-GETPGID) (rdi pid)) "syscall"))))
  (#fn linux-getsid ((pid i64)) i64
    (#return (#unsafe (#asm i64 ((rax LINUX-SYS-GETSID) (rdi pid)) "syscall"))))
  (#fn linux-getpriority ((which i64) (who i64)) i64
    (#return (#unsafe (#asm i64
      ((rax LINUX-SYS-GETPRIORITY) (rdi which) (rsi who)) "syscall"))))
  (#fn linux-gettid () i64
    (#return (#unsafe (#asm i64 ((rax LINUX-SYS-GETTID)) "syscall"))))
  (#fn linux-fork () i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-FORK ()))))
  (#fn linux-wait4 ((pid i64) (status (#ptr-mut i32)) (options usize)
      (usage (#ptr-mut i64))) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-WAIT4
      (pid status options usage)))))
  (#fn linux-sched-yield () i64
    (#return (#unsafe (#asm i64 ((rax LINUX-SYS-SCHED-YIELD)) "syscall"))))
  (#fn linux-sched-getparam ((pid i64) (scheduler-parameters (#ptr-mut i32))) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-SCHED-GETPARAM
      (pid scheduler-parameters)))))
  (#fn linux-sched-getscheduler ((pid i64)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-SCHED-GETSCHEDULER
      (pid)))))
  (#fn linux-sched-get-priority-max ((policy i64)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-SCHED-GET-PRIORITY-MAX
      (policy)))))
  (#fn linux-sched-get-priority-min ((policy i64)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-SCHED-GET-PRIORITY-MIN
      (policy)))))
  (#fn linux-sched-setaffinity ((pid i64) (size usize) (mask (#ptr-mut u64))) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-SCHED-SETAFFINITY
      (pid size mask)))))
  (#fn linux-sched-getaffinity ((pid i64) (size usize) (mask (#ptr-mut u64))) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-SCHED-GETAFFINITY
      (pid size mask)))))
  (#fn linux-close ((fd i64)) i64
    (#return (#unsafe (#asm i64 ((rax LINUX-SYS-CLOSE) (rdi fd)) "syscall"))))
  (#fn linux-openat ((directory i64) (path (#ptr-mut u8)) (flags usize) (mode usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-OPENAT
      (directory path flags mode)))))
  (#fn linux-mkdirat ((directory i64) (path (#ptr-mut u8)) (mode usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-MKDIRAT
      (directory path mode)))))
  (#fn linux-inotify-init1 ((flags usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-INOTIFY-INIT1 (flags)))))
  (#fn linux-inotify-add-watch ((fd i64) (path (#ptr-mut u8)) (mask usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-INOTIFY-ADD-WATCH
      (fd path mask)))))
  (#fn linux-inotify-rm-watch ((fd i64) (watch i64)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-INOTIFY-RM-WATCH
      (fd watch)))))
  (#fn linux-getcwd ((buffer (#ptr-mut u8)) (size usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-GETCWD
      (buffer size)))))
  (#fn linux-getdents64 ((fd i64) (buffer (#ptr-mut u8)) (size usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-GETDENTS64
      (fd buffer size)))))
  (#fn linux-fchdir ((fd i64)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-FCHDIR (fd)))))
  (#fn linux-getrusage ((resource i64) (usage (#ptr-mut i64))) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-GETRUSAGE
      (resource usage)))))
  (#fn linux-getitimer ((which i64) (current-value (#ptr-mut i64))) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-GETITIMER
      (which current-value)))))
  (#fn linux-setitimer ((which i64) (new-value (#ptr-mut i64))
      (old-value (#ptr-mut i64))) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-SETITIMER
      (which new-value old-value)))))
  (#fn linux-getrlimit ((resource usize) (limits (#ptr-mut i64))) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-GETRLIMIT
      (resource limits)))))
  (#fn linux-setrlimit ((resource usize) (limits (#ptr-mut i64))) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-SETRLIMIT
      (resource limits)))))
  (#fn linux-prlimit64 ((pid i64) (resource usize)
      (new-limits (#ptr-mut i64)) (old-limits (#ptr-mut i64))) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-PRLIMIT64
      (pid resource new-limits old-limits)))))
  (#fn linux-umask ((mask usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-UMASK (mask)))))
  (#fn linux-rt-sigaction ((signal i64) (action (#ptr-mut i64))
      (old-action (#ptr-mut i64)) (sigset-size usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-RT-SIGACTION
      (signal action old-action sigset-size)))))
  (#fn linux-rt-sigprocmask ((how usize) (signal-set (#ptr-mut i64))
      (old-set (#ptr-mut i64)) (sigset-size usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-RT-SIGPROCMASK
      (how signal-set old-set sigset-size)))))
  (#fn linux-rt-sigpending ((signal-set (#ptr-mut i64)) (sigset-size usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-RT-SIGPENDING
      (signal-set sigset-size)))))
  (#fn linux-read ((fd i64) (destination (#ptr-mut u8)) (count usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-READ (fd destination count)))))
  (#fn linux-write ((fd i64) (source (#ptr-mut u8)) (count usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-WRITE (fd source count)))))
  (#fn linux-pread64 ((fd i64) (destination (#ptr-mut u8)) (count usize) (offset i64)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-PREAD64
      (fd destination count offset)))))
  (#fn linux-pwrite64 ((fd i64) (source (#ptr-mut u8)) (count usize) (offset i64)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-PWRITE64
      (fd source count offset)))))
  (#fn linux-fstat ((fd i64) (metadata (#ptr-mut i64))) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-FSTAT (fd metadata)))))
  (#fn linux-fsetxattr ((fd i64) (name (#ptr-mut u8))
      (value (#ptr-mut u8)) (size usize) (flags usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-FSETXATTR
      (fd name value size flags)))))
  (#fn linux-fgetxattr ((fd i64) (name (#ptr-mut u8))
      (value (#ptr-mut u8)) (size usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-FGETXATTR
      (fd name value size)))))
  (#fn linux-flistxattr ((fd i64) (list (#ptr-mut u8)) (size usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-FLISTXATTR
      (fd list size)))))
  (#fn linux-fremovexattr ((fd i64) (name (#ptr-mut u8))) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-FREMOVEXATTR
      (fd name)))))
  (#fn linux-fcntl ((fd i64) (command usize) (argument usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-FCNTL
      (fd command argument)))))
  (#fn linux-fdatasync ((fd i64)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-FDATASYNC (fd)))))
  (#fn linux-memfd-create ((name (#ptr-mut u8)) (flags usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-MEMFD-CREATE (name flags)))))
  (#fn linux-unlinkat ((directory i64) (path (#ptr-mut u8)) (flags usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-UNLINKAT
      (directory path flags)))))
  (#fn linux-dup2 ((source i64) (destination i64)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-DUP2
      (source destination)))))
  (#fn linux-flock ((fd i64) (operation usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-FLOCK (fd operation)))))
  (#fn linux-fchmod ((fd i64) (mode usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-FCHMOD (fd mode)))))
  (#fn linux-fchown ((fd i64) (owner i64) (group i64)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-FCHOWN
      (fd owner group)))))
  (#fn linux-fallocate ((fd i64) (mode usize) (offset i64) (length i64)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-FALLOCATE
      (fd mode offset length)))))
  (#fn linux-fadvise64 ((fd i64) (offset i64) (length i64) (advice usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-FADVISE64
      (fd offset length advice)))))
  (#fn linux-pipe2 ((descriptors (#ptr-mut i32)) (flags usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-PIPE2
      (descriptors flags)))))
  (#fn linux-sendfile ((output i64) (input i64) (offset (#ptr-mut i64)) (count usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-SENDFILE
      (output input offset count)))))
  (#fn linux-copy-file-range ((input i64) (input-offset (#ptr-mut i64))
      (output i64) (output-offset (#ptr-mut i64)) (count usize) (flags usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-COPY-FILE-RANGE
      (input input-offset output output-offset count flags)))))
  (#fn linux-tee ((input i64) (output i64) (count usize) (flags usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-TEE
      (input output count flags)))))
  (#fn linux-splice ((input i64) (input-offset (#ptr-mut i64))
      (output i64) (output-offset (#ptr-mut i64)) (count usize) (flags usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-SPLICE
      (input input-offset output output-offset count flags)))))
  (#fn linux-dup ((fd i64)) i64
    (#return (#unsafe (#asm i64 ((rax LINUX-SYS-DUP) (rdi fd)) "syscall"))))
  (#fn linux-lseek ((fd i64) (offset i64) (whence i64)) i64
    (#return (#unsafe (#asm i64
      ((rax LINUX-SYS-LSEEK) (rdi fd) (rsi offset) (rdx whence)) "syscall"))))
  (#fn linux-fsync ((fd i64)) i64
    (#return (#unsafe (#asm i64 ((rax LINUX-SYS-FSYNC) (rdi fd)) "syscall"))))
  (#fn linux-ftruncate ((fd i64) (length i64)) i64
    (#return (#unsafe (#asm i64
      ((rax LINUX-SYS-FTRUNCATE) (rdi fd) (rsi length)) "syscall"))))
  (#fn linux-clock-gettime ((clock-id i64) (time (#ref-mut LinuxTimespec))) i64
    (#return (#unsafe (#asm i64
      ((rax LINUX-SYS-CLOCK-GETTIME) (rdi clock-id) (rsi time))
      "test rsi, 1\njz 1f\nand rsi, -2\nsub rsi, 8\n1:\nsyscall"))))
  (#fn linux-clock-getres ((clock-id i64) (time (#ptr-mut i64))) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-CLOCK-GETRES
      (clock-id time)))))
  (#fn linux-gettimeofday ((time (#ptr-mut i64)) (timezone (#ptr-mut i64))) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-GETTIMEOFDAY
      (time timezone)))))
  (#fn linux-time ((output (#ptr-mut i64))) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-TIME (output)))))
  (#fn linux-times ((output (#ptr-mut i64))) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-TIMES (output)))))
  (#fn linux-clock-nanosleep ((clock-id i64) (flags usize)
      (request (#ptr-mut i64)) (remaining (#ptr-mut i64))) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-CLOCK-NANOSLEEP
      (clock-id flags request remaining)))))
  (#fn linux-timer-create ((clock-id i64) (event (#ptr-mut i64))
      (timer-id (#ptr-mut i32))) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-TIMER-CREATE
      (clock-id event timer-id)))))
  (#fn linux-timer-settime ((timer-id i64) (flags usize)
      (new-time (#ptr-mut i64)) (old-time (#ptr-mut i64))) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-TIMER-SETTIME
      (timer-id flags new-time old-time)))))
  (#fn linux-timer-gettime ((timer-id i64) (current-time (#ptr-mut i64))) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-TIMER-GETTIME
      (timer-id current-time)))))
  (#fn linux-timer-delete ((timer-id i64)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-TIMER-DELETE
      (timer-id)))))
  (#fn linux-futex ((address (#ptr-mut u32)) (operation usize) (value u32)
      (timeout (#ptr-mut i64)) (second-address (#ptr-mut u32)) (value3 usize)) i64
    (#return (#unsafe (#linux-syscall i64 LINUX-SYS-FUTEX
      (address operation value timeout second-address value3)))))
  (#fn linux-nanosleep ((request (#ref LinuxTimespec)) (remaining (#ref-mut LinuxTimespec))) i64
    (#return (#unsafe (#asm i64
      ((rax LINUX-SYS-NANOSLEEP) (rdi request) (rsi remaining))
      "test rdi, 1\njz 1f\nand rdi, -2\nsub rdi, 8\n1:\ntest rsi, 1\njz 2f\nand rsi, -2\nsub rsi, 8\n2:\nsyscall"))))
  (#fn linux-getrandom-byte ((destination (#ref-mut u8))) i64
    (#return (#unsafe (#asm i64
      ((rax LINUX-SYS-GETRANDOM) (rdi destination) (rsi 1usize) (rdx 0usize))
      "and rdi, -2\nsyscall"))))
  (#cfg-else
    (#fn linux-read-byte ((destination (#ref-mut u8))) i64 (#return -38i64))
    (#fn linux-write-byte ((source (#ref u8))) i64 (#return -38i64))
    (#fn linux-getpid () i64 (#return -38i64))
    (#fn linux-getuid () i64 (#return -38i64))
