      (#unsafe
        (#asm
          #i64
          ((rax LINUX-SYS-READ) (rdi 0usize) (rsi destination) (rdx 1usize))
          "mov r8, rax\n1:\nmov rax, r8\nsyscall\ncmp rax, -4\nje 1b"))))
