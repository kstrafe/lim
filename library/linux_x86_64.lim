    (#fn linux-getrlimit ((resource usize) (limits (#ptr-mut i64))) i64 (#return -38i64))
    (#fn linux-setrlimit ((resource usize) (limits (#ptr-mut i64))) i64 (#return -38i64))
    (#fn linux-prlimit64 ((pid i64) (resource usize) (new-limits (#ptr-mut i64)) (old-limits (#ptr-mut i64))) i64 (#return -38i64))
    (#fn linux-umask ((mask usize)) i64 (#return -38i64))
    (#fn linux-rt-sigaction ((signal i64) (action (#ptr-mut i64)) (old-action (#ptr-mut i64)) (sigset-size usize)) i64 (#return -38i64))
    (#fn linux-rt-sigprocmask ((how usize) (signal-set (#ptr-mut i64)) (old-set (#ptr-mut i64)) (sigset-size usize)) i64 (#return -38i64))
    (#fn linux-rt-sigpending ((signal-set (#ptr-mut i64)) (sigset-size usize)) i64 (#return -38i64))
    (#fn linux-read ((fd i64) (destination (#ptr-mut u8)) (count usize)) i64 (#return -38i64))
    (#fn linux-write ((fd i64) (source (#ptr-mut u8)) (count usize)) i64 (#return -38i64))
    (#fn linux-pread64 ((fd i64) (destination (#ptr-mut u8)) (count usize) (offset i64)) i64 (#return -38i64))
    (#fn linux-pwrite64 ((fd i64) (source (#ptr-mut u8)) (count usize) (offset i64)) i64 (#return -38i64))
