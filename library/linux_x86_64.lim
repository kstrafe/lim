    (#fn linux-sched-get-priority-max ((policy i64)) i64 (#return -38i64))
    (#fn linux-sched-get-priority-min ((policy i64)) i64 (#return -38i64))
    (#fn linux-sched-setaffinity ((pid i64) (size usize) (mask (#ptr-mut u64))) i64 (#return -38i64))
    (#fn linux-sched-getaffinity ((pid i64) (size usize) (mask (#ptr-mut u64))) i64 (#return -38i64))
    (#fn linux-close ((fd i64)) i64 (#return -38i64))
    (#fn linux-openat ((directory i64) (path (#ptr-mut u8)) (flags usize) (mode usize)) i64 (#return -38i64))
