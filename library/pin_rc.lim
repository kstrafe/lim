;; Concrete, single-threaded reference-counted pinned allocations.
;; No weak handles or ordinary mutable pointee references are exposed.
;; -borrow-mut succeeds only with one strong owner. Destroy all borrowed
;; views before dropping a handle; final destruction runs in place.
;; Allocator hooks use the same layout/alignment protocol as @#pin-box.
;; allocate returns alloc-result containing (#ptr-mut NameAllocation).
;; destroy takes (: allocator (#ref Allocator) : pin (#pin-ref-mut Element)).
(#gn-fn pin-rc-name (name suffix) (#gn-symbol-append name suffix))
(#gn-fn pin-rc-check (option)
  (#gn-if (#gn-equal (#gn-length option) 2)
    (#gn-if (#gn-equal
      (#gn-for-each key (type allocator name error alloc-result alloc-ok alloc-error alloc dealloc destroy)
        (#gn-if (#gn-equal (#gn-first option) key) true false))
      (#gn-for-each key (type allocator name error alloc-result alloc-ok alloc-error alloc dealloc destroy) false))
      (#gn-error "@#pin-rc has an unknown named argument") ())
    (#gn-error "@#pin-rc requires named argument pairs")))

(#gn-fn pin-rc-build (element allocator name block error alloc-result alloc-ok alloc-error alloc dealloc destroy checked)
    `((#struct ,block () (: value ,element : strong (#atomic #usize)))
      (#opaque ,block)
      (#struct ,name () (: allocator (#ref ,allocator) : pointer (#pin-shared-own ,block)))
      (#opaque ,name)
      (#enum ,(#gn-call pin-rc-name name "CreateResult") (#linear)
        ((,(#gn-call pin-rc-name name "created") ,name)
         (,(#gn-call pin-rc-name name "allocation-failed") (#tuple ,error ,element))))

      (#enum ,(#gn-call pin-rc-name name "MutResult") (#linear)
        ((,(#gn-call pin-rc-name name "unique") (#pin-ref-mut ,element))
         (,(#gn-call pin-rc-name name "shared"))))

      (#fn ,(#gn-call pin-rc-name name "create")
        (: allocator (#ref ,allocator) : value ,element) ,(#gn-call pin-rc-name name "CreateResult")
        (#let allocated ,alloc-result (#call ,alloc
          (: allocator allocator : layout (#size-of ,block) : alignment (#align-of ,block))))
        (#return (#match allocated
          (#case (,alloc-ok raw)
            (#block
              (#let storage (#pin-own ,block) (#unsafe (#pin-own-of raw
                (#struct-literal ,block (: value value : strong (#atomic-init #usize 1usize))))))
              (,(#gn-call pin-rc-name name "created")
                (#struct-literal ,name (: allocator allocator : pointer (#pin-share storage))))))
          (#case (,alloc-error failure)
            (,(#gn-call pin-rc-name name "allocation-failed") (#tuple failure value))))))
      (#fn ,(#gn-call pin-rc-name name "borrow") (: owner (#ref ,name)) (#pin-ref ,element)
        (#let view (#pin-ref ,block)
          (#pin-shared-borrow (#borrow (#get owner pointer)) (#get owner allocator)))
        (#return (#pin-borrow (#get view value))))
      (#fn ,(#gn-call pin-rc-name name "clone") (: owner (#ref ,name)) ,name
        (#let view (#pin-ref ,block) (#pin-shared-borrow (#borrow (#get owner pointer))))
        (#let count #usize (#atomic-load (#borrow (#get view strong)) #memory-relaxed))
        (#assert (#bool.&& (#usize.> count 0usize) (#usize.< count (#usize.-.wrap 0usize 1usize))))
        (#atomic-store (#borrow (#get view strong)) (#usize.+.wrap count 1usize) #memory-relaxed)
        (#drop view)
        (#return (#struct-literal ,name
          (: allocator (#clone (#get owner allocator))
           : pointer (#unsafe (#pin-share-clone (#borrow (#get owner pointer))))))))
      (#fn ,(#gn-call pin-rc-name name "borrow-mut") (: owner (#ref-mut ,name)) ,(#gn-call pin-rc-name name "MutResult")
        (#let view (#pin-ref ,block) (#pin-shared-borrow (#borrow (#get owner pointer))))
        (#let count #usize (#atomic-load (#borrow (#get view strong)) #memory-relaxed))
        (#drop view)
        (#return (#if (#usize.== count 1usize)
          (#block
            (#let exclusive (#pin-ref-mut ,block)
              (#unsafe (#pin-shared-borrow-mut (#borrow-mut (#get owner pointer)) owner)))
            (,(#gn-call pin-rc-name name "unique") (#pin-borrow-mut (#get exclusive value))))
          (,(#gn-call pin-rc-name name "shared")))))
      (#fn ,(#gn-call pin-rc-name name "destroy") (: owner ,name) ()
        (#let-mut (,name allocator pointer) ,name owner)
        (#let view (#pin-ref ,block) (#pin-shared-borrow pointer))
        (#let count #usize (#atomic-load (#borrow (#get view strong)) #memory-relaxed))
        (#assert (#usize.> count 0usize))
        (#atomic-store (#borrow (#get view strong)) (#usize.-.wrap count 1usize) #memory-relaxed)
        (#drop view)
        (#if (#usize.== count 1usize)
          (#block
            (#let exclusive (#pin-ref-mut ,block) (#unsafe (#pin-shared-borrow-mut pointer)))
            (#call ,destroy (: allocator (#clone allocator) : pin (#pin-borrow-mut (#get exclusive value))))
            (#drop exclusive)
            (#let raw (#ptr-mut ,block) (#unsafe (#pin-shared-release pointer)))
            (#call ,dealloc (: allocator allocator : pointer raw
              : layout (#size-of ,block) : alignment (#align-of ,block))))
          (#forget pointer))
        (#return ()))))

(#gn #pin-rc (options)
  (#gn-call pin-rc-build
    (#gn-get options type) (#gn-get options allocator) (#gn-get options name)
    (#gn-call pin-rc-name (#gn-get options name) "Allocation")
    (#gn-get options error) (#gn-get options alloc-result)
    (#gn-get options alloc-ok) (#gn-get options alloc-error)
    (#gn-get options alloc) (#gn-get options dealloc) (#gn-get options destroy)
    (#gn-for-each option options (#gn-call pin-rc-check option))))
