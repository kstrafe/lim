#alias lim-gen-allocator-for = #std/allocator.lim::allocator-for

//; Concrete, single-threaded reference-counted pinned allocations.
//; No weak handles or ordinary mutable pointee references are exposed.
//; -borrow-mut succeeds only with one strong owner. Destroy all borrowed
//; views before dropping a handle; final destruction runs in place.
//; The allocator adapter allocates the complete reference-counted block.
//; destroy takes ((allocator (#ref ROOT::State)) (pin (#pin-ref-mut Element))).

#gn-fn pin-rc-name { name; suffix; } (#gn-symbol-append name suffix)
#gn-fn pin-rc-check { option; }
    (#gn-if (#gn-equal (#gn-length option) 2)
      (#gn-if (#gn-equal
        (#gn-for-each key (type allocator name destroy)
          (#gn-if (#gn-equal (#gn-first option) key) true false))
        (#gn-for-each key (type allocator name destroy) false))
        (#gn-error "#generate pin-rc has an unknown named argument") ())
      (#gn-error "#generate pin-rc requires named argument pairs"))

#gn-fn pin-rc-build { element; allocator; name; block; adapter; destroy; checked; }
      `((#struct ,block () ((value ,element) (strong (#atomic #usize))))
        (#opaque ,block)
        (#generate lim-gen-allocator-for { options = ((allocator ,allocator) (type ,block) (name ,adapter) (operations (allocate deallocate))); })
        (#struct ,name () ((allocator (#ref ,(#gn-call pin-rc-name { name = allocator; suffix = "State"; }))) (pointer (#pin-shared-own ,block))))
        (#opaque ,name)
        (#enum ,(#gn-call pin-rc-name { name = name; suffix = "CreateResult"; }) (#linear)
          ((,(#gn-variant (#gn-call pin-rc-name { name = name; suffix = "CreateResult"; }) "Created") ,name)
           (,(#gn-variant (#gn-call pin-rc-name { name = name; suffix = "CreateResult"; }) "Allocation-failed")
            (#tuple ,(#gn-call pin-rc-name { name = allocator; suffix = "Error"; }) ,element))))

        (#enum ,(#gn-call pin-rc-name { name = name; suffix = "MutResult"; }) (#linear)
          ((,(#gn-variant (#gn-call pin-rc-name { name = name; suffix = "MutResult"; }) "Unique") (#pin-ref-mut ,element))
           (,(#gn-variant (#gn-call pin-rc-name { name = name; suffix = "MutResult"; }) "Shared"))))

        (#fn ,(#gn-call pin-rc-name { name = name; suffix = "create"; })
          ((allocator (#ref ,(#gn-call pin-rc-name { name = allocator; suffix = "State"; }))) (value ,element)) ,(#gn-call pin-rc-name { name = name; suffix = "CreateResult"; })
          (#effects ((#effects-of ,(#gn-call pin-rc-name { name = adapter; suffix = "allocate"; }))))
          (#let allocated ,(#gn-call pin-rc-name { name = adapter; suffix = "Allocation"; })
            (#call ,(#gn-call pin-rc-name { name = adapter; suffix = "allocate"; })
            ((allocator allocator) (layout (#size-of ,block)) (alignment (#align-of ,block)))))
          (#return (#match allocated
            (#case (,(#gn-variant (#gn-call pin-rc-name { name = adapter; suffix = "Allocation"; }) "Allocated") raw)
              (#block
                (#let storage (#pin-own ,block) (#unsafe (#pin-own-of raw
                  (#struct-literal ,block ((value value) (strong (#atomic-init #usize 1usize)))))))
                (,(#gn-variant (#gn-call pin-rc-name { name = name; suffix = "CreateResult"; }) "Created")
                  (#struct-literal ,name ((allocator allocator) (pointer (#pin-share storage)))))))
            (#case (,(#gn-variant (#gn-call pin-rc-name { name = adapter; suffix = "Allocation"; }) "AllocationFailed") failure)
              (,(#gn-variant (#gn-call pin-rc-name { name = name; suffix = "CreateResult"; }) "Allocation-failed") (#tuple failure value))))))
        (#fn ,(#gn-call pin-rc-name { name = name; suffix = "borrow"; }) ((owner (#ref ,name))) (#pin-ref ,element)
          (#effects (#global-access #io))
          (#let view (#pin-ref ,block)
            (#pin-shared-borrow (#borrow (#get owner pointer)) (#get owner allocator)))
          (#return (#pin-borrow (#get view value))))
        (#fn ,(#gn-call pin-rc-name { name = name; suffix = "clone"; }) ((owner (#ref ,name))) ,name
          (#effects (#global-access #io))
          (#let view (#pin-ref ,block) (#pin-shared-borrow (#borrow (#get owner pointer))))
          (#let count #usize (#atomic-load (#borrow (#get view strong)) #memory-relaxed))
          (#assert (#bool::and (#usize::gt count 0usize) (#usize::lt count (#usize::sub-wrap 0usize 1usize))))
          (#atomic-store (#borrow (#get view strong)) (#usize::add-wrap count 1usize) #memory-relaxed)
          (#drop view)
          (#return (#struct-literal ,name
            ((allocator (#clone (#get owner allocator)))
             (pointer (#unsafe (#pin-share-clone (#borrow (#get owner pointer)))))))))
        (#fn ,(#gn-call pin-rc-name { name = name; suffix = "borrow-mut"; }) ((owner (#ref-mut ,name))) ,(#gn-call pin-rc-name { name = name; suffix = "MutResult"; })
          (#effects (#global-access #io))
          (#let view (#pin-ref ,block) (#pin-shared-borrow (#borrow (#get owner pointer))))
          (#let count #usize (#atomic-load (#borrow (#get view strong)) #memory-relaxed))
          (#drop view)
          (#return (#if (#usize::eq count 1usize)
            (#block
              (#let exclusive (#pin-ref-mut ,block)
                (#unsafe (#pin-shared-borrow-mut (#borrow-mut (#get owner pointer)) owner)))
              (,(#gn-variant (#gn-call pin-rc-name { name = name; suffix = "MutResult"; }) "Unique") (#pin-borrow-mut (#get exclusive value))))
            (,(#gn-variant (#gn-call pin-rc-name { name = name; suffix = "MutResult"; }) "Shared")))))
        (#fn ,(#gn-call pin-rc-name { name = name; suffix = "destroy"; }) ((owner ,name)) ()
          (#effects (#global-access #io (#effects-of ,(#gn-call pin-rc-name { name = adapter; suffix = "deallocate"; })) (#effects-of ,destroy)))
          (#let-mut (,name allocator pointer) ,name owner)
          (#let view (#pin-ref ,block) (#pin-shared-borrow pointer))
          (#let count #usize (#atomic-load (#borrow (#get view strong)) #memory-relaxed))
          (#assert (#usize::gt count 0usize))
          (#atomic-store (#borrow (#get view strong)) (#usize::sub-wrap count 1usize) #memory-relaxed)
          (#drop view)
          (#if (#usize::eq count 1usize)
            (#block
              (#let exclusive (#pin-ref-mut ,block) (#unsafe (#pin-shared-borrow-mut pointer)))
              (#call ,destroy ((allocator (#clone allocator)) (pin (#pin-borrow-mut (#get exclusive value)))))
              (#drop exclusive)
              (#let raw (#ptr-mut ,block) (#unsafe (#pin-shared-release pointer)))
              (#unsafe (#unsafe-call ,(#gn-call pin-rc-name { name = adapter; suffix = "deallocate"; })
                ((allocator allocator) (pointer raw)
                 (layout (#size-of ,block)) (alignment (#align-of ,block))))))
            (#forget pointer))
          (#return ())))

#gn pin-rc { options; }
    (#gn-call pin-rc-build
      { element = (#gn-get options type); allocator = (#gn-get options allocator); name = (#gn-get options name);
      block = (#gn-call pin-rc-name { name = (#gn-get options name); suffix = "Allocation"; });
      adapter = (#gn-call pin-rc-name { name = (#gn-get options name); suffix = "Allocator"; });
      destroy = (#gn-get options destroy);
      checked = (#gn-for-each option options (#gn-call pin-rc-check { option = option; })); })
