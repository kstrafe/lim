//; A concrete linear slot for values held in stationary storage. The unsafe
//; take operation reads the old value and replaces it with the empty variant
//; without changing the slot's address. Callers must first end every loan into
//; the stored value.
#gn-fn pin-slot-second { values; } (#gn-first (#gn-rest values))
#gn-fn pin-slot-third { values; } (#gn-first (#gn-rest (#gn-rest values)))
#gn-fn pin-slot-fourth { values; } (#gn-first (#gn-rest (#gn-rest (#gn-rest values))))
#gn-fn pin-slot-fifth { values; } (#gn-first (#gn-rest (#gn-rest (#gn-rest (#gn-rest values)))))
#gn-fn pin-slot-sixth { values; } (#gn-first (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest values))))))
#gn-fn pin-slot-seventh { values; } (#gn-first (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest values)))))))
#gn-fn pin-slot-eighth { values; } (#gn-first (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest values))))))))
#gn-fn pin-slot-ninth { values; } (#gn-first (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest values)))))))))

#gn #pin-slot { names; element; }
    (#gn-if (#gn-equal (#gn-length names) 9)
      `((#enum ,(#gn-first names) (#linear)
          ((,(#gn-call pin-slot-second { values = names; }))
           (,(#gn-call pin-slot-third { values = names; }) ,element)))

        (#fn ,(#gn-call pin-slot-fourth { values = names; }) () ,(#gn-first names)
          (#return (,(#gn-call pin-slot-second { values = names; }))))
        (#unsafe-fn ,(#gn-call pin-slot-fifth { values = names; })
          ((slot (#pin-ref-mut ,(#gn-first names)))) ,(#gn-first names)
          (#let previous ,(#gn-first names) (#unsafe (#pin-read slot)))
          (#unsafe (#pin-write slot (,(#gn-call pin-slot-second { values = names; }))))
          (#return previous))
        //; Try to refill the stable slot. Taking first ensures the destination is
        //; Empty; an occupied value is restored before the caller gets its input.
        (#enum ,(#gn-call pin-slot-sixth { values = names; }) ()
          ((,(#gn-call pin-slot-seventh { values = names; }))
           (,(#gn-call pin-slot-eighth { values = names; }) ,element)))
        (#fn ,(#gn-call pin-slot-ninth { values = names; })
          ((slot (#pin-ref-mut ,(#gn-first names))) (value ,element))
          ,(#gn-call pin-slot-sixth { values = names; })
          (#let previous ,(#gn-first names)
            (#unsafe (#unsafe-call ,(#gn-call pin-slot-fifth { values = names; }) ((slot slot)))))
          //; take initialized the slot with Empty. Consume that linear shell
          //; explicitly before either branch writes its replacement in place.
          (#unsafe (#forget (#pin-read slot)))
          (#return (#match previous
            (#case ,(#gn-call pin-slot-second { values = names; })
              (#block (#unsafe (#pin-write slot (,(#gn-call pin-slot-third { values = names; }) value)))
                (,(#gn-call pin-slot-seventh { values = names; }))))
            (#case (,(#gn-call pin-slot-third { values = names; }) occupied)
              (#block (#unsafe (#pin-write slot
                (,(#gn-call pin-slot-third { values = names; }) occupied)))
                (,(#gn-call pin-slot-eighth { values = names; }) value)))))))
      (#gn-error "pin-slot requires nine names: Slot Empty Full create take InsertResult Inserted Occupied try-insert"))
