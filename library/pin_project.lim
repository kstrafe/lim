; Fallible pinned enum projection expressed entirely as ordinary safe Lim.
; The declaration checker validates the enum, variant and payload signatures.
(#gn-fn pin-project-build (options projected)
  `((#enum ,(#gn-get options name) ()
      ((,(#gn-symbol-append (#gn-get options name) "Some")
         (#pin-ref-mut ,(#gn-get options payload)))
       ,(#gn-symbol-append (#gn-get options name) "None")))
    (#fn ,(#gn-symbol-append (#gn-get options name) "project")
      (: source (#pin-ref-mut ,(#gn-get options enum)))
      ,(#gn-get options name)
      (#return (#match source
        (#case-pin-mut (,(#gn-get options variant) ,projected)
          (,(#gn-symbol-append (#gn-get options name) "Some") ,projected))
        (#case _ ,(#gn-symbol-append (#gn-get options name) "None")))))))

(#gn #pin-project (options)
  (#gn-if (#gn-equal (#gn-length options) 4)
    (#gn-call pin-project-build options (#gn-gensym "payload"))
    (#gn-error "@#pin-project requires exactly enum, variant, payload and name")))
