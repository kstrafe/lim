; Fallible enum projection is ordinary safe Lim, specialized by reference mode.
(#gn-fn enum-project-case (mode)
  (#gn-if (#gn-equal mode #ref) #case-ref
    (#gn-if (#gn-equal mode #ref-mut) #case-ref-mut
      (#gn-if (#gn-equal mode #pin-ref) #case-pin
        (#gn-if (#gn-equal mode #pin-ref-mut) #case-pin-mut
          (#gn-error "@#enum-project mode must be #ref, #ref-mut, #pin-ref or #pin-ref-mut"))))))

(#gn-fn enum-project-build (options projected mode case)
  `((#enum ,(#gn-get options name) ()
      ((,(#gn-symbol-append (#gn-get options name) "Some")
         (,mode ,(#gn-get options payload)))
       ,(#gn-symbol-append (#gn-get options name) "None")))
    (#fn ,(#gn-symbol-append (#gn-get options name) "project")
      (: source (,mode ,(#gn-get options enum)))
      ,(#gn-get options name)
      (#return (#match source
        (,case (,(#gn-get options variant) ,projected)
          (,(#gn-symbol-append (#gn-get options name) "Some") ,projected))
        (#case _ ,(#gn-symbol-append (#gn-get options name) "None")))))))

(#gn #enum-project (options)
  (#gn-if (#gn-equal (#gn-length options) 5)
    (#gn-call enum-project-build options (#gn-gensym "payload")
      (#gn-get options mode) (#gn-call enum-project-case (#gn-get options mode)))
    (#gn-error "@#enum-project requires exactly enum, variant, payload, mode and name")))
