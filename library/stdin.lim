(#import "string.lim")

(#enum StdReadError ((StdIoError i64) (StdTextError StringError)))
(#enum StdReadResult ((StdLineRead usize) StdEndOfInput (StdReadFailed StdReadError)))
(#enum StdReadCharResult ((StdReadChar u8) StdReadCharEof (StdReadCharFailed i64)))

(#cfg-if (#cfg-and (#cfg-is #os linux) (#cfg-is #arch x86_64))
  (#fn std-read-one-char () StdReadCharResult
    (#let-mut byte u8 0u8)
    (#let-mut result StdReadCharResult StdReadCharEof)
    (#let-mut done bool false)
    (#while (#bool.== done false)
      (#let count i64 (#unsafe (#linux-syscall i64 0usize
        (0i64 (#addr-of-mut byte) 1usize))))
      (#if (#i64.== count 1i64)
        (#block (#set result (StdReadChar byte)) (#set done true) ())
        (#if (#i64.== count 0i64)
          (#block (#set result StdReadCharEof) (#set done true) ())
          (#if (#i64.== count -4i64)
            ()
            (#block (#set result (StdReadCharFailed count)) (#set done true) ())))))
    (#return result)))
(#cfg-if (#cfg-not (#cfg-and (#cfg-is #os linux) (#cfg-is #arch x86_64)))
  (#fn std-read-one-char () StdReadCharResult
    (#return (StdReadCharFailed -38i64))))

(#fn std-read-line ((string (#ref-mut String))) StdReadResult
  (#let-mut appended usize 0usize)
  (#let-mut result StdReadResult StdEndOfInput)
  (#let-mut finished bool false)
  (#while (#bool.== finished false)
    (#let first-result StdReadCharResult (#call std-read-one-char (:)))
    (#match first-result
      (#case StdReadCharEof
        (#block
          (#set result (#if (#usize.== appended 0usize) StdEndOfInput (StdLineRead appended)))
          (#set finished true)
          ()))
      (#case (StdReadCharFailed error)
        (#block
          (#set result (StdReadFailed (StdIoError error)))
          (#set finished true)
          ()))
      (#case (StdReadChar first)
        (#if (#u8.== first 10u8)
          (#block (#set result (StdLineRead appended)) (#set finished true) ())
          (#block
            (#let width usize (#if (#u8.< first 128u8) 1usize
              (#if (#u8.<= first 223u8) 2usize
                (#if (#u8.<= first 239u8) 3usize 4usize))))
            (#let-mut code u32 (#as
              (#if (#usize.== width 1usize) first
                (#if (#usize.== width 2usize) (#u8.& first 31u8)
                  (#if (#usize.== width 3usize) (#u8.& first 15u8) (#u8.& first 7u8)))) u32))
            (#let-mut got usize 1usize)
            (#let-mut bad bool
              (#bool.|| (#bool.&& (#u8.>= first 128u8) (#u8.< first 194u8))
                (#u8.> first 244u8)))
            (#while (#bool.&& (#usize.< got width) (#bool.== bad false))
              (#let continuation-result StdReadCharResult (#call std-read-one-char (:)))
              (#match continuation-result
                (#case (StdReadChar continuation)
                  (#if (#bool.|| (#u8.< continuation 128u8) (#u8.> continuation 191u8))
                    (#block (#set bad true) ())
                    (#block
                      (#set code (#u32.| (#u32.<< code 6u32) (#as (#u8.& continuation 63u8) u32)))
                      (#set got (#usize.+.wrap got 1usize))
                      ())))
                (#case StdReadCharEof (#block (#set bad true) ()))
                (#case (StdReadCharFailed error)
                  (#block
                    (#set result (StdReadFailed (StdIoError error)))
                    (#set bad true)
                    ()))))
            (#if (#bool.== bad true)
              (#block
                (#if (#match result (#case (StdReadFailed error) true) (#case _ false))
                  ()
                  (#block (#set result (StdReadFailed (StdTextError StringInvalidUtf8))) ()))
                (#set finished true)
                ())
              (#block
                (#if (#bool.||
                    (#bool.&& (#usize.== width 2usize) (#u32.< code 128u32))
                    (#bool.||
                      (#bool.&& (#usize.== width 3usize) (#u32.< code 2048u32))
                      (#bool.||
                        (#bool.&& (#usize.== width 4usize) (#u32.< code 65536u32))
                        (#bool.||
                          (#bool.&& (#u32.>= code 55296u32) (#u32.<= code 57343u32))
                          (#u32.> code 1114111u32)))))
                  (#block
                    (#set result (StdReadFailed (StdTextError StringInvalidUtf8)))
                    (#set finished true)
                    ())
                  (#match (#call String-push-char
                    (: string string : value (#as code char)))
                    (#case StringOk (#block (#set appended (#usize.+.wrap appended width)) ()))
                    (#case (StringErr error)
                      (#block
                        (#set result (StdReadFailed (StdTextError error)))
                        (#set finished true)
                        ())))))))))))
  (#return (#if (#bool.== finished true) result (StdLineRead appended))))
