;; Allocator owned stable storage exposed only through native pinned references.
(#gn-fn pin-box-name (name suffix) (#gn-symbol-append name suffix))
(#gn-fn pin-box-check (option keys)
  (#gn-if (#gn-equal (#gn-length option) 2)
    (#gn-if (#gn-equal
      (#gn-for-each key keys (#gn-if (#gn-equal (#gn-first option) key) true false))
      (#gn-for-each key keys false))
      (#gn-error "@#pin-box has an unknown named option") ())
    (#gn-error "@#pin-box options must be (key value) pairs")))

(#gn-fn pin-box-build (o checked)
  `((#enum ,(#gn-call pin-box-name (#gn-get o name) "CreateResult")
      ((,(#gn-call pin-box-name (#gn-get o name) "-created") ,(#gn-get o name))
       (,(#gn-call pin-box-name (#gn-get o name) "-allocation-failed")
        (#tuple ,(#gn-get o error) ,(#gn-get o type)))))
    (#struct ,(#gn-get o name)
      (: allocator (#ref ,(#gn-get o allocator)) : pointer (#pin-own ,(#gn-get o type))))
    (#opaque ,(#gn-get o name)) (#linear ,(#gn-get o name))
    (#fn ,(#gn-call pin-box-name (#gn-get o name) "-create")
      (: allocator (#ref ,(#gn-get o allocator)) : value ,(#gn-get o type))
      ,(#gn-call pin-box-name (#gn-get o name) "CreateResult")
      (#let allocation ,(#gn-get o alloc-result)
        (#call ,(#gn-get o alloc) (: allocator allocator
          : layout (#size-of ,(#gn-get o type)) : alignment (#align-of ,(#gn-get o type)))))
      (#return (#match allocation
        (#case (,(#gn-get o alloc-ok) pointer)
          (#block (,(#gn-call pin-box-name (#gn-get o name) "-created")
            (#struct-literal ,(#gn-get o name)
              (: allocator (#clone allocator)
               : pointer (#unsafe (#pin-own-of pointer value)))))))
        (#case (,(#gn-get o alloc-error) error)
          (,(#gn-call pin-box-name (#gn-get o name) "-allocation-failed")
            (#tuple error value))))))
    (#fn ,(#gn-call pin-box-name (#gn-get o name) "-borrow")
      (: owner (#ref ,(#gn-get o name))) (#pin-ref ,(#gn-get o type))
      (#return (#pin-own-borrow
        (#borrow (#get owner pointer)) (#get owner allocator))))
    (#fn ,(#gn-call pin-box-name (#gn-get o name) "-borrow-mut")
      (: owner (#ref-mut ,(#gn-get o name))) (#pin-ref-mut ,(#gn-get o type))
      (#return (#pin-own-borrow-mut
        (#borrow-mut (#get owner pointer)) (#get owner allocator))))
    (#fn ,(#gn-call pin-box-name (#gn-get o name) "-destroy")
      (: owner ,(#gn-get o name)) ()
      (#let-mut (,(#gn-get o name) allocator pointer) ,(#gn-get o name) owner)
      (#let pin (#pin-ref-mut ,(#gn-get o type))
        (#pin-own-borrow-mut (#borrow-mut pointer) allocator))
      (#call ,(#gn-get o destroy) (: allocator (#clone allocator) : pin pin))
      (#forget pin)
      (#let raw (#ptr-mut ,(#gn-get o type)) (#unsafe (#pin-release pointer)))
      (#call ,(#gn-get o dealloc) (: allocator (#clone allocator) : pointer raw
        : layout (#size-of ,(#gn-get o type)) : alignment (#align-of ,(#gn-get o type))))
      (#return ()))))

(#gn #pin-box (options)
  (#gn-call pin-box-build options
    (#gn-for-each option options (#gn-call pin-box-check option
      (type allocator name error alloc-result alloc-ok alloc-error alloc dealloc destroy)))))
