#alias lim-gen-allocator-for = /<lim-std>/allocator.lim::#allocator-for

//; Allocator owned stable storage exposed only through native pinned references.

#gn-fn pin-box-name (name suffix) (#gn-symbol-append name suffix)
#gn-fn pin-box-check (option keys)
    (#gn-if (#gn-equal (#gn-length option) 2)
      (#gn-if (#gn-equal
        (#gn-for-each key keys (#gn-if (#gn-equal (#gn-first option) key) true false))
        (#gn-for-each key keys false))
        (#gn-error "#generate #pin-box has an unknown named option") ())
      (#gn-error "#generate #pin-box options must be (key value) pairs"))

#gn-fn pin-box-build (o adapter checked)
    `((#generate lim-gen-allocator-for ((allocator ,(#gn-get o allocator)) (type ,(#gn-get o type)) (name ,adapter) (operations (allocate deallocate))))
      (#enum ,(#gn-call pin-box-name (#gn-get o name) "CreateResult") ()
        ((,(#gn-variant (#gn-call pin-box-name (#gn-get o name) "CreateResult") "Created") ,(#gn-get o name))
         (,(#gn-variant (#gn-call pin-box-name (#gn-get o name) "CreateResult") "Allocation-failed")
          (#tuple ,(#gn-call pin-box-name (#gn-get o allocator) "Error") ,(#gn-get o type)))))
      (#struct ,(#gn-get o name) (#linear)
        ((allocator (#ref ,(#gn-call pin-box-name (#gn-get o allocator) "State"))) (pointer (#pin-own ,(#gn-get o type)))))
      (#opaque ,(#gn-get o name))
      (#fn ,(#gn-call pin-box-name (#gn-get o name) "create")
        ((allocator (#ref ,(#gn-call pin-box-name (#gn-get o allocator) "State"))) (value ,(#gn-get o type)))
        ,(#gn-call pin-box-name (#gn-get o name) "CreateResult")
        (#effects ((#effects-of ,(#gn-call pin-box-name adapter "allocate"))))
        (#let allocation ,(#gn-call pin-box-name adapter "Allocation")
          (#call ,(#gn-call pin-box-name adapter "allocate") ((allocator allocator)
            (layout (#size-of ,(#gn-get o type))) (alignment (#align-of ,(#gn-get o type))))))
        (#return (#match allocation
          (#case (,(#gn-variant (#gn-call pin-box-name adapter "Allocation") "Allocated") pointer)
            (#block (,(#gn-variant (#gn-call pin-box-name (#gn-get o name) "CreateResult") "Created")
              (#struct-literal ,(#gn-get o name)
                ((allocator (#clone allocator))
                 (pointer (#unsafe (#pin-own-of pointer value))))))))
          (#case (,(#gn-variant (#gn-call pin-box-name adapter "Allocation") "AllocationFailed") error)
            (,(#gn-variant (#gn-call pin-box-name (#gn-get o name) "CreateResult") "Allocation-failed")
              (#tuple error value))))))
      (#fn ,(#gn-call pin-box-name (#gn-get o name) "borrow")
        ((owner (#ref ,(#gn-get o name)))) (#pin-ref ,(#gn-get o type))
        (#return (#pin-own-borrow
          (#borrow (#get owner pointer)) (#get owner allocator))))
      (#fn ,(#gn-call pin-box-name (#gn-get o name) "borrow-mut")
        ((owner (#ref-mut ,(#gn-get o name)))) (#pin-ref-mut ,(#gn-get o type))
        (#return (#pin-own-borrow-mut
          (#borrow-mut (#get owner pointer)) (#get owner allocator))))
      (#fn ,(#gn-call pin-box-name (#gn-get o name) "destroy")
        ((owner ,(#gn-get o name))) ()
        (#effects ((#effects-of ,(#gn-call pin-box-name adapter "deallocate")) (#effects-of ,(#gn-get o destroy))))
        (#let-mut (,(#gn-get o name) allocator pointer) ,(#gn-get o name) owner)
        (#let pin (#pin-ref-mut ,(#gn-get o type))
          (#pin-own-borrow-mut (#borrow-mut pointer) allocator))
        (#call ,(#gn-get o destroy) ((allocator (#clone allocator)) (pin pin)))
        (#forget pin)
        (#let raw (#ptr-mut ,(#gn-get o type)) (#unsafe (#pin-release pointer)))
        (#unsafe (#unsafe-call ,(#gn-call pin-box-name adapter "deallocate")
          ((allocator (#clone allocator)) (pointer raw)
           (layout (#size-of ,(#gn-get o type))) (alignment (#align-of ,(#gn-get o type))))))
        (#return ())))

#gn #pin-box (options)
    (#gn-call pin-box-build options
      (#gn-call pin-box-name (#gn-get options name) "Allocator")
      (#gn-for-each option options (#gn-call pin-box-check option
        (type allocator name destroy))))
