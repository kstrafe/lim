;; A concrete, allocator-owned stable allocation for one pinned value.
;;
;; Types: (Element Allocator Box CreateResult AllocError AllocResult).
;; Names: (Created AllocationFailed create borrow borrow-mut destroy
;;         AllocOk AllocError allocate deallocate destroy-element).
;;
;; allocate: ((allocator (#ref Allocator)) (layout usize) (alignment usize))
;;           -> AllocResult, where `(@result (: ok (#ptr-mut Element) :
;;           error AllocError : name AllocResult))` supplies the variants.
;; deallocate: ((allocator (#ref Allocator)) (pointer (#ptr-mut Element))
;;              (layout usize) (alignment usize)) -> ()
;; destroy-element: ((allocator (#ref Allocator)) (value (#pin-ref-mut Element))) -> ()
;;
;; The owner is movable; the allocation is stationary. Views retain the
;; allocation identity and allocator borrow, not the address of this handle.
;; Cleanup runs in place before releasing the allocation for deallocation.
(#gn-fn pin-box-second (values) (#gn-first (#gn-rest values)))
(#gn-fn pin-box-third (values) (#gn-first (#gn-rest (#gn-rest values))))
(#gn-fn pin-box-fourth (values) (#gn-first (#gn-rest (#gn-rest (#gn-rest values)))))
(#gn-fn pin-box-fifth (values) (#gn-first (#gn-rest (#gn-rest (#gn-rest (#gn-rest values))))))
(#gn-fn pin-box-sixth (values) (#gn-first (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest values)))))))
(#gn-fn pin-box-seventh (values) (#gn-first (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest values))))))))
(#gn-fn pin-box-eighth (values) (#gn-first (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest values)))))))))
(#gn-fn pin-box-ninth (values) (#gn-first (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest values))))))))))
(#gn-fn pin-box-tenth (values) (#gn-first (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest values)))))))))))
(#gn-fn pin-box-eleventh (values) (#gn-first (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest (#gn-rest values))))))))))))

(#gn pin-box (types names)
  `((#enum ,(#gn-call pin-box-fourth types)
          ((,(#gn-first names) ,(#gn-call pin-box-third types))
           (,(#gn-call pin-box-second names) (#tuple ,(#gn-call pin-box-fifth types) ,(#gn-first types)))))
        (#struct ,(#gn-call pin-box-third types)
          ((allocator (#ref ,(#gn-call pin-box-second types)))
           (pointer (#pin-own ,(#gn-first types)))))
        (#linear ,(#gn-call pin-box-third types))
        (#fn ,(#gn-call pin-box-third names)
          ((allocator (#ref ,(#gn-call pin-box-second types)))
           (value ,(#gn-first types)))
          ,(#gn-call pin-box-fourth types)
          (#let allocation ,(#gn-call pin-box-sixth types)
            (#call ,(#gn-call pin-box-ninth names)
              (: allocator allocator
               : layout (#size-of ,(#gn-first types))
               : alignment (#align-of ,(#gn-first types)))))
          (#return
            (#match allocation
              (#case (,(#gn-call pin-box-seventh names) pointer)
                (#block
                  (,(#gn-first names)
                    (#struct-literal ,(#gn-call pin-box-third types)
                      ((allocator (#clone allocator))
                       (pointer (#unsafe (#pin-own-of pointer value))))))))
              (#case (,(#gn-call pin-box-eighth names) error)
                (,(#gn-call pin-box-second names) (#tuple error value))))))
        (#fn ,(#gn-call pin-box-fourth names)
          ((owner (#ref ,(#gn-call pin-box-third types))))
          (#pin-ref ,(#gn-first types))
          (#return
            (#pin-own-borrow (#borrow (#get owner pointer)) (#get owner allocator))))
        (#fn ,(#gn-call pin-box-fifth names)
          ((owner (#ref-mut ,(#gn-call pin-box-third types))))
          (#pin-ref-mut ,(#gn-first types))
          (#return
            (#pin-own-borrow-mut (#borrow-mut (#get owner pointer)) (#get owner allocator))))
        (#fn ,(#gn-call pin-box-sixth names) ((owner ,(#gn-call pin-box-third types))) ()
          (#let-mut (,(#gn-call pin-box-third types) allocator pointer) ,(#gn-call pin-box-third types) owner)
          (#let value (#pin-ref-mut ,(#gn-first types)) (#pin-own-borrow-mut pointer allocator))
          (#call ,(#gn-call pin-box-eleventh names)
            (: allocator (#clone allocator) : value value))
          (#forget value)
          (#let raw (#ptr-mut ,(#gn-first types)) (#unsafe (#pin-release pointer)))
          (#call ,(#gn-call pin-box-tenth names)
            (: allocator (#clone allocator)
             : pointer raw
             : layout (#size-of ,(#gn-first types))
             : alignment (#align-of ,(#gn-first types))))
          (#return ())
        )))
