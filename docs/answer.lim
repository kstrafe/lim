// A function, not a method.
#fn add {
  #params = ((left #u64) (right #u64));
  #returns = #u64;
  #body = (
    (#return (#u64::add-wrap left right))
  );
}

#fn main {
  #params = ();
  #returns = #u64;
  #body = (
    (#let answer #u64
      (#call add ((left 40u64) (right 2u64))))
    (#return answer)
  );
}
